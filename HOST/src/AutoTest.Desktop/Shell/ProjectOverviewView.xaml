<UserControl x:Class="AutoTest.Desktop.Shell.ProjectOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="52"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Border BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
   <DockPanel Margin="18,0">
    <Button DockPanel.Dock="Right" Content="新建工程"
     Command="{Binding NewProjectCommand}" VerticalAlignment="Center"
     Padding="12,7"/>
    <TextBlock Text="检测工程" FontSize="16" FontWeight="SemiBold"
     Foreground="#253E55" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel MaxWidth="1050" Margin="22,19,22,24">
    <TextBlock Text="{Binding CurrentProjectName}" FontSize="21"
     FontWeight="SemiBold" Foreground="#243950"/>
    <Border CornerRadius="7" BorderBrush="#DFE7F1" BorderThickness="1"
     Background="#F5F8FC" Padding="13" Margin="0,0,0,17">
     <StackPanel>
      <TextBlock Text="工程状态" FontSize="13" FontWeight="SemiBold"
       Foreground="#2C587E"/>
      <TextBlock Text="{Binding SetupOverallStatus}" Foreground="#536E87"
       TextWrapping="Wrap" Margin="0,6,0,0"/>
     </StackPanel>
    </Border>
    <TextBlock Text="编辑工程" FontSize="14" FontWeight="SemiBold"
     Foreground="#243950" Margin="0,0,0,10"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/>
      <ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button Grid.Column="0" Command="{Binding OpenFirstTestProjectCommand}"
      Background="White" BorderBrush="#DBE3ED" Height="118"
      Padding="15" HorizontalContentAlignment="Stretch">
      <StackPanel>
       <TextBlock Text="测试用例与执行顺序" FontSize="14"
        Foreground="#263B51" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding TestProgramCount,StringFormat='当前 {0} 个测试用例'}"
        Foreground="#2368BD" FontSize="13" Margin="0,9,0,6"/>
       <TextBlock Text="设置执行顺序，点击用例编辑测试步骤"
        Foreground="#62788E" TextWrapping="Wrap"/>
      </StackPanel>
     </Button>
     <Button Grid.Column="2" Command="{Binding OpenProjectConfigurationOverviewCommand}"
      Background="White" BorderBrush="#DBE3ED" Height="118"
      Padding="15" HorizontalContentAlignment="Stretch">
      <StackPanel>
       <TextBlock Text="工程检查" FontSize="14"
        Foreground="#263B51" FontWeight="SemiBold"/>
       <TextBlock Text="测试用例 · 烧录 · DBC · 波形" Foreground="#2368BD"
        FontSize="13" Margin="0,9,0,6"/>
       <TextBlock Text="查看资源是否完整、引用是否有效"
        Foreground="#62788E" TextWrapping="Wrap"/>
      </StackPanel>
     </Button>
    </Grid>
    <Border Background="#EDF5FF" BorderBrush="#CBDEF5" BorderThickness="1"
     CornerRadius="7" Padding="14,12" Margin="0,12,0,0">
     <Border.Style>
      <Style TargetType="{x:Type Border}">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding TestProjectCount}" Value="0">
         <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </Border.Style>
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="开始编辑测试用例"
       Command="{Binding CreateStarterProjectCommand}"
       Style="{StaticResource AtPrimaryButton}" Padding="12,8"
       Margin="12,0,0,0" VerticalAlignment="Center"/>
      <StackPanel>
       <TextBlock Text="当前工程还没有测试用例"
        Foreground="#245B96" FontSize="13" FontWeight="SemiBold"/>
       <TextBlock Text="新建用例后即可添加测试步骤。"
        Foreground="#597491" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <TextBlock Text="工程资源" FontSize="14" FontWeight="SemiBold"
     Foreground="#243950" Margin="0,23,0,9"/>
    <TextBlock Text="{Binding SetupResourcesStatus}" Foreground="#63788B"
     TextWrapping="Wrap" Margin="0,0,0,10"/>
    <WrapPanel>
     <Button Content="导入 DBC" Command="{Binding ImportDbcCommand}"
      Padding="13,8" Margin="0,0,9,7"/>
     <Button Content="导入波形记录" Command="{Binding ImportWaveCommand}"
      Padding="13,8" Margin="0,0,9,7"/>
     <Button Content="打开波形工具" Command="{Binding OpenWaveWorkbenchCommand}"
      Padding="13,8" Margin="0,0,9,7"/>
    </WrapPanel>
    <TextBlock Text="专业工具" FontSize="14" FontWeight="SemiBold"
     Foreground="#243950" Margin="0,18,0,10"/>
    <WrapPanel>
     <Button Content="手动台架" Command="{Binding OpenManualBenchCommand}"
      Padding="13,8" Margin="0,0,9,7"/>
     <Button Content="ECU 烧录" Command="{Binding OpenFlashWorkbenchCommand}"
      Padding="13,8" Margin="0,0,9,7"/>
     <Button Content="检查工程配置" Command="{Binding OpenProjectConfigurationOverviewCommand}"
      Padding="13,8" Margin="0,0,9,7"/>
    </WrapPanel>
    <TextBlock Text="各工具可以独立打开。"
     TextWrapping="Wrap" Foreground="#798899" Margin="0,12,0,0"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
