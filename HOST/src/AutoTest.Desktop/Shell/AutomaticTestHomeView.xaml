<UserControl x:Class="AutoTest.Desktop.Shell.AutomaticTestHomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AutoTest.Desktop.Shell"
 FontFamily="{StaticResource UiFont}" FontSize="15" Background="#EFF3F7" Foreground="#182B3C"
 UseLayoutRounding="True">
 <UserControl.Resources>
  <local:OperatorRowWidthConverter x:Key="OperatorRowWidthConverter"/>
  <Style x:Key="Label" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#506276"/>
   <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style x:Key="PanelCard" TargetType="Border">
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style x:Key="ConnectionChip" TargetType="Border">
   <Setter Property="Background" Value="#FFF2DF"/><Setter Property="BorderBrush" Value="#DAB37C"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
   <Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,8,6"/>
  </Style>
  <Style x:Key="NodeState" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#526477"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding State}" Value="引用需修复"><Setter Property="Foreground" Value="#B42318"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="未纳入正式检测"><Setter Property="Foreground" Value="#9A4E00"/></DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="步骤已禁用（不执行）"><Setter Property="Foreground" Value="#64748B"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid Margin="16,12,16,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Style="{StaticResource PanelCard}" Padding="16,12" Margin="0,0,0,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0">
     <TextBlock Text="当前检测工程" Style="{StaticResource Label}"/>
     <TextBlock Text="{Binding ProjectName}" FontSize="21" FontWeight="Bold" Margin="0,5,0,5" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectName}"/>
     <TextBlock Text="{Binding ModelCode,StringFormat='ECU 型号：{0}'}" FontSize="15" Foreground="#334A62" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <Border Grid.Column="1" BorderBrush="#DBE3EC" BorderThickness="1,0,1,0" Padding="18,0" Margin="0,0,16,0">
     <StackPanel>
      <TextBlock Text="ECU 唯一编号" Style="{StaticResource Label}"/>
      <TextBlock Text="{Binding DutSerial}" FontSize="26" FontWeight="Bold" Foreground="#164C86" TextTrimming="CharacterEllipsis" ToolTip="{Binding DutSerial}" Margin="0,3,0,3"/>
      <TextBlock Text="{Binding IdentityLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#965000"/>
     </StackPanel>
    </Border>
    <StackPanel Grid.Column="2">
     <DockPanel Margin="0,0,0,7">
      <Button DockPanel.Dock="Right" Content="扫码枪设置" Command="{Binding OpenScannerSettingsCommand}"
       Padding="8,4" MinHeight="30" FontSize="13" ToolTip="扫码设备首次配置、连接诊断或更换 COM；主控 USB 无需手动连接"/>
      <TextBlock Text="工位连接 · 主控自动连接" Style="{StaticResource Label}" VerticalAlignment="Center"/>
     </DockPanel>
     <WrapPanel>
      <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ConnectionChip}"><Style.Triggers><DataTrigger Binding="{Binding MainControllerConnected}" Value="True"><Setter Property="Background" Value="#E5F4E9"/><Setter Property="BorderBrush" Value="#72B28A"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <TextBlock Text="{Binding ControllerLabel}" FontSize="14" FontWeight="SemiBold"/></Border>
      <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ConnectionChip}"><Style.Triggers><DataTrigger Binding="{Binding ScannerConnected}" Value="True"><Setter Property="Background" Value="#E5F4E9"/><Setter Property="BorderBrush" Value="#72B28A"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <TextBlock Text="{Binding ScannerLabel}" FontSize="14" FontWeight="SemiBold"/></Border>
      <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ConnectionChip}"><Style.Triggers><DataTrigger Binding="{Binding CanBitrateReady}" Value="True"><Setter Property="Background" Value="#E5F4E9"/><Setter Property="BorderBrush" Value="#72B28A"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <TextBlock Text="{Binding CanLabel}" FontSize="14" FontWeight="SemiBold"/></Border>
     </WrapPanel>
     <TextBlock Text="{Binding ControllerDetail}" FontSize="12" Foreground="#43566C" TextTrimming="CharacterEllipsis" ToolTip="{Binding ControllerDetail}"/>
     <TextBlock Text="{Binding UsbAutoStatus}" FontSize="12" Foreground="#9A5600"
      TextTrimming="CharacterEllipsis" ToolTip="{Binding UsbAutoStatus}" Margin="0,3,0,0"/>
     <TextBlock Text="{Binding ScannerDetail}" FontSize="12" Foreground="#43566C" TextTrimming="CharacterEllipsis" ToolTip="{Binding ScannerDetail}" Margin="0,3,0,0"/>
     <TextBlock Text="{Binding CanDetail}" FontSize="12" Foreground="#43566C" TextTrimming="CharacterEllipsis" ToolTip="{Binding CanDetail}" Margin="0,3,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="#FFF3E2" BorderBrush="#C47D26" BorderThickness="5,1,1,1" CornerRadius="5" Padding="14,9" Margin="0,0,0,10">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="打开工程与调试" Command="{Binding ChoosePlanCommand}" MinHeight="40" FontSize="14" Padding="13,7" Margin="12,0,8,0"/>
     <Button Content="停止实测" Command="{Binding StopOperatorVerificationCommand}" MinHeight="40" FontSize="14" Padding="12,7"
      Foreground="#AD261A" Margin="0,0,8,0"
      ToolTip="请求停止真实 TEST/FLASH；如正在擦写 ECU，停止后必须核实实体状态"/>
     <Button Content="整组真实实测" Command="{Binding StartOperatorVerificationCommand}" Style="{StaticResource AtPrimaryButton}" MinHeight="40" MinWidth="132" FontSize="15" Padding="14,7"
      ToolTip="软件 START：工位动作→真实前置烧录→全部测试用例。记录为工程实测，不会冒充生产放行"/>
     <Button Content="检查准备" Command="{Binding RequestSoftwareStartCommand}" MinHeight="40" FontSize="14" Padding="12,7" Margin="8,0,0,0"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="{Binding StationReadiness}" FontSize="19" FontWeight="Bold" Foreground="#914500"/>
     <TextBlock Text="{Binding StartInputHint}" FontSize="14" Foreground="#70491D" TextWrapping="Wrap" Margin="0,3,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*" MinWidth="460"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*" MinWidth="325"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource PanelCard}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="15,0">
      <TextBlock DockPanel.Dock="Right" Text="{Binding CaseCount,StringFormat='共 {0} 个用例'}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#42566C"/>
      <TextBlock Text="检测用例 · 执行顺序" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
     </DockPanel>
     <Border Grid.Row="1" Background="#EAF0F6" BorderBrush="#CBD5E1" BorderThickness="0,1" Padding="16,0">
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="执行状态" FontSize="14" FontWeight="SemiBold" Width="150" VerticalAlignment="Center"/>
       <TextBlock Text="序号 / 用例与步骤（展开查看）" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     </Border>
     <TreeView x:Name="CasesTree" Grid.Row="2" ItemsSource="{Binding Cases}" SelectedItemChanged="CasesTree_SelectedItemChanged"
      BorderThickness="0" Background="White" Padding="6,4" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      Visibility="{Binding HasPlan,Converter={StaticResource BoolToVisibility}}">
      <TreeView.ItemContainerStyle>
       <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=OneWay}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,2"/>
        <Setter Property="Padding" Value="2"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
       </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.Resources>
       <HierarchicalDataTemplate DataType="{x:Type local:AutomaticTestCase}" ItemsSource="{Binding Children}">
        <Border Background="#EDF4FA" BorderBrush="#C8D7E7" BorderThickness="4,0,0,1" Padding="9,0" MinHeight="51"
         Width="{Binding ActualWidth,ElementName=CasesTree,Converter={StaticResource OperatorRowWidthConverter}}"
         HorizontalAlignment="Left">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Index}" FontSize="17" FontWeight="Bold" Foreground="#24588C" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,10,0"/>
          <TextBlock Grid.Column="2" Text="{Binding StepCountLabel}" FontSize="14" Foreground="#526477" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding State}" Style="{StaticResource NodeState}" TextTrimming="CharacterEllipsis" ToolTip="{Binding State}"/>
         </Grid>
        </Border>
       </HierarchicalDataTemplate>
       <HierarchicalDataTemplate DataType="{x:Type local:AutomaticTestStep}" ItemsSource="{Binding Children}">
        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="6,0" MinHeight="39">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Index}" FontSize="14" Foreground="#526477" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,10,0"/>
          <TextBlock Grid.Column="2" Text="{Binding State}" Style="{StaticResource NodeState}" TextTrimming="CharacterEllipsis" ToolTip="{Binding State}"/>
         </Grid>
        </Border>
       </HierarchicalDataTemplate>
      </TreeView.Resources>
     </TreeView>
     <Border Grid.Row="2" Background="White" Visibility="{Binding NeedsSetup,Converter={StaticResource BoolToVisibility}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="20">
       <TextBlock Text="没有可显示的检测用例" FontSize="21" FontWeight="Bold" TextAlignment="Center"/>
       <TextBlock Text="{Binding SetupIssue}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12"/>
       <Button Content="打开工程与调试" Command="{Binding ChoosePlanCommand}" Style="{StaticResource AtPrimaryButton}" FontSize="15" MinHeight="40" HorizontalAlignment="Center" Padding="16,8"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource PanelCard}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="15,0"><TextBlock Text="检测状态与结果" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/></Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="15,13">
       <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="5" Padding="13">
        <StackPanel><TextBlock Text="本次检测结果" Style="{StaticResource Label}"/>
         <TextBlock Text="{Binding StationReadiness}" FontSize="20" FontWeight="Bold" Foreground="#475569" Margin="0,2,0,5" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Status}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
       <TextBlock Text="扫码与启动条件" FontSize="16" FontWeight="Bold" Margin="0,17,0,6"/>
       <TextBlock Text="{Binding ScanStatus}" FontSize="14" Foreground="#334A62" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding ScanTraceSummary}" FontSize="13" TextWrapping="Wrap" Foreground="#526477"/>
       <TextBlock Text="{Binding StartRequestStatus}" FontSize="14" TextWrapping="Wrap" Foreground="#914500" Margin="0,7,0,9"/>
       <Border Height="1" Background="#D5DFE9" Margin="0,6,0,10"/>
       <TextBlock Text="选中用例 / 步骤" FontSize="16" FontWeight="Bold"/>
       <TextBlock Text="{Binding InspectedNode}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,5"/>
       <TextBlock Text="{Binding InspectedStatus}" FontSize="14" TextWrapping="Wrap" Foreground="#506276"/>
       <Border Height="1" Background="#D5DFE9" Margin="0,12"/>
       <TextBlock Text="真实整组实测（非生产放行）" FontSize="16" FontWeight="Bold"/>
       <TextBlock Text="{Binding OperatorRunState}" FontSize="17" FontWeight="SemiBold"
        Margin="0,6,0,3" TextWrapping="Wrap" Foreground="#164C86"/>
       <TextBlock Text="{Binding OperatorCurrentCase}" FontSize="14"
        Foreground="#334A62" TextWrapping="Wrap" Margin="0,0,0,3"/>
       <TextBlock Text="{Binding OperatorCurrentStep}" FontSize="14"
        Foreground="#526477" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding OperatorRunEvidence}" FontSize="12"
        Foreground="#526477" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <ItemsControl ItemsSource="{Binding OperatorEvents}">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding}" FontSize="12" Foreground="#42566C"
           TextWrapping="Wrap" Margin="0,2,0,2"/>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <Border Height="1" Background="#D5DFE9" Margin="0,12"/>
       <TextBlock Text="正式生产运行条件" FontSize="16" FontWeight="Bold"/>
       <TextBlock Text="{Binding ExecutionNotice}" FontSize="14" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#526477"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
