<UserControl x:Class="AutoTest.Desktop.Shell.ProjectConfigurationOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="54"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#DCE5ED"
   BorderThickness="0,0,0,1">
   <DockPanel Margin="17,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="重新核对" Command="{Binding RefreshEngineeringSetupCommand}"
      Padding="12,7" Margin="0,0,8,0"/>
     <Button Content="返回 TEST 项目" Command="{Binding OpenFirstTestProjectCommand}"
      Padding="13,7" Style="{StaticResource AtPrimaryButton}"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center">
     <TextBlock Text="工程依赖与版本审查" FontSize="15" FontWeight="SemiBold"
      Foreground="#253C53"/>
     <TextBlock Text="核对资源与调用，不修改生产发布" FontSize="11"
      Foreground="#75889A"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
   HorizontalScrollBarVisibility="Disabled">
   <StackPanel MaxWidth="1080" Margin="22,20,22,28">
    <TextBlock Text="当前工程静态检查" FontWeight="SemiBold" FontSize="17"
     Foreground="#294B6B" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding SetupTestStatus}" TextWrapping="Wrap"
     Foreground="#4C6880" Margin="0,0,0,11"/>
    <Border Background="#F5F8FB" BorderBrush="#DCE6EF"
     BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,15">
     <StackPanel>
      <DockPanel Margin="0,0,0,7">
       <TextBlock DockPanel.Dock="Right"
        Text="{Binding SetupRootCauseCount,StringFormat='{}{0} 组根因'}"
        FontWeight="SemiBold" Foreground="#2C6594"/>
       <TextBlock Text="资源变更影响" FontWeight="SemiBold" FontSize="14"
        Foreground="#294B68"/>
      </DockPanel>
      <TextBlock Text="{Binding SetupDependencySummary}" TextWrapping="Wrap"
       Foreground="#667F93" Margin="0,0,0,10"/>
      <ItemsControl ItemsSource="{Binding SetupDependencyGroups}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border Background="White" BorderBrush="#DFE7EF" BorderThickness="1"
          CornerRadius="5" Margin="0,0,0,7" Padding="10,6">
          <Expander>
           <Expander.Header>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
             <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
              Foreground="#355770" Margin="0,0,12,0"/>
             <TextBlock Text="{Binding AffectedCount,StringFormat='影响 {0} 项'}"
              Foreground="#8A612F" FontSize="11"/>
            </StackPanel>
           </Expander.Header>
           <StackPanel Margin="6,9,0,8">
            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"
             Foreground="#506C82" Margin="0,0,0,9"/>
            <Button Content="定位到受影响用例 / 资源" HorizontalAlignment="Left"
             Tag="{Binding}" Click="LocateDependency_Click" Padding="12,7"
             ToolTip="仅定位源资源和调用实例，不自动改写固定修订或 DBC 信号"/>
           </StackPanel>
          </Expander>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>
    <TextBlock Text="工程内其他资源" FontWeight="SemiBold" FontSize="14"
     Foreground="#294B68" Margin="0,0,0,10"/>
    <Border Background="White" BorderBrush="#DCE6EF" BorderThickness="1"
     CornerRadius="7" Padding="14" Margin="0,0,0,9">
     <DockPanel LastChildFill="True">
      <Button Content="编辑原生 FLASH" Command="{Binding OpenNativeFlashProfileCommand}"
       DockPanel.Dock="Right" Padding="12,7" Margin="12,0,0,0"/>
      <StackPanel>
       <TextBlock Text="烧录配置与固件" FontWeight="SemiBold" Margin="0,0,0,5"/>
       <TextBlock Text="{Binding SetupFlashStatus}" Foreground="#60798B"
        TextWrapping="Wrap"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <Border Background="White" BorderBrush="#DCE6EF" BorderThickness="1"
     CornerRadius="7" Padding="14" Margin="0,0,0,10">
     <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
       <Button Content="DBC" Command="{Binding OpenDbcToolCommand}"
        Padding="12,7" Margin="0,0,7,0"/>
       <Button Content="波形" Command="{Binding OpenWaveWorkbenchCommand}"
        Padding="12,7"/>
      </StackPanel>
      <StackPanel>
       <TextBlock Text="DBC / 波形" FontWeight="SemiBold" Margin="0,0,0,5"/>
       <TextBlock Text="{Binding SetupResourcesStatus}" Foreground="#60798B"
        TextWrapping="Wrap"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <Border Background="#F7FAFD" BorderBrush="#DCE6EF" BorderThickness="1"
     CornerRadius="7" Padding="14">
     <DockPanel LastChildFill="True">
      <Button Content="生产准备" Command="{Binding NavigateProductionPreparationCommand}"
       DockPanel.Dock="Right" Padding="12,7" Margin="12,0,0,0"/>
      <TextBlock Text="扫码、夹具、实体 START 与生产发布属于工位；手动 IO 调试请打开独立手动台架。"
       Foreground="#57738B" TextWrapping="Wrap" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
