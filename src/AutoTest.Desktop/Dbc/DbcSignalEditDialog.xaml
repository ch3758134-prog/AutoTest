<Window x:Class="AutoTest.Desktop.Dbc.DbcSignalEditDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 Title="编辑信号参数" Width="670" Height="665" MinWidth="600" MinHeight="625"
 ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
 FontFamily="{StaticResource UiFont}" FontSize="13">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="68"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="67"/>
    </Grid.RowDefinitions>
    <Border Padding="19,14" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="信号参数" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="所有数值采用英文小数点，起始位和位长由现有 DBC 模型验证。"
                   FontSize="11" Foreground="{StaticResource Subtle}" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="19,16,19,12">
        <primitives:UniformGrid Columns="2">
          <StackPanel Margin="0,0,12,15">
            <TextBlock Text="信号名称" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,15">
            <TextBlock Text="起始位 StartBit" Margin="0,0,0,6"/>
            <TextBox x:Name="StartBitBox"/>
          </StackPanel>
          <StackPanel Margin="0,0,12,15">
            <TextBlock Text="位长 BitLength" Margin="0,0,0,6"/>
            <TextBox x:Name="BitLengthBox"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,15">
            <TextBlock Text="缩放因子 Factor" Margin="0,0,0,6"/>
            <TextBox x:Name="FactorBox"/>
          </StackPanel>
          <StackPanel Margin="0,0,12,15">
            <TextBlock Text="偏移 Offset" Margin="0,0,0,6"/>
            <TextBox x:Name="OffsetBox"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,15">
            <TextBlock Text="物理最小值 Minimum" Margin="0,0,0,6"/>
            <TextBox x:Name="MinimumBox"/>
          </StackPanel>
          <StackPanel Margin="0,0,12,15">
            <TextBlock Text="物理最大值 Maximum" Margin="0,0,0,6"/>
            <TextBox x:Name="MaximumBox"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,15">
            <TextBlock Text="单位 Unit（允许为空）" Margin="0,0,0,6"/>
            <TextBox x:Name="UnitBox"/>
          </StackPanel>
          <StackPanel Margin="0,0,12,15">
            <TextBlock Text="接收节点 Receiver" Margin="0,0,0,6"/>
            <TextBox x:Name="ReceiverBox"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,15">
            <TextBlock Text="复用标记（空 / M / m数字）" Margin="0,0,0,6"/>
            <TextBox x:Name="MultiplexerBox"/>
          </StackPanel>
        </primitives:UniformGrid>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,15"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <CheckBox x:Name="IntelBox" Content="Intel（小端 @1）"
                    Margin="0,0,28,0" VerticalAlignment="Center"/>
          <CheckBox x:Name="SignedBox" Content="有符号（-）"
                    VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}"
                   TextWrapping="Wrap" Margin="0,7,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="18,13" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="应用后还需保存 DBC 文件"
                   Foreground="{StaticResource Subtle}" FontSize="11"
                   VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    DockPanel.Dock="Right">
          <Button Content="取消" IsCancel="True"/>
          <Button Content="应用参数" Click="Apply_Click"
                  Style="{StaticResource AtPrimaryButton}" IsDefault="True"
                  MinWidth="105" Margin="0"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>