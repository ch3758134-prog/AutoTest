<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · ECU 测试与开发" Width="1360" Height="850"
 MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen"
 WindowState="Maximized" Background="{StaticResource Canvas}"
 Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}"
 FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
    <KeyBinding Key="F2" Command="{Binding RenameResourceCommand}"/>
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="35"/>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*" MinHeight="350"/>
      <RowDefinition Height="27"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentProjectName}"
                   FontSize="11" Foreground="{StaticResource Subtle}"
                   VerticalAlignment="Center" Margin="0,0,16,0"
                   TextTrimming="CharacterEllipsis" MaxWidth="430"/>
        <Menu Margin="8,1,0,0" VerticalAlignment="Stretch">
          <MenuItem Header="文件(_F)">
            <MenuItem Header="新建工程…" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
            <MenuItem Header="打开工程…" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
          </MenuItem>
          <MenuItem Header="资源(_R)">
            <MenuItem Header="新建测试程序…" Command="{Binding NewTestProgramCommand}"/>
            <MenuItem Header="导入 DBC…" Command="{Binding ImportDbcCommand}"/>
            <Separator/>
            <MenuItem Header="重命名资源…" Command="{Binding RenameResourceCommand}" InputGestureText="F2"/>
            <MenuItem Header="移除资源引用…" Command="{Binding RemoveReferenceCommand}"/>
          </MenuItem>
          <MenuItem Header="视图(_V)" IsEnabled="False"
                    ToolTip="后续阶段开放视图管理"/>
        </Menu>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0,13,0" LastChildFill="True">
        <TextBlock DockPanel.Dock="Right" Text="{Binding AssetCount,StringFormat='工程资源 {0} 项'}"
                   FontSize="11" Foreground="{StaticResource Subtle}"
                   VerticalAlignment="Center" Margin="0,0,0,0"/>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="新建工程" Command="{Binding NewProjectCommand}"
                  Style="{StaticResource AtButton}" ToolTip="创建新工程 (Ctrl+N)"/>
          <Button Content="打开工程" Command="{Binding OpenProjectCommand}"
                  Style="{StaticResource AtButton}" ToolTip="从程序目录选择工程文件 (Ctrl+O)"/>
          <Border Width="1" Height="24" Background="{StaticResource Line}"
                  Margin="2,0,10,0"/>
          <Button Content="新建测试程序" Command="{Binding NewTestProgramCommand}"
                  Style="{StaticResource AtButton}" ToolTip="创建真实空 TEST 文档并加入工程资源"/>
          <Button Content="导入 DBC" Command="{Binding ImportDbcCommand}"
                  Style="{StaticResource AtButton}" ToolTip="把所选 DBC 复制到当前工程并登记资源"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="2" Background="{StaticResource Canvas}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="200" MaxWidth="460"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="490"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Padding="13,12,12,11"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="工程资源" FontSize="{StaticResource SectionTitleSize}"
                         FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock DockPanel.Dock="Right" Text="{Binding AssetCount,StringFormat='{0} 项'}"
                         FontSize="11" Foreground="{StaticResource Subtle}"
                         VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <Grid Margin="8">
            <TextBlock Text="暂无工程。请新建或打开工程。"
                       Margin="8,12" Foreground="{StaticResource Subtle}"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasProject}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TreeView x:Name="ResourceTree"
                      ItemsSource="{Binding ResourceNodes}"
                      Tag="{Binding}" BorderThickness="0"
                      Margin="0,3" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasProject,Converter={StaticResource BoolToVisibility}}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      SelectedItemChanged="ResourceTree_SelectedItemChanged"
                      PreviewMouseRightButtonDown="ResourceTree_RightClick">
              <!-- Override Windows theme selection brushes with AutoTest light theme. -->
              <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="{StaticResource SelectedSurfaceColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="{StaticResource InkColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                 Color="{StaticResource InactiveSelectionColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                 Color="{StaticResource InkColor}"/>
              </TreeView.Resources>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" Margin="0,0,7,0"
                               Foreground="{StaticResource Subtle}"/>
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Description}"/>
                  </StackPanel>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="True"/>
                  <Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="2,5"/>
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.Tag,RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="新建测试程序…" Command="{Binding NewTestProgramCommand}"/>
                  <MenuItem Header="导入 DBC…" Command="{Binding ImportDbcCommand}"/>
                  <Separator/>
                  <MenuItem Header="重命名资源…" Command="{Binding RenameResourceCommand}"/>
                  <MenuItem Header="移除引用（保留磁盘文件）" Command="{Binding RemoveReferenceCommand}"/>
                </ContextMenu>
              </TreeView.ContextMenu>
            </TreeView>
          </Grid>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                    Background="{StaticResource Line}" ResizeDirection="Columns"/>
      <Border Grid.Column="2" Margin="10,10,10,9" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4"
              Padding="21">
        <Grid>
          <StackPanel Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasProject}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="开始使用 AutoTest" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="创建新工程，或从本机打开已有的 AutoTest 工程文件。"
                       Foreground="{StaticResource Subtle}" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,0,20"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Content="新建工程" Command="{Binding NewProjectCommand}"
                      Style="{StaticResource AtButton}" MinWidth="125"/>
              <Button Content="打开工程" Command="{Binding OpenProjectCommand}"
                      Style="{StaticResource AtButton}" MinWidth="125"/>
            </StackPanel>
          </StackPanel>

          <!-- Details for the selected asset/group, without opening a second editor. -->
          <StackPanel VerticalAlignment="Top" Margin="6,4,6,0">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasSelectedResource}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="资源详情" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <TextBlock Text="{Binding SelectedResourceTitle}" FontSize="16"
                       FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding SelectedResourceDescription}" TextWrapping="Wrap"
                       Foreground="{StaticResource Subtle}" Margin="0,0,0,18"/>
            <StackPanel>
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedResourceIsAsset}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="工程内相对路径" Foreground="{StaticResource Subtle}"
                         Margin="0,0,0,7"/>
              <TextBlock Text="{Binding SelectedResourcePath}" TextWrapping="Wrap"
                         Margin="0,0,0,15"/>
              <TextBlock Text="{Binding SelectedResourceKind,StringFormat='资源类型：{0}'}"
                         Foreground="{StaticResource Subtle}" Margin="0,0,0,7"/>
              <TextBlock Text="{Binding SelectedResourceRevision,StringFormat='修订版本：{0}'}"
                         Foreground="{StaticResource Subtle}" Margin="0,0,0,15"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="重命名" Command="{Binding RenameResourceCommand}"/>
                <Button Content="移除引用" Command="{Binding RemoveReferenceCommand}"
                        ToolTip="不删除磁盘中的 DBC / TEST 文件"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel VerticalAlignment="Top" Margin="6,4,6,0">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding HasProject}" Value="True"/>
                      <Condition Binding="{Binding HasSelectedResource}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="工程概览" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,17"/>
            <TextBlock Text="工程名称" Foreground="{StaticResource Subtle}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding CurrentProjectName}" FontSize="16"
                       FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBlock Text="工程清单路径" Foreground="{StaticResource Subtle}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding CurrentProjectPath}" TextWrapping="Wrap"
                       FontSize="12" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding AssetCount,StringFormat='已登记资源：{0} 项'}"
                       Margin="0,0,0,17"/>
            <Border Background="{StaticResource MutedSurface}" CornerRadius="4"
                    Padding="12,11" MaxWidth="700" HorizontalAlignment="Left">
              <TextBlock Text="左侧已展示 TEST、DBC、控制器和波形等资源分类。空分类只是提示，没有写入虚假的资产；点击上方“新建测试程序”或“导入 DBC”可创建真实工程资源。"
                         TextWrapping="Wrap" Foreground="{StaticResource Subtle}"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="13,0" LastChildFill="True">
        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentProjectName}"
                   Foreground="{StaticResource Subtle}" FontSize="11"
                   VerticalAlignment="Center" MaxWidth="380" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                   Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>