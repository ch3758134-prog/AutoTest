<UserControl x:Class="AutoTest.Frontend.Views.EditorWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Background="{StaticResource AT.Canvas}">
 <Grid Margin="14,12">
  <Grid.RowDefinitions><RowDefinition Height="57"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="4,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource AT.Muted}"
     FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
    <ui:Button Content="返回运行" Click="Run_Click"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="测试用例编辑" Style="{StaticResource AT.PageTitle}"/>
    <TextBlock Text="仅演示前端的步骤表与属性编辑；正式编辑器及流程合同由 TEST 专项提供。"
     Style="{StaticResource AT.Caption}" Margin="0,3,0,0"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" MinWidth="320"/>
    <ColumnDefinition Width="7"/>
    <ColumnDefinition Width="330" MinWidth="275" MaxWidth="475"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource AT.Panel}" Padding="0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="62"/>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="40"/>
     </Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="15,0">
      <TextBlock DockPanel.Dock="Left" Text="当前用例" Style="{StaticResource AT.PanelTitle}"
       Margin="0,0,15,0"/>
      <ComboBox Width="240" ItemsSource="{Binding Cases}" DisplayMemberPath="Name"
       SelectedItem="{Binding SelectedCase,Mode=TwoWay}" VerticalAlignment="Center"
       Margin="0,0,10,0"/>
      <TextBox x:Name="CaseNameBox" Width="230" Text="{Binding SelectedCase.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       VerticalAlignment="Center" ToolTip="直接修改当前用例名称，界面草稿自动保存"/>
     </DockPanel>
     <Border Grid.Row="1" Background="{StaticResource AT.SubtleSurface}"
      BorderBrush="{StaticResource AT.Border}" BorderThickness="0,1,0,1">
      <DockPanel Margin="13,0">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
        VerticalAlignment="Center">
        <ui:Button Content="复制" Click="Copy_Click" Margin="0,0,6,0"/>
        <ui:Button Content="上移" Click="Up_Click" Margin="0,0,6,0"/>
        <ui:Button Content="下移" Click="Down_Click" Margin="0,0,6,0"/>
        <ui:Button Content="删除" Click="Delete_Click"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ComboBox x:Name="PhasePicker" SelectedIndex="1" Width="92"
         Margin="0,0,8,0">
         <ComboBoxItem Content="准备"/>
         <ComboBoxItem Content="测试"/>
         <ComboBoxItem Content="清理"/>
        </ComboBox>
        <ui:Button Content="+ 新增步骤" Appearance="Primary" Click="Add_Click"
         Padding="13,7"/>
       </StackPanel>
      </DockPanel>
     </Border>
     <DataGrid x:Name="StepsGrid" Grid.Row="2" PreviewKeyDown="StepsGrid_PreviewKeyDown"
      ItemsSource="{Binding SelectedCase.Steps}"
      SelectedItem="{Binding SelectedStep,Mode=TwoWay}">
      <DataGrid.ContextMenu>
       <ContextMenu>
        <MenuItem Header="复制步骤" Click="Copy_Click"/>
        <MenuItem Header="上移" Click="Up_Click"/>
        <MenuItem Header="下移" Click="Down_Click"/>
        <Separator/>
        <MenuItem Header="删除步骤" Click="Delete_Click"/>
       </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="断点" Width="54">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding Breakpoint,Mode=TwoWay}"
           HorizontalAlignment="Center" VerticalAlignment="Center"
           ToolTip="仅前端断点标记；未接真实调试器"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="阶段" Binding="{Binding Phase}" Width="68" IsReadOnly="True"/>
       <DataGridTemplateColumn Header="启用" Width="45">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding Enabled,Mode=TwoWay}"
           HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="步骤名称" Binding="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Width="*" MinWidth="145"/>
       <DataGridTextColumn Header="类型" Binding="{Binding Kind}" IsReadOnly="True" Width="125"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border Grid.Row="3" Background="{StaticResource AT.SubtleSurface}"
      BorderBrush="{StaticResource AT.Border}" BorderThickness="0,1,0,0"
      Padding="14,9">
      <TextBlock Text="高频字段可直接编辑；复杂测试参数及流程结构等待正式 TEST Editor 接入。"
       Style="{StaticResource AT.Caption}"/>
     </Border>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" ResizeDirection="Columns"
    ShowsPreview="True" Background="Transparent"/>
   <Border Grid.Column="2" Style="{StaticResource AT.Panel}" Padding="0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="57"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{StaticResource AT.Border}" BorderThickness="0,0,0,1"
      Padding="15,0">
      <DockPanel>
       <TextBlock Text="步骤属性" Style="{StaticResource AT.PanelTitle}"/>
       <TextBlock DockPanel.Dock="Right" Text="右侧直接编辑"
        Style="{StaticResource AT.Caption}" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <ScrollViewer Grid.Row="1" Padding="15,10" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="名称" Style="{StaticResource AT.FieldLabel}"/>
       <TextBox Text="{Binding SelectedStep.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="阶段" Style="{StaticResource AT.FieldLabel}"/>
       <ComboBox SelectedValue="{Binding SelectedStep.Phase,Mode=TwoWay}"
        SelectedValuePath="Content">
        <ComboBoxItem Content="准备"/>
        <ComboBoxItem Content="测试"/>
        <ComboBoxItem Content="清理"/>
       </ComboBox>
       <TextBlock Text="类型" Style="{StaticResource AT.FieldLabel}"/>
       <ComboBox SelectedValue="{Binding SelectedStep.Kind,Mode=TwoWay}"
        SelectedValuePath="Content">
        <ComboBoxItem Content="CAN 发送"/>
        <ComboBoxItem Content="CAN 读取"/>
        <ComboBoxItem Content="比较判定"/>
        <ComboBoxItem Content="输入模拟"/>
        <ComboBoxItem Content="IGN 控制"/>
        <ComboBoxItem Content="等待"/>
        <ComboBoxItem Content="IF / ELSE"/>
        <ComboBoxItem Content="SWITCH"/>
        <ComboBoxItem Content="循环"/>
        <ComboBoxItem Content="UDS 请求"/>
        <ComboBoxItem Content="调用公共流程"/>
       </ComboBox>
       <TextBlock Text="目标 / 资源" Style="{StaticResource AT.FieldLabel}"/>
       <TextBox Text="{Binding SelectedStep.Target,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        ToolTip="这里只编辑界面演示文本，不生成 TEST Mapping"/>
       <TextBlock Text="参数（演示）" Style="{StaticResource AT.FieldLabel}"/>
       <TextBox Text="{Binding SelectedStep.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="说明" Style="{StaticResource AT.FieldLabel}"/>
       <TextBox Text="{Binding SelectedStep.Note,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Height="105" TextWrapping="Wrap" AcceptsReturn="True"
        VerticalContentAlignment="Top"/>
       <Border Background="{StaticResource AT.AccentWash}" CornerRadius="8"
        Padding="11" Margin="0,20,0,8">
        <TextBlock Text="仅 UI 展示：没有正式 StepNode、资源绑定或执行能力。"
         Foreground="#2E6CA6" TextWrapping="Wrap" FontSize="11"/>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
