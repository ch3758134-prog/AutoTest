<Window x:Class="AutoTest.Desktop.Shell.ProductionPreparationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="工位设置" Width="1020" Height="770" MinWidth="760" MinHeight="550"
 WindowStartupLocation="CenterOwner" Background="#F6F8FB"
 FontFamily="Microsoft YaHei" FontSize="13">
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DEE6ED"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="9"/>
   <Setter Property="Padding" Value="16"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#21384C"/>
   <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style x:Key="SmallHint" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#657C90"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="Margin" Value="0,0,10,8"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Margin" Value="0,2,17,5"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 </Window.Resources>
 <Grid Margin="20,15,20,12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="真实整组实测" Click="Engineering_Click"
      ToolTip="打开已有工程实测执行器。真实夹具和烧录仍需要明确许可。"/>
    <Button Content="返回生产检测" Click="Production_Click"
      ToolTip="正式生产在实体 START/记录适配器接通前保持阻断。"/>
    <Button x:Name="ApplyButton" Content="应用到工位" Click="Apply_Click"
      Padding="17,8" Background="#266BB4" BorderBrush="#266BB4"
      Foreground="White" FontWeight="SemiBold"/>
    <Button Content="关闭" Click="Close_Click"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="工位设置" FontSize="21" FontWeight="SemiBold" Foreground="#243B51"/>
    <TextBlock Text="工程 · 扫码 · 夹具" Style="{StaticResource SmallHint}"/>
   </StackPanel>
  </DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
    HorizontalScrollBarVisibility="Disabled">
   <StackPanel MaxWidth="1050">
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="当前工程" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="ProjectSummary" Text="尚未打开 ECU 工程" FontSize="15"
        TextWrapping="Wrap" Foreground="#304D64" Margin="0,0,0,10"/>
      <WrapPanel>
       <Button Content="使用当前打开的工程" Click="BindCurrent_Click"/>
       <Button Content="选择其他工程…" Click="SelectProject_Click"/>
       <Button Content="编辑 TEST" Click="Test_Click"/>
       <Button Content="编辑 FLASH" Click="Flash_Click"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="扫码枪" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="ScannerState" Text="检查扫码设备…" Style="{StaticResource SmallHint}"
        Margin="0,0,0,6"/>
      <TextBlock Text="最近收到的原始内容" Style="{StaticResource SmallHint}"/>
      <TextBlock x:Name="ScanRaw" FontSize="19" FontWeight="SemiBold"
        Foreground="#245F8B" TextWrapping="Wrap" Text="等待扫码…" Margin="0,3,0,10"/>
      <WrapPanel>
       <Button Content="重新检测" Click="RetryScanner_Click"/>
       <Button Content="设备设置…" Click="ScannerSettings_Click"/>
       <TextBox x:Name="ScanTrial" Width="220" ToolTip="可输入编号进行规则试算；不授权生产身份或物理动作"/>
       <Button Content="试算编号" Click="Preview_Click"/>
      </WrapPanel>
      <TextBlock x:Name="PreviewStatus" Style="{StaticResource SmallHint}"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="扫码如何选择工程" Style="{StaticResource SectionTitle}"/>
      <ComboBox x:Name="MatchMode" Width="350" HorizontalAlignment="Left"
        Margin="0,0,0,8" SelectionChanged="ConfigChanged">
       <ComboBoxItem Content="固定工程 · 整串作为 ECU 唯一编号"/>
       <ComboBoxItem Content="混线 · 从条码提取产品识别码"/>
       <ComboBoxItem Content="混线 · 从受控编号表查询归属"/>
      </ComboBox>
      <TextBlock Text="固定工程不要求填写 ECU 型号、硬件版本或提前登记每台 ECU。"
       Style="{StaticResource SmallHint}"/>
      <Expander Header="混线匹配配置（只有检测不同工程时才需要）"
        x:Name="MixedOptions" Margin="0,9,0,0">
       <StackPanel Margin="0,12,0,0">
        <TextBlock Text="产品识别码 → 工程（必须唯一）" FontWeight="SemiBold"
         Margin="0,0,0,7"/>
        <WrapPanel>
         <TextBox x:Name="ProductKeyInput" Width="135" ToolTip="条码可解析的产品识别码，例如 P01"/>
         <TextBox x:Name="HardwareInput" Width="130" ToolTip="可选的硬件版本；与条码中的字段匹配"/>
         <Button Content="绑定当前工程" Click="AddMixedProject_Click"/>
         <Button Content="删除选中绑定" Click="RemoveMixedProject_Click"/>
        </WrapPanel>
        <DataGrid x:Name="ProjectMappings" Height="130" AutoGenerateColumns="False"
          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
          Margin="0,0,0,9">
         <DataGrid.Columns>
          <DataGridTextColumn Header="产品识别码" Binding="{Binding ProductKey}" Width="130"/>
          <DataGridTextColumn Header="硬件版本" Binding="{Binding HardwareCode}" Width="95"/>
          <DataGridTextColumn Header="工程 ID" Binding="{Binding ProjectId}" Width="235"/>
          <DataGridTextColumn Header="工程路径" Binding="{Binding ManifestPath}" Width="*"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="条码解析规则" FontWeight="SemiBold" Margin="0,5,0,7"/>
        <WrapPanel>
         <TextBlock Text="分隔符" VerticalAlignment="Center" Margin="0,0,5,0"/>
         <TextBox x:Name="SeparatorInput" Width="58" Text="|" TextChanged="ConfigChanged"/>
         <TextBlock Text="产品字段序号" VerticalAlignment="Center" Margin="0,0,5,0"/>
         <TextBox x:Name="ProductIndexInput" Width="55" Text="1" TextChanged="ConfigChanged"/>
         <TextBlock Text="序列号字段序号" VerticalAlignment="Center" Margin="0,0,5,0"/>
         <TextBox x:Name="SerialIndexInput" Width="55" Text="2" TextChanged="ConfigChanged"/>
          <TextBlock Text="硬件版本字段（可选）" VerticalAlignment="Center" Margin="8,0,5,0"/>
          <TextBox x:Name="HardwareIndexInput" Width="55" Text="0"
            ToolTip="0 表示条码没有硬件版本字段；区分同产品不同版本时填实际字段序号"
            TextChanged="ConfigChanged"/>
        </WrapPanel>
        <TextBlock Text="验证样例（混线规则需要一个正确样例和一个应拒绝样例）"
         Style="{StaticResource SmallHint}"/>
        <WrapPanel Margin="0,6,0,0">
         <TextBox x:Name="PositiveSample" Width="220" ToolTip="真实或明确已知正确的产品编号"/>
         <TextBox x:Name="NegativeSample" Width="220" ToolTip="必须被规则拒绝的编号"/>
        </WrapPanel>
        <TextBlock Text="编号登记表（仅编号本身没有产品识别字段时使用）"
         FontWeight="SemiBold" Margin="0,6,0,5"/>
        <Button Content="导入受控 CSV…" Click="ImportRegistry_Click" HorizontalAlignment="Left"/>
        <TextBlock x:Name="RegistrySummary" Text="未导入编号表" Style="{StaticResource SmallHint}"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="工位夹具" Style="{StaticResource SectionTitle}"/>
      <TextBlock Text="扫码和应用配置都不会直接驱动夹具。真实动作由手动台架或经过授权的执行器控制。"
       Style="{StaticResource SmallHint}" Margin="0,0,0,10"/>
      <WrapPanel>
       <CheckBox x:Name="AutoClamp" Content="自动压紧/释放" Checked="ConfigChanged" Unchecked="ConfigChanged"/>
       <CheckBox x:Name="Clamp1" Content="夹具输出 1" Checked="ConfigChanged" Unchecked="ConfigChanged"/>
       <CheckBox x:Name="Clamp2" Content="夹具输出 2" Checked="ConfigChanged" Unchecked="ConfigChanged"/>
       <ComboBox x:Name="FirstClampChoice" Width="130" SelectionChanged="ConfigChanged">
        <ComboBoxItem Content="先夹具 1"/><ComboBoxItem Content="先夹具 2"/>
       </ComboBox>
      </WrapPanel>
      <Expander Header="实体输入与机械反馈（正式生产安全条件）" Margin="0,8,0,0">
       <StackPanel Margin="0,10,0,0">
        <TextBlock Text="配置文字不能代替实体输入、互锁或夹具到位传感器；没有可信反馈则正式生产不能启动。"
         Style="{StaticResource SmallHint}" Margin="0,0,0,10"/>
        <UniformGrid Columns="2">
         <StackPanel><TextBlock Text="实体 START 输入"/><TextBox x:Name="StartInput"/></StackPanel>
         <StackPanel><TextBlock Text="实体 STOP 输入"/><TextBox x:Name="StopInput"/></StackPanel>
         <StackPanel><TextBlock Text="安全互锁输入"/><TextBox x:Name="InterlockInput"/></StackPanel>
         <StackPanel><TextBlock Text="压紧机械反馈"/><TextBox x:Name="ClosedFeedback"/></StackPanel>
         <StackPanel><TextBlock Text="释放机械反馈"/><TextBox x:Name="OpenFeedback"/></StackPanel>
         <StackPanel>
          <TextBlock Text="机械稳定等待（毫秒）"/>
          <TextBox x:Name="SettleDelayInput" Text="0"/>
         </StackPanel>
        </UniformGrid>
       </StackPanel>
      </Expander>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
     <StackPanel>
      <TextBlock Text="应用版本" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="PublicationState" Foreground="#36546B"
       TextWrapping="Wrap" Text="尚未应用" Margin="0,0,0,8"/>
      <TextBlock x:Name="BlockerState" Style="{StaticResource SmallHint}"
       Text="正式生产仍需物理 START、机械反馈和真实 Inspection 记录。"/>
      <Button x:Name="ResetOldConfig" Content="重新建立工位配置（不兼容旧版本）"
       Click="ResetOld_Click" Visibility="Collapsed" HorizontalAlignment="Left"
       Margin="0,9,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="White" BorderBrush="#DEE6ED"
   BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,10,0,0">
   <TextBlock x:Name="StatusText" Foreground="#385D7B" TextWrapping="Wrap"
    Text="工位配置尚未载入"/>
  </Border>
 </Grid>
</Window>