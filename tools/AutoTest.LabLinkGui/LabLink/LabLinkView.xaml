<UserControl x:Class="AutoTest.LabLinkGui.LabLink.LabLinkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="#F4F6FA" FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E1EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="17" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#223148" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="主控板连接" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <Ellipse Width="10" Height="10" Margin="0,3,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#929CAA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#20865F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding DeviceIdentity}" Margin="0,6,0,0" Foreground="#53647A"
                               TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding LastError}" Margin="0,8,10,0" Foreground="#B42318"
                               TextWrapping="Wrap" FontWeight="SemiBold" />
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AwaitingSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="发现多台主控板，请选择一台后再点击连接" Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedBoard}"
                                  DisplayMemberPath="ChoiceLabel" MinWidth="300" MaxWidth="740" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding ConnectionCommand}"
                        Content="{Binding ConnectionLabel}" MinWidth="150" Height="43"
                        Background="#2263CC" Foreground="White" BorderThickness="0"
                        VerticalAlignment="Top" Margin="22,0,0,0" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="160" />
                </Grid.RowDefinitions>
                <Grid Margin="16,14,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="操作日志" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Margin="0,0,9,0" MinHeight="32"
                             ToolTip="按操作信息、设备身份、错误阶段、Win32、SEQ 或 Trace 过滤" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}"
                              Width="105" Margin="0,0,10,0" />
                    <Button Grid.Column="3" Content="复制" Command="{Binding CopyCommand}" />
                    <Button Grid.Column="4" Content="导出" Command="{Binding ExportCommand}" />
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding LogsView}" SelectedItem="{Binding SelectedLog}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    CanUserAddRows="False" CanUserDeleteRows="False" Background="White"
                    BorderThickness="0" RowHeight="33" ColumnHeaderHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="175" />
                        <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="110" />
                        <DataGridTextColumn Header="操作 / 请求 / 响应 / 结果" Binding="{Binding Message}" Width="*" />
                        <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="160" />
                        <DataGridTextColumn Header="Win32" Binding="{Binding Win32Text}" Width="145" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Margin="16,10,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="详细 Trace / 原始数据（选中日志查看）" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox Grid.Row="1" Text="{Binding SelectedLog.Detail, Mode=OneWay}"
                             FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#F7F9FC" BorderBrush="#D9E1EB" Padding="8" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

