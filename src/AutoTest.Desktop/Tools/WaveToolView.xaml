<UserControl x:Class="AutoTest.Desktop.Tools.WaveToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="850" MinHeight="530" Background="#121A27"
             Foreground="#DCE7F4" FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1B2636" />
        <SolidColorBrush x:Key="BorderBrush" Color="#354359" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="Background" Value="#293D53" />
            <Setter Property="Foreground" Value="#EFF5FE" />
            <Setter Property="BorderBrush" Value="#4D637C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinWidth" Value="74" />
        </Style>
        <Style TargetType="TextBlock" x:Key="MetricLabel">
            <Setter Property="Foreground" Value="#92A7C0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="波形采集与判定" FontSize="22" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Signal  " Foreground="#7F9AB6" />
                    <TextBlock Text="{Binding Signal}" FontWeight="SemiBold" />
                    <TextBlock Text="    ·    数据来源  " Foreground="#7F9AB6" />
                    <TextBlock Text="{Binding Origin}" />
                    <TextBlock Text="    ·    时间质量  " Foreground="#7F9AB6" />
                    <TextBlock Text="{Binding Quality}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="WAVE" VerticalAlignment="Top"
                       FontWeight="SemiBold" Foreground="#69BCDD" />
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="7"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="11"
                Margin="0,0,0,12">
            <WrapPanel>
                <Button Command="{Binding StartCommand}" Content="▶  开始采集" />
                <Button Command="{Binding StopCommand}" Content="■  停止" />
                <Button Command="{Binding MarkReferenceCommand}" Content="◇  保存参考" />
                <Button Command="{Binding ReplayCommand}" Content="↺  回放" />
                <Button Command="{Binding CompareCommand}" Content="◎  对比判定" />
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.22*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,12,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="3,2,3,10">
                        <TextBlock Text="采样曲线" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="━ 实测" Foreground="#4BD1EB" Margin="12,0,0,0" />
                            <TextBlock Text="━ 参考" Foreground="#F3C46A" Margin="12,0,0,0" />
                            <TextBlock Text="┄ 容差" Foreground="#9FB4D8" Margin="12,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#111B2A" BorderBrush="#2F4159"
                            BorderThickness="1" CornerRadius="5">
                        <Viewbox Stretch="Uniform">
                            <Canvas Width="950" Height="365" ClipToBounds="True">
                                <Rectangle Canvas.Left="44" Canvas.Top="42" Width="866" Height="286"
                                           Stroke="#49617C" StrokeThickness="1" />
                                <Line X1="44" X2="910" Y1="113" Y2="113" Stroke="#2E3E52" />
                                <Line X1="44" X2="910" Y1="185" Y2="185" Stroke="#2E3E52" />
                                <Line X1="44" X2="910" Y1="256" Y2="256" Stroke="#2E3E52" />
                                <Line X1="260" X2="260" Y1="42" Y2="328" Stroke="#2E3E52" />
                                <Line X1="477" X2="477" Y1="42" Y2="328" Stroke="#2E3E52" />
                                <Line X1="693" X2="693" Y1="42" Y2="328" Stroke="#2E3E52" />
                                <TextBlock Canvas.Left="7" Canvas.Top="9" Foreground="#90A7C3"
                                           FontSize="14" Text="值" />
                                <TextBlock Canvas.Left="850" Canvas.Top="338" Foreground="#90A7C3"
                                           FontSize="14" Text="时间 / s" />
                                <TextBlock Canvas.Left="52" Canvas.Top="331" Foreground="#90A7C3"
                                           FontSize="13" Text="{Binding XStart}" />
                                <TextBlock Canvas.Left="465" Canvas.Top="331" Foreground="#90A7C3"
                                           FontSize="13" Text="{Binding XMid}" />
                                <TextBlock Canvas.Left="782" Canvas.Top="331" Foreground="#90A7C3"
                                           FontSize="13" Text="{Binding XEnd}" />
                                <TextBlock Canvas.Left="48" Canvas.Top="19" Foreground="#90A7C3"
                                           FontSize="13" Text="{Binding YMax}" />
                                <TextBlock Canvas.Left="48" Canvas.Top="295" Foreground="#90A7C3"
                                           FontSize="13" Text="{Binding YMin}" />
                                <Polyline Points="{Binding UpperTolerancePoints}" Stroke="#718AAD"
                                          StrokeThickness="1.5" StrokeDashArray="4,5" />
                                <Polyline Points="{Binding LowerTolerancePoints}" Stroke="#718AAD"
                                          StrokeThickness="1.5" StrokeDashArray="4,5" />
                                <Polyline Points="{Binding ReferencePoints}" Stroke="#F3C46A"
                                          StrokeThickness="2.8" />
                                <Polyline Points="{Binding LivePoints}" Stroke="#4BD1EB"
                                          StrokeThickness="2.8" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <Grid Grid.Row="2" Margin="2,13,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MetricLabel}" Text="参考波形" />
                            <TextBlock Text="{Binding ReferenceName}" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource MetricLabel}" Text="采样点数" />
                            <TextBlock Text="{Binding SampleCount}" FontWeight="Medium" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="判定结果" Foreground="#96ABC2" />
                        <TextBlock Text="{Binding Verdict}" FontSize="26" FontWeight="Bold"
                                   Foreground="#F3C46A" Margin="0,5,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource MetricLabel}" Text="覆盖率" />
                                <TextBlock Text="{Binding Coverage}" FontSize="18" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource MetricLabel}" Text="对齐偏移" />
                                <TextBlock Text="{Binding Offset}" FontSize="18" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                        Margin="0,12,0,0" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="采样检查" FontWeight="SemiBold"
                                   Margin="5,4,4,9" />
                        <DataGrid ItemsSource="{Binding Readings}" AutoGenerateColumns="False"
                                  Background="#1B2636" Foreground="#DCE7F4"
                                  BorderThickness="0" HeadersVisibility="Column"
                                  RowBackground="#1B2636" AlternatingRowBackground="#253449"
                                  GridLinesVisibility="None" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="t / s" Binding="{Binding Seconds, StringFormat=F3}" Width="*" />
                                <DataGridTextColumn Header="实测" Binding="{Binding Actual, StringFormat=F3}" Width="*" />
                                <DataGridTextColumn Header="参考" Binding="{Binding Reference, StringFormat=F3}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="4,11,0,0" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock Text="●" Foreground="#F3C46A" Margin="0,0,9,0" />
                <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
