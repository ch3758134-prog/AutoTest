<UserControl x:Class="AutoTest.Desktop.Shell.SerialScannerSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource UiFont}" FontSize="12" Background="#FAFBFC">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Grid.Row="0" Text="USB 串口扫码枪" FontSize="20"
             FontWeight="SemiBold" Foreground="#1C2B39" Margin="0,0,0,15"/>
  <Border Grid.Row="1" Background="White" BorderBrush="#DEE5EC"
          BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="设备连接" FontSize="14" FontWeight="SemiBold"
               Foreground="#1C2B39" Margin="0,0,0,9"/>
    <WrapPanel>
     <ComboBox Width="145" ItemsSource="{Binding AvailablePorts}"
               SelectedItem="{Binding SelectedPort,Mode=TwoWay}"
               IsEnabled="{Binding CanEditConnection}" Margin="0,0,8,0"/>
     <ComboBox Width="120" ItemsSource="{Binding SupportedBaudRates}"
               SelectedItem="{Binding BaudRate,Mode=TwoWay}"
               IsEnabled="{Binding CanEditConnection}" Margin="0,0,8,0"/>
     <Button Content="刷新端口" Command="{Binding RefreshPortsCommand}"
             Margin="0,0,8,0" Padding="14,7"/>
     <Button Content="连接" Command="{Binding ConnectCommand}"
             Margin="0,0,8,0" Padding="18,7" IsEnabled="{Binding CanEditConnection}"/>
     <Button Content="断开" Command="{Binding DisconnectCommand}"
             Padding="18,7" IsEnabled="{Binding IsConnected}"/>
    </WrapPanel>
    <WrapPanel Margin="0,10,0,0">
     <Button Content="绑定已试扫设备" Command="{Binding BindScannerDeviceCommand}"
      Padding="12,6" Margin="0,0,8,0"
      ToolTip="首次连接并成功读取真实条码后，将该 USB 设备实例绑定到当前工位；之后自动查找其 COM"/>
     <Button Content="更换扫码枪" Command="{Binding ReplaceScannerDeviceCommand}"
      Padding="12,6" Margin="0,0,8,0"
      ToolTip="先断开再更换；不允许把其它 COM 当成已绑定扫码枪"/>
     <TextBlock Text="{Binding DeviceStatus}" VerticalAlignment="Center"
      Foreground="#526D87" TextWrapping="Wrap" MaxWidth="620"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Border Grid.Row="2" Background="White" BorderBrush="#DEE5EC"
          BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="条码解析规则 · 工位设置" FontSize="14" FontWeight="SemiBold"
               Foreground="#1C2B39" Margin="0,0,0,5"/>
    <TextBlock Text="设备连接只是接收字节；解析规则决定从标签提取型号和唯一编号。不要根据工程名称或号码前缀自动猜测。"
               Foreground="#65798A" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <WrapPanel VerticalAlignment="Center">
     <StackPanel Width="270" Margin="0,0,10,8">
      <TextBlock Text="条码格式" Foreground="#617280"/>
      <ComboBox ItemsSource="{Binding IdentityFormats}" DisplayMemberPath="Label"
                SelectedValuePath="Mode" SelectedValue="{Binding IdentityFormat,Mode=TwoWay}"
                Margin="0,4,0,0" MinHeight="28"/>
     </StackPanel>
     <StackPanel Width="94" Margin="0,0,10,8">
      <TextBlock Text="分隔符" Foreground="#617280"/>
      <TextBox Text="{Binding IdentitySeparator,UpdateSourceTrigger=PropertyChanged}"
               Margin="0,4,0,0" Padding="6,5" ToolTip="仅用于型号+编号模式，可选 -、|、:、/"/>
     </StackPanel>
     <StackPanel Width="188" Margin="0,0,10,8">
      <TextBlock Text="固定型号（纯编号模式）" Foreground="#617280"/>
      <TextBox Text="{Binding FixedModelCode,UpdateSourceTrigger=PropertyChanged}"
               Margin="0,4,0,0" Padding="6,5"
               ToolTip="必须是已登记到本工位的唯一 ECU 型号"/>
     </StackPanel>
     <StackPanel Width="90" Margin="0,0,10,8">
      <TextBlock Text="编号最短" Foreground="#617280"/>
      <TextBox Text="{Binding MinimumSerialLength,UpdateSourceTrigger=PropertyChanged}"
               Margin="0,4,0,0" Padding="6,5"/>
     </StackPanel>
     <StackPanel Width="90" Margin="0,0,10,8">
      <TextBlock Text="编号最长" Foreground="#617280"/>
      <TextBox Text="{Binding MaximumSerialLength,UpdateSourceTrigger=PropertyChanged}"
               Margin="0,4,0,0" Padding="6,5"/>
     </StackPanel>
    </WrapPanel>
    <DockPanel Margin="0,3,0,0" LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
      <Button Content="试解析" Command="{Binding TestIdentitySampleCommand}"
              Padding="12,6" Margin="0,0,8,0"/>
      <Button Content="保存规则" Command="{Binding SaveIdentityPolicyCommand}" Padding="12,6"/>
     </StackPanel>
     <TextBox Text="{Binding SampleRaw,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
              Padding="8,6" ToolTip="粘贴或录入真实标签内容，仅做离线解析测试"
              MinHeight="28"/>
    </DockPanel>
    <TextBlock Text="{Binding SampleResult}" Foreground="#396580" TextWrapping="Wrap" Margin="0,7,0,0"/>
    <TextBlock Text="{Binding IdentityPolicyStatus}" Foreground="#667987" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <TextBlock Text="UT1 校验 CRC；型号-编号模式按明确分隔符解析；纯编号模式必须先登记唯一型号工程。每次扫码仅生成身份候选，不能触发夹具、START、烧录或计数。"
               Foreground="#70818E" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/>
                           <ColumnDefinition Width="12"/>
                           <ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#DEE5EC"
           BorderThickness="1" CornerRadius="8" Padding="14">
    <StackPanel>
     <TextBlock Text="当前 ECU 工程" FontSize="14" FontWeight="SemiBold"
                Foreground="#1C2B39" Margin="0,0,0,10"/>
     <TextBlock Text="{Binding ProjectName}" FontSize="14" FontWeight="Medium"
                Margin="0,0,0,10" TextWrapping="Wrap"/>
     <TextBlock Text="ECU 型号代码" Foreground="#697986" Margin="0,0,0,4"/>
     <TextBox Text="{Binding ModelCode,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
              Padding="8,7" Margin="0,0,0,10"/>
     <WrapPanel>
      <Button Content="保存工程型号" Command="{Binding SaveModelCodeCommand}"
              Padding="12,9" Margin="0,0,8,0"/>
      <Button Content="登记到本工位" Command="{Binding RegisterModelCommand}"
              Padding="12,9"/>
     </WrapPanel>
     <TextBlock Text="每个正式 ECU 型号在工位只允许登记一份工程；重复型号会拒绝登记。"
                Foreground="#607381" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#DEE5EC"
           BorderThickness="1" CornerRadius="8" Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <TextBlock Text="最近一次扫描" FontSize="14" FontWeight="SemiBold"
                Foreground="#1C2B39" Margin="0,0,0,10"/>
     <TextBlock Text="原始条码" Foreground="#697986"/>
     <TextBox Text="{Binding LastRaw,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
              MinHeight="50" Padding="6,4" Margin="0,4,0,10"/>
     <TextBlock Text="串口原始 HEX" Foreground="#697986"/>
     <TextBox Text="{Binding LastHex,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
              FontSize="11" MaxHeight="52" Padding="6,4" Margin="0,4,0,8"/>
     <TextBlock Text="型号" Foreground="#697986"/>
     <TextBlock Text="{Binding LastModel}" Margin="0,2,0,8"/>
     <TextBlock Text="唯一编号" Foreground="#697986"/>
     <TextBlock Text="{Binding LastSerial}" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding LastDecision}" Foreground="#526A80"
                Margin="0,12,0,0"/>
     <TextBlock Text="{Binding MatchedProjectName}" FontWeight="SemiBold"
                Margin="0,7,0,7" TextWrapping="Wrap"/>
     <WrapPanel>
      <Button Content="切换到匹配工程" Command="{Binding SwitchProjectCommand}"
              IsEnabled="{Binding CanSwitchProject}" Padding="10,7"
              Margin="0,0,8,7"/>
      <Button Content="生产配置预检" Command="{Binding PrepareProductionCommand}"
              Padding="10,7" Margin="0,0,0,7"/>
     </WrapPanel>
     <TextBlock Text="{Binding ProductionPreview}" Foreground="#375B73"
                TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="4" Background="#EDF3F6" CornerRadius="6"
          Padding="10" Margin="0,12,0,0">
   <TextBlock Text="{Binding Status}" Foreground="#314F63"
              TextWrapping="Wrap" FontSize="12"/>
  </Border>
 </Grid>
</UserControl>