  /*********************************************************************************************
*函数名    :
*功能      :CAN使能
*输入      :
*返回      :
*备注      :
*日期      :
**********************************************************************************************/
void Drv_CAN_Enable(void)
{ 
    // 将INITRQ位设置为0，请求CAN模块进入正常运行模式
    CANCTL0_INITRQ = 0x00;             
    // 等待INITAK位变为0，表示CAN模块已经进入正常运行模式
    while(CANCTL1_INITAK) {}  
}

/*********************************************************************************************
*函数名    :
*功能      :CAN禁止
*输入      :
*返回      :
*备注      :
*日期      :
**********************************************************************************************/
void Drv_CAN_Disable(void)
{ 
    // 将INITRQ位设置为1，请求CAN模块进入初始化模式
    CANCTL0_INITRQ = 0x01;             
    // 等待INITAK位变为1，表示CAN模块已经进入初始化模式
    while(!CANCTL1_INITAK) {}   
}

/*********************************************************************************************
*函数名    :
*功能      :CAN RX 中断
*输入      :
*返回      :
*备注      :
*日期      :
**********************************************************************************************/
CanMsgInf CanMsg;
ISR(Drv_CAN_RX_ISR) //CAN RX中断
{
    while(CANRFLG_RXF == 1) {
        
        // 调用 Drv_CAN_ReadFrame 函数读取 CAN 总线上的一帧数据，并将读取到的数据存储在 CanMsg 结构体中
        Drv_CAN_ReadFrame(&CanMsg);
        canMessageReceivedFlag = 1;
    }
}

