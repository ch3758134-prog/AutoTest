<UserControl x:Class="AutoTest.Desktop.Testing.DbcReferencePicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12"
 Background="Transparent" Foreground="#223C58">
 <StackPanel>
  <Button x:Name="SelectionButton" Click="SelectionButton_Click"
   Background="White" BorderBrush="#CEDAE8" BorderThickness="1"
   HorizontalContentAlignment="Stretch" MinHeight="56" ToolTip="点击打开资源搜索和选择">
   <Button.Template>
    <ControlTemplate TargetType="Button">
     <Border x:Name="PickerChrome" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
      CornerRadius="7" Padding="10,7">
      <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="PickerChrome" Property="BorderBrush" Value="#71A1D6"/>
       <Setter TargetName="PickerChrome" Property="Background" Value="#F8FBFF"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
       <Setter TargetName="PickerChrome" Property="BorderBrush" Value="#327DD0"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter TargetName="PickerChrome" Property="Opacity" Value="0.55"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Button.Template>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock x:Name="CurrentTitle" FontSize="12" FontWeight="SemiBold"
      Foreground="#254766" TextTrimming="CharacterEllipsis" Text="选择 DBC 对象"/>
     <TextBlock x:Name="CurrentDetail" FontSize="10" Foreground="#75889E"
      TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Text="搜索名称、信号或 CAN ID"/>
    </StackPanel>
    <TextBlock Grid.Column="1" Text="⌄" FontSize="16" Foreground="#65809C"
      VerticalAlignment="Center" HorizontalAlignment="Right"/>
   </Grid>
  </Button>
  <!-- Inline expansion avoids a detached OS popup whose focus and position
       can drift when the inspector scrolls or the app changes window size. -->
  <Border x:Name="ChoicePanel" Visibility="Collapsed" MaxHeight="344"
   Background="White" BorderBrush="#D4E1EF" BorderThickness="1"
   CornerRadius="7" Padding="9" Margin="0,5,0,2">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Grid.Row="0" BorderBrush="#CFDBE9" Background="#F8FBFE"
      BorderThickness="1" CornerRadius="6" Margin="0,0,0,7">
      <DockPanel Margin="9,0,7,0">
       <Button DockPanel.Dock="Right" Content="清除" Click="ClearSearch_Click"
        Background="Transparent" BorderThickness="0" Foreground="#5F819E"
        FontSize="11" Padding="5,4" ToolTip="清除搜索文本"/>
       <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="18" Foreground="#6A8BAA"
        VerticalAlignment="Center" Margin="0,0,6,0"/>
       <Grid>
        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
         PreviewKeyDown="SearchBox_PreviewKeyDown" MinHeight="32"
         BorderThickness="0" Background="Transparent" Padding="0,4"
         ToolTip="输入中文别名、信号名、报文名或 CAN ID"/>
        <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False"
         Text="搜索 DBC 报文或信号、CAN ID…" Foreground="#9BAABC"
         VerticalAlignment="Center" Margin="2,0,0,0"/>
       </Grid>
      </DockPanel>
     </Border>
     <TextBlock Grid.Row="1" x:Name="ResultCount" FontSize="10"
      Foreground="#768A9F" Margin="3,0,0,7"/>
     <ListBox Grid.Row="2" x:Name="ResultsList" MaxHeight="260"
      BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Result_MouseUp"/>
        <Style.Triggers>
         <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F0F6FD"/>
         </Trigger>
         <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E8F2FF"/>
          <Setter Property="BorderBrush" Value="#C5DFF9"/>
         </Trigger>
        </Style.Triggers>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel ToolTip="{Binding FullDetail}">
         <DockPanel>
          <TextBlock Text="{Binding KindLabel}" DockPanel.Dock="Right"
           FontSize="10" Foreground="#7D8FA3" Margin="6,1,0,0"/>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
           FontSize="12" Foreground="#274B70" TextTrimming="CharacterEllipsis"/>
         </DockPanel>
         <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#6B8097"
          TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Grid.Row="3" FontSize="10" Foreground="#8394A6"
      Text="↑↓ 选择  ·  Enter 确认  ·  Esc 取消"
      Margin="3,7,0,1"/>
    </Grid>
  </Border>
 </StackPanel>
</UserControl>