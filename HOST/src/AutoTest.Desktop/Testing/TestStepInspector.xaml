<UserControl x:Class="AutoTest.Desktop.Testing.TestStepInspector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#FBFCFF" Foreground="#1E2C41" FontFamily="{StaticResource UiFont}"
 FontSize="13" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12,9,12,11">
    <DockPanel Margin="0,0,0,8" LastChildFill="True">
     <Border DockPanel.Dock="Left" Background="#E8EFF9" CornerRadius="5"
      Width="27" Height="27" Margin="0,0,8,0">
      <TextBlock x:Name="TypeIcon" Text="▣" Foreground="#386EA9" FontSize="13"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock x:Name="StepCode" DockPanel.Dock="Right" Visibility="Collapsed" Foreground="#8798AC"
      VerticalAlignment="Center" FontFamily="Consolas" FontSize="10"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="Heading" Text="编辑步骤" Visibility="Collapsed" Foreground="#26476D"
       FontWeight="SemiBold" FontSize="12"/>
      <TextBlock x:Name="TypeLabel" Foreground="#26476D" FontSize="13" FontWeight="SemiBold"/>
     </StackPanel>
    </DockPanel>
    <!-- Editing existing StepId only. New action selection belongs exclusively to
         the central editor's grouped ActionPalette; no second type list here. -->
    <TextBlock x:Name="ActionDescription" TextWrapping="Wrap" Foreground="#64758C"
     FontSize="11" Margin="0,0,0,6" Visibility="Collapsed"/>
    <TextBlock x:Name="ImportWarning"
     Text="该步骤来自旧版文件，尚未完成可执行参数验证。旧文件信息已保留，但不会作为可编辑参数展示；实测前请重新核对操作对象及判定条件。"
     TextWrapping="Wrap" Foreground="#9B6423" FontSize="11"
     Margin="0,0,0,10" Visibility="Collapsed"/>
    <Button x:Name="ConvertImportedAssertionButton" Content="按当前 DBC 重建 CAN 判定"
     Click="ConvertImportedAssertion_Click" Visibility="Collapsed"
     HorizontalAlignment="Left" Margin="0,0,0,12" Padding="10,6"
     ToolTip="只转换当前旧版 CAN 判定；必须选择 CAN ID 匹配的真实 DBC 信号，并核对原位长、字节序、判定值和超时。转换后此步骤参与执行。"/>
    <DockPanel Margin="0,0,0,12" LastChildFill="True">
      <CheckBox x:Name="StepEnabledInput" DockPanel.Dock="Right" Content="启用"
       Margin="10,14,0,0" VerticalAlignment="Top" IsChecked="True"
       ToolTip="关闭后运行时跳过；步骤仍保留。"/>
      <StackPanel>
       <TextBlock Text="名称" Foreground="#61738B" FontWeight="SemiBold"
        FontSize="11" Margin="0,0,0,4"/>
       <TextBox x:Name="NameInput" MinHeight="34"/>
      </StackPanel>
     </DockPanel>
    <StackPanel x:Name="PublicFlowPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="调用公共流程" Foreground="#61738B" FontWeight="SemiBold"
      FontSize="11" Margin="0,0,0,5"/>
     <ComboBox x:Name="PublicFlowPicker" ItemsSource="{Binding AvailableFlowChoices}"
      DisplayMemberPath="Label" MinHeight="34"/>
     <TextBlock x:Name="PublicFlowReferenceStatus" TextWrapping="Wrap"
      Foreground="#A96D20" FontSize="10" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel x:Name="TargetPanel" Margin="0,0,0,13">
     <TextBlock Text="选择报文、信号或资源" Foreground="#61738B"
      FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
     <TextBox x:Name="TargetSearch" TextChanged="TargetSearch_Changed"
      ToolTip="搜索报文、信号或 KEY 动作"
      Margin="0,0,0,5"/>
     <ComboBox x:Name="TargetPicker" ItemsSource="{Binding AvailableTargets}"
      DisplayMemberPath="Label" MinHeight="34"
      SelectionChanged="TargetPicker_Changed"/>
     <TextBlock x:Name="TargetHint" Visibility="Collapsed" Foreground="#64758C" FontSize="11"
      TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>

    <!-- CAN-only authoring: one report, one data payload, one send schedule.
         Normal step types retain their existing TargetPanel and ParameterList. -->
    <StackPanel x:Name="CanSendPanel" Visibility="Collapsed" Margin="0,2,0,15">
     <Border Background="White" BorderBrush="#DCE5EF" BorderThickness="1"
       CornerRadius="8" Padding="11" Margin="0,0,0,9">
      <StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Border Background="#EAF3FE" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
         <TextBlock Text="01" FontWeight="SemiBold" Foreground="#2B6CA9" FontSize="11"/>
        </Border>
        <TextBlock Text="选择发送报文" FontWeight="SemiBold" Foreground="#243F5E"
          FontSize="13" VerticalAlignment="Center"/>
       </StackPanel>
       <TextBox x:Name="CanTargetSearch" TextChanged="TargetSearch_Changed"
         ToolTip="搜索 DBC 中文名称、原始名称或 CAN ID"
         MinHeight="30" Margin="0,0,0,6"/>
       <ComboBox x:Name="CanTargetPicker" ItemsSource="{Binding AvailableTargets}"
          DisplayMemberPath="Label" MinHeight="32" MaxDropDownHeight="350"
          SelectionChanged="TargetPicker_Changed"
          ToolTip="选择当前 DBC 的报文，也可以选择无 DBC 原始报文"/>
       <TextBlock x:Name="CanTargetHint" TextWrapping="Wrap"
          Foreground="#6B7E94" FontSize="11" Margin="0,7,0,0"/>
       <Button x:Name="CanRebindButton" Content="使用当前 DBC 版本重新绑定"
         Click="CanRebind_Click" Visibility="Collapsed" HorizontalAlignment="Left"
         Margin="0,7,0,0" Padding="8,5" ToolTip="仅在明确点击后替换旧资源修订"/>
      </StackPanel>
     </Border>

     <Border x:Name="CanDataCard" Background="White" BorderBrush="#DCE5EF"
       BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,9">
      <StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
        <Border Background="#EAF3FE" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
         <TextBlock Text="02" FontWeight="SemiBold" Foreground="#2B6CA9" FontSize="11"/>
        </Border>
        <TextBlock Text="编辑报文内容" FontWeight="SemiBold" Foreground="#243F5E"
          FontSize="13" VerticalAlignment="Center"/>
       </StackPanel>
    <StackPanel x:Name="RawCanPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="自行指定 CAN ID 和数据" Foreground="#4B6382" FontWeight="SemiBold"
      FontSize="11" Margin="0,0,0,8"/>
     <TextBlock Text="CAN ID · 16 进制" Foreground="#61738B" FontSize="11" Margin="0,0,0,5"/>
     <TextBox x:Name="FrameIdInput" Margin="0,0,0,8" ToolTip="例如 0x123"/>
     <CheckBox x:Name="ExtendedFrame" Content="29 位扩展 ID" Margin="0,0,0,9"/>
     <TextBlock Text="整帧数据 · HEX（最大 8 字节）" Foreground="#61738B"
      FontSize="11" Margin="0,0,0,5"/>
     <TextBox x:Name="RawCanDataInput" FontFamily="Consolas"
      ToolTip="例如 0102030405060708"/>
    </StackPanel>

    <StackPanel x:Name="DbcCanPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="填写报文信号值" FontSize="11"
      FontWeight="SemiBold" Foreground="#285F9D" Margin="0,0,0,7"/>
     <Border Background="#F5F8FC" CornerRadius="5" BorderBrush="#E6ECF4"
      BorderThickness="1" Padding="7" Margin="0,0,0,10">
      <TextBlock x:Name="DbcMessageInfo" TextWrapping="Wrap"
       Foreground="#64758C" FontSize="10"/>
     </Border>
     <!-- A 320px Inspector cannot present a four-column native DataGrid clearly.
          Same real SignalValues; direct physical value editing, no hidden table. -->
     <ItemsControl x:Name="SignalGrid" ItemsSource="{Binding SignalValues}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <StackPanel Margin="0,0,0,12">
         <TextBlock Text="{Binding DisplayName}" Foreground="#344F70" FontSize="12"
          FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Definition}"/>
         <TextBlock Text="{Binding Name}" Visibility="Collapsed" ToolTip="{Binding Name}"
           FontSize="10" Foreground="#8597AA"/>
         <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap"
          Foreground="#64758C" Margin="0,2,0,5" ToolTip="{Binding Definition}"/>
         <Grid>
          <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           FontFamily="Consolas" ToolTip="{Binding Range}">
           <TextBox.Style><Style TargetType="TextBox">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True">
             <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger></Style.Triggers>
           </Style></TextBox.Style>
          </TextBox>
          <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
           SelectedValuePath="Value"
           SelectedValue="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           MinHeight="27" ToolTip="{Binding Definition}">
           <ComboBox.Style><Style TargetType="ComboBox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True">
             <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger></Style.Triggers>
           </Style></ComboBox.Style>
          </ComboBox>
         </Grid>
         <TextBlock Text="{Binding Range,StringFormat='范围：{0}'}"
          Foreground="#8493A6" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <CheckBox x:Name="DbcRawMode" Content="直接编辑数据字节（HEX）"
      Checked="DbcRawMode_Changed" Unchecked="DbcRawMode_Changed"
      Margin="0,9,0,6"/>
     <TextBox x:Name="DbcRawDataInput" Visibility="Collapsed" FontFamily="Consolas"
      ToolTip="需与当前 DBC DLC 匹配"/>

    </StackPanel>


       <Border Background="#F5F8FC" BorderBrush="#E3EAF3"
         BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,2,0,0">
        <StackPanel>
         <TextBlock Text="当前发送数据预览" Foreground="#5A6F88" FontSize="10"
           Margin="0,0,0,4"/>
         <TextBlock x:Name="CanFramePreview" FontFamily="Consolas" FontSize="12"
           Foreground="#213F64" TextWrapping="Wrap" Text="待选择报文"/>
         <TextBlock x:Name="CanPreviewIssue" Foreground="#AC5639" FontSize="10"
           TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </Border>

     <Border Background="White" BorderBrush="#DCE5EF" BorderThickness="1"
       CornerRadius="8" Padding="11">
      <StackPanel>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <Border Background="#EAF3FE" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
         <TextBlock Text="03" FontWeight="SemiBold" Foreground="#2B6CA9" FontSize="11"/>
        </Border>
        <TextBlock Text="发送方式" FontWeight="SemiBold" Foreground="#243F5E"
         FontSize="13" VerticalAlignment="Center"/>
       </StackPanel>
       <RadioButton x:Name="CanOnceMode" GroupName="CanSendMode"
         Content="发送一次" Checked="CanSendMode_Changed"
         Margin="0,0,0,8"/>
       <RadioButton x:Name="CanPeriodicMode" GroupName="CanSendMode"
         Content="周期发送" Checked="CanSendMode_Changed" Margin="0,0,0,6"/>
       <StackPanel x:Name="CanPeriodicPanel" Visibility="Collapsed"
         Margin="12,2,0,0">
        <TextBlock Text="发送周期（毫秒）" Foreground="#5C6D85" FontSize="11"
          Margin="0,0,0,4"/>
        <TextBox x:Name="CanPeriodInput" MinHeight="30" Margin="0,0,0,10"
          ToolTip="20～600000 ms"/>
        <TextBlock Text="结束条件" Foreground="#5C6D85" FontSize="11"
         Margin="0,0,0,6"/>
        <RadioButton x:Name="CanTimedStop" GroupName="CanSendStop"
         Content="发送指定时长后自动停止" Checked="CanStopMode_Changed"
         Margin="0,0,0,6"/>
        <StackPanel x:Name="CanTimedDurationPanel" Visibility="Collapsed"
          Margin="14,0,0,9">
         <TextBlock Text="持续时间（毫秒）" FontSize="11" Foreground="#5C6D85"
            Margin="0,0,0,4"/>
         <TextBox x:Name="CanDurationInput" MinHeight="29"
           ToolTip="1～1800000 ms"/>
        </StackPanel>
        <RadioButton x:Name="CanUntilStopped" GroupName="CanSendStop"
         Checked="CanStopMode_Changed" Margin="0,0,0,6">
         <TextBlock Text="持续发送，直到停止步骤或测试清理"
           TextWrapping="Wrap"/>
        </RadioButton>
        <TextBlock Text="周期任务在后台继续，下一测试步骤不会等待其自动结束。"
         FontSize="10" Foreground="#697C93" TextWrapping="Wrap"
         Margin="0,7,0,0"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </StackPanel>

    <StackPanel x:Name="KeyPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="KEY 动作" Foreground="#4B6382" FontWeight="SemiBold"
      FontSize="11" Margin="0,0,0,6"/>

     <ComboBox x:Name="KeyActionInput" SelectionChanged="KeyAction_Changed"
      MinHeight="28" Margin="0,0,0,8">
      <ComboBoxItem Content="按下后释放" Tag="Pulse"/>
      <ComboBoxItem Content="保持按下" Tag="Hold"/>
      <ComboBoxItem Content="恢复／释放" Tag="Release"/>
     </ComboBox>
     <StackPanel x:Name="RawKeyMaskPanel" Visibility="Collapsed">
      <TextBlock Text="20 Key 组合" Foreground="#61738B"
       FontSize="11" Margin="0,0,0,5"/>
      <TextBox x:Name="RawKeyMaskInput" IsReadOnly="True" Visibility="Collapsed" FontFamily="Consolas"
       Margin="0,0,0,8"/>
      <UniformGrid x:Name="RawKeyGrid" Columns="5" Rows="4" Margin="0,0,0,7"/>
      <Button Content="清空选择" Click="ClearRawKeys_Click"
       HorizontalAlignment="Left" Margin="0,0,0,8"/>

     </StackPanel>
     <StackPanel x:Name="KeyDurationPanel">
      <TextBlock Text="保持时间（ms）" Foreground="#61738B" FontSize="11"
       Margin="0,0,0,5"/>
      <TextBox x:Name="KeyDurationInput" Width="150"
       HorizontalAlignment="Left"/>
     </StackPanel>
    </StackPanel>

    <StackPanel x:Name="IgnitionPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="IGN 目标状态" FontWeight="SemiBold" Foreground="#61738B"
      FontSize="11" Margin="0,0,0,6"/>
     <ComboBox x:Name="IgnitionState">
      <ComboBoxItem Content="开启 IGN" Tag="ON"/>
      <ComboBoxItem Content="关闭 IGN" Tag="OFF"/>
     </ComboBox>
    </StackPanel>

    <ItemsControl x:Name="ParameterList" ItemsSource="{Binding ParameterFields}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="0,0,0,11">
        <TextBlock Text="{Binding Label}" Foreground="#61738B" FontSize="11"
         FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid>
         <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
          <TextBox.Style>
           <Style TargetType="TextBox">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding HasChoices}" Value="True">
              <Setter Property="Visibility" Value="Collapsed"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBox.Style>
         </TextBox>
         <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
          SelectedValuePath="Value" SelectedValue="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          MinHeight="28" Padding="6,3">
          <ComboBox.Style>
           <Style TargetType="ComboBox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding HasChoices}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </ComboBox.Style>
         </ComboBox>
        </Grid>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border BorderBrush="#E1E8F2" BorderThickness="0,1,0,0" Margin="0,12,0,8"/>
    <StackPanel x:Name="StepActionsPanel" Visibility="Collapsed"/>

   </StackPanel>
  </ScrollViewer>
  <!-- Sticky apply/cancel at the bottom; edits stay transactional and cancellable. -->
  <Border Grid.Row="1" Background="#FBFCFF" BorderBrush="#DBE3ED"
   BorderThickness="0,1,0,0" Padding="12,8">
   <StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#C04A57" FontSize="10"
     TextWrapping="Wrap" Margin="0,0,0,7"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click"
      MinWidth="70" Margin="0,0,7,0"/>
     <Button x:Name="ConfirmButton" Content="应用"
      Style="{StaticResource AtPrimaryButton}" Click="Confirm_Click" MinWidth="92"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
