<Window x:Class="AutoTest.Desktop.Projects.NewProjectDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="新建 AutoTest 工程" Width="570" Height="445"
 MinWidth="510" MinHeight="420" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="78"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="70"/>
    </Grid.RowDefinitions>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,0,1" Padding="19,15">
      <StackPanel>
        <TextBlock Text="新建工程" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="创建一个独立的、可持久保存的测试工程"
                   Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="19,13">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="工程名称" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <TextBox x:Name="ProjectNameInput"
                 Text="{Binding ProjectName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="100" Margin="0,0,0,14"/>
        <TextBlock Text="保存位置" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <Grid Margin="0,0,0,15">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0"
                   Text="{Binding ParentDirectory,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,0,7,0"/>
          <Button Grid.Column="1" Content="浏览…" MinWidth="79"
                  Command="{Binding BrowseCommand}" Margin="0"/>
        </Grid>
        <TextBlock Text="实际创建路径" Foreground="{StaticResource Subtle}" FontSize="11"
                   Margin="0,0,0,5"/>
        <TextBlock Text="{Binding TargetPath}" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding TargetPath}" FontSize="12"/>
        <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource Danger}"
                   TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"/>
      </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="19,12">
      <DockPanel>
        <TextBlock Text="不覆盖已有工程" DockPanel.Dock="Left"
                   VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    DockPanel.Dock="Right">
          <Button Content="取消" Command="{Binding CancelCommand}"/>
          <Button Content="创建工程" Style="{StaticResource AtPrimaryButton}"
                  Command="{Binding CreateCommand}" IsDefault="True"
                  MinWidth="108" Margin="0"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>