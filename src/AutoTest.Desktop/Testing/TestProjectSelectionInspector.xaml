<UserControl x:Class="AutoTest.Desktop.Testing.TestProjectSelectionInspector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="13,15">
   <TextBlock Text="当前测试项目" FontWeight="SemiBold" Foreground="#64758C" Margin="0,0,0,6"/>
   <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,15"/>
   <TextBlock Text="运行选择" FontWeight="SemiBold" Foreground="#64758C" Margin="0,0,0,6"/>
   <Border Background="#F2F7FC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="10">
    <StackPanel>
     <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" Foreground="#2368BD"/>
     <TextBlock Text="仅临时选择。不会修改工程默认 Enabled，也不会改变生产工序。"
      Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#64758C" FontSize="11"/>
    </StackPanel>
   </Border>
   <Button Content="▷ 检查所选用例" Command="{Binding PreflightSelectedCommand}"
    Style="{StaticResource AtPrimaryButton}" Margin="0,12,0,7"/>
   <TextBlock Text="当前项目级 Run 尚未具备真实设备租约、包间 Cleanup 和完整执行证据；仅检查真实资源引用，不会模拟 PASS。"
    Foreground="#A96D20" TextWrapping="Wrap" Margin="0,0,0,14"/>
   <TextBlock Text="项目属性" FontWeight="SemiBold" Margin="0,0,0,5"/>
   <TextBlock Text="名称（编辑后保存）" Foreground="#64758C" FontSize="11" Margin="0,0,0,4"/>
   <TextBox Text="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
   <TextBlock Text="工程引用（只读）" Foreground="#64758C" FontSize="11" Margin="0,0,0,4"/>
   <TextBox Text="{Binding FilePath}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="1"/>
   <Button Content="保存项目修订" Command="{Binding SaveCommand}" Margin="0,12,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
