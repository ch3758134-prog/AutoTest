<Window x:Class="AutoTest.Desktop.G4.ModuleToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoTest G4-LAB · 模块工作台" Width="1440" Height="900"
        MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="#142131" Foreground="#E6EFFB" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#513B19" Padding="10" Margin="0,0,0,8">
            <TextBlock FontWeight="Bold" Text="软件 Mock / Replay 工作台 · 真实 B0/B1/B2 只读连接需从主窗口 DEVICE 菜单手动打开；本窗口不发送物理输出。"/>
        </Border>
        <TabControl Background="#1B2A40" Foreground="#EAF3FF">
            <TabItem Header="控制器配置"><ContentControl x:Name="ControllerConfigHost"/></TabItem>
            <TabItem Header="DBC 编辑 / Replay"><ContentControl x:Name="DbcHost"/></TabItem>
            <TabItem Header="TEST 编辑 / Mock"><ContentControl x:Name="TestHost"/></TabItem>
            <TabItem Header="SCAN / Production Mock"><ContentControl x:Name="ProductionHost"/></TabItem>
            <TabItem Header="运行历史 / Records"><ContentControl x:Name="RecordsHost"/></TabItem>
            <TabItem Header="操作审计 / Trace"><ContentControl x:Name="OperationsHost"/></TabItem>
            <TabItem Header="UDS / ISO-TP Mock"><ContentControl x:Name="UdsHost"/></TabItem>
            <TabItem Header="Flash / Dry-run"><ContentControl x:Name="FlashHost"/></TabItem>
            <TabItem Header="Wave / CAN Hub Replay"><ContentControl x:Name="WaveHost"/></TabItem>
            <TabItem Header="U-BENCH 状态控制">
                <Grid Margin="28">
                    <StackPanel VerticalAlignment="Top" MaxWidth="920">
                        <TextBlock Text="U-BENCH 控制适配器尚未接入" FontSize="22" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock TextWrapping="Wrap" FontSize="15"
                                   Text="此页不创建伪造的 IBenchWorkbenchPort，也不提供按钮输出。当前可使用主窗口“DEVICE B0/B1/B2 只读诊断”进行设备枚举、人工确认后的手动连接、固件只读查询及被动 CAN 接收。控制器状态执行与测量持久化需在共享 DEVICE / PROJECT / RECORD 适配器接入后开放。"/>
                        <TextBlock Text="Software UI: NOT_CONNECTED · Physical output: DENY" FontFamily="Consolas" Foreground="#FFD28A" Margin="0,20,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
