<Window x:Class="AutoTest.Desktop.Shell.EngineeringVerificationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AutoTest.Desktop.Shell"
 Title="工程整组实测 · 非生产" Width="1180" Height="810"
 MinWidth="740" MinHeight="480" WindowStartupLocation="CenterOwner"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 Background="#F5F7FA" Foreground="#263849" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="EngFact" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="#293D52"/>
  </Style>
  <Style x:Key="EngCaption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#64788B"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style x:Key="EngPanel" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DEE6EF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style x:Key="EngState" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#526A81"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding State}" Value="执行中">
     <Setter Property="Foreground" Value="#1663A5"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="实测通过">
     <Setter Property="Foreground" Value="#19704B"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="实测失败">
     <Setter Property="Foreground" Value="#B42318"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Style="{StaticResource EngPanel}" Padding="14,10" Margin="0,0,0,9">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
     VerticalAlignment="Center" Margin="12,0,0,0">
     <Button Content="重新扫码" Command="{Binding ArmOperatorVerificationCommand}"
      Padding="12,7" Margin="0,0,7,0"
      ToolTip="撤销旧扫码，重新接收本台 ECU 的真实串口扫码身份；不执行 FLASH/TEST"/>
     <Button Content="开始整组实测" Command="{Binding StartOperatorVerificationCommand}"
      Style="{StaticResource AtPrimaryButton}" Padding="12,7" Margin="0,0,7,0"
      ToolTip="扫码后会自动弹出一次真实操作确认；此按钮供扫码确认取消后的人工重试"/>
     <Button Content="扫码枪设置" Command="{Binding OpenScannerSettingsCommand}"
      Padding="12,7" Margin="0,0,7,0"
      ToolTip="首次安装扫码设备时设置一次 COM，正常复测不需要反复进入生产准备"/>
     <Button Content="停止" Command="{Binding StopOperatorVerificationCommand}"
      Padding="12,7" Margin="0,0,7,0" ToolTip="请求停止并执行真实工位收尾，不擅自重试 FLASH"/>
     <Button Content="记录与报告" Click="OpenReports_Click" Padding="12,7" Margin="0,0,7,0"
      ToolTip="查询真实已经归档的运行证据和报告；进行中的步骤不会被视为已归档"/>
     <Button Content="关闭监视" Click="Close_Click" Padding="12,7"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="工程整组实测" FontWeight="SemiBold" FontSize="18"/>
     <TextBlock Text="连接设备 → 扫描 ECU → 确认真实动作 → 自动整组实测（非生产）"
      FontSize="11" Foreground="#667F94" Margin="0,3,0,0"/>
     <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
      <TextBlock Text="{Binding ControllerLabel}" Foreground="#41627D" FontSize="11" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding ScannerLabel}" Foreground="#41627D" FontSize="11"/>
     </StackPanel>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Style="{StaticResource EngPanel}" Padding="13,10"
   Margin="0,0,0,9">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="1*"/>
     <ColumnDefinition Width="1.1*"/>
     <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="当前 ECU" Style="{StaticResource EngCaption}"/>
     <TextBlock Text="{Binding DutSerial}" FontSize="16" FontWeight="SemiBold"
      TextTrimming="CharacterEllipsis" ToolTip="{Binding DutSerial}"/>
     <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource EngCaption}"
      MaxHeight="32" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding ScanStatus}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="12,0">
     <TextBlock Text="执行阶段" Style="{StaticResource EngCaption}"/>
     <TextBlock Text="{Binding OperatorRunState}" FontSize="14" FontWeight="SemiBold"
      TextTrimming="CharacterEllipsis" ToolTip="{Binding OperatorRunState}"/>
     <TextBlock Text="{Binding OperatorFlashState}" Style="{StaticResource EngCaption}"
      MaxHeight="32" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding OperatorFlashState}"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="证据 / 记录" Style="{StaticResource EngCaption}"/>
     <TextBlock Text="{Binding OperatorRecordState}" FontSize="12"
      FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding OperatorRecordState}"/>
     <TextBlock Text="{Binding OperatorRunEvidence}" Style="{StaticResource EngCaption}"
      TextTrimming="CharacterEllipsis" ToolTip="{Binding OperatorRunEvidence}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,9">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.15*" MinWidth="340"/>
    <ColumnDefinition Width="8"/>
    <ColumnDefinition Width="0.85*" MinWidth="290"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource EngPanel}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <DockPanel Margin="12,10">
      <TextBlock DockPanel.Dock="Right" Text="{Binding CaseCount,StringFormat='{}{0} 个用例'}"
       Foreground="#64788B" FontSize="12"/>
      <CheckBox x:Name="FollowEngineeringRun" DockPanel.Dock="Right"
       Content="跟随" IsChecked="True" Margin="0,0,12,0"
       VerticalAlignment="Center" FontSize="12"
       ToolTip="跟随当前真实运行的用例和步骤；取消后自由查看历史"/>
      <TextBlock Text="完整 TEST 用例及真实步骤" FontWeight="SemiBold" FontSize="14"/>
     </DockPanel>
     <TreeView x:Name="EngineeringCasesTree" Grid.Row="1"
      ItemsSource="{Binding Cases}" BorderThickness="0" Padding="6,4"
      SelectedItemChanged="EngineeringCasesTree_SelectedItemChanged"
      ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <TreeView.ItemContainerStyle>
       <Style TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=OneWay}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
       </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.Resources>
       <HierarchicalDataTemplate DataType="{x:Type local:AutomaticTestCase}"
        ItemsSource="{Binding Children}">
        <Grid Margin="5,4" MinHeight="37">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="*" MinWidth="120"/>
          <ColumnDefinition Width="148"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Index}" VerticalAlignment="Center"
          FontWeight="SemiBold" Foreground="#486581"/>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
          <TextBlock Text="{Binding StepCountLabel}" Style="{StaticResource EngCaption}"/>
         </StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding State}"
          Style="{StaticResource EngState}" VerticalAlignment="Center"
          ToolTip="{Binding State}"/>
        </Grid>
       </HierarchicalDataTemplate>
       <HierarchicalDataTemplate DataType="{x:Type local:AutomaticTestStep}"
        ItemsSource="{Binding Children}">
        <Grid Margin="4,3" MinHeight="33">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34"/>
          <ColumnDefinition Width="*" MinWidth="110"/>
          <ColumnDefinition Width="148"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Index}" VerticalAlignment="Center"
          Foreground="#72879A" FontSize="11"/>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
           ToolTip="{Binding Name}"/>
          <TextBlock Text="{Binding ActionSummary}" Style="{StaticResource EngCaption}"
           TextTrimming="CharacterEllipsis" ToolTip="{Binding ActionSummary}"/>
         </StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding State}"
          Style="{StaticResource EngState}" VerticalAlignment="Center"
          ToolTip="{Binding State}"/>
        </Grid>
       </HierarchicalDataTemplate>
      </TreeView.Resources>
     </TreeView>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
    Background="#E1E8F1"/>
   <Border Grid.Column="2" Style="{StaticResource EngPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="14,11,14,15">
      <TextBlock Text="当前真实步骤" FontSize="14" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding OperatorCurrentCase}" Foreground="#52708D"
       TextTrimming="CharacterEllipsis" ToolTip="{Binding OperatorCurrentCase}"
       Margin="0,8,0,0"/>
      <TextBlock Text="{Binding OperatorCurrentStep}" FontSize="15"
       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,5"/>
      <TextBlock Text="{Binding OperatorStepStatus}" Foreground="#286B9C"
       TextWrapping="Wrap" Margin="0,0,0,10"/>
      <Border Height="1" Background="#E1E7EE" Margin="0,0,0,10"/>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,7,0">
        <TextBlock Text="实际值" Style="{StaticResource EngCaption}"/>
        <TextBlock Text="{Binding OperatorActual}" Style="{StaticResource EngFact}"
         FontWeight="SemiBold" Margin="0,4,0,0"/>
       </StackPanel>
       <StackPanel Grid.Column="1">
        <TextBlock Text="期望／判据" Style="{StaticResource EngCaption}"/>
        <TextBlock Text="{Binding OperatorExpected}" Style="{StaticResource EngFact}"
         Margin="0,4,0,0"/>
       </StackPanel>
      </Grid>
      <TextBlock Text="{Binding OperatorFailure}" Foreground="#B42318"
       TextWrapping="Wrap" Margin="0,10,0,8"/>
      <Border Height="1" Background="#E1E7EE" Margin="0,2,0,10"/>
      <TextBlock Text="项目周期 CAN（主控 USB ACK 统计）" FontWeight="SemiBold" FontSize="12"/>
      <TextBlock Text="{Binding OperatorPeriodicStatus}" Foreground="#44647F"
       TextWrapping="Wrap" Margin="0,5,0,10"/>
      <TextBlock Text="USB ACK 不代表 ECU 收到报文；实际 65ms 周期需外部 CAN 分析仪测量。"
       FontSize="11" Foreground="#77889A" TextWrapping="Wrap" Margin="0,0,0,9"/>
      <Border Height="1" Background="#E1E7EE" Margin="0,2,0,10"/>
      <TextBlock Text="选中用例／步骤" FontSize="12" Foreground="#64788B"/>
      <TextBlock Text="{Binding InspectedNode}" FontWeight="SemiBold"
       Margin="0,4,0,2" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding InspectedStatus}" Foreground="#4A6178"
       TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource EngPanel}" Padding="8,5">
   <Expander Header="实测阶段与步骤事件（来自当前工程运行，不是正式生产报告）"
    IsExpanded="True" Foreground="#334963">
    <ListBox x:Name="OperatorEventsList" ItemsSource="{Binding OperatorEvents}"
     MaxHeight="145" MinHeight="70" BorderThickness="0"
     FontFamily="Consolas" FontSize="12"
     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
   </Expander>
  </Border>
 </Grid>
</Window>
