<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Title="AutoTest Studio · ECU 自动测试" Width="1580" Height="920"
    MinWidth="1150" MinHeight="720" WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    Background="#F6F8FB" Foreground="#24364A"
    FontFamily="Segoe UI" FontSize="13"
    SnapsToDevicePixels="True" UseLayoutRounding="True"
    Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Border" Color="#DCE4EE"/>
        <SolidColorBrush x:Key="Text" Color="#24364A"/>
        <SolidColorBrush x:Key="Muted" Color="#6A7E93"/>
        <SolidColorBrush x:Key="Primary" Color="#176AB2"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#254461"/>
            <Setter Property="Background" Value="#F7FAFD"/>
            <Setter Property="BorderBrush" Value="#CEDCEB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="MinHeight" Value="29"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <!-- Only the opened documents are tabs. Overflow scrolls horizontally
             instead of wrapping tabs into multiple rows and stealing TEST space. -->
        <Style x:Key="IdeDocuments" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" Background="#F6F8FB">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#EFF3F8"
                                BorderBrush="#DCE4EE" BorderThickness="0,0,0,1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Disabled" CanContentScroll="True"
                                    Focusable="False">
                                    <TabPanel IsItemsHost="True" Background="#EFF3F8"/>
                                </ScrollViewer>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Foreground" Value="#4A627B"/>
            <Setter Property="Background" Value="#F3F6FA"/>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="37"/>
            <RowDefinition Height="29"/>
            <RowDefinition Height="47"/>
            <RowDefinition Height="*" MinHeight="330"/>
            <RowDefinition x:Name="LogRow" Height="29" MinHeight="29"/>
            <RowDefinition Height="27"/>
        </Grid.RowDefinitions>

        <!-- Single coherent application chrome. No nested operator/developer shells. -->
        <Border Grid.Row="0" Background="#F8FAFD" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="13,0,13,0">
                <TextBlock DockPanel.Dock="Right" Text="ECU 测试与开发 · R1"
                    FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Left" Background="#176AB2" Width="26" Height="26"
                    CornerRadius="5" Margin="0,0,9,0" VerticalAlignment="Center">
                    <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="AutoTest Studio" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Text="   /   " Foreground="#A3B0BF" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ProjectLabel}" Foreground="#58738E" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Menu Grid.Row="1" Background="#FFFFFF" Foreground="#25364A">
            <MenuItem Header="文件">
                <MenuItem Header="新建工程" Command="{Binding NewProjectCommand}"/>
                <MenuItem Header="打开工程" Command="{Binding OpenProjectCommand}"/>
                <MenuItem Header="保存工程" Command="{Binding SaveCommand}"/>
                <Separator/>
                <MenuItem Header="导入 DBC" Command="{Binding ImportDbcCommand}"/>
                <MenuItem Header="退出" Click="Close_Click"/>
            </MenuItem>
            <MenuItem Header="测试">
                <MenuItem Header="自动测试" Click="OpenRun_Click"/>
                <MenuItem Header="TEST 程序编辑" Click="OpenTest_Click"/>
                <MenuItem Header="检查工程与引用" Command="{Binding ValidateCommand}"/>
            </MenuItem>
            <MenuItem Header="专业工具（独立窗口）">
                <MenuItem Header="设备连接 / Station" Click="OpenStation_Click"/>
                <MenuItem Header="CAN 监视" Click="OpenCan_Click"/>
                <MenuItem Header="DBC 信号编辑" Click="OpenDbc_Click"/>
                <MenuItem Header="Controller / 按键映射" Click="OpenController_Click"/>
                <MenuItem Header="手动台架" Click="OpenBench_Click"/>
                <MenuItem Header="波形分析" Click="OpenWave_Click"/>
                <MenuItem Header="UDS 诊断" Click="OpenUds_Click"/>
                <MenuItem Header="CAN 烧录" Click="OpenFlash_Click"/>
                <Separator/>
                <MenuItem Header="扫码 COM / 编号绑定" Click="OpenProduction_Click"/>
                <MenuItem Header="记录与报告" Click="OpenRecords_Click"/>
                <MenuItem Header="操作审计" Click="OpenAudit_Click"/>
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="显示 / 隐藏工程树" Click="ToggleExplorer_Click"/>
                <MenuItem Header="显示 / 隐藏运行日志" Click="ToggleBottom_Click"/>
                <MenuItem Header="命令搜索 Ctrl+K" Click="CommandPalette_Click"/>
            </MenuItem>
            <MenuItem Header="窗口">
                <MenuItem Header="浮动 TEST 编辑器" Click="FloatTest_Click"/>
                <MenuItem Header="打开 DBC 独立窗口" Click="FloatDbc_Click"/>
                <MenuItem Header="打开波形独立窗口" Click="FloatWave_Click"/>
                <MenuItem Header="返回自动测试" Click="OpenRun_Click"/>
            </MenuItem>
        </Menu>

        <!-- Test is the primary action. Scanner is only a small station input status. -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,7">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StationLed" Width="8" Height="8" Fill="#8A9CAF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StationStatus" Text="Station 未连接" VerticalAlignment="Center"
                        Foreground="#59738D" FontSize="11" Margin="0,0,10,0"/>
                    <Button Content="设备连接…" Click="OpenStation_Click" ToolTip="打开设备连接工具；不会在未经确认时自动连接硬件"
                        Padding="7,3" MinHeight="27"/>
                    <Border Height="23" Width="1" Background="#DCE4EE" Margin="6,0,12,0"/>
                    <TextBlock x:Name="ScannerStatus" Text="扫码：等待编号" VerticalAlignment="Center"
                        Foreground="#536D87" FontSize="11" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                    <Button Content="COM" Click="OpenProduction_Click" Padding="7,3" MinHeight="27" Margin="9,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶ 自动测试" Background="#176AB2" Foreground="White"
                        FontWeight="SemiBold" Click="OpenRun_Click"/>
                    <Button Content="TEST 编辑" Click="OpenTest_Click"/>
                    <Menu Background="Transparent" Foreground="#254461" VerticalAlignment="Center"
                          Margin="0,0,7,0">
                        <MenuItem Header="专业工具 ▾" ToolTip="所有工具在独立窗口打开，不占用自动测试工作区">
                            <MenuItem Header="CAN 监视 / 设备连接" Click="OpenCan_Click"/>
                            <MenuItem Header="DBC 编辑器" Click="OpenDbc_Click"/>
                            <MenuItem Header="波形分析" Click="OpenWave_Click"/>
                            <MenuItem Header="UDS 诊断" Click="OpenUds_Click"/>
                            <MenuItem Header="CAN 烧录" Click="OpenFlash_Click"/>
                            <Separator/>
                            <MenuItem Header="Controller 与按键映射" Click="OpenController_Click"/>
                            <MenuItem Header="手动台架" Click="OpenBench_Click"/>
                            <MenuItem Header="编号绑定 / COM 配置" Click="OpenProduction_Click"/>
                            <MenuItem Header="记录与报告" Click="OpenRecords_Click"/>
                        </MenuItem>
                    </Menu>
                    <Button Content="打开工程" Command="{Binding OpenProjectCommand}"/>
                    <Button Content="保存" Command="{Binding SaveCommand}"/>
                    <Button Content="查找工具" Click="CommandPalette_Click" Margin="1,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Background="#F6F8FB">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumn" Width="257" MinWidth="0"/>
                <ColumnDefinition x:Name="ExplorerSplitterColumn" Width="5"/>
                <ColumnDefinition Width="*" MinWidth="620"/>
            </Grid.ColumnDefinitions>
            <!-- An IDE always provides access to the project and TEST structure. -->
            <Border x:Name="ExplorerPanel" Grid.Column="0" Background="White"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F6F9FC" Padding="12,10"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="‹" Click="ToggleExplorer_Click"
                                Padding="6,0" MinHeight="20" Margin="0" Background="Transparent"
                                BorderThickness="0" ToolTip="收起工程树"/>
                            <TextBlock Text="工程 / TEST" FontSize="13" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                    <TabControl x:Name="ExplorerTabs" Background="White" BorderThickness="0">
                        <TabItem Header="测试结构">
                            <Grid Margin="7">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="5,7,1,6" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="全选" Command="{Binding SelectAllCasesCommand}" Padding="6,2"
                                            MinHeight="23" Margin="0,0,4,0" FontSize="11"/>
                                        <Button Content="清空" Command="{Binding ClearCasesCommand}" Padding="6,2"
                                            MinHeight="23" Margin="0" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="当前 TEST · 用例勾选" FontSize="11" FontWeight="SemiBold"
                                        Foreground="#526B85" VerticalAlignment="Center" Margin="1,0,4,0"/>
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" MaxHeight="216" VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,7">
                                <ItemsControl x:Name="TestCasesList" Margin="5,0,3,9">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Busy}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="5,5,5,5">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StepCount, StringFormat={}{0} 步}"
                                                    Foreground="#7C8C9F" FontSize="11" VerticalAlignment="Center"/>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                    ToolTip="仅用于本次工程局部运行；扫码仍运行全部已发布 TEST">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="170"/>
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>                                </ScrollViewer>
                                <Border Grid.Row="2" BorderBrush="#E6EDF4" BorderThickness="0,1,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="执行步骤" Margin="11,10,0,6"
                                            Foreground="#6A7E93" FontSize="11"/>
                                        <ListBox x:Name="PlannedStepsList" BorderThickness="0"
                                            Background="White" Foreground="#29435E" FontSize="12"
                                            SelectedItem="{Binding SelectedRunStep, Mode=TwoWay}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            SelectionChanged="PlannedSteps_SelectionChanged">
                                            <ListBox.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.HeaderTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#EBF1F8" Padding="9,6" Margin="0,6,0,1">
                                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                    Foreground="#436385"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GroupStyle.HeaderTemplate>
                                                </GroupStyle>
                                            </ListBox.GroupStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="3,7" ToolTip="{Binding Diagnostic}">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Verdict}"
                                                                Foreground="#768BA1" FontSize="10"
                                                                VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Number}"
                                                                Foreground="#91A0B1" FontSize="10"
                                                                Width="25" VerticalAlignment="Center"/>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" Foreground="#284760"
                                                                    FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Type}" Foreground="#8293A5" FontSize="10"
                                                                    TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="工程文件">
                            <ContentControl x:Name="ExplorerDocumentHost" Background="White"/>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="ExplorerSplitter" Grid.Column="1" Width="5"
                HorizontalAlignment="Stretch" Background="#EDF2F8"/>
            <!-- The ONE document host. The operator TEST is its first permanent document. -->
            <TabControl x:Name="DocumentTabs" Grid.Column="2" Style="{StaticResource IdeDocuments}" Background="#F6F8FB"
                BorderBrush="{StaticResource Border}" BorderThickness="0"
                SelectionChanged="DocumentTabs_SelectionChanged"/>
        </Grid>

        <Border Grid.Row="4" Background="White"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="日志 ▴ / ▾" Click="ToggleBottom_Click"
                    Background="Transparent" BorderThickness="0" Margin="0" Padding="12,2" MinHeight="25"/>
                <TextBlock DockPanel.Dock="Left" Text="运行事件 / 原始证据" Foreground="#6A7E93"
                    VerticalAlignment="Center" FontSize="11" Margin="13,0,9,0"/>
                <TabControl x:Name="EvidenceTabs" Visibility="Collapsed"
                    Background="White" BorderThickness="0" TabStripPlacement="Top">
                    <TabItem Header="CAN TRACE">
                        <DataGrid x:Name="CanTraceGrid" AutoGenerateColumns="True" IsReadOnly="True"
                            CanUserAddRows="False" RowHeaderWidth="0"/>
                    </TabItem>
                    <TabItem Header="UDS / ISO-TP">
                        <DataGrid x:Name="UdsTraceGrid" AutoGenerateColumns="True" IsReadOnly="True"
                            CanUserAddRows="False" RowHeaderWidth="0"/>
                    </TabItem>
                    <TabItem Header="操作审计">
                        <DataGrid x:Name="AuditGrid" AutoGenerateColumns="True" IsReadOnly="True"
                            CanUserAddRows="False" RowHeaderWidth="0"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <Border Grid.Row="5" Background="#EAF2FC" Padding="12,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#56708B"
                    FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="700"/>
                <TextBlock Text="R1 · TEST 为主 · 真实硬件状态和执行事实独立记录" FontSize="11"
                    Foreground="#345976"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>