<Window x:Class="AutoTest.Desktop.Bench.BenchDbcMessagePickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="从工程 DBC 选择 CAN 发送报文"
 Width="700" Height="530" MinWidth="580" MinHeight="430"
 WindowStartupLocation="CenterOwner"
 FontFamily="Microsoft YaHei UI" FontSize="13" Background="{DynamicResource StudioBg}"
 Foreground="{DynamicResource StudioText}" UseLayoutRounding="True">
 <Window.Resources>
  
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,12">
   <TextBlock Text="选择要发送的 DBC 报文" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock x:Name="ProjectDbcName" Text="从当前工程 DBC 选择，添加到手动台架的 CAN1 发送表"
    Foreground="#607992" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,9">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <TextBlock Text="查找报文" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <TextBox x:Name="FilterBox" Grid.Column="1" Padding="8,7"
    TextChanged="FilterBox_TextChanged"
    ToolTip="支持输入 DBC 报文名称或者十六进制 CAN ID，比如 0x123"/>
  </Grid>
  <ListBox x:Name="MessageList" Grid.Row="2" Margin="0,0,0,12"
   Background="White" BorderBrush="#D7E3EE"
   MouseDoubleClick="MessageList_MouseDoubleClick">
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Border BorderBrush="#E7EEF6" BorderThickness="0,0,0,1" Padding="9,8">
      <StackPanel>
       <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding IdText}"
         Foreground="#3188ED" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
       </DockPanel>
       <TextBlock Text="{Binding Detail}" Foreground="#607992"
        FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <DockPanel Grid.Row="3">
   <TextBlock DockPanel.Dock="Left" Text="双击报文，或选中后点击“添加到发送表”。"
    Foreground="#607992" FontSize="11" VerticalAlignment="Center"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="取消" Click="Cancel_Click"/>
    <Button Content="添加到发送表" Click="Confirm_Click"
     Background="#3188ED" Foreground="White" Margin="0"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>