<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:prism="http://prismlibrary.com/"
 xmlns:uds="clr-namespace:AutoTest.Desktop.Tools.Uds"
 xmlns:flash="clr-namespace:AutoTest.Desktop.Tools.Flash"
 xmlns:device="clr-namespace:AutoTest.DeviceLab;assembly=AutoTest.DeviceLab"
 prism:ViewModelLocator.AutoWireViewModel="True"
 Title="AutoTest Studio · R1 产品工作台 / 设计接入候选"
 Width="1600" Height="960" MinWidth="1150" MinHeight="720"
 WindowStartupLocation="CenterScreen" WindowState="Maximized"
 Closing="Window_Closing"
 Background="#101620" Foreground="#E2EDF7"
 FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
 SnapsToDevicePixels="True">
 <Window.Resources>
  <SolidColorBrush x:Key="R1Title" Color="#111924"/>
  <SolidColorBrush x:Key="R1Panel" Color="#192431"/>
  <SolidColorBrush x:Key="R1Surface" Color="#202D3B"/>
  <SolidColorBrush x:Key="R1Stroke" Color="#314458"/>
  <SolidColorBrush x:Key="R1Muted" Color="#92A4B7"/>
  <SolidColorBrush x:Key="R1Accent" Color="#4FAAFB"/>
  <Style x:Key="R1RailButton" TargetType="Button">
   <Setter Property="Width" Value="44"/>
   <Setter Property="Height" Value="45"/>
   <Setter Property="Margin" Value="2,3"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Padding" Value="3"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Foreground" Value="#B6C9D9"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Style.Triggers>
    <Trigger Property="Tag" Value="active">
     <Setter Property="Background" Value="#163C60"/>
     <Setter Property="Foreground" Value="#4FAAFB"/>
     <Setter Property="BorderBrush" Value="#4FAAFB"/>
     <Setter Property="BorderThickness" Value="3,0,0,0"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#2C4054"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="R1PanelHeader" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="#E2EDF7"/>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Background" Value="{StaticResource R1Panel}"/>
   <Setter Property="Foreground" Value="#E2EDF7"/>
   <Setter Property="BorderBrush" Value="{StaticResource R1Stroke}"/>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Padding" Value="15,8"/>
  </Style>
 </Window.Resources>
 <Window.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
  <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
  <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
  <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
  <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
  <KeyBinding Key="F2" Command="{Binding FocusNameCommand}"/>
 </Window.InputBindings>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="38"/>
   <RowDefinition Height="30"/>
   <RowDefinition Height="48"/>
   <RowDefinition Height="*" MinHeight="290"/>
   <RowDefinition Height="190" MinHeight="125"/>
   <RowDefinition Height="25"/>
  </Grid.RowDefinitions>
  <!-- HTML #app title row / theme / workspace -->
  <Border Background="{StaticResource R1Title}" BorderBrush="#263748" BorderThickness="0,0,0,1">
   <DockPanel Margin="12,0">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
     <TextBlock Text="DESIGN CANDIDATE" Foreground="#E8B967" FontSize="11" FontWeight="SemiBold"/>
     <TextBlock Text="   /   MOCK &amp; REPLAY VIEWS · REAL HARDWARE IN FIELD STUDIO" Foreground="{StaticResource R1Muted}" FontSize="11"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#257AC2" CornerRadius="5" Width="25" Height="25" Margin="0,0,9,0">
      <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="15"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="AutoTest" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
     <TextBlock Text="  STUDIO" FontSize="9" Foreground="#92A4B7" VerticalAlignment="Center"/>
     <TextBlock Text="     /     " Foreground="#65798F" VerticalAlignment="Center"/>
     <TextBlock Text="{Binding ProjectLabel}" Foreground="#CEDCEB" VerticalAlignment="Center"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <!-- HTML menu row / preserve all existing tested commands -->
  <Menu Grid.Row="1" Background="#16202C" Foreground="#E2EDF7">
   <MenuItem Header="_文件">
    <MenuItem Header="新建工程" Command="{Binding NewProjectCommand}"/>
    <MenuItem Header="打开工程" Command="{Binding OpenProjectCommand}"/>
    <MenuItem Header="保存工程" Command="{Binding SaveCommand}"/>
    <Separator/>
    <MenuItem Header="导入 DBC" Command="{Binding ImportDbcCommand}"/>
    <MenuItem Header="退出" Click="Close_Click"/>
   </MenuItem>
   <MenuItem Header="_编辑">
    <MenuItem Header="撤销" Command="{Binding UndoCommand}"/>
    <MenuItem Header="重做" Command="{Binding RedoCommand}"/>
    <MenuItem Header="前插步骤" Command="{Binding InsertBeforeCommand}"/>
    <MenuItem Header="后插步骤" Command="{Binding InsertAfterCommand}"/>
    <MenuItem Header="复制步骤" Command="{Binding CopyCommand}"/>
    <MenuItem Header="插入子步骤" Command="{Binding InsertChildCommand}"/>
    <MenuItem Header="删除节点" Command="{Binding DeleteCommand}"/>
   </MenuItem>
   <MenuItem Header="_运行">
    <MenuItem Header="校验工程/测试资源" Command="{Binding ValidateCommand}"/>
    <MenuItem Header="启动 Mock 测试" Command="{Binding RunCommand}"/>
    <MenuItem Header="停止" Command="{Binding StopCommand}"/>
   </MenuItem>
   <MenuItem Header="_诊断">
    <MenuItem Header="UDS Console / P08" Click="OpenUds_Click"/>
    <MenuItem Header="CAN Flash / P09" Click="OpenFlash_Click"/>
    <MenuItem Header="CAN / USB 设备诊断（独立工具）" Click="DeviceLab_Click"/>
    <MenuItem Header="已有专业工作台（Mock/Replay）" Click="Modules_Click"/>
   </MenuItem>
   <MenuItem Header="_视图">
    <MenuItem Header="测试程序 / P10" Click="OpenTest_Click"/>
    <MenuItem Header="工程资源 / P01" Click="OpenTest_Click"/>
    <MenuItem Header="旧集成工具（兼容）" Click="G4Tools_Click"/>
   </MenuItem>
   <MenuItem Header="_帮助"><MenuItem Header="R1 原型参考与独立联调说明" Click="R1About_Click"/></MenuItem>
  </Menu>
  <!-- HTML command bar, 48 px -->
  <Border Grid.Row="2" Background="#16202C" Padding="11,7"
          BorderBrush="{StaticResource R1Stroke}" BorderThickness="0,0,0,1">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="● MOCK HOST" Foreground="#E8B967" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock Text="   CAN1 Physical Link: not attached to product shell" Foreground="{StaticResource R1Muted}" FontSize="11" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="新建工程" Command="{Binding NewProjectCommand}"/>
     <Button Content="打开工程" Command="{Binding OpenProjectCommand}"/>
     <Button Content="保存" Command="{Binding SaveCommand}"/>
     <Button Content="验证" Command="{Binding ValidateCommand}"/>
     <Border BorderBrush="{StaticResource R1Stroke}" BorderThickness="1,0,0,0" Margin="7,0,12,0"/>
     <Button Content="UDS Console" Click="OpenUds_Click"/>
     <Button Content="CAN Flash" Click="OpenFlash_Click"/>
     <Button Content="设备联调" Click="DeviceLab_Click"/>
     <Button Content="▶ Mock Run" Command="{Binding RunCommand}"/>
     <Button Content="■ 停止" Command="{Binding StopCommand}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <!-- HTML rail / explorer / document / inspector -->
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="50"/>
    <ColumnDefinition Width="255" MinWidth="175"/>
    <ColumnDefinition Width="5"/>
    <ColumnDefinition Width="*" MinWidth="440"/>
    <ColumnDefinition Width="5"/>
    <ColumnDefinition Width="286" MinWidth="220"/>
   </Grid.ColumnDefinitions>
   <Border Background="#141D29" BorderBrush="{StaticResource R1Stroke}" BorderThickness="0,0,1,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <Button x:Name="R1ProjectRail" Content="工程" Style="{StaticResource R1RailButton}" Click="OpenProject_Click" ToolTip="P01 工程资源 / Revision"/>
      <Button x:Name="R1StationRail" Content="设备" Style="{StaticResource R1RailButton}" Click="OpenStation_Click" ToolTip="P02 主控 USB / 站点"/>
      <Button x:Name="R1CanRail" Content="CAN" Style="{StaticResource R1RailButton}" Click="OpenCan_Click" ToolTip="P03 CAN1/CAN0 被动监视"/>
      <Button x:Name="R1DbcRail" Content="DBC" Style="{StaticResource R1RailButton}" Click="OpenDbc_Click" ToolTip="P04 DBC 文件 / 信号编辑"/>
      <Button x:Name="R1ControllerRail" Content="控制" Style="{StaticResource R1RailButton}" Click="OpenController_Click" ToolTip="P05 Controller Designer"/>
      <Button x:Name="R1BenchRail" Content="台架" Style="{StaticResource R1RailButton}" Click="OpenBench_Click" ToolTip="P06 Manual Bench / 当前物理操作未接入"/>
      <Button x:Name="R1WaveRail" Content="波形" Style="{StaticResource R1RailButton}" Click="OpenWave_Click" ToolTip="P07 波形采集与比较"/>
      <Button x:Name="R1UdsRail" Content="UDS" Style="{StaticResource R1RailButton}" Click="OpenUds_Click" ToolTip="P08 诊断 Console"/>
      <Button x:Name="R1FlashRail" Content="烧录" Style="{StaticResource R1RailButton}" Click="OpenFlash_Click" ToolTip="P09 CAN Flash"/>
      <Button x:Name="R1TestRail" Content="测试" Style="{StaticResource R1RailButton}" Click="OpenTest_Click" ToolTip="P10 TEST 编辑"/>
      <Button x:Name="R1RunRail" Content="运行" Style="{StaticResource R1RailButton}" Click="OpenRun_Click" ToolTip="P11 TEST 调试（实验室）"/>
      <Button x:Name="R1ProductionRail" Content="扫码" Style="{StaticResource R1RailButton}" Click="OpenProduction_Click" ToolTip="P12 Production Scan"/>
      <Button x:Name="R1RecordsRail" Content="记录" Style="{StaticResource R1RailButton}" Click="OpenRecords_Click" ToolTip="P13 Records &amp; Reports"/>
      <Button x:Name="R1AuditRail" Content="审计" Style="{StaticResource R1RailButton}" Click="OpenAudit_Click" ToolTip="Operations Audit"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Border Grid.Column="1" Background="{StaticResource R1Panel}" BorderBrush="{StaticResource R1Stroke}" BorderThickness="0,0,1,0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Padding="12,13,12,10" BorderBrush="#263748" BorderThickness="0,0,0,1">
      <StackPanel>
       <TextBlock Text="EXPLORER / 工程资源" Style="{StaticResource R1PanelHeader}"/>
       <TextBlock Text="{Binding ProjectLabel}" Foreground="{StaticResource R1Muted}" FontSize="11" Margin="0,5,0,9" TextWrapping="Wrap"/>
       <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索工程与测试节点"/>
      </StackPanel>
     </Border>
     <ContentControl prism:RegionManager.RegionName="ProjectExplorerRegion"/>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="2" Background="{StaticResource R1Stroke}" HorizontalAlignment="Stretch"/>
   <Border Grid.Column="3" Background="#101620">
    <TabControl x:Name="WorkbenchTabs" Background="#101620" SelectedIndex="0" SelectionChanged="WorkbenchTabs_SelectionChanged">
     <TabItem Header="P01 工程">
      <ScrollViewer Background="#101620" Padding="22">
       <StackPanel MaxWidth="880" HorizontalAlignment="Left">
        <TextBlock Text="工程中心 / PROJECT" FontWeight="SemiBold" FontSize="23" Margin="0,0,0,13"/>
        <TextBlock Text="{Binding ProjectLabel}" Foreground="{StaticResource R1Muted}" Margin="0,0,0,12"/>
        <TextBlock Text="工程/资源/TEST 的现役数据和命令由同一个 V1Workspace 管理；左侧 Explorer 对应资源引用。"
                   TextWrapping="Wrap" Foreground="{StaticResource R1Muted}" Margin="0,0,0,14"/>
        <WrapPanel>
         <Button Content="新建工程" Command="{Binding NewProjectCommand}"/>
         <Button Content="打开工程" Command="{Binding OpenProjectCommand}"/>
         <Button Content="保存工程与 TEST" Command="{Binding SaveCommand}"/>
         <Button Content="校验资源" Command="{Binding ValidateCommand}"/>
         <Button Content="导入 DBC" Command="{Binding ImportDbcCommand}"/>
        </WrapPanel>
        <TextBlock Text="需要编辑完整的 DBC 定义、控制器状态或测试程序，请从左侧选择对应专业工作区。"
                   TextWrapping="Wrap" Margin="0,15,0,7"/>
        <TextBlock Text="当前 R1 Shell 保留现役事务编辑器；跨专业 Revision 级的持久化统一资源引用尚在集成。"
                   TextWrapping="Wrap" Foreground="#E8B967"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="P02/P03 设备 + CAN">
      <ContentControl x:Name="R1StationHost"/>
     </TabItem>
     <TabItem Header="P04 DBC">
      <ContentControl x:Name="R1DbcHost"/>
     </TabItem>
     <TabItem Header="P05 控制器">
      <ContentControl x:Name="R1ControllerHost"/>
     </TabItem>
     <TabItem Header="P06 台架">
      <ScrollViewer Background="#101620" Padding="18">
       <StackPanel>
        <TextBlock Text="Manual Bench / 真实台架" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="此工作区复用同一主控板 DEVICE 诊断会话。设备连接、CAN 接收及 GPIO 只读证据已可从“设备”打开；20 Key 电阻网络 / 五路模拟电压的物理控制适配尚未完成，危险输出禁用。"
                   TextWrapping="Wrap" Margin="0,15,0,20" Foreground="#E8B967"/>
        <Button Content="打开当前共享设备 / Station 状态" Click="OpenStation_Click" HorizontalAlignment="Left"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="P07 波形">
      <ContentControl x:Name="R1WaveHost"/>
     </TabItem>
     <TabItem Header="P08 UDS">
      <uds:UdsToolView/>
     </TabItem>
     <TabItem Header="P09 Flash">
      <flash:FlashToolView/>
     </TabItem>
     <TabItem Header="P10 TEST">
      <ContentControl prism:RegionManager.RegionName="TestEditorRegion"/>
     </TabItem>
     <TabItem Header="P11 Run">
      <ContentControl x:Name="R1RunHost"/>
     </TabItem>
     <TabItem Header="P12 Production">
      <ContentControl x:Name="R1ProductionHost"/>
     </TabItem>
     <TabItem Header="P13 Records">
      <ContentControl x:Name="R1RecordsHost"/>
     </TabItem>
     <TabItem Header="审计 Trace">
      <ContentControl x:Name="R1OperationsHost"/>
     </TabItem>
    </TabControl>
   </Border>
   <GridSplitter Grid.Column="4" Background="{StaticResource R1Stroke}" HorizontalAlignment="Stretch"/>
   <Border Grid.Column="5" Background="{StaticResource R1Panel}" BorderBrush="{StaticResource R1Stroke}" BorderThickness="1,0,0,0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#202D3B" Padding="12,12,12,9">
      <StackPanel>
       <TextBlock Text="INSPECTOR / 属性" Style="{StaticResource R1PanelHeader}"/>
       <TextBlock x:Name="R1InspectorTitle" Text="工程 / Revision" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,0"/>
       <TextBlock x:Name="R1InspectorDescription" Text="当前选择、属性与资源关联" Foreground="{StaticResource R1Muted}" Margin="0,7,0,0" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Grid>
      <Border x:Name="R1StepInspectorHost" Visibility="Collapsed">
       <ContentControl prism:RegionManager.RegionName="StepInspectorRegion"/>
      </Border>
      <StackPanel x:Name="R1InspectorContext" Margin="13">
       <TextBlock Text="CURRENT CONTEXT / 当前工作区" Foreground="{StaticResource R1Muted}" FontSize="10" Margin="0,0,0,12"/>
       <TextBlock Text="选中中央专业工具中的内容可查看、编辑或保存。操作与工程资源由对应 ViewModel 管理。" TextWrapping="Wrap" Foreground="#C1D4E2" Margin="0,0,0,14"/>
       <Border BorderBrush="{StaticResource R1Stroke}" BorderThickness="1,0,0,0" Margin="0,0,0,13"/>
       <TextBlock Text="资源关联" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
       <TextBlock Text="{Binding ProjectLabel}" TextWrapping="Wrap" FontSize="12"/>
       <TextBlock Text="Profile/Revision 与当前工作区随导航更新；具体专业属性在中央编辑器内显示。" Foreground="{StaticResource R1Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
      </StackPanel>
     </Grid>
    </DockPanel>
   </Border>
  </Grid>
  <!-- HTML bottom panel / Trace -->
  <Border Grid.Row="4" Background="#192431" BorderBrush="{StaticResource R1Stroke}" BorderThickness="0,1,0,0">
   <DockPanel>
    <Border DockPanel.Dock="Top" Background="#202D3B" Padding="12,6">
     <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="R1BottomLabel" Text="OUTPUT / TRACE" FontWeight="SemiBold"/>
      <TextBlock Text="    RUN MONITOR · StepFact · Expected/Actual" Foreground="{StaticResource R1Muted}" FontSize="11"/>
      <TextBlock Text="    // UDS raw ISO-TP trace is available in P08 tab" Foreground="#46D0DC" FontSize="11"/>
     </StackPanel>
    </Border>
    <ContentControl prism:RegionManager.RegionName="RunMonitorRegion"/>
   </DockPanel>
  </Border>
  <Border Grid.Row="5" Background="#163C60" Padding="10,3">
   <DockPanel>
    <TextBlock Text="AutoTest R1 · DESIGN / NOT PHYSICAL VALIDATED" FontWeight="SemiBold" Foreground="#E2EDF7"/>
    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" HorizontalAlignment="Right" Foreground="#D4E7F8"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>