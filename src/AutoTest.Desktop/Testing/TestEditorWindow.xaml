<Window x:Class="AutoTest.Desktop.Testing.TestEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · 测试程序编辑器" Width="1330" Height="810"
 MinWidth="1090" MinHeight="630" WindowStartupLocation="CenterOwner"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 SnapsToDevicePixels="True" UseLayoutRounding="True"
 Closing="Window_Closing">
  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    <KeyBinding Key="F2" Command="{Binding EditParametersCommand}"/>
    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="69"/>
      <RowDefinition Height="54"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="17,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="测试程序编辑器" FontSize="19" FontWeight="SemiBold" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding DocumentName}" FontSize="15"
                       Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding DocumentPath}" ToolTip="{Binding DocumentPath}"
                     TextTrimming="CharacterEllipsis" Foreground="{StaticResource Subtle}"
                     FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding AssetRevision,StringFormat='修订 {0}'}"
                     Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,15,0"/>
          <TextBlock Text="● 未保存" Foreground="{StaticResource Warning}"
                     FontSize="12" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0">
        <TextBlock DockPanel.Dock="Right" Text="准备  /  测试  /  清理"
                   Foreground="{StaticResource Subtle}" FontSize="11" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="保存" Command="{Binding SaveCommand}" ToolTip="Ctrl+S"/>
          <Button Content="重新加载" Command="{Binding ReloadCommand}" ToolTip="放弃草稿，重新读取文件"/>
          <Border Width="1" Height="25" Background="{StaticResource Line}" Margin="2,0,10,0"/>
          <ComboBox Width="175" ItemsSource="{Binding StepTypes}"
                    SelectedItem="{Binding SelectedStepType}"
                    Margin="0,0,9,0" VerticalAlignment="Center"/>
          <Button Content="添加到阶段/分支" Command="{Binding AddChildCommand}"
                  MinWidth="116" ToolTip="先选择阶段或 IF/ELSE、循环体子分支"/>
          <Button Content="插到步骤后" Command="{Binding AddAfterCommand}"
                  MinWidth="105" ToolTip="先选中已有步骤"/>
          <Border Width="1" Height="25" Background="{StaticResource Line}" Margin="2,0,10,0"/>
          <Button Content="撤销" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z"/>
          <Button Content="重做" Command="{Binding RedoCommand}" ToolTip="Ctrl+Y"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="480" MinWidth="330" MaxWidth="660"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="460"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource AtPanel}">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarSurface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                  Padding="14,11">
            <DockPanel>
              <TextBlock Text="步骤树" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock DockPanel.Dock="Right" Text="右键管理步骤"
                         FontSize="11" Foreground="{StaticResource Subtle}"/>
            </DockPanel>
          </Border>
          <TreeView x:Name="StepsTree" ItemsSource="{Binding StepRoots}"
                    Tag="{Binding}" BorderThickness="0" Margin="5,7"
                    SelectedItemChanged="StepsTree_SelectedItemChanged"
                    MouseDoubleClick="StepsTree_DoubleClick"
                    PreviewMouseRightButtonDown="StepsTree_RightClick"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True">
            <TreeView.Resources>
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                               Color="{StaticResource SelectedSurfaceColor}"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                               Color="{StaticResource InkColor}"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                               Color="{StaticResource InactiveSelectionColor}"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                               Color="{StaticResource InkColor}"/>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Icon}" Foreground="{StaticResource Subtle}"
                             Margin="0,0,8,0"/>
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/>
                <Setter Property="Padding" Value="3,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.Tag,RelativeSource={RelativeSource Self}}">
                <MenuItem Header="添加步骤到阶段 / 分支" Command="{Binding AddChildCommand}"/>
                <MenuItem Header="在此步骤后插入" Command="{Binding AddAfterCommand}"/>
                <Separator/>
                <MenuItem Header="编辑名称和参数…（F2）" Command="{Binding EditParametersCommand}"/>
                <MenuItem Header="复制步骤及子步骤" Command="{Binding DuplicateCommand}"/>
                <MenuItem Header="上移" Command="{Binding MoveUpCommand}"/>
                <MenuItem Header="下移" Command="{Binding MoveDownCommand}"/>
                <MenuItem Header="删除（Delete）" Command="{Binding DeleteCommand}"/>
                <Separator/>
                <MenuItem Header="撤销（Ctrl+Z）" Command="{Binding UndoCommand}"/>
                <MenuItem Header="重做（Ctrl+Y）" Command="{Binding RedoCommand}"/>
                <MenuItem Header="保存（Ctrl+S）" Command="{Binding SaveCommand}"/>
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                    HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>
      <Border Grid.Column="2" Style="{StaticResource AtPanel}" Padding="18,16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="步骤详情" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/>
            <TextBlock Text="当前选择" Foreground="{StaticResource Subtle}"
                       FontSize="11" Margin="0,0,0,7"/>
            <TextBlock Text="{Binding SelectedTitle}" FontWeight="SemiBold" FontSize="17"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="{Binding SelectedTypeLabel}" Foreground="{StaticResource Subtle}"
                       Margin="0,0,0,10"/>
            <TextBlock Text="{Binding SelectedDescription}" TextWrapping="Wrap" Margin="0,0,0,19"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <Button Content="编辑参数…" Command="{Binding EditParametersCommand}"/>
              <Button Content="复制" Command="{Binding DuplicateCommand}"/>
              <Button Content="删除" Command="{Binding DeleteCommand}"/>
            </StackPanel>
            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,17"/>
            <TextBlock Text="参数" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <ItemsControl ItemsSource="{Binding InspectorProperties}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,13">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Key}"
                               Foreground="{StaticResource Subtle}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="StepId（稳定身份）" Foreground="{StaticResource Subtle}"
                       FontSize="11" Margin="0,16,0,6"/>
            <TextBlock Text="{Binding SelectedId}" TextWrapping="Wrap" FontSize="11"
                       Margin="0,0,0,17"/>
            <Border Background="{StaticResource MutedSurface}" CornerRadius="4"
                    Padding="12,12" MaxWidth="620" HorizontalAlignment="Left">
              <StackPanel>
                <TextBlock Text="IF / ELSE 使用方式" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <TextBlock Text="先选择“条件判断”，插入后展开 THEN 与 ELSE 两个分支；选中对应分支，再添加子步骤。循环的步骤添加到“循环体”分支。"
                           Foreground="{StaticResource Subtle}" TextWrapping="Wrap"/>
                <TextBlock Text="本界面仅用于编辑，不进行 Mock 运行或硬件执行。"
                           Foreground="{StaticResource Subtle}" FontSize="11"
                           Margin="0,9,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="13,0">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Subtle}"
                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>