  "modules": [
    {
      "id": "PW1",
      "name": "电源输入/稳压",
      "refs": [
        "D4"
      ],
      "elements": [
        "ESR1",
        "D28",
        "D59",
        "U4",
        "U8",
        "U11"
      ],
      "explanation": "BAT+ 经保护与浪涌抑制后分别供降压转换与模拟电源模块；U4由SHDN使能，U11提供VCC3P3。",
      "software_constraint": "USB侧供电参与5V启动，BAT+存在不等于MCU已运行。"
    },
    {
      "id": "PW2",
      "name": "共享功率母线",
      "refs": [
        "D3",
        "D4",
        "D5"
      ],
      "elements": [
        "Q4",
        "U2 BTS50055"
      ],
      "explanation": "PTC0/RL_DRV经Q4改变U2的低有效IN，使U2向SOL24IN供电；SOL24IN接U5/U22/U23的Vbb。",
      "software_constraint": "母线供电与单通道请求必须分别管理，不应关闭Air一路时无条件关闭所有高边母线。"
    },
    {
      "id": "MC1",
      "name": "MCU/时钟/调试",
      "refs": [
        "D3"
      ],
      "elements": [
        "U7 MK20DN512VLL10",
        "R68",
        "C69",
        "U6 M95080"
      ],
      "explanation": "数字/模拟供电、复位及晶振构成MCU工作基础，SPI EEPROM占用对应Pad。",
      "software_constraint": "复位态与GPIO初始化态分开，ALT/MUX和板级外接负载共同决定功能可用性。"
    },
    {
      "id": "CM1",
      "name": "USB隔离",
      "refs": [
        "D4"
      ],
      "elements": [
        "U18 ADuM4160",
        "P1"
      ],
      "explanation": "主机侧PCUSB5V/PCGND与板侧VCC5V/GND通过USB隔离芯片传递D+/D−；VBUS还关联板上使能。",
      "software_constraint": "枚举成功不等于供电或实体负载反馈；USB拔线可能导致板级失电。"
    },
    {
      "id": "CM2",
      "name": "设计CAN1",
      "refs": [
        "D1",
        "D3",
        "D4"
      ],
      "elements": [
        "U9 ADM3054",
        "L4",
        "D46"
      ],
      "explanation": "MCU PTA12/13经隔离CAN收发器到J1 B11/B1；U9 VDD1由VCC3P3、VDD2由PCUSB5V供电。",
      "software_constraint": "历史MCAL CH0对应设计CAN1；隔离侧供电失效时控制器初始化成功仍不保证总线正常。"
    },
    {
      "id": "CM3",
      "name": "设计CAN2",
      "refs": [
        "D1",
        "D3",
        "D4"
      ],
      "elements": [
        "U10 TJA1042T/3",
        "L3",
        "D66"
      ],
      "explanation": "MCU PTC17/16经非隔离CAN收发器到J1 A12/A1；VCC=5V VIO=3.3V，STB由图纸固定为低电平。",
      "software_constraint": "历史MCAL CH1对应设计CAN2；软件不可声称具有独立U10 STB控制。"
    },
    {
      "id": "CM4",
      "name": "UART收发器",
      "refs": [
        "D3",
        "D4"
      ],
      "elements": [
        "U12 TJA1021/20",
        "U13 MAX3232"
      ],
      "explanation": "U12把KTXD/KRXD与图纸KLINE对应，U13通过电荷泵转换到RS232电平/DB9。",
      "software_constraint": "UART控制、物理收发器与上层协议须分开；KLINE网络名不能证明实现完整诊断协议。"
    },
    {
      "id": "PO1",
      "name": "BTS724G多路高边",
      "refs": [
        "D1",
        "D3",
        "D5"
      ],
      "elements": [
        "U5",
        "U22",
        "U23"
      ],
      "explanation": "IN高有效，OUT通过内部保护高边开关与SOL24IN/Vbb相连；诊断ST按两路共享。",
      "software_constraint": "命令HIGH不能证明输出电压/机械动作；所有分支必须审查供电、保护与同时扇出。"
    },
    {
      "id": "PO2",
      "name": "TLE6228低边灯驱动",
      "refs": [
        "D1",
        "D5"
      ],
      "elements": [
        "JU1",
        "JU2 TLE6228"
      ],
      "explanation": "低边通道导通后对负载吸流到GND，工作还取决于VS、STBY、ENA等引脚状态。",
      "software_constraint": "不能套用高边输出极性和负载供电假设；红色设计修改批注不是已装配证据。"
    },
    {
      "id": "PO3",
      "name": "HALL晶体管模拟",
      "refs": [
        "D1",
        "D5"
      ],
      "elements": [
        "Q1",
        "Q2",
        "Q7",
        "Q6",
        "Q13"
      ],
      "explanation": "SOL1IN/SOL3IN/SOL2IN/SOL4IN分别控制Q1/Q2/Q7/Q6，同时也控制U23对应IN1..4。",
      "software_constraint": "Air1对应SOL4IN还影响H_SPEED4；Air2对应SOL2IN还影响H_SPEED3。"
    },
    {
