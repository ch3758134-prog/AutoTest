<Window x:Class="AutoTest.FlashLab.Shell.FlashLabWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · ECU 烧录" Width="1440" Height="850"
 MinWidth="800" MinHeight="480" WindowState="Normal"
 WindowStartupLocation="CenterOwner" Background="#F5F7FA"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Margin" Value="4,2"/>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#263849"/>
   <Setter Property="BorderBrush" Value="#D7E1EC"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}"
       CornerRadius="5" TextElement.Foreground="{TemplateBinding Foreground}"
       SnapsToDevicePixels="True">
       <ContentPresenter Margin="{TemplateBinding Padding}"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#91B6DC"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#5F9AD4"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#3478D6"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.58"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Margin" Value="4,2"/>
   <Setter Property="Padding" Value="7,5"/>
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#D7E0DB"/>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="Margin" Value="5,4"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#35433F"/>
   <Setter Property="BorderBrush" Value="#E0E7E3"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="GroupBox">
      <Border Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
       CornerRadius="8">
       <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#F8FAF9" Padding="14,10"
         BorderBrush="#E6EBE8" BorderThickness="0,0,0,1">
         <ContentPresenter ContentSource="Header" TextElement.FontSize="13"
          TextElement.FontWeight="SemiBold" TextElement.Foreground="#475668"/>
        </Border>
        <ContentPresenter ContentSource="Content" Margin="9"/>
       </DockPanel>
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#343E3B"/>
   <Setter Property="BorderBrush" Value="#D7E1DC"/>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Padding" Value="9,5"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#263849"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="RowBackground" Value="White"/>
   <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
   <Setter Property="RowHeaderWidth" Value="0"/>
   <Setter Property="RowHeight" Value="36"/>
   <Setter Property="ColumnHeaderHeight" Value="38"/>
   <Setter Property="EnableRowVirtualization" Value="True"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#E4EAF1"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F4F7F5"/>
   <Setter Property="Foreground" Value="#475668"/>
   <Setter Property="Padding" Value="8,7"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#3B4542"/>
  </Style>
 </Window.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="330"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#E2E8E5"
    BorderThickness="1" CornerRadius="5" Margin="2,0,2,5" Padding="13,9">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="ECU 烧录" FontSize="19" FontWeight="SemiBold" Foreground="#303D37"/>
     <TextBlock Text="  ·  主控 USB → ECU CAN (A1/A12)" FontSize="12"
       Foreground="#627C9D" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
    </StackPanel>
    <TextBlock Text="烧录进度与通信记录"
      HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#6D7A76"/>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Background="White" BorderBrush="#E2E8E5"
    BorderThickness="1" CornerRadius="5" Margin="2,0,2,5" Padding="10,7">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click"/>
     <Button x:Name="ConnectButton" Content="连接 USB" Click="Connect_Click"
       Background="#E5F3EC" BorderBrush="#CADAF1" Foreground="#3478D6"
       FontWeight="SemiBold"/>
     <Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Left" Text="USB 主控" FontWeight="Bold"
      VerticalAlignment="Center" Margin="4,0,12,0"/>
    <ComboBox x:Name="DeviceSelector" DockPanel.Dock="Left" Width="235"
      ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedDevice,Mode=TwoWay}"
      SelectionChanged="Device_SelectionChanged" DisplayMemberPath="DisplayIdentity"
      Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="UsbStatusLabel" Text="设备未连接，请连接主控后刷新"
      TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#A5772F"/>
   </DockPanel>
  </Border>


  <!-- Responsive: wide = configuration/progress/CAN; compact = configuration
       plus vertically arranged live progress and received CAN evidence. -->
  <Grid x:Name="FlashWorkbenchGrid" Grid.Row="2" Margin="0,3,0,3">
   <Grid.RowDefinitions>
    <RowDefinition x:Name="FlashPrimaryRow" Height="*"/>
    <RowDefinition x:Name="FlashMonitorRow" Height="0"/>
   </Grid.RowDefinitions>
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="FlashConfigColumn" Width="304" MinWidth="0"/>
    <ColumnDefinition x:Name="FlashConfigGap" Width="6"/>
    <ColumnDefinition x:Name="FlashWorkflowColumn" Width="405" MinWidth="0"/>
    <ColumnDefinition x:Name="FlashMonitorGap" Width="6"/>
    <ColumnDefinition x:Name="FlashCanColumn" Width="*" MinWidth="0"/>
   </Grid.ColumnDefinitions>

   <!-- A：导入文件是配置信息，不是主工作区 -->
   <GroupBox x:Name="FlashConfigPanel" Grid.Column="0" Header="烧录配置">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="1">
      <Button Content="编辑烧录配置…" Click="OpenNativeProfile_Click"
        Background="#E7F4EF" BorderBrush="#D9E9E1" Foreground="#225845"
        FontWeight="SemiBold" Margin="3,3,3,8"
        ToolTip="手动编辑、自动保存到工程固定位置；独立工具可使用本地专属原生配置"
        HorizontalAlignment="Stretch"/>
      <TextBlock x:Name="NativeProfileLabel" Margin="7,0,7,5" Foreground="#375B73"
        TextWrapping="Wrap" FontSize="12" Text="尚未配置烧录参数"/>
      <TextBlock Text="HEX、CAN 参数、FLASH 地址统一在上方编辑；安全算法由软件固定提供。"
        Margin="7,2,7,9" TextWrapping="Wrap" Foreground="#63778A" FontSize="12"/>
      <!-- Legacy reference controls are inert during the native-only R1
           transition; keep named instances until old handlers are removed. -->
     </StackPanel>
    </ScrollViewer>
   </GroupBox>

   <GridSplitter x:Name="FlashConfigSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
     Background="#E4EAE6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

   <!-- B：烧录过程作为工作区 -->
   <GroupBox x:Name="FlashWorkflowPanel" Grid.Column="2" Header="烧录流程">
    <Grid Margin="2">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="125"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="120"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0">
      <TextBlock x:Name="WorkflowStatusLabel"
        Text="选择烧录配置并连接设备后开始" TextWrapping="Wrap"
        Margin="5,3,5,6" FontWeight="SemiBold" Foreground="#3478D6"/>
      <TextBlock x:Name="FlashPlanSummary" Text="开始时自动检查 CAN 地址、固件、算法和 Flash 范围"
        TextWrapping="Wrap" FontSize="11" Margin="7,2,7,6"
        Foreground="#627C9D" MaxHeight="105"/>
      <StackPanel Orientation="Horizontal" Margin="0,1,0,2">
       <Button x:Name="StartFlashButton" Content="开始烧录" Click="StartFlash_Click"
         Background="#3478D6" Foreground="White" BorderBrush="#3478D6"
         FontWeight="SemiBold" Padding="19,8"/>
       <Button x:Name="AbortFlashButton" Content="停止烧录" Click="AbortFlash_Click"
         IsEnabled="False" Padding="20,7"/>
      </StackPanel>
      <ProgressBar x:Name="FlashProgressBar" Foreground="#3478D6"
        Background="#E7EFEB" Height="9"
        Minimum="0" Maximum="100" Value="0" Margin="5,4,5,2"/>
      <TextBlock x:Name="FlashStageLabel" Text="待命" TextWrapping="Wrap"
        Margin="6,1,6,7" FontSize="11"/>
     </StackPanel>

     <TextBlock Grid.Row="1" Text="执行阶段" FontWeight="SemiBold"
       Foreground="#475668" Margin="7,5,0,3"/>
     <DataGrid Grid.Row="2" ItemsSource="{Binding Stages}"
       AutoGenerateColumns="False" CanUserAddRows="False"
       CanUserDeleteRows="False" IsReadOnly="True" Margin="4,0,4,4"
       HeadersVisibility="Column" RowHeaderWidth="0"
       EnableRowVirtualization="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="步骤" Binding="{Binding Step,Mode=OneWay}" Width="*"/>
       <DataGridTextColumn Header="结果" Binding="{Binding State,Mode=OneWay}" Width="96"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="3" Text="诊断通信与失败原因"
       FontWeight="SemiBold" Margin="7,5,2,4" Foreground="#475668"/>
     <ListBox Grid.Row="4" x:Name="LogList" ItemsSource="{Binding Logs}"
       FontFamily="Consolas" FontSize="11" Margin="4,0,4,3"
       ScrollViewer.HorizontalScrollBarVisibility="Auto"
       ScrollViewer.VerticalScrollBarVisibility="Auto"
       Background="#FCFDFE"/>
    </Grid>
   </GroupBox>

   <GridSplitter x:Name="FlashMonitorSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
     Background="#E4EAE6" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

   <!-- C：实测主观察区，全高度 CAN1 收发日志 -->
   <GroupBox x:Name="FlashCanPanel" Grid.Column="4" Header="ECU CAN 实时报文">
    <Grid Margin="2">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="2,0,2,6" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Content="导出日志" Click="Export_Click" Padding="10,5"/>
       <Button Content="清空显示" Click="ClearCan_Click" Padding="10,5"/>
      </StackPanel>
      <TextBlock Text="CAN 报文发送与接收"
        VerticalAlignment="Center" Margin="5,0,3,0"
        Foreground="#617B96" FontSize="11" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <DataGrid x:Name="CanLogTable" Grid.Row="1"
       ItemsSource="{Binding CanLogs}" AutoGenerateColumns="False"
       CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
       EnableRowVirtualization="True" EnableColumnVirtualization="True"
       GridLinesVisibility="Horizontal" RowHeaderWidth="0"
       HeadersVisibility="Column" Margin="2,0,2,2"
       ScrollViewer.HorizontalScrollBarVisibility="Auto"
       ScrollViewer.VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Time,Mode=OneWay}" Width="108"/>
       <DataGridTextColumn Header="方向" Binding="{Binding Direction,Mode=OneWay}" Width="76"/>
       <DataGridTextColumn Header="CAN ID" Binding="{Binding CanId,Mode=OneWay}" Width="95"/>
       <DataGridTextColumn Header="DLC" Binding="{Binding Dlc,Mode=OneWay}" Width="42"/>
       <DataGridTextColumn Header="CAN 数据（HEX）" Binding="{Binding Data,Mode=OneWay}" Width="*"/>
       <DataGridTextColumn Header="结果" Binding="{Binding Result,Mode=OneWay}" Width="195"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </GroupBox>
  </Grid>
  <Border Grid.Row="3" Background="#F7F8F8" BorderBrush="#E0E5E2"
    BorderThickness="0,1,0,0" Padding="7" Margin="4,3,4,0">
   <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="#475668"
     TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>
