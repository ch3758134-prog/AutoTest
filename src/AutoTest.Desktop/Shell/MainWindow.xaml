<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:navigation="clr-namespace:AutoTest.Desktop.Shell.Navigation"
 Title="AutoTest · ECU 测试工作台"
 Width="1440" Height="900" MinWidth="940" MinHeight="610"
 WindowState="Maximized" WindowStartupLocation="CenterScreen"
 ResizeMode="CanResize" Background="#F5F7FB" Foreground="#1B2838"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 PreviewKeyDown="Window_PreviewKeyDown"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.InputBindings>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveActiveCommand}"/>
 </Window.InputBindings>
 <Window.Resources>
  <Style x:Key="WorkspaceTab" TargetType="{x:Type TabItem}">
   <Setter Property="MinWidth" Value="115"/>
   <Setter Property="MaxWidth" Value="255"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Background" Value="#F5F7FA"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type TabItem}">
      <Border x:Name="Surface" Background="{TemplateBinding Background}"
       BorderBrush="#E2E8F0" BorderThickness="0,0,1,0"
       Padding="{TemplateBinding Padding}" MinHeight="38">
       <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter TargetName="Surface" Property="Background" Value="White"/>
        <Setter TargetName="Surface" Property="BorderBrush" Value="#2878D2"/>
        <Setter TargetName="Surface" Property="BorderThickness" Value="0,0,0,2"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Surface" Property="Background" Value="#EBF3FD"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#465A73"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 </Window.Resources>
 <Grid Background="#F5F7FB">
  <Grid.RowDefinitions>
   <RowDefinition Height="64"/>
   <RowDefinition Height="54"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="36"/>
  </Grid.RowDefinitions>

  <!-- New task-first command header. The OS owns maximize, caption and taskbar. -->
  <Border Grid.Row="0" Background="White" BorderBrush="#E1E7EF"
   BorderThickness="0,0,0,1">
   <DockPanel LastChildFill="True" Margin="18,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#F0F4F9" CornerRadius="8" Padding="10,7"
      Margin="0,0,11,0" ToolTip="{Binding HardwareStatus}">
      <StackPanel Orientation="Horizontal">
       <Ellipse Width="7" Height="7" Fill="#94A3B8" Margin="0,0,7,0">
        <Ellipse.Style>
         <Style TargetType="Ellipse">
          <Setter Property="Fill" Value="#94A3B8"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsHardwareConnected}" Value="True">
            <Setter Property="Fill" Value="#16A07A"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Ellipse.Style>
       </Ellipse>
       <TextBlock Text="{Binding HardwareStatus}" FontSize="11" Foreground="#4D6078"
        MaxWidth="235" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <ui:Button Content="{Binding ConnectionButtonText}" Command="{Binding ConnectHardwareCommand}"
      Margin="0,0,9,0" Padding="13,8" ToolTip="连接或断开真实主控板"/>
     <Menu Background="Transparent" VerticalAlignment="Center" Padding="0">
      <MenuItem Header="更多工具">
       <MenuItem Header="DBC 编辑与浏览" Command="{Binding OpenDbcToolCommand}"/>
       <MenuItem Header="波形分析" Command="{Binding OpenWaveWorkbenchCommand}"/>
       <MenuItem Header="波形配置" Command="{Binding OpenWaveConfigCommand}"/>
       <MenuItem Header="ECU 烧录" Command="{Binding OpenFlashWorkbenchCommand}"/>
       <MenuItem Header="CAN 监视" Command="{Binding OpenCanMonitorCommand}"/>
       <Separator/>
       <MenuItem Header="UDS 工作区（待正式集成）" IsEnabled="False"/>
      </MenuItem>
     </Menu>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#256FCA" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0">
      <TextBlock Text="AT" FontWeight="Bold" Foreground="White" FontSize="15"
       VerticalAlignment="Center" HorizontalAlignment="Center"/>
     </Border>
     <StackPanel VerticalAlignment="Center" Margin="0,0,25,0">
      <TextBlock Text="AutoTest" FontSize="18" FontWeight="SemiBold" Foreground="#172638"/>
      <TextBlock Text="ECU 工程测试工作台" FontSize="10" Foreground="#6F8095"/>
     </StackPanel>
     <Border Width="1" Height="26" Background="#DCE4EE" Margin="0,0,16,0"/>
     <ui:Button Appearance="Primary" Content="自动测试"
      Click="ShowTestWorkspace_Click" Padding="17,8" Margin="0,0,9,0"
      ToolTip="工程和用例编辑；执行视图会根据任务切换"/>
     <ui:Button Content="手动台架" Command="{Binding OpenManualBenchCommand}"
      Padding="17,8" Margin="0,0,9,0" ToolTip="真实 ECU 和主控板手动操作"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- Compact project actions. No permanent developer IDE menu or command clutter. -->
  <Border Grid.Row="1" Background="#FBFCFE" BorderBrush="#E1E7EF"
   BorderThickness="0,0,0,1">
   <DockPanel Margin="18,0" LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <ui:Button Content="资源" Click="ToggleProjectTree_Click" Padding="11,6"
      Margin="0,0,6,0" ToolTip="显示或收起当前工程资源列表"/>
     <ui:Button Content="属性" Click="ToggleInspector_Click" Padding="11,6"
      Margin="0,0,6,0" ToolTip="显示或收起所选步骤的参数编辑"/>
     <ui:Button Content="监视 / 结果" Click="ToggleBottom_Click" Padding="11,6"
      ToolTip="显示真实运行时间线、CAN 事件和问题"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <ui:Button Content="打开工程" Command="{Binding OpenProjectCommand}"
      Margin="0,0,8,0" Padding="12,6"/>
     <TextBlock Text="{Binding CurrentProjectName}" VerticalAlignment="Center"
      FontWeight="SemiBold" MaxWidth="230" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding CurrentProjectPath}" Margin="0,0,15,0"/>
     <Border Width="1" Height="22" Background="#DCE4EE" Margin="0,0,14,0"/>
     <ui:Button Content="新建用例" Command="{Binding NewTestProgramCommand}"
      Padding="12,6" Margin="0,0,7,0"/>
     <ui:Button Content="新建测试项目" Command="{Binding NewTestProjectCommand}"
      Padding="12,6" Margin="0,0,7,0"/>
     <ui:Button Content="保存" Command="{Binding SaveActiveCommand}"
      Padding="13,6" Margin="0,0,7,0"/>
     <ui:Button Content="撤销" Command="{Binding UndoActiveCommand}"
      Margin="0,0,5,0"/>
     <ui:Button Content="重做" Command="{Binding RedoActiveCommand}"
      Margin="0,0,13,0"/>
     <ui:Button Content="检查" Command="{Binding CheckActiveCommand}"
      Padding="12,6" ToolTip="检查当前用例，不代表实体测试已通过"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="2" Margin="12,12,12,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="TreeColumn" Width="280" MinWidth="0" MaxWidth="510"/>
    <ColumnDefinition x:Name="TreeSplitterColumn" Width="5"/>
    <ColumnDefinition Width="*" MinWidth="0"/>
   </Grid.ColumnDefinitions>
   <!-- Project tree is useful for editing but is no longer the global navigation. -->
   <Border Grid.Column="0" Background="White" BorderBrush="#E0E7F0"
    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Background="#F8FAFD" Margin="11,0">
      <Button DockPanel.Dock="Right" Content="×" Click="ToggleProjectTree_Click"
       Style="{StaticResource AtQuietButton}" Padding="3" ToolTip="收起资源列表"/>
      <TextBlock Text="工程资源" FontWeight="SemiBold" Foreground="#334B65"
       VerticalAlignment="Center"/>
     </DockPanel>
     <navigation:ProjectExplorerView Grid.Row="1"/>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" ResizeDirection="Columns" ShowsPreview="True"
    HorizontalAlignment="Stretch" Background="Transparent" Margin="1,0"/>

   <Border Grid.Column="2" Background="White" BorderBrush="#E0E7F0"
    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

     <Border Grid.Row="0" MinHeight="39" BorderBrush="#E3E9F1"
      BorderThickness="0,0,0,1" Background="#F8FAFD"
      Visibility="{Binding HasActiveEditor,Converter={StaticResource BoolToVisibility}}">
      <TabControl x:Name="DocumentTabs" ItemsSource="{Binding OpenEditors}"
       SelectedItem="{Binding ActiveEditorTab,Mode=TwoWay}"
       SelectionChanged="DocumentTabs_SelectionChanged"
       ItemContainerStyle="{StaticResource WorkspaceTab}" Background="Transparent"
       BorderThickness="0">
       <TabControl.Template>
        <ControlTemplate TargetType="{x:Type TabControl}">
         <ScrollViewer HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Disabled">
          <TabPanel IsItemsHost="True" Background="Transparent" HorizontalAlignment="Left"/>
         </ScrollViewer>
        </ControlTemplate>
       </TabControl.Template>
       <TabControl.ItemTemplate>
        <DataTemplate>
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Title}" MaxWidth="195" TextTrimming="CharacterEllipsis"
           VerticalAlignment="Center" Foreground="#2B4868"/>
          <Button Content="×" Tag="{Binding}" Click="CloseEditorTab_Click"
           Width="20" Height="20" MinHeight="0" MinWidth="0" Padding="0"
           Margin="8,0,0,0" Focusable="False" Style="{StaticResource AtQuietButton}"
           ToolTip="关闭当前资源"/>
         </StackPanel>
        </DataTemplate>
       </TabControl.ItemTemplate>
      </TabControl>
     </Border>

     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" MinWidth="0"/>
       <ColumnDefinition x:Name="InspectorSplitterColumn" Width="5"/>
       <ColumnDefinition x:Name="InspectorColumn" Width="320" MinWidth="0" MaxWidth="560"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
       <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="120"/>
        <RowDefinition x:Name="BottomSplitterRow" Height="0"/>
        <RowDefinition x:Name="BottomRow" Height="0" MinHeight="0"/>
       </Grid.RowDefinitions>
       <Grid Grid.Row="0" Background="White">
        <ContentControl Content="{Binding ActiveEditorView}"
         HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
         MaxWidth="510" Margin="28,20"
         Visibility="{Binding NoOpenEditors,Converter={StaticResource BoolToVisibility}}">
         <TextBlock Text="{Binding StartTitle}" FontSize="21" FontWeight="SemiBold"
          Foreground="#203C5C" Margin="0,0,0,10"/>
         <TextBlock Text="{Binding StartDescription}" FontSize="13" Foreground="#6C7D92"
          TextWrapping="Wrap" Margin="0,0,0,22"/>
         <StackPanel Orientation="Horizontal">
          <ui:Button Content="{Binding StartPrimaryLabel}" Command="{Binding StartPrimaryCommand}"
           Appearance="Primary" Padding="20,10" Margin="0,0,10,0"/>
          <ui:Button Content="{Binding StartSecondaryLabel}" Command="{Binding StartSecondaryCommand}"
           Visibility="{Binding ShowStartSecondary,Converter={StaticResource BoolToVisibility}}"
           Padding="15,10"/>
         </StackPanel>
        </StackPanel>
       </Grid>
       <GridSplitter Grid.Row="1" ResizeDirection="Rows" ShowsPreview="True"
        HorizontalAlignment="Stretch" Background="#E0E7F0"/>
       <Grid Grid.Row="2" Background="#F8FAFD">
        <TabControl BorderThickness="0" FontSize="12" Background="#F8FAFD">
         <TabItem Header="步骤执行">
          <DataGrid ItemsSource="{Binding ActiveEditorTab.Editor.RunFactRows}"
           AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
           RowHeaderWidth="0" BorderThickness="0" EnableRowVirtualization="True">
           <DataGrid.Columns>
            <DataGridTextColumn Header="步骤" Binding="{Binding Type}" Width="110"/>
            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="95"/>
            <DataGridTextColumn Header="实测值" Binding="{Binding Actual}" Width="150"/>
            <DataGridTextColumn Header="证据 / 说明" Binding="{Binding Detail}" Width="*"/>
           </DataGrid.Columns>
          </DataGrid>
         </TabItem>
         <TabItem Header="CAN 监控">
          <DataGrid ItemsSource="{Binding CanRecords}" AutoGenerateColumns="False"
           IsReadOnly="True" BorderThickness="0" RowHeaderWidth="0"
           EnableRowVirtualization="True">
           <DataGrid.Columns>
            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="110"/>
            <DataGridTextColumn Header="通道" Binding="{Binding Port}" Width="90"/>
            <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="110"/>
            <DataGridTextColumn Header="数据" Binding="{Binding Data}" Width="*"/>
           </DataGrid.Columns>
          </DataGrid>
         </TabItem>
         <TabItem Header="问题">
          <TextBlock Text="{Binding ActiveEditorTab.Editor.StatusMessage}"
           Foreground="#A46F35" Margin="14" TextWrapping="Wrap"/>
         </TabItem>
         <TabItem Header="设备状态">
          <StackPanel Margin="14">
           <TextBlock Text="{Binding HardwareStatus}" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding ScanStatus}" Margin="0,8,0,0"
            Foreground="#6C7D92" TextWrapping="Wrap"/>
          </StackPanel>
         </TabItem>
        </TabControl>
       </Grid>
      </Grid>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns"
       Background="#E2E9F2" ShowsPreview="True"/>
      <Grid Grid.Column="2" Background="#FAFCFF">
       <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <DockPanel Grid.Row="0" Margin="13,0" Background="#FAFCFF">
        <Button DockPanel.Dock="Right" Content="×" Click="ToggleInspector_Click"
         Style="{StaticResource AtQuietButton}" Padding="4" ToolTip="收起属性区"/>
        <TextBlock Text="{Binding InspectorHeading}" FontWeight="SemiBold"
         Foreground="#334D6C" VerticalAlignment="Center"/>
       </DockPanel>
       <ContentControl Grid.Row="1" Content="{Binding ActiveEditorInspector}"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      </Grid>
     </Grid>
    </Grid>
   </Border>
  </Grid>

  <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0"
   BorderThickness="0,1,0,0">
   <DockPanel Margin="15,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="扫码编号" FontSize="11" Foreground="#687B93"
      VerticalAlignment="Center" Margin="0,0,6,0"/>
     <TextBox x:Name="ScannerEntry" Width="130" MinHeight="25" Height="27"
      ToolTip="扫码枪键盘输入；Enter 匹配工程，不自动启动实体测试"
      PreviewTextInput="ScannerEntry_TextInput" PreviewKeyDown="ScannerEntry_KeyDown"/>
    </StackPanel>
    <TextBlock Text="{Binding StatusMessage}" Foreground="#516880"
     FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
