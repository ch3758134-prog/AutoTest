<Window x:Class="AutoTest.Desktop.Shell.ManualBenchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AutoTest.Desktop.Shell"
 Title="AutoTest · 手动台架" Width="1480" Height="840" MinWidth="820" MinHeight="490"
 WindowStartupLocation="CenterOwner" WindowState="Maximized" Background="#F7F8F8"
 FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="#303941">
 <Window.Resources>
  <Style x:Key="BenchKeyActionPad" TargetType="Button">
   <Setter Property="Height" Value="74"/>
   <Setter Property="Margin" Value="0,0,7,7"/>
   <Setter Property="Padding" Value="9,7"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="#F8FBFF"/>
   <Setter Property="BorderBrush" Value="#CCD9E6"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="KeyPadSurface" Background="{TemplateBinding Background}"
       BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
       CornerRadius="6" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="KeyPadSurface" Property="Background" Value="#EAF4FF"/>
        <Setter TargetName="KeyPadSurface" Property="BorderBrush" Value="#397EC3"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="KeyPadSurface" Property="Background" Value="#D8EAFB"/>
       </Trigger>
       <DataTrigger Binding="{Binding IsExecuting}" Value="True">
        <Setter TargetName="KeyPadSurface" Property="Background" Value="#DBEDFF"/>
        <Setter TargetName="KeyPadSurface" Property="BorderBrush" Value="#1E68A8"/>
       </DataTrigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="KeyPadSurface" Property="Opacity" Value="0.55"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="BenchHeader" TargetType="TextBlock">
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#303941"/>
  </Style>
  <Style x:Key="BenchHint" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="#627C9D"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="BenchCard" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#E0E5E5"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="11"/>
  </Style>
  <Style x:Key="BenchKey" TargetType="CheckBox">
   <Setter Property="Padding" Value="9,8"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style x:Key="FieldCaption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#627C9D"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="0,9,0,4"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="55"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="37"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="White" BorderBrush="#E0E5E5" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,10" LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="{Binding ConnectionActionLabel}" Command="{Binding ConnectCommand}"
     Style="{StaticResource AtPrimaryButton}" Padding="15,8" Margin="9,0,0,0"/>
    <Button DockPanel.Dock="Right" Content="刷新资源" Command="{Binding ReloadProfilesCommand}"
     Padding="12,7" Margin="9,0,0,0"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
     VerticalAlignment="Center" Margin="12,0,12,0">
     <TextBlock Text="ECU CAN 波特率" VerticalAlignment="Center"
      Foreground="#334252" Margin="0,0,8,0" FontWeight="SemiBold"/>
     <ComboBox Width="148" MinHeight="30"
      ItemsSource="{Binding EcuCanRateChoices}" DisplayMemberPath="Label"
      SelectedValuePath="Kbps"
      SelectedValue="{Binding RequestedEcuCanBitrateKbps,Mode=TwoWay}"
      ToolTip="应用并回读 ECU CAN 波特率；按键 CAN 保持 500 kbit/s"/>
     <Button Content="应用" Command="{Binding ApplyEcuCanBitrateCommand}"
      Margin="7,0,0,0" Padding="8,5"
      ToolTip="空闲工位设置 ECU CAN 波特率并向主控读回确认"/>
     <TextBlock x:Name="BenchBaudStatusText" Text="{Binding EcuCanBitrateStatus}"
      Foreground="#A45B36" VerticalAlignment="Center" FontSize="10"
      Margin="8,0,0,0" MaxWidth="215" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="手动台架" Style="{StaticResource BenchHeader}" FontSize="17"
       VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Border Background="#EFF3F2" Padding="10,5" CornerRadius="12" ToolTip="{Binding ConnectionStatus}">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="●" Foreground="#627C9D" Margin="0,0,6,0"/>
        <TextBlock>
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Text" Value="USB 未连接"/>
           <Setter Property="Foreground" Value="#475668"/>
           <Setter Property="FontSize" Value="11"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
             <Setter Property="Text" Value="USB 已连接"/>
             <Setter Property="Foreground" Value="#3478D6"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </Border>
     </StackPanel>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <StackPanel x:Name="BenchCompactNavigation" Grid.Row="0"
    Orientation="Horizontal" Visibility="Collapsed" Margin="12,8,12,0">
    <Button x:Name="BenchShowCanTab" Content="CAN 发送"
     Click="BenchShowCanTab_Click" Margin="0,0,7,0" Padding="12,6"/>
    <Button x:Name="BenchShowKeyTab" Content="KEY 与工位"
     Click="BenchShowKeyTab_Click" Margin="0,0,7,0" Padding="12,6"/>
    <Button x:Name="BenchShowMonitorTab" Content="CAN 监视"
     Click="BenchShowMonitorTab_Click" Padding="12,6"/>
   </StackPanel>
  <Grid x:Name="BenchWorkGrid" Grid.Row="1" Margin="12,12,12,10">
   <Grid.RowDefinitions>
    <RowDefinition x:Name="BenchPrimaryRow" Height="*"/>
    <RowDefinition x:Name="BenchMonitorRow" Height="0"/>
   </Grid.RowDefinitions>
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="BenchSendColumn" Width="37*" MinWidth="420"/>
    <ColumnDefinition x:Name="BenchSendSplitterColumn" Width="6"/>
    <ColumnDefinition x:Name="BenchKeyColumn" Width="29*" MinWidth="335"/>
    <ColumnDefinition x:Name="BenchMonitorSplitterColumn" Width="6"/>
    <ColumnDefinition x:Name="BenchMonitorColumn" Width="34*" MinWidth="330"/>
   </Grid.ColumnDefinitions>

   <!-- LEFT: SEND list is the one permanent complete raw-frame view;
        editing appears in a short-lived floating popup, not below the list. -->
   <Border x:Name="BenchSendPanel" Grid.Column="0" Style="{StaticResource BenchCard}" Margin="0,0,4,0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,9">
      <DockPanel Margin="0,0,0,8">
       <TextBlock Text="ECU CAN 发送" Style="{StaticResource BenchHeader}"/>
       <TextBlock DockPanel.Dock="Right" Text="双击编辑"
        FontSize="11" Foreground="#627C9D" Margin="8,0,0,0"/>
      </DockPanel>
      <WrapPanel>
       <Button Content="+ 报文" Click="AddCanRow_Click" Padding="9,6" Margin="0,0,5,5"
        ToolTip="新建报文并打开完整属性编辑，不直接发送"/>
       <Button Content="复制" Command="{Binding CopyCanRowCommand}" Padding="9,6" Margin="0,0,5,5"/>
       <Button Content="删除" Command="{Binding DeleteCanRowCommand}" Padding="9,6" Margin="0,0,5,5"/>
       <Button Content="↑" Command="{Binding MoveCanRowUpCommand}" Padding="8,6" Margin="0,0,4,5"/>
       <Button Content="↓" Command="{Binding MoveCanRowDownCommand}" Padding="8,6" Margin="0,0,9,5"/>
       <Button Content="启动勾选报文" Command="{Binding StartCanRowsCommand}"
        Style="{StaticResource AtPrimaryButton}" Padding="10,6" Margin="0,0,6,5"
        ToolTip="依次启动尚未运行的勾选报文；行内可单独启停和单发。"/>
       <Button Content="停止全部发送" Command="{Binding StopCanRowsCommand}" Padding="9,6" Margin="0,0,5,5"
        ToolTip="停止周期 CAN 发送，不改变当前按键状态"/>
      </WrapPanel>
     </StackPanel>
     <DataGrid x:Name="CanSendGrid" Grid.Row="1"
      ItemsSource="{Binding CanSendRows}" SelectedItem="{Binding SelectedCanRow,Mode=TwoWay}"
      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
      GridLinesVisibility="Horizontal" BorderBrush="#E2E7E7"
      RowHeight="43" ColumnHeaderHeight="35" FontSize="12"
      EnableRowVirtualization="True" EnableColumnVirtualization="True"
      Background="White" AlternatingRowBackground="#F8FAFA"
      MouseDoubleClick="CanSendGrid_MouseDoubleClick"
      PreviewMouseRightButtonDown="CanSendGrid_RightClick"
      ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="4,5"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#334963"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGrid.ColumnHeaderStyle>
       <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="3,2"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGrid.CellStyle>
       <DataGrid.ContextMenu>
       <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
        <MenuItem Header="属性 / 完整编辑…" Click="CanProperties_Click"/>
        <MenuItem Header="编辑报文" Click="CanQuickEditMenu_Click"/>
        <Separator/>
        <MenuItem Header="新增报文" Command="{Binding AddCanRowCommand}"/>
        <MenuItem Header="复制" Command="{Binding CopyCanRowCommand}"/>
        <MenuItem Header="删除" Command="{Binding DeleteCanRowCommand}"/>
       </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="勾选" Width="42">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <CheckBox IsChecked="{Binding Included,Mode=TwoWay}" IsEnabled="{Binding CanToggleIncluded}"
          ToolTip="参与启动勾选发送；周期发送时可取消勾选暂停；行内单发独立"
          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="报文 / CAN ID" Width="126">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel VerticalAlignment="Center" ToolTip="{Binding PreviewFull}">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
           TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal">
           <TextBlock Text="{Binding PreviewId}" FontFamily="Consolas"
            FontSize="11" Foreground="#526B84"/>
           <TextBlock Text="{Binding PreviewDlc,StringFormat='  / {0}B'}"
            FontSize="11" Foreground="#7C8FA0" Margin="3,0,0,0"/>
          </StackPanel>
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="DATA (HEX)" Width="*" MinWidth="177">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <TextBlock Text="{Binding PreviewData}" FontFamily="Consolas"
          FontSize="12" TextTrimming="None" VerticalAlignment="Center"
          ToolTip="{Binding PreviewFull}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="状态" Width="93">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel VerticalAlignment="Center" ToolTip="{Binding Result}">
           <TextBlock Text="{Binding ModeLabel}" FontSize="12"/>
           <TextBlock Text="{Binding Result}" FontSize="12" TextTrimming="CharacterEllipsis">
            <TextBlock.Style><Style TargetType="TextBlock">
             <Setter Property="Foreground" Value="#43566B"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
               <Setter Property="Foreground" Value="#17633B"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSendFault}" Value="True">
               <Setter Property="Foreground" Value="#B42318"/>
               <Setter Property="FontWeight" Value="Bold"/>
              </DataTrigger>
             </Style.Triggers>
            </Style></TextBlock.Style>
           </TextBlock>
          </StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="操作" Width="116">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="{Binding RunLabel}" Padding="5,5" Margin="0,0,3,0"
           Command="{Binding DataContext.ToggleCanRowCommand,RelativeSource={RelativeSource AncestorType=Window}}"
           CommandParameter="{Binding}" ToolTip="独立启动或停止此报文；周期发送持续到主动停止"/>
          <Button Content="单发" Padding="4,5" Margin="0,0,3,0"
           Command="{Binding DataContext.SendCanRowOnceCommand,RelativeSource={RelativeSource AncestorType=Window}}"
           CommandParameter="{Binding}" ToolTip="独立单发一次，不停止其他周期报文"/>
 
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>

   <!-- CENTER: priority order is real station IO then reusable KEY actions. -->
   <GridSplitter x:Name="BenchSendSplitter" Grid.Column="1" Width="6" Background="#DEE5EB" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch"/>
    <Border x:Name="BenchKeyPanel" Grid.Column="2" Style="{StaticResource BenchCard}" Margin="0,0,4,0">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="工位控制" Style="{StaticResource BenchHeader}"/>
      
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="7"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="7"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Border Grid.Column="0" BorderBrush="#DEE8E1" BorderThickness="1"
        Background="#F9FBF9" CornerRadius="6" Padding="7">
        <StackPanel>
         <TextBlock Text="IGN" FontWeight="SemiBold" Foreground="#475668" Margin="0,0,0,5"/>
          <TextBlock Text="{Binding IgnGpioLabel}" FontSize="10" Foreground="#627C9D" Margin="0,0,0,6" ToolTip="{Binding LastIgnAck}"/>
         <Button Content="ON" Click="IgnOn_Click" IsEnabled="{Binding CanInvokeManualIo}" Margin="0,0,0,4" MinHeight="30"/>
         <Button Content="OFF" Click="IgnOff_Click" IsEnabled="{Binding CanInvokeManualIo}" MinHeight="30"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" Grid.ColumnSpan="3" BorderBrush="#DEE8E1"
        Background="#F9FBF9" CornerRadius="6" Padding="9">
        <StackPanel>
         <TextBlock Text="夹具" FontWeight="SemiBold" Foreground="#475668"
          Margin="0,0,0,5"/>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
          <Button Content="压紧" Click="FixturePress_Click"
           IsEnabled="{Binding CanInvokeManualIo}" MinWidth="95" MinHeight="34"
           Margin="0,0,9,0" Padding="10,5"/>
          <Button Content="释放" Click="FixtureRelease_Click"
           IsEnabled="{Binding CanInvokeManualIo}" MinWidth="95" MinHeight="34"
           Padding="10,5"/>
         </StackPanel>
         <TextBlock Text="{Binding LastClampStatus}" Foreground="#647A90"
          FontSize="11" TextWrapping="Wrap" MaxHeight="44"
          ToolTip="这里显示主控命令及 GPIO 状态，机械位置仍需真实反馈"/>
        </StackPanel>
       </Border>
      </Grid>
      <DockPanel Margin="0,8,0,0">
       <Button DockPanel.Dock="Right" Content="读夹具 GPIO" Command="{Binding ReadClampsCommand}"
        Padding="8,5" Margin="6,0,0,0"/>
       <Button DockPanel.Dock="Right" Content="读 IGN" Command="{Binding ReadIgnCommand}"
        Padding="8,5" Margin="6,0,0,0"/>
       
      </DockPanel>
      
      
      <!-- Real TestCtr PTC7/6/5 button inputs, unrelated to CAN KEY_SIM K1-K20. -->
      <Border BorderBrush="#DDE8E3" BorderThickness="1" Background="#FBFDFC"
       CornerRadius="7" Padding="9" Margin="0,8,0,0">
       <StackPanel>
        <DockPanel Margin="0,0,0,6">
         <Button DockPanel.Dock="Right" Content="刷新输入"
          Command="{Binding RefreshExternalKeyInputsCommand}"
          Padding="8,4" MinHeight="25" ToolTip="USB 0x45 只读查询主控板 KEY1~KEY3 稳定电平"/>
         <TextBlock Text="实体按键输入（主控板）" FontWeight="SemiBold"
          Foreground="#365A47" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
        <ItemsControl ItemsSource="{Binding ExternalKeyInputs}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate>
          <UniformGrid Columns="3"/>
         </ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
          <DataTemplate>
           <Border Background="White" BorderBrush="#DDE7E1" BorderThickness="1"
            CornerRadius="6" Padding="7,5" Margin="2">
            <StackPanel>
             <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
              Foreground="#344B5E"/>
             <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
              <TextBlock Text="{Binding LevelText}" FontSize="12"
               Foreground="#177A5A" FontWeight="SemiBold"/>
             </StackPanel>
             <TextBlock Text="{Binding StateText}" FontSize="10"
              Foreground="#65778A" TextWrapping="Wrap"/>
            </StackPanel>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding LastExternalKeyEvent}" FontSize="11"
         Foreground="#365A47" TextWrapping="Wrap" Margin="2,6,0,0"/>
        <TextBlock Text="{Binding ExternalKeyMonitorStatus}" FontSize="10"
         Foreground="#6B7C87" TextWrapping="Wrap" Margin="2,3,0,0"/>
       </StackPanel>
      </Border>

      <Border BorderBrush="#E3EAE5" BorderThickness="0,1,0,0" Margin="0,12,0,10"/>
      <DockPanel Margin="0,0,0,8">
       <Button DockPanel.Dock="Right" Content="实际全部断开 KEY"
        Command="{Binding ReleaseAllKeysCommand}" Margin="8,0,0,0"
        Padding="9,5" ToolTip="向按键板发送全部断开指令，不只是清空界面选择"/>
       <TextBlock DockPanel.Dock="Left" Text="按键动作"
        Style="{StaticResource BenchHeader}" FontSize="14" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="{Binding KeyRequestStatus}" FontSize="12" Foreground="#995400"
       TextWrapping="Wrap" Margin="0,0,0,8"
       ToolTip="只反映主控 ACK 的最后请求，不代表五路电压实测"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <DockPanel Margin="0,0,0,9">
        <Button DockPanel.Dock="Right" Content="+ 新建" Click="AddKeyAction_Click"
         Padding="8,5" Margin="5,0,0,0" ToolTip="新建一个可保存到工程的 KEY 组合动作"/>
        <Button DockPanel.Dock="Right" Content="管理动作" Click="ManageKeyActions_Click"
         Padding="8,5" Margin="5,0,0,0" ToolTip="进入 20 KEY 组合和每段时间编辑器"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding KeyLibraryState}"
         Foreground="#64788D" VerticalAlignment="Center" Margin="8,0,0,0"
         ToolTip="KEY 动作有效修改会自动保存；单击按钮执行前也会先保存"/>
        <TextBlock Text="按键动作" FontSize="15" FontWeight="SemiBold"
         Foreground="#254D70" VerticalAlignment="Center"/>
       </DockPanel>
       <Grid Margin="0,0,5,5">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="查找" FontSize="12" Foreground="#51677D"
         Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding KeyPadSearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         Padding="8,5" MinHeight="32" FontSize="13"
         ToolTip="动作较多时按名称即时筛选；不会改变已保存按钮的顺序"/>
       </Grid>
       <DockPanel Margin="0,0,6,8">
        <TextBlock Text="{Binding KeyPadCountLabel}" Foreground="#596D81"
         FontSize="12" VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Right" Text="单击执行 · 双击编辑"
         Foreground="#596D81" FontSize="11" HorizontalAlignment="Right"/>
       </DockPanel>
       <ItemsControl ItemsSource="{Binding VisibleKeyPads}" Margin="0,0,0,4">
        <ItemsControl.ItemsPanel>
         <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Button Style="{StaticResource BenchKeyActionPad}"
           Tag="{Binding}"
           Click="KeyPad_Click"
            PreviewMouseLeftButtonDown="KeyPad_PreviewMouseLeftButtonDown"
            PreviewMouseRightButtonDown="KeyPad_PreviewMouseRightButtonDown"
            ToolTip="单击执行 · 双击编辑 · 右键更多操作">
           <Button.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
             <MenuItem Header="编辑动作…" Tag="{Binding}" Click="EditKeyPad_Click"/>
             <MenuItem Header="复制动作" Tag="{Binding}" Click="CopyKeyPad_Click"/>
             <MenuItem Header="置顶并保存顺序" Tag="{Binding}" Click="PinKeyPad_Click"/>
             <Separator/>
             <MenuItem Header="删除动作…" Tag="{Binding}" Click="DeleteKeyPad_Click"/>
            </ContextMenu>
           </Button.ContextMenu>
           <Grid>
            <Grid.RowDefinitions>
             <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
             Foreground="#1B4569" TextTrimming="CharacterEllipsis"/>
            <Grid Grid.Row="1" Margin="0,7,0,0">
             <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
             </Grid.ColumnDefinitions>
             <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#607489"
              TextTrimming="CharacterEllipsis"/>
             <TextBlock Grid.Column="1" Text="{Binding RunLabel}" FontSize="11"
              FontWeight="SemiBold" Foreground="#17623E" Margin="5,0,0,0"/>
            </Grid>
           </Grid>
          </Button>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <TextBlock Text="{Binding KeyPadEmptyMessage}" FontSize="12"
        Foreground="#62788C" TextWrapping="Wrap" Margin="2,12,2,10"
        Visibility="{Binding IsKeyPadEmpty,Converter={StaticResource BoolToVisibility}}"/>
       <Border Background="#F6F9FC" BorderBrush="#DFE8F1" BorderThickness="1"
        CornerRadius="5" Padding="9" Margin="0,6,6,0">
        <StackPanel>
         <DockPanel Margin="0,0,0,5">
          <Button DockPanel.Dock="Right" Content="停止当前动作"
           Command="{Binding StopKeyActionCommand}" Padding="8,4" FontSize="12"
           ToolTip="只停止后续动作步骤，不会自动断开当前 KEY 组合"/>
          <TextBlock Text="最近操作 / 执行进度" FontSize="12" FontWeight="SemiBold"
           Foreground="#365671" VerticalAlignment="Center"/>
         </DockPanel>
         <TextBlock Text="{Binding KeyActionRunStatus}" TextWrapping="Wrap"
          FontSize="12" Foreground="#425A73" ToolTip="{Binding KeyActionRunStatus}"/>
         <TextBlock Text="动作结束不自动断开 KEY"
          FontSize="11" Foreground="#875C24" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>

   <!-- RIGHT: raw CAN data is the primary content. Logs are optional. -->
   <GridSplitter x:Name="BenchMonitorSplitter" Grid.Column="3" Width="6" Background="#DEE5EB" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch"/>
   <Border x:Name="BenchMonitorPanel" Grid.Column="4" Style="{StaticResource BenchCard}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,9">
      <DockPanel Margin="0,0,0,6">
       <TextBlock Text="CAN 接收监视" Style="{StaticResource BenchHeader}"/>
       <TextBlock DockPanel.Dock="Right" Text="{Binding MonitorCountSummary}"
        FontSize="11" Foreground="#647C95" Margin="8,0,0,0"
        TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,7">
       <ComboBox DockPanel.Dock="Left" Width="92" ItemsSource="{Binding MonitorChannelChoices}"
        SelectedItem="{Binding MonitorChannel,Mode=TwoWay}" MinHeight="32"/>
       <TextBox Text="{Binding MonitorQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        MinHeight="32" Padding="8,6" Margin="8,0,0,0"
        ToolTip="按 ID、完整/局部 HEX、通道筛选"/>
      </DockPanel>
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearMonitorCommand}"
        Padding="8,5" Margin="5,0,0,0"/>
       <Button DockPanel.Dock="Right" Content="{Binding MonitorPauseLabel}"
        Command="{Binding ToggleMonitorPauseCommand}" Padding="9,5" Margin="5,0,0,0"/>
       <CheckBox Content="逐帧模式（取消为最新值）" FontSize="11"
        IsChecked="{Binding MonitorShowTimeline,Mode=TwoWay}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="{Binding CanRxReceiveStatus}" FontSize="11" Foreground="#627C9D"
       TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
       ToolTip="{Binding CanRxReceiveStatus}"/>
     </StackPanel>
     <DataGrid x:Name="CanMonitorGrid" Grid.Row="1"
      ItemsSource="{Binding MonitorDisplay}" AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
      HeadersVisibility="Column" SelectionMode="Single"
      ColumnHeaderHeight="35" RowHeight="35" FontSize="12"
      GridLinesVisibility="Horizontal" BorderBrush="#E6EDF5"
      EnableRowVirtualization="True"
      ScrollViewer.HorizontalScrollBarVisibility="Auto"
      PreviewMouseRightButtonDown="MonitorGrid_RightClick">
      <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="4,5"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#334963"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGrid.ColumnHeaderStyle>
       <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="3,2"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style></DataGrid.CellStyle>
       <DataGrid.ContextMenu>
       <ContextMenu>
        <MenuItem Header="复制完整 CAN 帧" Click="CopyMonitorFrame_Click"/>
        <MenuItem Header="仅复制 HEX 数据" Click="CopyMonitorData_Click"/>
       </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="104"/>
       <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="56"/>
       <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="96"/>
       <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="42"/>
       <DataGridTemplateColumn Header="DATA (HEX)" Width="*" MinWidth="182">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <TextBlock Text="{Binding Data}" FontFamily="Consolas" FontSize="12"
          TextTrimming="None" VerticalAlignment="Center" ToolTip="{Binding FullFrame}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="64"/>
      </DataGrid.Columns>
     </DataGrid>
     <Expander Grid.Row="2" Header="设备通信与操作日志"
      IsExpanded="False" BorderBrush="#E3EAE5" BorderThickness="0,1,0,0"
      Padding="3,8">
      <DockPanel Height="250" Margin="3,8,3,2">
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
        <Button DockPanel.Dock="Right" Content="导出日志" Click="ExportLog_Click"
         Padding="8,5" Margin="5,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="清空日志" Command="{Binding ClearLogsCommand}"
         Padding="8,5" Margin="5,0,0,0"/>
        <TextBox Text="{Binding LogFilter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         MinHeight="29" Padding="7,5" ToolTip="筛选操作/错误内容"/>
       </DockPanel>
       <DataGrid ItemsSource="{Binding FilteredLogs}"
        SelectedItem="{Binding SelectedLog,Mode=TwoWay}"
        AutoGenerateColumns="False" IsReadOnly="True"
        CanUserAddRows="False" CanUserDeleteRows="False"
        HeadersVisibility="Column" GridLinesVisibility="Horizontal"
        ColumnHeaderHeight="30" RowHeight="28" EnableRowVirtualization="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="96"/>
         <DataGridTextColumn Header="事件" Binding="{Binding Direction}" Width="75"/>
         <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
      </DockPanel>
     </Expander>
    </Grid>
   </Border>
  </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource ToolbarSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,8">
   <TextBlock Text="{Binding Status}" Foreground="{StaticResource Ink}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>
