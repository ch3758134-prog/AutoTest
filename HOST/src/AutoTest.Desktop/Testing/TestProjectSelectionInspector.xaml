<UserControl x:Class="AutoTest.Desktop.Testing.TestProjectSelectionInspector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="#FBFCFF">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="12">
   <TextBlock Text="当前测试项目" Foreground="#64758C" FontSize="11" Margin="0,0,0,7"/>
   <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
    Margin="0,0,0,13" TextWrapping="Wrap"/>
   <TextBlock Text="本次选择" Foreground="#64758C" FontSize="11" Margin="0,0,0,7"/>
   <Border Background="#EAF3FF" CornerRadius="6" BorderBrush="#C8DEF9"
    BorderThickness="1" Padding="12">
    <StackPanel>
     <TextBlock Text="{Binding SelectionSummary}" Foreground="#2368BD"
      FontSize="15" FontWeight="Bold" Margin="0,0,0,7"/>
     <TextBlock Text="仅影响本次调试范围，不修改正式检测的用例顺序或生产计数。"
      Foreground="#64758C" TextWrapping="Wrap" FontSize="11"/>
    </StackPanel>
   </Border>
   <Button Content="▷ 检查所选用例" Command="{Binding PreflightSelectedCommand}"
    Style="{StaticResource AtPrimaryButton}" Margin="0,12,0,7"/>
   <TextBlock Text="{Binding StatusMessage}" Foreground="#A96D20"
    TextWrapping="Wrap" FontSize="11" Margin="0,0,0,7"/>
   <TextBlock Text="项目按顺序执行用例，并分别保存结果。"
    Foreground="#64758C" FontSize="11" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
