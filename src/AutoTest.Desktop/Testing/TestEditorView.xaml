<UserControl x:Class="AutoTest.Desktop.Testing.TestEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White" Foreground="#1E2C41"
 PreviewKeyDown="Editor_KeyDown">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="45"/>
   <RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBox x:Name="StepSearch" Width="146" Height="26" VerticalContentAlignment="Center"
      Text="{Binding StepFind,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      ToolTip="查找并高亮步骤；Enter 下一条，Shift+Enter 上一条"
      KeyDown="StepSearch_KeyDown" Margin="0,0,4,0"/>
     <TextBlock Text="{Binding SearchMatchCount,StringFormat='{}{0} 命中'}"
      Foreground="#A96D20" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0">
      <TextBlock.Style><Style TargetType="{x:Type TextBlock}">
       <Style.Triggers><DataTrigger Binding="{Binding StepFind}" Value="">
        <Setter Property="Visibility" Value="Collapsed"/>
       </DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
     <Button Content="＋ 添加步骤" Command="{Binding AddStepCommand}"
      Style="{StaticResource AtPrimaryButton}" Margin="0,0,6,0"
      ToolTip="选中阶段/分支：追加；选中步骤：插入其下方"/>
     <Menu Background="Transparent" Height="28" Margin="0,0,6,0">
      <MenuItem Header="常用步骤 ▾" Padding="7,3" FontSize="11"
       ToolTip="先选阶段或明确的子分支，再直接选择步骤类型">
       <MenuItem Header="发送 CAN 报文" Command="{Binding QuickAddCommand}" CommandParameter="can"/>
       <MenuItem Header="模拟 ECU 按键" Command="{Binding QuickAddCommand}" CommandParameter="key"/>
       <MenuItem Header="切换 IGN" Command="{Binding QuickAddCommand}" CommandParameter="ign"/>
       <MenuItem Header="读取 CAN 信号" Command="{Binding QuickAddCommand}" CommandParameter="read"/>
       <MenuItem Header="固定等待" Command="{Binding QuickAddCommand}" CommandParameter="wait"/>
       <Separator/>
       <MenuItem Header="IF / ELSE" Command="{Binding QuickAddCommand}" CommandParameter="if"/>
       <MenuItem Header="循环" Command="{Binding QuickAddCommand}" CommandParameter="loop"/>
       <MenuItem Header="期望判定" Command="{Binding QuickAddCommand}" CommandParameter="expect"/>
      </MenuItem>
     </Menu>
     <Button Content="检查问题" Command="{Binding PreflightCommand}" Margin="0,0,6,0"/>
     <Button Content="保存" Click="SaveEditor_Click"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding DocumentName}" FontSize="14" FontWeight="SemiBold"
      VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
     <Border Background="#F7F9FC" BorderBrush="#DBE3ED" BorderThickness="1"
      CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
      <TextBlock Text="{Binding StepCountLabel}" FontSize="10" Foreground="#64758C"/>
     </Border>
     <TextBlock Text="● 未保存" FontSize="10" Foreground="#A96D20"
      VerticalAlignment="Center" Margin="10,0,0,0">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsDirty}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Background="#F3F7FB" BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
   <Grid Margin="0,0,8,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/>
     <ColumnDefinition Width="29*" MinWidth="185"/>
     <ColumnDefinition Width="71*" MinWidth="220"/>
     <ColumnDefinition Width="126"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="序号" FontSize="11" Foreground="#435B74"
     VerticalAlignment="Center" HorizontalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="步骤 / 流程" FontSize="11" Foreground="#435B74"
     VerticalAlignment="Center" Margin="7,0"/>
    <TextBlock Grid.Column="2" Text="主要参数 / 判据" FontSize="11" Foreground="#435B74"
     VerticalAlignment="Center" Margin="6,0"/>
    <TextBlock Grid.Column="3" Text="资源" FontSize="11" Foreground="#435B74"
     VerticalAlignment="Center" Margin="6,0"/>
    <TextBlock Grid.Column="4" Text="状态" FontSize="11" Foreground="#435B74"
     VerticalAlignment="Center" Margin="6,0"/>
   </Grid>
  </Border>

  <ListBox x:Name="StepsList" Grid.Row="2" ItemsSource="{Binding StepRows}"
   SelectedItem="{Binding SelectedRow,Mode=TwoWay}"
   SelectionChanged="StepsList_SelectionChanged"
   BorderThickness="0" Background="White"
   HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto"
   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
   VirtualizingStackPanel.IsVirtualizing="True"
   VirtualizingStackPanel.VirtualizationMode="Recycling"
   PreviewMouseRightButtonDown="StepsList_RightClick" MouseDoubleClick="StepsList_DoubleClick"
   PreviewMouseLeftButtonDown="StepsList_PreviewMouseLeftButtonDown"
   PreviewMouseMove="StepsList_PreviewMouseMove"
   AllowDrop="True" DragOver="StepsList_DragOver" Drop="StepsList_Drop">
   <ListBox.ItemContainerStyle>
    <Style TargetType="{x:Type ListBoxItem}">
     <Setter Property="Padding" Value="0"/>
     <Setter Property="MinHeight" Value="0"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="Background" Value="White"/>
     <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F8FD"/></Trigger>
      <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
       <Setter Property="Background" Value="#FFF5DE"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsNewDraft}" Value="True">
       <Setter Property="Background" Value="#FFF9EC"/>
      </DataTrigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E3F1FF"/></Trigger>
     </Style.Triggers>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Grid MinWidth="580">
      <!-- HTML final override: color-coded phases and compact 35-DIP steps. -->
      <Border x:Name="PhaseRow" BorderThickness="4,1,0,1" Height="34"
       Visibility="{Binding IsPhase,Converter={StaticResource BoolToVisibility}}">
       <Border.Style>
        <Style TargetType="{x:Type Border}">
         <Setter Property="Background" Value="#EDF5FC"/>
         <Setter Property="BorderBrush" Value="#397FBB"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding PhaseKind}" Value="Test">
           <Setter Property="Background" Value="#EDF7F4"/>
           <Setter Property="BorderBrush" Value="#238A7A"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding PhaseKind}" Value="Cleanup">
           <Setter Property="Background" Value="#FFF6E9"/>
           <Setter Property="BorderBrush" Value="#CA8B2E"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </Border.Style>
       <DockPanel Margin="10,0">
        <Button DockPanel.Dock="Right" Content="＋ 添加" Tag="{Binding}" Click="AddAtRow_Click"
         Focusable="False" Height="23" MinHeight="0" Padding="6,0"
         Style="{StaticResource AtQuietButton}" Foreground="#2368BD"
         ToolTip="添加到此阶段末尾"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding RowCount}" FontSize="10"
         Foreground="#8798AB" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Button Content="{Binding ExpandMark}" Click="StepExpand_Click" Tag="{Binding}"
          Width="19" Height="23" MinWidth="0" MinHeight="0" Padding="0"
          Style="{StaticResource AtQuietButton}" Foreground="#4C6687" FontWeight="Bold"/>
         <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
          VerticalAlignment="Center" Margin="5,0,0,0">
          <TextBlock.Style><Style TargetType="{x:Type TextBlock}">
           <Setter Property="Foreground" Value="#27649A"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding PhaseKind}" Value="Test"><Setter Property="Foreground" Value="#177669"/></DataTrigger>
            <DataTrigger Binding="{Binding PhaseKind}" Value="Cleanup"><Setter Property="Foreground" Value="#9A671F"/></DataTrigger>
           </Style.Triggers>
          </Style></TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </DockPanel>
      </Border>

      <Border x:Name="SlotRow" Background="#FAFBFF" BorderBrush="#EDF1F6"
       BorderThickness="0,0,0,1" Height="25"
       Visibility="{Binding IsSlot,Converter={StaticResource BoolToVisibility}}">
       <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" VerticalAlignment="Center">
        <Button Content="{Binding ExpandMark}" Click="StepExpand_Click"
         Width="18" Height="22" MinWidth="0" MinHeight="0" Padding="0"
         Style="{StaticResource AtQuietButton}" Foreground="#7550AB"/>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10"
         Foreground="#7550AB" VerticalAlignment="Center" Margin="5,0,0,0"/>
       </StackPanel>
      </Border>

      <Border x:Name="StepRow" Background="Transparent" BorderBrush="#E7EDF5"
       BorderThickness="0,0,0,1" Height="35"
       Visibility="{Binding IsStep,Converter={StaticResource BoolToVisibility}}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/>
         <ColumnDefinition Width="29*" MinWidth="185"/>
         <ColumnDefinition Width="71*" MinWidth="220"/>
         <ColumnDefinition Width="126"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
        <Border Width="3" HorizontalAlignment="Left" Panel.ZIndex="2">
         <Border.Style><Style TargetType="{x:Type Border}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="Background" Value="#2477CD"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Background" Value="#D89826"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=IsSelected}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Background" Value="#2477CD"/>
           </DataTrigger>
          </Style.Triggers>
         </Style></Border.Style>
        </Border>

        <TextBlock Grid.Column="0" Text="{Binding SequenceText}" FontSize="10"
         Foreground="#8798AB" HorizontalAlignment="Center" VerticalAlignment="Center"
         FontFamily="Consolas"/>
        <TextBlock Grid.Column="0" Text="{Binding BreakpointMark}" Foreground="#C04A57"
         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0" FontSize="10"/>
        <Grid Grid.Column="1" Margin="{Binding Indent}">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="19"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <Button Grid.Column="0" Content="{Binding ExpandMark}" Click="StepExpand_Click"
          Height="23" Width="18" MinWidth="0" MinHeight="0" Padding="0"
          Style="{StaticResource AtQuietButton}" Foreground="#64758C"
          Focusable="False" ToolTip="展开／收起子步骤"/>
         <Border Grid.Column="1" Width="21" Height="21" CornerRadius="4"
          VerticalAlignment="Center" Margin="1,0">
          <Border.Style>
           <Style TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#E9EEF5"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Category}" Value="Can"><Setter Property="Background" Value="#E5F1FF"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Hardware"><Setter Property="Background" Value="#FFF0DA"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Uds"><Setter Property="Background" Value="#EEE7FA"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Flow"><Setter Property="Background" Value="#EEE7FA"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Wave"><Setter Property="Background" Value="#DFF5F0"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </Border.Style>
          <TextBlock Text="{Binding Icon}" FontSize="12"
           VerticalAlignment="Center" HorizontalAlignment="Center">
           <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
             <Setter Property="Foreground" Value="#66788E"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding Category}" Value="Can"><Setter Property="Foreground" Value="#2368BD"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Hardware"><Setter Property="Foreground" Value="#A26319"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Uds"><Setter Property="Foreground" Value="#7050A6"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Flow"><Setter Property="Foreground" Value="#7050A6"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Wave"><Setter Property="Foreground" Value="#147E72"/></DataTrigger>
             </Style.Triggers>
            </Style>
           </TextBlock.Style>
          </TextBlock>
         </Border>
         <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
          TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#1E2C41"
          VerticalAlignment="Center" ToolTip="{Binding Kind}" Margin="5,0,7,0"/>
        </Grid>
        <Grid Grid.Column="2" Margin="6,0">
         <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
          Foreground="#607B98" VerticalAlignment="Center" FontSize="12"
          Visibility="{Binding ShowQuickSummary,Converter={StaticResource BoolToVisibility}}"
          MouseLeftButtonDown="QuickSummary_MouseLeftButtonDown"
          ToolTip="步骤摘要；等待时间与循环次数可双击直接修改"/>
         <TextBox Text="{Binding QuickValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          Visibility="{Binding ShowInlineEditor,Converter={StaticResource BoolToVisibility}}"
          Background="White" BorderBrush="#5A9BD2" BorderThickness="1"
          Padding="4,1" Height="25" MinHeight="0" FontSize="12" Foreground="#264D74"
          VerticalAlignment="Center" VerticalContentAlignment="Center"
          ToolTip="Enter 应用到 TEST 草稿；Esc 恢复原值"
          LostFocus="QuickField_LostFocus" KeyDown="QuickField_KeyDown"/>
        </Grid>
        <TextBlock Grid.Column="3" Text="{Binding Resource}" TextTrimming="CharacterEllipsis"
         Foreground="#7A8DA4" VerticalAlignment="Center" FontSize="10" Margin="7,0"
         ToolTip="{Binding Resource}"/>
        <TextBlock Grid.Column="4" Text="{Binding State}" TextTrimming="CharacterEllipsis"
         VerticalAlignment="Center" FontSize="11" Margin="6,0" ToolTip="{Binding StateDetail}">
         <TextBlock.Style><Style TargetType="{x:Type TextBlock}">
          <Setter Property="Foreground" Value="#748399"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsNewDraft}" Value="True">
            <Setter Property="Foreground" Value="#A96D20"/>
            <Setter Property="FontWeight" Value="Bold"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding IsUnavailable}" Value="True"><Setter Property="Foreground" Value="#B05D47"/></DataTrigger>
           <DataTrigger Binding="{Binding HasRealExecutionError}" Value="True">
            <Setter Property="Foreground" Value="#BC454F"/>
            <Setter Property="FontWeight" Value="Bold"/>
           </DataTrigger>
          </Style.Triggers>
         </Style></TextBlock.Style>
        </TextBlock>
       </Grid>
      </Border>
     </Grid>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <Border Grid.Row="3" Background="#FBFCFF" BorderBrush="#DBE3ED" BorderThickness="0,1,0,0">
   <DockPanel Margin="10,0">
    <TextBlock DockPanel.Dock="Right" Text="右键 · F2 · F9 · Ctrl+Space"
     FontSize="10" Foreground="#8B9BAE" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding StatusMessage}" Foreground="#64758C" FontSize="10"
     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <!-- Native WPF searchable palette. Choice creates the undoable formal TEST draft. -->
  <Popup x:Name="ActionPalette" Placement="Center"
   PlacementTarget="{Binding ElementName=StepsList}" StaysOpen="False" AllowsTransparency="True">
   <Border Width="490" MaxHeight="560" Background="White" CornerRadius="8"
    BorderBrush="#CAD7E7" BorderThickness="1" Padding="14">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22"/></Border.Effect>
    <DockPanel LastChildFill="True">
     <TextBlock DockPanel.Dock="Top" Text="选择步骤类型" FontSize="15"
      FontWeight="SemiBold" Foreground="#234F82" Margin="0,0,0,9"/>
     <TextBlock DockPanel.Dock="Top" x:Name="PaletteHint"
      Text="选择后立即插入草稿，在右侧配置" FontSize="11"
      Foreground="#64758C" Margin="0,0,0,9"/>
     <TextBox DockPanel.Dock="Top" x:Name="PaletteSearch"
      TextChanged="PaletteSearch_Changed" KeyDown="PaletteSearch_KeyDown"
      ToolTip="搜索 CAN、IGN、按键、等待、IF、波形等操作"
      Height="29" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
     <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
      HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="取消" Click="PaletteCancel_Click" Margin="0,0,8,0" MinWidth="64"/>
      <Button Content="添加所选步骤" Click="PaletteSelect_Click"
       Style="{StaticResource AtPrimaryButton}" MinWidth="110"/>
     </StackPanel>
     <ListBox x:Name="PaletteList" MaxHeight="355" MinHeight="160"
      MouseDoubleClick="PaletteList_DoubleClick" KeyDown="PaletteList_KeyDown"
      PreviewMouseLeftButtonUp="PaletteList_PreviewMouseLeftButtonUp"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      BorderBrush="#DBE3ED" FontSize="12">
      <ListBox.GroupStyle>
       <GroupStyle>
        <GroupStyle.HeaderTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"
           Foreground="#48617E" Margin="8,10,2,4"/>
         </DataTemplate>
        </GroupStyle.HeaderTemplate>
        <GroupStyle.Panel>
         <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </GroupStyle.Panel>
       </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemContainerStyle>
       <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Width" Value="202"/>
        <Setter Property="MinHeight" Value="43"/>
        <Setter Property="Margin" Value="4,3"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D7E2EF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
         <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#EDF5FF"/>
          <Setter Property="BorderBrush" Value="#74A6DF"/>
         </Trigger>
         <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E5F1FF"/>
          <Setter Property="BorderBrush" Value="#4C8BC9"/>
         </Trigger>
        </Style.Triggers>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel ToolTip="{Binding Description}">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
         TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Category}" Foreground="#71849D" FontSize="10"
         TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
