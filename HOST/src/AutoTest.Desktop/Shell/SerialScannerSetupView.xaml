<UserControl x:Class="AutoTest.Desktop.Shell.SerialScannerSetupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Microsoft YaHei" FontSize="13" Background="#F7F9FC">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="扫码枪连接" FontSize="20" FontWeight="SemiBold" Foreground="#263D50"/>
   <TextBlock Text="连接设备后，扫码内容会立即显示在下方。"
     Foreground="#657B8D" Margin="0,5,0,12"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Border Background="White" Padding="15" BorderBrush="#DFE8EF" BorderThickness="1"
      CornerRadius="8" Margin="0,0,0,13">
     <StackPanel>
      <TextBlock Text="{Binding DeviceStatus}" TextWrapping="Wrap"
        Foreground="#425E76" Margin="0,0,0,12"/>
      <WrapPanel>
       <Button Content="刷新端口" Command="{Binding RefreshPortsCommand}"
         Padding="12,7" Margin="0,0,8,8"/>
       <ComboBox ItemsSource="{Binding AvailablePorts}"
         SelectedItem="{Binding SelectedPort,Mode=TwoWay}"
         IsEnabled="{Binding CanEditConnection}" Width="125" Height="32"
         Margin="0,0,8,8"/>
       <ComboBox ItemsSource="{Binding SupportedBaudRates}"
         SelectedItem="{Binding BaudRate,Mode=TwoWay}"
         IsEnabled="{Binding CanEditConnection}" Width="105" Height="32"
         Margin="0,0,8,8"/>
       <Button Content="连接" Command="{Binding ConnectCommand}"
         IsEnabled="{Binding CanEditConnection}" Padding="12,7" Margin="0,0,8,8"/>
       <Button Content="断开" Command="{Binding DisconnectCommand}"
         IsEnabled="{Binding IsConnected}" Padding="12,7" Margin="0,0,8,8"/>
      </WrapPanel>
      <WrapPanel>
       <Button Content="设为本工位扫码枪" Command="{Binding BindScannerDeviceCommand}"
         Padding="12,7" Margin="0,0,8,8"/>
       <Button Content="更换扫码枪" Command="{Binding ReplaceScannerDeviceCommand}"
         Padding="12,7"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Border Background="White" Padding="15" BorderBrush="#DFE8EF"
     BorderThickness="1" CornerRadius="8">
     <StackPanel>
      <TextBlock Text="最近扫码内容" Foreground="#657B8D"/>
      <TextBox Text="{Binding LastRaw,Mode=OneWay}" IsReadOnly="True"
       FontSize="20" FontWeight="SemiBold" Foreground="#245B83"
       TextWrapping="Wrap" Padding="10" Margin="0,6,0,15"/>
      <Expander Header="串口诊断" IsExpanded="False" Margin="0,0,0,10">
       <StackPanel Margin="0,8,0,0">
        <TextBlock Text="接收数据（HEX）" Foreground="#657B8D"/>
        <TextBox Text="{Binding LastHex,Mode=OneWay}" IsReadOnly="True"
         FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
         Padding="10" Margin="0,6,0,0"/>
       </StackPanel>
      </Expander>
      <TextBlock Text="检测工程的关联方式可在“工位设置”中修改。"
       Foreground="#657B8D" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="#E9F0F6" Padding="12"
   CornerRadius="6" Margin="0,12,0,0">
   <TextBlock Text="{Binding Status}" Foreground="#31546F" TextWrapping="Wrap"/>
  </Border>
 </Grid>
</UserControl>