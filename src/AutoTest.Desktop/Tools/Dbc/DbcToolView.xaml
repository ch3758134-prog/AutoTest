<UserControl x:Class="AutoTest.Desktop.Tools.Dbc.DbcToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="950" MinHeight="550">
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="DBC 专业编辑 · P-DBC" FontSize="18" FontWeight="Bold" Margin="0,0,16,0"/>
      <TextBox x:Name="DbcFilePathBox" Width="395" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="DBC 绝对文件路径（UTF-8）"/>
      <Button Content="选择 DBC…" Click="BrowseDbc_Click" Margin="5,0,0,0" Padding="8,4"/>
      <Button Content="打开" Command="{Binding OpenCommand}" Margin="8,0,0,0" Padding="12,4"/>
      <Button Content="保存" Command="{Binding SaveCommand}" Margin="6,0,0,0" Padding="12,4"/>
      <Button Content="重置" Command="{Binding ResetCommand}" Margin="6,0,0,0" Padding="12,4"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,9">
      <WrapPanel>
        <TextBlock Text="工程 manifest" VerticalAlignment="Center"/>
        <TextBox x:Name="DbcProjectPathBox" Width="270" Text="{Binding ProjectFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,4,0"/>
        <Button Content="选择工程…" Click="BrowseProject_Click" Margin="0,0,8,0" Padding="8,4"/>
        <TextBlock Text="DBC AssetId" VerticalAlignment="Center"/>
        <TextBox Width="260" Text="{Binding BoundAssetId, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,10,0"/>
        <Button Content="绑定工程资源" Command="{Binding BindProjectCommand}" Padding="9,4"/>
      </WrapPanel>
      <TextBlock Text="{Binding ProjectBindingSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,5"/>
      <StackPanel Orientation="Horizontal">
      <TextBlock Text="DBC Revision " FontWeight="SemiBold"/><TextBlock Text="{Binding Revision}" FontWeight="SemiBold"/>
      <TextBlock Text=" · " Margin="5,0"/><TextBlock Text="{Binding SupportSummary}" Foreground="DarkGoldenrod" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="报文树 (BO_)" Grid.Column="0" Margin="0,0,8,0"><DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="ID（0x100）/ 名称 / DLC / TX节点" Foreground="Gray"/>
          <TextBox Text="{Binding NewMessageId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
          <TextBox Text="{Binding NewMessageName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
          <TextBox Text="{Binding NewMessageDlc, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
          <TextBox Text="{Binding Transmitter, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
          <TextBlock Text="新增 Node"/><TextBox Text="{Binding NewNodeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
          <Button Content="添加节点" Command="{Binding AddNodeCommand}" Margin="0,2" Padding="8,3"/>
          <WrapPanel Margin="0,4"><Button Content="新增报文" Command="{Binding AddMessageCommand}" Padding="9,3"/>
            <Button Content="删除报文" Command="{Binding DeleteMessageCommand}" Margin="5,0" Padding="9,3"/>
            <Button Content="更新报文" Command="{Binding UpdateMessageCommand}" Margin="5,0" Padding="9,3"/></WrapPanel>
        </StackPanel><ListBox ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" DisplayMemberPath="Name"/>
      </DockPanel></GroupBox>
      <GroupBox Grid.Column="1" Header="信号树 (SG_)" Margin="0,0,8,0"><DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Bottom"><TextBox Text="{Binding SignalName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
          <WrapPanel><Button Content="新增信号" Command="{Binding AddSignalCommand}" Padding="8,3"/>
            <Button Content="删除信号" Command="{Binding DeleteSignalCommand}" Margin="4,0" Padding="8,3"/></WrapPanel>
        </StackPanel><ListBox ItemsSource="{Binding Signals}" SelectedItem="{Binding SelectedSignal}" DisplayMemberPath="Name"/>
      </DockPanel></GroupBox>
      <GroupBox Grid.Column="2" Header="属性 / 值表 / Replay"><Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <UniformGrid Grid.Row="0" Columns="4">
          <StackPanel Margin="3"><TextBlock Text="起始位"/><TextBox Text="{Binding StartBit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Margin="3"><TextBlock Text="位长度"/><TextBox Text="{Binding BitLength, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Margin="3"><TextBlock Text="Factor"/><TextBox Text="{Binding Factor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Margin="3"><TextBlock Text="Offset"/><TextBox Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Margin="3"><TextBlock Text="Minimum"/><TextBox Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Margin="3"><TextBlock Text="Maximum"/><TextBox Text="{Binding Maximum, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Margin="3"><TextBlock Text="Unit"/><TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Margin="3"><TextBlock Text="Receiver"/><TextBox Text="{Binding Receiver, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <StackPanel Margin="3"><CheckBox Content="Intel little-endian" IsChecked="{Binding Intel}"/></StackPanel>
          <StackPanel Margin="3"><CheckBox Content="Signed" IsChecked="{Binding Signed}"/></StackPanel>
          <StackPanel Margin="3"><TextBlock Text="Mux (M/mN)"/><TextBox Text="{Binding Mux, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          <Button Content="更新信号属性" Command="{Binding UpdateSignalCommand}" Margin="3" Padding="8,4"/>
        </UniformGrid>
        <WrapPanel Grid.Row="1" Margin="0,8"><TextBlock Text="值表 RAW" VerticalAlignment="Center"/>
          <TextBox Width="55" Text="{Binding LabelRaw, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,7,0"/>
          <TextBlock Text="说明" VerticalAlignment="Center"/><TextBox Width="150" Text="{Binding ValueLabel, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,7,0"/>
          <Button Content="设置值表" Command="{Binding LabelCommand}" Padding="8,3"/>
        </WrapPanel>
        <StackPanel Grid.Row="2" Margin="0,5,0,6">
          <TextBlock Text="CAN Replay（只解码离线帧，不发送 CAN）" FontWeight="SemiBold"/>
          <WrapPanel Margin="0,5"><TextBlock Text="Frame ID" VerticalAlignment="Center"/>
            <TextBox Width="80" Text="{Binding ReplayFrameId, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,8,0"/>
            <TextBox Width="240" Text="{Binding ReplayHex, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="解码" Command="{Binding ReplayCommand}" Margin="7,0" Padding="8,3"/></WrapPanel>
          <TextBlock Text="{Binding DecodeSummary}"/>
        </StackPanel>
        <TabControl Grid.Row="3"><TabItem Header="解码值 / Physical"><DataGrid ItemsSource="{Binding Decoded}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns><DataGridTextColumn Header="信号" Binding="{Binding SignalName}" Width="*"/>
            <DataGridTextColumn Header="Raw" Binding="{Binding RawValue}"/>
            <DataGridTextColumn Header="物理值" Binding="{Binding PhysicalValue}"/>
            <DataGridTextColumn Header="单位" Binding="{Binding Unit}"/>
            <DataGridTextColumn Header="值表" Binding="{Binding ValueDescription}" Width="*"/></DataGrid.Columns>
        </DataGrid></TabItem>
          <TabItem Header="DBC 位布局 / 原始 bit">
            <DataGrid ItemsSource="{Binding BitRows}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Byte" Binding="{Binding ByteIndex}"/>
                <DataGridTextColumn Header="Hex" Binding="{Binding RawHex}"/>
                <DataGridTextColumn Header="bit7" Binding="{Binding Bit7}" Width="130"/>
                <DataGridTextColumn Header="bit6" Binding="{Binding Bit6}" Width="130"/>
                <DataGridTextColumn Header="bit5" Binding="{Binding Bit5}" Width="130"/>
                <DataGridTextColumn Header="bit4" Binding="{Binding Bit4}" Width="130"/>
                <DataGridTextColumn Header="bit3" Binding="{Binding Bit3}" Width="130"/>
                <DataGridTextColumn Header="bit2" Binding="{Binding Bit2}" Width="130"/>
                <DataGridTextColumn Header="bit1" Binding="{Binding Bit1}" Width="130"/>
                <DataGridTextColumn Header="bit0" Binding="{Binding Bit0}" Width="130"/>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="信号位序">
            <DataGrid ItemsSource="{Binding LayoutSignals}" AutoGenerateColumns="True" IsReadOnly="True"/>
          </TabItem>
          <TabItem Header="DBC 源码定位 / 只读语法">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="4">
                <Button Content="检查当前磁盘 DBC（不修改源文件）" Command="{Binding DiagnoseSourceCommand}"
                        HorizontalAlignment="Left" Padding="8,3"/>
                <TextBlock Text="{Binding SourceDiagnosticSummary}" TextWrapping="Wrap" Margin="0,5"/>
              </StackPanel>
              <DataGrid ItemsSource="{Binding SourceIssues}" IsReadOnly="True" AutoGenerateColumns="False"
                        EnableRowVirtualization="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="行" Binding="{Binding Line}" Width="55"/>
                  <DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="80"/>
                  <DataGridTextColumn Header="代码" Binding="{Binding Code}" Width="170"/>
                  <DataGridTextColumn Header="诊断说明" Binding="{Binding Message}" Width="280"/>
                  <DataGridTextColumn Header="源行预览" Binding="{Binding Snippet}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="离线 CAN 归档 Replay">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="4">
                <TextBlock Text="兼容 WAVE RecordedCanArchive v1；必须先绑定工程 DBC。只读离线文件，严格核对 Revision/Hash。"
                           TextWrapping="Wrap"/>
                <WrapPanel Margin="0,4">
                  <TextBlock Text="归档 JSON" VerticalAlignment="Center"/>
                  <TextBox Width="360" Text="{Binding ArchiveFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,8,0"/>
                  <Button Content="校验并 Replay" Command="{Binding ReplayArchiveCommand}" Padding="8,3"/>
                </WrapPanel>
                <WrapPanel Margin="0,4">
                  <TextBlock Text="完整逐帧证据 JSONL" VerticalAlignment="Center"/>
                  <TextBox Width="360" Text="{Binding ArchiveEvidencePath, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,8,0"/>
                  <Button Content="完整导出（不覆盖）" Command="{Binding ExportArchiveEvidenceCommand}" Padding="8,3"/>
                  <CheckBox Content="包含原始 CAN Hex（本地敏感数据）" IsChecked="{Binding IncludeArchivedRawHex}" Margin="8,0"/>
                </WrapPanel>
                <TextBlock Text="{Binding ArchiveSummary}" TextWrapping="Wrap" Margin="0,4"/>
              </StackPanel>
              <DataGrid ItemsSource="{Binding ArchiveRows}" IsReadOnly="True" AutoGenerateColumns="False"
                        EnableRowVirtualization="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding FrameIndex}" Width="45"/>
                  <DataGridTextColumn Header="重建 UTC（非硬件时钟）" Binding="{Binding ReconstructedUtc}" Width="185"/>
                  <DataGridTextColumn Header="offset μs" Binding="{Binding OffsetMicroseconds}" Width="95"/>
                  <DataGridTextColumn Header="Bus" Binding="{Binding BusRole}" Width="85"/>
                  <DataGridTextColumn Header="CAN ID" Binding="{Binding FrameId}" Width="75"/>
                  <DataGridTextColumn Header="HEX" Binding="{Binding PayloadHex}" Width="110"/>
                  <DataGridTextColumn Header="结果" Binding="{Binding Status}" Width="115"/>
                  <DataGridTextColumn Header="错误码" Binding="{Binding ErrorCode}" Width="130"/>
                  <DataGridTextColumn Header="解码与失败明细" Binding="{Binding DecodedSummary}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
          <TabItem Header="操作时间线 / 原始证据">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                  <TextBlock Text="JSONL" VerticalAlignment="Center"/>
                  <TextBox Width="320" Text="{Binding TraceFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,8,0"/>
                  <Button Content="导出" Command="{Binding ExportTraceCommand}" Padding="8,3"/>
                  <CheckBox Content="保留 RawHex" IsChecked="{Binding IncludeRawTraceHex}" Margin="8,0"/>
                </WrapPanel>
                <WrapPanel Margin="0,5">
                  <TextBlock Text="过滤" VerticalAlignment="Center"/>
                  <TextBox Width="180" Text="{Binding TraceFilter, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,8,0"/>
                  <TextBlock Text="{Binding TraceQuality}" VerticalAlignment="Center"/>
                </WrapPanel>
              </StackPanel>
              <DataGrid ItemsSource="{Binding VisibleTraceEvents}" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="UTC" Binding="{Binding TimestampUtc}" Width="170"/>
                  <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="125"/>
                  <DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="95"/>
                  <DataGridTextColumn Header="错误" Binding="{Binding ErrorCode}" Width="120"/>
                  <DataGridTextColumn Header="RawHex" Binding="{Binding RawHex}" Width="145"/>
                  <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid></GroupBox>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="{Binding Status}"/>
      <TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/>
      <TextBlock Text="当前界面仅提供 Replay 解码；不执行真实 CAN 发送。复杂 DBC 语法采用只读保护，不自动删节。" Foreground="DarkGoldenrod"/></StackPanel>
  </Grid>
</UserControl>
