<UserControl x:Class="AutoTest.Desktop.Tools.Testing.R1ProjectRunView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F4F8FD" Foreground="#25394E" FontFamily="Microsoft YaHei UI"
 FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <SolidColorBrush x:Key="RunLine" Color="#D7E3F1"/>
  <SolidColorBrush x:Key="RunMuted" Color="#667F9A"/>
  <Style x:Key="RunPanel" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="{StaticResource RunLine}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="RunLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="#71869C"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="12,10,12,10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="340"/>
   <RowDefinition Height="7"/>
   <RowDefinition Height="188" MinHeight="140"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource RunPanel}" Padding="15,13,15,13" Margin="0,0,0,9">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="预检" Command="{Binding PreflightCommand}"/>
     <Button Content="▷  开始执行" Command="{Binding RunPhysicalReadOnlyCommand}" Style="{StaticResource AtPrimaryButton}"/>
     <Button Content="暂停" Command="{Binding PauseCommand}"/>
     <Button Content="继续" Command="{Binding ResumeCommand}"/>
     <Button Content="单步" Command="{Binding StepCommand}"/>
     <Button Content="停止" Command="{Binding StopCommand}" Style="{StaticResource AtDangerButton}"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="自动测试运行" FontSize="22" FontWeight="SemiBold" Foreground="#263B53"/>
     <TextBlock Text="{Binding DocumentName}" FontSize="12" Foreground="#5D7894" Margin="0,5,0,0"/>
     <TextBlock Text="仅记录来自真实 ECU 的执行事实，不将设备响应确认等同于测试通过。"
        FontSize="11" Foreground="#8A9CAF" Margin="0,4,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="233" MinWidth="188"/>
    <ColumnDefinition Width="7"/>
    <ColumnDefinition Width="*" MinWidth="370"/>
    <ColumnDefinition Width="7"/>
    <ColumnDefinition Width="285" MinWidth="260"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource RunPanel}" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F1F6FE" Padding="12,12"
       BorderBrush="#DDE8F4" BorderThickness="0,0,0,1">
      <StackPanel>
       <TextBlock Text="执行计划" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding SelectedScopeText}" Foreground="#66829C" FontSize="11" Margin="0,6,0,0"/>
      </StackPanel>
     </Border>
     <StackPanel DockPanel.Dock="Bottom" Margin="12,9,12,13">
      <StackPanel Orientation="Horizontal">
       <Button Content="全选" Command="{Binding SelectAllCasesCommand}" Style="{StaticResource AtQuietButton}"/>
       <Button Content="清空" Command="{Binding ClearCasesCommand}" Style="{StaticResource AtQuietButton}"/>
      </StackPanel>
      <Button Content="▶  执行勾选用例" Command="{Binding RunSelectedPhysicalCommand}"
         Style="{StaticResource AtPrimaryButton}" HorizontalAlignment="Stretch" Margin="0,9,0,0"/>
      <TextBlock Text="此选择不更改生产程序范围" Foreground="#8898A9" FontSize="10"
        TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,9">
      <ItemsControl ItemsSource="{Binding TestCases}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="#E6EDF5" BorderThickness="0,0,0,1" Padding="6,11">
         <CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay}">
          <StackPanel>
           <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding StepCount,StringFormat={}{0} 个步骤}" Foreground="#8699AF" FontSize="11" Margin="0,5,0,0"/>
          </StackPanel>
         </CheckBox>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions>
     <RowDefinition Height="83"/>
     <RowDefinition Height="151"/>
     <RowDefinition Height="*" MinHeight="155"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource RunPanel}" Padding="11,9" Margin="0,0,0,8">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/>
       <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.5*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
       <TextBlock Text="运行状态" Style="{StaticResource RunLabel}"/>
       <TextBlock Text="{Binding Verdict}" FontSize="17" FontWeight="SemiBold" Foreground="#2F7FD5" Margin="0,7,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="总步骤" Style="{StaticResource RunLabel}"/><TextBlock Text="{Binding RunTotalSteps}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="已完成" Style="{StaticResource RunLabel}"/><TextBlock Text="{Binding RunCompletedSteps}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="3"><TextBlock Text="失败" Style="{StaticResource RunLabel}"/><TextBlock Text="{Binding RunFailedSteps}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="4">
       <TextBlock Text="进度" Style="{StaticResource RunLabel}"/>
       <TextBlock Text="{Binding RunProgressLabel}" FontSize="14" FontWeight="SemiBold" Foreground="#327BC9" Margin="0,4,0,4"/>
       <ProgressBar Minimum="0" Maximum="100" Value="{Binding RunProgressPercent}" Height="8"/>
      </StackPanel>
     </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource RunPanel}" Padding="10,8" Margin="0,0,0,8">
     <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
       <TextBlock Text="当前执行流程" FontSize="14" FontWeight="SemiBold" Foreground="#324B67"/>
       <TextBlock DockPanel.Dock="Right" Text="{Binding RunFactsText}" Foreground="#8A9CB0" FontSize="11"/>
      </DockPanel>
      <ItemsControl ItemsSource="{Binding RunTimelineRows}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="#EFF5FD" BorderBrush="#E0EAF6" BorderThickness="1"
           CornerRadius="6" Margin="3" Padding="8,11">
         <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="{Binding Number}" FontWeight="SemiBold" Foreground="#317BCA" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="155" FontSize="11"
            HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"/>
          <TextBlock Text="{Binding Verdict}" Foreground="#347CC8" FontWeight="SemiBold" FontSize="11"
            HorizontalAlignment="Center" Margin="0,7,0,0"/>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </DockPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource RunPanel}" Padding="0">
     <DockPanel>
      <Border DockPanel.Dock="Top" Background="#EFF4FB" BorderBrush="#DDE7F3" BorderThickness="0,0,0,1" Padding="10,7">
       <TextBlock Text="实时测试步骤" FontSize="14" FontWeight="SemiBold"/>
      </Border>
      <DataGrid ItemsSource="{Binding RunStepRows}" SelectedItem="{Binding SelectedRunStep,Mode=TwoWay}"
        IsReadOnly="True" AutoGenerateColumns="False" RowHeaderWidth="0" BorderThickness="0"
        CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
       <DataGrid.Columns>
        <DataGridTextColumn Header="序号" Binding="{Binding Number}" Width="48"/>
        <DataGridTextColumn Header="阶段" Binding="{Binding Phase}" Width="80"/>
        <DataGridTextColumn Header="步骤" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="预期" Binding="{Binding Expected}" Width="1.5*"/>
        <DataGridTextColumn Header="实际" Binding="{Binding Actual}" Width="*"/>
        <DataGridTextColumn Header="判定" Binding="{Binding Verdict}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Border>
   </Grid>
   <GridSplitter Grid.Column="3" Width="7" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Column="4" Style="{StaticResource RunPanel}" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F3F7FD" Padding="13,13" BorderBrush="#DFE8F4" BorderThickness="0,0,0,1">
      <TextBlock Text="当前步骤详情" FontSize="15" FontWeight="SemiBold"/>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="13,13">
       <TextBlock Text="步骤名称" Style="{StaticResource RunLabel}"/>
       <TextBlock Text="{Binding SelectedRunStep.Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,14"/>
       <TextBlock Text="步骤类型" Style="{StaticResource RunLabel}"/>
       <TextBlock Text="{Binding SelectedRunStep.Type}" Margin="0,5,0,13"/>
       <TextBlock Text="预期结果" Style="{StaticResource RunLabel}"/>
       <TextBlock Text="{Binding SelectedRunStep.Expected}" TextWrapping="Wrap" Margin="0,5,0,13"/>
       <TextBlock Text="实际观测" Style="{StaticResource RunLabel}"/>
       <TextBlock Text="{Binding SelectedRunStep.Actual}" TextWrapping="Wrap" Margin="0,5,0,13"/>
       <TextBlock Text="结果判定" Style="{StaticResource RunLabel}"/>
       <TextBlock Text="{Binding SelectedRunStep.Verdict}" Foreground="#317CCF" FontWeight="SemiBold" Margin="0,5,0,13"/>
       <TextBlock Text="质量 / 来源" Style="{StaticResource RunLabel}"/>
       <TextBlock Text="{Binding SelectedRunStep.Quality}" Margin="0,5,0,2"/>
       <TextBlock Text="{Binding SelectedRunStep.Source}" Margin="0,0,0,13"/>
       <TextBlock Text="诊断原因 / 追踪" Style="{StaticResource RunLabel}"/>
       <TextBlock Text="{Binding SelectedRunStep.Diagnostic}" TextWrapping="Wrap" Margin="0,5,0,6"/>
       <TextBlock Text="{Binding SelectedRunStep.TraceReference}" Foreground="#65819C" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <GridSplitter Grid.Row="2" Height="7" HorizontalAlignment="Stretch" Background="Transparent"/>
  <Border Grid.Row="3" Style="{StaticResource RunPanel}" Padding="0">
   <TabControl Background="White" BorderThickness="0">
    <TabItem Header="执行结果">
     <DataGrid ItemsSource="{Binding Facts}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0" BorderThickness="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="阶段" Binding="{Binding Phase}" Width="90"/>
       <DataGridTextColumn Header="步骤" Binding="{Binding NodeType}" Width="160"/>
       <DataGridTextColumn Header="预期" Binding="{Binding Expected}" Width="*"/>
       <DataGridTextColumn Header="实际" Binding="{Binding Actual}" Width="*"/>
       <DataGridTextColumn Header="判定" Binding="{Binding Verdict}" Width="110"/>
       <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="125"/>
       <DataGridTextColumn Header="诊断" Binding="{Binding Diagnostic}" Width="1.3*"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="诊断追踪">
     <DataGrid ItemsSource="{Binding Facts}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0" BorderThickness="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="步骤" Binding="{Binding NodeType}" Width="130"/>
       <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="110"/>
       <DataGridTextColumn Header="Trace" Binding="{Binding TraceReference}" Width="*"/>
       <DataGridTextColumn Header="诊断" Binding="{Binding Diagnostic}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="操作状态">
     <ScrollViewer Padding="13,9" Background="White">
      <StackPanel>
       <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding PhysicalEvidencePath}" Foreground="#71859C" TextWrapping="Wrap" Margin="0,7,0,0"/>
       <TextBlock Text="{Binding CurrentFailureText}" Foreground="#9A5A4C" TextWrapping="Wrap" Margin="0,7,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>
  </Border>
 </Grid>
</UserControl>