<UserControl x:Class="AutoTest.Desktop.Shell.ProjectConfigurationOverviewInspector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="#FBFCFF">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="12">
   <TextBlock Text="当前配置任务" Foreground="#64758C" FontSize="11" Margin="0,0,0,8"/>
   <TextBlock Text="工程配置" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,13"/>
   <Border Background="#E9EEF5" Height="1" Margin="0,0,0,13"/>
   <Button Content="DUT 资源绑定" Command="{Binding OpenTcfCommand}" Margin="0,0,0,7"/>
   <Button Content="按键输入配置" Command="{Binding OpenControllerCommand}" Margin="0,0,0,7"/>
   <Button Content="工位物理能力" Command="{Binding OpenTbcCommand}" Margin="0,0,0,12"/>
   <TextBlock Text="已关联工程资源" FontWeight="SemiBold" Margin="0,0,0,7"/>
   <TextBlock Text="{Binding SelectedConfigurationSummary}" Foreground="#64758C" TextWrapping="Wrap"
    FontSize="11"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
