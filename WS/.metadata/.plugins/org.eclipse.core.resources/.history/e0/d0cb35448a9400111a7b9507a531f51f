/* 心跳帧：1s 周期发送，主控板经 0x41 回传上位机，用于判断按键板在线。
 * ID=0x1A0 标准帧；数据[0]=特征字节 0x5A，数据[1]=递增计数（上位机看跳变判断活着）。 */
#define HB_CAN_ID   0x1A0U

void SetDefault(void)
{
    Drv_Gpio_AllKeyHigh();
    KEY7_OFF();
    KEY10_OFF();
}

void SetPark(void)
{
    Drv_Gpio_AllKeyHigh();
    KEY7_OFF();
    KEY8_OFF();
    wait_ms(200);
    SetDefault();
}

void SetRele(void)
{
    Drv_Gpio_AllKeyHigh();
    KEY12_OFF();
    KEY13_OFF();
    wait_ms(200);
    SetDefault();
}

