<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>
  <sys:Double x:Key="BodySize">13</sys:Double>
  <sys:Double x:Key="TitleSize">20</sys:Double>
  <sys:Double x:Key="SectionTitleSize">15</sys:Double>
  <sys:Double x:Key="CaptionSize">11</sys:Double>
  <Style TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="{StaticResource BodySize}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>
</ResourceDictionary>