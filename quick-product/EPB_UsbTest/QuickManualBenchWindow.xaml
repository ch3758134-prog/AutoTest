<Window x:Class="EPB_UsbTest.QuickManualBenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoTest QUICK · 手动台架" Width="1560" Height="940" MinWidth="1260" MinHeight="710"
        WindowStartupLocation="CenterOwner" Background="#F5F7FB" FontFamily="Microsoft YaHei UI"
        FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Bench_Loaded" Closing="Bench_Closing" Closed="Bench_Closed">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#213044"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#66778A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="32"/><Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="AlternatingRowBackground" Value="#F6F9FD"/>
            <Setter Property="BorderBrush" Value="#E0E7F0"/><Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#DFE7F0" BorderThickness="1"
                CornerRadius="8" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="手动台架" FontSize="18" FontWeight="SemiBold" Foreground="#213044"/>
                    <TextBlock Text="CAN1 ECU 发送 · CAN0 KEY_SIM · IGN / 双夹具 · CAN0/1 观察"
                               FontSize="11" Foreground="#63788E" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceStateText" Text="USB 未连接" Foreground="#687A90"
                               VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FirmwareStateText" Text="固件未核验" Foreground="#687A90"
                               VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                    <Button Content="读取状态" Style="{StaticResource BtnToolbar}" Click="ReadHardware_Click"/>
                    <Button x:Name="ConnectButton" Content="连接主控" Style="{StaticResource BtnToolbarPrimary}"
                            MinWidth="90" Click="Connect_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.4*" MinWidth="350"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="3.8*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="3.3*" MinWidth="315"/>
            </Grid.ColumnDefinitions>
            <!-- CAN transmit: G4 layout and actions adapted to the old QUICK transport. -->
            <Border Grid.Column="0" Style="{StaticResource QuickPanel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="210" MinHeight="145"/>
                        <RowDefinition Height="6"/><RowDefinition Height="*" MinHeight="190"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="＋ 报文" Style="{StaticResource BtnToolbarPrimary}" Click="AddCan_Click"/>
                            <Button Content="复制" Style="{StaticResource BtnToolbar}" Click="CopyCan_Click"/>
                            <Button Content="删除" Style="{StaticResource BtnToolbar}" Click="DeleteCan_Click"/>
                        </StackPanel>
                        <TextBlock Text="CAN1 · 发送报文" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>
                    <DataGrid x:Name="CanTxGrid" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="CanTxGrid_SelectionChanged"
                              IsReadOnly="False" CanUserSortColumns="False" Margin="0,0,0,0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="选" Binding="{Binding Included,Mode=TwoWay}" Width="34"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding IdText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="94"/>
                            <DataGridCheckBoxColumn Header="周期" Binding="{Binding Periodic,Mode=TwoWay}" Width="48"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" IsReadOnly="True" Width="86"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#E7EDF4"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,9">
                            <TextBlock Text="选中报文编辑" FontWeight="SemiBold" Foreground="#213044" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="刷新 DBC" Style="{StaticResource BtnToolbar}"
                                    Click="ReloadDbc_Click" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,8,7">
                                <TextBlock Text="CAN ID (HEX)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="CanIdBox" Width="120" Height="29" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,7">
                                <TextBlock Text="DLC" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="CanDlcBox" Width="52" Height="29" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,7">
                                <TextBlock Text="周期 (ms)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="CanPeriodBox" Width="82" Height="29" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,7" VerticalAlignment="Bottom">
                                <CheckBox x:Name="CanIdeCheck" Content="扩展帧" Margin="0,0,0,6"/>
                                <CheckBox x:Name="CanPeriodicCheck" Content="周期发送"/>
                            </StackPanel>
                        </WrapPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <CheckBox x:Name="CanUseDbcCheck" Content="按 DBC 信号编辑（否则原始 HEX）"
                                          Checked="CanUseDbc_Changed" Unchecked="CanUseDbc_Changed"/>
                                <ComboBox x:Name="CanDbcCombo" DisplayMemberPath="Display"
                                          SelectionChanged="CanDbcCombo_SelectionChanged"
                                          MinHeight="30" Margin="0,6,0,7"/>
                                <DataGrid x:Name="CanSignalsGrid" Height="115" CanUserResizeColumns="True"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="DBC 信号（中文 / 原名）" Binding="{Binding Display}"
                                                            IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="物理值" Binding="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                            Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="原始数据 HEX（1～8字节）" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                                <TextBox x:Name="CanDataBox" MinHeight="31" FontFamily="Consolas" FontSize="12"/>
                                <TextBlock Text="周期发送只调用主控 0x50/0x51，整表替换，不启用 PC 定时线程。"
                                           TextWrapping="Wrap" Foreground="#7A8798" FontSize="11" Margin="0,9,0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="保存编辑" Style="{StaticResource BtnToolbar}" Click="SaveCan_Click"/>
                            <Button Content="单发当前" Style="{StaticResource QuickSecondaryToolbar}" Click="SendSelectedCan_Click"/>
                            <Button Content="单发勾选" Style="{StaticResource BtnToolbar}" Click="SendCheckedCan_Click"/>
                            <Button Content="启动周期" Style="{StaticResource BtnToolbarPrimary}" Click="StartPeriodic_Click"/>
                            <Button Content="停止周期" Style="{StaticResource BtnToolbarDanger}" Click="StopPeriodic_Click"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" Background="#E7EDF4" HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>
            <!-- Middle: real fixture/IGN and 20-switch KEY action editor. -->
            <Border Grid.Column="2" Style="{StaticResource QuickPanel}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="工位控制 · 主控 GPIO" Style="{StaticResource SectionTitle}"/>
                            <Button DockPanel.Dock="Right" Content="读取 GPIO" Style="{StaticResource BtnToolbar}" Click="ReadHardware_Click"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F6F9FD" CornerRadius="6" Margin="0,0,5,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="IGN" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="IgnValueText" Text="GPIO: 未读" Style="{StaticResource FieldLabel}" Margin="0,4,0,7"/>
                                    <Button Content="ON" Click="IgnOn_Click" Margin="0,0,0,4"/>
                                    <Button Content="OFF" Click="IgnOff_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#F6F9FD" CornerRadius="6" Margin="5,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="夹具 1" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Clamp1Text" Text="GPIO: 未读" Style="{StaticResource FieldLabel}" Margin="0,4,0,7"/>
                                    <Button Content="压紧" Click="Clamp1Press_Click" Margin="0,0,0,4"/>
                                    <Button Content="释放" Click="Clamp1Release_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#F6F9FD" CornerRadius="6" Margin="5,0,0,0" Padding="8">
                                <StackPanel>
                                    <TextBlock Text="夹具 2" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Clamp2Text" Text="GPIO: 未读" Style="{StaticResource FieldLabel}" Margin="0,4,0,7"/>
                                    <Button Content="压紧" Click="Clamp2Press_Click" Margin="0,0,0,4"/>
                                    <Button Content="释放" Click="Clamp2Release_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="GPIO 读回不等于 ECU 实测电压或夹具机械到位。" Foreground="#937138"
                                   FontSize="11" Margin="2,0,0,15" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="按键动作 · CAN0" Style="{StaticResource SectionTitle}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="新建" Style="{StaticResource BtnToolbarPrimary}" Click="NewKeyAction_Click"/>
                                <Button Content="复制" Style="{StaticResource BtnToolbar}" Click="CopyKeyAction_Click"/>
                                <Button Content="删除" Style="{StaticResource BtnToolbar}" Click="DeleteKeyAction_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="20 路模拟开关（5 路电阻网络输出）；每段使用完整 Mask 替换上段状态。"
                                   Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ListBox x:Name="KeyActionList" Height="102" SelectionChanged="KeyActionList_SelectionChanged"
                                 DisplayMemberPath="Name" HorizontalContentAlignment="Stretch"/>
                        <DockPanel Margin="0,8,0,10">
                            <TextBlock Text="动作步骤（仅 Mask + 保持时间）" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="＋步骤" Click="NewKeyStep_Click" Style="{StaticResource BtnToolbar}"/>
                                <Button Content="复制" Click="CopyKeyStep_Click" Style="{StaticResource BtnToolbar}"/>
                                <Button Content="删除" Click="DeleteKeyStep_Click" Style="{StaticResource BtnToolbar}"/>
                                <Button Content="↑" Click="MoveKeyStepUp_Click" Width="29" Padding="0"/>
                                <Button Content="↓" Click="MoveKeyStepDown_Click" Width="29" Padding="0"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="KeyStepsList" Height="112" SelectionChanged="KeyStepsList_SelectionChanged"
                                 DisplayMemberPath="Summary"/>
                        <WrapPanel Margin="0,10,0,7">
                            <StackPanel Margin="0,0,9,0">
                                <TextBlock Text="Mask（20-bit HEX）" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="KeyMaskBox" Width="145" Height="30" FontFamily="Consolas"
                                         TextChanged="KeyMask_Changed"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,9,0">
                                <TextBlock Text="保持 (ms)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="KeyHoldBox" Width="105" Height="30"
                                         TextChanged="KeyHold_Changed"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Bottom">
                                <Button Content="当前组合发送" Style="{StaticResource QuickSecondaryToolbar}"
                                        Click="ApplyKeyMask_Click" ToolTip="只发送完整 20-bit Mask，不自动释放"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock x:Name="KeyMaskInfo" Text="实体 KEY 状态 UNKNOWN；未发送任何初始化命令。"
                                   Foreground="#806A3A" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/>
                        <ItemsControl x:Name="KeySwitches">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked,Mode=TwoWay}"
                                              Checked="KeySwitch_Changed" Unchecked="KeySwitch_Changed"
                                              HorizontalAlignment="Left" Margin="4,5" FontSize="12"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="清空勾选" Click="ClearKeys_Click" Style="{StaticResource BtnToolbar}"
                                    ToolTip="仅改编辑值，不下发实体指令"/>
                            <Button Content="保存动作" Click="SaveKeyActions_Click" Style="{StaticResource BtnToolbar}"/>
                            <Button Content="▶ 运行动作" Click="RunKeyAction_Click" Style="{StaticResource BtnToolbarPrimary}"/>
                            <Button Content="■ 停止动作" Click="StopKeyAction_Click" Style="{StaticResource BtnToolbarDanger}"/>
                        </WrapPanel>
                        <TextBlock x:Name="KeyRunStateText" Text="未运行 KEY 动作" Foreground="#63788E"
                                   TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="3" Width="6" Background="#E7EDF4" HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>
            <!-- Right: live combined monitor and original frame/operator log. -->
            <Border Grid.Column="4" Style="{StaticResource QuickPanel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="175"/>
                        <RowDefinition Height="6"/><RowDefinition Height="215" MinHeight="125"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="CAN0 / CAN1 实时监控" Style="{StaticResource SectionTitle}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="PauseMonitorButton" Content="暂停显示" Click="PauseMonitor_Click" Padding="7,4"/>
                                <Button Content="清空" Click="ClearMonitor_Click" Padding="7,4" Margin="3,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid x:Name="MonitorGrid" Grid.Row="1" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CAN" Binding="{Binding Channel}" Width="45"/>
                                <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="87"/>
                                <DataGridTextColumn Header="数据" Binding="{Binding DataText}" Width="*"/>
                                <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="51"/>
                                <DataGridTextColumn Header="周期" Binding="{Binding PeriodText}" Width="57"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <GridSplitter Grid.Row="1" Height="6" Background="#E7EDF4" HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"/>
                    <Grid Grid.Row="2" Margin="0,7,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock Text="操作 / 收发日志" Style="{StaticResource SectionTitle}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="导出" Click="ExportLogs_Click" Padding="7,4"/>
                                <Button Content="清空" Click="ClearLogs_Click" Padding="7,4" Margin="4,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox x:Name="BenchLogList" Grid.Row="1" FontFamily="Consolas" FontSize="11"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>