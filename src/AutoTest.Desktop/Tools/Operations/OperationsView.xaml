<UserControl x:Class="AutoTest.Desktop.Tools.Operations.OperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="650" MinHeight="410"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="170"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="17" Text="操作审计 / Trace" Margin="0,0,16,0" VerticalAlignment="Center" />
      <TextBlock Foreground="DimGray" VerticalAlignment="Center" Text="追加记录 · 失败可查 · 不等真实设备连接"/>
    </DockPanel>
    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <TextBox Width="200" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索事件类别、错误阶段、概要" Margin="0,0,8,0"/>
      <TextBlock Text="来源" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <ComboBox Width="104" ItemsSource="{Binding OriginOptions}" SelectedItem="{Binding OriginFilter}" Margin="0,0,8,0"/>
      <CheckBox Content="仅错误" IsChecked="{Binding OnlyFailures}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <CheckBox Content="有关联 Trace" IsChecked="{Binding OnlyWithTrace}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <Button Content="_查询" Command="{Binding RefreshCommand}" Padding="12,3" IsDefault="True" Margin="0,0,8,0"/>
      <Button Content="更多" Command="{Binding MoreCommand}" Padding="12,3"/>
    </WrapPanel>
    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
      <TextBlock Text="设备" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <TextBox Width="170" Text="{Binding DeviceFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
      <TextBlock Text="RunId" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <TextBox Width="205" Text="{Binding RunFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
      <TextBlock Text="OperationId" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <TextBox Width="205" Text="{Binding OperationFilter, UpdateSourceTrigger=PropertyChanged}"/>
    </WrapPanel>
    <DataGrid Grid.Row="3" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
              CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,0,0,6">
      <DataGrid.Columns>
        <DataGridTextColumn Header="UTC" Binding="{Binding OccurredUtc, StringFormat={}{0:MM-dd HH:mm:ss.fff}}" Width="145"/>
        <DataGridTextColumn Header="来源" Binding="{Binding Origin}" Width="85"/>
        <DataGridTextColumn Header="等级" Binding="{Binding Level}" Width="80"/>
        <DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="94"/>
        <DataGridTextColumn Header="操作" Binding="{Binding Kind}" Width="140"/>
        <DataGridTextColumn Header="设备" Binding="{Binding DeviceId}" Width="105"/>
        <DataGridTextColumn Header="错误码" Binding="{Binding NativeErrorCode}" Width="82"/>
        <DataGridTextColumn Header="事件摘要" Binding="{Binding Summary}" Width="*" MinWidth="120"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="4" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Grid.Column="0" Header="操作事实 / 原生错误 / 会话世代">
        <TextBox IsReadOnly="True" Text="{Binding Detail, Mode=OneWay}" FontFamily="Consolas" FontSize="11"
                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      </GroupBox>
      <GroupBox Grid.Column="2" Header="原始 Trace / SHA-256 / 反向关联">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,5">
            <Button Content="校验并打开 Trace" Command="{Binding TraceCommand}" Padding="9,2" Margin="0,0,6,0"/>
            <Button Content="查关联事件" Command="{Binding ReverseTraceCommand}" Padding="9,2"/>
          </StackPanel>
          <TextBox IsReadOnly="True" Text="{Binding TraceText, Mode=OneWay}" FontFamily="Consolas" FontSize="11"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </DockPanel>
      </GroupBox>
    </Grid>
    <StackPanel Grid.Row="5">
      <DockPanel Margin="0,0,0,5" LastChildFill="True">
        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="导出到" Margin="0,0,6,0"/>
        <Button DockPanel.Dock="Right" Content="诊断 ZIP（含 Trace）" Command="{Binding BundleCommand}" Padding="10,3" Margin="5,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="JSONL 导出" Command="{Binding JsonlCommand}" Padding="10,3" Margin="5,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="CSV 导出" Command="{Binding CsvCommand}" Padding="10,3" Margin="5,0,0,0"/>
        <TextBox Text="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入尚不存在的路径；诊断包必须使用 .zip 后缀"/>
      </DockPanel>
      <TextBlock Text="{Binding State}" Foreground="DimGray" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
