<UserControl x:Class="AutoTest.Desktop.Shell.AutomaticTestHomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AutoTest.Desktop.Shell"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 Background="#F5F7FA" Foreground="#263849" UseLayoutRounding="True">
 <UserControl.Resources>
  <local:OperatorRowWidthConverter x:Key="OperatorRowWidthConverter"/>
  <local:OperatorStateTextConverter x:Key="OperatorStateTextConverter"/>
  <Style x:Key="OperatorCaption" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="#62758A"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="OperatorFact" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="#263849"/>
  </Style>
  <Style x:Key="OperatorState" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#53687B"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding State}" Value="执行中">
     <Setter Property="Foreground" Value="#1463A2"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="实测通过">
     <Setter Property="Foreground" Value="#197047"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="执行异常">
     <Setter Property="Foreground" Value="#B42318"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="已停止">
     <Setter Property="Foreground" Value="#A35A19"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="引用需修复">
     <Setter Property="Foreground" Value="#B42318"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="OperatorPanel" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DFE6ED"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="6"/>
  </Style>
 </UserControl.Resources>

 <!-- Production shares the physical FLASH and TEST engine with engineering. -->
 <Grid Margin="12,10,12,12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource OperatorPanel}"
   BorderThickness="1,1,1,2" Padding="16,12" Margin="0,0,0,10">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="3*"/>
     <ColumnDefinition Width="2*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
     <!-- The complete physical barcode must remain visible even when routing
          fails; a match is never substituted for what the scanner observed. -->
     <TextBlock Text="当前扫码 · ECU 完整编号" Style="{StaticResource OperatorCaption}"
      Margin="0,0,0,5"/>
     <TextBlock Text="{Binding LastObservedBarcode}" FontSize="21"
      FontFamily="Consolas,Microsoft YaHei" FontWeight="SemiBold"
      Foreground="#1F4368" TextWrapping="Wrap"
      ToolTip="{Binding LastObservedBarcode}" Margin="0,0,0,7"/>
     <TextBlock Text="{Binding ProjectName,StringFormat='匹配工程：{0}'}"
      Foreground="#52677D" FontSize="13" TextWrapping="Wrap"
      ToolTip="{Binding ProjectName}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <Border Background="#F4F8FC" CornerRadius="6" Padding="13,10">
      <StackPanel>
       <TextBlock Text="{Binding ProductionDisplayStage}" FontSize="12"
        Foreground="#496C91" FontWeight="SemiBold" Margin="0,0,0,3"/>
       <TextBlock Text="{Binding ProductionHeadline}" FontSize="20"
        FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#1F3449"/>
       <TextBlock Text="{Binding ProductionGuidance}" FontSize="12"
        Foreground="#60738A" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
     </Border>
     <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
      <Button Content="开始检测" Command="{Binding RequestSoftwareStartCommand}"
       MinWidth="116" Height="34" Background="#196DB0" Foreground="White"
       FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0"
       IsEnabled="{Binding CanStartOperatorVerification}"/>
      <Button Content="停止" Command="{Binding StopOperatorVerificationCommand}"
       MinWidth="72" Height="34" Background="White" BorderBrush="#C7D4DF"
       Foreground="#A1382B"/>
     </StackPanel>
     <TextBlock Text="{Binding StartRequestStatus}" FontSize="11"
      Foreground="#65788B" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid x:Name="OperatorWorkspace" Grid.Row="1">
   <Grid.RowDefinitions>
    <RowDefinition x:Name="OperatorPrimaryRow" Height="*"/>
    <RowDefinition x:Name="OperatorDetailsRow" Height="0"/>
   </Grid.RowDefinitions>
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="OperatorCasesColumn" Width="*"/>
    <ColumnDefinition x:Name="OperatorGapColumn" Width="10"/>
    <ColumnDefinition x:Name="OperatorDetailsColumn" Width="360"/>
   </Grid.ColumnDefinitions>

   <Border x:Name="OperatorCasesPanel" Grid.Row="0" Grid.Column="0"
    Style="{StaticResource OperatorPanel}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="43"/>
      <RowDefinition Height="35"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <DockPanel Margin="14,0" LastChildFill="True">
      <TextBlock DockPanel.Dock="Right"
       Text="{Binding CaseCount,StringFormat='{}{0} 个用例'}"
       VerticalAlignment="Center" Foreground="#61758A" FontSize="12"/>
      <CheckBox x:Name="OperatorFollowExecution" DockPanel.Dock="Right"
       Content="跟随执行" IsChecked="True" VerticalAlignment="Center"
       Margin="0,0,15,0" FontSize="12"
       ToolTip="自动定位当前执行的测试步骤"/>
      <TextBlock Text="检测流程 · 用例与步骤" FontSize="16" FontWeight="SemiBold"
       VerticalAlignment="Center"/>
     </DockPanel>
     <Border Grid.Row="1" BorderBrush="#DFE6ED" BorderThickness="0,1,0,1"
      Background="#F8FAFC" Padding="10,0">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="55"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="134"/>
       </Grid.ColumnDefinitions>
       <TextBlock Grid.Column="0" Text="序号" VerticalAlignment="Center"
        Style="{StaticResource OperatorCaption}"/>
       <TextBlock Grid.Column="1" Text="用例 / 步骤及关键参数"
        VerticalAlignment="Center" Style="{StaticResource OperatorCaption}"/>
       <TextBlock Grid.Column="2" Text="状态" VerticalAlignment="Center"
        Style="{StaticResource OperatorCaption}"/>
      </Grid>
     </Border>
     <TreeView x:Name="CasesTree" Grid.Row="2" ItemsSource="{Binding Cases}"
      SelectedItemChanged="CasesTree_SelectedItemChanged"
      BorderThickness="0" Padding="5,4" Background="White"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Auto">
      <TreeView.ItemContainerStyle>
       <Style TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=OneWay}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,1,0,1"/>
        <Setter Property="Padding" Value="1"/>
       </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.Resources>
       <HierarchicalDataTemplate DataType="{x:Type local:AutomaticTestCase}"
        ItemsSource="{Binding Children}">
        <Border MinHeight="43" BorderBrush="#E3E9F0"
         BorderThickness="0,0,0,1" Padding="8,2"
         Width="{Binding ActualWidth,ElementName=CasesTree,Converter={StaticResource OperatorRowWidthConverter}}">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Background" Value="White"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="执行中">
             <Setter Property="Background" Value="#EDF4FC"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="实测通过">
             <Setter Property="Background" Value="#F4FAF7"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="44"/>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="132"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Index}" FontSize="13" Foreground="#526B83"
           FontWeight="SemiBold" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
           <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
           <TextBlock Text="{Binding StepCountLabel}" FontSize="11"
            Foreground="#65788B"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding State,Converter={StaticResource OperatorStateTextConverter}}"
           Style="{StaticResource OperatorState}"
           ToolTip="{Binding State}" TextTrimming="CharacterEllipsis"/>
         </Grid>
        </Border>
       </HierarchicalDataTemplate>
       <HierarchicalDataTemplate DataType="{x:Type local:AutomaticTestStep}"
        ItemsSource="{Binding Children}">
        <Border MinHeight="37" BorderBrush="#EFF2F5"
         BorderThickness="0,0,0,1" Padding="8,2"
         Width="{Binding ActualWidth,ElementName=CasesTree,Converter={StaticResource OperatorRowWidthConverter}}">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Background" Value="White"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="执行中">
             <Setter Property="Background" Value="#EDF4FC"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="31"/>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="132"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Index}" FontSize="12" VerticalAlignment="Center"
           Foreground="#77889A"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
           <TextBlock Text="{Binding Name}" FontSize="13"
            Foreground="#2B4052" TextTrimming="CharacterEllipsis"
            ToolTip="{Binding Name}"/>
           <TextBlock Text="{Binding ActionSummary}" FontSize="11"
            Foreground="#6B7E90" TextTrimming="CharacterEllipsis"
            ToolTip="{Binding ActionSummary}"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding State,Converter={StaticResource OperatorStateTextConverter}}"
           Style="{StaticResource OperatorState}"
           ToolTip="{Binding State}" TextTrimming="CharacterEllipsis"/>
         </Grid>
        </Border>
       </HierarchicalDataTemplate>
      </TreeView.Resources>
     </TreeView>
     <Border Grid.Row="2" Background="#FAFCFE"
      Visibility="{Binding NeedsSetup,Converter={StaticResource BoolToVisibility}}">
      <StackPanel MaxWidth="430" VerticalAlignment="Center"
       HorizontalAlignment="Center" Margin="18">
       <TextBlock Text="当前没有可监视的 TEST 用例" FontWeight="SemiBold"
        FontSize="16" TextAlignment="Center"/>
       <TextBlock Text="{Binding SetupIssue}" Margin="0,9,0,0"
        TextWrapping="Wrap" Foreground="#66798E" TextAlignment="Center"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>

   <Border x:Name="OperatorDetailsPanel" Grid.Row="0" Grid.Column="2"
    Style="{StaticResource OperatorPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
     HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="15,12,15,16">
      <!-- Values below are projected only from actual physical TEST events. -->
      <StackPanel Visibility="{Binding HasFormalExecutionFacts,Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="当前步骤与检测证据" FontSize="16" FontWeight="SemiBold"
       Margin="0,0,0,9"/>
      <Border Background="#F4F7FA" Padding="10" CornerRadius="5"
       Margin="0,0,0,11">
       <StackPanel>
        <TextBlock Text="当前用例" Style="{StaticResource OperatorCaption}"/>
        <TextBlock Text="{Binding ProductionCurrentCase}" Style="{StaticResource OperatorFact}"
         FontWeight="SemiBold" Margin="0,3,0,7"/>
        <TextBlock Text="当前步骤" Style="{StaticResource OperatorCaption}"/>
        <TextBlock Text="{Binding ProductionCurrentStep}" Style="{StaticResource OperatorFact}"
         Margin="0,3,0,4"/>
        <TextBlock Text="{Binding ProductionStepStatus}" FontWeight="SemiBold"
         Foreground="#2F668F" FontSize="12" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
      <Grid Margin="0,0,0,12">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0">
        <TextBlock Text="实际结果" Style="{StaticResource OperatorCaption}"/>
        <TextBlock Text="{Binding ProductionMeasuredValue}" FontSize="16"
         FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
       </StackPanel>
       <StackPanel Grid.Column="1">
        <TextBlock Text="期望结果" Style="{StaticResource OperatorCaption}"/>
        <TextBlock Text="{Binding ProductionExpectedValue}" FontSize="14"
         TextWrapping="Wrap" Margin="0,4,0,0"/>
       </StackPanel>
      </Grid>
      <TextBlock Text="{Binding ProductionFailure}" Foreground="#A12D27"
       TextWrapping="Wrap" FontSize="13" Margin="0,0,0,9"/>
      <Border Height="1" Background="#E5EBF1" Margin="0,4,0,11"/>
      </StackPanel>
      <TextBlock Text="检测进度" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <TextBlock Grid.Row="0" Text="扫码" Style="{StaticResource OperatorCaption}" Margin="0,0,0,7"/>
       <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IdentityLabel}"
        Style="{StaticResource OperatorFact}" FontSize="12" Margin="0,0,0,7"/>
       <TextBlock Grid.Row="1" Text="设备" Style="{StaticResource OperatorCaption}" Margin="0,0,0,7"/>
       <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StationReadiness}"
        Style="{StaticResource OperatorFact}" FontSize="12" Margin="0,0,0,7"/>
       <TextBlock Grid.Row="2" Text="启动方式" Style="{StaticResource OperatorCaption}" Margin="0,0,0,7"/>
       <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PhysicalStartStatus}"
        Foreground="#A3651D" TextWrapping="Wrap" Margin="0,0,0,7"/>
       <TextBlock Grid.Row="3" Text="烧录" Style="{StaticResource OperatorCaption}" Margin="0,0,0,7"/>
       <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProductionFlashState}"
        Foreground="#53687B" TextWrapping="Wrap" Margin="0,0,0,7"/>
       <TextBlock Grid.Row="4" Text="测试" Style="{StaticResource OperatorCaption}" Margin="0,0,0,7"/>
       <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProductionTestState}"
        Foreground="#53687B" TextWrapping="Wrap" Margin="0,0,0,7"/>
       <TextBlock Grid.Row="5" Text="记录" Style="{StaticResource OperatorCaption}"/>
       <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProductionRecordState}"
        Foreground="#53687B" TextWrapping="Wrap"/>
      </Grid>
      <Border Height="1" Background="#E5EBF1" Margin="0,13,0,10"/>
      <TextBlock Text="{Binding ProductionResultLabel}" FontSize="14"
       FontWeight="SemiBold" Foreground="#A3651D"/>
      <TextBlock Text="{Binding ProductionAlert}" Foreground="#A12D27"
       FontSize="12" FontWeight="SemiBold"
       TextWrapping="Wrap" Margin="0,7,0,2"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</UserControl>