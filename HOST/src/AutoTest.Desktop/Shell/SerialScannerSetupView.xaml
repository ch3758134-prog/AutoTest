<UserControl x:Class="AutoTest.Desktop.Shell.SerialScannerSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource UiFont}" FontSize="12" Background="#F7F9FC">
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,12">
   <TextBlock Text="扫码枪 · 串口设备" FontSize="20"
              FontWeight="SemiBold" Foreground="#20364A"/>
   <TextBlock Text="连接扫码枪并查看实时输入。"
              Foreground="#62798C" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Background="White" BorderBrush="#DEE7EF" BorderThickness="1"
            CornerRadius="8" Padding="14" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="一、串口设备" FontSize="15" FontWeight="SemiBold"
                 Foreground="#20364A" Margin="0,0,0,9"/>
      <WrapPanel>
       <StackPanel Width="150" Margin="0,0,10,0">
        <TextBlock Text="USB 虚拟串口" Foreground="#64798C" FontSize="11"/>
        <ComboBox ItemsSource="{Binding AvailablePorts}"
                  SelectedItem="{Binding SelectedPort,Mode=TwoWay}"
                  IsEnabled="{Binding CanEditConnection}" Margin="0,4,0,0" MinHeight="28"/>
       </StackPanel>
       <StackPanel Width="130" Margin="0,0,10,0">
        <TextBlock Text="波特率" Foreground="#64798C" FontSize="11"/>
        <ComboBox ItemsSource="{Binding SupportedBaudRates}"
                  SelectedItem="{Binding BaudRate,Mode=TwoWay}"
                  IsEnabled="{Binding CanEditConnection}" Margin="0,4,0,0" MinHeight="28"/>
       </StackPanel>
       <Button Content="刷新端口" Command="{Binding RefreshPortsCommand}"
               Margin="0,18,6,0" Padding="12,6"/>
       <Button Content="连接" Command="{Binding ConnectCommand}"
               IsEnabled="{Binding CanEditConnection}" Margin="0,18,6,0" Padding="12,6"/>
       <Button Content="断开" Command="{Binding DisconnectCommand}"
               IsEnabled="{Binding IsConnected}" Margin="0,18,6,0" Padding="12,6"/>
       <Button Content="记住当前扫码枪" Command="{Binding BindScannerDeviceCommand}"
               ToolTip="真实试扫成功后绑定此实体设备，以后根据 USB 设备身份找到实际 COM"
               Margin="0,18,6,0" Padding="12,6"/>
       <Button Content="更换设备" Command="{Binding ReplaceScannerDeviceCommand}"
               Margin="0,18,0,0" Padding="12,6"/>
      </WrapPanel>
      <TextBlock Text="{Binding DeviceStatus}" Foreground="#546E86"
                 TextWrapping="Wrap" Margin="0,9,0,0"/>
      <TextBlock Text="扫码以回车或换行结束。"
                 Foreground="#76899A" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <Border Background="White" BorderBrush="#DEE7EF" BorderThickness="1" CornerRadius="8" Padding="14">
     <StackPanel>
      <TextBlock Text="设备接收诊断" FontSize="15" FontWeight="SemiBold" Foreground="#20364A" Margin="0,0,0,12"/>
      <TextBlock Text="编码形制及型号匹配只在「生产准备」发布；此处仅负责真实串口设备连接与原始输入诊断。" Foreground="#62798C" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="最近完整原始文本" Foreground="#64798C"/>
      <TextBox Text="{Binding LastRaw,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" Margin="0,4,0,12"/>
      <TextBlock Text="原始帧 HEX" Foreground="#64798C"/>
      <TextBox Text="{Binding LastHex,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="8,6" Margin="0,4,0,12"/>
      <TextBlock Text="当前扫码设备诊断（不是正式生产匹配结果）" FontWeight="SemiBold" Foreground="#20364A"/>
      <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" Foreground="#345E83" Margin="0,6,0,4"/>
      <TextBlock Text="{Binding LastMappedFields}" TextWrapping="Wrap" Foreground="#355C76"/>
      <TextBlock Text="{Binding LastDecision}" Foreground="#657D90" Margin="0,6,0,0"/>
      <TextBlock Text="试扫不会启动检测。" TextWrapping="Wrap" Foreground="#788A9B" Margin="0,8,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="#EBF1F5" CornerRadius="6" Padding="10" Margin="0,10,0,0">
   <TextBlock Text="{Binding Status}" Foreground="#314F63" TextWrapping="Wrap"/>
  </Border>
 </Grid>
</UserControl>