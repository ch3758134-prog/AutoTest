<UserControl x:Class="AutoTest.Desktop.Shell.ManualBenchKeyActionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F7F8FA" Foreground="#303941" FontSize="13"
 FontFamily="{StaticResource UiFont}">
 <UserControl.Resources>
  <Style x:Key="BenchKey" TargetType="ToggleButton">
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Height" Value="34"/>
   <Setter Property="Foreground" Value="#355579"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="KeyTile" Background="#FFFFFF" BorderBrush="#D2DEEB" BorderThickness="1" CornerRadius="4">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="KeyTile" Property="Background" Value="#3478D6"/><Setter TargetName="KeyTile" Property="BorderBrush" Value="#3478D6"/><Setter Property="Foreground" Value="White"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="KeyTile" Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="FieldCaption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#627C9D"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Margin" Value="0,9,0,4"/>
  </Style>
  <Style x:Key="BenchHint" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="#627C9D"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,12">
   <TextBlock Text="编辑按键动作" FontSize="19" FontWeight="SemiBold"/>
   <TextBlock Text="各段按顺序执行；结束后保持最后的按键组合。"
    Foreground="#526579" FontSize="12" Margin="0,5,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#E0E5E5"
   BorderThickness="1" CornerRadius="8" Padding="12">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
   <StackPanel x:Name="KeyEditorSection"
    Visibility="{Binding IsKeyEditorExpanded,Converter={StaticResource BoolToVisibility}}">

   <StackPanel Visibility="{Binding HasSelectedKeyAction,Converter={StaticResource BoolToVisibility}}">
    <TextBlock Text="动作名称" Style="{StaticResource FieldCaption}"/>
    <TextBox Text="{Binding SelectedKeyAction.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
     IsEnabled="{Binding CanEditKeyActions}" Padding="7,5"/>
    <DockPanel Margin="0,10,0,6">
     <Button DockPanel.Dock="Right" Content="+ KEY 组合" Command="{Binding AddKeyStepCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="+ 纯等待" Command="{Binding AddWaitOnlyStepCommand}" Padding="8,5" Margin="5,0,0,0"
      ToolTip="增加一个仅计时、不向 KEY CAN 发送任何报文的独立等待段"/>
     <Button DockPanel.Dock="Right" Content="复制" Command="{Binding CopyKeyStepCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="删除" Command="{Binding DeleteKeyStepCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="↑" Command="{Binding MoveKeyStepUpCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="↓" Command="{Binding MoveKeyStepDownCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <TextBlock Text="动作步骤" Style="{StaticResource FieldCaption}" VerticalAlignment="Center"/>
    </DockPanel>
    <ListBox ItemsSource="{Binding SelectedKeyAction.Steps}" MaxHeight="190" HorizontalContentAlignment="Stretch"
     SelectedItem="{Binding SelectedKeyStep,Mode=TwoWay}"
     MinHeight="60" BorderBrush="#E0E9F3" Padding="4"
     ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ListBox.ItemTemplate>
      <DataTemplate>
       <Grid Margin="3,4" MinHeight="30">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="23"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextWrapping="Wrap"
         ToolTip="{Binding Summary}" Foreground="#355579" FontSize="13"/>
        <TextBox Grid.Column="1" Text="{Binding HoldMsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         ToolTip="本段等待时间（毫秒）" Padding="5,3" VerticalAlignment="Center" MinHeight="28"
         IsEnabled="{Binding DataContext.CanEditKeyActions,RelativeSource={RelativeSource AncestorType=ListBox}}"/>
        <TextBlock Grid.Column="2" Text="ms" Margin="3,0,0,0" VerticalAlignment="Center" FontSize="10"/>
       </Grid>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <Border Background="#F7FAFE" BorderBrush="#DDE8F5" BorderThickness="1"
     CornerRadius="6" Padding="9" Margin="0,9,0,0">
     <StackPanel IsEnabled="{Binding CanEditKeyActions}">
      <TextBlock Text="按键组合" Foreground="#295A81"
       FontWeight="SemiBold" Margin="0,0,0,6"/>
      <CheckBox Content="仅等待，不更改按键"
       IsChecked="{Binding SelectedKeyStep.WaitOnly,Mode=TwoWay}"
       Margin="0,0,0,8" FontSize="13"
       ToolTip="纯等待会保留此前最后一次 KEY 组合请求；与 20 Key 全部不选的“全部断开”不同"/>
      <WrapPanel Margin="0,0,0,5" IsEnabled="{Binding SelectedKeyStep.CanChangeKeys}">
       <Button Content="清空" Command="{Binding ClearStepKeysCommand}" Padding="7,5" Margin="0,0,5,5"/>
       <Button Content="反选" Command="{Binding InvertStepKeysCommand}" Padding="7,5" Margin="0,0,5,5"/>
       <Button Content="复制上一段" Command="{Binding CopyPreviousStepKeysCommand}" Padding="7,5" Margin="0,0,5,5"/>
      </WrapPanel>

      <ItemsControl ItemsSource="{Binding StepKeys}" IsEnabled="{Binding SelectedKeyStep.CanChangeKeys}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <ToggleButton Content="{Binding Label}" IsChecked="{Binding Checked,Mode=TwoWay}"
          Style="{StaticResource BenchKey}"/>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      
     </StackPanel>
    </Border>
   </StackPanel>
  </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <Button DockPanel.Dock="Right" Content="完成" Click="SaveAndClose_Click"
    Padding="16,8" MinWidth="110" Style="{StaticResource AtPrimaryButton}"/>
   <TextBlock Text="{Binding KeyLibraryState}" Foreground="#627C9D"
    VerticalAlignment="Center" ToolTip="编辑更改将在关闭时自动保存"/>
  </DockPanel>
 </Grid>
</UserControl>