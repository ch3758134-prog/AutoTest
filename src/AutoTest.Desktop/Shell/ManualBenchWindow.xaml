<Window x:Class="AutoTest.Desktop.Shell.ManualBenchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AutoTest.Desktop.Shell"
 Title="AutoTest · 手动台架" Width="1500" Height="860" MinWidth="1200" MinHeight="660"
 WindowStartupLocation="CenterOwner" WindowState="Maximized" Background="#F4F7FC"
 FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#223A57">
 <Window.Resources>
  <Style x:Key="BenchHeader" TargetType="TextBlock">
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#263C53"/>
  </Style>
  <Style x:Key="BenchHint" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="#61758A"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="BenchCard" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DCE5EF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="13"/>
  </Style>
  <Style x:Key="BenchKey" TargetType="CheckBox">
   <Setter Property="Padding" Value="9,8"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style x:Key="FieldCaption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#617B98"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="0,9,0,4"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="55"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="37"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="White" BorderBrush="#DCE5EF" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,10" LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="连接 / 断开" Command="{Binding ConnectCommand}"
     Style="{StaticResource AtPrimaryButton}" Padding="15,8" Margin="9,0,0,0"/>
    <Button DockPanel.Dock="Right" Content="刷新资源" Command="{Binding ReloadProfilesCommand}"
     Padding="12,7" Margin="9,0,0,0"/>
    <StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="手动台架" Style="{StaticResource BenchHeader}" FontSize="17"
       VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Border Background="#EDF2F7" Padding="10,5" CornerRadius="12" ToolTip="{Binding ConnectionStatus}">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="●" Foreground="#72889F" Margin="0,0,6,0"/>
        <TextBlock>
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Text" Value="USB 未连接"/>
           <Setter Property="Foreground" Value="#4B6279"/>
           <Setter Property="FontSize" Value="11"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
             <Setter Property="Text" Value="USB 已连接"/>
             <Setter Property="Foreground" Value="#267850"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </Border>
     </StackPanel>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="1" Margin="12,12,12,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="40*" MinWidth="475"/>
    <ColumnDefinition Width="31*" MinWidth="385"/>
    <ColumnDefinition Width="29*" MinWidth="340"/>
   </Grid.ColumnDefinitions>

   <!-- LEFT: CAN0 multi-message table and selected-message inspector. -->
   <Border Grid.Column="0" Style="{StaticResource BenchCard}" Margin="0,0,9,0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="CAN0 发送" Style="{StaticResource BenchHeader}"/>
      
      <DockPanel LastChildFill="False">
       <Button Content="+ 新增" Command="{Binding AddCanRowCommand}" Padding="10,6" Margin="0,0,5,0"/>
       <Button Content="复制" Command="{Binding CopyCanRowCommand}" Padding="9,6" Margin="0,0,5,0"/>
       <Button Content="删除" Command="{Binding DeleteCanRowCommand}" Padding="9,6" Margin="0,0,5,0"/>
       <Button Content="↑" Command="{Binding MoveCanRowUpCommand}" Padding="8,6" Margin="0,0,4,0"/>
       <Button Content="↓" Command="{Binding MoveCanRowDownCommand}" Padding="8,6" Margin="0,0,8,0"/>
       <Button Content="单发勾选" Command="{Binding StartCanRowsCommand}"
        Style="{StaticResource AtPrimaryButton}" Padding="11,6" Margin="0,0,5,0"/>
       <Button Content="停止全部" Command="{Binding StopCanRowsCommand}" Padding="11,6"/>
      </DockPanel>
     </StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding CanSendRows}"
      SelectedItem="{Binding SelectedCanRow,Mode=TwoWay}"
      AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
      GridLinesVisibility="None" RowHeight="60" ColumnHeaderHeight="30"
      SelectionMode="Single" EnableRowVirtualization="True" BorderBrush="#E2EAF3"
      Background="#FFFFFF" AlternatingRowBackground="#F8FAFD">
      <DataGrid.ContextMenu>
       <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
        <MenuItem Header="新增报文" Command="{Binding AddCanRowCommand}"/>
        <MenuItem Header="复制当前报文" Command="{Binding CopyCanRowCommand}"/>
        <MenuItem Header="删除当前报文" Command="{Binding DeleteCanRowCommand}"/>
        <Separator/>
        <MenuItem Header="上移报文" Command="{Binding MoveCanRowUpCommand}"/>
        <MenuItem Header="下移报文" Command="{Binding MoveCanRowDownCommand}"/>
       </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="选" Width="35">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding Included,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           IsEnabled="{Binding CanToggleIncluded}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="CAN 报文 / 数据 / 周期 / 状态" Width="*">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <StackPanel Margin="3,3,0,3">
           <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#24405E"
             TextTrimming="CharacterEllipsis" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding Summary}" Foreground="#58728E" FontSize="11"
             TextTrimming="CharacterEllipsis" Margin="0,0,7,0"/>
            <TextBlock Text="{Binding ModeLabel}" Foreground="#607A92" FontSize="10"/>
           </StackPanel>
           <TextBlock Text="{Binding DataSummary}" FontSize="11" Foreground="#445F7C"
            TextTrimming="CharacterEllipsis" ToolTip="{Binding DataSummary}"/>
           <TextBlock Text="{Binding Result}" FontSize="10" Foreground="#72849B"
            TextTrimming="CharacterEllipsis"/>
          </StackPanel>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="操作" Width="112">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
           <Button Content="单发" Padding="6,4" Margin="0,0,4,0"
            Command="{Binding DataContext.SendCanRowOnceCommand,RelativeSource={RelativeSource AncestorType=Window}}"
            CommandParameter="{Binding}" ToolTip="单次发送当前报文；未连接 USB 时直接在状态和日志中提示"/>
           <Button Content="编辑" Padding="6,4"
            Command="{Binding DataContext.EditCanRowCommand,RelativeSource={RelativeSource AncestorType=Window}}"
            CommandParameter="{Binding}" ToolTip="展开当前报文原始 HEX / DBC 编辑"/>
          </StackPanel>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
      Background="#ECF1F7" ResizeDirection="Rows" VerticalAlignment="Stretch"
      Visibility="{Binding IsCanEditorExpanded,Converter={StaticResource BoolToVisibility}}"/>
     <Border Grid.Row="3" BorderBrush="#DFE8F3" BorderThickness="1" CornerRadius="5"
      Background="#FBFCFE" Padding="12" Margin="0,7,0,0" MaxHeight="330"
      Visibility="{Binding IsCanEditorExpanded,Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <Button Content="收起编辑" DockPanel.Dock="Right" Command="{Binding CloseCanEditorCommand}"
         Padding="8,4" Margin="8,0,0,0"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="手动台架" Style="{StaticResource BenchHeader}" FontSize="17"
       VerticalAlignment="Center" Margin="0,0,13,0"/>
      <Border CornerRadius="12" Padding="9,4" Background="#EDF2F7"
       ToolTip="{Binding ConnectionStatus}">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="●" Foreground="#8291A1" Margin="0,0,6,0"/>
        <TextBlock Text="USB 未连接" FontSize="11" Foreground="#445D75">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Text" Value="USB 未连接"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
             <Setter Property="Text" Value="USB 已连接"/>
             <Setter Property="Foreground" Value="#267850"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </Border>
     </StackPanel>
       </DockPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel DataContext="{Binding SelectedCanRow}"
         IsEnabled="{Binding DataContext.CanEditCanRows,RelativeSource={RelativeSource AncestorType=Window}}">
         <TextBlock Text="名称" Style="{StaticResource FieldCaption}"/>
         <TextBox Text="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          Padding="7,5" MinHeight="30"/>
         <StackPanel Orientation="Horizontal" Margin="0,12,0,2">
          <CheckBox Content="周期发送" IsChecked="{Binding IsPeriodic,Mode=TwoWay}" Margin="0,0,16,0"/>
          <TextBlock Text="周期 (ms)" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox Text="{Binding PeriodText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           Width="78" Padding="6,4" ToolTip="周期 50～60000 ms，全部周期帧合计不超过 25 帧/秒"/>
         </StackPanel>
         <CheckBox Content="使用工程 DBC 报文" IsChecked="{Binding UseDbc,Mode=TwoWay}"
          Margin="0,9,0,1"/>
         <StackPanel Visibility="{Binding UseDbc,Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="DBC 报文" Style="{StaticResource FieldCaption}"/>
          <ComboBox ItemsSource="{Binding DataContext.DbcMessages,RelativeSource={RelativeSource AncestorType=Window}}"
           SelectedItem="{Binding DbcMessage,Mode=TwoWay}" DisplayMemberPath="Display" MinHeight="29"/>
          <TextBlock Text="信号物理值" Style="{StaticResource FieldCaption}"/>
          <ItemsControl ItemsSource="{Binding SignalValues}">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Grid Margin="0,0,0,9">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/>
               <ColumnDefinition Width="155"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
               <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" ToolTip="{Binding Definition}"/>
               <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#8393A7"/>
               <TextBlock Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap"
                Foreground="#697C91" ToolTip="{Binding Definition}"/>
               <TextBlock Text="{Binding Range}" FontSize="10" Foreground="#8899AA"/>
              </StackPanel>
              <Grid Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
               <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                Padding="6,5" ToolTip="{Binding Range}">
                <TextBox.Style><Style TargetType="TextBox">
                 <Setter Property="Visibility" Value="Visible"/>
                 <Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                 </DataTrigger></Style.Triggers>
                </Style></TextBox.Style>
               </TextBox>
               <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                SelectedValuePath="Value"
                SelectedValue="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                MinHeight="28" ToolTip="{Binding Definition}">
                <ComboBox.Style><Style TargetType="ComboBox">
                 <Setter Property="Visibility" Value="Collapsed"/>
                 <Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                 </DataTrigger></Style.Triggers>
                </Style></ComboBox.Style>
               </ComboBox>
              </Grid>
             </Grid>
       </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
         <StackPanel Visibility="{Binding IsRaw,Converter={StaticResource BoolToVisibility}}">
          <Grid Margin="0,8,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="CAN ID (HEX)" Style="{StaticResource FieldCaption}"/>
            <TextBox Text="{Binding IdHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
             Padding="7,5" MinHeight="30"/>
           </StackPanel>
           <CheckBox Grid.Column="1" Content="扩展帧" IsChecked="{Binding Extended,Mode=TwoWay}"
            VerticalAlignment="Bottom" Margin="14,0,0,7"/>
          </Grid>
          <TextBlock Text="DATA (HEX，0～8 字节)" Style="{StaticResource FieldCaption}"/>
          <TextBox Text="{Binding DataHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           MinHeight="31" Padding="7,5" ToolTip="如 01 02 03 04"/>
         </StackPanel>
         
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Border>
    </Grid>
   </Border>

   <!-- CENTER: priority order is real station IO then reusable KEY actions. -->
   <Border Grid.Column="1" Style="{StaticResource BenchCard}" Margin="0,0,9,0">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="工位控制" Style="{StaticResource BenchHeader}"/>
      
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="7"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="7"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Border Grid.Column="0" BorderBrush="#DCE6F2" BorderThickness="1"
        Background="#F9FBFE" CornerRadius="6" Padding="7">
        <StackPanel>
         <TextBlock Text="IGN" FontWeight="SemiBold" Foreground="#2C527D" Margin="0,0,0,5"/>
          <TextBlock Text="{Binding IgnGpioLabel}" FontSize="10" Foreground="#60758C" Margin="0,0,0,6" ToolTip="{Binding LastIgnAck}"/>
         <Button Content="ON" Click="IgnOn_Click" IsEnabled="{Binding CanInvokeManualIo}" Margin="0,0,0,4" MinHeight="30"/>
         <Button Content="OFF" Click="IgnOff_Click" IsEnabled="{Binding CanInvokeManualIo}" MinHeight="30"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" BorderBrush="#DCE6F2" BorderThickness="1"
        Background="#F9FBFE" CornerRadius="6" Padding="7">
        <StackPanel>
         <TextBlock Text="夹具 1 · B5" FontWeight="SemiBold" Foreground="#2C527D" Margin="0,0,0,5"/>
          <TextBlock Text="{Binding Clamp1GpioLabel}" FontSize="10" Foreground="#60758C" Margin="0,0,0,6" ToolTip="{Binding LastClampStatus}"/>
         <Button Content="压紧" Click="Clamp1Press_Click" IsEnabled="{Binding CanInvokeManualIo}" Margin="0,0,0,4" MinHeight="30"/>
         <Button Content="释放" Click="Clamp1Release_Click" IsEnabled="{Binding CanInvokeManualIo}" MinHeight="30"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="4" BorderBrush="#DCE6F2" BorderThickness="1"
        Background="#F9FBFE" CornerRadius="6" Padding="7">
        <StackPanel>
         <TextBlock Text="夹具 2 · B4" FontWeight="SemiBold" Foreground="#2C527D" Margin="0,0,0,5"/>
          <TextBlock Text="{Binding Clamp2GpioLabel}" FontSize="10" Foreground="#60758C" Margin="0,0,0,6" ToolTip="{Binding LastClampStatus}"/>
         <Button Content="压紧" Click="Clamp2Press_Click" IsEnabled="{Binding CanInvokeManualIo}" Margin="0,0,0,4" MinHeight="30"/>
         <Button Content="释放" Click="Clamp2Release_Click" IsEnabled="{Binding CanInvokeManualIo}" MinHeight="30"/>
        </StackPanel>
       </Border>
      </Grid>
      <DockPanel Margin="0,8,0,0">
       <Button DockPanel.Dock="Right" Content="读夹具 GPIO" Command="{Binding ReadClampsCommand}"
        Padding="8,5" Margin="6,0,0,0"/>
       <Button DockPanel.Dock="Right" Content="读 IGN" Command="{Binding ReadIgnCommand}"
        Padding="8,5" Margin="6,0,0,0"/>
       
      </DockPanel>
      
      
      <Border BorderBrush="#E5ECF4" BorderThickness="0,1,0,0" Margin="0,12,0,10"/>
      <DockPanel Margin="0,0,0,8">
       <TextBlock DockPanel.Dock="Left" Text="按键动作 · CAN1" Style="{StaticResource BenchHeader}" FontSize="14"/>
       
      </DockPanel>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <DockPanel Margin="0,0,0,9">
    <Button DockPanel.Dock="Right" Content="保存动作库" Command="{Binding SaveKeyActionsCommand}"
     Style="{StaticResource AtPrimaryButton}" Padding="9,6" Margin="6,0,0,0"/>
    <Button DockPanel.Dock="Right" Content="+ 新建动作" Command="{Binding AddKeyActionCommand}"
     Padding="9,6" Margin="6,0,0,0"/>
    <Border Background="#EDF2F7" CornerRadius="10" Padding="9,4"
     VerticalAlignment="Center" ToolTip="{Binding KeyCatalogRevisionLabel}">
     <TextBlock Text="{Binding KeyLibraryState}" FontWeight="SemiBold" Foreground="#425E77" FontSize="11"/>
    </Border>
   </DockPanel>
   
   <ItemsControl ItemsSource="{Binding KeyActions}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border BorderThickness="1" BorderBrush="#CFDFF0" Background="#F8FBFF"
       CornerRadius="7" Margin="0,0,6,7" Padding="7">
       <StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#244E74"
         TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
        <TextBlock Text="{Binding Summary}" Foreground="#60758C" FontSize="10"
         TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
         <Button Content="运行" Tag="{Binding}" Click="RunKeyAction_Click"
          PreviewMouseRightButtonUp="EditKeyAction_RightClick"
          IsEnabled="{Binding DataContext.CanRunKeyAction,RelativeSource={RelativeSource AncestorType=Window}}"
          Padding="9,4" Margin="0,0,5,0" ToolTip="运行已保存的按键动作；未连接 USB 时直接在状态和日志中提示"/>
         <Button Content="编辑" Tag="{Binding}" Click="SelectKeyAction_Click" Padding="9,4"/>
        </StackPanel>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   
   <StackPanel x:Name="KeyEditorSection"
    Visibility="{Binding IsKeyEditorExpanded,Converter={StaticResource BoolToVisibility}}">
   <Border BorderBrush="#E5ECF4" BorderThickness="0,1,0,0" Margin="0,8,0,10"/>
   <DockPanel Margin="0,0,0,8">
    <Button DockPanel.Dock="Right" Content="完成" Click="CloseKeyEditor_Click"
     Padding="8,5" Margin="4,0,0,0"/>
    <Button DockPanel.Dock="Right" Content="复制动作" Command="{Binding CopyKeyActionCommand}"
     Padding="8,5" Margin="4,0,0,0"/>
    <Button DockPanel.Dock="Right" Content="删除动作" Command="{Binding DeleteKeyActionCommand}"
     Padding="8,5" Margin="4,0,0,0"/>
    <TextBlock Text="动作编辑" Foreground="#2C527D" FontSize="13" FontWeight="SemiBold"
     VerticalAlignment="Center"/>
   </DockPanel>
   <StackPanel Visibility="{Binding HasSelectedKeyAction,Converter={StaticResource BoolToVisibility}}">
    <TextBlock Text="动作名称" Style="{StaticResource FieldCaption}"/>
    <TextBox Text="{Binding SelectedKeyAction.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
     IsEnabled="{Binding CanEditKeyActions}" Padding="7,5"/>
    <DockPanel Margin="0,10,0,6">
     <Button DockPanel.Dock="Right" Content="+ 步骤" Command="{Binding AddKeyStepCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="复制" Command="{Binding CopyKeyStepCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="删除" Command="{Binding DeleteKeyStepCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="↑" Command="{Binding MoveKeyStepUpCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="↓" Command="{Binding MoveKeyStepDownCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <TextBlock Text="步骤 · KEY 组合 / 保持时间" Style="{StaticResource FieldCaption}" VerticalAlignment="Center"/>
    </DockPanel>
    <ListBox ItemsSource="{Binding SelectedKeyAction.Steps}"
     SelectedItem="{Binding SelectedKeyStep,Mode=TwoWay}"
     MinHeight="60" BorderBrush="#E0E9F3" Padding="4"
     ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate>
      <DataTemplate>
       <Grid Margin="3,4" MinHeight="30">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="23"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
         ToolTip="{Binding Summary}" Foreground="#355579" FontSize="11"/>
        <TextBox Grid.Column="1" Text="{Binding HoldMsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         ToolTip="保持时间（ms）" Padding="5,3" VerticalAlignment="Center" MinHeight="28"
         IsEnabled="{Binding DataContext.CanEditKeyActions,RelativeSource={RelativeSource AncestorType=ListBox}}"/>
        <TextBlock Grid.Column="2" Text="ms" Margin="3,0,0,0" VerticalAlignment="Center" FontSize="10"/>
       </Grid>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <Border Background="#F7FAFE" BorderBrush="#DDE8F5" BorderThickness="1"
     CornerRadius="6" Padding="9" Margin="0,9,0,0">
     <StackPanel IsEnabled="{Binding CanEditKeyActions}">
      <TextBlock Text="KEY 组合" Foreground="#315E8E"
       FontWeight="SemiBold" Margin="0,0,0,6"/>
      <WrapPanel Margin="0,0,0,5">
       <Button Content="清空" Command="{Binding ClearStepKeysCommand}" Padding="7,5" Margin="0,0,5,5"/>
       <Button Content="反选" Command="{Binding InvertStepKeysCommand}" Padding="7,5" Margin="0,0,5,5"/>
       <Button Content="复制上一段" Command="{Binding CopyPreviousStepKeysCommand}" Padding="7,5" Margin="0,0,5,5"/>
      </WrapPanel>
      <Grid Margin="0,3,0,6">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/>
        <ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBlock Grid.Column="0" Text="掩码" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <TextBox Grid.Column="1" Text="{Binding SelectedKeyStep.MaskHexText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Padding="6,5" ToolTip="掩码 0x00000～0xFFFFF；同步勾选 20 KEY"/>
       <TextBlock Grid.Column="3" Text="保持" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <TextBox Grid.Column="4" Text="{Binding SelectedKeyStep.HoldMsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Padding="6,5" MinHeight="28"/>
       <TextBlock Grid.Column="5" Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"/>
      </Grid>
      <TextBlock Text="{Binding SelectedKeyStep.Summary}" Foreground="#516D87"
       TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,0,0,5"/>
      <TextBlock Text="{Binding SelectedKeyStep.MaskError}" Foreground="#B34035"
       FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
      <ItemsControl ItemsSource="{Binding StepKeys}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked,Mode=TwoWay}"
          Style="{StaticResource BenchKey}"/>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      
     </StackPanel>
    </Border>
   </StackPanel>
   <Border BorderBrush="#E5ECF4" BorderThickness="0,1,0,0" Margin="0,12,0,8"/>
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="停止 KEY 动作"
     Command="{Binding StopKeyActionCommand}" Padding="9,6"/>
    <TextBlock Text="动作运行状态 · CAN1" FontWeight="SemiBold"
     Foreground="#315E8E" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock Text="{Binding KeyActionRunStatus}" Style="{StaticResource BenchHint}"
    ToolTip="{Binding KeyActionRunStatus}" TextTrimming="CharacterEllipsis" MaxHeight="21" Margin="0,5,0,0"/>
  </StackPanel>
  </StackPanel>
 </ScrollViewer>
    </DockPanel>
   </Border>

   <!-- RIGHT: a dedicated CAN view and a separately scrollable operation log. -->
   <Border Grid.Column="2" Style="{StaticResource BenchCard}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="3*"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="2*"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,9">
      <TextBlock Text="CAN 实时监控" Style="{StaticResource BenchHeader}" ToolTip="{Binding MonitorCountSummary}"/>
      <TextBlock Text="{Binding CanRxReceiveStatus}" FontSize="10"
       Foreground="#516983" TextWrapping="Wrap" Margin="0,3,0,7"
       ToolTip="USB 0x41 为主控上报数量；CAN有效为通过帧校验数量；监视交付是派发给界面订阅者的次数。计数每秒更新，不代表 ECU 必然已经发报文。"/>
      
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="86"/><ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <ComboBox Grid.Column="0" ItemsSource="{Binding MonitorChannelChoices}"
        SelectedItem="{Binding MonitorChannel,Mode=TwoWay}" MinHeight="28"/>
       <TextBox Grid.Column="1" Text="{Binding MonitorQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        MinHeight="28" Margin="7,0,0,0" Padding="7,5"
        ToolTip="筛选 CAN ID、数据或格式"/>
      </Grid>
      <DockPanel Margin="0,8,0,0">
       <Button DockPanel.Dock="Right" Content="清空监视" Command="{Binding ClearMonitorCommand}"
        Padding="9,5" Margin="5,0,0,0"/>
       <Button DockPanel.Dock="Right" Content="{Binding MonitorPauseLabel}"
        Command="{Binding ToggleMonitorPauseCommand}" Padding="9,5" Margin="5,0,0,0"/>
       <CheckBox Content="逐帧时间线" IsChecked="{Binding MonitorShowTimeline,Mode=TwoWay}"
        VerticalAlignment="Center"/>
      </DockPanel>
     </StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding MonitorDisplay}"
      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
      CanUserDeleteRows="False" HeadersVisibility="Column"
      ColumnHeaderHeight="31" RowHeight="28" GridLinesVisibility="Horizontal"
      BorderBrush="#E6EDF5" EnableRowVirtualization="True"
      ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="90"/>
       <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="55"/>
       <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="79"/>
       <DataGridTextColumn Header="数据" Binding="{Binding Data}" Width="*"/>
       <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="50"/>
       <DataGridTextColumn Header="质量" Binding="{Binding Status}" Width="68"/>
      </DataGrid.Columns>
     </DataGrid>
     <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
      ResizeDirection="Rows" Background="#EEF3F9"/>
     <DockPanel Grid.Row="3" Margin="0,7,0,0">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
       <Button DockPanel.Dock="Right" Content="导出真实记录" Click="ExportLog_Click"
        Padding="9,5" Margin="4,0,0,0"/>
       <Button DockPanel.Dock="Right" Content="清空显示" Command="{Binding ClearLogsCommand}"
        Padding="9,5" Margin="4,0,0,0"/>
       <TextBlock Text="USB / 操作 / 错误日志" FontSize="12" FontWeight="SemiBold"
        Foreground="#28517E" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBox DockPanel.Dock="Top"
       Text="{Binding LogFilter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       MinHeight="27" Padding="7,5" Margin="0,0,0,6" ToolTip="按事件和内容过滤"/>
      <Border DockPanel.Dock="Bottom" Margin="0,5,0,0" Padding="5,7"
       BorderBrush="#E5ECF5" BorderThickness="0,1,0,0">
       <TextBlock Text="{Binding SelectedLog.Detail}" Style="{StaticResource BenchHint}"
        TextWrapping="Wrap" MinHeight="36"/>
      </Border>
      <DataGrid ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog,Mode=TwoWay}"
       AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
       CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
       HeadersVisibility="Column" EnableRowVirtualization="True"
       ColumnHeaderHeight="29" RowHeight="27" BorderBrush="#E6EDF5">
       <DataGrid.Columns>
        <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="93"/>
        <DataGridTextColumn Header="来源" Binding="{Binding Channel}" Width="81"/>
        <DataGridTextColumn Header="事件" Binding="{Binding Direction}" Width="66"/>
        <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#286DAE" Padding="14,8">
   <TextBlock Text="{Binding Status}" Foreground="White" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>
