<UserControl x:Class="AutoTest.Desktop.Configuration.ConfigurationWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}">
  <UserControl.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  </UserControl.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="74"/>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="38"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="17,9">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold" FontSize="18"/>
          <TextBlock Text="{Binding AssetName}" Foreground="{StaticResource Subtle}"
                     Margin="12,4,0,0"/>
          <TextBlock Text="{Binding Revision,StringFormat='修订 {0}'}" Margin="18,4,0,0"
                     Foreground="{StaticResource Subtle}"/>
        </StackPanel>
        <TextBlock Text="{Binding DocumentPath}" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,7,0,0"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0">
        <Button Content="保存配置" Command="{Binding SaveCommand}"
                Style="{StaticResource AtPrimaryButton}" Margin="0,0,7,0"/>
        <Button Content="应用参数" Command="{Binding ApplyCommand}"
                Style="{StaticResource AtButton}" Margin="0,0,7,0"/>
        <Button Content="重新加载" Command="{Binding ReloadCommand}"
                Style="{StaticResource AtButton}"/>
        <Button Content="从工程 DBC 选择信号…" Command="{Binding PickWaveSignalCommand}"
                Visibility="{Binding IsWave,Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource AtPrimaryButton}" Margin="10,0,0,0"/>
        <TextBlock Text="● 未保存" Foreground="{StaticResource Warning}"
                   Visibility="{Binding IsDirty,Converter={StaticResource BoolToVisibility}}"
                   VerticalAlignment="Center" Margin="16,0,0,0"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" Margin="10,10,10,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" MinWidth="200"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="390"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="1"
              Background="{StaticResource Panel}" Padding="9">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="配置结构" FontWeight="SemiBold" FontSize="15" Margin="3,3,0,11"/>
            <WrapPanel>
              <Button Content="新增模拟按键" Command="{Binding AddButtonActionCommand}"
                      Visibility="{Binding IsController,Converter={StaticResource BoolToVisibility}}"
                      Style="{StaticResource AtPrimaryButton}" Margin="0,0,5,6"/>
              <Button Content="新增通用控制器" Command="{Binding AddControllerCommand}"
                      Visibility="{Binding IsController,Converter={StaticResource BoolToVisibility}}"
                      Margin="0,0,5,6"/>
              <Button Content="新增状态" Command="{Binding AddStateCommand}"
                      Visibility="{Binding IsController,Converter={StaticResource BoolToVisibility}}"
                      Margin="0,0,5,6"/>
              <Button Content="设为默认" Command="{Binding SetDefaultCommand}"
                      Visibility="{Binding IsController,Converter={StaticResource BoolToVisibility}}"
                      Margin="0,0,5,6"/>
              <Button Content="新增规则" Command="{Binding AddRuleCommand}"
                      Visibility="{Binding IsScan,Converter={StaticResource BoolToVisibility}}"
                      Margin="0,0,5,6"/>
              <Button Content="新增匹配配方" Command="{Binding AddRecipeCommand}"
                      Visibility="{Binding IsScan,Converter={StaticResource BoolToVisibility}}"
                      Margin="0,0,5,6"/>
              <Button Content="删除选中项" Command="{Binding RemoveEntryCommand}"
                      Margin="0,0,5,6">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource AtButton}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsController}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsScan}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </WrapPanel>
          </StackPanel>
          <ListBox ItemsSource="{Binding Nodes}"
                   SelectedItem="{Binding SelectedNode,Mode=TwoWay}"
                   BorderThickness="0" Margin="0,7,0,0"
                   ScrollViewer.CanContentScroll="True"/>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="5"
                    Background="{StaticResource Line}"/>
      <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1"
              Background="{StaticResource Panel}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource MutedSurface}"
                  Padding="16,13" BorderBrush="{StaticResource Line}"
                  BorderThickness="0,0,0,1">
            <TextBlock Text="参数编辑" FontWeight="SemiBold" FontSize="15"/>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Fields}" Margin="20,15,24,20">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="{Binding Title}" FontWeight="Medium" Margin="0,0,0,6"/>
                    <Grid>
                      <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                               IsReadOnly="{Binding IsReadOnly}" Padding="8,7">
                        <TextBox.Style>
                          <Style TargetType="TextBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBox.Style>
                      </TextBox>
                      <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value,Mode=TwoWay}"
                                Padding="6,4" MinHeight="30">
                        <ComboBox.Style>
                          <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasOptions}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ComboBox.Style>
                      </ComboBox>
                    </Grid>
                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap"
                               Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,5,0,0"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="14,0">
        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}"
                   VerticalAlignment="Center" Foreground="{StaticResource Subtle}"
                   TextTrimming="CharacterEllipsis" MaxWidth="500"/>
        <TextBlock Text="{Binding ExecutionBoundary}" FontSize="11"
                   Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
