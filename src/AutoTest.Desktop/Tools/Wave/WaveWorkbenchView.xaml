<UserControl x:Class="AutoTest.Desktop.Tools.Wave.WaveWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource StudioBg}"
             Foreground="{DynamicResource StudioText}" FontFamily="Segoe UI" FontSize="13"
             Focusable="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#D6E1EC" />
        
        
        <Style TargetType="TextBlock" x:Key="SmallCaption">
            <Setter Property="Foreground" Value="#637A90" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReplayCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="波形分析" Style="{StaticResource AtPageTitle}" />
                <TextBlock Style="{StaticResource SmallCaption}"
                           Text="信号观察 · 采样记录 · 参考波形 · 判定证据" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#D9EBFD" CornerRadius="4"
                    Padding="10,5" HorizontalAlignment="Right">
                <TextBlock Text="DBC / CAN1" Foreground="#127C9D" FontWeight="SemiBold" />
            </Border>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" Padding="11" CornerRadius="6" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="采集与回放" Style="{StaticResource AtSectionTitle}" Margin="0,0,0,8"/>
                <WrapPanel Margin="0,0,0,5">
                    <Button Command="{Binding LiveCommand}" Content="▶ 实时采集"
                     Style="{StaticResource AtPrimaryButton}"/>
                    <Button x:Name="RecordCanButton" Click="RecordCanArchive_Click"
                     Content="录制 CAN1（5秒）"
                     ToolTip="从已连接主控记录真实 CAN1 接收帧，不发送指令"/>
                    <Button Click="CancelCanArchive_Click" Content="取消录制"
                     Style="{StaticResource AtDangerButton}"/>
                    <Button Command="{Binding StopCommand}" Content="停止当前操作"
                     Style="{StaticResource AtDangerButton}"/>
                    <Button Command="{Binding ReloadCommand}" Content="刷新 DBC 信号"/>
                </WrapPanel>
                <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="接收档案" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="185" Text="{Binding ArchivePath,UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="保存的真实 CAN1 RX 档案路径" Margin="0,0,7,0"/>
                    <Button Click="ChooseArchive_Click" Content="选择文件"/>
                    <Button Command="{Binding OpenArchiveCommand}" Content="加载档案"/>
                    <Button Command="{Binding ReplayCommand}" Content="回放档案"/>
                </WrapPanel>
                <Separator Background="{DynamicResource StudioLine}" Margin="0,0,0,9"/>
                <WrapPanel>
                    <TextBlock Text="参考与判定" Style="{StaticResource AtSectionTitle}"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Command="{Binding SaveReferenceCommand}" Content="保存参考波形"/>
                    <Button Command="{Binding LoadReferenceCommand}" Content="加载参考波形"/>
                    <TextBlock Text="绝对容差" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="80" Text="{Binding ToleranceText,UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="设置数值信号的绝对判定容差" Margin="0,0,7,0"/>
                    <Button Command="{Binding CompareCommand}" Content="比较并生成证据"/>
                </WrapPanel>
            </StackPanel></WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                        <TextBlock Text="项目 DBC 信号" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="勾选信号（同图最多显示 8 路）" Style="{StaticResource SmallCaption}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Signals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="1,8,1,8" Foreground="{DynamicResource StudioText}" ToolTip="DBC Revision 已固定；修改后需要重新刷新信号" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,9">
                    <DockPanel>
                        <TextBlock Text="时间曲线 / 独立 Y 轴分层" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Command="{Binding ZoomInCommand}" Content="＋" MinWidth="35" Padding="5,2" />
                            <Button Command="{Binding ZoomOutCommand}" Content="－" MinWidth="35" Padding="5,2" />
                            <Button Command="{Binding ResetZoomCommand}" Content="适合窗口" Padding="7,2" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="ChartCanvas" Width="950" Height="350" ClipToBounds="True"
                                Background="#FFFFFF" MouseLeftButtonDown="ChartCanvas_MouseLeftButtonDown">
                            <Rectangle Canvas.Left="48" Canvas.Top="12" Width="852" Height="322"
                                       Stroke="#D6E1EC" StrokeThickness="1" />
                            <Line X1="48" X2="900" Y1="92" Y2="92" Stroke="#ECF2F8" />
                            <Line X1="48" X2="900" Y1="174" Y2="174" Stroke="#ECF2F8" />
                            <Line X1="48" X2="900" Y1="254" Y2="254" Stroke="#ECF2F8" />
                            <Line X1="261" X2="261" Y1="12" Y2="334" Stroke="#ECF2F8" />
                            <Line X1="474" X2="474" Y1="12" Y2="334" Stroke="#ECF2F8" />
                            <Line X1="687" X2="687" Y1="12" Y2="334" Stroke="#ECF2F8" />
                            <ItemsControl ItemsSource="{Binding Traces}" Canvas.Left="0" Canvas.Top="0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polyline Points="{Binding Points}" Stroke="{Binding Color}" StrokeThickness="2"
                                                  />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Polyline Points="{Binding CursorLineA}" Stroke="#8F611B" StrokeThickness="1.7" />
                            <Polyline Points="{Binding CursorLineB}" Stroke="#B63B51" StrokeThickness="1.7" />
                            <TextBlock Canvas.Left="52" Canvas.Top="336" FontSize="11"
                                       Foreground="{DynamicResource StudioMuted}" Text="时间（s） / 单击 A · Shift+单击 B" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="6" Margin="0,9,0,0" Padding="9">
                    <StackPanel>
                        <TextBlock Text="{Binding ViewRange}" Style="{StaticResource SmallCaption}" />
                        <TextBlock Text="{Binding CursorInfo}" TextWrapping="Wrap" Margin="0,4,0,3" />
                        <ItemsControl ItemsSource="{Binding Traces}" MaxHeight="80">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1,0,1">
                                        <Rectangle Fill="{Binding Color}" Width="11" Height="3" Margin="0,7,8,0" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding Name}" Foreground="#3F5A76" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="采集质量 / 证据" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="来源" Style="{StaticResource SmallCaption}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding Origin}" TextWrapping="Wrap" />
                        <TextBlock Text="时间与采样质量" Style="{StaticResource SmallCaption}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding Quality}" TextWrapping="Wrap" />
                        <TextBlock Text="固定参考" Style="{StaticResource SmallCaption}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding ReferenceStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="比较结果" FontWeight="SemiBold" Margin="0,7,0,8" />
                    <TextBlock Grid.Row="2" Text="PASS 仅表示当前离线数据满足规则，不等于实机验收。"
                               TextWrapping="Wrap" Foreground="#8F611B" Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource StudioLine}" Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Signal}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Verdict}" FontSize="18" Foreground="#8F611B" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Coverage}" Style="{StaticResource SmallCaption}" />
                                            <TextBlock Text="{Binding EvidenceId}" Style="{StaticResource SmallCaption}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="比较证据 ID" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Margin="0,12,0,0" Padding="4,10,2,0">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="ArchiveCaptureStatus" Text="CAN RX 录制未开始"
                               Foreground="#167B5A" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource StudioMuted}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="Physical / Replay 原始事实分别记录" Foreground="{DynamicResource StudioMuted}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
