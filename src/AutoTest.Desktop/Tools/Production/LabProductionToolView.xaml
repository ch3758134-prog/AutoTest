<UserControl x:Class="AutoTest.Desktop.Tools.Production.LabProductionToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="650" MinHeight="420"
             Background="{DynamicResource StudioBg}" Foreground="{DynamicResource StudioText}" FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        
        
        
    </UserControl.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock FontSize="23" FontWeight="SemiBold" Text="扫码与生产配置"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#697C8E"
                       Text="扫描编号 → 匹配工程规则 → 执行已发布测试程序 → 保存真实结果"/>
        </StackPanel>
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="{DynamicResource StudioLine}"
                BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="扫码枪连接" FontWeight="SemiBold" Foreground="{DynamicResource StudioText}" Margin="0,0,0,9"/>
                <WrapPanel>
                    <TextBlock Text="COM" Foreground="#697C8E" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox x:Name="R1ScannerPorts" Width="100" Margin="0,0,6,0"
                              Background="{DynamicResource StudioPanel}" Foreground="{DynamicResource StudioText}"/>
                    <Button Content="刷新设备" Click="ScannerRefresh_Click"/>
                    <TextBlock Text="波特率" Foreground="#697C8E" VerticalAlignment="Center" Margin="9,0,8,0"/>
                    <ComboBox x:Name="R1ScannerBaud" Width="105" Margin="0,0,9,0"
                              Background="#EDF3F9" Foreground="{DynamicResource StudioBg}"/>
                    <Button x:Name="R1ScannerConnect" Content="连接扫码枪" Style="{StaticResource AtPrimaryButton}" Click="ScannerConnect_Click"/>
                    <Button x:Name="R1ScannerDisconnect" Content="断开" Style="{StaticResource AtDangerButton}" Click="ScannerDisconnect_Click" IsEnabled="False"/>
                </WrapPanel>
                <TextBlock x:Name="R1ScannerState" Text="选择真实扫码枪 COM 和波特率后连接；不需键盘焦点。"
                           Foreground="#697C8E" TextWrapping="Wrap" Margin="0,7,0,0"/>
                <WrapPanel Margin="0,10,0,4">
                    <TextBlock x:Name="R1ScannerRxCount" Text="RX 0 bytes" Foreground="#127B91" FontFamily="Consolas" Margin="0,0,16,0"/>
                    <TextBlock x:Name="R1ScannerBoundary" Text="等待扫码" Foreground="#697C8E"/>
                </WrapPanel>
                <TextBlock x:Name="R1ScannerHex" Text="HEX —" Foreground="#697C8E"
                           FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="40"/>
                <TextBlock x:Name="R1ScannerBarcode" Text="最近扫码 —"
                           Foreground="{DynamicResource StudioText}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                           Margin="0,7,0,0"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="{DynamicResource StudioLine}"
                BorderThickness="1" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="生产状态" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LastRun}" TextWrapping="Wrap" Foreground="#127B91" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding LastEvidence}" TextWrapping="Wrap" Foreground="#177D65" Margin="0,3,0,0"/>
                <TextBlock Text="扫码后执行当前工程的唯一真实 TEST，绑定 DUT、Revision 和 RunId。已发布配方若启用出厂检测统计，则按真实 TEST 结果保存生产 PASS/FAIL；测试结果不等同于发货放行。"
                           TextWrapping="Wrap" Foreground="#90611A" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <TabControl Background="{DynamicResource StudioBg}">
            <TabItem Header="实际扫码 / 识别">
                <StackPanel Margin="12">
                    <TextBlock Text="条码输入 / 校验" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="校验条码" Style="{StaticResource AtPrimaryButton}" Command="{Binding PreviewCommand}"/>
                        <TextBox x:Name="BarcodeInput" KeyDown="BarcodeInput_OnKeyDown"
                                 Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding MatchDetail}" TextWrapping="Wrap" Margin="0,12,0,3"/>
                    <TextBlock Text="{Binding RuleRevision, StringFormat=规则版本：{0}}"
                               Foreground="#697C8E"/>
                    <TextBlock Text="{Binding CatalogSource}" TextWrapping="Wrap"
                               Foreground="#697C8E" Margin="0,6,0,0"/>
                    <Button Content="打开当前工程测试" Click="OpenProjectTest_Click"
                            HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,8"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="扫码规则 / 当前工程 TEST 配方">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="为当前已保存工程发布实际扫码规则" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="规则必须明确匹配测试条码，不能由程序推测客户条码格式。工程须已登记并保存正式 TEST 和 DBC。"
                                   Foreground="#697C8E" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock Text="完整条码正则表达式（使用命名捕获组）"/>
                        <TextBox Text="{Binding RulePattern,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                                 Width="610" HorizontalAlignment="Left" Margin="0,3,0,10"/>
                        <TextBlock Text="身份字段（命名捕获组，逗号分隔；如 serial）"/>
                        <TextBox Text="{Binding IdentityFields,UpdateSourceTrigger=PropertyChanged}" Width="410"
                                 HorizontalAlignment="Left" Margin="0,3,0,10"/>
                        <TextBlock Text="配方名称"/>
                        <TextBox Text="{Binding RecipeId,UpdateSourceTrigger=PropertyChanged}" Width="410"
                                 HorizontalAlignment="Left" Margin="0,3,0,10"/>
                        <TextBlock Text="当前工位 Profile 文件（原始真实配置文件，使用 SHA256 固定）"/>
                        <DockPanel HorizontalAlignment="Left" Width="610" Margin="0,3,0,10">
                            <Button Content="浏览…" DockPanel.Dock="Right" Click="BrowseStationProfile_Click"/>
                            <TextBox Text="{Binding StationProfileFile,UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Text="工位 Profile Revision（由操作者配置）"/>
                        <TextBox Text="{Binding StationProfileRevision,UpdateSourceTrigger=PropertyChanged}"
                                 Width="180" HorizontalAlignment="Left" Margin="0,3,0,10"/>
                        <CheckBox IsChecked="{Binding ProductionTestEnabled,Mode=TwoWay}"
                                   Content="将此已发布配方用于真实出厂检测统计（按工程 TEST 实际 PASS/FAIL 入库）"
                                   Foreground="{DynamicResource StudioText}" Margin="0,12,0,8"
                                   ToolTip="关闭时仍可做真实诊断测试，但不进入生产统计；无真实设备/TEST 的运行绝不成为生产 PASS。"/>
                        <TextBlock Text="真实条码样本（用于发布前验证规则）"/>
                        <TextBox Text="{Binding ExampleBarcode,UpdateSourceTrigger=PropertyChanged}"
                                 Width="410" HorizontalAlignment="Left" Margin="0,3,0,12"/>
                        <WrapPanel>
                            <Button Content="发布到当前工程" Style="{StaticResource AtPrimaryButton}" Command="{Binding PublishRuleCommand}" Padding="14,8"/>
                            <Button Content="重新加载已发布规则" Command="{Binding LoadCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="只有明确的物理配方且 TestProgram ID/Revision/SHA256 与当前工程完全一致时才进入真实执行；工位文件哈希本身不证明硬件连接或设备动作。"
                                   TextWrapping="Wrap" Foreground="#90611A" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="真实扫码记录">
                <DataGrid ItemsSource="{Binding ScanEvents}" IsReadOnly="True" Margin="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Width="160" Binding="{Binding When}"/>
                        <DataGridTextColumn Header="扫码内容" Width="*" Binding="{Binding Input}"/>
                        <DataGridTextColumn Header="匹配/拒绝状态" Width="220" Binding="{Binding Result}"/>
                        <DataGridTextColumn Header="实际输入来源" Width="180" Binding="{Binding Origin}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
