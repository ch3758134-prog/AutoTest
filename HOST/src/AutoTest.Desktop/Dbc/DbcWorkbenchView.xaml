<UserControl x:Class="AutoTest.Desktop.Dbc.DbcWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F7F9FC" Foreground="#263B50" FontFamily="{StaticResource UiFont}" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Workbench_PreviewKeyDown">
 <UserControl.Resources>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#EDF2F7"/><Setter Property="Foreground" Value="#405870"/>
   <Setter Property="Padding" Value="6,5"/><Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="BorderBrush" Value="#DFE6EE"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="4,2"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#263B50"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E3EEFF"/><Setter Property="BorderBrush" Value="#B6D1F3"/><Setter Property="Foreground" Value="#203952"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#3478D6"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Matrix" TargetType="DataGrid">
   <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="RowHeaderWidth" Value="0"/><Setter Property="RowHeight" Value="34"/>
   <Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#E9EEF3"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
   <Setter Property="SelectionMode" Value="Single"/><Setter Property="EnableRowVirtualization" Value="True"/>
   <Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="0,0,0,1" Padding="14,10">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="未保存" Foreground="#9B6423" Visibility="{Binding IsDirty,Converter={StaticResource BoolToVisibility}}"/>
    </StackPanel>
    <StackPanel>
     <Button Content="{Binding AssetName}" Click="RenameDocument_Click"
      FontSize="19" FontWeight="SemiBold" Background="Transparent"
      HorizontalAlignment="Left" HorizontalContentAlignment="Left"
      BorderThickness="0" Padding="0" Foreground="#20394F"
      ToolTip="单击重命名 DBC；独立文件会真正修改磁盘文件名"/>
     <TextBlock Text="{Binding FileLocationDescription}" Foreground="#62778D"
      FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
      ToolTip="{Binding FilePath}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="White" BorderBrush="#DFE6EE" BorderThickness="0,0,0,1" Padding="10,5">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="编辑限制" Click="ShowPolicy_Click"
      ToolTip="{Binding StateDescription}" Margin="8,0,0,0"/>
    <WrapPanel VerticalAlignment="Center">
     <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,10,0">
      <MenuItem Header="文件">
       <MenuItem Header="新建 DBC…" Click="NewDocument_Click"/>
       <MenuItem Header="打开 DBC…" Click="OpenDocument_Click"/>
       <Separator/>
       <MenuItem Header="重命名当前 DBC…" Click="RenameDocument_Click"/>
       <MenuItem Header="{Binding DbcSaveCopyLabel}" Click="SaveCopy_Click"/>
      </MenuItem>
     </Menu>
     <TextBlock Text="自动保存" Foreground="#567766" VerticalAlignment="Center" Margin="0,0,9,0" ToolTip="合法编辑自动保存；Ctrl+S 可立即保存"/>
     <Button Content="撤销" Click="Undo_Click" IsEnabled="{Binding CanUndo}" Margin="0,0,4,0"/>
     <Button Content="重做" Click="Redo_Click" IsEnabled="{Binding CanRedo}" Margin="0,0,12,0"/>
     <Button Content="＋ 报文" Click="AddMessage_Click" IsEnabled="{Binding CanChangeStructure}" ToolTip="{Binding UnsupportedDescription}" Margin="0,0,4,0"/>
     <Button Content="＋ 信号" Click="AddSignal_Click" IsEnabled="{Binding CanChangeStructure}" ToolTip="{Binding UnsupportedDescription}" Margin="0,0,4,0"/>
     <Button Content="检查 DBC" Click="Check_Click" Margin="0,0,4,0"/>
     <Button Content="重新加载" Click="Reload_Click"/>
    </WrapPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2" Margin="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="290" MinWidth="230"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="6">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="10,9">
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding MessageCount}" Foreground="#62778D"/><TextBlock Text="报文" FontSize="15" FontWeight="SemiBold"/></DockPanel>
      <TextBlock Text="按 ID、别名、名称或信号检索" FontSize="11"
       Foreground="#62778D" Margin="0,5,0,0"/>
      <TextBox x:Name="MessageSearch" Text="{Binding MessageSearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索报文名称、中文别名、CAN ID 或信号" Margin="0,4,0,4" MinHeight="30"/>
     </StackPanel>
     <DataGrid x:Name="MessageGrid" Grid.Row="1" Style="{StaticResource Matrix}" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage,Mode=TwoWay}" IsReadOnly="True" SelectionUnit="FullRow" MouseDoubleClick="Message_DoubleClick" RowHeight="42">
      <DataGrid.ContextMenu><ContextMenu>
       <MenuItem Header="编辑报文（含名称）" Click="EditMessage_Click"/><MenuItem Header="名称与注释" Click="MessageNotes_Click"/>
       <MenuItem Header="删除报文" Click="DeleteMessage_Click"/>
      </ContextMenu></DataGrid.ContextMenu>
      <DataGrid.Columns>
       <DataGridTextColumn Header="CAN ID" Binding="{Binding HexId}" Width="98" SortMemberPath="Message.Id"/>
       <DataGridTemplateColumn Header="报文 / 别名" Width="*" MinWidth="100" SortMemberPath="Name">
        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" Margin="3,0">
         <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
         <TextBlock Text="{Binding Alias}" FontSize="10" Foreground="#62778D" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
        </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="45"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="6" Background="#E1E7EF" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
   <Border Grid.Column="2" Background="White" BorderBrush="#DFE6EE" BorderThickness="1" CornerRadius="6">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="12,10,12,8">
      <DockPanel>
       <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
        <Button Content="编辑报文" Click="EditMessage_Click" IsEnabled="{Binding CanEdit}" Margin="0,0,5,0"
         ToolTip="修改报文技术名称、CAN ID、DLC、发送节点"/>
        <Button Content="名称与注释" Click="MessageNotes_Click"/>
       </WrapPanel>
       <StackPanel>
        <TextBlock Text="{Binding SelectedMessage.Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding SelectedMessage.Alias}" Foreground="#62778D" FontSize="12" TextTrimming="CharacterEllipsis"/>
        <WrapPanel Margin="0,5,0,0">
         <TextBlock Text="{Binding SelectedMessage.HexId}" Margin="0,0,12,0"/>
         <TextBlock Text="{Binding SelectedMessage.FrameType}" Foreground="#526B84" Margin="0,0,12,0"/>
         <TextBlock Text="{Binding SelectedMessage.Dlc,StringFormat='DLC {0}'}" Margin="0,0,12,0"/>
         <TextBlock Text="{Binding SelectedMessage.Transmitter,StringFormat='发送节点 {0}'}" Foreground="#526B84"/>
        </WrapPanel>
       </StackPanel>
      </DockPanel>
      <TextBlock Text="{Binding SelectedMessageDefinition}" MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="#62778D" FontSize="11" Margin="0,6,0,6" ToolTip="{Binding SelectedMessageDefinition}"/>
      <DockPanel>
       <WrapPanel DockPanel.Dock="Right">
         <Button x:Name="AdvancedColumnsButton" Content="高级列" Click="ToggleAdvancedColumns_Click"
          ToolTip="显示最小值、最大值、接收节点、复用、枚举和说明；普通批量编辑默认只显示常用字段"
          Margin="0,0,4,0"/>
         <Button Content="信号说明" Click="SignalNotes_Click" Margin="0,0,4,0"/>
         <Button Content="枚举值" Click="Enums_Click" Margin="0,0,4,0"/>
         <Button Content="完整参数" Click="EditSignal_Click" IsEnabled="{Binding CanEdit}"/>
        </WrapPanel>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="信号定义" FontWeight="SemiBold" Margin="0,0,8,0"/><TextBlock Text="{Binding SignalCount,StringFormat='{}{0} 个'}" Foreground="#62778D"/></StackPanel>
      </DockPanel>
     </StackPanel>
     <DataGrid x:Name="SignalGrid" Grid.Row="1" Style="{StaticResource Matrix}" ItemsSource="{Binding Signals}" SelectedItem="{Binding SelectedSignal,Mode=TwoWay}" SelectionUnit="FullRow" FrozenColumnCount="1"
       BeginningEdit="Signal_BeginningEdit" CellEditEnding="Signal_CellEditEnding" RowEditEnding="Signal_RowEditEnding" MouseDoubleClick="Signal_DoubleClick">
      <DataGrid.ContextMenu><ContextMenu>
       <MenuItem Header="名称与注释" Click="SignalNotes_Click"/><MenuItem Header="完整参数" Click="EditSignal_Click"/><MenuItem Header="枚举值" Click="Enums_Click"/><MenuItem Header="删除信号" Click="DeleteSignal_Click"/>
      </ContextMenu></DataGrid.ContextMenu>
      <DataGrid.Columns>
       <DataGridTextColumn Header="信号名称"
         Binding="{Binding Draft.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         Width="142"/>
       <DataGridTextColumn Header="中文别名" Binding="{Binding Alias,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         Width="128" SortMemberPath="Alias"/>
       <DataGridTextColumn Header="起始位" Width="65" Binding="{Binding Draft.StartBit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SortMemberPath="StartBit"/>
<DataGridTextColumn Header="位长" Width="54" Binding="{Binding Draft.BitLength,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SortMemberPath="BitLength"/>
       <DataGridTemplateColumn Header="字节序" Width="98" SortMemberPath="ByteOrder">
 <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Draft.ByteOrder}" VerticalAlignment="Center" Margin="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
 <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding ByteOrders}" SelectedItem="{Binding Draft.ByteOrder,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinHeight="26"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
 </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="类型" Width="78" SortMemberPath="SignType">
 <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Draft.SignType}" VerticalAlignment="Center" Margin="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
 <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding SignTypes}" SelectedItem="{Binding Draft.SignType,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MinHeight="26"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
 </DataGridTemplateColumn>
       <DataGridTextColumn Header="因子" Width="83" Binding="{Binding Draft.Factor,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SortMemberPath="Factor"/>
<DataGridTextColumn Header="偏移" Width="83" Binding="{Binding Draft.Offset,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SortMemberPath="Offset"/>
<DataGridTextColumn x:Name="DbcMinimumColumn" Visibility="Collapsed" Header="最小值" Width="90" Binding="{Binding Draft.Minimum,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SortMemberPath="Minimum"/>
<DataGridTextColumn x:Name="DbcMaximumColumn" Visibility="Collapsed" Header="最大值" Width="90" Binding="{Binding Draft.Maximum,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SortMemberPath="Maximum"/>
<DataGridTextColumn Header="单位" Width="70" Binding="{Binding Draft.Unit,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SortMemberPath="Unit"/>
<DataGridTextColumn x:Name="DbcReceiverColumn" Visibility="Collapsed" Header="接收节点" Width="90" Binding="{Binding Draft.Receiver,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SortMemberPath="Receiver"/>
<DataGridTextColumn x:Name="DbcMultiplexerColumn" Visibility="Collapsed" Header="复用" Width="66" Binding="{Binding Draft.Multiplexer,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" SortMemberPath="Multiplexer"/>
       <DataGridTextColumn x:Name="DbcEnumColumn" Visibility="Collapsed" Header="枚举" Binding="{Binding EnumCount}" IsReadOnly="True" Width="55"/>
       <DataGridTextColumn x:Name="DbcDescriptionColumn" Visibility="Collapsed" Header="说明" Binding="{Binding Summary}" IsReadOnly="True" Width="170"/>
      </DataGrid.Columns>
     </DataGrid>
     <Expander Grid.Row="2" Header="位布局（按需展开）" IsExpanded="False" Margin="8,4,8,8" Padding="2">
      <Border Background="#F8FAFC" CornerRadius="5" Padding="8">
       <ScrollViewer MaxHeight="250" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Left">
         <Grid x:Name="BitGrid" HorizontalAlignment="Left"/>
         <TextBlock x:Name="BitStatus" Foreground="#62778D" FontSize="11" TextWrapping="Wrap" MaxWidth="720" Margin="0,6,0,0"/>
        </StackPanel>
       </ScrollViewer>
      </Border>
     </Expander>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#DFE6EE"
   BorderThickness="0,1,0,0" Padding="10,6">
   <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
    Foreground="#405870" FontSize="12"/>
  </Border>
  <Grid x:Name="PropertyOverlay" Grid.RowSpan="4" Panel.ZIndex="100" Background="#40F1F5F9" Visibility="Collapsed" MouseLeftButtonDown="Overlay_Backdrop">
   <Border x:Name="PropertyCard" Background="White" BorderBrush="#D5E0EB" BorderThickness="1" CornerRadius="9" Width="610" MaxHeight="610" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="✕" Click="CancelOverlay_Click" ToolTip="取消当前浮窗修改" MinWidth="32"/><TextBlock x:Name="OverlayTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <StackPanel x:Name="NotesPanel">
       <TextBlock x:Name="OriginalName" Foreground="#526B84" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <TextBlock Text="中文别名" FontWeight="Medium"/><TextBox x:Name="AliasBox" MinHeight="32" Margin="0,4,0,10"/>
       <TextBlock Text="功能摘要" FontWeight="Medium"/><TextBox x:Name="SummaryBox" MinHeight="32" Margin="0,4,0,10"/>
       <TextBlock Text="详细注释（标准 CM_）" FontWeight="Medium"/><TextBox x:Name="CommentBox" Height="118" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel x:Name="EnumsPanel" Visibility="Collapsed">
       <TextBlock x:Name="EnumPolicy" TextWrapping="Wrap" Foreground="#526B84" Margin="0,0,0,8"/>
       <DataGrid x:Name="EnumGrid" Style="{StaticResource Matrix}" Height="250">
        <DataGrid.Columns><DataGridTextColumn Header="原始值" Binding="{Binding Raw,UpdateSourceTrigger=PropertyChanged}" Width="120"/><DataGridTextColumn Header="描述" Binding="{Binding Label,UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns>
       </DataGrid>
       <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="AddEnumButton" Content="＋ 添加值" Click="AddEnum_Click" Margin="0,0,5,0"/><Button x:Name="DeleteEnumButton" Content="删除选中值" Click="DeleteEnum_Click"/></StackPanel>
      </StackPanel>
      <TextBlock x:Name="PolicyText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#405870"/>
      <TextBlock x:Name="OverlayError" Foreground="#B34035" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel></ScrollViewer>
     <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" Click="CancelOverlay_Click" Margin="0,0,6,0"/><Button Content="完成" Click="FinishOverlay_Click" MinWidth="74"/></StackPanel>
      <TextBlock Text="应用或取消后关闭；点击外部不丢失草稿" Foreground="#62778D" FontSize="11" VerticalAlignment="Center"/>
     </DockPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
