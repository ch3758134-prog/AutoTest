<UserControl x:Class="AutoTest.Desktop.Shell.ProjectConfigurationOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,0">
    <Button DockPanel.Dock="Right" Content="检查当前工程"
     Command="{Binding CheckActiveCommand}" Margin="0,0,0,0"
     VerticalAlignment="Center"/>
    <TextBlock Text="检测准备 · 工程配置与实测" FontSize="14" FontWeight="SemiBold"
     VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <TabControl x:Name="ConfigTabs" Grid.Row="1" Background="White" BorderThickness="0" Padding="0">
   <TabControl.Resources>
    <Style TargetType="{x:Type TabItem}">
     <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
     <Setter Property="FontSize" Value="11"/>
     <Setter Property="Foreground" Value="#64758C"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="{x:Type TabItem}">
        <Border x:Name="TabLine" Height="35" Background="#FBFCFF"
         BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="13,0">
         <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="TabLine" Property="BorderBrush" Value="#2368BD"/>
          <Setter TargetName="TabLine" Property="Background" Value="White"/>
          <Setter Property="Foreground" Value="#1C5DA8"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
         </Trigger>
         <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="TabLine" Property="Background" Value="#F0F5FB"/>
         </Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </TabControl.Resources>
   <TabControl.Template>
    <ControlTemplate TargetType="{x:Type TabControl}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FBFCFF" BorderBrush="#DBE3ED"
       BorderThickness="0,0,0,1">
       <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
      </Border>
      <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
       ContentSource="SelectedContent"/>
     </Grid>
    </ControlTemplate>
   </TabControl.Template>
   <TabItem Header="检测准备">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel MaxWidth="1050" Margin="22,20,22,24">
      <DockPanel LastChildFill="True" Margin="0,0,0,12">
       <Button Content="重新核对" Command="{Binding RefreshEngineeringSetupCommand}"
        DockPanel.Dock="Right" Padding="15,7" Margin="12,0,0,0"/>
       <StackPanel>
        <TextBlock Text="{Binding CurrentProjectName}" FontWeight="SemiBold"
         FontSize="21" Foreground="{StaticResource Ink}"/>
        <TextBlock Text="检测准备 · 同一 ECU 工程、同一测试项目、同一套正式资源"
         Margin="0,5,0,0" Foreground="{StaticResource Subtle}"/>
       </StackPanel>
      </DockPanel>
      <Border CornerRadius="8" Background="#F3F7FC" BorderBrush="#DFE8F2"
       BorderThickness="1" Padding="13" Margin="0,0,0,13">
       <StackPanel>
        <TextBlock Text="从工程配置直接进入真实实测" FontWeight="SemiBold"
         Foreground="#2B507D" FontSize="13" Margin="0,0,0,5"/>
        <TextBlock Text="点击任何一项，可在同一个工作台处理配置、实际试验与问题。TEST、DBC、固件及原生烧录资源只维护一次；独立工具仍可脱离工程使用。"
         Foreground="#4F647E" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding SetupOverallStatus}" Foreground="#6D7683"
         TextWrapping="Wrap" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
      <TextBlock Text="工程工作清单" Foreground="{StaticResource Ink}" FontWeight="SemiBold"
       FontSize="14" Margin="0,0,0,10"/>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="15" Margin="0,0,0,9">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="查看身份与资源" Tag="dut" Click="NavigateToStage_Click"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="01  ECU 型号及资源" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupModelStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="15" Margin="0,0,0,9">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="编辑 TEST 项目" Command="{Binding OpenFirstTestProjectCommand}"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="02  测试项目与用例" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupTestStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="15" Margin="0,0,0,9">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="配置并试扫" Tag="scan" Click="NavigateToStage_Click"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="03  扫码身份与工程匹配" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupScanStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="15" Margin="0,0,0,9">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="配置与验证烧录" Tag="flash" Click="NavigateToStage_Click"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="04  原生烧录工艺" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupFlashStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="15" Margin="0,0,0,9">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="操作夹具与 IGN" Tag="station" Click="NavigateToStage_Click"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="05  工位与夹具 / START" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupStationStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="15">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="检查整机条件" Tag="check" Click="NavigateToStage_Click"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="06  整机联调与投产" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="统一检查身份、夹具、START、必烧录、全部 TEST 与记录。缺少真机证据时不得宣告生产就绪。"
          Foreground="{StaticResource Subtle}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="DUT 配置">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="12,4">
      <Button DockPanel.Dock="Right" Content="创建／打开 TCF"
       Command="{Binding OpenTcfCommand}"/>
      <TextBlock Text="ECU 与 DBC 资源"
       FontSize="11" Foreground="#64758C" VerticalAlignment="Center"/>
     </DockPanel>
     <ContentControl x:Name="DutFormHost" Grid.Row="1"
      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
   </TabItem>
   <TabItem Header="工位状态">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="12,4">
      <Button DockPanel.Dock="Right" Content="创建／打开 TBC"
       Command="{Binding OpenTbcCommand}"/>
      <TextBlock Text="固定台架：ECU CAN（A1/A12）／KEY CAN（B1/B11）"
       Foreground="#64758C" FontSize="11" VerticalAlignment="Center"/>
     </DockPanel>
     <ContentControl x:Name="BenchFormHost" Grid.Row="1"
      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
   </TabItem>
   <TabItem Header="扫码与身份">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Background="#F3F7FC" BorderBrush="#DBE5F0"
      BorderThickness="0,0,0,1" Padding="14,8">
      <TextBlock Text="同一工位扫码服务 · 原始数据 → 身份解析 → 唯一型号工程；在这里直接试扫，不用切换窗口。扫码不会触发烧录。"
       Foreground="#506986" TextWrapping="Wrap"/>
     </Border>
     <ContentControl x:Name="ScannerSetupHost" Grid.Row="1"
      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
   </TabItem>
   <TabItem Header="烧录工艺">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel MaxWidth="880" Margin="22,22,22,18">
      <TextBlock Text="当前 ECU 工程 · 原生烧录工艺" FontSize="18" FontWeight="SemiBold"
       Foreground="{StaticResource Ink}"/>
      <TextBlock Text="{Binding SetupFlashStatus}" Foreground="#516B83"
       TextWrapping="Wrap" Margin="0,10,0,14"/>
      <TextBlock Text="当前工程内受控管理烧录参数、固件、算法以及发布版本。配置编辑器使用当前工程，不需要 CanTool XML，也不创建第二份扫码配方。"
       Foreground="{StaticResource Subtle}" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,16,0,0">
       <Button Content="编辑当前工程烧录工艺" Command="{Binding OpenNativeFlashProfileCommand}"
        Padding="15,9" Margin="0,0,10,8" Style="{StaticResource AtPrimaryButton}"/>
       <Button Content="真实烧录调试（查看 UDS/CAN）" Command="{Binding OpenFlashWorkbenchCommand}"
        Padding="15,9" Margin="0,0,10,8"/>
       <Button Content="核对发布配置" Command="{Binding RefreshEngineeringSetupCommand}"
        Padding="15,9" Margin="0,0,10,8"/>
      </WrapPanel>
      <Border Background="#F2F6FA" BorderBrush="#E0E8EF" BorderThickness="1"
       CornerRadius="6" Padding="12" Margin="0,10,0,0">
       <StackPanel>
        <TextBlock Text="正确的工程操作顺序" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="编辑参数与受控固件 → 校验冻结 Job → 使用独立烧录工具进行实体调试 → 审查证据 → 显式发布当前工程烧录版本。正式生产每次都使用发布快照前置烧录。"
         Foreground="{StaticResource Subtle}" TextWrapping="Wrap"/>
        <TextBlock Text="当前版本的真实烧录工具独占主控 USB；编辑工艺不意味着已成功烧录，发布记录也不能代替 ECU 后验。"
         Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#9A6A2C"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="夹具与 START">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel MaxWidth="900" Margin="22,22,22,18">
      <TextBlock Text="工位能力 · 夹具 / IGN / 软件与实体 START" FontSize="18"
       FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
      <TextBlock Text="{Binding SetupStationStatus}" Foreground="#516B83"
       TextWrapping="Wrap" Margin="0,10,0,14"/>
      <TextBlock Text="固定硬件：夹具1、夹具2由主控 USB 驱动；IGN 独立控制。使用真实手动台架可直接压紧/释放、读取 MCU GPIO 并观察 USB 结果，不需要创建 TEST 用例。"
       Foreground="{StaticResource Subtle}" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,14,0,0">
       <Button Content="连接 / 断开主控" Command="{Binding ConnectHardwareCommand}" Padding="14,8"
        Margin="0,0,9,8"/>
       <Button Content="读取夹具 MCU GPIO" Command="{Binding ReadEngineeringClampGpioCommand}"
        Padding="14,8" Margin="0,0,9,8"/>
       <Button Content="打开真实夹具操作台架" Command="{Binding OpenManualBenchCommand}"
        Style="{StaticResource AtPrimaryButton}" Padding="14,8" Margin="0,0,9,8"/>
      </WrapPanel>
      <Border Background="White" BorderBrush="#DDE6EE" BorderThickness="1"
       CornerRadius="7" Padding="13" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="单项真实操作 · 一次点击只发送一条受控请求"
         FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <WrapPanel Margin="0,0,0,8">
         <TextBlock Text="夹具 1" Width="75" VerticalAlignment="Center" FontWeight="SemiBold"/>
         <Button Content="压紧" Command="{Binding EngineeringClamp1PressCommand}" Padding="14,7" Margin="0,0,9,0"/>
         <Button Content="释放" Command="{Binding EngineeringClamp1ReleaseCommand}" Padding="14,7" Margin="0,0,9,0"/>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,8">
         <TextBlock Text="夹具 2" Width="75" VerticalAlignment="Center" FontWeight="SemiBold"/>
         <Button Content="压紧" Command="{Binding EngineeringClamp2PressCommand}" Padding="14,7" Margin="0,0,9,0"/>
         <Button Content="释放" Command="{Binding EngineeringClamp2ReleaseCommand}" Padding="14,7" Margin="0,0,9,0"/>
        </WrapPanel>
        <WrapPanel>
         <TextBlock Text="IGN" Width="75" VerticalAlignment="Center" FontWeight="SemiBold"/>
         <Button Content="ON" Command="{Binding EngineeringIgnOnCommand}" Padding="14,7" Margin="0,0,9,0"/>
         <Button Content="OFF" Command="{Binding EngineeringIgnOffCommand}" Padding="14,7" Margin="0,0,9,0"/>
        </WrapPanel>
        <TextBlock Text="这是当前工位的真实手动调试命令，不会修改正式工程流程、不自动运行测试、不声称夹具机械到位。主控未连接或协议不符时后台拒绝发送，按钮仍可点击。"
         Foreground="#687C8B" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="#F3F7FC" CornerRadius="7" BorderBrush="#DCE5EF"
       BorderThickness="1" Padding="13" Margin="0,9,0,0">
       <StackPanel>
        <TextBlock Text="设备读取结果" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding EngineeringClampReadback}" Foreground="#3B607E"
         TextWrapping="Wrap"/>
        <TextBlock Text="只代表主控 GPIO，绝不冒充夹具机械到位信号。实体 START 尚未实测，上位机保留软件 START；两者最终共用一次检测锁。"
         Foreground="#7C6470" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="White" BorderBrush="#DDE6EE" BorderThickness="1"
       CornerRadius="7" Padding="13" Margin="0,14,0,0">
       <StackPanel>
        <DockPanel Margin="0,0,0,10" LastChildFill="True">
         <Button DockPanel.Dock="Right" Content="创建／编辑本工程工位动作"
          Command="{Binding OpenInspectionProcedureCommand}" Padding="12,7"
          Margin="12,0,0,0"/>
         <TextBlock Text="本型号检测工艺中的夹具动作"
          FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="动作定义与测试用例分离，受当前工程正式资源修订管理；下面的配置仅保存草稿，实体执行仍需硬件验证。"
         Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ContentControl x:Name="InspectionProcedureHost"
         HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
       </StackPanel>
      </Border>
      <Border CornerRadius="7" BorderBrush="#DBE3ED" BorderThickness="1"
       Background="White" Padding="13" Margin="0,14,0,0">
       <StackPanel>
        <TextBlock Text="正式检测关联" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <TextBlock Text="扫码 → 夹具准备 → 软件/实体 START → 原生前置烧录 → 全部 TEST → RECORD → 受控收尾。当前工位实际夹具动作顺序、等待和机械到位条件仍需通过真实硬件确定，不使用假传感器。"
         TextWrapping="Wrap" Foreground="{StaticResource Subtle}"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="运行前检查">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="16,16,16,12">
      <TextBlock Text="当前工程与实体运行条件" FontSize="13" FontWeight="SemiBold"
       Margin="0,0,0,12"/>
      <Border Background="#F5F8FC" BorderBrush="#E5ECF4"
       BorderThickness="1" CornerRadius="6" Padding="10">
       <StackPanel>
        <TextBlock Text="{Binding SelectedConfigurationSummary}" TextWrapping="Wrap"
         Foreground="#64758C" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding HardwareStatus}" Foreground="#A96D20"/>
        <TextBlock Text="尚无正式项目级 Run/设备租约预检；此页面不输出 PASS，也不执行实体动作。"
         Foreground="#64758C" TextWrapping="Wrap" Margin="0,10,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
