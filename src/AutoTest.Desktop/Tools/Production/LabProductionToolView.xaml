<UserControl x:Class="AutoTest.Desktop.Tools.Production.LabProductionToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="650" MinHeight="420"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="3,0,3,0" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock FontSize="23" FontWeight="SemiBold" Text="生产 / 扫码模拟工作台" />
            <TextBlock Margin="0,6,0,0" Foreground="#9B3D21" FontWeight="SemiBold"
                       Text="MOCK ONLY · 当前不是实物出厂检测 · 禁止真实放行及真实出厂数累计" />
            <TextBlock Margin="0,4,0,0" Opacity="0.75"
                       Text="扫码枪单独实测：聚焦专用框后扫码，以 Enter 终止；系统只记录焦点和输入变化，不能将人工键入当作已识别的硬件。" />
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="1,0,0,0" BorderBrush="#D6D6D6"
                Margin="0,12,0,0" Padding="0,10,0,0">
            <StackPanel>
                <WrapPanel>
                    <TextBlock FontWeight="SemiBold" Text="状态：" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                </WrapPanel>
                <TextBlock Margin="0,4,0,0" Opacity="0.68" FontSize="11"
                           Text="实际 TEST/Records/Physical 接线由 INTEGRATION 负责；当前内置 Mock 运行及内存历史不能代替持久生产记录。" />
            </StackPanel>
        </Border>
        <TabControl>
            <TabItem Header="扫码 / 模拟执行">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="13" Text="专用扫码输入（真实键盘口/人工均可；设备身份未验证）" FontWeight="SemiBold" />
                    <DockPanel Grid.Row="1" Margin="0,8,0,12" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="解析并匹配" Command="{Binding PreviewCommand}" />
                        <TextBox x:Name="BarcodeInput" KeyDown="BarcodeInput_OnKeyDown"
                                 TextChanged="BarcodeInput_OnTextChanged"
                                 GotKeyboardFocus="BarcodeInput_OnGotFocus"
                                 LostKeyboardFocus="BarcodeInput_OnLostFocus"
                                 Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="在此处聚焦扫码；扫码枪通常附带 Enter 结束符" />
                    </DockPanel>
                    <TextBlock Grid.Row="2" Margin="0,0,0,9" FontSize="11" TextWrapping="Wrap"
                               Text="{Binding ScannerEvidence}" ToolTip="Enter 自动捕获需要本专用输入框获得焦点并发生新文本变更；不能鉴别真实扫码枪与人工输入。" />
                    <Border Grid.Row="3" BorderBrush="#D6D6D6" BorderThickness="1" Padding="12" CornerRadius="4">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="匹配预览 / 不修改当前运行身份" />
                            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Text="{Binding MatchDetail}" />
                            <TextBlock Margin="0,5,0,0" Opacity="0.75" Text="{Binding RuleRevision, StringFormat=已发布规则版本：{0}}" />
                            <TextBlock Margin="0,3,0,0" Opacity="0.75" Text="{Binding CatalogSource}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="4" Margin="0,14,0,6">
                        <TextBlock Text="模拟 TEST 场景（不会发送 CAN、IGN、KEY 或 Flash 命令）"
                                   FontWeight="SemiBold" />
                        <WrapPanel Margin="0,7,0,0" VerticalAlignment="Center">
                            <ComboBox MinWidth="165" ItemsSource="{Binding Scenarios}"
                                      SelectedItem="{Binding SelectedScenario, Mode=TwoWay}" />
                            <CheckBox Content="明确允许同一 ECU 复测（不增加单件数）"
                                      Margin="14,0,8,0" VerticalAlignment="Center"
                                      IsChecked="{Binding AllowRetest, Mode=TwoWay}" />
                            <Button Content="执行 Mock" Command="{Binding RunMockCommand}" />
                            <Button Content="取消当前运行" Command="{Binding AbortCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="5" Margin="0,10,0,0">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="最新运行 / RunId / 结果来源" />
                        <TextBox Margin="0,7,0,0" BorderThickness="1" IsReadOnly="True"
                                 Text="{Binding LastRun, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,9,0,0" Text="PASS（Mock）仅为模拟执行结果，不产生 ECU 出厂合格结论。"
                                   Foreground="#9B3D21" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="编号解析规则">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                   Text="使用 .NET 正则命名捕获组；身份字段以逗号分隔，保留原始编号前导零。多个不同正则需填写交集人工评审编号，运行遇到多匹配始终拒绝。" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="新增规则" Command="{Binding AddRuleCommand}" />
                        <Button Content="删除选中" Command="{Binding RemoveRuleCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="规则 ID" Width="140" Binding="{Binding RuleId, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="正则 Pattern" Width="*" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="身份字段 CSV" Width="140" Binding="{Binding IdentityFieldsCsv, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="交集评审编号" Width="155" Binding="{Binding OverlapReviewId, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="启用" Width="65" Binding="{Binding Enabled}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="配方 / TEST 资源">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.75"
                               Text="此处的测试程序与工位资源引用属于 Mock 演示；真实资源必须经 PROJECT 版本解析、权限预检和 INTEGRATION 适配，编辑文本不能自行认证物理资源。" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="新增配方" Command="{Binding AddRecipeCommand}" />
                        <Button Content="删除选中" Command="{Binding RemoveRecipeCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="配方 ID" Width="135" Binding="{Binding RecipeId, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="修订" Width="75" Binding="{Binding Revision, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="型号条件" Width="110" Binding="{Binding ModelField, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="客户条件" Width="110" Binding="{Binding CustomerField, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Mock TEST 引用" Width="*" Binding="{Binding MockTestProgramKey, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Mock Station 引用" Width="*" Binding="{Binding MockStationProfileKey, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="生效 UTC (含)" Width="175" Binding="{Binding EffectiveFromUtc, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="截止 UTC (不含)" Width="175" Binding="{Binding EffectiveUntilUtc, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="启用" Width="65" Binding="{Binding Enabled}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="规则验证样本">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Content="增加样本" Command="{Binding AddSampleCommand}" />
                        <Button Content="删除选中" Command="{Binding RemoveSampleCommand}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Opacity="0.75"
                               Text="发布时逐个验证所有已填写样本，但有限样本不能证明所有正则完全无交集。" />
                    <DataGrid ItemsSource="{Binding Samples}" SelectedItem="{Binding SelectedSample}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="原始扫码" Width="*" Binding="{Binding RawBarcode, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="预期规则 ID" Width="220" Binding="{Binding ExpectedRuleId, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="预期配方 ID" Width="220" Binding="{Binding ExpectedRecipeId, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="样本时间 UTC" Width="210" Binding="{Binding ObservedAtUtc, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="运行历史 / 统计">
                <DockPanel Margin="12">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="本次会话 Mock 执行次数：" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MockRunCount}" />
                        <TextBlock Text="    不同模拟单件：" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DistinctMockUnits}" />
                        <TextBlock Text="    真实出厂放行单件：" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FactoryReleasedCount}" />
                    </WrapPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding History}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RunId" Width="220" Binding="{Binding RunId}" />
                            <DataGridTextColumn Header="结束时间" Width="155" Binding="{Binding When}" />
                            <DataGridTextColumn Header="单件身份 Key" Width="*" Binding="{Binding UnitKey}" />
                            <DataGridTextColumn Header="配方" Width="130" Binding="{Binding Recipe}" />
                            <DataGridTextColumn Header="状态" Width="100" Binding="{Binding Result}" />
                            <DataGridTextColumn Header="来源" Width="85" Binding="{Binding Origin}" />
                            <DataGridCheckBoxColumn Header="出厂放行" Width="90" Binding="{Binding FactoryReleased}" />
                        </DataGrid.Columns>
                        </DataGrid>
                        <GroupBox Grid.Row="1" Header="扫码观察（不等于 Run）" Margin="0,8,0,0">
                            <DataGrid ItemsSource="{Binding ScanEvents}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Width="155" Binding="{Binding When}" />
                                    <DataGridTextColumn Header="扫码文本" Width="*" Binding="{Binding Input}" />
                                    <DataGridTextColumn Header="匹配结果 / 拒绝原因" Width="220" Binding="{Binding Result}" />
                                    <DataGridTextColumn Header="输入来源" Width="190" Binding="{Binding Origin}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="诊断 / 原始事件">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontWeight="SemiBold" FontSize="14" Text="生产流程诊断时间线 / R0-DIAG" />
                        <TextBlock Margin="0,5,0,9" TextWrapping="Wrap" Opacity="0.76"
                                   Text="UI 层原始事件，不是 USB/CAN 物理 Trace。JSONL 保存 UTC、阶段、错误码、来源、RunId、扫码 AttemptId 和版本；默认脱敏。" />
                        <WrapPanel>
                            <CheckBox Content="只看警告和错误" IsChecked="{Binding ErrorsOnly, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                            <CheckBox Content="只看扫码枪采集" IsChecked="{Binding ScannerOnly, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="复制筛选结果（脱敏）" Click="CopyDiagnostics_OnClick" />
                            <Button Content="导出 JSONL" Click="ExportDiagnostics_OnClick" />
                            <CheckBox Margin="12,0,0,0" VerticalAlignment="Center"
                                      Content="包含原始编号（仅本地敏感资料）"
                                      IsChecked="{Binding IncludeRawBarcodeInLocalExport, Mode=TwoWay}" />
                        </WrapPanel>
                        <TextBlock Margin="0,9,0,0" Text="{Binding ExportPath}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" Opacity="0.7"
                                   Text="{Binding DroppedDiagnosticEvents, StringFormat=内存环形缓冲已丢弃事件：{0}}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding DiagnosticEvents}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="UTC 时间" Width="185" Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" />
                            <DataGridTextColumn Header="#" Width="65" Binding="{Binding Sequence}" />
                            <DataGridTextColumn Header="阶段" Width="140" Binding="{Binding Stage}" />
                            <DataGridTextColumn Header="级别" Width="78" Binding="{Binding Severity}" />
                            <DataGridTextColumn Header="代码" Width="190" Binding="{Binding Code}" />
                            <DataGridTextColumn Header="来源" Width="132" Binding="{Binding Source}" />
                            <DataGridTextColumn Header="RunId" Width="220" Binding="{Binding RunId}" />
                            <DataGridTextColumn Header="采集 AttemptId" Width="220" Binding="{Binding CaptureAttemptId}" />
                            <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Summary}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="样本回放 / 规则诊断">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="草稿规则诊断 · 不发布、不执行 Test、不放行 ECU" />
                        <TextBlock Margin="0,5,0,9" TextWrapping="Wrap" Opacity="0.73"
                                   Text="直接读取当前编辑中的规则、配方与样本。所有检查是软件预览，不能取代配置发布校验；样本无冲突也不等于所有编号都无冲突。" />
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="默认回放时间（UTC）" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox MinWidth="205" Width="250" ToolTip="空样本时间使用此值；已填样本时间优先"
                                     Text="{Binding SampleReplayAtUtc, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="8,0,3,0" Content="批量回放样本" Command="{Binding ReplaySamplesCommand}" />
                            <Button Content="检查规则重叠" Command="{Binding InspectOverlapCommand}" />
                            <Button Content="对比已发布版本" Command="{Binding CompareDraftCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <GroupBox Grid.Row="1" Header="样本回放：预期 / 实际" Margin="0,10,0,0">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SampleReplayStatus}"
                                       TextWrapping="Wrap" Margin="0,0,0,5" />
                            <DataGrid ItemsSource="{Binding SampleReplayRows}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Width="48" Binding="{Binding RowNumber}" />
                                    <DataGridTextColumn Header="样本原始编号（仅本地 UI）" Width="150" Binding="{Binding RawBarcode}" />
                                    <DataGridTextColumn Header="预期规则" Width="130" Binding="{Binding ExpectedRuleId}" />
                                    <DataGridTextColumn Header="实际规则" Width="130" Binding="{Binding ActualRuleId}" />
                                    <DataGridTextColumn Header="预期配方" Width="140" Binding="{Binding ExpectedRecipeId}" />
                                    <DataGridTextColumn Header="实际配方" Width="140" Binding="{Binding ActualRecipeId}" />
                                    <DataGridTextColumn Header="候选配方@Revision" Width="180" Binding="{Binding CandidateSummary}" />
                                    <DataGridTextColumn Header="诊断码" Width="200" Binding="{Binding Code}" />
                                    <DataGridCheckBoxColumn Header="样本通过" Width="95" Binding="{Binding Passed}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="2" Header="规则对重叠证据（有限样本，不作全域保证）" Margin="0,9,0,0">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding OverlapStatus}"
                                       TextWrapping="Wrap" Margin="0,0,0,5" />
                            <DataGrid ItemsSource="{Binding RuleOverlapRows}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="规则 A" Width="140" Binding="{Binding FirstRuleId}" />
                                    <DataGridTextColumn Header="规则 B" Width="140" Binding="{Binding SecondRuleId}" />
                                    <DataGridTextColumn Header="分类" Width="200" Binding="{Binding Classification}" />
                                    <DataGridTextColumn Header="证实重叠的样本数" Width="145" Binding="{Binding CollidingSamples}" />
                                    <DataGridTextColumn Header="说明 / 确定性" Width="*" Binding="{Binding Evidence}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                    <GroupBox Grid.Row="3" Header="当前草稿 ↔ 已发布修订差异" Margin="0,9,0,0">
                        <DockPanel Margin="8">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding RevisionCompareStatus}"
                                       TextWrapping="Wrap" Margin="0,0,0,5" />
                            <DataGrid ItemsSource="{Binding RevisionChangeRows}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="对象" Width="125" Binding="{Binding EntityType}" />
                                    <DataGridTextColumn Header="ID / 修订" Width="225" Binding="{Binding EntityKey}" />
                                    <DataGridTextColumn Header="变更" Width="100" Binding="{Binding Kind}" />
                                    <DataGridTextColumn Header="变更字段（不显示样本原文）" Width="*" Binding="{Binding ChangedFields}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="发布 / 本地配置">
                <StackPanel Margin="12">
                    <TextBlock FontWeight="SemiBold" Text="保存草稿与发布是两个独立操作" FontSize="14" />
                    <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Text="草稿允许保留错误供修正；发布必须通过全部规则、配方重叠和样本检查，新的配置只有发布后才能被扫码使用。" />
                    <WrapPanel Margin="0,15,0,0">
                        <Button Content="保存未发布草稿" Command="{Binding SaveDraftCommand}" />
                        <Button Content="验证并发布 MOCK 配方" Command="{Binding PublishCommand}" />
                        <Button Content="加载本地配置" Command="{Binding LoadCommand}" />
                    </WrapPanel>
                    <TextBlock Margin="0,18,0,0" Text="{Binding DraftState}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,9,0,0" Text="{Binding CatalogSource}" />
                    <TextBlock Margin="0,9,0,0" Text="{Binding RuleRevision, StringFormat=当前生效修订：{0}}" />
                    <TextBlock Margin="0,12,0,0" Foreground="#9B3D21" TextWrapping="Wrap"
                               Text="此工具提供配置草稿和 MOCK 发布，不提供物理生产签发功能。不能把 JSON 编辑器、Mock 工位资源或内存历史当成真实产线放行证据。" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
