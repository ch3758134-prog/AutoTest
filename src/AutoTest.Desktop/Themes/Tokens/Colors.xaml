<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Color x:Key="InkColor">#E6EDF5</Color><Color x:Key="SubtleColor">#9CABBE</Color><Color x:Key="PanelColor">#202B3A</Color><Color x:Key="BackgroundColor">#111A27</Color><Color x:Key="LineColor">#34465B</Color><Color x:Key="AccentColor">#58A6FF</Color>
 <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/><SolidColorBrush x:Key="Subtle" Color="{StaticResource SubtleColor}"/><SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/><SolidColorBrush x:Key="Canvas" Color="{StaticResource BackgroundColor}"/><SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/><SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
 <SolidColorBrush x:Key="Ok" Color="#77D9AA"/><SolidColorBrush x:Key="Warning" Color="#FFCB75"/><SolidColorBrush x:Key="Danger" Color="#FF8994"/>
</ResourceDictionary>