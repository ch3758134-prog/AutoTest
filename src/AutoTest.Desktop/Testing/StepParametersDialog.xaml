<Window x:Class="AutoTest.Desktop.Testing.StepParametersDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="编辑步骤参数" Width="550" Height="515" MinWidth="480" MinHeight="430"
 WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
 Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="70"/>
    </Grid.RowDefinitions>
    <Border Background="{StaticResource ToolbarSurface}" Padding="20,14"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="步骤参数" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="TypeInfo" Foreground="{StaticResource Subtle}"
                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,16,20,14">
        <TextBlock Text="步骤名称" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <TextBox x:Name="NameInput" Margin="0,0,0,16"/>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/>
        <TextBlock Text="参数" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,11"/>
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding DisplayName}" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Options}" IsEditable="True"
                    Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                  <ComboBox.Style>
                    <Style TargetType="ComboBox">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOptions}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ComboBox.Style>
                </ComboBox>
                <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding Key}">
                  <TextBox.Style>
                    <Style TargetType="TextBox">
                      <Setter Property="Visibility" Value="Visible"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasOptions}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBox.Style>
                </TextBox>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}"
                   TextWrapping="Wrap" Margin="0,4,0,8"/>
        <TextBlock Text="应用会生成一条可撤销的编辑记录。只有回到工作台点击保存才会写入磁盘。"
                   Foreground="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" IsCancel="True"/>
        <Button Content="应用参数" MinWidth="110" Margin="0" IsDefault="True"
                Style="{StaticResource AtPrimaryButton}" Click="Apply_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>