<Window x:Class="AutoTest.Desktop.Shell.RecordHistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="检测记录与报告" Width="1110" Height="690" MinWidth="820" MinHeight="510"
 WindowStartupLocation="CenterOwner" Background="#F6F8FA" Foreground="#263849"
 FontFamily="{StaticResource UiFont}" FontSize="13">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="清空来源" Click="ClearSources_Click" Padding="10,6" Margin="0,0,7,0"/>
    <Button Content="添加记录库…" Click="ChooseDatabase_Click" Padding="12,6"
     ToolTip="可一次选择多个 ECU 工程已有的 r1-records.sqlite，按 ECU 编号联合查询"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="检测记录与报告" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock x:Name="SourceLabel" Text="尚未载入记录库"
     Foreground="#64758C" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#E0E6EC" BorderThickness="1"
   CornerRadius="6" Padding="12" Margin="0,0,0,10">
   <DockPanel LastChildFill="False">
    <Button DockPanel.Dock="Right" Content="查询" Click="Query_Click" MinWidth="75" Padding="12,6"
     Style="{StaticResource AtPrimaryButton}" Margin="10,0,0,0"/>
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="ECU 编号" VerticalAlignment="Center" Margin="0,0,7,0"/>
     <TextBox x:Name="DutSearch" Width="230" MinHeight="30" VerticalContentAlignment="Center"
      KeyDown="DutSearch_KeyDown"
      ToolTip="输入完整 ECU 编号；留空查询最近检测"/>
     <TextBlock Text="记录类别" VerticalAlignment="Center" Margin="18,0,7,0"/>
     <ComboBox x:Name="ModeFilter" Width="132" Height="30" SelectedIndex="0">
      <ComboBoxItem Content="全部" Tag="All"/>
      <ComboBoxItem Content="正式检测" Tag="Production"/>
      <ComboBoxItem Content="开发调试" Tag="Development"/>
      <ComboBoxItem Content="独立诊断" Tag="Diagnostic"/>
     </ComboBox>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="2" Background="White" BorderBrush="#E0E6EC" BorderThickness="1"
   CornerRadius="6">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="1.1*" MinHeight="130"/>
     <RowDefinition Height="5"/>
     <RowDefinition Height="1*" MinHeight="130"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DataGrid x:Name="HistoryGrid" Grid.Row="0" AutoGenerateColumns="False"
     CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
     SelectionMode="Extended" SelectionChanged="HistoryGrid_SelectionChanged"
     MouseDoubleClick="HistoryGrid_DoubleClick" ToolTip="双击记录查看完整报告；Ctrl 多选用于批量打包"
     RowHeaderWidth="0" RowHeight="36" ColumnHeaderHeight="38"
     BorderThickness="0" GridLinesVisibility="Horizontal"
     HorizontalScrollBarVisibility="Auto">
     <!-- Group actual SQLite-backed attempts by the ONE DUT identity.
          Expanding a group reveals every independent Inspection/Run record.
          No new verdict source or editable history is created. -->
     <DataGrid.GroupStyle>
      <GroupStyle>
       <GroupStyle.ContainerStyle>
        <Style TargetType="{x:Type GroupItem}">
         <Setter Property="Template">
          <Setter.Value>
           <ControlTemplate TargetType="{x:Type GroupItem}">
            <Expander IsExpanded="True" Background="#F4F8FC"
             BorderBrush="#DAE4EF" BorderThickness="0,0,0,1">
             <Expander.Header>
              <DockPanel Margin="8,5">
               <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                Foreground="#254D75"/>
               <TextBlock Text="{Binding ItemCount,StringFormat='  ·  {0} 次记录'}"
                Foreground="#6F8195" FontSize="12" Margin="12,0,0,0"/>
              </DockPanel>
             </Expander.Header>
             <ItemsPresenter/>
            </Expander>
           </ControlTemplate>
          </Setter.Value>
         </Setter>
        </Style>
       </GroupStyle.ContainerStyle>
      </GroupStyle>
     </DataGrid.GroupStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="检测时间" Width="157" Binding="{Binding StartedLocal}"/>
      <DataGridTextColumn Header="ECU 编号" Width="*" MinWidth="150" Binding="{Binding DutId}"/>
      <DataGridTextColumn Header="工程来源" Width="130" Binding="{Binding ProjectName}"/>
      <DataGridTextColumn Header="类别" Width="102" Binding="{Binding ModeLabel}"/>
      <DataGridTextColumn Header="记录判定" Width="104" Binding="{Binding VerdictLabel}"/>
      <DataGridTextColumn Header="归档状态" Width="105" Binding="{Binding PersistenceLabel}"/>
      <DataGridTextColumn Header="步骤事实" Width="93" Binding="{Binding StepFactCount}"/>
      <DataGridTextColumn Header="失败原因" Width="185" Binding="{Binding FailureReason}"/>
     </DataGrid.Columns>
    </DataGrid>
    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
     ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
     Background="#E3EAF1" ToolTip="拖动调整运行列表与真实步骤事实的高度"/>
    <DockPanel Grid.Row="2" LastChildFill="True">
     <TextBlock x:Name="DetailsStatus" DockPanel.Dock="Top" FontSize="12"
      Foreground="#526B84" Background="#F7FAFD" Padding="10,6"
      Text="选择一次真实记录后查看逐步骤数据、事件和证据状态"/>
     <TabControl BorderThickness="0" Background="White" FontSize="13">
      <TabItem Header="逐步骤事实">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid x:Name="StepFactsGrid" Grid.Row="0" AutoGenerateColumns="False"
         IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
         SelectionMode="Single" SelectionChanged="StepFactsGrid_SelectionChanged"
         RowHeight="33" ColumnHeaderHeight="34"
         HorizontalScrollBarVisibility="Auto"
         BorderThickness="0" GridLinesVisibility="Horizontal"
         EnableRowVirtualization="True">
         <DataGrid.Columns>
          <DataGridTextColumn Header="#" Width="45" Binding="{Binding Number}"/>
          <DataGridTextColumn Header="步骤路径" Width="*" MinWidth="130"
           Binding="{Binding StepLabel}"/>
          <DataGridTextColumn Header="实际状态" Width="135" Binding="{Binding State}"/>
          <DataGridTextColumn Header="测量值" Width="135" Binding="{Binding Actual}"/>
          <DataGridTextColumn Header="期望值" Width="135" Binding="{Binding Expected}"/>
          <DataGridTextColumn Header="质量" Width="105" Binding="{Binding Quality}"/>
          <DataGridTextColumn Header="发生时间" Width="145" Binding="{Binding When}"/>
          <DataGridTextColumn Header="说明" Width="175" Binding="{Binding FailureHint}"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StepDetailText" Grid.Row="1" Margin="10,7"
         FontSize="12" TextWrapping="Wrap" Foreground="#485D73"
         Text="选择一个步骤可查看 Occurrence、真实证据 ID 和说明"/>
       </Grid>
      </TabItem>
      <TabItem Header="原始事件">
       <DataGrid x:Name="EventFactsGrid" AutoGenerateColumns="False"
        IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
        RowHeight="33" ColumnHeaderHeight="34"
        HorizontalScrollBarVisibility="Auto"
        BorderThickness="0" GridLinesVisibility="Horizontal"
        EnableRowVirtualization="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="#" Width="45" Binding="{Binding Number}"/>
         <DataGridTextColumn Header="时间" Width="170" Binding="{Binding When}"/>
         <DataGridTextColumn Header="类别" Width="145" Binding="{Binding Kind}"/>
         <DataGridTextColumn Header="原始记录事实" Width="*" MinWidth="250"
          Binding="{Binding Description}"/>
         <DataGridTextColumn Header="证据质量" Width="125" Binding="{Binding Quality}"/>
        </DataGrid.Columns>
       </DataGrid>
      </TabItem>
      <TabItem Header="证据完整性">
       <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
         <TextBlock Text="本次真实归档证据" FontWeight="SemiBold"
          FontSize="15" Margin="0,0,0,8"/>
         <TextBlock x:Name="EvidenceIntegrity" FontSize="13"
          TextWrapping="Wrap" Foreground="#526B84"
          Text="尚未选择记录。证据不足或未归档不能解释为测试通过。"/>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
     </TabControl>
    </DockPanel>
    <Border Grid.Row="3" BorderBrush="#E0E6EC" BorderThickness="0,1,0,0" Padding="10,8">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
       <TextBlock x:Name="SelectionSummary" Text="选择一条记录查看详情"
        FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
        ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
       <TextBlock x:Name="FailureDetail" TextWrapping="Wrap" Foreground="#9C5018"
        TextTrimming="CharacterEllipsis" MaxHeight="60" Margin="0,5,12,0"
        ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="ViewReport" Content="打开完整报告" Click="OpenReport_Click"
        IsEnabled="False" Padding="12,6" Margin="0,0,7,0"/>
       <Button x:Name="ExportReport" Content="导出报告…" Click="ExportReport_Click"
        IsEnabled="False" Padding="12,6" Margin="0,0,7,0"/>
       <Button x:Name="BatchExportReport" Content="批量打包…" Click="BatchExportReport_Click"
        ToolTip="按 Ctrl 选择至少两条已归档记录；批量导出真实 HTML 或 JSON 至一个 ZIP 文件"
        IsEnabled="False" Padding="12,6" Margin="0,0,7,0"/>
       <Button x:Name="CancelBatchExport" Content="取消打包"
        Click="CancelBatchExport_Click" Visibility="Collapsed"
        Padding="10,6" ToolTip="取消当前打包并清理未完成的临时 ZIP"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </Border>
  <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,10,0,0"
   Foreground="#526477" TextWrapping="Wrap" Text="查询真实归档记录，不产生或修改 ECU 检测事实。"/>
 </Grid>
</Window>