<UserControl x:Class="AutoTest.Desktop.Shell.Navigation.ProjectExplorerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F8FAFD" Foreground="#24394D"
 FontFamily="{StaticResource UiFont}" FontSize="13">
 <UserControl.Resources>
  <Style x:Key="CaseRow" TargetType="{x:Type ListBoxItem}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="2,2,2,2"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#E4F0FD"/>
     <Setter Property="Foreground" Value="#165CA3"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="#EDF4FA"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <DockPanel LastChildFill="True">
  <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DFE8F1"
   BorderThickness="0,0,0,1" Padding="11,11,11,10">
   <StackPanel>
    <DockPanel LastChildFill="True">
     <TextBlock DockPanel.Dock="Left" Text="测试用例" FontSize="16"
      FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock DockPanel.Dock="Right" Foreground="#55718D" FontSize="12"
      Text="{Binding OrderedCaseCount,StringFormat='{}{0} 项'}"
      VerticalAlignment="Center"/>
    </DockPanel>
    <TextBox x:Name="CaseSearch" Height="32" Margin="0,11,0,9"
     Padding="8,5" VerticalContentAlignment="Center"
     TextChanged="CaseSearch_TextChanged"
     ToolTip="搜索用例名称，不修改 TEST 顺序"/>
    <Button Content="＋ 新建测试用例" Command="{Binding NewTestProgramCommand}"
     Style="{StaticResource AtPrimaryButton}" Padding="9,7"
     HorizontalAlignment="Stretch" Margin="0,0,0,4"
     ToolTip="创建测试用例并直接加入本工程的正式执行顺序"/>
    <Button Content="调整检测顺序…" Command="{Binding OpenFirstTestProjectCommand}"
     Style="{StaticResource AtQuietButton}" HorizontalAlignment="Stretch"
     Padding="8,5" ToolTip="编辑正式执行顺序；单步和临时调试勾选不修改生产顺序"/>
   </StackPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="White"
   BorderBrush="#DFE8F1" BorderThickness="0,1,0,0" Padding="10,10">
   <Button Content="工程资源 · DBC / 波形 / 公共流程"
    Command="{Binding OpenEngineeringResourcesCommand}"
    Style="{StaticResource AtQuietButton}" HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Left" Padding="9,7"
    ToolTip="专业资源分别在各自的工具中创建和编辑"/>
  </Border>
  <Grid>
   <ListBox x:Name="CaseList" ItemsSource="{Binding OrderedCaseNodes}"
    ItemContainerStyle="{StaticResource CaseRow}"
    SelectionChanged="CaseList_SelectionChanged"
    PreviewKeyDown="CaseList_PreviewKeyDown"
    BorderThickness="0" Background="Transparent" Padding="5,7"
    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate>
     <DataTemplate>
      <Grid Height="39" ToolTip="{Binding Description}">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="32"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <TextBlock Grid.Column="0" Text="{Binding CountLabel}" FontSize="12"
        Foreground="#67819C" VerticalAlignment="Center" HorizontalAlignment="Center"/>
       <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14"
        TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
        Margin="4,0,4,0"/>
      </Grid>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
    Margin="14" IsHitTestVisible="False">
    <StackPanel.Style>
     <Style TargetType="StackPanel">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding HasOrderedCases}" Value="False">
        <Setter Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </StackPanel.Style>
    <TextBlock Text="暂无正式测试用例" FontSize="14" FontWeight="SemiBold"
     Foreground="#667E95" HorizontalAlignment="Center"/>
    <TextBlock Text="新建用例后直接编辑步骤" FontSize="12"
     Foreground="#8193A6" Margin="0,7,0,0" HorizontalAlignment="Center"/>
   </StackPanel>
  </Grid>
 </DockPanel>
</UserControl>