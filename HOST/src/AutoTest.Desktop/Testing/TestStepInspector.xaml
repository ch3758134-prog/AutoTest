<UserControl x:Class="AutoTest.Desktop.Testing.TestStepInspector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:testing="clr-namespace:AutoTest.Desktop.Testing"
 Background="#FAFBFB" Foreground="#2B3435" FontFamily="{StaticResource UiFont}"
 FontSize="13" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12,9,12,11">
    <DockPanel Margin="0,0,0,8" LastChildFill="True">
     <Border DockPanel.Dock="Left" Background="#EDF4FF" CornerRadius="5"
      Width="27" Height="27" Margin="0,0,8,0">
      <TextBlock x:Name="TypeIcon" Text="▣" Foreground="#475668" FontSize="13"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock x:Name="StepCode" DockPanel.Dock="Right" Visibility="Collapsed" Foreground="#627C9D"
      VerticalAlignment="Center" FontFamily="Consolas" FontSize="10"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="Heading" Text="编辑步骤" Visibility="Collapsed" Foreground="#344454"
       FontWeight="SemiBold" FontSize="12"/>
      <TextBlock x:Name="TypeLabel" Foreground="#344454" FontSize="13" FontWeight="SemiBold"/>
     </StackPanel>
    </DockPanel>
    <!-- Editing existing StepId only. New action selection belongs exclusively to
         the central editor's grouped ActionPalette; no second type list here. -->
    <TextBlock x:Name="ActionDescription" TextWrapping="Wrap" Foreground="#64758C"
     FontSize="11" Margin="0,0,0,6" Visibility="Collapsed"/>
    <TextBlock x:Name="ImportWarning"
     Text="当前步骤类型未接入真实执行；请核对参数并转换为已支持的正式步骤。"
     TextWrapping="Wrap" Foreground="#9B6423" FontSize="11"
     Margin="0,0,0,10" Visibility="Collapsed"/>
    <DockPanel Margin="0,0,0,12" LastChildFill="True">
      <CheckBox x:Name="StepEnabledInput" DockPanel.Dock="Right" Content="执行此步骤"
       Margin="10,14,0,0" VerticalAlignment="Top" IsChecked="True"
       ToolTip="取消后，本步骤不参与测试；如果是流程容器，其子步骤也会跳过。步骤配置仍保留。"/>
      <StackPanel>
       <TextBlock Text="名称" Foreground="#627C9D" FontWeight="SemiBold"
        FontSize="11" Margin="0,0,0,4"/>
       <TextBox x:Name="NameInput" MinHeight="34"/>
      </StackPanel>
     </DockPanel>
    <StackPanel x:Name="PublicFlowPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="调用公共流程" Foreground="#627C9D" FontWeight="SemiBold"
      FontSize="11" Margin="0,0,0,5"/>
     <ComboBox x:Name="PublicFlowPicker" ItemsSource="{Binding AvailableFlowChoices}"
      DisplayMemberPath="Label" MinHeight="34"/>
     <TextBlock x:Name="PublicFlowReferenceStatus" TextWrapping="Wrap"
      Foreground="#A2752D" FontSize="10" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel x:Name="TargetPanel" Margin="0,0,0,13">
     <!-- All TEST DBC signals share the same search-first picker as CAN sending. -->
     <StackPanel x:Name="DbcSignalPickerPanel" Visibility="Collapsed">
      <TextBlock Text="DBC 信号" FontWeight="SemiBold" Foreground="#475668"
       FontSize="12" Margin="0,0,0,6"/>
      <testing:DbcReferencePicker x:Name="SignalDbcPicker"
       ChoiceCommitted="DbcReference_ChoiceCommitted"/>
     </StackPanel>
     <!-- Keep existing non-DBC KEY, IGN and wave resource edit contracts. -->
     <StackPanel x:Name="LegacyTargetPanel">
      <TextBlock Text="选择资源" Foreground="#627C9D"
       FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
      <TextBox x:Name="TargetSearch" TextChanged="TargetSearch_Changed"
       ToolTip="搜索 KEY、IGN 或波形资源"
       Margin="0,0,0,5"/>
      <ComboBox x:Name="TargetPicker" ItemsSource="{Binding AvailableTargets}"
       DisplayMemberPath="Label" MinHeight="34"
       SelectionChanged="TargetPicker_Changed"/>
     </StackPanel>
     <TextBlock x:Name="TargetHint" Visibility="Collapsed" Foreground="#64758C"
      FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>

    <!-- CAN remains an exact byte editor; DBC is an automatically attached
         helper, with a compact optional picker for changing definitions. -->
    <StackPanel x:Name="CanSendPanel" Visibility="Collapsed" Margin="0,0,0,12">
     <Border x:Name="CanDataCard" Background="White" BorderBrush="#E2E8E5"
      BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,11">
      <StackPanel>
       <TextBlock Text="发送报文" FontWeight="SemiBold" Foreground="#475668"
        Margin="0,0,0,8"/>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <StackPanel Margin="0,0,10,0">
         <TextBlock Text="CAN ID" FontSize="11" Foreground="#627C9D"
          Margin="0,0,0,3"/>
         <TextBox x:Name="FrameIdInput" Width="126" Height="29"
          FontFamily="Consolas" TextChanged="CanId_Changed"
          LostFocus="CanId_LostFocus"/>
        </StackPanel>
        <StackPanel Margin="0,0,10,0">
         <TextBlock Text="DLC" FontSize="11" Foreground="#627C9D"
          Margin="0,0,0,3"/>
         <TextBox x:Name="CanDlcInput" Width="43" Height="29"
          IsReadOnly="True" Background="#F2F5F9"
          FontFamily="Consolas"/>
        </StackPanel>
        <StackPanel>
         <TextBlock Text="帧格式" FontSize="11" Foreground="#627C9D"
          Margin="0,0,0,3"/>
         <TextBlock x:Name="CanFrameFormatLabel" Text="根据 CAN ID 自动识别"
          Margin="0,5,0,0" FontSize="11" Foreground="#64758C"
          ToolTip="DBC 定义优先；无 DBC 时，ID 大于 0x7FF 自动识别为扩展帧，否则默认为标准帧。"/>
        </StackPanel>
       </StackPanel>
       <TextBlock Text="DATA · 实际发送字节（HEX）" FontWeight="SemiBold"
        Foreground="#475668" FontSize="11" Margin="0,3,0,4"/>
       <TextBox x:Name="RawCanDataInput" TextChanged="CanData_Changed"
        MinHeight="31" Padding="7,4"
         HorizontalAlignment="Stretch" FontFamily="Consolas" FontSize="12"
        ToolTip="直接编辑完整报文字节，例如 00 00 00 00 00 00 00 00"/>
       <TextBlock x:Name="CanFramePreview" FontSize="10"
        Foreground="#627C9D" Margin="0,6,0,0" TextWrapping="Wrap"/>
       <TextBlock x:Name="CanPreviewIssue" FontSize="10" Foreground="#AF533D"
        Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>

     <Border Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="6"
      Padding="10" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="发送方式" FontWeight="SemiBold"
        Foreground="#475668" Margin="0,0,0,8"/>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <RadioButton x:Name="CanOnceMode" Content="单次"
         GroupName="CanSendMode" Checked="CanSendMode_Changed"
         Margin="0,0,15,0"/>
        <RadioButton x:Name="CanPeriodicMode" Content="周期"
         GroupName="CanSendMode" Checked="CanSendMode_Changed"/>
       </StackPanel>
       <StackPanel x:Name="CanPeriodicPanel" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
         <StackPanel>
          <TextBlock Text="周期 ms" FontSize="11" Foreground="#64758C"
           Margin="0,0,0,3"/>
          <TextBox x:Name="CanPeriodInput" Width="94" MinHeight="28"/>
         </StackPanel>
         <StackPanel x:Name="CanTimedDurationPanel" Visibility="Collapsed" Margin="12,0,0,0">
          <TextBlock Text="持续 ms" FontSize="11" Foreground="#64758C"
           Margin="0,0,0,3"/>
          <TextBox x:Name="CanDurationInput" Width="94" MinHeight="28"/>
         </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
         <RadioButton x:Name="CanTimedStop" Content="定时停止"
          GroupName="CanSendStop" Checked="CanStopMode_Changed"
          Margin="0,0,12,0"/>
         <RadioButton x:Name="CanUntilStopped" Content="直到停止"
          GroupName="CanSendStop" Checked="CanStopMode_Changed"/>
        </StackPanel>
        <TextBlock Text="后台周期发送；后续测试步骤继续执行"
         FontSize="11" Foreground="#526B84" Margin="0,6,0,0"
         TextWrapping="Wrap"/>
       </StackPanel>
      </StackPanel>
     </Border>
     <StackPanel Margin="0,0,0,0">
      <DockPanel Margin="0,0,0,7">
        <Button DockPanel.Dock="Right" Content="清除辅助" Click="ClearCanDbc_Click"
         Padding="9,4" MinWidth="80" ToolTip="解除 DBC 关联；保留 CAN ID、帧格式、DATA 和发送方式"/>
        <TextBlock Text="DBC 信号辅助" FontWeight="SemiBold" Foreground="#475668"
         VerticalAlignment="Center"/>
       </DockPanel>
      <testing:DbcReferencePicker x:Name="CanDbcPicker" Margin="0,0,0,6"
       ChoiceCommitted="DbcReference_ChoiceCommitted"/>
      <!-- Hidden compatibility selection state for existing StepNode transactions.
           The operator sees only the unified DBC picker above. -->
      <StackPanel Visibility="Collapsed">
       <TextBox x:Name="CanTargetSearch" TextChanged="TargetSearch_Changed"/>
       <ComboBox x:Name="CanTargetPicker" ItemsSource="{Binding AvailableTargets}"
        DisplayMemberPath="Label" SelectionChanged="TargetPicker_Changed"/>
      </StackPanel>
      <TextBlock x:Name="CanTargetHint" Foreground="#627C9D"
       TextWrapping="Wrap" FontSize="11" Margin="0,1,0,5"/>
      <Button x:Name="CanRebindButton" Content="重新绑定 DBC"
       Click="CanRebind_Click" Visibility="Collapsed"
       HorizontalAlignment="Left" Padding="7,4" Margin="0,3,0,5"/>
      <StackPanel x:Name="DbcCanPanel" Visibility="Collapsed">
       <TextBlock x:Name="DbcMessageInfo" FontSize="10" Foreground="#526B84"
        Margin="0,0,0,7" TextWrapping="Wrap"/>
       <TextBox x:Name="CanSignalSearch" TextChanged="CanSignalSearch_Changed" ToolTip="搜索信号名称或别名，不改变 DATA" MinHeight="28" Margin="0,0,0,6"/>
       <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ItemsControl x:Name="SignalGrid" ItemsSource="{Binding SignalValues}">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Grid Margin="0,0,0,5" IsEnabled="{Binding IsEditable}">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="112"/>
           </Grid.ColumnDefinitions>
           <TextBlock Text="{Binding DisplayName}" FontSize="12"
            Foreground="#475668" VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis" ToolTip="{Binding Definition}"
            Margin="0,0,8,0"/>
           <Grid Grid.Column="1">
            <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
             FontFamily="Consolas" MinHeight="27"
             ToolTip="{Binding Range}">
             <TextBox.Style><Style TargetType="TextBox">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding HasChoices}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
               </DataTrigger>
              </Style.Triggers>
             </Style></TextBox.Style>
            </TextBox>
            <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
             SelectedValuePath="Value"
             SelectedValue="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
             MinHeight="27" ToolTip="{Binding Range}">
             <ComboBox.Style><Style TargetType="ComboBox">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding HasChoices}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
               </DataTrigger>
              </Style.Triggers>
             </Style></ComboBox.Style>
            </ComboBox>
           </Grid>
          </Grid>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       </ScrollViewer>
      </StackPanel>
     </StackPanel>

    </StackPanel>

    <StackPanel x:Name="KeyPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="KEY 动作" Foreground="#627C9D" FontWeight="SemiBold"
      FontSize="11" Margin="0,0,0,6"/>

     <ComboBox x:Name="KeyActionInput" SelectionChanged="KeyAction_Changed"
      MinHeight="28" Margin="0,0,0,8">
      <ComboBoxItem Content="按下后释放" Tag="Pulse"/>
      <ComboBoxItem Content="保持按下" Tag="Hold"/>
      <ComboBoxItem Content="恢复／释放" Tag="Release"/>
     </ComboBox>
     <StackPanel x:Name="RawKeyMaskPanel" Visibility="Collapsed">
      <TextBlock Text="20 Key 组合" Foreground="#627C9D"
       FontSize="11" Margin="0,0,0,5"/>
      <TextBox x:Name="RawKeyMaskInput" IsReadOnly="True" Visibility="Collapsed" FontFamily="Consolas"
       Margin="0,0,0,8"/>
      <UniformGrid x:Name="RawKeyGrid" Columns="5" Rows="4" Margin="0,0,0,7"/>
      <Button Content="清空选择" Click="ClearRawKeys_Click"
       HorizontalAlignment="Left" Margin="0,0,0,8"/>

     </StackPanel>
     <StackPanel x:Name="KeyDurationPanel">
      <TextBlock Text="保持时间（ms）" Foreground="#627C9D" FontSize="11"
       Margin="0,0,0,5"/>
      <TextBox x:Name="KeyDurationInput" Width="150"
       HorizontalAlignment="Left"/>
     </StackPanel>
    </StackPanel>

    <StackPanel x:Name="IgnitionPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="IGN 目标状态" FontWeight="SemiBold" Foreground="#627C9D"
      FontSize="11" Margin="0,0,0,6"/>
     <ComboBox x:Name="IgnitionState">
      <ComboBoxItem Content="开启 IGN" Tag="ON"/>
      <ComboBoxItem Content="关闭 IGN" Tag="OFF"/>
     </ComboBox>
    </StackPanel>

    <ItemsControl x:Name="ParameterList" ItemsSource="{Binding ParameterFields}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="0,0,0,11">
        <TextBlock Text="{Binding Label}" Foreground="#627C9D" FontSize="11"
         FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid>
         <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
          <TextBox.Style>
           <Style TargetType="TextBox">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding HasChoices}" Value="True">
              <Setter Property="Visibility" Value="Collapsed"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBox.Style>
         </TextBox>
         <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
          SelectedValuePath="Value" SelectedValue="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          MinHeight="28" Padding="6,3">
          <ComboBox.Style>
           <Style TargetType="ComboBox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding HasChoices}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </ComboBox.Style>
         </ComboBox>
        </Grid>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border BorderBrush="#E3E9E6" BorderThickness="0,1,0,0" Margin="0,12,0,8"/>
    <StackPanel x:Name="StepActionsPanel" Visibility="Collapsed"/>

   </StackPanel>
  </ScrollViewer>
  <!-- Sticky apply/cancel at the bottom; edits stay transactional and cancellable. -->
  <Border Grid.Row="1" Background="#FAFBFB" BorderBrush="#E1E7E4"
   BorderThickness="0,1,0,0" Padding="12,8">
   <StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#C04A57" FontSize="10"
     TextWrapping="Wrap" Margin="0,0,0,7"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click"
      MinWidth="70" Margin="0,0,7,0"/>
     <Button x:Name="ConfirmButton" Content="应用"
      Style="{StaticResource AtPrimaryButton}" Click="Confirm_Click" MinWidth="92"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
