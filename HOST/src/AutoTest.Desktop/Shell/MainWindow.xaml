<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:navigation="clr-namespace:AutoTest.Desktop.Shell.Navigation"
 Title="AutoTest · ECU 工程测试工作台" Width="1460" Height="900" MinWidth="1080" MinHeight="640"
 WindowStartupLocation="CenterScreen" WindowState="Maximized" 
 PreviewKeyDown="Window_PreviewKeyDown"
 ResizeMode="CanResize" Background="{StaticResource AT.Canvas}" Foreground="{StaticResource AT.Text}"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.InputBindings>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveActiveCommand}"/>
 </Window.InputBindings>
 <Window.Resources>
  <Style x:Key="ChromeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AtQuietButton}">
   <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="Width" Value="40"/><Setter Property="Height" Value="36"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="#64758C"/>
  </Style>
  <Style x:Key="DocumentTabItem" TargetType="{x:Type TabItem}">
   <Setter Property="MinWidth" Value="100"/><Setter Property="MaxWidth" Value="220"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
     <Border x:Name="TabSurface" Height="34" Background="{TemplateBinding Background}"
      BorderBrush="#DBE3ED" BorderThickness="0,0,1,0" Padding="9,0">
      <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="TabSurface" Property="Background" Value="White"/>
       <Setter TargetName="TabSurface" Property="BorderBrush" Value="#2368BD"/>
       <Setter TargetName="TabSurface" Property="BorderThickness" Value="0,0,0,2"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="TabSurface" Property="Background" Value="#F7FBFF"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>

  </Style>
  <Style x:Key="ObservationTabItem" TargetType="{x:Type TabItem}">
   <Setter Property="Padding" Value="9,0"/><Setter Property="Height" Value="29"/>
   <Setter Property="Foreground" Value="#64758C"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
     <Border x:Name="Line" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="Line" Property="BorderBrush" Value="#2368BD"/>
       <Setter Property="Foreground" Value="#2368BD"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter TargetName="Line" Property="Background" Value="White"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Line" Property="Background" Value="#F2F7FE"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="{StaticResource AT.Canvas}">
  <Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="50"/>
   <RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>

  <!-- A single desktop-native 38px caption and IDE menu; no second OS titlebar. -->
  <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource AT.Border}"
   BorderThickness="0,0,0,1">
   <DockPanel Margin="17,0" LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#F2F6FA" CornerRadius="6" Padding="11,8" Margin="0,0,10,0">
      <TextBlock Text="{Binding HardwareStatus}" Foreground="{StaticResource AT.Muted}"
       FontSize="11" MaxWidth="225" TextTrimming="CharacterEllipsis"/>
     </Border>
     <ui:Button Content="{Binding ConnectionButtonText}" Command="{Binding ConnectHardwareCommand}"
      Margin="0,0,10,0" Padding="14,8" ToolTip="真实主控连接 / 断开"/>
     <ui:Button x:Name="ToolMenuButton" Content="工具  ▾" Appearance="Primary"
      Click="ShowToolsMenu_Click" Padding="17,8">
      <ui:Button.ContextMenu>
       <ContextMenu>
        <MenuItem Header="手动台架" Command="{Binding OpenManualBenchCommand}"/>
        <Separator/>
        <MenuItem Header="DBC 编辑" Command="{Binding OpenDbcToolCommand}"/>
        <MenuItem Header="输入模拟配置" Command="{Binding OpenControllerCommand}"/>
        <MenuItem Header="波形分析" Command="{Binding OpenWaveWorkbenchCommand}"/>
        <MenuItem Header="波形配置" Command="{Binding OpenWaveConfigCommand}"/>
        <MenuItem Header="ECU 烧录" Command="{Binding OpenFlashWorkbenchCommand}"/>
        <Separator/>
        <MenuItem Header="独立 UDS 工作台（未接入）" IsEnabled="False"/>
        <MenuItem Header="CAN 诊断观察" Command="{Binding OpenCanMonitorCommand}"/>
       </ContextMenu>
      </ui:Button.ContextMenu>
     </ui:Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AT.Accent}"
      Margin="0,0,12,0">
      <TextBlock Text="AT" FontSize="15" FontWeight="Bold" Foreground="White"
       VerticalAlignment="Center" HorizontalAlignment="Center"/>
     </Border>
     <StackPanel VerticalAlignment="Center" Margin="0,0,26,0">
      <TextBlock Text="AutoTest" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="ECU 工程测试工作台" Style="{StaticResource AT.Caption}"/>
     </StackPanel>
     <Border Width="1" Height="24" Background="{StaticResource AT.Border}" Margin="0,0,17,0"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="{Binding CurrentProjectName}" FontWeight="SemiBold"
       FontSize="13" MaxWidth="340" TextTrimming="CharacterEllipsis"
       ToolTip="{Binding CurrentProjectPath}"/>
      <TextBlock Text="{Binding SelectedConfigurationSummary}" Style="{StaticResource AT.Caption}"
       MaxWidth="405" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </StackPanel>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Background="#FBFCFE" BorderBrush="{StaticResource AT.Border}"
   BorderThickness="0,0,0,1">
   <DockPanel Margin="14,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="工程信息" Click="ShowOverview_Click" Margin="0,0,7,0"/>
     <Button Content="观察区" Click="ToggleBottom_Click" Margin="0,0,7,0"/>
     <Button Content="步骤属性" Click="ToggleInspector_Click" Margin="0,0,7,0"/>
     <Button Content="帮助" Command="{Binding HelpCommand}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="打开工程" Command="{Binding OpenProjectCommand}" Margin="0,0,7,0"/>
     <Button Content="新建工程" Command="{Binding NewProjectCommand}" Margin="0,0,9,0"/>
     <Border Height="20" Width="1" Background="{StaticResource AT.Border}" Margin="0,0,10,0"/>
     <Button Content="新建用例" Command="{Binding NewTestProgramCommand}" Margin="0,0,7,0"/>
     <Button Content="新建测试项目" Command="{Binding NewTestProjectCommand}" Margin="0,0,9,0"/>
     <Button Content="保存" Command="{Binding SaveActiveCommand}" Margin="0,0,7,0"/>
     <Button Content="撤销" Command="{Binding UndoActiveCommand}" Margin="0,0,6,0"/>
     <Button Content="重做" Command="{Binding RedoActiveCommand}" Margin="0,0,7,0"/>
     <Button Content="检查" Command="{Binding CheckActiveCommand}"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="2" Background="#F9FBFD">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="TreeColumn" Width="322" MinWidth="280" MaxWidth="510"/>
    <ColumnDefinition Width="4"/>
    <ColumnDefinition Width="*" MinWidth="520"/>
   </Grid.ColumnDefinitions>
   <navigation:ProjectExplorerView Grid.Column="0"/>
   <GridSplitter Grid.Column="1" Background="#EDF2F7" ResizeDirection="Columns"
    HorizontalAlignment="Stretch" ShowsPreview="True"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Height="35" Background="#EDF2F8"
     BorderBrush="#DBE3ED" BorderThickness="0,0,0,1"
     Visibility="{Binding HasActiveEditor,Converter={StaticResource BoolToVisibility}}">
     <DockPanel LastChildFill="True">
      <TabControl x:Name="DocumentTabs" ItemsSource="{Binding OpenEditors}"
       SelectedItem="{Binding ActiveEditorTab,Mode=TwoWay}"
       SelectionChanged="DocumentTabs_SelectionChanged"
       Background="Transparent" BorderThickness="0" Margin="0" Padding="0"
       ItemContainerStyle="{StaticResource DocumentTabItem}">
       <TabControl.Template>
        <ControlTemplate TargetType="{x:Type TabControl}">
         <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <TabPanel IsItemsHost="True" Background="Transparent" HorizontalAlignment="Left"/>
         </ScrollViewer>
        </ControlTemplate>
       </TabControl.Template>
       <TabControl.ItemTemplate>
        <DataTemplate>
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Title}" MaxWidth="190" TextTrimming="CharacterEllipsis"
           VerticalAlignment="Center" Foreground="#2C5F99" FontSize="11"/>
          <Button Content="×" Tag="{Binding}" Click="CloseEditorTab_Click"
           Width="19" Height="19" MinWidth="0" MinHeight="0"
           Padding="0" Margin="4,0,0,0" Focusable="False"
           Style="{StaticResource AtQuietButton}" ToolTip="关闭此资源页签"/>
         </StackPanel>
        </DataTemplate>
       </TabControl.ItemTemplate>
      </TabControl>
     </DockPanel>
    </Border>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="330"/>
      <ColumnDefinition x:Name="InspectorSplitterColumn" Width="4"/>
      <ColumnDefinition x:Name="InspectorColumn" Width="390" MinWidth="0" MaxWidth="560"/>
     </Grid.ColumnDefinitions>
     <Grid Grid.Column="0">
      <Grid.RowDefinitions>
       <RowDefinition Height="*" MinHeight="180"/>
       <RowDefinition x:Name="BottomSplitterRow" Height="4"/>
       <RowDefinition x:Name="BottomRow" Height="158" MinHeight="0"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="White">
       <ContentControl Content="{Binding ActiveEditorView}"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
       <!-- Only real project state decides the next action. No fake resources or persisted steps. -->
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
        MaxWidth="510" Margin="30,22"
        Visibility="{Binding NoOpenEditors,Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding StartTitle}" FontWeight="SemiBold" FontSize="18"
         Foreground="#294D79" Margin="0,0,0,9"/>
        <TextBlock Text="{Binding StartDescription}" FontSize="12" Foreground="#647A93"
         TextWrapping="Wrap" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal">
         <Button Content="{Binding StartPrimaryLabel}" Command="{Binding StartPrimaryCommand}"
          Style="{StaticResource AtPrimaryButton}" Padding="18,9" MinWidth="142" Margin="0,0,12,0"/>
         <Button Content="{Binding StartSecondaryLabel}" Command="{Binding StartSecondaryCommand}"
          Visibility="{Binding ShowStartSecondary,Converter={StaticResource BoolToVisibility}}"
          Padding="14,8" MinWidth="100"/>
        </StackPanel>
       </StackPanel>
      </Grid>
      <GridSplitter Grid.Row="1" Background="#E5ECF5" HorizontalAlignment="Stretch"
       ResizeDirection="Rows" ShowsPreview="True"/>
      <!-- HTML: bottom dock contains its tabs on the first line, not a nested native tab row. -->
      <Grid Grid.Row="2" Background="#FBFCFF">
       <TabControl BorderThickness="0" Background="#FBFCFF" FontSize="11"
        ItemContainerStyle="{StaticResource ObservationTabItem}">
        <TabControl.Template>
         <ControlTemplate TargetType="{x:Type TabControl}">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <Border Grid.Row="0" Background="#FBFCFF" BorderBrush="#DBE3ED"
            BorderThickness="0,0,0,1">
            <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
           </Border>
           <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
            ContentSource="SelectedContent"/>
          </Grid>
         </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="运行时间线">
         <DataGrid ItemsSource="{Binding ActiveEditorTab.Editor.RunFactRows}" AutoGenerateColumns="False"
          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
          RowHeaderWidth="0" RowHeight="25" BorderThickness="0">
          <DataGrid.Columns>
           <DataGridTextColumn Header="步骤" Binding="{Binding Type}" Width="105"/>
           <DataGridTextColumn Header="实际状态" Binding="{Binding Status}" Width="100"/>
           <DataGridTextColumn Header="实际数据" Binding="{Binding Actual}" Width="180"/>
           <DataGridTextColumn Header="证据／说明" Binding="{Binding Detail}" Width="*"/>
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
        <TabItem Header="CAN 事件">
         <DataGrid ItemsSource="{Binding CanRecords}" AutoGenerateColumns="False"
          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
          RowHeaderWidth="0" RowHeight="25" BorderThickness="0">
          <DataGrid.Columns>
           <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="105"/>
           <DataGridTextColumn Header="通道" Binding="{Binding Port}" Width="116"/>
           <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="85"/>
           <DataGridTextColumn Header="帧字节" Binding="{Binding Data}" Width="*"/>
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
        <TabItem Header="变量观察">
         <TextBlock Margin="13" TextWrapping="Wrap" Foreground="#64758C"
          Text="暂无真实项目级变量观察事实；仅显示运行器实际发布的数据。"/>
        </TabItem>
        <TabItem Header="问题列表">
         <TextBlock Margin="13" Foreground="#A96D20" TextWrapping="Wrap"
          Text="{Binding ActiveEditorTab.Editor.StatusMessage}"/>
        </TabItem>
        <TabItem Header="设备状态">
         <StackPanel Margin="13">
          <TextBlock Text="{Binding HardwareStatus}" Foreground="#A96D20" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ScanStatus}" Foreground="#64758C"
           TextWrapping="Wrap" Margin="0,7,0,0"/>
         </StackPanel>
        </TabItem>
       </TabControl>
       <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Width="24"
        Height="24" MinWidth="0" MinHeight="0" Margin="0,3,8,0"
        Style="{StaticResource AtQuietButton}" ToolTip="隐藏观察区"
        Click="ToggleBottom_Click"/>
      </Grid>
     </Grid>
     <GridSplitter Grid.Column="1" ResizeDirection="Columns"
      Background="#EDF2F7" HorizontalAlignment="Stretch" ShowsPreview="True"/>
     <Grid Grid.Column="2" Background="#FBFCFF">
      <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FBFCFF" BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
       <DockPanel Margin="12,0">
        <Button DockPanel.Dock="Right" Content="×" Click="ToggleInspector_Click"
         Width="24" Height="24" MinWidth="0" MinHeight="0" Style="{StaticResource AtQuietButton}"
         VerticalAlignment="Center" ToolTip="隐藏属性"/>
        <TextBlock Text="{Binding InspectorHeading}" FontSize="12" FontWeight="SemiBold"
         VerticalAlignment="Center"/>
       </DockPanel>
      </Border>
      <ContentControl Grid.Row="1" Content="{Binding ActiveEditorInspector}"
       HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     </Grid>
    </Grid>
   </Grid>
  </Grid>

  <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource AT.Border}" BorderThickness="0,1,0,0">
   <DockPanel Margin="11,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding HardwareStatus}" Foreground="White"
      FontSize="10" VerticalAlignment="Center" Margin="0,0,13,0"/>
     <TextBlock Text="扫码" Foreground="{StaticResource AT.Muted}" FontSize="10"
      VerticalAlignment="Center" Margin="0,0,4,0"/>
     <TextBox x:Name="ScannerEntry" Width="94" Height="20" MinHeight="0" Padding="4,0"
      FontSize="10" VerticalContentAlignment="Center" Margin="0,0,8,0"
      ToolTip="扫码枪键盘输入；按 Enter 完成匹配，不自动触发生产执行"
      PreviewTextInput="ScannerEntry_TextInput" PreviewKeyDown="ScannerEntry_KeyDown"/>
     <Button Content="观察" Click="ToggleBottom_Click"
      Foreground="White" Background="Transparent" BorderThickness="0"
      MinWidth="38" MinHeight="20" Height="20" Padding="2,0" FontSize="10" Margin="0,0,3,0"/>
     <Button Content="属性" Click="ToggleInspector_Click"
      Foreground="White" Background="Transparent" BorderThickness="0"
      MinWidth="38" MinHeight="20" Height="20" Padding="2,0" FontSize="10" Margin="0"/>
    </StackPanel>
    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AT.Muted}" FontSize="11"
     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
