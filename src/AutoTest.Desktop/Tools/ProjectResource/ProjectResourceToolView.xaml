<UserControl x:Class="AutoTest.Desktop.Tools.ProjectResource.ProjectResourceToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="1100" MinHeight="720">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="270"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="PROJECT / 资源工作台 · R0-LAB" FontWeight="Bold" FontSize="19"/>
      <TextBlock Text="仅本地工程资源。无 USB/CAN 连接、无物理输出授权；修订与设备状态互不代表。" Foreground="DarkGoldenrod" Margin="0,3,0,9"/>
      <WrapPanel>
        <TextBlock Text="工程 manifest" VerticalAlignment="Center"/>
        <TextBox Width="480" Text="{Binding ProjectFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,8,0"/>
        <TextBlock Text="名称" VerticalAlignment="Center"/>
        <TextBox Width="145" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,8,0"/>
        <Button Content="新建" Command="{Binding CreateProjectCommand}" Padding="10,4"/>
        <Button Content="打开" Command="{Binding OpenProjectCommand}" Margin="5,0" Padding="10,4"/>
        <Button Content="重新核验" Command="{Binding VerifyAssetsCommand}" Padding="10,4"/>
      </WrapPanel>
      <TextBlock Text="{Binding ProjectSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,9"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
      <TextBlock Text="导入源文件" VerticalAlignment="Center"/>
      <TextBox Width="365" Text="{Binding ImportFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,8,0"/>
      <ComboBox Width="110" ItemsSource="{Binding ResourceKinds}" SelectedItem="{Binding ResourceKind}" Margin="0,0,8,0"/>
      <TextBox Width="170" Text="{Binding ResourceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="资源显示名称"/>
      <Button Content="导入到工程" Command="{Binding ImportResourceCommand}" Padding="9,4"/>
      <TextBox Width="130" Text="{Binding NewResourceName, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,5,0" ToolTip="新资源名称"/>
      <Button Content="重命名" Command="{Binding RenameResourceCommand}" Padding="9,4"/>
      <Button Content="从工程解绑" Command="{Binding UnlinkResourceCommand}" Margin="5,0" Padding="9,4" ToolTip="保留磁盘文件；有任何工程引用时拒绝解绑"/>
    </WrapPanel>
    <GroupBox Grid.Row="2" Header="工程资源清单 · 由 manifest 的 AssetId/Revision/Hash 唯一标识" Margin="0,0,0,7">
      <DockPanel Margin="5">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
          <TextBlock Text="{Binding SelectedAssetDetails}" TextWrapping="Wrap"/>
          <Button Content="复制选中资源绝对路径" Command="{Binding CopyAssetPathCommand}" HorizontalAlignment="Left" Padding="8,4" Margin="0,5,0,0"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="类型" Binding="{Binding Asset.Kind}" Width="105"/>
            <DataGridTextColumn Header="名称" Binding="{Binding Asset.Name}" Width="145"/>
            <DataGridTextColumn Header="Revision" Binding="{Binding Asset.Revision}" Width="80"/>
            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120"/>
            <DataGridTextColumn Header="资源路径" Binding="{Binding Asset.RelativePath}" Width="*"/>
            <DataGridTextColumn Header="AssetId" Binding="{Binding Asset.Id.Value}" Width="260"/>
            <DataGridTextColumn Header="SHA256" Binding="{Binding Asset.Sha256}" Width="260"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </GroupBox>
    <GroupBox Grid.Row="3" Header="操作时间线 / 原始资源校验证据 · SOFTWARE_ONLY">
      <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Top">
          <WrapPanel>
            <TextBlock Text="诊断导出 JSONL" VerticalAlignment="Center"/>
            <TextBox Width="320" Text="{Binding TraceFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,8,0"/>
            <Button Content="导出完整日志" Command="{Binding ExportTraceCommand}" Padding="8,4"/>
            <Button Content="复制过滤结果" Command="{Binding CopyVisibleTraceCommand}" Margin="5,0" Padding="8,4"/>
            <CheckBox Content="脱敏本机路径" IsChecked="{Binding RedactTracePaths}" VerticalAlignment="Center" Margin="8,0"/>
            <CheckBox Content="保留 RawHex" IsChecked="{Binding IncludeRawTraceHex}" VerticalAlignment="Center"/>
          </WrapPanel>
          <WrapPanel Margin="0,5,0,5">
            <TextBlock Text="过滤" VerticalAlignment="Center"/>
            <TextBox Width="170" Margin="5,0,10,0" Text="{Binding TraceFilter, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding TraceQuality}" VerticalAlignment="Center"/>
          </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding VisibleTraceEvents}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="UTC" Binding="{Binding TimestampUtc}" Width="165"/>
            <DataGridTextColumn Header="操作阶段" Binding="{Binding Stage}" Width="135"/>
            <DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="100"/>
            <DataGridTextColumn Header="错误码" Binding="{Binding ErrorCode}" Width="155"/>
            <DataGridTextColumn Header="预期" Binding="{Binding Expected}" Width="190"/>
            <DataGridTextColumn Header="实际" Binding="{Binding Actual}" Width="190"/>
            <DataGridTextColumn Header="原始证据" Binding="{Binding Detail}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </GroupBox>
  </Grid>
</UserControl>