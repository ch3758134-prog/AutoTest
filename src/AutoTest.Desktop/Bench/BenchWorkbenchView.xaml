<UserControl x:Class="AutoTest.Desktop.Bench.BenchWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource StudioBg}" Foreground="{DynamicResource StudioText}" FontFamily="Segoe UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVis"/>
  <SolidColorBrush x:Key="Ink" Color="#23374D"/>
  <SolidColorBrush x:Key="Muted" Color="#657D95"/>
  <SolidColorBrush x:Key="Rule" Color="#DCE5EF"/>
  
  
  
  
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="KeySwitch" TargetType="CheckBox">
   <Setter Property="Margin" Value="4"/>
   <Setter Property="Padding" Value="9,7"/>
   <Setter Property="Foreground" Value="#29435D"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  
  
  
 </UserControl.Resources>

 <Grid Margin="15">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="450"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="连接主控" Click="OpenStation_Click"
     ToolTip="打开共用的真实 WinUSB 主控连接窗口；本手动台架不会创建第二条 USB 会话"/>
    <Button Content="刷新状态/工程" Command="{Binding RefreshCommand}" Margin="0"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="手动台架" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="左侧选择和发送 CAN 报文 · 中间点击按键动作 · 右侧观察 ECU CAN 广播"
     Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="12,10">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="1.2*"/>
     <ColumnDefinition Width="1.2*"/>
     <ColumnDefinition Width="1.5*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="主控设备" FontSize="11" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{Binding ConnectionStatus}" FontSize="15" FontWeight="SemiBold"
      Margin="0,5,0,2"/>
     <TextBlock Text="{Binding DeviceIdentity}" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding DeviceIdentity}" FontSize="11" Foreground="{StaticResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="10,0,0,0">
     <TextBlock Text="当前工程" FontSize="11" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{Binding ProjectName}" FontSize="13" FontWeight="SemiBold"
      Margin="0,5,0,2" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Revision, StringFormat=Revision {0}}" FontSize="11"
      Foreground="{StaticResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Margin="10,0,0,0">
     <TextBlock Text="连接状态说明" FontSize="11" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{Binding ConnectionDetail}" TextWrapping="Wrap" FontSize="11"
      Foreground="#57718B" Margin="0,5,0,0" MaxHeight="47"/>
    </StackPanel>
   </Grid>
  </Border>


  <!-- One workstation: CAN transmit | direct 20-Key / IGN | DUT CAN receive. -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="40*" MinWidth="330"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="33*" MinWidth="315"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="35*" MinWidth="330"/>
   </Grid.ColumnDefinitions>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
    Background="#DFE8F1" ResizeDirection="Columns" ShowsPreview="True"/>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
    Background="#DFE8F1" ResizeDirection="Columns" ShowsPreview="True"/>

   <!-- LEFT: a single coherent CAN1 transmit workbench: add/choose/edit/send. -->
   <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="11">
    <Grid DataContext="{Binding CanMessages}">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="235"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

     <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <DockPanel Margin="0,0,0,8">
       <TextBlock DockPanel.Dock="Right" Text="{Binding SendModeStatus}"
        Foreground="#176AB2" FontSize="11" VerticalAlignment="Center"
        TextAlignment="Right" Margin="8,0,0,0"/>
       <TextBlock Text="CAN 报文发送" FontSize="17" FontWeight="SemiBold"
        VerticalAlignment="Center"/>
      </DockPanel>
      <WrapPanel Margin="0,0,0,6">
       <Button Content="＋ 从 DBC 选择报文" Click="ChooseDbcCanMessage_Click"
        Background="#E6F1FC" Foreground="#155F9E" FontWeight="SemiBold"
        ToolTip="从当前工程已导入的 DBC 中按报文名称或 CAN ID 选择，然后加入下方发送表"/>
       <Button Content="＋ 原始报文" Command="{Binding AddCommand}"
        ToolTip="创建一条可直接编辑 ID 和十六进制 Data 的报文"/>
       <Button Content="DBC 管理" Click="OpenDbc_Click"
        ToolTip="导入或修改当前工程的 DBC，返回后即可选报文"/>
       <Button Content="删除行" Command="{Binding DeleteCommand}"
        Margin="0" ToolTip="删除当前选中的发送报文"/>
      </WrapPanel>
      <WrapPanel Margin="0,0,0,6">
       <Button Content="▶ 发送勾选报文" Command="{Binding StartPeriodicCommand}"
        IsEnabled="{Binding CanEdit}" Background="#176AB2" Foreground="White"
        FontWeight="SemiBold" ToolTip="按各行的独立周期向真实 DUT CAN1 发送所有勾选行；停止前一直发送"/>
       <Button Content="■ 停止发送" Command="{Binding StopPeriodicCommand}"
        IsEnabled="{Binding IsPeriodicRunning}"
        Background="#FFF0ED" Foreground="#A74541"
        ToolTip="停止本次已勾选报文的所有周期发送；不会自动修改报文数据"/>
       <Button Content="单发选中行" Command="{Binding SendOnceCommand}"
        IsEnabled="{Binding CanEdit}" ToolTip="当前选中的一行仅发送一次"/>
       <Button Content="保存发送表" Command="{Binding SaveCommand}"
        IsEnabled="{Binding CanEdit}" Margin="0"
        ToolTip="保存当前报文表到工程；现场试发可先不保存"/>
      </WrapPanel>
      <TextBlock Text="{Binding DbcStatus}" FontSize="11" Foreground="#607B94"
       TextWrapping="Wrap" Margin="0,1,0,3"/>
      <TextBlock Text="左侧勾选要周期发送的报文；先编辑 ID / Data / 周期，再点击“发送勾选报文”。"
       FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
     </StackPanel>

     <DataGrid x:Name="TransmitGrid" Grid.Row="1" ItemsSource="{Binding Messages}"
      SelectedItem="{Binding SelectedMessage,Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
      HeadersVisibility="Column" RowHeaderWidth="0" Margin="0,0,0,8"
      ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionUnit="FullRow">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="发" Width="35">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding IsChecked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           VerticalAlignment="Center" HorizontalAlignment="Center"
           ToolTip="勾选此行：参与周期发送；未勾选不发送"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="报文名称" Width="95"
        Binding="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="CAN ID" Width="81"
        Binding="{Binding CanIdHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridCheckBoxColumn Header="扩展" Width="46"
        Binding="{Binding Extended,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="DATA (HEX)" Width="136"
        Binding="{Binding DataHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="周期 ms" Width="67"
        Binding="{Binding PeriodMsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="来源" Width="53" IsReadOnly="True"
        Binding="{Binding SourceLabel}"/>
      </DataGrid.Columns>
     </DataGrid>

     <!-- Signal editing is part of the chosen transmit row, not a permanent
          unrelated empty table: collapse entirely when editing raw CAN. -->
     <Border Grid.Row="2" BorderBrush="{StaticResource Rule}" BorderThickness="1"
      Visibility="{Binding HasDbcSignals,Converter={StaticResource BoolVis}}"
      CornerRadius="5" Padding="9" Background="#FAFCFF"
      Margin="0,0,0,7">
      <Grid Height="192">
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
       </Grid.RowDefinitions>
       <DockPanel Grid.Row="0" Margin="0,0,0,5">
        <Button DockPanel.Dock="Right" Content="改为原始报文"
         Command="{Binding UnbindDbcCommand}" Margin="0" Padding="6,3"
         MinHeight="25" ToolTip="解除工程 DBC 绑定，保留当前十六进制 CAN 数据"/>
        <TextBlock Text="当前 DBC 报文 · 信号值" FontWeight="SemiBold"
         FontSize="13" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Grid.Row="1" Text="{Binding SignalStatus}" Foreground="#536F89"
        FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
       <DataGrid Grid.Row="2" ItemsSource="{Binding SignalInputs}"
        AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
        IsEnabled="{Binding CanEdit}" HeadersVisibility="Column" RowHeaderWidth="0">
        <DataGrid.Columns>
         <DataGridTextColumn Header="信号名称" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>
         <DataGridTextColumn Header="物理值" Width="100"
          Binding="{Binding ValueText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
         <DataGridTextColumn Header="单位" Width="58" Binding="{Binding Unit}" IsReadOnly="True"/>
        </DataGrid.Columns>
       </DataGrid>
      </Grid>
     </Border>

     <StackPanel Grid.Row="3" Margin="0,3,0,0">
      <TextBlock Text="{Binding SelectedSourceLabel}" FontSize="11"
       Foreground="#536F89" TextWrapping="Wrap" Margin="0,0,0,3"/>
      <TextBlock Text="{Binding Status}" FontSize="11"
       TextWrapping="Wrap" Foreground="#607992" Margin="0,0,0,3"/>
      <TextBlock Text="{Binding PeriodicStatus}" FontSize="11"
       TextWrapping="Wrap" Foreground="#8B6733"/>
     </StackPanel>
    </Grid>
   </Border>

   <!-- CENTER: named action buttons are the operation surface, NOT a step editor. -->
   <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="11">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="250"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid Grid.Row="0">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,6">
       <Button DockPanel.Dock="Right" Content="+ 新建动作"
        Click="CreateKeyAction_Click" Margin="8,0,0,0"
        Background="#176AB2" Foreground="White" FontWeight="SemiBold"/>
       <TextBlock Text="按键动作" FontSize="17" FontWeight="SemiBold"
        VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Grid.Row="1" FontSize="11" TextWrapping="Wrap"
       Foreground="{StaticResource Muted}" Margin="0,0,0,9"
       Text="左键点击按钮试运行对应动作；右键编辑、重命名、复制或删除。执行真实动作前需要确认。"/>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
       HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,7">
       <ItemsControl ItemsSource="{Binding KeyActions.Actions}">
        <ItemsControl.ItemsPanel>
         <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="172" ItemHeight="84"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Button Click="KeyActionTile_Click" Margin="3" Height="76" Width="164" Padding="8,9"
           HorizontalAlignment="Left" VerticalAlignment="Top"
           HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
           ToolTip="左键：试运行此动作（需确认）；右键：编辑、重命名、复制或删除">
           <Button.Style>
            <Style TargetType="Button">
             <Setter Property="Background" Value="#F6F9FD"/>
             <Setter Property="Foreground" Value="#23374D"/>
             <Setter Property="BorderBrush" Value="#C7D7E7"/>
             <Setter Property="BorderThickness" Value="1"/>
             <Setter Property="Cursor" Value="Hand"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
               <Setter Property="Background" Value="#E4F0FE"/>
               <Setter Property="BorderBrush" Value="#176AB2"/>
               <Setter Property="BorderThickness" Value="2"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
               <Setter Property="BorderBrush" Value="#176AB2"/>
              </Trigger>
             </Style.Triggers>
            </Style>
           </Button.Style>
           <Button.ContextMenu>
            <ContextMenu>
             <MenuItem Header="执行动作" Click="KeyActionMenu_Run_Click"/>
             <MenuItem Header="编辑动作" Click="KeyActionMenu_Edit_Click"/>
             <MenuItem Header="重命名" Click="KeyActionMenu_Rename_Click"/>
             <MenuItem Header="复制动作" Click="KeyActionMenu_Copy_Click"/>
             <Separator/>
             <MenuItem Header="删除动作" Click="KeyActionMenu_Delete_Click"/>
            </ContextMenu>
           </Button.ContextMenu>
           <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
             TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Steps.Count,StringFormat=共 {0} 个步骤}"
             Foreground="#69829B" FontSize="11" Margin="0,6,0,0" TextAlignment="Center"/>
           </StackPanel>
          </Button>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="还没有按键动作。点击右上角“+ 新建动作”，动作就会作为按钮出现在这里。"
       HorizontalAlignment="Center" VerticalAlignment="Center"
       TextAlignment="Center" TextWrapping="Wrap" FontSize="13"
       Foreground="#7A8FA5" Margin="14">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Setter Property="Visibility" Value="Collapsed"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding KeyActions.Actions.Count}" Value="0">
           <Setter Property="Visibility" Value="Visible"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
      <StackPanel Grid.Row="3">
       <WrapPanel Margin="0,0,0,5">
        <Button Content="编辑选中动作" Click="EditSelectedKeyAction_Click"/>
        <Button Content="停止动作" Command="{Binding KeyActions.StopActionCommand}"
         Foreground="#A74541" Background="#FFF1EC" Margin="0"/>
       </WrapPanel>
       <WrapPanel Margin="0,0,0,5">
        <Button Content="保存动作配置" Command="{Binding KeyActions.SaveActionsCommand}"/>
        <Button Content="重新加载" Click="ReloadKeyActions_Click"/>
        <Button Content="释放全部真实按键" Command="{Binding ReleaseAllKeysCommand}"
         Foreground="#A74541" Background="#FFF1EC" Margin="0"/>
       </WrapPanel>
       <TextBlock Text="{Binding KeyActions.Status}" FontSize="11"
        Foreground="#536F89" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding KeyActions.Progress}" FontSize="11"
        Foreground="#8B6733" TextWrapping="Wrap" Margin="0,3,0,0"/>
      </StackPanel>
     </Grid>

     <!-- Separate hardware controls do not belong inside an action sequence. -->
     <Border Grid.Row="1" BorderBrush="{StaticResource Rule}" BorderThickness="1"
      CornerRadius="5" Background="#F6F9FC" Padding="9" Margin="0,10,0,0">
      <StackPanel>
       <TextBlock Text="其他设备控制" FontSize="14" FontWeight="SemiBold"/>
       <WrapPanel Margin="0,7,0,3">
        <TextBlock Text="IGN" VerticalAlignment="Center" FontWeight="SemiBold"
         Margin="0,0,9,0"/>
        <Button Content="打开" Command="{Binding IgnOnCommand}"
         Foreground="#146A4D" Background="#E7F5ED" Padding="9,4"/>
        <Button Content="关闭" Command="{Binding IgnOffCommand}"
         Foreground="#A44835" Background="#FFF3EF" Padding="9,4" Margin="0"/>
       </WrapPanel>
       <TextBlock Text="{Binding IgnStatus}" FontSize="10"
        TextWrapping="Wrap" Foreground="#536F89" Margin="0,0,0,4"/>
       <WrapPanel Margin="0,3,0,4">
        <TextBlock Text="夹具电磁阀" VerticalAlignment="Center" FontWeight="SemiBold"
         Margin="0,0,9,0"/>
        <Button Content="升起" Command="{Binding SolenoidRaiseCommand}" Padding="9,4"/>
        <Button Content="下落" Command="{Binding SolenoidLowerCommand}" Padding="9,4"/>
        <Button Content="读取状态" Command="{Binding SolenoidReadCommand}"
         Padding="9,4" Margin="0"/>
       </WrapPanel>
       <TextBlock Text="{Binding SolenoidStatus}" FontSize="10"
        TextWrapping="Wrap" Foreground="#536F89"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>

   <!-- RIGHT: DUT CAN1 broadcasts, not USB command/operator logs. -->
   <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="11">
    <Grid DataContext="{Binding CanMonitor}">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="ECU CAN 接收日志" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="实时显示被测 ECU 在 CAN1 广播的调试报文"
       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,6"/>
      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#536F89"
       TextWrapping="Wrap"/>
     </StackPanel>
     <WrapPanel Grid.Row="1" Margin="0,0,0,7">
      <TextBlock Text="CAN ID" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <TextBox Width="92" Text="{Binding FilterId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       Margin="0,0,6,0" ToolTip="输入报文 ID 进行筛选"/>
      <Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"
       Padding="7,4"/>
      <Button Content="清空" Command="{Binding ClearCommand}" Padding="7,4" Margin="0"/>
     </WrapPanel>
     <TabControl Grid.Row="2">
      <TabItem Header="按 ID 实时刷新">
       <DataGrid ItemsSource="{Binding IdView}" AutoGenerateColumns="False"
        IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
        RowHeaderWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
         <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="74"/>
         <DataGridTextColumn Header="数据 HEX" Binding="{Binding Data}" Width="*"/>
         <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="55"/>
         <DataGridTextColumn Header="最近时间" Binding="{Binding LastAt,StringFormat={}{0:HH:mm:ss.fff}}" Width="94"/>
        </DataGrid.Columns>
       </DataGrid>
      </TabItem>
      <TabItem Header="原始接收流水">
       <DataGrid ItemsSource="{Binding HistoryView}" AutoGenerateColumns="False"
        IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
        RowHeaderWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
         <DataGridTextColumn Header="时间" Binding="{Binding ReceivedAt,StringFormat={}{0:HH:mm:ss.fff}}" Width="92"/>
         <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="74"/>
         <DataGridTextColumn Header="数据 HEX" Binding="{Binding Data}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
      </TabItem>
     </TabControl>
     <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <WrapPanel>
       <TextBlock Text="{Binding Received,StringFormat=收到 {0} 帧}" Margin="0,0,12,0"/>
       <TextBlock Text="{Binding DisplayDropped,StringFormat=显示丢弃 {0}}" Margin="0,0,12,0"/>
      </WrapPanel>
      <WrapPanel Margin="0,4,0,0">
       <TextBlock Text="{Binding PausedSkipped,StringFormat=暂停未显示 {0}}" Margin="0,0,12,0"/>
       <TextBlock Text="{Binding DeviceDropped,StringFormat=设备丢帧 {0}}"/>
      </WrapPanel>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>