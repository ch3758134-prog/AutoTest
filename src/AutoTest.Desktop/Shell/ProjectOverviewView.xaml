<UserControl x:Class="AutoTest.Desktop.Shell.ProjectOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
  <StackPanel Margin="18,15">
   <DockPanel Margin="0,0,0,13">
    <Button DockPanel.Dock="Right" Content="新建测试工程" Command="{Binding NewProjectCommand}"
     Padding="9,4" FontSize="11"/>
    <TextBlock Text="工程工作区" FontSize="16" FontWeight="SemiBold"
     VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock Text="{Binding CurrentProjectName}" FontWeight="SemiBold" Foreground="#2368BD" FontSize="13"
    Margin="0,0,0,4"/>
   <TextBlock Text="{Binding CurrentProjectPath}" Foreground="#64758C" FontSize="10"
    TextWrapping="Wrap" Margin="0,0,0,14"/>
   <UniformGrid Columns="3" Margin="0,0,0,16">
    <Button Command="{Binding OpenFirstTestProjectCommand}" Height="127"
     Background="#FBFCFF" BorderBrush="#DBE3ED" Padding="9" Margin="0,0,9,0"
     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
     <StackPanel Margin="6">
      <TextBlock Text="▣  测试项目" Foreground="#64758C" FontSize="11" Margin="0,0,0,11"/>
      <TextBlock Text="{Binding TestProjectCount,StringFormat='{}{0} 个'}" FontSize="23" FontWeight="SemiBold"
       Foreground="#2368BD" Margin="0,0,0,7"/>
      <TextBlock Text="组织有序用例，勾选本次运行" Foreground="#64758C" FontSize="11" TextWrapping="Wrap"/>
     </StackPanel>
    </Button>
    <Button Command="{Binding OpenFirstTestProgramCommand}" Height="127"
     Background="#FBFCFF" BorderBrush="#DBE3ED" Padding="9" Margin="0,0,9,0"
     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
     <StackPanel Margin="6">
      <TextBlock Text="▤  测试用例" Foreground="#64758C" FontSize="11" Margin="0,0,0,11"/>
      <TextBlock Text="{Binding TestProgramCount,StringFormat='{}{0} 个'}" FontSize="23" FontWeight="SemiBold"
       Foreground="#2368BD" Margin="0,0,0,7"/>
      <TextBlock Text="准备／测试／清理与步骤属性" Foreground="#64758C" FontSize="11" TextWrapping="Wrap"/>
     </StackPanel>
    </Button>
    <Button Command="{Binding OpenFirstConfigurationCommand}" Height="127"
     Background="#FBFCFF" BorderBrush="#DBE3ED" Padding="9"
     HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
     <StackPanel Margin="6">
      <TextBlock Text="⚙  工程配置" Foreground="#64758C" FontSize="11" Margin="0,0,0,11"/>
      <TextBlock Text="{Binding ConfigurationCount,StringFormat='{}{0} 项资源'}" FontSize="23"
       FontWeight="SemiBold" Foreground="#2368BD" Margin="0,0,0,7"/>
      <TextBlock Text="DUT、DBC、TCF/TBC 与资源" Foreground="#64758C" FontSize="11" TextWrapping="Wrap"/>
     </StackPanel>
    </Button>
   </UniformGrid>
   <TextBlock Text="常用操作" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,9"/>
   <WrapPanel Margin="0,0,0,16">
    <Button Content="＋ 新建测试项目" Command="{Binding NewTestProjectCommand}" Margin="0,0,7,7"/>
    <Button Content="＋ 新建测试用例" Command="{Binding NewTestProgramCommand}" Margin="0,0,7,7"/>
    <Button Content="导入 DBC 数据库" Command="{Binding ImportDbcCommand}" Margin="0,0,7,7"/>
    <Button Content="打开 CAN 监视" Command="{Binding OpenCanMonitorCommand}" Margin="0,0,7,7"/>
   </WrapPanel>
   <Border BorderBrush="#DBE3ED" BorderThickness="1" Background="#F9FBFF" CornerRadius="5" Padding="12">
    <StackPanel>
     <TextBlock Text="真实工程状态" FontWeight="SemiBold" Margin="0,0,0,7"/>
     <TextBlock Text="{Binding SelectedConfigurationSummary}" Foreground="#64758C"
      TextWrapping="Wrap" Margin="0,0,0,6"/>
     <TextBlock Text="{Binding HardwareStatus}" Foreground="#A96D20"
      TextWrapping="Wrap" Margin="0,0,0,5"/>
     <TextBlock Text="本工作区仅以实际工程资产为数据源；未执行 ECU、未产生测试结论。"
      Foreground="#64758C" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
