<Window x:Class="AutoTest.Desktop.Shell.ManualBenchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AutoTest.Desktop.Shell"
 Title="AutoTest · 手动台架" Width="1360" Height="840" MinWidth="1080" MinHeight="650"
 WindowStartupLocation="CenterOwner" WindowState="Maximized" Background="#F5F8FC"
 FontFamily="{StaticResource UiFont}" FontSize="12"
 Foreground="#223A57">
 <Window.Resources>
  <Style x:Key="BenchSectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#294D77"/>
   <Setter Property="Margin" Value="0,0,0,9"/>
  </Style>
  <Style x:Key="BenchFieldLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="#617B98"/>
   <Setter Property="Margin" Value="0,9,0,4"/>
  </Style>
  <Style x:Key="BenchCard" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DAE4F0"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="7"/>
   <Setter Property="Padding" Value="15"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style x:Key="BenchKeyChoice" TargetType="CheckBox">
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Padding" Value="8,7"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="BorderBrush" Value="#D7E4F2"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="65"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="39"/>
  </Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#D7E3F1" BorderThickness="0,0,0,1">
   <DockPanel Margin="17,10" LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="连接／断开" Command="{Binding ConnectCommand}"
     Style="{StaticResource AtPrimaryButton}" Margin="12,0,0,0" MinWidth="94"/>
    <Button DockPanel.Dock="Right" Content="刷新工程配置" Command="{Binding ReloadProfilesCommand}"
     Margin="10,0,0,0"/>
    <StackPanel>
     <TextBlock Text="手动台架 · 真实操作" FontSize="17" FontWeight="SemiBold" Foreground="#214B7D"/>
     <TextBlock Text="{Binding ConnectionStatus}" Foreground="#6C8198" Margin="0,4,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="13,13,3,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="328" MinWidth="286"/>
    <ColumnDefinition Width="455" MinWidth="380"/>
    <ColumnDefinition Width="*" MinWidth="340"/>
   </Grid.ColumnDefinitions>

   <!-- CAN1: actual DUT traffic, explicit single-frame authorization. -->
   <Border Style="{StaticResource BenchCard}" Grid.Column="0">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="CAN1 · DUT 发送" Style="{StaticResource BenchSectionTitle}"/>
      <TextBlock Text="发送真实 CAN 帧；操作需明确确认。USB ACK 不代表 DUT 收到。"
       TextWrapping="Wrap" Foreground="#72869D" FontSize="11"/>
      <CheckBox Content="使用工程 DBC 报文与物理信号" IsChecked="{Binding UseDbcMessage,Mode=TwoWay}"
       Margin="0,12,0,4"/>
      <StackPanel Visibility="{Binding UseDbcMessage,Converter={StaticResource BoolToVisibility}}">
       <TextBlock Text="DBC 报文（来自当前工程）" Style="{StaticResource BenchFieldLabel}"/>
       <ComboBox ItemsSource="{Binding DbcMessages}"
        SelectedItem="{Binding SelectedDbcMessage,Mode=TwoWay}" DisplayMemberPath="Display"
        MinHeight="30" ToolTip="DBC 数据按资源 Revision/SHA 验证后读取"/>
       <TextBlock Text="逐路输入完整物理信号值，编码遵循 DBC 位序、比例及取值范围"
        Foreground="#72869D" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,5"/>
       <ItemsControl ItemsSource="{Binding DbcSignals}">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <StackPanel Margin="0,0,0,7">
           <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Range}" FontSize="10"
             Foreground="#8798AA" VerticalAlignment="Center" Margin="6,0,0,0"/>
            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
           </DockPanel>
           <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            ToolTip="{Binding Range}" Padding="6,5" Margin="0,4,0,0"/>
          </StackPanel>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <StackPanel Visibility="{Binding IsRawCanMode,Converter={StaticResource BoolToVisibility}}">
       <TextBlock Text="CAN 报文 ID（十六进制）" Style="{StaticResource BenchFieldLabel}"/>
       <TextBox Text="{Binding CanIdHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Height="29" Padding="7,5"/>
       <CheckBox Content="扩展帧（29 bit）" IsChecked="{Binding Extended,Mode=TwoWay}"
        Margin="0,11,0,0"/>
       <TextBlock Text="数据字节（HEX，0–8 字节）" Style="{StaticResource BenchFieldLabel}"/>
       <TextBox Text="{Binding CanDataHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Padding="7,7" MinHeight="32" TextWrapping="Wrap" AcceptsReturn="False"/>
      </StackPanel>
      <TextBlock Text="需确认的完整 CAN 帧" Style="{StaticResource BenchFieldLabel}"/>
      <TextBox Text="{Binding CanExpectedConsent}" TextWrapping="Wrap" IsReadOnly="True"
       FontSize="10" Foreground="#55708C" Padding="7,7" MinHeight="64"/>
      <Button Content="复制确认文字" Click="CopyCanConfirmation_Click"
       Margin="0,6,0,0" HorizontalAlignment="Left"/>
      <TextBlock Text="粘贴或输入上述完整确认文字" Style="{StaticResource BenchFieldLabel}"/>
      <TextBox Text="{Binding CanConfirmation,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       MinHeight="34" Padding="7,6"/>
      <Button Content="发送一次 CAN1 帧" Command="{Binding SendCanCommand}"
       Style="{StaticResource AtPrimaryButton}" Margin="0,14,0,0"
       IsEnabled="{Binding CanSendHardware}" Height="34"/>
      <Border BorderBrush="#E5EDF6" BorderThickness="0,1,0,0" Margin="0,19,0,14"/>
      <TextBlock Text="操作说明" Style="{StaticResource BenchSectionTitle}"/>
      <TextBlock Text="CAN1 用于被测 ECU，CAN0 固定连接 KEY_SIM。连接或重连不会自动发送任何报文；断开也不会自动释放按键，请确认台架实际电气状态。"
       Foreground="#71869C" TextWrapping="Wrap"/>
     </StackPanel>
    </ScrollViewer>
   </Border>

   <!-- KEY_SIM 20 resistor switches; a draft is not a physical state. -->
   <Border Style="{StaticResource BenchCard}" Grid.Column="1">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="工位操作 · KEY_SIM / IGN / 夹具" Style="{StaticResource BenchSectionTitle}"/>
      <TextBlock Text="{Binding ControllerSummary}" Foreground="#6B819B"
       TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
      <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile,Mode=TwoWay}"
       MinHeight="29" ToolTip="选择工程中真实的 Controller 配置"/>
      <TextBlock Text="已定义的 ECU 功能动作（选择后填充 20 Key 组合）"
       Style="{StaticResource BenchFieldLabel}"/>
      <ItemsControl ItemsSource="{Binding NamedOperations}">
       <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
       </ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Content="{Binding Display}" Tag="{Binding}" Click="SelectNamedOperation_Click"
          Margin="0,0,5,5" Padding="8,5" ToolTip="仅选择配置的组合；不会自动下发"/>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border BorderBrush="#E5EDF6" BorderThickness="0,1,0,0" Margin="0,9,0,10"/>
      <DockPanel Margin="0,0,0,8">
       <Button DockPanel.Dock="Right" Content="选择全部释放" Command="{Binding ReleaseKeysCommand}"/>
       <TextBlock Text="{Binding DraftMaskLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
      </DockPanel>
      <TextBlock Text="20 路 Key 为电阻网络开关，合成五路模拟电压；不是 20 路独立 ECU 数字输入。"
       FontSize="11" Foreground="#6D849C" TextWrapping="Wrap" Margin="0,0,0,7"/>
      <ItemsControl ItemsSource="{Binding Keys}">
       <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
       </ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked,Mode=TwoWay}"
          Style="{StaticResource BenchKeyChoice}" ToolTip="只改变待发送掩码，不自动操作硬件"/>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding LastKeyAck}" FontSize="11" Foreground="#607B99"
       TextWrapping="Wrap" Margin="2,9,0,0"/>
      <TextBlock Text="CAN0 单帧授权文字" Style="{StaticResource BenchFieldLabel}"/>
      <TextBox Text="{Binding KeyExpectedConsent}" IsReadOnly="True"
       TextWrapping="Wrap" Padding="7,6" FontSize="10" MinHeight="48"/>
      <DockPanel Margin="0,6,0,0">
       <Button DockPanel.Dock="Right" Content="复制" Click="CopyKeyConfirmation_Click"
        Margin="6,0,0,0"/>
       <TextBox Text="{Binding KeyConfirmation,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Padding="7,6" MinHeight="29"/>
      </DockPanel>
      <Button Content="下发 Key 组合（CAN0）" Command="{Binding SendKeyCommand}"
       Style="{StaticResource AtPrimaryButton}" IsEnabled="{Binding CanSendHardware}"
       Margin="0,9,0,0" Height="33"/>
      <Border BorderBrush="#E5EDF6" BorderThickness="0,1,0,0" Margin="0,15,0,11"/>
      <TextBlock Text="IGN 控制" Style="{StaticResource BenchSectionTitle}"/>
      <StackPanel Orientation="Horizontal">
       <RadioButton Content="ON" GroupName="IgnTarget" IsChecked="{Binding IgnOn,Mode=TwoWay}"
        Margin="0,0,16,0"/>
       <RadioButton Content="OFF" GroupName="IgnTarget" IsChecked="{Binding IgnOff,Mode=TwoWay}"/>
      </StackPanel>
      <TextBlock Text="{Binding LastIgnAck}" TextWrapping="Wrap"
       Foreground="#607B99" FontSize="11" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding IgnExpectedConsent}" FontSize="11" Foreground="#69849D"
       Margin="0,7,0,4"/>
      <TextBox Text="{Binding IgnConfirmation,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       Padding="7,6" MinHeight="29"/>
      <Button Content="下发一次 IGN" Command="{Binding SendIgnCommand}"
       IsEnabled="{Binding CanSendHardware}" Margin="0,8,0,0"/>
      <Border BorderBrush="#E5EDF6" BorderThickness="0,1,0,0" Margin="0,15,0,10"/>
      <TextBlock Text="夹具电磁阀" Style="{StaticResource BenchSectionTitle}"/>
      <TextBlock Text="固件命令与现场接线仍待确认。本版本禁用夹具输出，不借用其他 USB 指令。"
       Foreground="#9D6A26" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
      <Button Content="夹具压紧／释放 · 未开放" IsEnabled="False"/>
     </StackPanel>
    </ScrollViewer>
   </Border>

   <!-- Real RX events, no simulated monitor rows. -->
   <Border Style="{StaticResource BenchCard}" Grid.Column="2" Margin="0,0,10,0">
    <DockPanel LastChildFill="True">
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <Button DockPanel.Dock="Right" Content="清空显示" Command="{Binding ClearLogsCommand}"
       ToolTip="仅清除窗口内显示，不影响设备和文件"/>
      <Button DockPanel.Dock="Right" Content="导出 JSONL" Click="ExportLog_Click"
       Margin="0,0,7,0" ToolTip="导出真实 CAN/USB 操作记录（含错误）"/>
      <StackPanel>
       <TextBlock Text="CAN / USB 操作记录" Style="{StaticResource BenchSectionTitle}"/>
       <TextBlock Text="真实 CAN RX、发送 ACK、失败与 USB 事件；未连接时无虚构数据"
        FontSize="11" Foreground="#71869C" TextWrapping="Wrap"/>
      </StackPanel>
     </DockPanel>
     <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True"
      CanUserAddRows="False" CanUserDeleteRows="False"
      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
      BorderThickness="0" RowHeight="29" FontSize="11"
      EnableRowVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="98"/>
       <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="90"/>
       <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="58"/>
       <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="82"/>
       <DataGridTextColumn Header="数据" Binding="{Binding Data}" Width="145"/>
       <DataGridTextColumn Header="证据 / 说明" Binding="{Binding Detail}" Width="300"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#2368AD" Padding="14,8">
   <TextBlock Text="{Binding Status}" Foreground="White" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>