<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Color x:Key="InkColor">#203249</Color><Color x:Key="SubtleColor">#64798D</Color><Color x:Key="PanelColor">#FFFFFF</Color><Color x:Key="BackgroundColor">#F5F7FA</Color><Color x:Key="LineColor">#D4DFEA</Color><Color x:Key="AccentColor">#176CB5</Color>
 <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/><SolidColorBrush x:Key="Subtle" Color="{StaticResource SubtleColor}"/><SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/><SolidColorBrush x:Key="Canvas" Color="{StaticResource BackgroundColor}"/><SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/><SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
 <SolidColorBrush x:Key="Ok" Color="#187D55"/><SolidColorBrush x:Key="Warning" Color="#95621A"/><SolidColorBrush x:Key="Danger" Color="#C34050"/>
</ResourceDictionary>