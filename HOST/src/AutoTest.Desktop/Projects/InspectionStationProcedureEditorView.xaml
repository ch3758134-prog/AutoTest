<UserControl x:Class="AutoTest.Desktop.Projects.InspectionStationProcedureEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="White" FontSize="12">
 <UserControl.Resources>
  <DataTemplate x:Key="StationActionRow">
   <Border BorderBrush="#E1E8F0" BorderThickness="0,0,0,1" Padding="4,8">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
      VerticalAlignment="Center">
      <Button Content="↑" Command="{Binding DataContext.MoveUpCommand,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
       CommandParameter="{Binding}" ToolTip="上移" Width="27" MinWidth="27" Margin="0,0,3,0"/>
      <Button Content="↓" Command="{Binding DataContext.MoveDownCommand,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
       CommandParameter="{Binding}" ToolTip="下移" Width="27" MinWidth="27" Margin="0,0,3,0"/>
      <Button Content="移除" Command="{Binding DataContext.RemoveActionCommand,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
       CommandParameter="{Binding}" Padding="9,5"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="等待 ms" Foreground="#62758A" VerticalAlignment="Center"
       Margin="0,0,6,0"/>
      <TextBox Width="76" Padding="7,5"
       Text="{Binding WaitAfterMilliseconds,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
     </StackPanel>
     <ComboBox Margin="0,0,10,0" MinWidth="180" MaxWidth="300"
      ItemsSource="{Binding DataContext.ActionOptions,RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
      DisplayMemberPath="Label" SelectedValuePath="Kind"
      SelectedValue="{Binding Kind,Mode=TwoWay}"/>
    </DockPanel>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="0,5,0,5">
   <TextBlock Text="本 ECU 的工位动作（工程草稿）" FontSize="14" FontWeight="SemiBold"
    Foreground="#223B54" Margin="0,0,0,7"/>
   <TextBlock Text="仅编辑 START 前准备和检测后收尾的固定夹具、IGN、等待动作，不建立第二套 TEST 脚本。每个动作可以独立使用上方真实工位按钮实测；保存文件本身不构成安全授权。"
    Foreground="#65798B" TextWrapping="Wrap" Margin="0,0,0,12"/>
   <DockPanel LastChildFill="True" Margin="0,0,0,7">
    <Button DockPanel.Dock="Right" Content="＋ 添加准备动作" Command="{Binding AddBeforeCommand}"
     Padding="12,6" Margin="10,0,0,0"/>
    <TextBlock Text="START 前准备" FontWeight="SemiBold" FontSize="13"
     VerticalAlignment="Center"/>
   </DockPanel>
   <Border BorderBrush="#DEE5EC" BorderThickness="1" CornerRadius="6"
    Padding="8" Margin="0,0,0,13">
    <ItemsControl ItemsSource="{Binding BeforeStart}" ItemTemplate="{StaticResource StationActionRow}"/>
   </Border>
   <DockPanel LastChildFill="True" Margin="0,0,0,7">
    <Button DockPanel.Dock="Right" Content="＋ 添加收尾动作" Command="{Binding AddAfterCommand}"
     Padding="12,6" Margin="10,0,0,0"/>
    <TextBlock Text="检测结束收尾（失败/异常需独立确认）" FontWeight="SemiBold"
     FontSize="13" VerticalAlignment="Center"/>
   </DockPanel>
   <Border BorderBrush="#DEE5EC" BorderThickness="1" CornerRadius="6"
    Padding="8">
    <ItemsControl ItemsSource="{Binding AfterFinish}" ItemTemplate="{StaticResource StationActionRow}"/>
   </Border>
   <DockPanel LastChildFill="True" Margin="0,12,0,0">
    <Button DockPanel.Dock="Right" Content="保存工程动作" Command="{Binding SaveCommand}"
     Padding="12,7" Margin="10,0,0,0"/>
    <TextBlock Text="{Binding SaveStatus}" Foreground="#526F8C" TextWrapping="Wrap"
     VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock Text="注意：机械到位、电气响应和实体 START 输入尚无可靠现场证明；这些动作当前只作为工程内受版本保护的配置草稿，生产执行不会自动触发它们。"
    Foreground="#9A6C29" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
