void write_record_busoff(u16 timers)
  {
      Busoff_record[Busoff_record_n] = timers;
      if(Busoff_record_n<9)Busoff_record_n++;
      else if(Busoff_record_n==9) Busoff_record_n = 0;
  }
  
  
u16 read_busoff_record(void)
  {
      u16 return_temp = 0;
      if( Busoff_record_n>9) return 0;
      if(Busoff_record_n==0) 
        {
            return_temp =  Busoff_record[9] -Busoff_record[0];
        }
      else 
        {
            return_temp =  Busoff_record[Busoff_record_n-1] -Busoff_record[Busoff_record_n];
        }
      return   return_temp;
    
  }
 
void clear_busoff_record(void)
  {
        u8 n = 0;
        for(n= 0;n<10;n++)
          {
            Busoff_record[n] = 0;
          }
        Busoff_record_n = 0;
    
    
  }

