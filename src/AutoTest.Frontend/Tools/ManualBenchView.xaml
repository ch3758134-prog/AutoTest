<UserControl x:Class="AutoTest.Frontend.Tools.ManualBenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Background="{StaticResource AT.Canvas}">
 <Grid Margin="13">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="41*" MinWidth="320"/>
   <ColumnDefinition Width="30*" MinWidth="285"/>
   <ColumnDefinition Width="29*" MinWidth="285"/>
  </Grid.ColumnDefinitions>
  <!-- Send and monitoring are adjacent to actual station controls, not hidden in tabs. -->
  <Border Grid.Column="0" Style="{StaticResource AT.Panel}"
   Padding="0" Margin="0,0,10,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="135"/><RowDefinition Height="*"/><RowDefinition Height="164"/></Grid.RowDefinitions>
    <StackPanel Margin="15,13">
     <TextBlock Text="CAN 报文发送" Style="{StaticResource AT.PanelTitle}"/>
     <TextBlock Text="直接编辑原始帧；有 DBC 后可由正式编码器接入信号编辑。"
      Style="{StaticResource AT.Caption}" Margin="0,6,0,12"/>
     <WrapPanel>
      <ui:Button Content="+ 添加报文" Appearance="Primary" Click="AddCan_Click"
       Style="{StaticResource AT.ToolCommand}"/>
      <ui:Button Content="复制" Click="CopyCan_Click" Style="{StaticResource AT.ToolCommand}"/>
      <ui:Button Content="删除" Click="DeleteCan_Click" Style="{StaticResource AT.ToolCommand}"/>
      <ui:Button Content="发送勾选" IsEnabled="False"
       ToolTip="未接设备，不允许发送实体 CAN 帧" Style="{StaticResource AT.ToolCommand}"/>
     </WrapPanel>
    </StackPanel>
    <DataGrid x:Name="CanGrid" Grid.Row="1"
     ItemsSource="{Binding CanRows}" SelectedItem="{Binding SelectedCan,Mode=TwoWay}"
     ScrollViewer.HorizontalScrollBarVisibility="Auto">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="选" Width="37">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <CheckBox IsChecked="{Binding Included,Mode=TwoWay}"
         VerticalAlignment="Center" HorizontalAlignment="Center"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="报文名称"
       Binding="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       Width="115"/>
      <DataGridTextColumn Header="CAN ID"
       Binding="{Binding IdHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Width="85"/>
      <DataGridTextColumn Header="DATA HEX"
       Binding="{Binding DataHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       Width="*" MinWidth="130"/>
     </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="2" Background="{StaticResource AT.SubtleSurface}"
     BorderBrush="{StaticResource AT.Border}" BorderThickness="0,1,0,0"
     Padding="14,12">
     <StackPanel>
      <TextBlock Text="发送选项" Style="{StaticResource AT.PanelTitle}"/>
      <CheckBox Content="周期发送" IsChecked="{Binding SelectedCan.Periodic,Mode=TwoWay}"
       Margin="0,13,0,8"/>
      <DockPanel>
       <TextBlock Text="周期 (ms)" Foreground="{StaticResource AT.Muted}"
        FontSize="11" VerticalAlignment="Center" Margin="0,0,9,0"/>
       <TextBox Text="{Binding SelectedCan.PeriodMs,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"
        Width="95" HorizontalAlignment="Left"/>
      </DockPanel>
      <TextBlock Text="发送执行、DBC 信号编码与参数合法性由正式业务服务负责。"
       Style="{StaticResource AT.Caption}" Margin="0,9,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>

  <Border Grid.Column="1" Style="{StaticResource AT.Panel}" Padding="0"
   Margin="0,0,10,0">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="15,13">
     <TextBlock Text="工位控制" Style="{StaticResource AT.PanelTitle}"/>
     <TextBlock Text="状态：未连接 / 无物理命令权限"
      Style="{StaticResource AT.Caption}" Margin="0,6,0,12"/>
     <Border BorderBrush="{StaticResource AT.Border}" Background="{StaticResource AT.SubtleSurface}"
      BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,7">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ui:Button Content="ON" IsEnabled="False" Margin="0,0,5,0"/>
        <ui:Button Content="OFF" IsEnabled="False"/>
       </StackPanel>
       <StackPanel>
        <TextBlock Text="IGN" FontWeight="SemiBold"/>
        <TextBlock Text="状态未知" Style="{StaticResource AT.Caption}" Margin="0,4,0,0"/>
       </StackPanel>
      </DockPanel>
     </Border>
     <Border BorderBrush="{StaticResource AT.Border}" Background="{StaticResource AT.SubtleSurface}"
      BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,7">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ui:Button Content="压紧" IsEnabled="False" Margin="0,0,5,0"/>
        <ui:Button Content="释放" IsEnabled="False"/>
       </StackPanel>
       <TextBlock Text="夹具 1" VerticalAlignment="Center" FontWeight="SemiBold"/>
      </DockPanel>
     </Border>
     <Border BorderBrush="{StaticResource AT.Border}" Background="{StaticResource AT.SubtleSurface}"
      BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,7">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ui:Button Content="压紧" IsEnabled="False" Margin="0,0,5,0"/>
        <ui:Button Content="释放" IsEnabled="False"/>
       </StackPanel>
       <TextBlock Text="夹具 2" VerticalAlignment="Center" FontWeight="SemiBold"/>
      </DockPanel>
     </Border>
     <Border Height="1" Background="{StaticResource AT.Border}" Margin="0,13,0,13"/>
     <DockPanel>
      <ui:Button DockPanel.Dock="Right" Content="+ 动作" Click="AddAction_Click"/>
      <TextBlock Text="输入动作" Style="{StaticResource AT.PanelTitle}"/>
     </DockPanel>
     <TextBlock Text="名称来自工程输入定义；这里仅编辑动作草稿。"
      Style="{StaticResource AT.Caption}" Margin="0,7,0,9"/>
     <ListBox x:Name="ActionList" ItemsSource="{Binding KeyActions}"
      SelectedItem="{Binding SelectedAction,Mode=TwoWay}"
      DisplayMemberPath="Name" MaxHeight="110" MinHeight="54"/>
     <TextBlock Text="动作名称" Style="{StaticResource AT.FieldLabel}"/>
     <TextBox Text="{Binding SelectedAction.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
     <DockPanel Margin="0,13,0,8">
      <ui:Button DockPanel.Dock="Right" Content="+ 保持步骤" Click="AddKeyStep_Click"/>
      <TextBlock Text="动作步骤" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <ListBox ItemsSource="{Binding SelectedAction.Steps}"
      SelectedItem="{Binding SelectedKeyStep,Mode=TwoWay}" MinHeight="50" MaxHeight="103">
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="输入组合 · " Foreground="{StaticResource AT.Muted}"/>
        <TextBlock Text="{Binding HoldMs}"/>
        <TextBlock Text=" ms"/>
       </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="保持时间 (ms)" Style="{StaticResource AT.FieldLabel}"/>
     <TextBox Text="{Binding SelectedKeyStep.HoldMs,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"
      Width="95" HorizontalAlignment="Left"/>
     <Expander Header="编辑底层 KEY_SIM 组合（高级）" Margin="0,15,0,0">
      <StackPanel Margin="4,9">
       <TextBlock Text="20 个电阻网络开关可组合闭合；不是 20 个 ECU 功能键。"
        Style="{StaticResource AT.Caption}" Margin="0,0,0,10"/>
       <ItemsControl ItemsSource="{Binding SelectedKeyStep.Keys}">
        <ItemsControl.ItemsPanel>
         <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked,Mode=TwoWay}"
           FontSize="11" Margin="2,6"/>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Expander>
     <ui:Button Content="执行动作（未接入）" IsEnabled="False"
      Margin="0,14,0,0" HorizontalAlignment="Left"/>
    </StackPanel>
   </ScrollViewer>
  </Border>

  <Border Grid.Column="2" Style="{StaticResource AT.Panel}" Padding="0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="101"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="15,14">
     <TextBlock Text="CAN 实时监控" Style="{StaticResource AT.PanelTitle}"/>
     <TextBlock Text="请求、ACK、真实 CAN 帧与 ECU 响应将分层显示。"
      Style="{StaticResource AT.Caption}" Margin="0,6,0,12"/>
     <TextBox IsEnabled="False" ToolTip="尚未接入真实接收帧过滤器"/>
    </StackPanel>
    <TabControl Grid.Row="1">
     <TabItem Header="接收帧">
      <Grid Background="White">
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="暂无真实 CAN 接收帧" Foreground="{StaticResource AT.Muted}"
         FontSize="14" HorizontalAlignment="Center"/>
        <TextBlock Text="不会以演示数据填充实时监控。" Style="{StaticResource AT.Caption}"
         Margin="0,9,0,0"/>
       </StackPanel>
      </Grid>
     </TabItem>
     <TabItem Header="操作日志">
      <Grid Background="White">
       <TextBlock Text="尚无真实硬件操作记录"
        Foreground="{StaticResource AT.Muted}" HorizontalAlignment="Center"
        VerticalAlignment="Center"/>
      </Grid>
     </TabItem>
     <TabItem Header="DBC 解码">
      <Grid Background="White">
       <TextBlock Text="等待正式 DBC 解码与 CAN 实时数据"
        Foreground="{StaticResource AT.Muted}" HorizontalAlignment="Center"
        VerticalAlignment="Center" TextWrapping="Wrap"/>
      </Grid>
     </TabItem>
    </TabControl>
   </Grid>
  </Border>
 </Grid>
</UserControl>
