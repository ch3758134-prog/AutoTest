<Window x:Class="AutoTest.TestEditorPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutoTest.TestEditorPreview"
        Title="AutoTest · TEST 专业编辑器（V02-04 UI 研究原型）"
        WindowState="Maximized" Width="1580" Height="920"
        MinWidth="730" MinHeight="415"
        Background="#F4F7FA" Foreground="#1B2C41"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" SizeChanged="Window_SizeChanged" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <SolidColorBrush x:Key="Ink" Color="#1B2C41"/>
        <SolidColorBrush x:Key="Muted" Color="#63748A"/>
        <SolidColorBrush x:Key="Accent" Color="#2167B4"/>
        <SolidColorBrush x:Key="AccentPale" Color="#E9F2FC"/>
        <SolidColorBrush x:Key="Outline" Color="#DCE5EF"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Panel" Color="#F8FAFD"/>
        <SolidColorBrush x:Key="Warning" Color="#935114"/>
        <SolidColorBrush x:Key="WarningSurface" Color="#FFF4E6"/>
        <Style TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="#1B2C41"/>
        </Style>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1B2C41"/>
            <Setter Property="BorderBrush" Value="#DCE5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="5" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#679DCE"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#EDF5FF"/>
                                <Setter Property="Foreground" Value="#164C91"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2167B4"/>
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#2167B4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2167B4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#164C91"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#63748A"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1B2C41"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE5EF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#2167B4"/>
            <Setter Property="SelectionBrush" Value="#B8D9FB"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2167B4"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder" Background="Transparent" CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#E9F2FC"/>
                                <Setter Property="Foreground" Value="#164C91"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="#B8D3EE"/>
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="0,0,0,1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="CaseTemplate" DataType="{x:Type local:EditorCase}">
            <Grid Height="44" Margin="5,0" ToolTip="{Binding Name}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="13,0,4,0" VerticalAlignment="Center"
                           Text="{Binding Name}" FontSize="12.5"/>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          HorizontalAlignment="Center" IsChecked="{Binding RunSelected,Mode=TwoWay}"
                          ToolTip="仅选择本次运行的用例；不会改变当前编辑选择" Click="RunSelect_Click" PreviewMouseLeftButtonDown="RunSelect_PreviewMouseDown" PreviewKeyDown="RunSelect_PreviewKey"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type local:StepRow}">
            <Border x:Name="RowSurface" Background="Transparent" MinHeight="36" BorderBrush="#EDF1F5" BorderThickness="0,0,0,1">
                <Grid Margin="{Binding Indent}" MinHeight="35">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="29"/>
                        <ColumnDefinition Width="390" MinWidth="160"/>
                        <ColumnDefinition Width="*" MinWidth="80"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding Arrow}" Tag="{Binding Node}"
                            IsEnabled="{Binding HasChildren}"
                            Style="{StaticResource QuietButton}" BorderThickness="0" Padding="0"
                            FontSize="15" Click="ExpandNode_Click"
                            ToolTip="展开或折叠当前结构，不改变步骤选择"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="Kind" Text="{Binding Category}" FontSize="10.5" Foreground="#63748A"
                                   Width="38" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NodeTitle" Text="{Binding Title}" FontSize="13"
                                   VerticalAlignment="Center" FontWeight="Medium"/>
                    </StackPanel>
                    <TextBlock x:Name="RowSummary" Grid.Column="2" Margin="10,0,15,0"
                               Text="{Binding Summary}" FontSize="12"
                               Foreground="#63748A" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RowStatus" Grid.Column="3" Text="{Binding StateText}"
                               Foreground="#63748A" FontSize="11.5" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,13,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Node.Role}" Value="{x:Static local:NodeRole.Phase}">
                    <Setter TargetName="RowSurface" Property="Background" Value="#F1F5FA"/>
                    <Setter TargetName="RowSurface" Property="MinHeight" Value="42"/>
                    <Setter TargetName="NodeTitle" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="NodeTitle" Property="FontSize" Value="14"/>
                    <Setter TargetName="Kind" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.Role}" Value="{x:Static local:NodeRole.Container}">
                    <Setter TargetName="RowSurface" Property="Background" Value="#F6F9FD"/>
                    <Setter TargetName="NodeTitle" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.Role}" Value="{x:Static local:NodeRole.Branch}">
                    <Setter TargetName="RowSurface" Property="Background" Value="#FBFCFE"/>
                    <Setter TargetName="NodeTitle" Property="Foreground" Value="#164C91"/>
                    <Setter TargetName="NodeTitle" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="Kind" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasIssue}" Value="True">
                    <Setter TargetName="RowStatus" Property="Foreground" Value="#935114"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Node.IsEnabled}" Value="False">
                    <Setter TargetName="NodeTitle" Property="Foreground" Value="#63748A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="RowSurface" Property="Background" Value="#E9F2FC"/>
                    <Setter TargetName="RowSurface" Property="BorderBrush" Value="#2167B4"/>
                    <Setter TargetName="RowSurface" Property="BorderThickness" Value="3,0,0,1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="FieldTemplate" DataType="{x:Type local:EditorField}">
            <StackPanel Margin="0,0,0,16">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="必填" FontSize="11" Foreground="#935114"
                               Visibility="{Binding IsResource,Converter={StaticResource BoolVisibility}}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding Text,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding}"
                             GotKeyboardFocus="EditorText_GotKeyboardFocus"
                             LostKeyboardFocus="EditorText_LostKeyboardFocus"
                             TextChanged="EditorText_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInvalid}" Value="True">
                                        <Setter Property="BorderBrush" Value="#935114"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Grid.Column="1" Content="选择资源…" Margin="8,0,0,0" MinWidth="92"
                            Visibility="{Binding IsResource,Converter={StaticResource BoolVisibility}}"
                            Style="{StaticResource BaseButton}" Tag="{Binding}"
                            Click="PickResource_Click" ToolTip="使用 UI 研究样本资源，不访问真实 DBC 或工程"/>
                </Grid>
                <TextBlock Text="{Binding Error}" Foreground="#935114" FontSize="11.5" Margin="0,5,0,0"
                           Visibility="{Binding IsInvalid,Converter={StaticResource BoolVisibility}}"/>
                <TextBlock Text="{Binding Hint}" Foreground="#63748A" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InspectorTemplate" DataType="{x:Type local:EditorNode}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="19,16,19,22">
                    <TextBlock Text="步骤参数" FontSize="16" FontWeight="SemiBold"/>
                    <Border Height="1" Background="#ECF0F5" Margin="0,13,0,17"/>
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="17" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock Text="{Binding Kind}" FontSize="12" Foreground="#63748A" Margin="0,8,0,16"/>
                    <TextBlock Text="步骤名称" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Title,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}"
                             GotKeyboardFocus="EditorText_GotKeyboardFocus"
                             LostKeyboardFocus="EditorText_LostKeyboardFocus"
                             TextChanged="EditorText_TextChanged"
                             Margin="0,0,0,15"/>
                    <CheckBox Content="启用此步骤" IsChecked="{Binding IsEnabled,Mode=TwoWay}"
                              Visibility="{Binding IsMovable,Converter={StaticResource BoolVisibility}}"
                              Margin="0,1,0,15" Click="Enabled_Click"
                              PreviewMouseLeftButtonDown="Enabled_PreviewMouseDown"
                              PreviewKeyDown="Enabled_PreviewKey"/>
                    <Border Background="#E9F2FC" Padding="12" CornerRadius="6" Margin="0,0,0,15"
                            Visibility="{Binding IsStructuralSlot,Converter={StaticResource BoolVisibility}}">
                      <StackPanel>
                        <TextBlock Text="这里是阶段或分支容器，不是一个普通执行步骤。" FontSize="12" Foreground="#164C91" TextWrapping="Wrap"/>
                        <Button Content="＋ 在此阶段 / 分支添加步骤" Click="OpenPalette_Click"
                                Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Background="#FFF4E6" Padding="11" CornerRadius="5" Margin="0,0,0,15">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLocalIssues}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="当前步骤存在未完成或无效参数，请在下方修正。" Foreground="#935114"
                                   FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Fields}"
                                  ItemTemplate="{StaticResource FieldTemplate}"/>
                    <Border Background="#F4F7FA" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="研究原型 · 仅编辑 UI 草稿" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="不会执行 CAN、UDS、Flash 或物理 IO，也不生成真实结果。"
                                       TextWrapping="Wrap" FontSize="11.5" Foreground="#63748A" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="MainHeaderRow" Height="63"/>
            <RowDefinition x:Name="TaskHeaderRow" Height="87"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="FooterRow" Height="30"/>
        </Grid.RowDefinitions>
        <!-- Global product chrome: tasks and identity are separate from TEST editor commands. -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DCE5EF" BorderThickness="0,0,0,1">
            <Grid Margin="19,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="6" Background="#2167B4" VerticalAlignment="Center">
                    <TextBlock Text="AT" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,28,0" VerticalAlignment="Center">
                    <TextBlock Text="AutoTest" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="TEST 专业工作环境" Foreground="#63748A" FontSize="10.5"/>
                </StackPanel>
                <StackPanel x:Name="BreadcrumbBar" Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="自动测试" Foreground="#2167B4" FontWeight="SemiBold"/>
                    <TextBlock Text="   /   " Foreground="#8090A4"/>
                    <TextBlock Text="测试程序编辑" Foreground="#63748A"/>
                    <TextBlock Text="   /   " Foreground="#8090A4"/>
                    <TextBlock Text="{Binding SelectedCase.Name}" FontWeight="Medium"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F2F4F7" CornerRadius="4" Padding="10,6" Margin="0,0,10,0">
                        <TextBlock Text="UI 研究样本 · 非真实工程" FontSize="11" Foreground="#63748A"/>
                    </Border>
                    <StackPanel x:Name="HeaderActions" Orientation="Horizontal">
                    <Button Content="重置样本" Style="{StaticResource BaseButton}" Click="Reset_Click" Margin="0,0,8,0"/>
                    <Button Content="打开草稿" Style="{StaticResource BaseButton}" Click="Open_Click" Margin="0,0,8,0"/>
                    <Button Content="保存草稿" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    </StackPanel>
                    <Menu x:Name="CompactFileMenu" Visibility="Collapsed" Background="White" Margin="0" FontSize="12">
                      <MenuItem Header="文件与草稿"><MenuItem Header="重置研究样本" Click="Reset_Click"/><MenuItem Header="打开草稿" Click="Open_Click"/><MenuItem Header="保存草稿" Click="Save_Click"/></MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20,12,20,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedCase.Name}" FontSize="22" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding SelectedCase.CountSteps,StringFormat='步骤 {0} · '}" Foreground="#63748A" FontSize="12"/>
                    <TextBlock Text="{Binding ProblemCount,StringFormat='待修正 {0} 处 · '}" Foreground="#935114" FontSize="12"/>
                    <TextBlock Text="{Binding SaveStateText}" Foreground="#63748A" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LayoutLabel" Text="工作布局" VerticalAlignment="Center" Foreground="#63748A" Margin="0,0,9,0"/>
                <ComboBox x:Name="CompactCasePicker" Width="178" Height="34" DisplayMemberPath="Name"
                          Visibility="Collapsed" Margin="0,0,8,0" SelectionChanged="CompactCasePicker_SelectionChanged"/>
                <ComboBox x:Name="LayoutPicker" Width="167" Height="34" SelectedIndex="0" SelectionChanged="LayoutPicker_SelectionChanged" Margin="0,0,8,0">
                    <ComboBoxItem Content="A · 右侧持续参数"/>
                    <ComboBoxItem Content="B · 下方参数工作台"/>
                </ComboBox>
                <Button x:Name="CompactDetailsButton" Content="编辑详情 →" Click="CompactDetails_Click"
                        Style="{StaticResource BaseButton}" Visibility="Collapsed" Margin="0,0,8,0"/>
                <Button Content="问题列表" Click="Problems_Click" Style="{StaticResource BaseButton}" Margin="0,0,8,0"/>
                <Button x:Name="ValidateButton" Content="检查草稿" Click="Validate_Click" Style="{StaticResource BaseButton}"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="EditorArea" Grid.Row="2" Margin="18,0,18,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CaseColumn" Width="255"/>
                <ColumnDefinition x:Name="CaseSplitColumn" Width="7"/>
                <ColumnDefinition x:Name="StepsColumn" Width="*"/>
                <ColumnDefinition x:Name="InspectorSplitColumn" Width="7"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="380"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="MainRow" Height="*"/>
                <RowDefinition x:Name="BottomRow" Height="0"/>
                <RowDefinition x:Name="ProblemsRow" Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- TEST case navigation. -->
            <Border x:Name="CasePane" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Background="White"
                    BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="7">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,14,14,5">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="测试用例" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <Button Content="＋" Click="NewCase_Click" Style="{StaticResource QuietButton}"
                                    DockPanel.Dock="Right" ToolTip="新增测试用例" FontSize="17" MinWidth="28"/>
                        </DockPanel>
                        <TextBox x:Name="CaseSearch" Margin="0,12,0,5" Height="33" Padding="9,5"
                                 Style="{StaticResource FieldBox}" TextChanged="CaseSearch_TextChanged"
                                 ToolTip="按名称过滤测试用例"/>
                        <Grid Margin="8,5,14,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="用例 · 当前编辑" FontSize="11" Foreground="#63748A"/>
                            <TextBlock Grid.Column="1" Text="本次执行" FontSize="11" Foreground="#63748A"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="11,5,11,14">
                        <Border Height="1" Background="#ECF0F5" Margin="0,9"/>
                        <WrapPanel HorizontalAlignment="Left">
                            <Button Content="复制" Click="DuplicateCase_Click" Style="{StaticResource QuietButton}" Margin="0,0,4,0"/>
                            <Button Content="删除" Click="DeleteCase_Click" Style="{StaticResource QuietButton}" Margin="0,0,4,0"/>
                            <Button Content="重命名" Click="RenameCase_Click" Style="{StaticResource QuietButton}"/>
                        </WrapPanel>
                        <TextBox x:Name="CaseRenameBox" Style="{StaticResource FieldBox}"
                                 Visibility="Collapsed" Height="36" Margin="0,7,0,0"
                                 KeyDown="CaseRenameBox_KeyDown" LostKeyboardFocus="CaseRenameBox_LostKeyboardFocus"/>
                        <TextBlock Text="编辑选中与本次运行勾选相互独立" Foreground="#63748A"
                                   TextWrapping="Wrap" FontSize="10.5" Margin="6,6,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="CaseList" BorderThickness="0" Background="Transparent"
                             ItemTemplate="{StaticResource CaseTemplate}"
                             SelectionChanged="CaseList_SelectionChanged"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="CaseSplitter" Grid.Row="0" Grid.Column="1"
                          HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="Transparent" ShowsPreview="True"/>
            <!-- Center is the primary work object: a scrollable step structure. -->
            <Border x:Name="StepsPane" Grid.Row="0" Grid.Column="2" Background="White"
                    CornerRadius="7" BorderThickness="1" BorderBrush="#DCE5EF">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition x:Name="StepToolbarRow" Height="104"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,11,16,5">
                        <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="45"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="步骤结构" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedCase.CountSteps,StringFormat='   {0} 步'}" FontSize="12" Foreground="#63748A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="AddButton" Grid.Column="1" Content="＋ 添加步骤"
                                    Click="OpenPalette_Click" Style="{StaticResource PrimaryButton}" MinWidth="122" Height="35"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="115"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StepSearch" Style="{StaticResource FieldBox}" MinHeight="31" Height="33"
                                     Padding="10,5" ToolTip="搜索当前用例的步骤、类型或摘要"
                                     TextChanged="StepSearch_TextChanged"/>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                <Button Content="复制" Click="DuplicateStep_Click" Style="{StaticResource QuietButton}"/>
                                <Button Content="移动到…" Click="MoveTo_Click" Style="{StaticResource QuietButton}"/>
                                <Button Content="撤销" Click="Undo_Click" Style="{StaticResource QuietButton}" />
                                <Button Content="重做" Click="Redo_Click" Style="{StaticResource QuietButton}" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1" Margin="10,0,10,10">
                        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Background="#F6F8FB">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <TextBlock Text="步骤 / 层级" Margin="18,8" Foreground="#63748A" FontWeight="SemiBold" FontSize="11.5"/>
                            <TextBlock Text="主要参数 / 条件摘要" Grid.Column="1" Margin="7,8" Foreground="#63748A" FontWeight="SemiBold" FontSize="11.5"/>
                            <TextBlock Text="状态" Grid.Column="2" Margin="7,8" Foreground="#63748A" FontWeight="SemiBold" FontSize="11.5"/>
                        </Grid>
                        <ListBox x:Name="StepList" Grid.Row="1" BorderThickness="0" Background="White"
                                 SelectionMode="Extended" ItemsSource="{Binding Rows}"
                                 ItemTemplate="{StaticResource StepTemplate}"
                                 SelectionChanged="StepList_SelectionChanged"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="StepList_MouseDoubleClick"
                                 PreviewMouseRightButtonDown="StepList_PreviewMouseRightButtonDown">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="在选中项后插入…" Click="ContextAdd_Click"/>
                                    <Separator/>
                                    <MenuItem Header="复制步骤" Click="DuplicateStep_Click"/>
                                    <MenuItem Header="复制到剪贴缓冲（Ctrl+C）" Click="CopyStep_Click"/>
                                    <MenuItem Header="粘贴到当前位置（Ctrl+V）" Click="PasteStep_Click"/>
                                    <MenuItem Header="上移（同级）" Click="MoveUp_Click"/>
                                    <MenuItem Header="下移（同级）" Click="MoveDown_Click"/>
                                    <MenuItem Header="包裹为 IF / ELSE" Click="WrapIf_Click"/>
                                    <MenuItem Header="包裹为循环" Click="WrapLoop_Click"/>
                                    <Separator/>
                                    <MenuItem Header="启用 / 停用" Click="ToggleEnabled_Click"/>
                                    <MenuItem Header="设置 / 清除断点" Click="ToggleBreakpoint_Click"/>
                                    <MenuItem Header="删除（可撤销）" Click="DeleteStep_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <!-- Compact mode keeps the detail inside the same workspace, never as another property popup. -->
            <Border x:Name="CompactInspector" Grid.Row="0" Grid.Column="2"
                    Visibility="Collapsed" Background="White" BorderBrush="#DCE5EF"
                    BorderThickness="1" CornerRadius="7" Panel.ZIndex="2">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="← 返回步骤结构" Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Left" Margin="16,9,0,0" Click="CompactDetails_Click"/>
                    <ContentControl Content="{Binding SelectedNode}" ContentTemplate="{StaticResource InspectorTemplate}"/>
                </DockPanel>
            </Border>
            <GridSplitter x:Name="InspectorSplitter" Grid.Row="0" Grid.Column="3"
                          HorizontalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="True" Background="Transparent"/>
            <Border x:Name="RightInspector" Grid.Row="0" Grid.Column="4" Background="White"
                    BorderThickness="1" BorderBrush="#DCE5EF" CornerRadius="7">
                <ContentControl Content="{Binding SelectedNode}"
                                ContentTemplate="{StaticResource InspectorTemplate}"/>
            </Border>
            <Border x:Name="BottomInspector" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3"
                    Background="White" Visibility="Collapsed" Margin="0,8,0,0"
                    BorderThickness="1" BorderBrush="#DCE5EF" CornerRadius="7">
                <ContentControl Content="{Binding SelectedNode}" ContentTemplate="{StaticResource InspectorTemplate}"/>
            </Border>
            <Border x:Name="ProblemPane" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3"
                    Visibility="Collapsed" Height="142" Margin="0,8,0,0"
                    Background="White" BorderThickness="1" BorderBrush="#DCE5EF" CornerRadius="7">
                <DockPanel Margin="12,9">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,7">
                        <TextBlock Text="问题与定位" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProblemCount,StringFormat='  ·  {0} 条'}" Foreground="#935114" Margin="8,1,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="ProblemList" ItemsSource="{Binding Problems}"
                             BorderThickness="0" Background="White" FontSize="12.5"
                             MouseDoubleClick="ProblemList_DoubleClick" SelectionChanged="ProblemList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Display}" Margin="9,6" TextTrimming="CharacterEllipsis"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="White" BorderThickness="0,1,0,0" BorderBrush="#DCE5EF">
            <DockPanel Margin="20,0">
                <TextBlock Text="UI ONLY · 研究样本 · 不连接真实执行器" Foreground="#63748A"
                           FontSize="10.5" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Status}" Foreground="#63748A" FontSize="11"
                           DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Popup x:Name="StepPalette" PlacementTarget="{Binding ElementName=AddButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="355" Background="White" BorderThickness="1" BorderBrush="#B5CBE1"
                    CornerRadius="8" Padding="15" Margin="4">
                <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.13"/></Border.Effect>
                <DockPanel>
                    <TextBlock Text="插入步骤 · 当前插入位置可预览" DockPanel.Dock="Top"
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock x:Name="PaletteTargetLabel" Foreground="#63748A" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,9,0,7"/>
                        <WrapPanel>
                            <Button Content="插入前" Click="InsertBefore_Click" Style="{StaticResource BaseButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="插入后 / 添加到分支" Click="InsertAfter_Click"
                                    Style="{StaticResource PrimaryButton}"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBox x:Name="PaletteSearch" Style="{StaticResource FieldBox}"
                                 Height="36" TextChanged="PaletteSearch_TextChanged" Margin="0,0,0,8"/>
                    </StackPanel>
                    <ListBox x:Name="PaletteTypes" Height="286" SelectionMode="Single"
                             MouseDoubleClick="PaletteTypes_MouseDoubleClick"/>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
