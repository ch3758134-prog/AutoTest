<UserControl x:Class="AutoTest.Desktop.Tools.Uds.UdsToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="Segoe UI" FontSize="13" Background="#F2F5F9">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="29"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,2,7,2"/>
            <Setter Property="MinHeight" Value="31"/>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#18314B"/>
            <Setter Property="Margin" Value="0,1,0,12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5F7084"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="#172C43" Padding="18,12">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="UDS  /  诊断调试工作台" Foreground="White"
                               FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="MOCK 模式 · ISO-TP → UDS · 不连接物理 CAN · 不授权真实 ECU 发送"
                               Foreground="#F8CB81" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1"
                    CornerRadius="5" Padding="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="数据来源" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding SourceModes}" SelectedItem="{Binding SourceMode,Mode=TwoWay}"
                                  Margin="0,4,0,10" Padding="6,4"/>
                        <TextBlock Text="Replay 记录文件（仅回放保存数据）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ReplayPath,UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="载入 Replay JSON" Command="{Binding LoadReplayCommand}" Margin="0,0,0,9"/>
                        <TextBlock Text="ECU / ISO-TP Profile" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="配置名称" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Mock ECU 身份（需匹配）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding MockIdentity,UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="TX CAN ID (HEX)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding TxId,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="RX CAN ID (HEX)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding RxId,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="P2 (ms)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding P2Ms,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="P2* (ms)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding P2StarMs,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding AddressingDescription}" Margin="0,0,0,9" Foreground="#8B4428" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MockCaptureUsage, StringFormat='Mock 帧采集批次 {0}，达上限需重置'}" FontSize="11" Foreground="#8B4428" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding MockChannelStatus}" FontSize="11"
                                   Foreground="#AF4E32" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Button Content="重置 Mock ECU / 会话" Command="{Binding ResetCommand}"/>
                        <Separator Margin="0,13"/>
                        <TextBlock Text="诊断服务定义" Style="{StaticResource SectionHeading}"/>
                        <ListBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService,Mode=TwoWay}"
                                 DisplayMemberPath="Name" MinHeight="130" MaxHeight="230"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="新增 / 更新定义" Command="{Binding SaveServiceCommand}"/>
                            <Button Content="删除选中" Command="{Binding DeleteServiceCommand}"/>
                        </WrapPanel>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="服务文件（JSON）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DocumentPath,UpdateSourceTrigger=PropertyChanged}" ToolTip="选择本地 .json 路径；非 DBC 资源"/>
                        <WrapPanel>
                            <Button Content="保存服务定义" Command="{Binding SaveDocumentCommand}"/>
                            <Button Content="重开服务定义" Command="{Binding LoadDocumentCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1"
                        CornerRadius="5" Padding="14">
                    <StackPanel>
                        <TextBlock Text="服务编辑 / 发送" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="服务名称" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ServiceName,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="请求 PDU（十六进制，不包含 ISO-TP PCI）" Style="{StaticResource FieldLabel}"/>
                        <TextBox FontFamily="Consolas" Text="{Binding RequestHex,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="期望响应 PDU（可选；未填写不判 PASS）" Style="{StaticResource FieldLabel}"/>
                        <TextBox FontFamily="Consolas" Text="{Binding ExpectedHex,UpdateSourceTrigger=PropertyChanged}"/>
                        <WrapPanel>
                            <CheckBox Content="下一次注入 NRC" IsChecked="{Binding InjectNrc}"
                                      Margin="0,3,18,3" VerticalAlignment="Center"/>
                            <CheckBox Content="下一次模拟 NRC 0x78 Pending" IsChecked="{Binding InjectPending}"
                                      Margin="0,3,18,3" VerticalAlignment="Center"/>
                            <CheckBox Content="模拟不响应（超时）" IsChecked="{Binding NoResponse}"
                                      Margin="0,3,18,3" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,5,0,3">
                            <TextBlock Text="故障 SID / NRC (HEX): " VerticalAlignment="Center" Foreground="#667B8F"/>
                            <TextBox Width="65" Margin="7,0,6,0" Text="{Binding FaultSid,UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Width="65" Margin="0,0,6,0" Text="{Binding FaultCode,UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Session: " VerticalAlignment="Center" Foreground="#667B8F"/>
                            <TextBlock Text="{Binding Session}" VerticalAlignment="Center"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="▶ 单次 Mock/Replay 请求" Command="{Binding SendCommand}" MinWidth="175"/>
                            <Button Content="■ 取消请求" Command="{Binding CancelRequestCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Margin="0,11,0,11" Background="White" BorderBrush="#D7E0EA"
                        BorderThickness="1" CornerRadius="5" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="响应 PDU" Margin="0,0,18,6" Foreground="#5F7084"/>
                        <TextBox Grid.Column="1" FontFamily="Consolas" IsReadOnly="True" Text="{Binding ResponseHex, Mode=OneWay}"/>
                        <TextBlock Grid.Row="1" Text="Negative Response" Foreground="#5F7084" Margin="0,0,18,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Nrc}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Text="期望比对" Foreground="#5F7084" Margin="0,0,18,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExpectedMatch}"/>
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Error}"
                                   Foreground="#B24637" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="4" Text="Correlation ID" Foreground="#5F7084"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastCorrelationId}" FontFamily="Consolas" FontSize="11"/>
                        <TextBlock Grid.Row="5" Text="Trace 质量" Foreground="#5F7084"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TraceQuality}" TextWrapping="Wrap" FontSize="11"/>
                        <TextBlock Grid.Row="6" Text="失败层级" Foreground="#5F7084" Margin="0,2,12,4"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FailureLayer}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="7" Text="诊断原因" Foreground="#5F7084" Margin="0,2,12,4"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DiagnosticDetail}" TextWrapping="Wrap" FontSize="11"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="White" BorderBrush="#D7E0EA"
                        BorderThickness="1" CornerRadius="5" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="UDS 诊断时间线 / ISO-TP 原始证据（软件来源）"
                                       Style="{StaticResource SectionHeading}"/>
                            <WrapPanel>
                                <TextBlock Text="过滤：" VerticalAlignment="Center"/>
                                <TextBox Width="175" Text="{Binding TraceFilter,UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="复制当前视图" Command="{Binding CopyTraceCommand}"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBox Width="350" ToolTip="完整诊断包 JSON 保存路径"
                                         Text="{Binding DiagnosticPath,UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Content="导出完整诊断包" Command="{Binding ExportDiagnosticCommand}"/>
                            </WrapPanel>
                            <WrapPanel><TextBlock Text="UI Trace 丢弃数量: " Foreground="#8B4428"/><TextBlock Text="{Binding DroppedTraceEvents}" FontWeight="SemiBold"/></WrapPanel>
                            <TextBlock Text="帧时间为 UI 观察时间；Mock 双向帧按发送端分组，非真实 CAN 时序。"
                                       FontSize="11" Foreground="#8B4428" TextWrapping="Wrap"
                                       Margin="0,0,0,7"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding VisibleEvents}" IsReadOnly="True"
                                  AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" RowHeaderWidth="0" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="UTC" Binding="{Binding TimestampUtc,StringFormat={}{0:HH:mm:ss.fff}}" Width="115"/>
                                <DataGridTextColumn Header="层" Binding="{Binding Layer}" Width="65"/>
                                <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="110"/>
                                <DataGridTextColumn Header="原始 Hex" Binding="{Binding RawHex}" Width="210"/>
                                <DataGridTextColumn Header="解码 / 状态" Binding="{Binding DecodedSummary}" Width="*"/>
                                <DataGridTextColumn Header="错误" Binding="{Binding ErrorCode}" Width="145"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#DEE7EF" Padding="14,9">
            <DockPanel>
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SourceLabel}" DockPanel.Dock="Right" Foreground="#8B4428"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
