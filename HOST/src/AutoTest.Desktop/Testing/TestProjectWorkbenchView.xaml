<UserControl x:Class="AutoTest.Desktop.Testing.TestProjectWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White" Foreground="#2B3435">
 <UserControl.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
 </UserControl.InputBindings>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="53"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="25"/>
  </Grid.RowDefinitions>
  <!-- The ordered list is the main work object, not a scroll child below
       two permanent parameter forms. Keep native DataGrid virtualization. -->
  <Border Grid.Row="0" Background="White" BorderBrush="#DCE5EE"
   BorderThickness="0,0,0,1">
   <DockPanel Margin="14,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
     VerticalAlignment="Center">
     <Button Content="依赖与版本" Click="OpenDependencyReview_Click"
      Margin="0,0,8,0" Padding="10,7" ToolTip="按真实资源根因查看失效引用，不会自动采用新版"/>
     <Button Content="检查所选" Command="{Binding PreflightSelectedCommand}"
      Margin="0,0,8,0" Padding="11,7"/>
     <Button Content="▶ 运行所选" Command="{Binding RunSelectedCommand}"
      Style="{StaticResource AtPrimaryButton}" Margin="0,0,7,0" Padding="11,7"/>
     <Button Content="■ 停止" Command="{Binding StopSelectedCommand}" Padding="10,7"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
      Foreground="#2B455D" MaxWidth="280" TextTrimming="CharacterEllipsis"
      VerticalAlignment="Center"/>
     <TextBlock Text="{Binding TotalCount,StringFormat=' · {0} 条正式调用'}"
      Foreground="#71869A" VerticalAlignment="Center" Margin="9,0,0,0"/>
     <Button Content="＋ 新建用例" Command="{Binding CreateNewPackageCommand}"
      Margin="13,0,0,0" Padding="11,7"
      ToolTip="新建一个真正的 TEST 定义并加入此有序项目"/>
    </StackPanel>
   </DockPanel>
  </Border>
      <Border Grid.Row="1" BorderBrush="#E1E7E4" BorderThickness="1" CornerRadius="7"
     Background="White" ClipToBounds="True">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FAFCFA" BorderBrush="#ECF2EF"
       BorderThickness="0,0,0,1">
       <DockPanel Margin="10,0">
        <TextBlock Text="添加测试用例" FontWeight="SemiBold" FontSize="11"
         VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox ItemsSource="{Binding AvailablePackages}"
         SelectedItem="{Binding SelectedAvailable,Mode=TwoWay}"
         DisplayMemberPath="Label" Width="290" Height="27"
         VerticalAlignment="Center" Margin="0,0,7,0"/>
        <Button Content="＋ 添加到项目" Command="{Binding AddCommand}"
         VerticalAlignment="Center"/>
       </DockPanel>
      </Border>
      <DataGrid x:Name="PackagesGrid" Grid.Row="1"
       ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage,Mode=TwoWay}"
       AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
       HeadersVisibility="Column" RowHeight="45" ColumnHeaderHeight="29"
       MinHeight="100" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True"
       VirtualizingPanel.VirtualizationMode="Recycling"
       ScrollViewer.CanContentScroll="True"
       EnableRowVirtualization="True" SelectionUnit="FullRow"
       MouseDoubleClick="PackagesGrid_DoubleClick">
       <DataGrid.RowStyle>
        <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding RunSelected}" Value="True">
           <Setter Property="Background" Value="#F1F8F4"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding RunSelected}" Value="False">
           <Setter Property="Background" Value="#FBFCFB"/>
           <Setter Property="Foreground" Value="#778598"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </DataGrid.RowStyle>
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="本次执行" Width="80">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <CheckBox IsChecked="{Binding RunSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="只影响本次实际运行选择">
            <CheckBox.Content>
             <TextBlock FontSize="11" Foreground="#475668">
              <TextBlock.Style>
               <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Text" Value="已选"/>
                <Style.Triggers>
                 <DataTrigger Binding="{Binding RunSelected}" Value="False">
                  <Setter Property="Text" Value="—"/>
                  <Setter Property="Foreground" Value="#9AA7B6"/>
                 </DataTrigger>
                </Style.Triggers>
               </Style>
              </TextBlock.Style>
             </TextBlock>
            </CheckBox.Content>
           </CheckBox>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="顺序" Binding="{Binding Order,StringFormat={}{0:D2}}"
         IsReadOnly="True" Width="57"/>
        <DataGridTemplateColumn Header="测试用例" Width="*">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
           <Button Content="{Binding Name}" Tag="{Binding}" Click="OpenPackage_Click"
            FontSize="11" FontWeight="SemiBold" Foreground="#475668"
            HorizontalAlignment="Left" Height="21" MinHeight="0"
            Background="Transparent" BorderThickness="0"
            Padding="2,0" ToolTip="打开此用例编辑步骤"
            Style="{StaticResource AtQuietButton}"/>
           <StackPanel Orientation="Horizontal" Height="17" ToolTip="{Binding PinDetail}">
            <TextBlock Text="{Binding PinStatus}" FontSize="10" Foreground="#627C9D"
             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button Content="更新引用…" Tag="{Binding}" Click="AdoptCurrentRevision_Click"
             FontSize="10" Margin="6,0,0,0" Padding="4,0" Height="17" MinHeight="0"
             ToolTip="先核对当前 TEST 资源的版本与哈希，再只更新本条正式调用实例">
             <Button.Style>
              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AtQuietButton}">
               <Setter Property="Visibility" Value="Collapsed"/>
               <Style.Triggers>
                <DataTrigger Binding="{Binding CanAdoptLatest}" Value="True">
                 <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </Button.Style>
            </Button>
            <Button Content="修复旧项目用例" Tag="{Binding}" Click="RestoreLegacyInclusion_Click"
             FontSize="10" Margin="6,0,0,0" Padding="4,0" Height="17"
             MinHeight="0" Foreground="#94651F"
             ToolTip="旧工程存在被排除的实例；恢复并保存后才可以进行完整正式检测">
             <Button.Style>
              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AtQuietButton}">
               <Setter Property="Visibility" Value="Collapsed"/>
               <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                 <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </Button.Style>
            </Button>
           </StackPanel>
          </StackPanel>
         </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- Presence in the ordered project is production participation.
             Only the engineer's temporary run selection remains editable. -->
        <DataGridTextColumn Header="步骤" Binding="{Binding StepCountLabel}"
         IsReadOnly="True" Width="66"/>
        <DataGridTemplateColumn Header="调整" Width="143">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <StackPanel Orientation="Horizontal">
            <Button Content="↑" Tag="{Binding}" Click="MoveRowUp_Click" Width="26"
             MinWidth="0" Height="23" MinHeight="0" Margin="0,0,4,0"
             ToolTip="上移此用例"/>
            <Button Content="↓" Tag="{Binding}" Click="MoveRowDown_Click" Width="26"
             MinWidth="0" Height="23" MinHeight="0" Margin="0,0,4,0"
             ToolTip="下移此用例"/>
            <Button Content="移除" Tag="{Binding}" Click="RemoveRow_Click" Width="46"
             MinWidth="0" Height="23" MinHeight="0" Foreground="#C04A57"
             ToolTip="从测试项目移除此条用例并立即保存；原 TEST 文件仍保留"/>
           </StackPanel>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
  <Expander Grid.Row="2" Header="项目准备 / 项目收尾 · 开发运行参数"
   Background="#F5F8FC" BorderBrush="#DCE6EF" BorderThickness="1,1,1,0"
   MaxHeight="300" IsExpanded="False" ToolTip="仅高级设置，正式项目顺序始终在上方列表">
   <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="270">
    <StackPanel Margin="13,11,13,13">
    <Border Background="#F7FAFD" BorderBrush="#DDE8F3" BorderThickness="1"
     CornerRadius="7" Padding="12" Margin="0,0,0,13">
     <StackPanel>
      <TextBlock Text="项目准备 / 项目收尾" FontSize="14" FontWeight="SemiBold"
       Foreground="#294A70" Margin="0,0,0,6"/>
      <TextBlock Text="可选整车测试环境：项目准备 → 有序用例 → 项目收尾。周期 CAN 跨用例保持；扫码、机械工装、前置 FLASH 不放在这里。"
       TextWrapping="Wrap" Foreground="#60768A" Margin="0,0,0,9"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
       <TextBlock Text="选择已有 TEST 定义" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <ComboBox Width="280" Height="28" ItemsSource="{Binding AvailablePackages}"
        SelectedItem="{Binding SelectedAvailable,Mode=TwoWay}" DisplayMemberPath="Label"/>
      </StackPanel>
      <DockPanel Margin="0,0,0,8">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="＋ 新建" Command="{Binding CreateProjectSetupCommand}"
         Margin="0,0,5,0" ToolTip="创建同一 TEST DSL 的新资源，自动绑定并进入步骤编辑"/>
        <Button Content="绑定" Command="{Binding SetProjectSetupCommand}" Margin="0,0,5,0"/>
        <Button Content="编辑步骤" Command="{Binding OpenProjectSetupCommand}" Margin="0,0,5,0"/>
        <Button Content="移除" Command="{Binding RemoveProjectSetupCommand}"/>
       </StackPanel>
       <TextBlock Text="项目准备" Width="86" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding ProjectSetupLabel}" Foreground="#537089"
        VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="＋ 新建" Command="{Binding CreateProjectTeardownCommand}"
         Margin="0,0,5,0" ToolTip="创建并绑定可选项目收尾 TEST 步骤树"/>
        <Button Content="绑定" Command="{Binding SetProjectTeardownCommand}" Margin="0,0,5,0"/>
        <Button Content="编辑步骤" Command="{Binding OpenProjectTeardownCommand}" Margin="0,0,5,0"/>
        <Button Content="移除" Command="{Binding RemoveProjectTeardownCommand}"/>
       </StackPanel>
       <TextBlock Text="项目收尾" Width="86" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding ProjectTeardownLabel}" Foreground="#537089"
        VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
     </StackPanel>
    </Border>
    <!-- Engineer-only temporary selection does not alter the formal tree. -->
    <Border Background="#EDF7F2" BorderBrush="#E7EFFB" BorderThickness="1"
     CornerRadius="7" Padding="11,8" Margin="0,0,0,12">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="全选" Command="{Binding SelectAllCommand}" Margin="0,0,5,0"/>
       <Button Content="清空" Command="{Binding ClearSelectionCommand}" Margin="0,0,7,0"/>
       <Button Content="▷ 检查所选" Command="{Binding PreflightSelectedCommand}"
        Style="{StaticResource AtPrimaryButton}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="本次开发调试" FontSize="13" FontWeight="SemiBold" Margin="0,0,14,0"
        VerticalAlignment="Center"/>
       <TextBlock Text="{Binding SelectedCount}" Foreground="#3478D6" FontSize="19"
        FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0"/>
       <TextBlock Text="{Binding TotalCount,StringFormat=' / {0} 个用例'}" FontSize="12"
        Foreground="#627C9D" VerticalAlignment="Center">
        <TextBlock.LayoutTransform><ScaleTransform ScaleX="1" ScaleY="1"/></TextBlock.LayoutTransform>
       </TextBlock>
      </StackPanel>
     </DockPanel>
    </Border>
    <Border Background="#F7F9FC" BorderBrush="#DCE5EF" BorderThickness="1"
     CornerRadius="6" Padding="10" Margin="0,0,0,12">
     <StackPanel>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="ECU 唯一编号" FontWeight="SemiBold" VerticalAlignment="Center"
        Margin="0,0,9,0"/>
       <TextBox Width="240" Height="28" VerticalContentAlignment="Center"
        Text="{Binding DutIdentity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        ToolTip="开发批量联调可不填 ECU 编号，按未绑定 DUT 的诊断记录归档，不计出厂数量"/>

       <Button Content="▶ 运行所选" Command="{Binding RunSelectedCommand}"
        Style="{StaticResource AtPrimaryButton}" Margin="0,0,5,0"/>
       <Button Content="■ 停止" Command="{Binding StopSelectedCommand}"/>
      </StackPanel>
      <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
       <StackPanel.Style><Style TargetType="StackPanel">
        <Style.Triggers>
         <DataTrigger Binding="{Binding ExpectedFlashApproval}" Value="">
          <Setter Property="Visibility" Value="Collapsed"/>
         </DataTrigger>
        </Style.Triggers>
       </Style></StackPanel.Style>
       <TextBlock Text="FLASH 实体授权" VerticalAlignment="Center" Margin="0,0,9,0"/>
       <TextBox Width="390" Height="27" VerticalContentAlignment="Center"
        Text="{Binding FlashApproval,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        ToolTip="{Binding ExpectedFlashApproval}"/>
       <TextBlock Text="需输入完整授权指纹，授权不保存" Margin="8,0,0,0"
        Foreground="#64758C" VerticalAlignment="Center"/>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding BatchResults}" Margin="0,6,0,0">
       <ItemsControl.ItemTemplate><DataTemplate>
        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#455E76" FontSize="11"
         Margin="0,2,0,0"/>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>

     </StackPanel>
    </Border>

    </StackPanel>
   </ScrollViewer>
  </Expander>
  <Border Grid.Row="3" Background="#F9FBFD" BorderBrush="#E0E7EE"
   BorderThickness="0,1,0,0">
   <TextBlock Text="{Binding StatusMessage}" Foreground="#5B7188"
    FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0"/>
  </Border>
 </Grid>
</UserControl>
