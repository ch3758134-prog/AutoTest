<UserControl x:Class="AutoTest.Desktop.Shell.ManualBenchCanPropertiesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:testing="clr-namespace:AutoTest.Desktop.Testing"
 Background="#F7F8F8" Foreground="#303941" FontSize="13"
 FontFamily="{StaticResource UiFont}">
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,12">
   <TextBlock Text="CAN 报文 · 完整属性" FontSize="19" FontWeight="SemiBold"/>
   <TextBlock Text="编辑的是待发送配置，不会自动向 ECU 发送。点击旁边空白处关闭属性浮层，报文配置保持在列表中。"
    Foreground="#627C9D" FontSize="12" Margin="0,5,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" DataContext="{Binding SelectedCanRow}" IsEnabled="{Binding CanEditFields}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#E0E5E5" BorderThickness="1" CornerRadius="8" Padding="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
     <TextBlock Text="报文名称" Margin="0,0,0,5"/>
     <TextBox Text="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      Padding="8,6" MinHeight="33" Margin="0,0,0,13"/>
     <TextBlock Text="CAN 报文" FontSize="14" FontWeight="SemiBold"
      Foreground="#475668" Margin="0,0,0,9"/>
     <Grid Margin="0,0,0,9">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="135"/>
       <ColumnDefinition Width="52"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,10,0">
       <TextBlock Text="CAN ID (HEX)" FontSize="11"
        Foreground="#627C9D" Margin="0,0,0,4"/>
       <TextBox Text="{Binding IdHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        IsReadOnly="{Binding UseDbc}" FontFamily="Consolas" MinHeight="32"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
       <TextBlock Text="DLC" FontSize="11" Foreground="#627C9D" Margin="0,0,0,4"/>
       <TextBox Text="{Binding PreviewDlc,Mode=OneWay}" IsReadOnly="True"
        Background="#F7F8FA" FontFamily="Consolas" MinHeight="32"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="9,0,0,0">
       <TextBlock Text="帧格式" FontSize="11" Foreground="#667789"
        Margin="0,0,0,4"/>
       <TextBlock Text="{Binding PreviewFrameFormat}" VerticalAlignment="Center"
        Foreground="#364656" FontSize="12"
        ToolTip="DBC 决定帧格式；未绑定 DBC 时按 CAN ID 自动判断，大于 0x7FF 为扩展帧"/>
      </StackPanel>
     </Grid>
     <TextBlock Text="DATA · 实际发送字节（HEX，最多 8 字节）"
      FontWeight="SemiBold" Foreground="#43536B" Margin="0,0,0,6"/>
     <TextBox Text="{Binding DataHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      FontFamily="Consolas" FontSize="14" Padding="9,6" MinHeight="34"
      Margin="0,0,0,5"/>
     <TextBlock Text="{Binding PreviewError}" Foreground="#B64E3D"
      TextWrapping="Wrap" FontSize="11" Margin="0,0,0,11"/>
      <Border Height="1" Background="#E4E8ED" Margin="0,6,0,12"/>
     <TextBlock Text="发送方式" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="周期发送持续到主动停止、连接中断或真实通信失败。行内单发始终只发一次。"
      TextWrapping="Wrap" Foreground="#627C9D" Margin="0,0,0,10"/>
     <Grid IsEnabled="{Binding CanEditFields}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <CheckBox Content="周期发送" IsChecked="{Binding IsPeriodic,Mode=TwoWay}"
       VerticalAlignment="Center" Margin="0,0,18,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <TextBox Width="72" Text="{Binding PeriodText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPeriodic}" Padding="7,6"/>
       <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0"/>
      </StackPanel>
     </Grid>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Border Grid.Column="2" Background="White" BorderBrush="#E0E5E5" BorderThickness="1" CornerRadius="8" Padding="12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0">
     <DockPanel Margin="0,0,0,7">
      <Button DockPanel.Dock="Right" Content="清除辅助" Click="ClearDbc_Click"
       Padding="9,4" MinWidth="80" ToolTip="解除 DBC 定义，不删除 CAN ID 或 DATA 字节"/>
      <TextBlock Text="DBC 信号辅助" FontWeight="SemiBold" FontSize="14"
       Foreground="#303A46" VerticalAlignment="Center"/>
     </DockPanel>
     <testing:DbcReferencePicker x:Name="BenchDbcPicker" Margin="0,0,0,7"
       BenchChoiceCommitted="BenchDbcPicker_ChoiceCommitted"/>
     <TextBlock Text="选报文即可看到信号；直接改 DATA 也会同步解析信号。无需切换编辑模式。"
      FontSize="11" Foreground="#606F7F" TextWrapping="Wrap"
      Margin="0,0,0,9"/>
     <TextBox x:Name="SignalSearch" TextChanged="SignalSearch_Changed" ToolTip="输入信号名称、别名或定义进行筛选；不改变 DATA" Padding="7,5" Margin="0,0,0,6" Visibility="{Binding UseDbc,Converter={StaticResource BoolToVisibility}}"/>
     </StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding UseDbc,Converter={StaticResource BoolToVisibility}}">
      <ItemsControl x:Name="SignalList" ItemsSource="{Binding SignalValues}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Grid Margin="0,0,0,3" MinHeight="28" IsEnabled="{Binding IsEditable}">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="142"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
           <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis"
            ToolTip="{Binding Definition}"/>
           <TextBlock Text="{Binding Range}" Foreground="#627C9D" FontSize="10"/>
          </StackPanel>
          <Grid Grid.Column="1" Margin="9,0,0,0">
           <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <TextBox.Style><Style TargetType="TextBox">
             <Setter Property="Visibility" Value="Visible"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding HasChoices}" Value="True">
               <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
             </Style.Triggers></Style>
            </TextBox.Style>
           </TextBox>
           <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
            SelectedValuePath="Value" MinHeight="26"
            SelectedValue="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
            <ComboBox.Style><Style TargetType="ComboBox">
             <Setter Property="Visibility" Value="Collapsed"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding HasChoices}" Value="True">
               <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
             </Style.Triggers></Style>
            </ComboBox.Style>
           </ComboBox>
          </Grid>
         </Grid>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <TextBlock Text="编辑完成后返回列表，勾选报文并点击“启动勾选发送”；行内“单发”始终只发一次。"
    Foreground="#627C9D" FontSize="12" VerticalAlignment="Center"/>
   <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click"
    Padding="17,7" MinWidth="78" HorizontalAlignment="Right"/>
  </DockPanel>
 </Grid>
</UserControl>