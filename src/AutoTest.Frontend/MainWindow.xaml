<Window x:Class="AutoTest.Frontend.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="AutoTest · 前端设计工作台" Width="1460" Height="900"
 MinWidth="1060" MinHeight="660" WindowStartupLocation="CenterScreen"
 Background="{StaticResource PageBackground}" Foreground="{StaticResource MainInk}"
 FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="194"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="White" BorderBrush="#E0E7F0"
   BorderThickness="0,0,1,0">
   <DockPanel LastChildFill="True" Margin="12">
    <StackPanel DockPanel.Dock="Bottom">
     <Border Height="1" Background="#E8EDF4" Margin="6,0,6,12"/>
     <TextBlock Text="UI 设计预览" Margin="10,0,0,5"
      FontSize="11" Foreground="#69809A"/>
     <TextBlock Text="未连接设备 · 无真实执行"
      Margin="10,0,0,6" FontSize="10" Foreground="#8795A8"
      TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="9,13,0,30">
      <Border Background="#2676D3" CornerRadius="10" Width="40" Height="40"
       Margin="0,0,12,0">
       <TextBlock Text="AT" Foreground="White" FontSize="15" FontWeight="Bold"
        HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="AutoTest" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="测试工作台" FontSize="11" Foreground="#7E8FA3"/>
      </StackPanel>
     </StackPanel>
     <TextBlock Text="工作区" FontSize="11" Foreground="#8B9AB0"
      Margin="10,0,0,9"/>
     <ui:Button x:Name="TestNavButton" Appearance="Primary" Content="自动测试"
      Click="ShowTest_Click" Padding="13,12" Margin="0,0,0,7"
      HorizontalContentAlignment="Left"/>
     <ui:Button x:Name="BenchNavButton" Content="手动台架"
      Click="ShowBench_Click" Padding="13,12" Margin="0,0,0,7"
      HorizontalContentAlignment="Left"/>
     <ui:Button Content="UDS · 待设计" IsEnabled="False"
      Padding="13,12" Margin="0,0,0,7" HorizontalContentAlignment="Left"/>
     <ui:Button Content="波形 · 待设计" IsEnabled="False"
      Padding="13,12" Margin="0,0,0,7" HorizontalContentAlignment="Left"/>
     <ui:Button Content="DBC · 待设计" IsEnabled="False"
      Padding="13,12" Margin="0,0,0,7" HorizontalContentAlignment="Left"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="64"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="36"/>
   </Grid.RowDefinitions>
   <Border Grid.Row="0" Background="White" BorderBrush="#E0E7F0"
    BorderThickness="0,0,0,1">
    <DockPanel Margin="22,0" LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
      VerticalAlignment="Center">
      <ui:Button Content="打开界面草稿" Click="OpenDraft_Click"
       Margin="0,0,8,0" Padding="10,7"/>
      <ui:Button Content="保存界面草稿" Appearance="Primary"
       Click="SaveDraft_Click" Padding="10,7"/>
     </StackPanel>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="WorkspaceHeading" Text="自动测试"
       FontSize="19" FontWeight="SemiBold"/>
      <TextBlock x:Name="WorkspaceSubheading"
       Text="结构化编排 · 不连接执行器"
       Foreground="#718399" FontSize="11"/>
     </StackPanel>
    </DockPanel>
   </Border>

   <!-- Task-specific TEST authoring: its resource list is not global navigation. -->
   <Grid x:Name="TestWorkspace" Grid.Row="1" Margin="16">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="220"/>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="308"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource SurfaceCard}"
     Margin="0,0,12,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,13">
       <TextBlock Text="测试用例" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="当前仅编辑界面草稿" Foreground="#8695A9"
        FontSize="11" Margin="0,5,0,11"/>
       <ui:Button Content="+ 新建用例" Click="AddCase_Click"
        Appearance="Primary" Padding="10,7"/>
      </StackPanel>
      <ListBox x:Name="CaseList" ItemsSource="{Binding Cases}"
       SelectedItem="{Binding SelectedCase,Mode=TwoWay}"
       DisplayMemberPath="Name" BorderThickness="0"
       Background="Transparent" FontSize="13"/>
     </DockPanel>
    </Border>
    <Border Grid.Column="1" Style="{StaticResource SurfaceCard}"
     Margin="0,0,12,0">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,11">
       <DockPanel Margin="0,0,0,5">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <ui:Button Content="+ 步骤" Click="AddStep_Click"
          Appearance="Primary" Padding="11,7" Margin="0,0,6,0"/>
         <ui:Button Content="复制" Click="CopyStep_Click" Margin="0,0,6,0"/>
         <ui:Button Content="删除" Click="DeleteStep_Click"/>
        </StackPanel>
        <TextBlock Text="步骤编排" Style="{StaticResource SectionTitle}"
         VerticalAlignment="Center"/>
       </DockPanel>
       <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="插入阶段" Foreground="#788AA0"
         VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="PhasePicker" Width="125" SelectedIndex="1">
         <ComboBoxItem Content="准备"/>
         <ComboBoxItem Content="测试"/>
         <ComboBoxItem Content="清理"/>
        </ComboBox>
       </StackPanel>
      </StackPanel>
      <Grid Grid.Row="1">
       <DataGrid x:Name="StepsGrid"
        ItemsSource="{Binding SelectedCase.Steps}"
        SelectedItem="{Binding SelectedStep,Mode=TwoWay}"
        AutoGenerateColumns="False" CanUserAddRows="False"
        CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
        RowHeaderWidth="0" HeadersVisibility="Column"
        EnableRowVirtualization="True" RowHeight="39"
        BorderThickness="0" SelectionMode="Single"
        Background="White">
        <DataGrid.Columns>
         <DataGridTextColumn Header="阶段" Binding="{Binding Phase}"
          Width="65" IsReadOnly="True"/>
         <DataGridTemplateColumn Header="启用" Width="48">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <CheckBox IsChecked="{Binding Enabled,Mode=TwoWay}"
             HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTextColumn Header="步骤名称" Binding="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          Width="*" MinWidth="110"/>
         <DataGridTextColumn Header="操作" Binding="{Binding Kind}"
          Width="102" IsReadOnly="True"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="新建用例后即可添加步骤；双击名称直接编辑。"
        Foreground="#90A0B4" TextWrapping="Wrap"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        MaxWidth="280" TextAlignment="Center" IsHitTestVisible="False">
        <TextBlock.Style>
         <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding SelectedCase}" Value="{x:Null}">
            <Setter Property="Visibility" Value="Visible"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </TextBlock.Style>
       </TextBlock>
      </Grid>
     </Grid>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="步骤编辑" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="选择步骤后在这里直接修改；不打开模态对话框。"
        Foreground="#718399" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8"/>
       <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
       <TextBox Text="{Binding SelectedStep.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        MinHeight="33"/>
       <TextBlock Text="操作类型" Style="{StaticResource FieldLabel}"/>
       <ComboBox SelectedValue="{Binding SelectedStep.Kind,Mode=TwoWay}"
        SelectedValuePath="Content" MinHeight="33">
        <ComboBoxItem Content="CAN 发送"/>
        <ComboBoxItem Content="CAN 判定"/>
        <ComboBoxItem Content="KEY 动作"/>
        <ComboBoxItem Content="IGN 控制"/>
        <ComboBoxItem Content="等待"/>
        <ComboBoxItem Content="IF / ELSE"/>
        <ComboBoxItem Content="循环"/>
        <ComboBoxItem Content="UDS 请求"/>
        <ComboBoxItem Content="调用公共流程"/>
       </ComboBox>
       <TextBlock Text="引用 / 操作对象" Style="{StaticResource FieldLabel}"/>
       <TextBox Text="{Binding SelectedStep.Target,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        MinHeight="33" ToolTip="UI 文本输入演示，尚未关联真实 DBC/工程资源"/>
       <TextBlock Text="值 / 参数" Style="{StaticResource FieldLabel}"/>
       <TextBox Text="{Binding SelectedStep.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        MinHeight="33"/>
       <TextBlock Text="说明" Style="{StaticResource FieldLabel}"/>
       <TextBox Text="{Binding SelectedStep.Note,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        AcceptsReturn="True" Height="86" TextWrapping="Wrap"
        VerticalScrollBarVisibility="Auto"/>
       <Border Height="1" Background="#E5EBF3" Margin="0,16,0,10"/>
       <TextBlock Text="这些字段仅用于前端操作验收。"
        Foreground="#75889F" FontSize="11" TextWrapping="Wrap"/>
       <TextBlock Text="执行器、正式 TEST DSL、真实 ECU 判定均未接入。"
        Foreground="#75889F" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
       <ui:Button Content="运行当前用例（未接入）" IsEnabled="False"
        Margin="0,17,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>

   <!-- Bench UI: editable CAN/KEY data, NO physical controls wired or simulated. -->
   <Grid x:Name="BenchWorkspace" Grid.Row="1" Margin="16" Visibility="Collapsed">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="41*"/>
     <ColumnDefinition Width="30*"/>
     <ColumnDefinition Width="29*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Style="{StaticResource SurfaceCard}" Margin="0,0,12,0">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,11">
       <TextBlock Text="CAN 报文发送" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="可编辑发送配置；不产生真实 CAN 帧。"
        FontSize="11" Foreground="#798A9E" Margin="0,6,0,12"/>
       <WrapPanel>
        <ui:Button Content="+ 报文" Appearance="Primary" Click="AddCan_Click" Margin="0,0,6,7"/>
        <ui:Button Content="复制" Click="CopyCan_Click" Margin="0,0,6,7"/>
        <ui:Button Content="删除" Click="DeleteCan_Click" Margin="0,0,6,7"/>
        <ui:Button Content="单发（未接入）" IsEnabled="False" Margin="0,0,6,7"/>
       </WrapPanel>
      </StackPanel>
      <DataGrid x:Name="CanGrid" Grid.Row="1" ItemsSource="{Binding CanRows}"
       SelectedItem="{Binding SelectedCan,Mode=TwoWay}"
       AutoGenerateColumns="False" CanUserAddRows="False"
       CanUserDeleteRows="False" RowHeaderWidth="0" HeadersVisibility="Column"
       BorderThickness="0" RowHeight="38" EnableRowVirtualization="True"
       GridLinesVisibility="Horizontal" ScrollViewer.HorizontalScrollBarVisibility="Auto">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="选" Width="33">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate><CheckBox IsChecked="{Binding Included,Mode=TwoWay}"
           HorizontalAlignment="Center"/></DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="名称" Binding="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         Width="115"/>
        <DataGridTextColumn Header="CAN ID" Binding="{Binding Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         Width="88"/>
        <DataGridTextColumn Header="DATA (HEX)" Binding="{Binding Data,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         Width="*" MinWidth="150"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
    <Border Grid.Column="1" Style="{StaticResource SurfaceCard}" Margin="0,0,12,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,13">
       <TextBlock Text="工位与按键动作" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="实体操作待接入 · 仅可编辑动作方案"
        FontSize="11" Foreground="#798A9E" Margin="0,6,0,11"/>
       <WrapPanel Margin="0,0,0,9">
        <ui:Button Content="IGN ON" IsEnabled="False" Margin="0,0,6,7"/>
        <ui:Button Content="IGN OFF" IsEnabled="False" Margin="0,0,6,7"/>
        <ui:Button Content="夹具压紧" IsEnabled="False" Margin="0,0,6,7"/>
        <ui:Button Content="夹具释放" IsEnabled="False" Margin="0,0,6,7"/>
       </WrapPanel>
       <Border Height="1" Background="#E5EBF3" Margin="0,5,0,12"/>
       <DockPanel>
        <ui:Button DockPanel.Dock="Right" Content="+ 动作" Click="AddKeyAction_Click"/>
        <TextBlock Text="按键动作" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
      </StackPanel>
      <ScrollViewer>
       <StackPanel>
        <ListBox x:Name="ActionList" ItemsSource="{Binding KeyActions}"
         DisplayMemberPath="Name" SelectedItem="{Binding SelectedAction,Mode=TwoWay}"
         MinHeight="72" MaxHeight="143" Margin="0,0,0,8"/>
        <TextBlock Text="动作名称" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding SelectedAction.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
        <DockPanel Margin="0,13,0,8">
         <ui:Button DockPanel.Dock="Right" Content="+ 段" Click="AddKeyStep_Click"/>
         <TextBlock Text="动作步骤" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox ItemsSource="{Binding SelectedAction.Steps}"
         SelectedItem="{Binding SelectedKeyStep,Mode=TwoWay}"
         MinHeight="67" MaxHeight="100" Margin="0,0,0,7">
         <ListBox.ItemTemplate>
          <DataTemplate>
           <StackPanel Orientation="Horizontal">
            <TextBlock Text="按键组合" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding HoldMs}" FontWeight="SemiBold"/>
            <TextBlock Text=" ms" Foreground="#8092A6"/>
           </StackPanel>
          </DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel>
         <TextBlock Text="保持时间（毫秒）" Style="{StaticResource FieldLabel}"/>
         <TextBox Text="{Binding SelectedKeyStep.HoldMs,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"/>
         <TextBlock Text="20 路 KEY 组合 · 可同时勾选"
          Style="{StaticResource FieldLabel}"/>
         <ItemsControl ItemsSource="{Binding SelectedKeyStep.Keys}">
          <ItemsControl.ItemsPanel>
           <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <CheckBox Content="{Binding Label}"
             IsChecked="{Binding Checked,Mode=TwoWay}" Margin="1,5"/>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
        <ui:Button Content="执行按键动作（未接入）"
         IsEnabled="False" Margin="0,14,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </DockPanel>
    </Border>
    <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="实时 CAN 监视" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="这里只显示真实采集数据；没有虚拟帧和虚拟设备。"
        FontSize="11" Foreground="#798A9E"
        TextWrapping="Wrap" Margin="0,6,0,10"/>
       <ui:Button Content="连接主控（待接入）" IsEnabled="False"
        Margin="0,0,0,10"/>
       <Border Background="#F4F8FC" CornerRadius="7" Padding="9,8">
        <TextBlock Text="设备未连接 · 无监控数据"
         Foreground="#7387A0" FontSize="11"/>
       </Border>
      </StackPanel>
      <TextBlock Grid.Row="1" Text="尚无真实 CAN 帧&#x0A;&#x0A;完成前端体验验收后再接主控 USB / CAN 服务。"
       TextAlignment="Center" TextWrapping="Wrap" Foreground="#8C9CB0"
       HorizontalAlignment="Center" VerticalAlignment="Center"
       MaxWidth="260" IsHitTestVisible="False"/>
     </Grid>
    </Border>
   </Grid>

   <Border Grid.Row="2" Background="White"
    BorderBrush="#E0E7F0" BorderThickness="0,1,0,0">
    <DockPanel Margin="20,0">
     <TextBlock x:Name="StatusText" Text="纯前端设计模式。没有设备接线，也不会执行任何真实 ECU 命令。"
      VerticalAlignment="Center" Foreground="#687B93" FontSize="11"/>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
