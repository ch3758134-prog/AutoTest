<Window x:Class="AutoTest.FlashDiag.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest Studio · CanTool Flash Lab" Width="1600" Height="960"
 MinWidth="1200" MinHeight="720" WindowStartupLocation="CenterScreen" WindowState="Maximized"
 Background="#101620" Foreground="#E2EDF7" FontFamily="Segoe UI" FontSize="13"
 Closing="Window_Closing">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#192431"/>
  <SolidColorBrush x:Key="Edge" Color="#314458"/>
 </Window.Resources>
 <Grid Margin="0">
  <Grid.RowDefinitions>
   <RowDefinition Height="38"/>
   <RowDefinition Height="30"/>
   <RowDefinition Height="48"/>
   <RowDefinition Height="*" MinHeight="350"/>
   <RowDefinition Height="190" MinHeight="110"/>
   <RowDefinition Height="25"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#111924" BorderBrush="#263748" BorderThickness="0,0,0,1">
   <DockPanel Margin="12,0">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
     <TextBlock Text="CANTOOL FLASH LAB" Foreground="#4FAAFB" FontSize="11" FontWeight="SemiBold"/>
     <TextBlock Text="   /   INDEPENDENT PHYSICAL CAN1 DIAGNOSTICS" Foreground="#92A4B7" FontSize="11"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#257AC2" CornerRadius="5" Width="25" Height="25" Margin="0,0,9,0">
      <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="AutoTest" FontWeight="Bold" FontSize="16" Foreground="White"/>
     <TextBlock Text="  STUDIO" FontSize="9" Foreground="#92A4B7"/>
     <TextBlock Text="     /     " Foreground="#65798F"/>
     <TextBlock Text="CanTool ECU 烧录实测" Foreground="#CEDCEB" FontSize="12"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Menu Grid.Row="1" Background="#16202C" Foreground="#E2EDF7">
   <MenuItem Header="_文件">
    <MenuItem Header="导入 CanTool Configuration.xml" Click="OpenConfig_Click"/>
    <MenuItem Header="选择固件 HEX / S19 / BIN" Click="OpenFirmware_Click"/>
    <MenuItem Header="选择 Seed/Key DLL" Click="OpenKeyDll_Click"/>
    <Separator/>
    <MenuItem Header="导出全部日志" Click="Export_Click"/>
    <MenuItem Header="复制日志" Click="CopyLog_Click"/>
    <Separator/>
    <MenuItem Header="退出" Click="Exit_Click"/>
   </MenuItem>
   <MenuItem Header="_设备">
    <MenuItem Header="查找主控 USB" Click="Refresh_Click"/>
    <MenuItem Header="连接主控" Click="Connect_Click"/>
    <MenuItem Header="断开" Click="Disconnect_Click"/>
   </MenuItem>
   <MenuItem Header="_诊断">
    <MenuItem Header="CAN1 探测 Boot / APP（10 03）" Click="Probe_Click"/>
    <MenuItem Header="解析固件并预检" Click="Preflight_Click"/>
   </MenuItem>
   <MenuItem Header="_帮助">
    <MenuItem Header="独立实测：不是 R1 正式 Flash" IsEnabled="False"/>
   </MenuItem>
  </Menu>
  <Border Grid.Row="2" Background="#16202C" BorderBrush="#314458" BorderThickness="0,0,0,1" Padding="10,6">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock x:Name="StatusLine" Text="未连接主控" TextWrapping="Wrap" Foreground="#92A4B7" VerticalAlignment="Center" Margin="10,0,10,0" FontSize="11"/>
     <Button Content="导出日志" Click="Export_Click"/>
     <Button Content="复制日志" Click="CopyLog_Click"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="STATION / USB" Foreground="#92A4B7" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <ComboBox x:Name="Devices" Width="360" Height="29" Margin="0,0,8,0"
      DisplayMemberPath="DisplayIdentity" Background="#202D3B" Foreground="#E2EDF7"/>
     <Button Content="查找 USB" Click="Refresh_Click"/>
     <Button x:Name="ConnectButton" Content="连接主控" Click="Connect_Click" Background="#1975BA"/>
     <Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click" IsEnabled="False"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TabControl Grid.Row="3" Background="#101620" Foreground="#E2EDF7">
   <TabItem Header="烧录操作">
    <Grid Margin="0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="50"/>
      <ColumnDefinition Width="340"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*" MinWidth="350"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="286"/>
     </Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="#141D29" BorderBrush="#314458" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,15,0,0" HorizontalAlignment="Center">
       <TextBlock Text="⇧" FontSize="20" Foreground="#4FAAFB" HorizontalAlignment="Center" Margin="0,0,0,24" ToolTip="真实烧录工作区"/>
       <TextBlock Text="XML" FontSize="10" Foreground="#92A4B7" HorizontalAlignment="Center" Margin="0,0,0,16"/>
       <TextBlock Text="HEX" FontSize="10" Foreground="#92A4B7" HorizontalAlignment="Center" Margin="0,0,0,16"/>
       <TextBlock Text="UDS" FontSize="10" Foreground="#92A4B7" HorizontalAlignment="Center" Margin="0,0,0,16"/>
       <TextBlock Text="CAN" FontSize="10" Foreground="#92A4B7" HorizontalAlignment="Center"/>
      </StackPanel>
     </Border>
     <GridSplitter Grid.Column="2" Background="#314458" HorizontalAlignment="Stretch"/>
     <GridSplitter Grid.Column="4" Background="#314458" HorizontalAlignment="Stretch"/>
     <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
             BorderThickness="1" Grid.Column="1" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="1. CanTool 配置 / Firmware" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="Configuration.xml" Foreground="#9FB4C8" Margin="0,10,0,3"/>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="导入 XML…" Click="OpenConfig_Click"/>
         <TextBox x:Name="ConfigPath" IsReadOnly="True"/>
        </DockPanel>
        <TextBlock x:Name="ConfigSummary" Text="未导入配置（APP/Boot ID 未确定）"
                   TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#9FDACB"/>
        <TextBlock Text="固件 HEX / S19（扩展支持 BIN + 必填地址）"
                   Foreground="#9FB4C8" Margin="0,12,0,3"/>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="选固件…" Click="OpenFirmware_Click"/>
         <TextBox x:Name="ImagePath" IsReadOnly="True"/>
        </DockPanel>
        <DockPanel Margin="0,7,0,0">
         <TextBlock DockPanel.Dock="Left" Text="BIN 起始地址 0x" VerticalAlignment="Center"/>
         <TextBox x:Name="BinAddress" Width="155" HorizontalAlignment="Left" Text="0"/>
        </DockPanel>
        <TextBlock x:Name="ImageSummary" Text="尚未解析固件" TextWrapping="Wrap"
                   Foreground="#9FDACB" Margin="0,7,0,0"/>
        <TextBlock Text="Seed/Key DLL（必须真实 ZLGKey 原生导出）"
                   Foreground="#9FB4C8" Margin="0,12,0,3"/>
        <DockPanel>
         <Button DockPanel.Dock="Right" Content="选择…" Click="OpenKeyDll_Click"/>
         <TextBox x:Name="SecurityDllPath" IsReadOnly="True"/>
        </DockPanel>
        <TextBlock Text="2. CanTool 参数 · 实际生效值" FontSize="17"
                   FontWeight="SemiBold" Margin="0,16,0,8"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <TextBlock Text="BlockLength（HEX）" Grid.Row="0" Margin="0,5"/>
         <TextBox x:Name="BlockLength" Grid.Row="0" Grid.Column="1" Text="200"/>
         <TextBlock Text="P2 毫秒" Grid.Row="1" Margin="0,5"/>
         <TextBox x:Name="P2Timeout" Grid.Row="1" Grid.Column="1" Text="1000"/>
         <TextBlock Text="P2* 毫秒" Grid.Row="2" Margin="0,5"/>
         <TextBox x:Name="P2StarTimeout" Grid.Row="2" Grid.Column="1" Text="5000"/>
         <TextBlock Text="Erase 毫秒" Grid.Row="3" Margin="0,5"/>
         <TextBox x:Name="EraseTimeout" Grid.Row="3" Grid.Column="1" Text="30000"/>
         <TextBlock Text="ISO-TP FC 毫秒" Grid.Row="4" Margin="0,5"/>
         <TextBox x:Name="FlowControlTimeout" Grid.Row="4" Grid.Column="1" Text="2000"/>
        </Grid>
        <CheckBox x:Name="InsertSignature" Content="按 CanTool 原流程写入末端 12 34 56 78 签名（OEM 专用；默认关闭）" Margin="0,12,0,6"/>
        <Button x:Name="ProbeButton" Content="实际 CAN1 探测 Boot / APP（仅 10 03，不擦除）"
                Click="Probe_Click" HorizontalAlignment="Stretch" Margin="0,9,0,2"
                ToolTip="只需先导入 XML 并连接 WinUSB 主控；不要求固件和 Seed/Key DLL。但会改变 ECU 诊断会话。"/>
        <Button Content="解析镜像 / 核对地址范围 / 生成预检清单" Click="Preflight_Click"
                HorizontalAlignment="Stretch" Margin="0,6"/>
        <TextBlock Text="3. 实机授权（非模拟）" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,6"/>
        <CheckBox x:Name="ConfirmPower" Content="已核实接线、目标 ECU 身份及实际供电状态"/>
        <CheckBox x:Name="ConfirmBitrate" Content="已核实主控 CAN1 实际比特率与 XML 一致（导入 XML 不会改速率）"/>
        <CheckBox x:Name="AuthorizeErase" Content="确认允许对该 ECU 执行真实擦除、下载和复位"/>
        <Button Content="生成本次授权短语（无发送）" Click="PrepareAuthorization_Click" Margin="0,7"/>
        <TextBox x:Name="AuthorizationExpected" MinHeight="46" IsReadOnly="True"
                 TextWrapping="Wrap" Margin="0,3"/>
        <TextBlock Text="核对 ECU / 地址 / 镜像 SHA 后，人工输入相同授权短语" Foreground="#9FB4C8" Margin="0,7,0,2"/>
        <TextBox x:Name="AuthorizationEntered" MinHeight="44" TextWrapping="Wrap"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
     <Grid Grid.Column="3">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}"
              BorderThickness="1" Padding="14">
       <StackPanel>
        <TextBlock Text="烧录控制" FontSize="17" FontWeight="SemiBold"/>
        <WrapPanel Margin="0,9,0,0">
         <Button x:Name="StartButton" Content="▶ 开始真实烧录" Click="StartFlash_Click"
                 IsEnabled="False" Padding="24,9" Background="#27514A"/>
         <Button x:Name="CancelButton" Content="停止 / 请求取消" Click="CancelFlash_Click"
                 IsEnabled="False" Padding="20,9"/>
         <Button Content="重新核对配置" Click="Preflight_Click" Padding="18,9"/>
        </WrapPanel>
        <ProgressBar x:Name="FlashProgress" Height="13" Margin="0,12,0,5" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="ProgressLine" Text="等待预检" Foreground="#9FDACB"/>
        <TextBlock x:Name="FlashResultLine" Text="未执行" Margin="0,7,0,0"
                   Foreground="#E6C18B" TextWrapping="Wrap"/>
        <TextBlock Text="ECU 可能已擦除但没有最终响应时标为 UNCERTAIN；不会自动重擦、重传或宣称成功。"
                   TextWrapping="Wrap" Foreground="#B7C4D2" Margin="0,9,0,0"/>
       </StackPanel>
      </Border>
      <TabControl Grid.Row="1" Background="#101620" Margin="0,9,0,0" Foreground="#E5EDF6">
       <TabItem Header="烧录阶段 / UDS">
        <DataGrid x:Name="StagesGrid" ItemsSource="{Binding Stages}" Margin="4"
                  HeadersVisibility="Column" SelectionMode="Single">
         <DataGrid.Columns>
          <DataGridTextColumn Header="时间" Binding="{Binding When}" Width="165"/>
          <DataGridTextColumn Header="步骤" Binding="{Binding Stage}" Width="230"/>
          <DataGridTextColumn Header="状态" Binding="{Binding Outcome}" Width="130"/>
          <DataGridTextColumn Header="诊断信息" Binding="{Binding Detail}" Width="*"/>
          <DataGridTextColumn Header="已确认字节" Binding="{Binding Confirmed}" Width="110"/>
         </DataGrid.Columns>
        </DataGrid>
       </TabItem>
       <TabItem Header="配置字段 / XML 来源">
        <DataGrid x:Name="ConfigurationGrid" ItemsSource="{Binding ConfigurationFields}" Margin="4">
         <DataGrid.Columns>
          <DataGridTextColumn Header="XML 字段" Binding="{Binding Field}" Width="150"/>
          <DataGridTextColumn Header="实际值" Binding="{Binding Value}" Width="175"/>
          <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="130"/>
          <DataGridTextColumn Header="参与流程" Binding="{Binding UsedBy}" Width="*"/>
          <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="250"/>
         </DataGrid.Columns>
        </DataGrid>
       </TabItem>
       <TabItem Header="固件内存地址段">
        <DataGrid x:Name="FirmwareGrid" ItemsSource="{Binding FirmwareSegments}" Margin="4">
         <DataGrid.Columns>
          <DataGridTextColumn Header="起点" Binding="{Binding Start}" Width="160"/>
          <DataGridTextColumn Header="结束（不含）" Binding="{Binding End}" Width="160"/>
          <DataGridTextColumn Header="字节" Binding="{Binding Bytes}" Width="130"/>
         </DataGrid.Columns>
        </DataGrid>
       </TabItem>
       <TabItem Header="CAN1 原始收发日志">
        <ListBox x:Name="CanLogs" ItemsSource="{Binding CanEvents}" Margin="4"
                 FontFamily="Consolas" FontSize="11" Background="#192431" Foreground="#DAEAF7"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
       </TabItem>
      </TabControl>
     </Grid>
     <Border Grid.Column="5" Background="#192431" BorderBrush="#314458" BorderThickness="1,0,0,0">
      <DockPanel>
       <Border DockPanel.Dock="Top" Background="#202D3B" Padding="12,12,12,10">
        <StackPanel>
         <TextBlock Text="INSPECTOR / 烧录上下文" Foreground="#92A4B7" FontSize="11" FontWeight="SemiBold"/>
         <TextBlock Text="ECU / 配置 / 物理来源" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0"/>
         <TextBlock Text="独立 CAN1 真实烧录诊断" Foreground="#92A4B7" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
       </Border>
       <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
         <TextBlock Text="CONFIGURATION / XML" Foreground="#4FAAFB" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,9"/>
         <TextBlock Text="{Binding ElementName=ConfigSummary,Path=Text}" Foreground="#C6D5E5" TextWrapping="Wrap" FontSize="12"/>
         <Border BorderBrush="#314458" BorderThickness="0,0,0,1" Margin="0,12,0,13"/>
         <TextBlock Text="FIRMWARE / IMAGE" Foreground="#4FAAFB" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,9"/>
         <TextBlock Text="{Binding ElementName=ImageSummary,Path=Text}" Foreground="#C6D5E5" TextWrapping="Wrap" FontSize="12"/>
         <Border BorderBrush="#314458" BorderThickness="0,0,0,1" Margin="0,12,0,13"/>
         <TextBlock Text="JOB / PHYSICAL RESULT" Foreground="#4FAAFB" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,9"/>
         <TextBlock Text="{Binding ElementName=FlashResultLine,Path=Text}" Foreground="#E8B967" TextWrapping="Wrap" FontSize="12"/>
         <Border BorderBrush="#314458" BorderThickness="0,0,0,1" Margin="0,12,0,13"/>
         <TextBlock Text="通信事实" FontWeight="SemiBold" Margin="0,0,0,9"/>
         <TextBlock Text="USB ACK 不等于 ECU UDS 响应。原始帧、NRC、超时、擦除后的不确定状态分别记录。"
          Foreground="#92A4B7" TextWrapping="Wrap" FontSize="12"/>
         <TextBlock Text="真实擦写授权必须在左侧配置区完成；物理 CAN1 独占。" Foreground="#FF7886"
          TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12"/>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="诊断说明 / 实测结果">
    <ScrollViewer Background="{StaticResource Panel}" Padding="18">
     <StackPanel>
      <TextBlock Text="CanTool 参考流程与现役 CAN 收发路径" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                 Text="探测：Boot 10 03 → APP 10 03；进入编程：APP 11 01、Boot 10 02；Security：27 01/27 02；Erase：31 01 FF00；逐块 34/36/37/31 01 FF01；最终 11 01。除 CAN 设备底层以外，保留 CanTool 参考 PDU 形状。"/>
      <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                 Text="CAN：AutoTest USB 0x40 / channel=1 → ECU；接收 0x41 / CAN1；主控 ACK 不代表 ECU 收到数据；UDS 0x74/76/71 响应单独检查。APP 与 Boot 各自 CAN ID 由 XML 提供。"/>
      <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                 Text="原 CanTool 的低半字节 0x74 解析、缺失校验即成功、以及擦除/传输自动重试存在风险，实测程序使用严格解析并在不确定状态停止。原 CanTool 写末端签名为可选项，必须人工确认。"/>
      <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                 Text="上传样例 SafetyFile.dll 是托管 .NET DLL，没有原生 ZLGKey 导出；不能按 CanTool 的 LoadLibrary/GetProcAddress 原生 ABI 使用。sa_demo.dll 是演示算法，不能默认视为真实 ECU 的 Key Provider。"/>
      <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                 Text="实际 CAN1 波特率配置能力、当前 ECU 身份、授权烧录算法、复位后 APP 版本回读需要台架确认。这个窗口专用于可追溯排障，不属于 R1 产品发布内容。"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="4" Margin="0" Background="{StaticResource Panel}"
          BorderBrush="{StaticResource Edge}" BorderThickness="1" Padding="10">
   <DockPanel>
    <DockPanel DockPanel.Dock="Top">
     <TextBlock Text="USB / CAN1 / 烧录全局事件" FontWeight="SemiBold"/>
    </DockPanel>
    <ListBox x:Name="Logs" ItemsSource="{Binding Events}" FontFamily="Consolas"
             FontSize="11" Background="#192735" Foreground="#DFE9F2"
             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
   </DockPanel>
  </Border>
  <Border Grid.Row="5" Background="#174269" BorderBrush="#314458" BorderThickness="0,1,0,0" Padding="10,3">
   <DockPanel>
    <TextBlock DockPanel.Dock="Right" Text="PHYSICAL CAN1 / 独立烧录排障，不属于 R1 正式程序" Foreground="#E2EDF7" FontSize="11"/>
    <TextBlock x:Name="TracePathLine" Text="USB/CAN 原始证据：未开始" Foreground="#D5E4F4" FontSize="11" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>