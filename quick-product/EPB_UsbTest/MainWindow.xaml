<Window x:Class="EPB_UsbTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:config="clr-namespace:EPB.Core.Configuration;assembly=EPB.Core"
        xmlns:testing="clr-namespace:EPB.Core.Testing;assembly=EPB.Core"
        Title="EPB 自动测试工作台" MinWidth="1260" MinHeight="720" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Closed="Window_Closed" Loaded="Window_Loaded" KeyDown="Window_KeyDown" StateChanged="Window_StateChanged" IsVisibleChanged="Window_IsVisibleChanged">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- 兼容动态控件的旧资源名；实际颜色全部复用全局浅色主题。 -->
        <SolidColorBrush x:Key="Blue" Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="Line" Color="{StaticResource Line}"/>
        <SolidColorBrush x:Key="Muted" Color="{StaticResource Text2}"/>
        <!-- 按钮外观统一由 App.xaml/Styles.xaml 提供。这里不再声明窗口级隐式 Button，
             避免主窗口、动态步骤卡片和弹窗各自得到不同的默认样式。 -->
        <Style x:Key="TestStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeText}">
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LastStatus}" Value="{x:Static testing:TestResultStatus.通过}"><Setter Property="Foreground" Value="{StaticResource GreenBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding LastStatus}" Value="{x:Static testing:TestResultStatus.判定失败}"><Setter Property="Foreground" Value="{StaticResource AmberBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding LastStatus}" Value="{x:Static testing:TestResultStatus.执行错误}"><Setter Property="Foreground" Value="{StaticResource RedBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding LastStatus}" Value="{x:Static testing:TestResultStatus.运行中}"><Setter Property="Foreground" Value="{StaticResource StatusRunningBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TestStatusBadge" TargetType="Border" BasedOn="{StaticResource StatusBadge}">
            <Setter Property="Background" Value="#F4F7FA"/>
            <Setter Property="BorderBrush" Value="#D9E2EC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LastStatus}" Value="{x:Static testing:TestResultStatus.通过}"><Setter Property="Background" Value="#ECF8F0"/><Setter Property="BorderBrush" Value="#B9DEC5"/></DataTrigger>
                <DataTrigger Binding="{Binding LastStatus}" Value="{x:Static testing:TestResultStatus.判定失败}"><Setter Property="Background" Value="#FFF7E8"/><Setter Property="BorderBrush" Value="#EBCF92"/></DataTrigger>
                <DataTrigger Binding="{Binding LastStatus}" Value="{x:Static testing:TestResultStatus.执行错误}"><Setter Property="Background" Value="#FFF0F0"/><Setter Property="BorderBrush" Value="#E6B5B5"/></DataTrigger>
                <DataTrigger Binding="{Binding LastStatus}" Value="{x:Static testing:TestResultStatus.运行中}"><Setter Property="Background" Value="#EEF7FD"/><Setter Property="BorderBrush" Value="#B9D8ED"/></DataTrigger>
                <DataTrigger Binding="{Binding LastStatus}" Value="{x:Static testing:TestResultStatus.跳过}"><Setter Property="Background" Value="#F5F6F8"/><Setter Property="BorderBrush" Value="#D8DEE6"/></DataTrigger>
                <DataTrigger Binding="{Binding LastStatus}" Value="{x:Static testing:TestResultStatus.未进入}"><Setter Property="Background" Value="#F5F6F8"/><Setter Property="BorderBrush" Value="#D8DEE6"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepExecutionBadgeText" TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.成功}"><Setter Property="Foreground" Value="{StaticResource GreenBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.失败}"><Setter Property="Foreground" Value="{StaticResource AmberBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.错误}"><Setter Property="Foreground" Value="{StaticResource RedBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.运行中}"><Setter Property="Foreground" Value="{StaticResource StatusRunningBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepExecutionBadge" TargetType="Border" BasedOn="{StaticResource StatusBadge}">
            <Setter Property="Background" Value="#F4F7FA"/>
            <Setter Property="BorderBrush" Value="#D9E2EC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.成功}"><Setter Property="Background" Value="#ECF8F0"/><Setter Property="BorderBrush" Value="#B9DEC5"/></DataTrigger>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.失败}"><Setter Property="Background" Value="#FFF7E8"/><Setter Property="BorderBrush" Value="#EBCF92"/></DataTrigger>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.错误}"><Setter Property="Background" Value="#FFF0F0"/><Setter Property="BorderBrush" Value="#E6B5B5"/></DataTrigger>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.运行中}"><Setter Property="Background" Value="#EEF7FD"/><Setter Property="BorderBrush" Value="#B9D8ED"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#C9D5E2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <!-- 属性编辑器使用窄滚动条，保留滚轮和拖动能力，减少视觉占用。 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="RowHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderBrush" Value="#D6E0EB"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Text2Brush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E3E8EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F7FBFD"/>
                    <Setter Property="BorderBrush" Value="#C9DEEF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource SelectionLineBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475766"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="TestFlowTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="ConfigurationTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475766"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="SelectionSurface" Grid.Row="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="4" Padding="4,2">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Grid.Column="0" Width="15" Height="18"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                                  Foreground="#80909E" Content="▸" Click="ConfigurationTreeExpander_Click"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="16,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expander" Property="Content" Value="▾"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionSurface" Property="Background" Value="#F7FBFF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionSurface" Property="Background" Value="{StaticResource SelectionSoftBrush}"/><Setter TargetName="SelectionSurface" Property="BorderBrush" Value="{StaticResource SelectionLineBrush}"/><Setter Property="Foreground" Value="#3E5366"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfigurationAddButtonStyle" TargetType="Button">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="Width" Value="23"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4D99D8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsSelected}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsMouseOver}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ConfigurationDeleteButtonStyle" TargetType="Button">
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#B34747"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsSelected}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsMouseOver}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TestCaseTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475766"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Border x:Name="CaseSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="4" Padding="4,3">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaseSurface" Property="Background" Value="#F7FBFF"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="CaseSurface" Property="Background" Value="{StaticResource SelectionSoftBrush}"/><Setter TargetName="CaseSurface" Property="BorderBrush" Value="{StaticResource SelectionLineBrush}"/><Setter Property="Foreground" Value="#3E5366"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0" Width="18" Height="22"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                          Foreground="#6B7B8F" Content="▸"/>
                            <ContentPresenter Grid.Row="0" Grid.Column="1" ContentSource="Header"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
                            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expander" Property="Content" Value="▾"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TestCaseTemplate">
            <Grid MinHeight="48" Margin="0,2,3,2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*" MinWidth="75"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox Grid.RowSpan="2" Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="2,0,4,0" ToolTip="本用例是否参与批量测试"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Style="{StaticResource TestStatusTextStyle}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,2,4,0"/>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource TestStatusBadge}" Margin="2,2,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding StatusSummary}" Style="{StaticResource TestStatusTextStyle}" FontSize="11"/></Border>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WaitSummary}" Foreground="#687787" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,4,0"/>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Tag="{Binding}" Click="TestCaseWait_Click" Content="间隔" Height="22" Padding="6,0" Margin="0,2,4,0" Background="Transparent" BorderBrush="#BFD3E6" Foreground="#5D7890" FontSize="11" ToolTip="设置本用例与下一个启用用例之间的等待时间"/>
                    <Button Tag="{Binding}" Click="TestCaseDelete_Click" Content="×" Width="22" Height="22" Padding="0" Margin="0,2,0,0" Background="Transparent" BorderThickness="0" Foreground="#B34747" FontSize="15" ToolTip="删除测试用例"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <HierarchicalDataTemplate x:Key="TestFlowTemplate" ItemsSource="{Binding Children}">
            <Border x:Name="TestStepCard" Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3,4,3" HorizontalAlignment="Stretch" MaxWidth="1200" MinHeight="60" PreviewMouseLeftButtonDown="TestFlowStepCard_MouseLeftButtonDown">
                             <Grid>
                                 <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="是否启用此测试节点"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DisplaySummary}" Foreground="{StaticResource Text2Brush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource TestStatusBadge}" Margin="6,0">
                        <TextBlock Text="{Binding StatusSummary}" Style="{StaticResource TestStatusTextStyle}" FontSize="12"/>
                    </Border>
                    <Border x:Name="TestStepTypeBadge" Grid.Column="3" Background="#EAF3FF" CornerRadius="10" Padding="8,2" Margin="6,0">
                        <TextBlock Text="{Binding DisplayKind}" Foreground="#477A9B" FontSize="12"/>
                    </Border>
                    <Button Grid.Column="4" Tag="{Binding}" Click="TestFlowNodeDelete_Click" Content="×" Width="24" Height="24" Padding="0" Margin="2,0,0,0" Visibility="Collapsed"
                            Background="Transparent" BorderThickness="0" Foreground="#8A98A8" FontSize="16" ToolTip="删除测试节点"/>
                </Grid>
            </Border>
        <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True">
                    <Setter TargetName="TestStepCard" Property="Background" Value="{StaticResource SelectionSoftBrush}"/>
                    <Setter TargetName="TestStepCard" Property="BorderBrush" Value="{StaticResource SelectionLineBrush}"/>
                    <Setter TargetName="TestStepCard" Property="BorderThickness" Value="1"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type config:ConfigurationStep}" ItemsSource="{Binding Children}">
            <Border x:Name="StepCard" Background="White" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,3,4,3" HorizontalAlignment="Stretch" MaxWidth="1200" MinHeight="60">
                             <Grid>
                                 <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding SelectedForGroup}" Checked="StepGroupCheckBox_Changed" Unchecked="StepGroupCheckBox_Changed" VerticalAlignment="Center" ToolTip="勾选多个同级步骤后创建组合"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StepNameText" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StepSummaryText" Text="{Binding Summary}" Foreground="{StaticResource Text2Brush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource StepExecutionBadge}" Margin="6,0">
                        <TextBlock Text="{Binding ExecutionState}" Style="{StaticResource StepExecutionBadgeText}" FontSize="12"/>
                    </Border>
                    <Border x:Name="TypeBadge" Grid.Column="3" Background="#EAF3FF" CornerRadius="10" Padding="8,2" Margin="6,0">
                        <TextBlock x:Name="TypeText" Text="{Binding DisplayKind}" Foreground="#477A9B" FontSize="12"/>
                    </Border>
                    <Button Grid.Column="4" Tag="{Binding}" Click="StepDelete_Click" Content="×" Width="24" Height="24" Padding="0" Margin="2,0,0,0"
                            Background="Transparent" BorderThickness="0" Foreground="#8A98A8" FontSize="16" ToolTip="删除步骤"/>
                </Grid>
            </Border>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}}" Value="True"><Setter TargetName="StepCard" Property="Background" Value="{StaticResource SelectionSoftBrush}"/><Setter TargetName="StepCard" Property="BorderBrush" Value="{StaticResource SelectionLineBrush}"/><Setter TargetName="StepCard" Property="BorderThickness" Value="1"/></DataTrigger>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.运行中}"><Setter TargetName="StepCard" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter TargetName="StepCard" Property="BorderBrush" Value="#8FC4E2"/></DataTrigger>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.成功}"><Setter TargetName="StepCard" Property="Background" Value="#ECF9F1"/><Setter TargetName="StepCard" Property="BorderBrush" Value="#43A66A"/></DataTrigger>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.失败}"><Setter TargetName="StepCard" Property="Background" Value="#FFF0F0"/><Setter TargetName="StepCard" Property="BorderBrush" Value="#D95C5C"/></DataTrigger>
                <DataTrigger Binding="{Binding ExecutionState}" Value="{x:Static config:StepExecutionState.错误}"><Setter TargetName="StepCard" Property="Background" Value="#FFF2E8"/><Setter TargetName="StepCard" Property="BorderBrush" Value="#D97832"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static config:ConfigurationStepKind.等待}"><Setter TargetName="TypeBadge" Property="Background" Value="#FFF5D9"/><Setter TargetName="TypeText" Property="Foreground" Value="#8A6416"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static config:ConfigurationStepKind.动作控制}"><Setter TargetName="TypeBadge" Property="Background" Value="#F3EAFE"/><Setter TargetName="TypeText" Property="Foreground" Value="#7246A8"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static config:ConfigurationStepKind.电源控制}"><Setter TargetName="TypeBadge" Property="Background" Value="#FFECE3"/><Setter TargetName="TypeText" Property="Foreground" Value="#A24F28"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static config:ConfigurationStepKind.引用序列}"><Setter TargetName="TypeBadge" Property="Background" Value="#E7F7F4"/><Setter TargetName="TypeText" Property="Foreground" Value="#247C70"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static config:ConfigurationStepKind.组合}"><Setter TargetName="TypeBadge" Property="Background" Value="#EDF0F5"/><Setter TargetName="TypeText" Property="Foreground" Value="#485B73"/></DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <Style x:Key="FlowEditorListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEF2F7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="FlowRowSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FlowRowSurface" Property="Background" Value="#F4F8FD"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="FlowRowSurface" Property="Background" Value="#EAF2FF"/><Setter TargetName="FlowRowSurface" Property="BorderBrush" Value="#A2C5F1"/></Trigger>
                        </ControlTemplate.Triggers>
