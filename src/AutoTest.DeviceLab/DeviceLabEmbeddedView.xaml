<UserControl x:Class="AutoTest.DeviceLab.DeviceLabEmbeddedView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F5F7FA" Foreground="#203249" FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Outline" Color="#D6E1EC" />
        <SolidColorBrush x:Key="Subtle" Color="#637A90" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Background" Value="#EAF0F8"/>
            <Setter Property="Foreground" Value="#203249"/>
            <Setter Property="BorderBrush" Value="#D6E1EC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ConnectPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#176CB5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#176CB5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style x:Key="DisconnectDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#9F3440"/>
            <Setter Property="Background" Value="#FFF2F1"/>
            <Setter Property="BorderBrush" Value="#E6C6C6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#203249"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="ListBox"><Setter Property="Foreground" Value="#203249"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <DataTemplate x:Key="TimelineItem">
            <StackPanel Orientation="Horizontal" Margin="3,3,6,3">
                <TextBlock Text="{Binding Time}" Width="92" Foreground="{StaticResource Subtle}" FontFamily="Consolas"/>
                <TextBlock Text="{Binding Source}" Width="72" Foreground="#127C9D" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Details}" FontFamily="Consolas" TextWrapping="NoWrap"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="主控板连接" FontSize="23" FontWeight="Bold"/>
                <TextBlock Text="连接实际主控，确认设备状态，查看 CAN0 / CAN1 接收信息" Foreground="{StaticResource Subtle}" Margin="0,5,0,0"/>
                <TextBlock Text="本窗口用于设备连接及只读诊断；按键、IGN、夹具和 CAN 发送请到手动台架操作"
                           Foreground="{StaticResource Subtle}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="#FFF6E8" BorderBrush="#C9A271" BorderThickness="1"
                CornerRadius="5" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontWeight="Bold" Foreground="#744611" FontSize="14"
                           Text="安全提示：主控板上电初始 GPIO 可能使 IGN 或电源控制输出为高，软件回读不能代替实测电压。"/>
                <TextBlock Margin="0,5,0,0" Foreground="#8F611B"
                           Text="首次接线应物理隔离 DUT 和执行机构、独立确认供电与 IGN 电压；本工具不执行 IGN、夹具、按键输出、CAN 发送或烧录。每次连接（含重试）均须重新勾选确认。"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Header="连接主控">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding B0Acknowledged,Mode=TwoWay}"
                                      Content="已确认 DUT 与执行机构安全隔离，已核对 IGN 和供电初始状态"
                                      FontWeight="SemiBold" Margin="0,3,0,13"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="连接主控" Style="{StaticResource ConnectPrimary}" Command="{Binding ConnectCommand}"/>
                                <Button Content="断开" Style="{StaticResource DisconnectDanger}" Command="{Binding DisconnectCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,12,0,5"/>
                            <TextBlock Text="自动重连已禁用。连接失败会保留故障阶段及日志路径。"
                                       Foreground="{StaticResource Subtle}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="识别主控设备">
                        <StackPanel>
                            <TextBlock Text="仅识别固件接口 GUID + VID_1183/PID_5850" Foreground="{StaticResource Subtle}" Margin="0,0,0,10"/>
                            <Button Content="重新枚举设备" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate,Mode=TwoWay}"
                                      DisplayMemberPath="DeviceInstanceId" Height="33"/>
                            <TextBlock Text="驱动服务" FontWeight="SemiBold" Margin="0,12,0,2"/>
                            <TextBlock Text="{Binding DriverService}" TextWrapping="Wrap"/>
                            <TextBlock Text="设备实例 ID 不符合主控板身份将被拒绝；扫码枪不做 HID/串口探测。"
                                       Foreground="{StaticResource Subtle}" Margin="0,9,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <Expander Header="高级诊断 · 固件回读和连接故障" IsExpanded="False" Margin="0,0,0,10">
                        <StackPanel Margin="6,8,0,0"><GroupBox Header="主控只读诊断">
                        <StackPanel>
                            <TextBlock Text="命令白名单固定；不允许任意 CMD / 原始写入 / CAN TX" Foreground="{StaticResource Subtle}" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding ReadOnlyCommands}" SelectedItem="{Binding SelectedReadOnlyCommand,Mode=TwoWay}"
                                      Height="32"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                <TextBlock Text="超时（毫秒）" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding TimeoutMs,UpdateSourceTrigger=PropertyChanged}" Width="90"
                                         Padding="6" VerticalContentAlignment="Center"/>
                                <Button Content="执行只读请求" Command="{Binding ReadCommand}" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="返回状态与 GPIO 均仅代表固件响应，不能证明实际 IGN、电源、夹具状态。"
                                       Foreground="{StaticResource Subtle}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </GroupBox>
<GroupBox Header="连接故障详情">
                        <StackPanel>
                            <TextBlock Text="最近阶段" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LastNativeStage}" Margin="0,3,0,9" FontFamily="Consolas"/>
                            <TextBlock Text="Win32 失败码 / 详情" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding NativeFailure}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </GroupBox></StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#FFFFFF" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="5"
                        Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="连接状态与操作反馈" FontWeight="Bold" FontSize="14" Margin="0,0,0,7"/>
                        <TextBox Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="#ECF2F8" BorderThickness="0" MinHeight="65" MaxHeight="105"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
                <TabControl x:Name="DevicePages" Grid.Row="1" BorderBrush="{StaticResource Outline}" Background="White">
                    <TabItem Header="USB 连接事件">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,9">
                                <Button DockPanel.Dock="Right" Content="复制选中" Command="{Binding CopyUsbCommand}" Margin="10,0,0,0"/>
                                <TextBox Text="{Binding UsbFilter,UpdateSourceTrigger=PropertyChanged}" Padding="7"
                                         ToolTip="仅过滤当前窗口，原始 JSONL 不受影响"/>
                            </DockPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding UsbView}"
                                     SelectedItem="{Binding SelectedUsbLine,Mode=TwoWay}"
                                     ItemTemplate="{StaticResource TimelineItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            <TextBlock Grid.Row="2" Text="{Binding TraceStats}" Foreground="{StaticResource Subtle}" Margin="0,8,0,0"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="CAN 按 ID 实时监视">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="真实 CAN0 / CAN1 · 按通道、11/29-bit 和报文 ID 合并刷新，保留完整原始 Trace；每个设备会话独立计数。"
                                       Foreground="{StaticResource Subtle}" Margin="0,0,0,10"/>
                            <DataGrid x:Name="R1CanIdsGrid" Grid.Row="1"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" RowHeaderWidth="0"
                                      Background="#FFFFFF" Foreground="#203249"
                                      RowBackground="#FFFFFF" AlternatingRowBackground="#ECF2F8"
                                      BorderBrush="{StaticResource Outline}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CAN 通道" Binding="{Binding Channel}" Width="110"/>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                                    <DataGridTextColumn Header="帧格式" Binding="{Binding Format}" Width="75"/>
                                    <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="50"/>
                                    <DataGridTextColumn Header="DATA / HEX（最新）" Binding="{Binding DataHex}" Width="*"/>
                                    <DataGridTextColumn Header="周期 ms" Binding="{Binding PeriodMs}" Width="90"/>
                                    <DataGridTextColumn Header="接收次数" Binding="{Binding Count}" Width="90"/>
                                    <DataGridTextColumn Header="累计丢帧" Binding="{Binding LostFrames}" Width="80"/>
                                    <DataGridTextColumn Header="最近时间" Binding="{Binding LastTime}" Width="100"/>
                                    <DataGridTextColumn Header="会话" Binding="{Binding Generation}" Width="65"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="CAN0 / CAN1 接收流水">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding CanStats}" FontWeight="SemiBold" Margin="0,0,0,9"/>
                            <DockPanel Grid.Row="1" Margin="0,0,0,9">
                                <Button DockPanel.Dock="Right" Content="复制选中" Command="{Binding CopyCanCommand}" Margin="10,0,0,0"/>
                                <TextBox Text="{Binding CanFilter,UpdateSourceTrigger=PropertyChanged}" Padding="7"
                                         ToolTip="按 CAN 角色、port、HEX、GEN 筛选显示，不影响原始录制"/>
                            </DockPanel>
                            <ListBox Grid.Row="2" ItemsSource="{Binding CanView}"
                                     SelectedItem="{Binding SelectedCanLine,Mode=TwoWay}"
                                     ItemTemplate="{StaticResource TimelineItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="GPIO 回读（仅供诊断）">
                        <ScrollViewer Margin="20" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="仅显示主控固件回读值，不代表实际电压、夹具位置或 ECU 已上电"
                                           FontSize="15" FontWeight="Bold" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="IGN GPIO" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IgnReadback}" Margin="0,0,0,14"/>
                                    <TextBlock Grid.Row="1" Text="ECU 电源 GPIO" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EcuPowerReadback}" Margin="0,0,0,14"/>
                                    <TextBlock Grid.Row="2" Text="按键板电源 GPIO" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding KeyPowerReadback}" Margin="0,0,0,14"/>
                                    <TextBlock Grid.Row="3" Text="夹具 GPIO" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SolenoidReadback}" Margin="0,0,0,14"/>
                                    <TextBlock Grid.Row="4" Text="电源汇总 GPIO" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AllPowerReadback}" Margin="0,0,0,14"/>
                                </Grid>
                                <TextBlock Text="使用左侧的固定只读命令逐项回读。任意断连后旧回读立即失效。实际电压必须由操作者独立测量，软件 GPIO 返回值不能替代万用表。"
                                           Foreground="{StaticResource Subtle}" Margin="0,17,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="诊断记录与导出">
                        <StackPanel Margin="20">
                            <TextBlock Text="主控原始 WinUSB / USB SEQ / CAN JSONL" FontWeight="Bold"/>
                            <TextBox Text="{Binding TraceFile, Mode=OneWay}" IsReadOnly="True" Margin="0,7,0,18" TextWrapping="Wrap"/>
                            <TextBlock Text="连接与操作记录（JSONL）" FontWeight="Bold"/>
                            <TextBox Text="{Binding OperationLogFile, Mode=OneWay}" IsReadOnly="True" Margin="0,7,0,18" TextWrapping="Wrap"/>
                            <TextBlock Text="导出的设备日志与操作记录可按时间和会话进行关联。时间为电脑接收时间，非 CAN 硬件时间戳。"
                                       Foreground="{StaticResource Subtle}"/>
                            <TextBlock Text="导出完整诊断记录（需先断开主控连接）" FontWeight="Bold" Margin="0,18,0,5"/>
                            <TextBox Text="{Binding ExportPath,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                     Padding="7" TextWrapping="Wrap"/>
                            <Button Content="导出 ZIP + SHA-256 完整诊断包" Command="{Binding ExportCommand}"
                                    HorizontalAlignment="Left" Margin="0,9,0,8"/>
                            <TextBox Text="{Binding ExportResult, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     MinHeight="60" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Subtle}"
                                       Text="ZIP 含未修改的 USB/CAN 与操作 JSONL、SHA-256 和来源/丢帧/时钟质量清单。原始报文可能含敏感 ECU 信息，仅保存本地，不自动上传；不代表真实硬件测试通过。"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Margin="0,12,0,0" Background="#D9EBFD" CornerRadius="4" Padding="9">
            <TextBlock Text="CAN0：按键板 · CAN1：被测 ECU · GPIO 回读仅供诊断，不能替代电气实测"
                       Foreground="#D4E7F8" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
