<UserControl x:Class="AutoTest.Desktop.Shell.ProductionInspectionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12"
 Background="#F6F8FA" Foreground="#263847">
 <UserControl.Resources>
  <Style x:Key="LabelCaption" TargetType="{x:Type TextBlock}">
   <Setter Property="Foreground" Value="#718093"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
 </UserControl.Resources>

 <!-- Stage-adaptive read-only operator display. Actual test details appear
      only when an observed step supplies evidence; idle has no empty rail. -->
 <Grid Margin="11,9,11,10">
  <Grid.RowDefinitions>
   <RowDefinition Height="94"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <!-- Do not display source project names, revisions, provenance or filenames. -->
  <Border Grid.Row="0" Background="White" CornerRadius="5"
   BorderBrush="#DDE4EC" BorderThickness="1" Margin="0,0,0,9"
   Padding="14,8">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="2*"/>
     <ColumnDefinition Width="1.2*"/>
     <ColumnDefinition Width="2*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="最近扫码原文" Style="{StaticResource LabelCaption}"/>
     <TextBlock Text="{Binding LastScannerRaw}" FontSize="17" FontWeight="SemiBold"
      Margin="0,3,12,0" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding LastScannerDiagnostic}" Foreground="#235B8B"/>
     <TextBlock Text="{Binding DutSerial,StringFormat='已核对编号：{0}'}"
      FontSize="11" Margin="0,3,12,0" Foreground="#52677D"
      TextTrimming="CharacterEllipsis" ToolTip="{Binding DutSerial}"/>
    </StackPanel>
    <StackPanel Grid.Column="1">
     <TextBlock Text="ECU 型号" Style="{StaticResource LabelCaption}"/>
     <TextBlock Text="{Binding ProjectName}" FontSize="13"
      FontWeight="SemiBold" Margin="0,5,12,0"
      TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="当前状态" Style="{StaticResource LabelCaption}"/>
     <TextBlock Text="{Binding StatusSummary}" FontSize="14"
      FontWeight="SemiBold" Foreground="#346D9C" Margin="0,4,0,0"
      TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusSummary}"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="7*" MinWidth="440"/>
    <ColumnDefinition Width="9"/>
    <ColumnDefinition Width="{Binding EvidenceColumnWidth}" MinWidth="0"/>
   </Grid.ColumnDefinitions>

   <!-- One dense, read-only, non-navigational execution list. -->
   <Border Grid.Column="0" CornerRadius="5" Background="White"
    BorderBrush="#DDE4EC" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="37"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="12,0,13,0">
      <TextBlock DockPanel.Dock="Right" Text="{Binding EnabledCaseCount,StringFormat='共 {0} 项'}"
       FontSize="11" Foreground="#73869A" VerticalAlignment="Center"/>
      <TextBlock Text="测试项目" FontWeight="SemiBold"
       FontSize="13" VerticalAlignment="Center"/>
     </DockPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Cases}"
      Visibility="{Binding HasCases,Converter={StaticResource BoolToVisibility}}"
      IsReadOnly="True" AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False"
      CanUserResizeColumns="False" CanUserReorderColumns="False"
      CanUserSortColumns="False" SelectionUnit="FullRow"
      Focusable="False" IsTabStop="False"
      RowHeight="31" ColumnHeaderHeight="29"
      RowHeaderWidth="0" HeadersVisibility="Column"
      GridLinesVisibility="Horizontal"
      HorizontalGridLinesBrush="#ECF0F4"
      BorderThickness="0" Background="White"
      AlternatingRowBackground="#FAFBFC"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      VirtualizingPanel.IsVirtualizing="True">
      <DataGrid.RowStyle>
       <Style TargetType="{x:Type DataGridRow}">
        <!-- No click-to-select affordance; execution moves the state, not the mouse. -->
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="White"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding State}" Value="执行中">
          <Setter Property="Background" Value="#EDF4FC"/>
         </DataTrigger>
         <DataTrigger Binding="{Binding State}" Value="研发执行中">
          <Setter Property="Background" Value="#EDF4FC"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
       <DataGridTextColumn Header="序号" Binding="{Binding IndexLabel}" Width="67"/>
       <DataGridTextColumn Header="测试项目" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="执行状态" Binding="{Binding State}" Width="132"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border Grid.Row="1" Visibility="{Binding HasCaseListIssue,Converter={StaticResource BoolToVisibility}}"
      Background="#FCFDFE" Padding="24">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="450">
       <TextBlock Text="当前没有可执行测试项目" TextAlignment="Center"
        FontSize="16" FontWeight="SemiBold" Foreground="#40566B"/>
       <TextBlock Text="{Binding CaseListHint}" TextAlignment="Center"
        TextWrapping="Wrap" Foreground="#6C7F94" FontSize="12"
        Margin="0,12,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>

   <!-- Automatically follows the actual executing step: no selection and no disclosures. -->
   <Border Grid.Column="2" CornerRadius="5" Background="White"
    Visibility="{Binding ShowEvidenceDetails,Converter={StaticResource BoolToVisibility}}"
    BorderBrush="#DDE4EC" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="37"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <Border Grid.Row="0" BorderBrush="#E7EDF2" BorderThickness="0,0,0,1">
      <TextBlock Text="当前测试" FontWeight="SemiBold" FontSize="13"
       VerticalAlignment="Center" Margin="13,0,0,0"/>
     </Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="13,13,13,16">
       <TextBlock Text="测试用例" Style="{StaticResource LabelCaption}"/>
       <TextBlock Text="{Binding CurrentCaseName}" FontSize="15"
        FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,13"/>
       <TextBlock Text="当前步骤" Style="{StaticResource LabelCaption}"/>
       <TextBlock Text="{Binding CurrentStepName}" FontSize="14"
        FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,5"/>
       <TextBlock Text="{Binding CurrentStepStatus}" Foreground="#346D9C"
        FontSize="12" Margin="0,0,0,13"/>
       <Border Height="1" Background="#E7EDF2" Margin="0,0,0,13"/>
       <TextBlock Text="实际测量" Style="{StaticResource LabelCaption}"/>
       <TextBlock Text="{Binding CurrentMeasurement}" FontSize="16"
        FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#283D50"
        Margin="0,4,0,16"/>
       <TextBlock Text="预期与判据" Style="{StaticResource LabelCaption}"/>
       <TextBlock Text="{Binding CurrentExpected}" FontSize="12"
        TextWrapping="Wrap" Foreground="#344C60" Margin="0,4,0,16"/>
       <TextBlock Text="步骤信息 / 失败原因" Style="{StaticResource LabelCaption}"/>
       <TextBlock Text="{Binding CurrentFailure}" TextWrapping="Wrap"
        FontSize="12" Foreground="#344C60" Margin="0,4,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
