<UserControl x:Class="AutoTest.Desktop.Tools.Testing.R1ProjectRunView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F5F7FA" Foreground="#213247" FontFamily="Segoe UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Ink" Color="#213247"/>
  <SolidColorBrush x:Key="Muted" Color="#66788C"/>
  <SolidColorBrush x:Key="Outline" Color="#DBE3ED"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#29415A"/>
   <Setter Property="BorderBrush" Value="#C9D7E6"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="MinHeight" Value="30"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Margin" Value="0,0,0,0"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Outline}"/><Setter Property="RowBackground" Value="#FFFFFF"/>
   <Setter Property="AlternatingRowBackground" Value="#F6F9FC"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#E6ECF3"/>
   <Setter Property="ColumnHeaderHeight" Value="34"/><Setter Property="RowHeight" Value="34"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F1F5F9"/><Setter Property="Foreground" Value="#52687E"/>
   <Setter Property="BorderBrush" Value="#DBE3ED"/><Setter Property="Padding" Value="9,5"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="8,4"/></Style>
  <Style TargetType="TreeView">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="250"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="实际判定" Foreground="{StaticResource Muted}" Margin="0,0,9,0" VerticalAlignment="Center"/>
    <Border Background="#EAF0F6" BorderBrush="#D6E1ED" BorderThickness="1" CornerRadius="4" Padding="12,6">
     <TextBlock Text="{Binding Verdict}" FontWeight="Bold" Foreground="#28527A" FontSize="14"/>
    </Border>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="自动测试" FontWeight="SemiBold" FontSize="23"/>
    <TextBlock Text="{Binding DocumentName}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding ProjectAssetStatus}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Outline}"
    BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,12">
   <StackPanel>
    <WrapPanel>
     <Button Content="检查运行条件" Command="{Binding PreflightCommand}"/>
     <Button Content="▶ 运行全部用例" Command="{Binding RunPhysicalReadOnlyCommand}"
        Background="#176CB5" Foreground="White" FontWeight="SemiBold"/>
     <Button Content="▶ 按勾选运行" Command="{Binding RunSelectedPhysicalCommand}"
        Background="#E8F2FF" Foreground="#135A99" FontWeight="SemiBold"/>
     <Button Content="暂停" Command="{Binding PauseCommand}"/>
     <Button Content="继续" Command="{Binding ResumeCommand}"/>
     <Button Content="单步" Command="{Binding StepCommand}"/>
     <Button Content="停止" Command="{Binding StopCommand}" Foreground="#B43C45"/>
    </WrapPanel>
    <TextBlock Text="开发验证可按测试用例选择执行；扫码触发的正式检测始终使用完整已发布程序，不读取勾选状态。仅执行现有已授权的真实步骤。"
     FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,7,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="315" MinWidth="245"/>
    <ColumnDefinition Width="5"/>
    <ColumnDefinition Width="*" MinWidth="390"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="5">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F4F7FB" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1" Padding="11">
      <StackPanel>
       <DockPanel>
        <TextBlock Text="运行范围 · 测试用例" FontSize="13" FontWeight="SemiBold"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <Button Content="全选" Command="{Binding SelectAllCasesCommand}" Padding="7,3" MinHeight="23" Margin="0,0,5,0"/>
         <Button Content="清空" Command="{Binding ClearCasesCommand}" Padding="7,3" MinHeight="23" Margin="0"/>
        </StackPanel>
       </DockPanel>
       <TextBlock Text="勾选一个或多个测试用例；不是逐条选择底层动作" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ItemsControl Grid.Row="0" ItemsSource="{Binding TestCases}" Margin="11,10,11,8">
       <ItemsControl.Style>
        <Style TargetType="ItemsControl">
         <Style.Triggers>
          <DataTrigger Binding="{Binding Busy}" Value="True">
           <Setter Property="IsEnabled" Value="False"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </ItemsControl.Style>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="#E7ECF3" BorderThickness="0,0,0,1" Padding="0,7">
          <DockPanel>
           <TextBlock DockPanel.Dock="Right" Text="{Binding StepCount, StringFormat={}{0} 步骤}" FontSize="11"
              Foreground="#798A9D" VerticalAlignment="Center"/>
           <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             ToolTip="仅控制工程调试中的本次用例选择">
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="170"/>
           </CheckBox>
          </DockPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <DockPanel Grid.Row="1" Margin="9,4,9,9">
       <TextBlock DockPanel.Dock="Top" Text="程序步骤结构 / Prepare · Test · Cleanup"
         FontWeight="SemiBold" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,0,0,8"/>
       <TreeView ItemsSource="{Binding Tree}" SelectedItemChanged="StepTree_SelectionChanged"
         Background="White" Foreground="{StaticResource Ink}" BorderThickness="0"/>
      </DockPanel>
     </Grid>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Background="#D9E2EE" HorizontalAlignment="Stretch"/>
   <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="5">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F4F7FB" BorderBrush="{StaticResource Outline}" BorderThickness="0,0,0,1" Padding="12,10">
      <DockPanel>
       <TextBlock DockPanel.Dock="Right" Text="同一 RunId · 来源/质量/时间戳/原始 Trace" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
       <TextBlock Text="TEST 执行事实 · 预期 / 实际 / 判定" FontSize="13" FontWeight="SemiBold"/>
      </DockPanel>
     </Border>
     <DataGrid ItemsSource="{Binding Facts}" AutoGenerateColumns="False" IsReadOnly="True"
       CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
       EnableRowVirtualization="True" EnableColumnVirtualization="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="阶段" Binding="{Binding Phase}" Width="65"/>
       <DataGridTextColumn Header="步骤" Binding="{Binding NodeType}" Width="110"/>
       <DataGridTextColumn Header="预期" Binding="{Binding Expected}" Width="*"/>
       <DataGridTextColumn Header="实际" Binding="{Binding Actual}" Width="*"/>
       <DataGridTextColumn Header="判定" Binding="{Binding Verdict}" Width="95"/>
       <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="95"/>
       <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="90"/>
       <DataGridTextColumn Header="耗时/时间" Binding="{Binding AtUtc,StringFormat=HH:mm:ss.fff}" Width="110"/>
       <DataGridTextColumn Header="原始证据" Binding="{Binding TraceReference}" Width="150"/>
       <DataGridTextColumn Header="错误/NRC" Binding="{Binding Diagnostic}" Width="1.4*"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="#F0F5FB" BorderBrush="#D6E1ED" BorderThickness="1"
   CornerRadius="5" Padding="12,9" Margin="0,12,0,0">
   <StackPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12"/>
    <TextBlock Text="{Binding PhysicalEvidencePath, StringFormat=运行证据：{0}}"
      Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
    <TextBlock Text="提示：这里显示真实执行的事实；无 ECU 观测不能生成 PASS，当前不签发正式出厂放行。"
      Foreground="#8C641F" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
