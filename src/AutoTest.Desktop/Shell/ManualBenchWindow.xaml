<Window x:Class="AutoTest.Desktop.Shell.ManualBenchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:AutoTest.Desktop.Shell"
 Title="AutoTest · 手动台架" Width="1440" Height="860" MinWidth="1090" MinHeight="680"
 WindowStartupLocation="CenterOwner" WindowState="Maximized" Background="#F6F8FB"
 FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="#223A57">
 <Window.Resources>
  <Style x:Key="BenchHeader" TargetType="TextBlock">
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#263C53"/>
  </Style>
  <Style x:Key="BenchHint" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="#61758A"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="BenchCard" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DCE5EF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="13"/>
  </Style>
  <Style x:Key="BenchKey" TargetType="CheckBox">
   <Setter Property="Padding" Value="9,8"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style x:Key="FieldCaption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#617B98"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="0,9,0,4"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="55"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="37"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="White" BorderBrush="#DCE5EF" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,10" LastChildFill="True">
    <ui:Button DockPanel.Dock="Right" Content="{Binding ConnectionActionLabel}" Command="{Binding ConnectCommand}"
      Appearance="Primary" Padding="15,8" Margin="9,0,0,0"/>
    <ui:Button DockPanel.Dock="Right" Content="刷新资源" Command="{Binding ReloadProfilesCommand}"
      Padding="12,7" Margin="9,0,0,0"/>
    <StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="手动台架" Style="{StaticResource BenchHeader}" FontSize="17"
       VerticalAlignment="Center" Margin="0,0,12,0"/>
      <Border Background="#EDF2F7" Padding="10,5" CornerRadius="12" ToolTip="{Binding ConnectionStatus}">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="●" Foreground="#72889F" Margin="0,0,6,0"/>
        <TextBlock>
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Text" Value="USB 未连接"/>
           <Setter Property="Foreground" Value="#4B6279"/>
           <Setter Property="FontSize" Value="11"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="True">
             <Setter Property="Text" Value="USB 已连接"/>
             <Setter Property="Foreground" Value="#267850"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </StackPanel>
      </Border>
     </StackPanel>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="1" Margin="12,12,12,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="41*" MinWidth="345"/>
     <ColumnDefinition Width="24*" MinWidth="315"/>
     <ColumnDefinition Width="35*" MinWidth="340"/>
   </Grid.ColumnDefinitions>

   <!-- LEFT: SEND list is the one permanent complete raw-frame view;
        editing appears in a short-lived floating popup, not below the list. -->
   <Border Grid.Column="0" Style="{StaticResource BenchCard}" Margin="0,0,9,0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,9">
      <DockPanel Margin="0,0,0,8">
       <TextBlock Text="ECU CAN 发送" Style="{StaticResource BenchHeader}"/>
       <TextBlock DockPanel.Dock="Right" Text="双击快速编辑 · 右键属性"
        FontSize="11" Foreground="#65788F" Margin="8,0,0,0"/>
      </DockPanel>
      <WrapPanel>
       <ui:Button Content="+ 报文" Click="AddCanRow_Click" Padding="9,6" Margin="0,0,5,5"
        ToolTip="新增一条报文并立即打开快捷编辑浮层"/>
       <Button Content="复制" Command="{Binding CopyCanRowCommand}" Padding="9,6" Margin="0,0,5,5"/>
       <Button Content="删除" Command="{Binding DeleteCanRowCommand}" Padding="9,6" Margin="0,0,5,5"/>
       <Button Content="↑" Command="{Binding MoveCanRowUpCommand}" Padding="8,6" Margin="0,0,4,5"/>
       <Button Content="↓" Command="{Binding MoveCanRowDownCommand}" Padding="8,6" Margin="0,0,9,5"/>
       <ui:Button Content="发送勾选" Command="{Binding StartCanRowsCommand}"
         Appearance="Primary" Padding="10,6" Margin="0,0,6,5"
        ToolTip="对所有勾选报文各发送一次。ECU CAN 周期发送目前不可用。"/>
       <Button Content="停止" Command="{Binding StopCanRowsCommand}" Padding="9,6" Margin="0,0,5,5"/>
      </WrapPanel>
     </StackPanel>
     <DataGrid x:Name="CanSendGrid" Grid.Row="1"
      ItemsSource="{Binding CanSendRows}" SelectedItem="{Binding SelectedCanRow,Mode=TwoWay}"
      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
      IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
      GridLinesVisibility="Horizontal" BorderBrush="#E2EAF3"
      RowHeight="40" ColumnHeaderHeight="34" FontSize="12"
      EnableRowVirtualization="True" EnableColumnVirtualization="True"
      Background="White" AlternatingRowBackground="#F7FAFD"
      MouseDoubleClick="CanSendGrid_MouseDoubleClick"
      PreviewMouseRightButtonDown="CanSendGrid_RightClick"
      ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.ContextMenu>
       <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
        <MenuItem Header="属性 / 完整编辑…" Click="CanProperties_Click"/>
        <MenuItem Header="快速编辑" Click="CanQuickEditMenu_Click"/>
        <Separator/>
        <MenuItem Header="新增报文" Command="{Binding AddCanRowCommand}"/>
        <MenuItem Header="复制" Command="{Binding CopyCanRowCommand}"/>
        <MenuItem Header="删除" Command="{Binding DeleteCanRowCommand}"/>
       </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="选" Width="32">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <CheckBox IsChecked="{Binding Included,Mode=TwoWay}" IsEnabled="{Binding CanToggleIncluded}"
          HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <!-- Inline name edit uses the same BenchCanRow as the Flyout and physical sender. -->
        <DataGridTemplateColumn Header="报文" Width="118" MinWidth="100">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <TextBox Text="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"
            IsEnabled="{Binding CanEditFields}" MinHeight="28" Padding="5,2"
            BorderThickness="0" Background="Transparent"
            VerticalContentAlignment="Center" ToolTip="直接修改名称；修改不会发送 CAN 帧"/>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       <!-- Raw CAN IDs are edited directly; DBC-generated IDs stay read-only. -->
        <DataGridTemplateColumn Header="CAN ID" Width="98">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <Grid>
            <TextBox Text="{Binding IdHex,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"
             IsEnabled="{Binding CanEditFields}" MinHeight="27" BorderThickness="0"
             Background="Transparent" Padding="3,2" ToolTip="{Binding PreviewError}">
             <TextBox.Style>
              <Style TargetType="TextBox">
               <Setter Property="Visibility" Value="Visible"/>
               <Style.Triggers><DataTrigger Binding="{Binding UseDbc}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
               </DataTrigger></Style.Triggers>
              </Style>
             </TextBox.Style>
            </TextBox>
            <TextBlock Text="{Binding PreviewId}" VerticalAlignment="Center">
             <TextBlock.Style>
              <Style TargetType="TextBlock">
               <Setter Property="Visibility" Value="Collapsed"/>
               <Style.Triggers><DataTrigger Binding="{Binding UseDbc}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
               </DataTrigger></Style.Triggers>
              </Style>
             </TextBlock.Style>
            </TextBlock>
           </Grid>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       <DataGridTextColumn Header="DLC" Binding="{Binding PreviewDlc}" Width="40"/>
       <DataGridTemplateColumn Header="完整 Data (HEX)" Width="*" MinWidth="198">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <Grid>
            <TextBox Text="{Binding DataHex,Mode=TwoWay,UpdateSourceTrigger=LostFocus}"
             IsEnabled="{Binding CanEditFields}" FontFamily="Consolas" FontSize="12"
             MinHeight="27" BorderThickness="0" Padding="4,2" Background="Transparent"
             ToolTip="{Binding PreviewError}">
             <TextBox.Style>
              <Style TargetType="TextBox">
               <Setter Property="Visibility" Value="Visible"/>
               <Style.Triggers><DataTrigger Binding="{Binding UseDbc}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
               </DataTrigger></Style.Triggers>
              </Style>
             </TextBox.Style>
            </TextBox>
            <TextBlock Text="{Binding PreviewData}" FontFamily="Consolas" FontSize="12"
             VerticalAlignment="Center" ToolTip="{Binding PreviewFull}">
             <TextBlock.Style>
              <Style TargetType="TextBlock">
               <Setter Property="Visibility" Value="Collapsed"/>
               <Style.Triggers><DataTrigger Binding="{Binding UseDbc}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
               </DataTrigger></Style.Triggers>
              </Style>
             </TextBlock.Style>
            </TextBlock>
           </Grid>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       <DataGridTextColumn Header="发送" Binding="{Binding ModeLabel}" Width="66"/>
       <DataGridTemplateColumn Header="操作" Width="100">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="单发" Padding="6,5" Margin="0,0,4,0"
           Command="{Binding DataContext.SendCanRowOnceCommand,RelativeSource={RelativeSource AncestorType=Window}}"
           CommandParameter="{Binding}" ToolTip="发送该行当前完整帧，USB ACK 写入操作日志"/>
          <Button Content="改值" Padding="6,5" Tag="{Binding}" Click="OpenCanQuickEdit_Click"
           ToolTip="在报文旁临时打开编辑浮层，点外部自动收起"/>
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <!-- A WPF Popup has no layout footprint and closes when clicking outside.
          The raw data appears ONCE in the persistent table; this edits fields. -->
     <Popup x:Name="CanQuickPopup" Placement="Right" StaysOpen="False"
      AllowsTransparency="True" PopupAnimation="Fade"
      DataContext="{Binding SelectedCanRow}">
      <Border Width="410" MaxHeight="590" BorderBrush="#A8BBD1" BorderThickness="1"
       CornerRadius="9" Background="White" Padding="14">
       <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
       <DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,10">
         <Button DockPanel.Dock="Right" Content="×" Width="27" Height="27"
          Click="CloseCanQuickEdit_Click" ToolTip="关闭快速编辑"/>
         <TextBlock Text="快速编辑 CAN 报文" FontSize="16" FontWeight="SemiBold"
          Foreground="#24496C" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom"
         Text="离开浮层即收起；有效编辑留在待发送草稿中，不会自动发往 ECU。右键报文 → 属性可编辑全部字段。"
         FontSize="11" Foreground="#617B94" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <ScrollViewer MaxHeight="485" VerticalScrollBarVisibility="Auto">
         <StackPanel IsEnabled="{Binding CanEditFields}">
          <TextBlock Text="名称" Style="{StaticResource FieldCaption}"/>
          <TextBox Text="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           MinHeight="32" Padding="7,6"/>
          <CheckBox Content="使用工程 DBC" IsChecked="{Binding UseDbc,Mode=TwoWay}"
           Margin="0,10,0,2"/>
          <StackPanel Visibility="{Binding UseDbc,Converter={StaticResource BoolToVisibility}}">
           <TextBlock Text="DBC 报文" Style="{StaticResource FieldCaption}"/>
           <ComboBox ItemsSource="{Binding DbcChoices}" SelectedItem="{Binding DbcMessage,Mode=TwoWay}"
            DisplayMemberPath="Display" MinHeight="33"/>
          </StackPanel>
          <StackPanel Visibility="{Binding IsRaw,Converter={StaticResource BoolToVisibility}}">
           <TextBlock Text="CAN ID (HEX)" Style="{StaticResource FieldCaption}"/>
           <TextBox Text="{Binding IdHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
             Padding="7,6" MinHeight="32"/>
           <TextBlock Text="Data (HEX，0～8 字节)" Style="{StaticResource FieldCaption}"/>
           <TextBox Text="{Binding DataHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
             FontFamily="Consolas" FontSize="14" Padding="8,7" MinHeight="35"
             ToolTip="例如 01 02 03 04 05 06 07 08。完整编码结果同步显示在发送主列表。"/>
          </StackPanel>
          <StackPanel Visibility="{Binding UseDbc,Converter={StaticResource BoolToVisibility}}">
           <TextBlock Text="DBC 信号值（编辑后实时编码至主列表）" Style="{StaticResource FieldCaption}"/>
           <ItemsControl ItemsSource="{Binding SignalValues}">
            <ItemsControl.ItemTemplate><DataTemplate>
             <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="155"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
               <TextBlock Text="{Binding DisplayName}" FontSize="12"
                FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Definition}"/>
               <TextBlock Text="{Binding Range}" FontSize="10" Foreground="#66809A"/>
              </StackPanel>
              <Grid Grid.Column="1" Margin="6,0,0,0">
               <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                Padding="7,6" FontSize="13">
                <TextBox.Style><Style TargetType="TextBox">
                 <Setter Property="Visibility" Value="Visible"/>
                 <Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                 </DataTrigger></Style.Triggers>
                </Style></TextBox.Style>
               </TextBox>
               <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                SelectedValuePath="Value" SelectedValue="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                MinHeight="32">
                <ComboBox.Style><Style TargetType="ComboBox">
                 <Setter Property="Visibility" Value="Collapsed"/>
                 <Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                 </DataTrigger></Style.Triggers>
                </Style>
                </ComboBox.Style>
               </ComboBox>
              </Grid>
             </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
           </ItemsControl>
          </StackPanel>
         </StackPanel>
        </ScrollViewer>
       </DockPanel>
      </Border>
     </Popup>
    </Grid>
   </Border>

   <!-- CENTER: priority order is real station IO then reusable KEY actions. -->
   <Border Grid.Column="1" Style="{StaticResource BenchCard}" Margin="0,0,9,0">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="工位控制" Style="{StaticResource BenchHeader}"/>
      
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="7"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="7"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Border Grid.Column="0" BorderBrush="#DCE6F2" BorderThickness="1"
        Background="#F9FBFE" CornerRadius="6" Padding="7">
        <StackPanel>
         <TextBlock Text="IGN" FontWeight="SemiBold" Foreground="#2C527D" Margin="0,0,0,5"/>
          <TextBlock Text="{Binding IgnGpioLabel}" FontSize="10" Foreground="#60758C" Margin="0,0,0,6" ToolTip="{Binding LastIgnAck}"/>
         <Button Content="ON" Click="IgnOn_Click" IsEnabled="{Binding CanInvokeManualIo}" Margin="0,0,0,4" MinHeight="30"/>
         <Button Content="OFF" Click="IgnOff_Click" IsEnabled="{Binding CanInvokeManualIo}" MinHeight="30"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="2" BorderBrush="#DCE6F2" BorderThickness="1"
        Background="#F9FBFE" CornerRadius="6" Padding="7">
        <StackPanel>
         <TextBlock Text="夹具 1 · B5" FontWeight="SemiBold" Foreground="#2C527D" Margin="0,0,0,5"/>
          <TextBlock Text="{Binding Clamp1GpioLabel}" FontSize="10" Foreground="#60758C" Margin="0,0,0,6" ToolTip="{Binding LastClampStatus}"/>
         <Button Content="压紧" Click="Clamp1Press_Click" IsEnabled="{Binding CanInvokeManualIo}" Margin="0,0,0,4" MinHeight="30"/>
         <Button Content="释放" Click="Clamp1Release_Click" IsEnabled="{Binding CanInvokeManualIo}" MinHeight="30"/>
        </StackPanel>
       </Border>
       <Border Grid.Column="4" BorderBrush="#DCE6F2" BorderThickness="1"
        Background="#F9FBFE" CornerRadius="6" Padding="7">
        <StackPanel>
         <TextBlock Text="夹具 2 · B4" FontWeight="SemiBold" Foreground="#2C527D" Margin="0,0,0,5"/>
          <TextBlock Text="{Binding Clamp2GpioLabel}" FontSize="10" Foreground="#60758C" Margin="0,0,0,6" ToolTip="{Binding LastClampStatus}"/>
         <Button Content="压紧" Click="Clamp2Press_Click" IsEnabled="{Binding CanInvokeManualIo}" Margin="0,0,0,4" MinHeight="30"/>
         <Button Content="释放" Click="Clamp2Release_Click" IsEnabled="{Binding CanInvokeManualIo}" MinHeight="30"/>
        </StackPanel>
       </Border>
      </Grid>
      <DockPanel Margin="0,8,0,0">
       <Button DockPanel.Dock="Right" Content="读夹具 GPIO" Command="{Binding ReadClampsCommand}"
        Padding="8,5" Margin="6,0,0,0"/>
       <Button DockPanel.Dock="Right" Content="读 IGN" Command="{Binding ReadIgnCommand}"
        Padding="8,5" Margin="6,0,0,0"/>
       
      </DockPanel>
      
      
      <Border BorderBrush="#E5ECF4" BorderThickness="0,1,0,0" Margin="0,12,0,10"/>
      <DockPanel Margin="0,0,0,8">
       <TextBlock DockPanel.Dock="Left" Text="KEY CAN · 按键动作" Style="{StaticResource BenchHeader}" FontSize="14"/>
       
      </DockPanel>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel>
   <DockPanel Margin="0,0,0,9">
    <Button DockPanel.Dock="Right" Content="保存动作库" Command="{Binding SaveKeyActionsCommand}"
     Style="{StaticResource AtPrimaryButton}" Padding="9,6" Margin="6,0,0,0"/>
    <Button DockPanel.Dock="Right" Content="+ 新建动作" Command="{Binding AddKeyActionCommand}"
     Padding="9,6" Margin="6,0,0,0"/>
    <Border Background="#EDF2F7" CornerRadius="10" Padding="9,4"
     VerticalAlignment="Center" ToolTip="{Binding KeyCatalogRevisionLabel}">
     <TextBlock Text="{Binding KeyLibraryState}" FontWeight="SemiBold" Foreground="#425E77" FontSize="11"/>
    </Border>
   </DockPanel>
   
   <ItemsControl ItemsSource="{Binding KeyActions}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border BorderThickness="1" BorderBrush="#CFDFF0" Background="#F8FBFF"
       CornerRadius="7" Margin="0,0,6,7" Padding="7">
       <StackPanel>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#244E74"
         TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
        <TextBlock Text="{Binding Summary}" Foreground="#60758C" FontSize="10"
         TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
         <Button Content="运行" Tag="{Binding}" Click="RunKeyAction_Click"
          PreviewMouseRightButtonUp="EditKeyAction_RightClick"
          IsEnabled="{Binding DataContext.CanRunKeyAction,RelativeSource={RelativeSource AncestorType=Window}}"
          Padding="9,4" Margin="0,0,5,0" ToolTip="运行已保存的按键动作；未连接 USB 时直接在状态和日志中提示"/>
         <Button Content="编辑" Tag="{Binding}" Click="SelectKeyAction_Click" Padding="9,4"/>
        </StackPanel>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   
   <StackPanel x:Name="KeyEditorSection"
    Visibility="{Binding IsKeyEditorExpanded,Converter={StaticResource BoolToVisibility}}">
   <Border BorderBrush="#E5ECF4" BorderThickness="0,1,0,0" Margin="0,8,0,10"/>
   <DockPanel Margin="0,0,0,8">
    <Button DockPanel.Dock="Right" Content="完成" Click="CloseKeyEditor_Click"
     Padding="8,5" Margin="4,0,0,0"/>
    <Button DockPanel.Dock="Right" Content="复制动作" Command="{Binding CopyKeyActionCommand}"
     Padding="8,5" Margin="4,0,0,0"/>
    <Button DockPanel.Dock="Right" Content="删除动作" Command="{Binding DeleteKeyActionCommand}"
     Padding="8,5" Margin="4,0,0,0"/>
    <TextBlock Text="动作编辑" Foreground="#2C527D" FontSize="13" FontWeight="SemiBold"
     VerticalAlignment="Center"/>
   </DockPanel>
   <StackPanel Visibility="{Binding HasSelectedKeyAction,Converter={StaticResource BoolToVisibility}}">
    <TextBlock Text="动作名称" Style="{StaticResource FieldCaption}"/>
    <TextBox Text="{Binding SelectedKeyAction.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
     IsEnabled="{Binding CanEditKeyActions}" Padding="7,5"/>
    <DockPanel Margin="0,10,0,6">
     <Button DockPanel.Dock="Right" Content="+ 步骤" Command="{Binding AddKeyStepCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="复制" Command="{Binding CopyKeyStepCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="删除" Command="{Binding DeleteKeyStepCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="↑" Command="{Binding MoveKeyStepUpCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <Button DockPanel.Dock="Right" Content="↓" Command="{Binding MoveKeyStepDownCommand}" Padding="8,5" Margin="5,0,0,0"/>
     <TextBlock Text="步骤 · KEY 组合 / 保持时间" Style="{StaticResource FieldCaption}" VerticalAlignment="Center"/>
    </DockPanel>
    <ListBox ItemsSource="{Binding SelectedKeyAction.Steps}"
     SelectedItem="{Binding SelectedKeyStep,Mode=TwoWay}"
     MinHeight="60" BorderBrush="#E0E9F3" Padding="4"
     ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate>
      <DataTemplate>
       <Grid Margin="3,4" MinHeight="30">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/><ColumnDefinition Width="75"/><ColumnDefinition Width="23"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
         ToolTip="{Binding Summary}" Foreground="#355579" FontSize="11"/>
        <TextBox Grid.Column="1" Text="{Binding HoldMsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         ToolTip="保持时间（ms）" Padding="5,3" VerticalAlignment="Center" MinHeight="28"
         IsEnabled="{Binding DataContext.CanEditKeyActions,RelativeSource={RelativeSource AncestorType=ListBox}}"/>
        <TextBlock Grid.Column="2" Text="ms" Margin="3,0,0,0" VerticalAlignment="Center" FontSize="10"/>
       </Grid>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <Border Background="#F7FAFE" BorderBrush="#DDE8F5" BorderThickness="1"
     CornerRadius="6" Padding="9" Margin="0,9,0,0">
     <StackPanel IsEnabled="{Binding CanEditKeyActions}">
      <TextBlock Text="KEY 组合" Foreground="#315E8E"
       FontWeight="SemiBold" Margin="0,0,0,6"/>
      <WrapPanel Margin="0,0,0,5">
       <Button Content="清空" Command="{Binding ClearStepKeysCommand}" Padding="7,5" Margin="0,0,5,5"/>
       <Button Content="反选" Command="{Binding InvertStepKeysCommand}" Padding="7,5" Margin="0,0,5,5"/>
       <Button Content="复制上一段" Command="{Binding CopyPreviousStepKeysCommand}" Padding="7,5" Margin="0,0,5,5"/>
      </WrapPanel>
      <Grid Margin="0,3,0,6">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/>
        <ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBlock Grid.Column="0" Text="掩码" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <TextBox Grid.Column="1" Text="{Binding SelectedKeyStep.MaskHexText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Padding="6,5" ToolTip="掩码 0x00000～0xFFFFF；同步勾选 20 KEY"/>
       <TextBlock Grid.Column="3" Text="保持" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <TextBox Grid.Column="4" Text="{Binding SelectedKeyStep.HoldMsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Padding="6,5" MinHeight="28"/>
       <TextBlock Grid.Column="5" Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"/>
      </Grid>
      <TextBlock Text="{Binding SelectedKeyStep.Summary}" Foreground="#516D87"
       TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,0,0,5"/>
      <TextBlock Text="{Binding SelectedKeyStep.MaskError}" Foreground="#B34035"
       FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
      <ItemsControl ItemsSource="{Binding StepKeys}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked,Mode=TwoWay}"
          Style="{StaticResource BenchKey}"/>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      
     </StackPanel>
    </Border>
   </StackPanel>
   <Border BorderBrush="#E5ECF4" BorderThickness="0,1,0,0" Margin="0,12,0,8"/>
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="停止 KEY 动作"
     Command="{Binding StopKeyActionCommand}" Padding="9,6"/>
    <TextBlock Text="KEY 动作状态" FontWeight="SemiBold"
     Foreground="#315E8E" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBlock Text="{Binding KeyActionRunStatus}" Style="{StaticResource BenchHint}"
    ToolTip="{Binding KeyActionRunStatus}" TextTrimming="CharacterEllipsis" MaxHeight="21" Margin="0,5,0,0"/>
  </StackPanel>
  </StackPanel>
 </ScrollViewer>
    </DockPanel>
   </Border>

   <!-- RIGHT: raw CAN data is the primary content. Logs are optional. -->
   <Border Grid.Column="2" Style="{StaticResource BenchCard}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,9">
      <DockPanel Margin="0,0,0,6">
       <TextBlock Text="CAN 接收监视" Style="{StaticResource BenchHeader}"/>
       <TextBlock DockPanel.Dock="Right" Text="{Binding MonitorCountSummary}"
        FontSize="11" Foreground="#647C95" Margin="8,0,0,0"
        TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel Margin="0,0,0,7">
       <ComboBox DockPanel.Dock="Left" Width="92" ItemsSource="{Binding MonitorChannelChoices}"
        SelectedItem="{Binding MonitorChannel,Mode=TwoWay}" MinHeight="32"/>
       <TextBox Text="{Binding MonitorQuery,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        MinHeight="32" Padding="8,6" Margin="8,0,0,0"
        ToolTip="按 ID、完整/局部 HEX、通道筛选"/>
      </DockPanel>
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearMonitorCommand}"
        Padding="8,5" Margin="5,0,0,0"/>
       <Button DockPanel.Dock="Right" Content="{Binding MonitorPauseLabel}"
        Command="{Binding ToggleMonitorPauseCommand}" Padding="9,5" Margin="5,0,0,0"/>
       <CheckBox Content="逐帧模式（取消为最新值）" FontSize="11"
        IsChecked="{Binding MonitorShowTimeline,Mode=TwoWay}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="{Binding CanRxReceiveStatus}" FontSize="11" Foreground="#61758A"
       TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
       ToolTip="{Binding CanRxReceiveStatus}"/>
     </StackPanel>
     <DataGrid x:Name="CanMonitorGrid" Grid.Row="1"
      ItemsSource="{Binding MonitorDisplay}" AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
      HeadersVisibility="Column" SelectionMode="Single"
      ColumnHeaderHeight="37" RowHeight="38" FontSize="13"
      GridLinesVisibility="Horizontal" BorderBrush="#E6EDF5"
      EnableRowVirtualization="True"
      ScrollViewer.HorizontalScrollBarVisibility="Auto"
      PreviewMouseRightButtonDown="MonitorGrid_RightClick">
      <DataGrid.ContextMenu>
       <ContextMenu>
        <MenuItem Header="复制完整 CAN 帧" Click="CopyMonitorFrame_Click"/>
        <MenuItem Header="仅复制 HEX 数据" Click="CopyMonitorData_Click"/>
       </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="92"/>
       <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="68"/>
       <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="91"/>
       <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="40"/>
       <DataGridTemplateColumn Header="完整 Data (HEX)" Width="*" MinWidth="198">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <TextBlock Text="{Binding Data}" FontFamily="Consolas" FontSize="12"
          TextTrimming="None" VerticalAlignment="Center" ToolTip="{Binding FullFrame}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="48"/>
      </DataGrid.Columns>
     </DataGrid>
     <Expander Grid.Row="2" Header="USB / 操作 / 错误日志（按需展开）"
      IsExpanded="False" BorderBrush="#E5ECF4" BorderThickness="0,1,0,0"
      Padding="3,8">
      <DockPanel Height="250" Margin="3,8,3,2">
       <DockPanel DockPanel.Dock="Top" Margin="0,0,0,7">
        <Button DockPanel.Dock="Right" Content="导出真实记录" Click="ExportLog_Click"
         Padding="8,5" Margin="5,0,0,0"/>
        <Button DockPanel.Dock="Right" Content="清空日志" Command="{Binding ClearLogsCommand}"
         Padding="8,5" Margin="5,0,0,0"/>
        <TextBox Text="{Binding LogFilter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         MinHeight="29" Padding="7,5" ToolTip="筛选操作/错误内容"/>
       </DockPanel>
       <DataGrid ItemsSource="{Binding FilteredLogs}"
        SelectedItem="{Binding SelectedLog,Mode=TwoWay}"
        AutoGenerateColumns="False" IsReadOnly="True"
        CanUserAddRows="False" CanUserDeleteRows="False"
        HeadersVisibility="Column" GridLinesVisibility="Horizontal"
        ColumnHeaderHeight="30" RowHeight="28" EnableRowVirtualization="True">
        <DataGrid.Columns>
         <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="96"/>
         <DataGridTextColumn Header="事件" Binding="{Binding Direction}" Width="75"/>
         <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
      </DockPanel>
     </Expander>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#286DAE" Padding="14,8">
   <TextBlock Text="{Binding Status}" Foreground="White" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>
