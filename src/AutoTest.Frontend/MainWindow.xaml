<Window x:Class="AutoTest.Frontend.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:views="clr-namespace:AutoTest.Frontend.Views"
 Title="AutoTest · ECU 测试工作台"
 Width="1490" Height="915" MinWidth="1050" MinHeight="650"
 WindowStartupLocation="CenterScreen" WindowState="Maximized"
 Background="{StaticResource AT.Canvas}" Foreground="{StaticResource AT.Text}"
 FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
 SnapsToDevicePixels="True" PreviewKeyDown="Main_PreviewKeyDown">
 <Window.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}"/>
 </Window.InputBindings>
 <Window.CommandBindings>
  <CommandBinding Command="{x:Static ApplicationCommands.Save}"
   Executed="SaveDraft_Executed"/>
 </Window.CommandBindings>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="65"/>
   <RowDefinition Height="47"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="32"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource AT.Border}"
   BorderThickness="0,0,0,1">
   <DockPanel Margin="18,0" LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Border CornerRadius="6" Background="#F2F5F9" Padding="10,7" Margin="0,0,10,0">
      <StackPanel Orientation="Horizontal">
       <Ellipse Width="7" Height="7" Fill="#8999AB" VerticalAlignment="Center"
        Margin="0,0,7,0"/>
       <TextBlock Text="设备未连接" Foreground="{StaticResource AT.Muted}" FontSize="11"/>
      </StackPanel>
     </Border>
     <ui:Button Content="记录与报告" Click="OpenRecords_Click" Margin="0,0,8,0"/>
     <ui:Button Content="扫码生产" Click="OpenProduction_Click" Margin="0,0,8,0"
      ToolTip="预留生产操作界面，当前纯前端不扫码启动"/>
     <ui:Button x:Name="ToolsButton" Appearance="Primary" Content="工具  ▾"
      Click="ShowTools_Click" Padding="17,8">
      <ui:Button.ContextMenu>
       <ContextMenu x:Name="ToolsMenu">
        <MenuItem Header="手动台架" Tag="bench" Click="OpenTool_Click"/>
        <Separator/>
        <MenuItem Header="UDS 诊断" Tag="uds" Click="OpenTool_Click"/>
        <MenuItem Header="ECU 烧录" Tag="flash" Click="OpenTool_Click"/>
        <MenuItem Header="DBC 编辑器" Tag="dbc" Click="OpenTool_Click"/>
        <MenuItem Header="波形分析" Tag="wave" Click="OpenTool_Click"/>
        <Separator/>
        <MenuItem Header="输入模拟配置" Tag="inputs" Click="OpenTool_Click"/>
        <MenuItem Header="设备连接与诊断" Tag="device" Click="OpenTool_Click"/>
       </ContextMenu>
      </ui:Button.ContextMenu>
     </ui:Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="{StaticResource AT.Accent}" Width="38" Height="38"
      CornerRadius="10" Margin="0,0,11,0">
      <TextBlock Text="AT" FontSize="16" FontWeight="Bold" Foreground="White"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel VerticalAlignment="Center" Margin="0,0,26,0">
      <TextBlock Text="AutoTest" FontSize="18" FontWeight="SemiBold"
       Foreground="{StaticResource AT.Text}"/>
      <TextBlock Text="工程测试工作台" FontSize="10"
       Foreground="{StaticResource AT.Muted}"/>
     </StackPanel>
     <Border Height="26" Width="1" Background="{StaticResource AT.Border}"
      Margin="0,0,17,0"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="{Binding ProjectLabel}" FontSize="13" FontWeight="SemiBold"
       Foreground="{StaticResource AT.Text}" TextTrimming="CharacterEllipsis"
       MaxWidth="345"/>
      <TextBlock Text="可编辑界面草稿 · 正式工程尚未接入"
       FontSize="10" Foreground="{StaticResource AT.Muted}"/>
     </StackPanel>
    </StackPanel>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Background="#FBFCFE" BorderBrush="{StaticResource AT.Border}"
   BorderThickness="0,0,0,1">
   <DockPanel Margin="17,0" LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding RunSelectionSummary}" Foreground="{StaticResource AT.Muted}"
      FontSize="11" VerticalAlignment="Center" Margin="0,0,13,0"/>
     <ui:Button Content="运行测试" Appearance="Primary" IsEnabled="False"
      ToolTip="未接入正式 TEST 执行器；不产生模拟执行结果" Padding="17,7"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <ui:Button Content="导入界面草稿" Click="Import_Click"
      Margin="0,0,7,0" ToolTip="仅支持 .ui-draft.json，不是正式 AutoTest 工程"/>
     <ui:Button Content="导出草稿" Click="Export_Click" Margin="0,0,7,0"/>
     <ui:Button Content="新建用例（界面）" Click="AddCase_Click" Margin="0,0,7,0"/>
     <Border Background="{StaticResource AT.AccentWash}" CornerRadius="5"
      Padding="9,5" Margin="7,0,0,0">
      <TextBlock Text="纯前端设计模式" Foreground="#2A67B2" FontSize="11"/>
     </Border>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="2" Margin="12">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="ExplorerColumn" Width="255" MinWidth="180" MaxWidth="400"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="*" MinWidth="440"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource AT.Panel}"
    Padding="0" Margin="0,0,3,0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="47"/><RowDefinition Height="39"/><RowDefinition Height="*"/>
      <RowDefinition Height="55"/>
     </Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="13,0">
      <TextBlock Text="工程文件" Style="{StaticResource AT.PanelTitle}"/>
     </DockPanel>
     <Border Grid.Row="1" BorderBrush="{StaticResource AT.Border}"
      BorderThickness="0,0,0,1" Padding="9,0">
      <TextBox x:Name="FileSearchBox" TextChanged="FileSearch_TextChanged"
       ToolTip="按名称筛选当前示例工程资源" VerticalAlignment="Center"
       MinHeight="28" FontSize="11"/>
     </Border>
     <TreeView x:Name="FileTree" Grid.Row="2" BorderThickness="0"
      Background="Transparent" Padding="5,9"
      SelectedItemChanged="FileTree_SelectedItemChanged"
      MouseDoubleClick="FileTree_MouseDoubleClick">
      <TreeView.ContextMenu>
       <ContextMenu>
        <MenuItem Header="新建测试用例" Click="AddCase_Click"/>
        <MenuItem Header="重命名选中用例" Click="RenameCase_Click"/>
        <Separator/>
        <MenuItem Header="删除选中的测试用例" Click="DeleteCase_Click"/>
       </ContextMenu>
      </TreeView.ContextMenu>
      <TreeView.Resources>
       <DataTemplate DataType="{x:Type local:CaseDraft}"
        xmlns:local="clr-namespace:AutoTest.Frontend">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
       </DataTemplate>
       <DataTemplate DataType="{x:Type local:DbcMessageDraft}"
        xmlns:local="clr-namespace:AutoTest.Frontend">
        <TextBlock Text="{Binding Name}"/>
       </DataTemplate>
       <DataTemplate DataType="{x:Type local:WaveSignalDraft}"
        xmlns:local="clr-namespace:AutoTest.Frontend">
        <TextBlock Text="{Binding Name}"/>
       </DataTemplate>
       <DataTemplate DataType="{x:Type local:InputStateDraft}"
        xmlns:local="clr-namespace:AutoTest.Frontend">
        <TextBlock Text="{Binding Name}"/>
       </DataTemplate>
      </TreeView.Resources>
      <TreeViewItem Header="测试项目" IsExpanded="True">
       <TreeViewItem Header="当前测试项目" IsExpanded="True" ItemsSource="{Binding ExplorerCases}"/>
      </TreeViewItem>
      <TreeViewItem Header="公共流程"/>
      <TreeViewItem Header="DBC 资源" ItemsSource="{Binding ExplorerDbc}"/>
      <TreeViewItem Header="波形资源" ItemsSource="{Binding ExplorerWaves}"/>
      <TreeViewItem Header="输入模拟配置" ItemsSource="{Binding ExplorerInputs}"/>
      <TreeViewItem Header="烧录配置"/>
     </TreeView>
     <Border Grid.Row="3" BorderBrush="{StaticResource AT.Border}"
      BorderThickness="0,1,0,0" Padding="12,8">
      <StackPanel>
       <TextBlock Text="文件管理体验区" FontSize="11" FontWeight="SemiBold"/>
       <TextBlock Text="双击测试用例进入编辑；正式工程接线暂缓。"
        Style="{StaticResource AT.Caption}" Margin="0,3,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
    ResizeDirection="Columns" ShowsPreview="True"
    Background="Transparent" Margin="1,0"/>
   <Border Grid.Column="2" Style="{StaticResource AT.Panel}" Padding="0">
    <TabControl x:Name="WorkTabs" SelectedIndex="0"
     Background="White" BorderThickness="0">
     <TabItem Header="运行 · 当前任务">
      <views:RunWorkspace x:Name="RunWorkspaceView"/>
     </TabItem>
     <TabItem Header="编辑 · 测试用例">
      <views:EditorWorkspace x:Name="EditorWorkspaceView"/>
     </TabItem>
    </TabControl>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource AT.Border}"
   BorderThickness="0,1,0,0">
   <DockPanel Margin="16,0">
    <TextBlock DockPanel.Dock="Right" Text="{Binding SaveStatus}"
     FontSize="11" Foreground="{StaticResource AT.Muted}"
     VerticalAlignment="Center"/>
    <TextBlock Text="设计预览 · 无设备连接 / 无真实执行 / 不生成测试报告"
     Foreground="{StaticResource AT.Warning}" VerticalAlignment="Center" FontSize="11"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
