<UserControl x:Class="AutoTest.Desktop.Testing.TestEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 SnapsToDevicePixels="True" UseLayoutRounding="True">
  <UserControl.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    <KeyBinding Key="F2" Command="{Binding EditParametersCommand}"/>
    <KeyBinding Key="Space" Modifiers="Control" Command="{Binding AddChildCommand}"/>
    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
  </UserControl.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="69"/>
      <RowDefinition Height="Auto" MinHeight="54"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="17,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="测试程序编辑器" FontSize="19" FontWeight="SemiBold" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding DocumentName}" FontSize="15"
                       Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="{Binding DocumentPath}" ToolTip="{Binding DocumentPath}"
                     TextTrimming="CharacterEllipsis" Foreground="{StaticResource Subtle}"
                     FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding AssetRevision,StringFormat='修订 {0}'}"
                     Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,15,0"/>
          <TextBlock Text="● 未保存" Foreground="{StaticResource Warning}"
                     FontSize="12" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0">
        <WrapPanel VerticalAlignment="Center" Margin="0,7,0,7">
          <Button Content="保存" Command="{Binding SaveCommand}" ToolTip="Ctrl+S"/>
          <Button Content="重新加载" Command="{Binding ReloadCommand}" ToolTip="放弃草稿，重新读取文件"/>
          <Border Width="1" Height="25" Background="{StaticResource Line}" Margin="2,0,10,0"/>
          <Button Content="＋ 添加步骤" Command="{Binding AddChildCommand}"
                  Style="{StaticResource AtPrimaryButton}" MinWidth="110"
                  ToolTip="Ctrl+Space · 在右侧属性栏选择和配置新步骤"/>
          <Button Content="发送 CAN" Command="{Binding QuickAddCommand}"
                  CommandParameter="can" ToolTip="添加 CAN 发送并立即编辑报文"/>
          <Button Content="模拟按键" Command="{Binding QuickAddCommand}"
                  CommandParameter="key" ToolTip="选择 ECU 功能按键或直接操作 KEY_SIM"/>
          <Button Content="读取信号" Command="{Binding QuickAddCommand}"
                  CommandParameter="read" ToolTip="从 DBC 选择 ECU 信号并设置变量"/>
          <Button Content="期望判定" Command="{Binding QuickAddCommand}"
                  CommandParameter="expect" ToolTip="添加独立的显式判定"/>
          
          <Border Width="1" Height="25" Background="{StaticResource Line}" Margin="2,0,10,0"/>
          <Button Content="撤销" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z"/>
          <Button Content="重做" Command="{Binding RedoCommand}" ToolTip="Ctrl+Y"/>
        </WrapPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.45*" MinWidth="360"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="1*" MinWidth="360"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource AtPanel}">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarSurface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                  Padding="14,11">
            <DockPanel>
              <TextBlock Text="测试程序 · 步骤序列" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock DockPanel.Dock="Right" Text="右键调整步骤与分支"
                         FontSize="11" Foreground="{StaticResource Subtle}"/>
            </DockPanel>
          </Border>
          <Expander DockPanel.Dock="Bottom" Header="高级：操作对象绑定（添加步骤时自动建立）"
                    IsExpanded="False" Padding="10,7" Background="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="{Binding MappingInfo}" Foreground="{StaticResource Subtle}"
                         Margin="0,0,0,7"/>
              <ComboBox ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}"
                        DisplayMemberPath="Name" MinHeight="27" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="管理 / 重新绑定" Command="{Binding AddMappingCommand}"/>
                <Button Content="移除未使用绑定" Command="{Binding RemoveMappingCommand}"/>
              </StackPanel>
            </StackPanel>
          </Expander>
          <Expander Header="运行与调试 · 真实台架" DockPanel.Dock="Bottom" MaxHeight="390" IsExpanded="False"
                      Margin="0,0,0,10">
              <StackPanel Margin="9,12,9,4">
              <TextBlock Text="真实测试执行 · 不会运行 Mock 设备"
                         Foreground="{StaticResource Subtle}"
                         TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Text="运行授权文本（仅对包含物理写入的 TEST 必填）"
                       Foreground="{StaticResource Subtle}" Margin="0,0,0,5"/>
            <TextBox Text="{Binding ExpectedApproval,Mode=OneWay}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBox Text="{Binding RunApproval,UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button Content="开始真实测试" Command="{Binding RunCommand}"
                      Style="{StaticResource AtPrimaryButton}"/>
              <Button Content="停止" Command="{Binding StopRunCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding RunSummary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding RunFacts}" IsReadOnly="True" AutoGenerateColumns="False"
                      MaxHeight="220" HeadersVisibility="Column" RowHeaderWidth="0"
                      CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="步骤" Binding="{Binding Type}" Width="85"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="95"/>
                <DataGridTextColumn Header="实际数据" Binding="{Binding Actual}" Width="100"/>
                <DataGridTextColumn Header="说明" Binding="{Binding Detail}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
              </StackPanel>
            </Expander>
          <TreeView x:Name="StepsTree" ItemsSource="{Binding StepRoots}"
                    Tag="{Binding}" BorderThickness="0" Margin="5,7"
                    SelectedItemChanged="StepsTree_SelectedItemChanged"
                    MouseDoubleClick="StepsTree_DoubleClick"
                    PreviewMouseRightButtonDown="StepsTree_RightClick"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True">
            <TreeView.Resources>
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                               Color="{StaticResource SelectedSurfaceColor}"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                               Color="{StaticResource InkColor}"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                               Color="{StaticResource InactiveSelectionColor}"/>
              <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                               Color="{StaticResource InkColor}"/>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Icon}" Foreground="{StaticResource Subtle}"
                             Margin="0,0,8,0"/>
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/>
                <Setter Property="Padding" Value="3,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.Tag,RelativeSource={RelativeSource Self}}">
                <MenuItem Header="添加步骤…" Command="{Binding AddChildCommand}"/>
                <MenuItem Header="在此步骤后插入" Command="{Binding AddAfterCommand}"/>
                <Separator/>
                <MenuItem Header="显示步骤属性（F2）" Command="{Binding EditParametersCommand}"/>
                <MenuItem Header="复制步骤及子步骤" Command="{Binding DuplicateCommand}"/>
                <MenuItem Header="上移" Command="{Binding MoveUpCommand}"/>
                <MenuItem Header="下移" Command="{Binding MoveDownCommand}"/>
                <MenuItem Header="删除（Delete）" Command="{Binding DeleteCommand}"/>
                <Separator/>
                <MenuItem Header="撤销（Ctrl+Z）" Command="{Binding UndoCommand}"/>
                <MenuItem Header="重做（Ctrl+Y）" Command="{Binding RedoCommand}"/>
                <MenuItem Header="保存（Ctrl+S）" Command="{Binding SaveCommand}"/>
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                    HorizontalAlignment="Stretch" Background="{StaticResource Line}"/>
      <Border Grid.Column="2" Style="{StaticResource AtPanel}" Padding="0">
        <ContentControl x:Name="InspectorHost" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="13,0">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Subtle}"
                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>