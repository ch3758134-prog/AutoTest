<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Color x:Key="InkColor">#202D3F</Color><Color x:Key="SubtleColor">#607185</Color><Color x:Key="PanelColor">#FFFFFF</Color><Color x:Key="BackgroundColor">#F5F8FD</Color><Color x:Key="LineColor">#D7E3F2</Color><Color x:Key="AccentColor">#2C83E7</Color>
 <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/><SolidColorBrush x:Key="Subtle" Color="{StaticResource SubtleColor}"/><SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/><SolidColorBrush x:Key="Canvas" Color="{StaticResource BackgroundColor}"/><SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/><SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
 <SolidColorBrush x:Key="Ok" Color="#2B83D9"/><SolidColorBrush x:Key="Warning" Color="#95621A"/><SolidColorBrush x:Key="Danger" Color="#C34050"/>
</ResourceDictionary>