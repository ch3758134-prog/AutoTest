<UserControl x:Class="AutoTest.Desktop.Testing.TestProjectWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="White" Foreground="{StaticResource Ink}"
 FontFamily="{StaticResource UiFont}" FontSize="12">
 <UserControl.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/></UserControl.InputBindings>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="49"/>
   <RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <DockPanel Margin="12,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="保存" Command="{Binding SaveCommand}" Margin="0,0,5,0"/>
     <Button Content="从工程重新加载" Command="{Binding ReloadCommand}"/>
    </StackPanel>
    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <DockPanel Margin="12,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="全选" Command="{Binding SelectAllCommand}" Margin="0,0,4,0"/>
     <Button Content="清空" Command="{Binding ClearSelectionCommand}" Margin="0,0,6,0"/>
     <Button Content="▷ 检查所选" Command="{Binding PreflightSelectedCommand}"
      Style="{StaticResource AtPrimaryButton}"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="本次执行" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock Text="{Binding SelectionSummary}" Margin="9,0,0,0"
      Foreground="#2368BD" VerticalAlignment="Center" FontSize="11"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#FCFDFF" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
    <DockPanel Margin="10,0">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="↑" Command="{Binding UpCommand}" Width="27" Margin="0,0,3,0"/>
      <Button Content="↓" Command="{Binding DownCommand}" Width="27" Margin="0,0,3,0"/>
      <Button Content="移除引用" Command="{Binding RemoveCommand}"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="添加测试用例" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
      <ComboBox Width="205" ItemsSource="{Binding AvailablePackages}"
       SelectedItem="{Binding SelectedAvailable,Mode=TwoWay}" DisplayMemberPath="Label"
       Margin="0,0,7,0" Height="28"/>
      <Button Content="＋ 添加" Command="{Binding AddCommand}" Height="28"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <DataGrid Grid.Row="1" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage,Mode=TwoWay}"
    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
    HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
    RowHeight="37" ColumnHeaderHeight="30" BorderThickness="0"
    EnableRowVirtualization="True" SelectionUnit="FullRow">
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="本次执行" Width="85">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <CheckBox IsChecked="{Binding RunSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Content="选中" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="顺序" Binding="{Binding Order}" Width="55" IsReadOnly="True"/>
     <DataGridTextColumn Header="测试用例" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
     <DataGridTemplateColumn Header="工程默认" Width="105">
      <DataGridTemplateColumn.CellTemplate><DataTemplate>
       <CheckBox Content="默认启用" IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        VerticalAlignment="Center" HorizontalAlignment="Center"/>
      </DataTemplate></DataGridTemplateColumn.CellTemplate>
     </DataGridTemplateColumn>
     <DataGridTextColumn Header="固定修订" Binding="{Binding Revision}" Width="73" IsReadOnly="True"/>
     <DataGridTextColumn Header="SHA256" Binding="{Binding Sha256}" Width="135" IsReadOnly="True"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
  <Border Grid.Row="3" Background="#FBFCFF" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
   <TextBlock Text="{Binding StatusMessage}" Foreground="#64758C" FontSize="10"
    TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0"/>
  </Border>
 </Grid>
</UserControl>
