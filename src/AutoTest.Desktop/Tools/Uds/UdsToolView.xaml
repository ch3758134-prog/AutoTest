<UserControl x:Class="AutoTest.Desktop.Tools.Uds.UdsToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="False"
    Background="#F5F7FA" Foreground="#203249"
    FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources>
  <SolidColorBrush x:Key="UdsPanel" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="UdsRaised" Color="#ECF2F8"/>
  <SolidColorBrush x:Key="UdsBorder" Color="#D6E1EC"/>
  <SolidColorBrush x:Key="UdsMuted" Color="#637A90"/>
  <SolidColorBrush x:Key="UdsAccent" Color="#176CB5"/>
  <Style x:Key="UdsCard" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource UdsPanel}"/>
   <Setter Property="BorderBrush" Value="{StaticResource UdsBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="13"/>
   <Setter Property="CornerRadius" Value="5"/>
  </Style>
  <Style x:Key="UdsCaption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource UdsMuted}"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="0,7,0,4"/>
  </Style>
  <Style x:Key="UdsSection" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#203249"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#203249"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#F5F7FA"/>
   <Setter Property="Foreground" Value="#203249"/>
   <Setter Property="BorderBrush" Value="{StaticResource UdsBorder}"/>
   <Setter Property="Margin" Value="0,2,0,7"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="MinHeight" Value="29"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#ECF2F8"/>
   <Setter Property="Foreground" Value="#203249"/>
   <Setter Property="BorderBrush" Value="{StaticResource UdsBorder}"/>
   <Setter Property="Padding" Value="7,4"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#EAF0F8"/>
   <Setter Property="Foreground" Value="#203249"/>
   <Setter Property="BorderBrush" Value="#D6E1EC"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="Margin" Value="0,0,7,5"/>
  </Style>
  <Style x:Key="UdsSendButton" TargetType="Button">
   <Setter Property="Background" Value="#126BBB"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#277ABD"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="MinHeight" Value="34"/>
   <Setter Property="Margin" Value="0,0,9,6"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="#F5F7FA"/>
   <Setter Property="Foreground" Value="#203249"/>
   <Setter Property="BorderBrush" Value="{StaticResource UdsBorder}"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="#203249"/>
   <Setter Property="RowBackground" Value="#FFFFFF"/>
   <Setter Property="AlternatingRowBackground" Value="#ECF2F8"/>
   <Setter Property="BorderBrush" Value="{StaticResource UdsBorder}"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#D6E1EC"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="200"/>
   <RowDefinition Height="185" MinHeight="120"/>
  </Grid.RowDefinitions>
  <!-- R1 P08 title / service actions derived from the approved HTML -->
  <DockPanel Margin="3,0,3,11">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="EXECUTION SOURCE" Foreground="{StaticResource UdsMuted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox Width="105" ItemsSource="{Binding SourceModes}" SelectedItem="{Binding SourceMode,Mode=TwoWay}" Margin="0,0,7,0"/>
    <Button Content="发送请求" Command="{Binding SendCommand}" Style="{StaticResource UdsSendButton}"/>
    <Button Content="取消" Command="{Binding CancelCommand}"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="UDS Console" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock Text="DIAGNOSTICS / UDS  ·  Service Builder · ISO-TP · NRC · Response · Trace"
               Foreground="{StaticResource UdsMuted}" FontSize="11" Margin="0,4,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#FFF6E8" BorderBrush="#C9A271"
          BorderThickness="1" CornerRadius="4" Padding="11,7" Margin="0,0,0,12">
   <TextBlock Text="R1 仅支持真实 CAN1 只读 UDS 及离线档案 Replay。真实请求仅允许 0x19/0x22，其他服务不执行物理发送。"
              Foreground="#744611" TextWrapping="Wrap"/>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="240" MinWidth="190"/>
    <ColumnDefinition Width="10"/>
    <ColumnDefinition Width="*" MinWidth="300"/>
    <ColumnDefinition Width="10"/>
    <ColumnDefinition Width="275" MinWidth="235"/>
   </Grid.ColumnDefinitions>
   <!-- Services / definitions -->
   <Border Style="{StaticResource UdsCard}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="服务目录 / UDS SERVICES" Style="{StaticResource UdsSection}"/>
      <TextBlock Text="保存可复用诊断任务；选中后自动填入请求编辑器"
                 Foreground="{StaticResource UdsMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,11"/>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <WrapPanel Margin="0,9,0,5">
       <Button Content="保存服务" Command="{Binding SaveServiceCommand}"/>
       <Button Content="删除服务" Command="{Binding DeleteServiceCommand}"/>
      </WrapPanel>
      <Separator Background="#D6E1EC" Margin="0,6"/>
      <TextBlock Text="服务定义文档 / JSON" Style="{StaticResource UdsCaption}"/>
      <TextBox Text="{Binding DocumentPath,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
      <WrapPanel>
       <Button Content="保存服务列表" Command="{Binding SaveDocumentCommand}"/>
       <Button Content="重开" Command="{Binding LoadDocumentCommand}"/>
      </WrapPanel>
     </StackPanel>
     <TabControl Background="#FFFFFF">
      <TabItem Header="UDS 服务目录">
       <DataGrid ItemsSource="{Binding ServiceCatalog}" SelectedItem="{Binding SelectedCatalogService,Mode=TwoWay}"
                 AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                 CanUserAddRows="False" SelectionMode="Single" GridLinesVisibility="None">
        <DataGrid.Columns>
         <DataGridTextColumn Header="SID" Binding="{Binding Sid,StringFormat=X2}" Width="50"/>
         <DataGridTextColumn Header="服务" Binding="{Binding Name}" Width="*"/>
         <DataGridTextColumn Header="类别" Binding="{Binding Risk}" Width="115"/>
        </DataGrid.Columns>
       </DataGrid>
      </TabItem>
      <TabItem Header="我的诊断任务">
       <ListBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService,Mode=TwoWay}"
                DisplayMemberPath="Name" BorderThickness="0" MinHeight="120"/>
      </TabItem>
     </TabControl>
    </DockPanel>
   </Border>
   <!-- Request builder and response -->
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="11"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource UdsCard}">
     <StackPanel>
      <TextBlock Text="请求编辑 / REQUEST BUILDER" Style="{StaticResource UdsSection}"/>
      <TextBlock Text="服务名称" Style="{StaticResource UdsCaption}"/>
      <TextBox Text="{Binding ServiceName,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="结构化参数 / SERVICE PARAMETERS" Style="{StaticResource UdsCaption}"/>
      <WrapPanel Margin="0,0,0,5">
       <TextBlock Text="DID (HEX)" Foreground="{StaticResource UdsMuted}" VerticalAlignment="Center" Margin="0,0,5,4"/>
       <TextBox Width="74" Text="{Binding DidParameter,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
       <Button Content="生成 ReadDID" Command="{Binding PrepareReadDidCommand}"/>
       <TextBlock Text="DTC Mask" Foreground="{StaticResource UdsMuted}" VerticalAlignment="Center" Margin="6,0,5,4"/>
       <TextBox Width="60" Text="{Binding DtcMaskParameter,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
       <Button Content="生成 ReadDTC" Command="{Binding PrepareReadDtcCommand}"/>
       <Button Content="生成 TesterPresent" Command="{Binding PrepareTesterPresentCommand}"/>
      </WrapPanel>
      <TextBlock Text="UDS Request PDU · HEX（无需手工添加 ISO-TP PCI）" Style="{StaticResource UdsCaption}"/>
      <TextBox Text="{Binding RequestHex,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="14"
               ToolTip="例如 22 F1 90，应用层 PDU；多帧分包由 ISO-TP 层处理"/>
      <TextBlock Text="期望 ECU Response PDU · HEX（可选，用于严格比较）" Style="{StaticResource UdsCaption}"/>
      <TextBox Text="{Binding ExpectedHex,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
      <WrapPanel Margin="0,5,0,0">
       <Button Content="发送真实请求 / 回放" Command="{Binding SendCommand}" Style="{StaticResource UdsSendButton}"/>
       <Button Content="保存为服务" Command="{Binding SaveServiceCommand}"/>
       <Button Content="取消" Command="{Binding CancelCommand}"/>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource UdsCard}">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="ECU 响应 / RESPONSE" Style="{StaticResource UdsSection}"/>
       <TextBlock Text="原始 UDS PDU" Style="{StaticResource UdsCaption}"/>
       <TextBox Text="{Binding ResponseHex,Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"/>
       <TextBlock Text="诊断解释 / NRC" Style="{StaticResource UdsCaption}"/>
       <TextBlock Text="{Binding ResponseSummary}" TextWrapping="Wrap" Margin="0,3,0,12" Foreground="#127C9D"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="结果：" Foreground="{StaticResource UdsMuted}" Margin="0,0,10,7"/>
        <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="NRC：" Foreground="{StaticResource UdsMuted}" Margin="0,0,10,7"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Nrc}"/>
        <TextBlock Grid.Row="2" Text="预期比对：" Foreground="{StaticResource UdsMuted}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExpectedMatch}"/>
       </Grid>
       <TextBlock Text="{Binding Error}" Foreground="#BD4052" TextWrapping="Wrap" Margin="0,11,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>
   <!-- Profile / inspector -->
   <Border Grid.Column="4" Style="{StaticResource UdsCard}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="ECU PROFILE / INSPECTOR" Style="{StaticResource UdsSection}"/>
      <TextBlock Text="通信来源：Physical Read / Replay。真实请求共用 P02 主控板会话。"
                 Foreground="{StaticResource UdsMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <WrapPanel Margin="0,0,0,7">
       <Button Content="导入 CanTool XML" Click="ImportCanTool_Click"/>
       <Button Content="使用 APP 地址" Click="UseCanToolApp_Click"/>
       <Button Content="使用 Boot 地址" Click="UseCanToolBoot_Click"/>
      </WrapPanel>
      <TextBlock Text="ECU Profile 名称" Style="{StaticResource UdsCaption}"/>
      <TextBox Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="ECU 身份标识（由实际配置确认）" Style="{StaticResource UdsCaption}"/>
      <TextBox Text="{Binding MockIdentity,UpdateSourceTrigger=PropertyChanged}"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="TX CAN ID" Style="{StaticResource UdsCaption}"/><TextBox Text="{Binding TxId,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="RX CAN ID" Style="{StaticResource UdsCaption}"/><TextBox Text="{Binding RxId,UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/></StackPanel>
      </Grid>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="P2 (ms)" Style="{StaticResource UdsCaption}"/><TextBox Text="{Binding P2Ms,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="P2* (ms)" Style="{StaticResource UdsCaption}"/><TextBox Text="{Binding P2StarMs,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      </Grid>
      <TextBlock Text="会话状态" Style="{StaticResource UdsCaption}"/>
      <TextBlock Text="{Binding Session}" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <Separator Background="#D6E1EC" Margin="0,10"/>
      <TextBlock Text="Replay 记录文件" Style="{StaticResource UdsCaption}"/>
      <TextBox Text="{Binding ReplayPath,UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="加载 Replay JSON" Command="{Binding LoadReplayCommand}"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource UdsCard}" Margin="0,11,0,0" Padding="10">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
     <TextBlock Text="TRANSPORT / UDS TRACE" FontWeight="SemiBold"/>
     <TextBlock Text="    ISO-TP · TX/RX · NRC · 时间线" Foreground="{StaticResource UdsMuted}"/>
     <TextBlock Text="    源=" Foreground="{StaticResource UdsMuted}"/>
     <TextBlock Text="{Binding SourceLabel}" Foreground="#8F611B"/>
    </StackPanel>
    <DataGrid ItemsSource="{Binding TraceRows}" IsReadOnly="True" AutoGenerateColumns="False"
              HeadersVisibility="Column" CanUserAddRows="False" RowHeaderWidth="0">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="150"/>
      <DataGridTextColumn Header="ISO-TP CAN DATA (HEX)" Binding="{Binding Hex}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>