<Window x:Class="AutoTest.Desktop.Dbc.DbcMessageEditDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 Title="编辑报文参数" Width="590" Height="375" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
 Background="{StaticResource Panel}" Foreground="{StaticResource Ink}"
 FontFamily="{StaticResource UiFont}" FontSize="13">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="67"/>
    </Grid.RowDefinitions>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="19,14">
      <StackPanel>
        <TextBlock Text="报文参数" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="修改后先应用到 DBC 草稿，点击工作台“保存 DBC”才写入磁盘。"
                   Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Margin="19,15">
      <primitives:UniformGrid Columns="2">
        <StackPanel Margin="0,0,12,14">
          <TextBlock Text="CAN ID（只读，保留完整 DBC 引用）" Margin="0,0,0,6"/>
          <TextBox x:Name="IdBox"/>
        </StackPanel>
        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="报文名称" Margin="0,0,0,6"/>
          <TextBox x:Name="NameBox"/>
        </StackPanel>
        <StackPanel Margin="0,0,12,14">
          <TextBlock Text="DLC（0–8 字节）" Margin="0,0,0,6"/>
          <TextBox x:Name="DlcBox"/>
        </StackPanel>
        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="发送节点" Margin="0,0,0,6"/>
          <TextBox x:Name="TransmitterBox"/>
        </StackPanel>
      </primitives:UniformGrid>
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}"
                 TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
            Background="{StaticResource ToolbarSurface}" Padding="18,13">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" IsCancel="True"/>
        <Button Content="应用参数" Style="{StaticResource AtPrimaryButton}"
                IsDefault="True" Click="Apply_Click" Margin="0" MinWidth="105"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>