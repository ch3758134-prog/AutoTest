<UserControl x:Class="AutoTest.Desktop.Dbc.DbcWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True"
 PreviewKeyDown="Workbench_PreviewKeyDown">
  <UserControl.Resources>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                     Color="{StaticResource SelectedSurfaceColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                     Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                     Color="{StaticResource InactiveSelectionColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                     Color="{StaticResource InkColor}"/>
    <Style x:Key="DbcSectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource MutedSurface}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="9,9"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="4,3"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource HoverSurface}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource SelectedSurface}"/>
          <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource SelectedSurface}"/>
          <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="6,5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource SelectedSurface}"/>
          <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="F5" Command="{Binding ReloadCommand}"/>
  </UserControl.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="69"/>
      <RowDefinition Height="49"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="17,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="DBC 工作台" FontSize="19" FontWeight="SemiBold"
                       Margin="0,0,12,0"/>
            <TextBlock Text="{Binding AssetName}" FontSize="15" Foreground="{StaticResource Subtle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
          </StackPanel>
          <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource Subtle}"
                     FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"
                     ToolTip="{Binding FilePath}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding AssetRevision,StringFormat='资源修订 {0}'}"
                     VerticalAlignment="Center" Foreground="{StaticResource Subtle}"
                     Margin="0,0,15,0"/>
          <TextBlock Text="● 未保存" Foreground="{StaticResource Warning}"
                     FontSize="12" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,0">
        <TextBlock DockPanel.Dock="Right" Text="{Binding StateDescription}"
                   Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                   FontSize="12"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="保存 DBC" Command="{Binding SaveCommand}"
                  ToolTip="保存修改并更新工程资源版本（Ctrl+S）；中文别名也保存到 DBC 文件"/>
          <Button Content="重新加载" Command="{Binding ReloadCommand}"
                  ToolTip="重新从磁盘读取 DBC（F5）"/>
          <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="2,0,10,0"/>
          <TextBlock Text="双击名称改中文别名 · F2 重命名 · 右侧编辑参数及详细注释" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="12"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="10,10,10,9">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="285" MinWidth="250"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="380"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="390" MinWidth="335"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource AtPanel}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="12,11"
                  Background="{StaticResource ToolbarSurface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="报文" Style="{StaticResource DbcSectionTitle}"/>
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding MessageCount,StringFormat='{}{0} 条'}"
                         Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Top" Padding="9,8" Background="White"
           BorderBrush="#E3EAF3" BorderThickness="0,0,0,1">
           <StackPanel>
            <TextBlock Text="查找报文或信号" Foreground="#607891" FontSize="10" Margin="0,0,0,4"/>
            <TextBox Text="{Binding MessageSearchText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
             MinHeight="29" Padding="7,4"
             ToolTip="支持中文名称、功能摘要、原始标识、CAN ID 和信号名称；搜索结果不修改 DBC。"/>
           </StackPanel>
          </Border>
          <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                   BorderThickness="0" Background="Transparent" Margin="5"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingStackPanel.VirtualizationMode="Recycling"
                   MouseDoubleClick="MessageList_DoubleClick"
                   PreviewMouseRightButtonDown="MessageList_PreviewMouseRightButtonDown">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="重命名中文别名 (F2)" Click="RenameMessageMenu_Click"/>
                <MenuItem Header="完整编辑原始报文…" Click="EditMessageMenu_Click"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,3">
                  <StackPanel x:Name="MessageInlineDisplay" Margin="4,3">
                    <TextBlock Text="{Binding NavTitle}" FontSize="13" FontWeight="SemiBold"
                      TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                      <TextBlock Text="{Binding HexId}" Foreground="{StaticResource Subtle}"
                        FontSize="11" Margin="0,0,9,0"/>
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource Subtle}"
                        FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBox x:Name="MessageInlineEditor" Visibility="Collapsed" MinHeight="30"
                    Margin="4,3" KeyDown="InlineEditor_KeyDown"
                    LostKeyboardFocus="InlineEditor_LostKeyboardFocus"
                    ToolTip="Enter 确认中文别名 · Esc 取消"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" Background="{StaticResource Line}"/>

      <Border Grid.Column="2" Style="{StaticResource AtPanel}">
        <Grid Background="White">
          <Grid.RowDefinitions>
            <RowDefinition Height="43"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Padding="14,0" Background="{StaticResource ToolbarSurface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center">
              <TextBlock DockPanel.Dock="Right" Text="{Binding SignalCount,StringFormat='{}{0} 个信号'}"
                Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
              <TextBlock Text="报文内容" Style="{StaticResource DbcSectionTitle}"
                VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" Padding="14,10" BorderBrush="{StaticResource Line}"
                  BorderThickness="0,0,0,1">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedMessage.NavTitle}" FontSize="15"
                  FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding SelectedMessage.HexId,StringFormat='  ·  {0}'}"
                  Foreground="{StaticResource Subtle}" FontSize="12"
                  VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock Text="{Binding SelectedMessageDefinition}" FontSize="11"
                Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" Margin="0,5,0,0"
                ToolTip="{Binding SelectedMessageDefinition}"/>
            </StackPanel>
          </Border>
          <DataGrid Grid.Row="2" x:Name="SignalGrid"
                    ItemsSource="{Binding Signals}" SelectedItem="{Binding SelectedSignal}"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    CanUserSortColumns="True" IsReadOnly="True" HeadersVisibility="Column"
                    RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    MaxHeight="375" BorderThickness="0" Background="White"
                    AlternatingRowBackground="{StaticResource ToolbarSurface}"
                    RowHeight="42" ColumnHeaderHeight="38"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    MouseDoubleClick="SignalGrid_DoubleClick"
                    PreviewMouseRightButtonDown="SignalGrid_PreviewMouseRightButtonDown">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="重命名中文别名 (F2)" Click="RenameSignalMenu_Click"/>
                <MenuItem Header="编辑原始信号参数…" Click="EditSignalMenu_Click"/>
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="信号" Width="2.2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <StackPanel x:Name="SignalInlineDisplay" Margin="0,2">
                        <TextBlock Text="{Binding NavTitle}" FontSize="12"
                          FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                          ToolTip="{Binding DisplayName}"/>
                        <TextBlock Text="{Binding Name}" FontSize="10"
                          Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <TextBox x:Name="SignalInlineEditor" Visibility="Collapsed"
                        MinHeight="29" KeyDown="InlineEditor_KeyDown"
                        LostKeyboardFocus="InlineEditor_LostKeyboardFocus"
                        ToolTip="Enter 确认别名 · Esc 取消"/>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="注释预览" Binding="{Binding Summary}" Width="2.1*"/>
              <DataGridTextColumn Header="起始位" Binding="{Binding StartBit}" Width="64"/>
              <DataGridTextColumn Header="位长" Binding="{Binding BitLength}" Width="52"/>
              <DataGridTextColumn Header="因子" Binding="{Binding Factor}" Width="70"/>
              <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="65"/>
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                  Background="{StaticResource ToolbarSurface}">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="14,11" Background="White"
                      BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="蓝：信号占用    深蓝：当前信号    橙：位重叠"
                    FontSize="11" Foreground="{StaticResource Subtle}"
                    VerticalAlignment="Center"/>
                  <TextBlock Text="位布局" Style="{StaticResource DbcSectionTitle}"/>
                </DockPanel>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,10,14,12">
                  <TextBlock Text="一个色块代表 1 bit · 点击定位信号 · 悬停查看完整名称"
                    Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,0,0,9"/>
                  <Grid x:Name="BitGrid" MinHeight="220"/>
                  <TextBlock Text="位布局按实际 DBC 编码显示，复用信号的重叠需结合复用条件理解。"
                    Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" Background="{StaticResource Line}"/>

      <Border Grid.Column="4" Style="{StaticResource AtPanel}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="12,10"
                  Background="{StaticResource ToolbarSurface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <TextBlock Text="当前对象 · 属性与注释" Style="{StaticResource DbcSectionTitle}"/>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,10,12,15">
              <!-- Do not repeat the full message and signal properties at once. -->
              <StackPanel>
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsMessageSelected}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="报文定义" FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                <TextBlock Text="{Binding SelectedMessage.HexId}" FontSize="12"
                           Foreground="{StaticResource Subtle}" Margin="0,0,0,9"/>
                <TextBlock Text="中文别名" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding MessageAliasText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                         MinHeight="30" Margin="0,0,0,9"/>
                <TextBlock Text="DBC 原始名称（受引用约束）" Foreground="{StaticResource Subtle}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SelectedMessage.Name,Mode=OneWay}" IsReadOnly="True"
                         Background="{StaticResource MutedSurface}" Margin="0,0,0,9"/>
                <TextBlock Text="详细注释 · CM_ BO_" FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding MessageCommentText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="16000"
                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
                         MinHeight="158" MaxHeight="540" VerticalScrollBarVisibility="Auto"
                         Padding="8,8" Margin="0,0,0,7"
                         ToolTip="直接编辑报文详细定义、发送条件和使用说明；Ctrl+S 保存到 DBC。"/>
                <TextBlock Text="注释可多行编写，保存至 DBC 标准 CM_，不是另建一份摘要。"
                           FontSize="11" Foreground="{StaticResource Subtle}"
                           TextWrapping="Wrap" Margin="0,0,0,13"/>
                <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,10"/>
                <TextBlock Text="通信参数" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding SelectedMessage.Dlc,StringFormat='数据长度：{0} Byte'}"
                           Margin="0,0,0,5"/>
                <TextBlock Text="{Binding SelectedMessage.FrameType}" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding SelectedMessage.Transmitter,StringFormat='发送节点：{0}'}"
                           Margin="0,0,0,10"/>
                <Button Content="完整编辑报文参数…" Command="{Binding EditMessageCommand}"
                        HorizontalAlignment="Left" MinHeight="29"
                        ToolTip="修改报文原始名称、DLC、发送节点等结构字段，按原文保留策略校验。"/>
              </StackPanel>
              <StackPanel>
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsSignalSelected}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="信号定义" FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                <TextBlock Text="{Binding SelectedSignal.Name}" Foreground="{StaticResource Subtle}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="中文别名" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SignalAliasText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                         MinHeight="30" Margin="0,0,0,11"/>
                <TextBlock Text="信号注释 · CM_ SG_" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SignalCommentText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" MaxLength="16000"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="118" MaxHeight="460"
                         VerticalScrollBarVisibility="Auto" Padding="8,8" Margin="0,0,0,12"
                         ToolTip="说明物理含义、有效性、状态枚举和测试注意事项。"/>
                <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,10"/>
                <TextBlock Text="信号编码参数" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel IsEnabled="{Binding CanEdit}">
                <TextBlock Text="修改参数后点击“应用技术参数”，先校验整组数值，再 Ctrl+S 保存文件。"
                           FontSize="11" Foreground="{StaticResource Subtle}"
                           TextWrapping="Wrap" Margin="0,0,0,9"/>
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="起始位" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SignalDraft.StartBit,UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="位长" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SignalDraft.BitLength,UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                  <CheckBox Content="Intel (小端)" IsChecked="{Binding SignalDraft.Intel}"
                            Margin="0,0,15,0"/>
                  <CheckBox Content="有符号" IsChecked="{Binding SignalDraft.Signed}"/>
                </StackPanel>
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="因子 (Factor)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SignalDraft.Factor,UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="偏移 (Offset)" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SignalDraft.Offset,UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,9">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="最小物理值" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SignalDraft.Minimum,UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="最大物理值" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SignalDraft.Maximum,UpdateSourceTrigger=PropertyChanged}"/>
                  </StackPanel>
                </Grid>
                <TextBlock Text="单位" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SignalDraft.Unit,UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,9"/>
                <TextBlock Text="接收节点" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SignalDraft.Receiver,UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,9"/>
                <TextBlock Text="复用标记 (空 / M / m数字)" Margin="0,0,0,4"/>
                <TextBox Text="{Binding SignalDraft.Multiplexer,UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,11"/>
                <Button Content="应用技术参数" Command="{Binding ApplySignalParametersCommand}"
                        MinHeight="32" HorizontalAlignment="Stretch"
                        Margin="0,0,0,10"/>
                <TextBlock Text="数值枚举 (VAL_)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding SelectedValueDescriptions}" TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                </StackPanel>
                <Button Content="高级编辑原始信号…" Command="{Binding EditSignalCommand}"
                        HorizontalAlignment="Left" MinHeight="29" Margin="0,0,0,8"/>
              </StackPanel>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,10"/>
              <TextBlock Text="{Binding UnsupportedDescription}"
                         Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                         FontSize="11" Margin="0,0,0,10"/>
              <TextBlock Text="未保存修改不会写入磁盘。Ctrl+S 保存时执行 DBC 解析与修订回读验证。"
                         Foreground="{StaticResource Subtle}" TextWrapping="Wrap"
                         FontSize="11"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0">
        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                   Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>