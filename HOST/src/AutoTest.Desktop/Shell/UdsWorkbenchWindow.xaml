<Window x:Class="AutoTest.Desktop.Shell.UdsWorkbenchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · UDS 诊断序列工作台" Width="1220" Height="780"
 MinWidth="800" MinHeight="520" WindowStartupLocation="CenterOwner"
 Background="#F4F7FA" Foreground="#26394E" FontFamily="{StaticResource UiFont}" FontSize="13"
 PreviewKeyDown="Workbench_PreviewKeyDown" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="UdsAction" TargetType="Button" BasedOn="{StaticResource AtQuietButton}">
   <Setter Property="MinHeight" Value="31"/>
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
  </Style>
  <Style x:Key="UdsCaption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#52677F"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
  </Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,11">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="新建" Click="NewDocument_Click" Style="{StaticResource UdsAction}"
     ToolTip="新建独立诊断序列 Ctrl+N"/>
    <Button Content="打开序列…" Click="OpenDocument_Click" Style="{StaticResource UdsAction}"
     ToolTip="打开已有诊断序列 Ctrl+O"/>
    <Button Content="保存" Click="SaveDocument_Click" Style="{StaticResource AtPrimaryButton}"
     Padding="13,6" Margin="0,0,7,0" ToolTip="保存并校验诊断序列 Ctrl+S"/>
    <Button Content="另存为…" Click="SaveAsDocument_Click" Style="{StaticResource UdsAction}"
     ToolTip="保存为新的独立文件 Ctrl+Shift+S"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="UDS 诊断序列" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock x:Name="SourceLabel" Text="尚未保存 · 独立工具，不需要 ECU 工程"
     Foreground="#5C7189" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#DFE6EF" BorderThickness="1"
   CornerRadius="6" Padding="12" Margin="0,0,0,11">
   <Expander x:Name="UdsProfileExpander" Header="诊断端点、超时与序列名称"
    IsExpanded="False" FontSize="13" Foreground="#314A63">
   <Grid Margin="0,8,0,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/>
     <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/>
     <ColumnDefinition Width="1.15*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="序列名称" Style="{StaticResource UdsCaption}" Margin="0,0,0,4"/>
     <TextBox x:Name="SequenceName" TextChanged="Profile_TextChanged"
      MinHeight="31" Padding="7,4"/>
     <TextBlock Text="ECU 标识" Style="{StaticResource UdsCaption}" Margin="0,6,0,4"/>
     <TextBox x:Name="EcuIdentity" TextChanged="Profile_TextChanged"
      MinHeight="31" Padding="7,4"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="请求 CAN ID（HEX）" Style="{StaticResource UdsCaption}" Margin="0,0,0,4"/>
     <TextBox x:Name="RequestCanId" TextChanged="Profile_TextChanged"
      MinHeight="31" FontFamily="Consolas" Padding="7,4" ToolTip="例如 0x18DA50F1"/>
     <TextBlock Text="响应 CAN ID（HEX）" Style="{StaticResource UdsCaption}" Margin="0,6,0,4"/>
     <TextBox x:Name="ResponseCanId" TextChanged="Profile_TextChanged"
      MinHeight="31" FontFamily="Consolas" Padding="7,4" ToolTip="例如 0x18DAF150"/>
    </StackPanel>
    <StackPanel Grid.Column="4">
     <TextBlock Text="超时设置" Style="{StaticResource UdsCaption}" Margin="0,0,0,4"/>
     <WrapPanel>
      <TextBlock Text="P2" Style="{StaticResource UdsCaption}" Margin="0,0,5,0"/>
      <TextBox x:Name="P2Input" Width="84" TextChanged="Profile_TextChanged"
       MinHeight="31" Padding="6,4"/>
      <TextBlock Text="ms" Style="{StaticResource UdsCaption}" Margin="5,0,14,0"/>
      <TextBlock Text="P2*" Style="{StaticResource UdsCaption}" Margin="0,0,5,0"/>
      <TextBox x:Name="P2StarInput" Width="84" TextChanged="Profile_TextChanged"
       MinHeight="31" Padding="6,4"/>
      <TextBlock Text="ms" Style="{StaticResource UdsCaption}" Margin="5,0,0,0"/>
     </WrapPanel>
     <TextBlock Text="ISO-TP Normal 地址模式 · ECU CAN"
      Foreground="#5C7189" FontSize="12" Margin="0,14,0,0"/>
    </StackPanel>
   </Grid>
   </Expander>
  </Border>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>
   <StackPanel x:Name="UdsCompactNavigation" Grid.Row="0"
    Orientation="Horizontal" Margin="0,0,0,7" Visibility="Collapsed">
    <Button x:Name="UdsServicesTab" Content="服务序列"
     Click="UdsServicesTab_Click" Padding="13,5" Margin="0,0,7,0"
     ToolTip="编辑和保存诊断服务定义"/>
    <Button x:Name="UdsReplayTab" Content="回放与响应"
     Click="UdsReplayTab_Click" Padding="13,5"
     ToolTip="核对已导入的真实诊断交换记录"/>
   </StackPanel>
  <Grid x:Name="UdsMainGrid" Grid.Row="1">
   <Grid.RowDefinitions>
    <RowDefinition x:Name="UdsPrimaryRow" Height="*"/>
    <RowDefinition x:Name="UdsReplayRow" Height="0"/>
   </Grid.RowDefinitions>
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="UdsEditorColumn" Width="1.15*" MinWidth="0"/>
    <ColumnDefinition x:Name="UdsGapColumn" Width="7"/>
    <ColumnDefinition x:Name="UdsReplayColumn" Width="1*" MinWidth="0"/>
   </Grid.ColumnDefinitions>
   <Border x:Name="UdsEditorPanel" Background="White" BorderBrush="#DFE6EF"
    BorderThickness="1" CornerRadius="6">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <DockPanel Margin="12,10" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Content="新增" Click="AddService_Click" Style="{StaticResource UdsAction}"
       ToolTip="新增实际 UDS 服务请求 Insert"/>
       <Button Content="复制" Click="CopyService_Click" Style="{StaticResource UdsAction}"
       ToolTip="复制选中服务 Ctrl+D"/>
       <Button Content="上移" Click="MoveUp_Click" Style="{StaticResource UdsAction}"/>
       <Button Content="下移" Click="MoveDown_Click" Style="{StaticResource UdsAction}"/>
       <Button Content="删除" Click="DeleteService_Click" Style="{StaticResource UdsAction}"
       Margin="0" ToolTip="删除选中服务（表格焦点下按 Delete）"/>
      </StackPanel>
      <TextBlock Text="服务序列" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <Border Grid.Row="1" BorderBrush="#DCE7EE" BorderThickness="0,1,0,1"
      Background="#F7FBFE" Padding="11,8" Margin="0,0,0,5">
      <StackPanel>
       <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
         <Button x:Name="ReadDidButton" Content="读取选中 DID" Click="ReadDid_Click"
          Style="{StaticResource AtPrimaryButton}" Padding="11,5"
          ToolTip="仅允许当前选中的 22 HH LL；需要精确输入下面展示的授权文本" IsEnabled="False"/>
         <Button x:Name="CancelDidButton" Content="停止" Click="CancelDid_Click"
          Style="{StaticResource UdsAction}" IsEnabled="False" Margin="7,0,0,0"/>
        </StackPanel>
        <StackPanel>
         <TextBlock Text="读取 ECU 数据（只读）" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock x:Name="DidHardwareStatus" Text="主控连接待确认"
          Foreground="#52677F" FontSize="11" Margin="0,2,0,2"/>
         <TextBlock x:Name="DidScopeText" Text="选择 22 HH LL 服务，并配置 ECU CAN 端点"
          FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
          Foreground="#486780" Margin="0,3,0,4"/>
        </StackPanel>
       </DockPanel>
       <DockPanel Margin="0,5,0,0">
        <Button Content="复制授权" Click="CopyDidAuthorization_Click"
         DockPanel.Dock="Right" Style="{StaticResource UdsAction}"
         ToolTip="复制当前选中 DID 与 ECU CAN 请求/响应 ID 对应的唯一授权文本"
         Margin="7,0,0,0"/>
        <TextBox x:Name="DidConsentInput" MinHeight="29" Padding="6,4"
         FontFamily="Consolas" TextChanged="DidConsentChanged"
         ToolTip="粘贴完整的 AUTHORIZE DID 授权文本；每次实体读取均需重新确认"/>
       </DockPanel>
      </StackPanel>
     </Border>
     <DataGrid x:Name="ServiceGrid" Grid.Row="2" AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False"
      ItemsSource="{Binding ServiceRows}" SelectionMode="Single" RowHeight="37"
      ColumnHeaderHeight="35" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
      SelectionChanged="ServiceGrid_SelectionChanged">
      <DataGrid.Columns>
       <DataGridTextColumn Header="服务名称" Width="*" MinWidth="120"
        Binding="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="请求 PDU (HEX)" Width="175"
        Binding="{Binding RequestHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="期望响应（可空）" Width="165"
        Binding="{Binding ExpectedHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </Border>
   <GridSplitter x:Name="UdsColumnSplitter" Grid.Column="1" Width="7" Background="#E1E7EF"
    ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" HorizontalAlignment="Stretch"/>
   <GridSplitter x:Name="UdsRowSplitter" Grid.Row="1" Grid.Column="0"
    Height="6" Background="#DEE7F0" Panel.ZIndex="2"
    ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
    VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed"
    ToolTip="拖动调整诊断服务与真实回放明细高度"/>
   <Border x:Name="UdsReplayPanel" Grid.Column="2" Background="White" BorderBrush="#DFE6EF"
    BorderThickness="1" CornerRadius="6">
    <Grid Margin="12">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <TextBlock Text="诊断与记录回放" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
     <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#66788B" FontSize="12"
      Text="读取结果和文件回放分别显示；回放不会向 ECU 发送数据。"
      Margin="0,0,0,11"/>
     <WrapPanel Grid.Row="2" Margin="0,0,0,10">
      <Button Content="载入回放…" Click="LoadReplay_Click" Style="{StaticResource UdsAction}"/>
      <Button x:Name="ReplayNext" Content="按序核对下一项" Click="NextReplay_Click"
       IsEnabled="False" Style="{StaticResource AtPrimaryButton}"
       Padding="10,5" Margin="0,0,7,0"/>
      <Button Content="清除回放" Click="ClearReplay_Click" Style="{StaticResource UdsAction}"/>
     </WrapPanel>
     <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <Border Background="#F4FAF6" BorderBrush="#D9E9DF"
        BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12">
        <StackPanel>
         <TextBlock Text="读取数据标识符（0x22）"
          FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
         <TextBlock x:Name="DidOutcomeText" Text="尚未读取 ECU"
          TextWrapping="Wrap" Foreground="#38614D" Margin="0,0,0,6"/>
         <TextBlock x:Name="DidResponseText" FontFamily="Consolas"
          TextWrapping="Wrap" Margin="0,0,0,6"/>
         <Button x:Name="ExportDidReportButton" Content="导出本次真实诊断记录…"
          Click="ExportDidReport_Click" IsEnabled="False"
          Style="{StaticResource UdsAction}" Margin="0,0,0,7"
          HorizontalAlignment="Left"
          ToolTip="仅导出当前会话实际记录的 PDU、CAN1 帧、主控身份和结果；非正式 RECORD"/>
         <ListBox x:Name="DidFrames" FontFamily="Consolas"
          FontSize="11" MaxHeight="165" MinHeight="44"/>
        </StackPanel>
       </Border>
       <TextBlock x:Name="ReplayFileLabel" Text="尚未加载回放文件" Foreground="#5C7189"
        TextWrapping="Wrap" Margin="0,0,0,10"/>
       <TextBlock x:Name="ReplayOutcome" FontSize="15" FontWeight="SemiBold"
        Text="暂无诊断结果" Margin="0,0,0,9"/>
       <TextBlock x:Name="ReplayResponse" FontFamily="Consolas" FontSize="13"
        TextWrapping="Wrap" Margin="0,0,0,9"/>
       <TextBlock x:Name="ReplayExplanation" Foreground="#65768B" TextWrapping="Wrap"
        Margin="0,0,0,8"/>
       <TextBlock Text="导入记录中的 CAN 帧" FontWeight="SemiBold" Margin="0,10,0,6"/>
       <ListBox x:Name="ReplayFrames" FontFamily="Consolas"
        FontSize="12" MinHeight="120"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap"
   Foreground="#53677F" Margin="2,11,0,1"
   Text="实时操作仅允许经单次授权的 0x22 DID；其他 UDS 服务只可编辑和离线回放，未经真机验收不产生正式测试结论。"/>
 </Grid>
</Window>