<UserControl x:Class="AutoTest.Desktop.Shell.AutomaticTestHomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12"
 Background="#F7F9FB" Foreground="#263847">
 <UserControl.Resources>
  <Style x:Key="SmallCaption" TargetType="{x:Type TextBlock}">
   <Setter Property="Foreground" Value="#708198"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="11,10,11,11">
  <Grid.RowDefinitions>
   <RowDefinition Height="108"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="White" CornerRadius="5"
   BorderBrush="#DDE5ED" BorderThickness="1" Padding="14,9" Margin="0,0,0,9">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="2.2*"/>
     <ColumnDefinition Width="1.2*"/>
     <ColumnDefinition Width="2*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="ECU 编号" Style="{StaticResource SmallCaption}"/>
     <TextBlock Text="{Binding DutSerial}" FontSize="17" FontWeight="SemiBold"
      Foreground="#273C50" Margin="0,4,8,0" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding ScanStatus}" FontSize="11" Foreground="#75889A"
      TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="30"
      Margin="0,4,12,0"/>
     <TextBlock Text="{Binding ScanTraceSummary}" FontSize="10" Foreground="#647D92"
      TextTrimming="CharacterEllipsis" Margin="0,3,12,0"
      ToolTip="{Binding ScanTraceSummary}"/>
    </StackPanel>
    <StackPanel Grid.Column="1">
     <TextBlock Text="ECU 型号" Style="{StaticResource SmallCaption}"/>
     <TextBlock Text="{Binding ModelCode}" FontWeight="SemiBold" FontSize="13"
      Margin="0,6,8,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="当前状态" Style="{StaticResource SmallCaption}"/>
     <TextBlock Text="{Binding Status}" Foreground="#346C9A" FontWeight="SemiBold"
      FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- One START job, two input sources. This is a fail-closed readiness
       surface until the verified production adapter and physical input arrive. -->
  <Border Grid.Row="1" Background="White" CornerRadius="5"
   BorderBrush="#DDE5ED" BorderThickness="1" Padding="14,10" Margin="0,0,0,9">
   <DockPanel LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="核对启动条件"
     Command="{Binding RequestSoftwareStartCommand}"
     Style="{StaticResource AtPrimaryButton}" MinWidth="130" MinHeight="37"
     Padding="13,7" Margin="18,0,0,0" VerticalAlignment="Center"
     ToolTip="当前生产实体执行适配器未接通；点击查看准确的阻断原因，不会发送 CAN、FLASH 或实体动作"/>
    <StackPanel>
     <TextBlock Text="正式检测启动检查" FontSize="13" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding PhysicalStartStatus}" FontSize="11"
      Foreground="#9B6A22" Margin="0,5,0,0" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding StartInputHint}" FontSize="11"
      Foreground="#687C91" Margin="0,4,0,0" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding StartRequestStatus}" FontSize="11"
      Foreground="#526B86" Margin="0,6,0,0" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding DeploymentStatus}" FontSize="11"
      Foreground="#547C70" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- The operator sees a test program, never a developer project explorer. -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="7*" MinWidth="440"/>
    <ColumnDefinition Width="9"/>
    <ColumnDefinition Width="3*" MinWidth="310"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="5"
    BorderBrush="#DDE5ED" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="12,0">
      <TextBlock Text="{Binding CaseCount,StringFormat='共 {0} 项'}"
       DockPanel.Dock="Right" VerticalAlignment="Center"
       Foreground="#758599" FontSize="11"/>
      <TextBlock Text="测试用例与步骤（点击展开查看）" VerticalAlignment="Center"
       FontSize="13" FontWeight="SemiBold"/>
     </DockPanel>
     <!-- Show exactly the deployed, pinned TEST sources; step hierarchy is
          a read-only operator inspection, not a second test-plan editor. -->
     <TreeView Grid.Row="1" ItemsSource="{Binding Cases}"
      SelectedItemChanged="CasesTree_SelectedItemChanged"
      Visibility="{Binding HasPlan,Converter={StaticResource BoolToVisibility}}"
      BorderThickness="0" Background="White" Padding="5,5,7,7"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <TreeView.ItemContainerStyle>
       <Style TargetType="{x:Type TreeViewItem}">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=OneWay}"/>
        <Setter Property="Margin" Value="0,1"/>
       </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate>
       <HierarchicalDataTemplate ItemsSource="{Binding Children}">
        <Grid MinHeight="32" Margin="2,0,5,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="146"/>
         </Grid.ColumnDefinitions>
         <TextBlock Grid.Column="0" Text="{Binding Index}" Foreground="#8291A2"
                    FontSize="11" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#273C50"
                    FontWeight="Medium" TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" Margin="0,0,8,0"
                    ToolTip="{Binding Name}"/>
         <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#657F95"
                    FontSize="11" VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"/>
        </Grid>
       </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
     </TreeView>
     <!-- Only first setup / invalid operator plan has a setup action. -->
     <Border Grid.Row="1" Background="#FCFDFE"
      Visibility="{Binding NeedsSetup,Converter={StaticResource BoolToVisibility}}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
       MaxWidth="470" Margin="20">
       <TextBlock Text="当前没有可浏览的测试用例" FontSize="16"
        FontWeight="SemiBold" TextAlignment="Center" Foreground="#344C62"/>
       <TextBlock Text="{Binding SetupIssue}" TextWrapping="Wrap"
        FontSize="12" TextAlignment="Center" Foreground="#6A7E92"
        Margin="0,11,0,19"/>
       <Button Content="打开工程与调试" Command="{Binding ChoosePlanCommand}"
        Style="{StaticResource AtPrimaryButton}" Padding="18,8"
        HorizontalAlignment="Center" MinWidth="145" MinHeight="34"/>
       <TextBlock Text="请在开发与调试中打开或创建 ECU 工程。工程配置未完成时仍可浏览用例，但不能进行真实生产检测。"
        FontSize="11" TextAlignment="Center" Foreground="#8C9AAA"
        Margin="0,14,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="White" CornerRadius="5"
    BorderBrush="#DDE5ED" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <TextBlock Grid.Row="0" Text="运行与结果" FontSize="13"
      FontWeight="SemiBold" VerticalAlignment="Center" Margin="13,0,0,0"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="13,15,13,16">
       <TextBlock Text="选择的工程步骤（仅结构预览）" Style="{StaticResource SmallCaption}"/>
       <TextBlock Text="{Binding InspectedNode}" FontWeight="SemiBold" FontSize="13"
        Foreground="#314C66" TextWrapping="Wrap" Margin="0,5,0,6"/>
       <TextBlock Text="{Binding InspectedStatus}" FontSize="11" Foreground="#75889A"
        TextWrapping="Wrap" Margin="0,0,0,14"/>
       <Border Height="1" Background="#E7EDF3" Margin="0,0,0,12"/>
       <TextBlock Text="当前用例" Style="{StaticResource SmallCaption}"/>
       <TextBlock Text="{Binding CurrentCase}" FontSize="15"
        FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,14"/>
       <TextBlock Text="当前步骤" Style="{StaticResource SmallCaption}"/>
       <TextBlock Text="{Binding CurrentStep}" FontSize="14"
        TextWrapping="Wrap" Margin="0,5,0,14"/>
       <Border Height="1" Background="#E7EDF3" Margin="0,0,0,12"/>
       <TextBlock Text="实际测量" Style="{StaticResource SmallCaption}"/>
       <TextBlock Text="{Binding ActualValue}" FontSize="16"
        FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,15"/>
       <TextBlock Text="预期与判据" Style="{StaticResource SmallCaption}"/>
       <TextBlock Text="{Binding ExpectedValue}" TextWrapping="Wrap"
        Margin="0,5,0,15"/>
       <TextBlock Text="失败原因" Style="{StaticResource SmallCaption}"/>
       <TextBlock Text="{Binding FailureReason}" TextWrapping="Wrap"
        Margin="0,5,0,15"/>
       <Border Height="1" Background="#E7EDF3" Margin="0,1,0,11"/>
       <TextBlock Text="{Binding DeviceStatus}" FontSize="11"
        Foreground="#74859A" Margin="0,0,0,9"/>
       <TextBlock Text="{Binding ExecutionNotice}" FontSize="11"
        Foreground="#708198" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
