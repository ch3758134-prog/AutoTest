<UserControl x:Class="AutoTest.Desktop.Project.ProjectExplorerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:AutoTest.Desktop.Shell"
 Background="{DynamicResource StudioPanel}" Foreground="{DynamicResource StudioText}"
 FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource StudioPanel}" Padding="12,8"
          BorderBrush="{DynamicResource StudioLine}" BorderThickness="0,0,0,1">
   <DockPanel>
    <Menu DockPanel.Dock="Right" Background="Transparent">
     <MenuItem Header="＋ 新建 / 打开 ▾">
      <MenuItem Header="编辑测试程序" Click="OpenTest_Click"/>
      <MenuItem Header="打开 DBC 编辑器" Click="OpenDbc_Click"/>
      <MenuItem Header="编辑编号规则" Click="OpenRules_Click"/>
      <Separator/>
      <MenuItem Header="打开工程文件夹" Click="OpenFolder_Click"/>
     </MenuItem>
    </Menu>
    <TextBlock Text="工程资源" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <TreeView Grid.Row="1" x:Name="ResourceTree" ItemsSource="{Binding ResourceNodes}"
    Background="{DynamicResource StudioPanel}" BorderThickness="0" Padding="6,8"
    MouseDoubleClick="ResourceTree_MouseDoubleClick"
    PreviewMouseRightButtonDown="ResourceTree_RightClick">
   <TreeView.ItemContainerStyle>
    <Style TargetType="{x:Type TreeViewItem}">
     <Setter Property="IsExpanded" Value="True"/>
     <Setter Property="Margin" Value="0,2"/>
    </Style>
   </TreeView.ItemContainerStyle>
   <TreeView.Resources>
    <HierarchicalDataTemplate DataType="{x:Type vm:WorkbenchResourceNode}" ItemsSource="{Binding Children}">
     <StackPanel Orientation="Horizontal" Margin="0,5">
      <TextBlock x:Name="Glyph" Text="▤" Width="23" VerticalAlignment="Center"
                 Foreground="{DynamicResource StudioMuted}" FontSize="14"/>
      <TextBlock Text="{Binding Label}" FontSize="12.5" TextWrapping="Wrap"
                 Foreground="{DynamicResource StudioText}" VerticalAlignment="Center"/>
     </StackPanel>
     <HierarchicalDataTemplate.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="folder">
       <Setter TargetName="Glyph" Property="Text" Value="▸"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="project">
       <Setter TargetName="Glyph" Property="Text" Value="⌂"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="test">
       <Setter TargetName="Glyph" Property="Text" Value="▷"/>
       <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource StudioAccent}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="dbc">
       <Setter TargetName="Glyph" Property="Text" Value="▤"/>
      </DataTrigger>
     </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
   </TreeView.Resources>
   <TreeView.ContextMenu>
    <ContextMenu>
     <MenuItem Header="打开选中资源" Click="OpenSelectedResource_Click"/>
     <MenuItem Header="打开工程文件夹" Click="OpenFolder_Click"/>
    </ContextMenu>
   </TreeView.ContextMenu>
  </TreeView>
  <Expander Grid.Row="2" Header="工程设置" IsExpanded="False"
     Foreground="{DynamicResource StudioMuted}" Margin="8,0,8,8">
   <StackPanel Margin="5,7">
    <TextBlock Text="工程名称" Style="{StaticResource AtFieldLabel}"/>
    <TextBox Text="{Binding EditableProjectName,UpdateSourceTrigger=PropertyChanged}"
         ToolTip="编辑当前工程名称" Margin="0,0,0,7"/>
    <Button Content="保存工程名称" Command="{Binding RenameProjectCommand}" Style="{StaticResource AtPrimaryButton}" HorizontalAlignment="Left"/>
    <Button Content="打开工程文件夹" Click="OpenFolder_Click" Style="{StaticResource AtQuietButton}" HorizontalAlignment="Left" Margin="0,7,0,0"/>
   </StackPanel>
  </Expander>
 </Grid>
</UserControl>