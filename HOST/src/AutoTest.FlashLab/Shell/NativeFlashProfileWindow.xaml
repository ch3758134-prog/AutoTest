<Window x:Class="AutoTest.FlashLab.Shell.NativeFlashProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECU 烧录配置" Width="925" Height="710"
        MinWidth="790" MinHeight="560" Background="#F7F9FC"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,14">
   <TextBlock Text="ECU 烧录配置" FontSize="22" FontWeight="SemiBold" Foreground="#20364A"/>
   <TextBlock Text="选择 HEX，设置 ECU 通信与擦写参数。安全算法由软件固定提供。"
              FontSize="12" Foreground="#62798D" Margin="0,5,0,0"/>
   <TextBlock Text="当前支持已验证的 HydEPB 烧录方法；其他型号必须先完成真实验证。"
               Foreground="#8D621F" FontSize="12" Margin="0,6,0,0"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Padding="16" Background="White" CornerRadius="9"
            BorderBrush="#DFE7EF" BorderThickness="1" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="固件 HEX" FontSize="15" FontWeight="SemiBold"
                 Foreground="#20364A" Margin="0,0,0,10"/>
      <DockPanel>
       <Button x:Name="FirmwareImportButton" DockPanel.Dock="Right" Content="选择 HEX" Click="ImportFirmware_Click"
               Padding="16,8" Margin="12,0,0,0" MinWidth="110"/>
       <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="FirmwareLabel" Text="尚未导入固件"
                   TextTrimming="CharacterEllipsis" Foreground="#325574"
                   ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
        <TextBlock Text="保存到当前工程；更换后可直接校验烧录范围"
                   Foreground="#75889B" FontSize="11" Margin="0,5,0,0"/>
       </StackPanel>
      </DockPanel>
     </StackPanel>
    </Border>
    <Border Padding="16" Background="White" CornerRadius="9"
            BorderBrush="#DFE7EF" BorderThickness="1" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="烧录参数" FontSize="15" FontWeight="SemiBold"
                 Foreground="#20364A" Margin="0,0,0,4"/>
      <TextBlock Text="修改有效参数后自动保存"
                 Foreground="#65798C" FontSize="11" Margin="0,0,0,13"/>
      <TextBlock Text="诊断 CAN ID（十六进制）" FontWeight="SemiBold"
                 Foreground="#354E66" Margin="0,0,0,7"/>
      <UniformGrid Columns="4">
       <StackPanel Margin="0,0,10,12">
        <TextBlock Text="APPPhyID · APP 请求" FontSize="11" Foreground="#667B8F"/>
        <TextBox x:Name="AppTxBox" Padding="8,6" Margin="0,5,0,0" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Margin="0,0,10,12">
        <TextBlock Text="APPRespond · APP 应答" FontSize="11" Foreground="#667B8F"/>
        <TextBox x:Name="AppRxBox" Padding="8,6" Margin="0,5,0,0" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Margin="0,0,10,12">
        <TextBlock Text="BootloadPhyID · Boot 请求" FontSize="11" Foreground="#667B8F"/>
        <TextBox x:Name="BootTxBox" Padding="8,6" Margin="0,5,0,0" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Margin="0,0,0,12">
        <TextBlock Text="BootRespond · Boot 应答" FontSize="11" Foreground="#667B8F"/>
        <TextBox x:Name="BootRxBox" Padding="8,6" Margin="0,5,0,0" TextChanged="EditorChanged"/>
       </StackPanel>
      </UniformGrid>
      <Expander Header="参考字段（仅兼容原始参数）" IsExpanded="False"
                Foreground="#637E94" Margin="0,2,0,10">
        <StackPanel Margin="0,8,0,0">
      <UniformGrid Columns="4">
       <StackPanel Margin="0,0,10,12">
        <TextBlock Text="VersionID" FontSize="11" Foreground="#667B8F"/>
        <TextBox x:Name="VersionIdBox" Padding="8,6" Margin="0,5,0,0" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Margin="0,0,10,12">
        <TextBlock Text="DiagnosticsID" FontSize="11" Foreground="#667B8F"/>
        <TextBox x:Name="DiagnosticsIdBox" Padding="8,6" Margin="0,5,0,0" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Margin="0,0,10,12">
        <TextBlock Text="BootFeature / item" FontSize="11" Foreground="#667B8F"/>
        <TextBox x:Name="BootFeatureBox" Padding="8,6" Margin="0,5,0,0" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Margin="0,0,0,12">
        <TextBlock Text="APPFeature / item" FontSize="11" Foreground="#667B8F"/>
        <TextBox x:Name="AppFeatureBox" Padding="8,6" Margin="0,5,0,0" TextChanged="EditorChanged"/>
       </StackPanel>
      </UniformGrid>
        </StackPanel>
      </Expander>
      <TextBlock Text="FLASH 范围与 CAN 波特率" FontWeight="SemiBold"
                 Foreground="#354E66" Margin="0,0,0,7"/>
      <UniformGrid Columns="3">
       <StackPanel Margin="0,0,10,4">
        <TextBlock Text="FLASH 起始地址（HEX）" FontSize="11" Foreground="#667B8F"/>
        <TextBox x:Name="StartBox" Padding="8,6" Margin="0,5,0,0" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Margin="0,0,10,4">
        <TextBlock Text="FLASH 结束地址（含，HEX）" FontSize="11" Foreground="#667B8F"/>
        <TextBox x:Name="EndBox" Padding="8,6" Margin="0,5,0,0" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Margin="0,0,0,4">
        <TextBlock Text="波特率（kbit/s）" FontSize="11" Foreground="#667B8F"/>
        <ComboBox x:Name="BaudBox" Margin="0,5,0,0" Padding="7,4"
                  SelectionChanged="EditorSelectionChanged">
         <ComboBoxItem Content="250"/>
         <ComboBoxItem Content="500"/>
        </ComboBox>
       </StackPanel>
      </UniformGrid>
      <Border Background="#FFF4DF" BorderBrush="#EED6A3" BorderThickness="1"
              CornerRadius="6" Padding="11" Margin="0,13,0,0">
       <StackPanel>
        <TextBlock Text="烧录镜像提醒 · 已验证的 HydEPB 特殊工艺"
                   FontWeight="SemiBold" Foreground="#8B5817"/>
        <TextBlock Text="可能覆盖 HEX 末尾 4 字节；校验时必须查看实际烧录计划。"
                   ToolTip="当已验证的 HydEPB 工艺命中 512 字节块长、APP/Boot ID 和地址范围时，计划可能在 0x1006FFFC～0x1006FFFF 写入 12 34 56 78，并增加末尾块；与原始 HEX 的差异必须核对。"
                   Foreground="#765722" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
      <TextBlock Text="烧录计划" FontWeight="SemiBold"
                 Foreground="#354E66" Margin="0,15,0,6"/>
      <TextBox x:Name="JobDetailsLabel" Text="尚未完成离线 Job 校验"
               Background="#F3F7FA" BorderBrush="#DCE6EF" IsReadOnly="True"
               TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
               MinHeight="70" MaxHeight="178" Padding="9,8" FontSize="11"
               Foreground="#415B72"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="校验配置" Click="Preview_Click" Padding="12,8" Margin="0,0,8,0"/>
    <Button Content="完成" Click="Close_Click" Padding="15,8"/>
    <TextBlock Text="有效参数自动保存" Foreground="#567766" FontSize="12"
     VerticalAlignment="Center" Margin="10,0,4,0"/>
   </StackPanel>
   <TextBlock x:Name="StatusLabel" Text="工程配置待读取" Foreground="#375B73"
              TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"
              FontSize="12"/>
  </DockPanel>
 </Grid>
</Window>