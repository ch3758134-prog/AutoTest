<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
 <!-- G4 frozen light IDE palette. Values intentionally preserve approved preview appearance. -->
 <SolidColorBrush x:Key="AtUiSurface" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="AtUiInk" Color="#1E2C41"/>
 <SolidColorBrush x:Key="AtUiButtonForeground" Color="#25415F"/>
 <SolidColorBrush x:Key="AtUiBorder" Color="#D4DFED"/>
 <SolidColorBrush x:Key="AtUiHoverSurface" Color="#F1F6FD"/>
 <SolidColorBrush x:Key="AtUiHoverBorder" Color="#A8C6E8"/>
 <SolidColorBrush x:Key="AtUiPressedSurface" Color="#DEEAF9"/>
 <SolidColorBrush x:Key="AtUiAccent" Color="#2368BD"/>
 <SolidColorBrush x:Key="AtUiAccentHover" Color="#1F5BA7"/>
 <SolidColorBrush x:Key="AtUiAccentPressed" Color="#17477F"/>
 <SolidColorBrush x:Key="AtUiStepTitle" Color="#263D5C"/>
 <SolidColorBrush x:Key="AtUiStepSummary" Color="#587795"/>
 <SolidColorBrush x:Key="AtUiStepResource" Color="#8498B0"/>
 <SolidColorBrush x:Key="AtUiStepStatus" Color="#8293A9"/>
 <FontFamily x:Key="AtUiFont">Segoe UI, Microsoft YaHei UI</FontFamily>
 <sys:Double x:Key="AtUiBodySize">12</sys:Double>
 <sys:Double x:Key="AtUiCaptionSize">11</sys:Double>
 <sys:Double x:Key="AtUiMicroSize">10</sys:Double>
 <sys:Double x:Key="AtUiButtonHeight">26</sys:Double>
 <sys:Double x:Key="AtUiStepHeight">35</sys:Double>
 <sys:Double x:Key="AtUiPhaseHeight">34</sys:Double>
 <sys:Double x:Key="AtUiBranchHeight">26</sys:Double>
 <Thickness x:Key="AtUiButtonPadding">9,3</Thickness>
 <Thickness x:Key="AtUiStepIconMargin">0,0,7,0</Thickness>
</ResourceDictionary>
