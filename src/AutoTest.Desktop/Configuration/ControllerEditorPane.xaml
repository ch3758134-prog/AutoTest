<UserControl x:Class="AutoTest.Desktop.Configuration.ControllerEditorPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="White" Foreground="#263C55" FontSize="13"
 FontFamily="{StaticResource UiFont}">
 <UserControl.Resources>
  <Style x:Key="ControllerHeading" TargetType="TextBlock">
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#294F7A"/>
   <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="ControllerHint" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#70859C"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="ControllerFieldLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#526D8C"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <DataTemplate x:Key="ControllerGenericField">
   <StackPanel Margin="0,0,17,17">
    <TextBlock Text="{Binding Title}" Style="{StaticResource ControllerFieldLabel}"/>
    <Grid>
     <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      IsReadOnly="{Binding IsReadOnly}" Padding="8,7" MinHeight="33">
      <TextBox.Style>
       <Style TargetType="TextBox">
        <Setter Property="Visibility" Value="Visible"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding HasOptions}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBox.Style>
     </TextBox>
     <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value,Mode=TwoWay}"
      Padding="6,4" MinHeight="33">
      <ComboBox.Style>
       <Style TargetType="ComboBox">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding HasOptions}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </ComboBox.Style>
     </ComboBox>
    </Grid>
    <TextBlock Text="{Binding Hint}" Foreground="#8192A5"
     FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
   </StackPanel>
  </DataTemplate>
  <Style x:Key="ControllerKeySwitch" TargetType="CheckBox">
   <Setter Property="Height" Value="43"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="ToolTip" Value="改变的是配置草稿，不会立即向 KEY_SIM 发送指令"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <Border x:Name="Tile" Background="#F7F9FC" BorderBrush="#D6E2EF"
       BorderThickness="1" CornerRadius="5" Padding="8,6">
       <Grid>
        <TextBlock x:Name="Caption" Text="{TemplateBinding Content}"
         HorizontalAlignment="Center" VerticalAlignment="Center"
         Foreground="#405B77" FontSize="12" FontWeight="Medium"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Tile" Property="BorderBrush" Value="#81AED7"/>
       </Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Tile" Property="Background" Value="#DAEFEF"/>
        <Setter TargetName="Tile" Property="BorderBrush" Value="#2A918C"/>
        <Setter TargetName="Caption" Property="Foreground" Value="#166760"/>
        <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Tile" Property="Background" Value="#F1F3F6"/>
        <Setter TargetName="Caption" Property="Foreground" Value="#A1AFBE"/>
        <Setter Property="Cursor" Value="Arrow"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="23,21,25,26" MaxWidth="1050">
   <!-- Profile: ECU identity and verified hardware policy only. -->
   <StackPanel Visibility="{Binding IsControllerOverview,Converter={StaticResource BoolToVisibility}}">
    <TextBlock Text="ECU 与按键模拟硬件" Style="{StaticResource ControllerHeading}"/>
    <TextBlock Text="此配置决定 ECU 功能动作如何映射为 KEY_SIM 电阻开关组合，不会改变板载物理接线。"
     Style="{StaticResource ControllerHint}" Margin="0,0,0,19"/>
    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource ControllerGenericField}">
     <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
    </ItemsControl>
    <Border Background="#F4F9FE" BorderBrush="#D9E7F5" BorderThickness="1"
     CornerRadius="5" Padding="15" Margin="0,8,0,0">
     <StackPanel>
      <TextBlock Text="20 Key 硬件资源边界" FontWeight="SemiBold"
       FontSize="14" Foreground="#30597F" Margin="0,0,0,8"/>
      <TextBlock Text="{Binding HardwareKeySummary}"
       Style="{StaticResource ControllerHint}" Margin="0,0,0,12"/>
      <Button Content="设置已经确认的硬件可用 Key…" Command="{Binding PickSupportedKeysCommand}"
       HorizontalAlignment="Left" Padding="12,7" MinHeight="33"/>
      <TextBlock Text="Key01～Key20 是电阻网络组合开关；真正被 ECU 识别的是五路模拟输出电压。"
       Style="{StaticResource ControllerHint}" Margin="0,11,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>

   <!-- An ECU function is an operator-facing name containing multiple states. -->
   <StackPanel Visibility="{Binding IsControllerDefinition,Converter={StaticResource BoolToVisibility}}">
    <TextBlock Text="ECU 功能按键" Style="{StaticResource ControllerHeading}"/>
    <TextBlock Text="先给功能命名，再在左侧选择“按下 / 松开”等具体状态，编辑对应的电阻组合与电压。"
     Style="{StaticResource ControllerHint}" Margin="0,0,0,18"/>
    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource ControllerGenericField}">
     <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
    </ItemsControl>
    <Button Content="＋ 为此功能新增状态" Command="{Binding AddStateCommand}"
     HorizontalAlignment="Left" Padding="13,8" MinHeight="34" Margin="0,6,0,0"/>
   </StackPanel>

   <!-- State: the real 20-key mask and five voltage windows, edited in context. -->
   <StackPanel Visibility="{Binding IsControllerState,Converter={StaticResource BoolToVisibility}}">
    <DockPanel Margin="0,0,0,18">
     <Button DockPanel.Dock="Right" Content="设为该功能的默认状态"
      Command="{Binding SetDefaultCommand}" Padding="10,6"/>
     <StackPanel>
      <TextBlock Text="{Binding ControllerSelectionTitle}" Style="{StaticResource ControllerHeading}"/>
      <TextBlock Text="编辑 ECU 功能状态及其 KEY_SIM 开关组合"
       Style="{StaticResource ControllerHint}"/>
     </StackPanel>
    </DockPanel>
    <Grid Margin="0,0,0,19">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <TextBlock Text="状态名称" Style="{StaticResource ControllerFieldLabel}"/>
      <TextBox Text="{Binding StateNameField.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       Padding="8,7" Height="34"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="动作方式" Style="{StaticResource ControllerFieldLabel}"/>
      <ComboBox ItemsSource="{Binding InteractionChoices}"
       DisplayMemberPath="Label" SelectedValuePath="Id"
       SelectedValue="{Binding StateInteractionField.Value,Mode=TwoWay}"
       Height="34" Padding="6,4"/>
     </StackPanel>
    </Grid>
    <Border BorderBrush="#D6E4EE" BorderThickness="1" CornerRadius="6"
     Background="#FAFCFE" Padding="14" Margin="0,0,0,17">
     <StackPanel>
      <DockPanel Margin="0,0,0,8">
       <Button DockPanel.Dock="Right" Content="全部释放" Command="{Binding ClearKeyMaskCommand}"
        Padding="10,5" ToolTip="只清空当前状态的配置组合，不向设备发送释放命令"/>
       <TextBlock Text="20 Key 电阻网络组合" FontWeight="SemiBold" FontSize="14"
        Foreground="#2B577E" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="{Binding KeyMaskSummary}" Foreground="#2B7D7A"
       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <ItemsControl ItemsSource="{Binding KeyTiles}" Margin="0,5,0,5">
       <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
       </ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected,Mode=TwoWay}"
          IsEnabled="{Binding IsSelectable}" Style="{StaticResource ControllerKeySwitch}"/>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding HardwareKeySummary}" Style="{StaticResource ControllerHint}"
       Margin="4,7,4,1"/>
     </StackPanel>
    </Border>

    <TextBlock Text="五路模拟电压配置" Style="{StaticResource ControllerHeading}"/>
    <TextBlock Text="按通道填写目标电压、ECU 识别下限与上限；留空表示此通道未设定要求。"
     Style="{StaticResource ControllerHint}" Margin="0,0,0,10"/>
    <Border BorderBrush="#D6E2EE" BorderThickness="1" CornerRadius="5"
     Margin="0,0,0,20">
     <StackPanel>
      <Grid Background="#EEF4FA" Height="35">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="85"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <TextBlock Grid.Column="0" Text="输出" VerticalAlignment="Center" Margin="12,0"/>
       <TextBlock Grid.Column="1" Text="目标电压 (V)" VerticalAlignment="Center" Margin="10,0"/>
       <TextBlock Grid.Column="2" Text="识别下限 (V)" VerticalAlignment="Center" Margin="10,0"/>
       <TextBlock Grid.Column="3" Text="识别上限 (V)" VerticalAlignment="Center" Margin="10,0"/>
      </Grid>
      <ItemsControl ItemsSource="{Binding VoltageRows}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="#E8EDF3" BorderThickness="0,1,0,0" Padding="5,7">
          <Grid>
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
           </Grid.ColumnDefinitions>
           <TextBlock Grid.Column="0" Text="{Binding ChannelLabel}" FontWeight="SemiBold"
            Foreground="#37658B" VerticalAlignment="Center" Margin="7,0"/>
           <TextBox Grid.Column="1" Text="{Binding Target.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            Padding="7,5" Margin="5,0" MinHeight="31"/>
           <TextBox Grid.Column="2" Text="{Binding Minimum.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            Padding="7,5" Margin="5,0" MinHeight="31"/>
           <TextBox Grid.Column="3" Text="{Binding Maximum.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            Padding="7,5" Margin="5,0" MinHeight="31"/>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>

    <TextBlock Text="动作时序" Style="{StaticResource ControllerHeading}"/>
    <Grid Margin="0,0,0,12">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <TextBlock Text="按下前延迟 (ms)" Style="{StaticResource ControllerFieldLabel}"/>
      <TextBox Text="{Binding StateBeforeField.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       Padding="8,7" MinHeight="33"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="短按保持 (ms)" Style="{StaticResource ControllerFieldLabel}"/>
      <TextBox Text="{Binding StateHoldField.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       Padding="8,7" MinHeight="33"/>
     </StackPanel>
     <StackPanel Grid.Column="4">
      <TextBlock Text="释放后间隔 (ms)" Style="{StaticResource ControllerFieldLabel}"/>
      <TextBox Text="{Binding StateAfterField.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       Padding="8,7" MinHeight="33"/>
     </StackPanel>
    </Grid>
    <StackPanel Visibility="{Binding RequiresReturnState,Converter={StaticResource BoolToVisibility}}"
     Margin="0,8,0,13">
     <TextBlock Text="松开后弹回哪个状态" Style="{StaticResource ControllerFieldLabel}"/>
     <ComboBox ItemsSource="{Binding ReturnStateChoices}"
      DisplayMemberPath="Label" SelectedValuePath="Id"
      SelectedValue="{Binding StateReturnField.Value,Mode=TwoWay}"
      MinHeight="33" Padding="7,5"/>
    </StackPanel>
    <StackPanel Visibility="{Binding RequiresExclusiveGroup,Converter={StaticResource BoolToVisibility}}"
     Margin="0,8,0,13">
     <TextBlock Text="互斥组名称" Style="{StaticResource ControllerFieldLabel}"/>
     <TextBox Text="{Binding StateGroupField.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      Padding="8,6" MinHeight="33"/>
    </StackPanel>
    <TextBlock Text="勾选状态只修改配置草稿。保存后由正式 TEST 步骤引用，真实按键控制仍须设备连接与物理授权。"
     Style="{StaticResource ControllerHint}" Margin="0,8,0,0"/>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>