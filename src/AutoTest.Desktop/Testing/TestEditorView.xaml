<UserControl x:Class="AutoTest.Desktop.Testing.TestEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel Margin="12">
  <!-- Selection and creation live above the tree. Structural operations
       remain available by right-clicking an individual step. -->
  <Border DockPanel.Dock="Top" Style="{StaticResource AtSurface}"
   Padding="12,11" Margin="0,0,0,12">
   <StackPanel>
    <DockPanel Margin="0,0,0,9">
     <TextBlock DockPanel.Dock="Right" Text="右键步骤查看更多操作"
      Style="{StaticResource AtHint}" VerticalAlignment="Center"/>
     <TextBlock Text="测试步骤编辑" Style="{StaticResource AtSectionTitle}"/>
    </DockPanel>
    <WrapPanel Margin="0,0,0,5">
     <TextBlock Text="步骤类型" VerticalAlignment="Center" Margin="0,0,7,0"/>
     <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding NewStepType,Mode=TwoWay}"
      Width="144" Margin="0,0,12,0"/>
     <TextBlock Text="阶段" VerticalAlignment="Center" Margin="0,0,7,0"/>
     <ComboBox ItemsSource="{Binding AvailablePhases}" SelectedItem="{Binding NewStepPhase,Mode=TwoWay}"
      Width="104" Margin="0,0,12,0"/>
     <Button Content="＋ 添加步骤" Command="{Binding InsertAfterCommand}"
      Style="{StaticResource AtPrimaryButton}" ToolTip="在选中步骤后插入"/>
     <Button Content="＋ 添加子步骤" Command="{Binding InsertChildCommand}"
      ToolTip="在选中步骤内部插入"/>
    </WrapPanel>
    <WrapPanel>
     <Button Content="新增阶段根节点" Command="{Binding InsertRootCommand}"/>
     <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,6,0">
      <MenuItem Header="插入选项 ▾">
       <MenuItem Header="在前面插入" Command="{Binding InsertBeforeCommand}"/>
       <MenuItem Header="在后面插入" Command="{Binding InsertAfterCommand}"/>
       <MenuItem Header="插入子节点" Command="{Binding InsertChildCommand}"/>
       <MenuItem Header="插入 IF / ELSE" Command="{Binding InsertElseCommand}"/>
      </MenuItem>
      <MenuItem Header="步骤操作 ▾">
       <MenuItem Header="上移" Command="{Binding MoveUpCommand}"/>
       <MenuItem Header="下移" Command="{Binding MoveDownCommand}"/>
       <MenuItem Header="复制步骤及子树" Command="{Binding CopyCommand}"/>
       <Separator/>
       <MenuItem Header="删除所选步骤" Command="{Binding DeleteCommand}"/>
      </MenuItem>
     </Menu>
    </WrapPanel>
   </StackPanel>
  </Border>
  <ListBox ItemsSource="{Binding FilteredSteps}" SelectedItem="{Binding SelectedStep,Mode=TwoWay}" MouseDoubleClick="OnDoubleClick" PreviewMouseRightButtonDown="OnStepRightClick">
   <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding IndexLabel}" Foreground="{StaticResource Subtle}" Margin="3"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="3"><TextBlock Text="{Binding TreeLabel}" FontWeight="Medium"/>
     <TextBlock Text="{Binding NodeType}" Foreground="{StaticResource Subtle}" Margin="8,0,0,0"/></StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding Expected}" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
    <TextBlock Grid.Column="3" Text="{Binding RunBadge}" Foreground="{StaticResource Warning}"/>
   </Grid></DataTemplate></ListBox.ItemTemplate>
   <ListBox.ContextMenu><ContextMenu>
    <MenuItem Header="前插" Click="InsertBefore_Click"/><MenuItem Header="后插" Click="InsertAfter_Click"/>
    <MenuItem Header="插入子步骤" Click="InsertChild_Click"/><MenuItem Header="插入条件分支（IF / ELSE）" Click="InsertElse_Click"/>
    <MenuItem Header="复制步骤及子树" Click="Copy_Click"/>
    <Separator/><MenuItem Header="上移" Click="MoveUp_Click"/><MenuItem Header="下移" Click="MoveDown_Click"/>
    <MenuItem Header="删除" Click="Delete_Click"/>
   </ContextMenu></ListBox.ContextMenu>
  </ListBox>
 </DockPanel>
</UserControl>
