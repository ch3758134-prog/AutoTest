<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><UseWPF>true</UseWPF>
    <AssemblyName>AutoTest.Desktop</AssemblyName></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AutoTest.Application/AutoTest.Application.csproj" />
    <ProjectReference Include="../AutoTest.Contracts/AutoTest.Contracts.csproj" />
    <ProjectReference Include="../AutoTest.Testing/AutoTest.Testing.csproj" />
    <ProjectReference Include="../AutoTest.Projects/AutoTest.Projects.csproj" />
    <ProjectReference Include="../AutoTest.Specialists/AutoTest.Specialists.csproj" />
    <ProjectReference Include="../AutoTest.DeviceLab/AutoTest.DeviceLab.csproj" />
    <ProjectReference Include="../AutoTest.Flash/AutoTest.Flash.csproj" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Prism.DryIoc" /><PackageReference Include="System.IO.Ports" /></ItemGroup>
  <!-- Keep the actual hash-verified PROJECT manifest, TEST program and DBC together.
       They are genuine project files for UI review, never synthetic execution data. -->
  <ItemGroup>
    <Content Include="../../samples/ui-review-epb/**/*">
      <Link>samples/ui-review-epb/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
