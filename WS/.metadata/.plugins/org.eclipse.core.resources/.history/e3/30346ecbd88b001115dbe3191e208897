ISR(Drv_CAN_Err_ISR) //CAN错误中断
{
  // 清除CAN状态变化中断标志位
  CANRFLG_CSCIF  =  1; 
  
  // 清除所有发送缓冲区的请求
  CANTARQ_ABTRQ0=1;
  CANTARQ_ABTRQ1=1;
  CANTARQ_ABTRQ2=1;  
  
  // 设置总线关闭标志位
  sDrvCan_Busoff =  1;
}

