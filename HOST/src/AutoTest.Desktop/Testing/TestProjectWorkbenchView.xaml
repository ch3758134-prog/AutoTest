<UserControl x:Class="AutoTest.Desktop.Testing.TestProjectWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="13" Background="White" Foreground="#2B3435">
 <UserControl.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
 </UserControl.InputBindings>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="53"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="25"/>
  </Grid.RowDefinitions>
  <!-- The ordered list is the main work object, not a scroll child below
       two permanent parameter forms. Keep native DataGrid virtualization. -->
  <Border Grid.Row="0" Background="White" BorderBrush="#DCE5EE"
   BorderThickness="0,0,0,1">
   <DockPanel Margin="14,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
     VerticalAlignment="Center">
     <Button Content="▶ 运行所选" Command="{Binding RunSelectedCommand}"
      Style="{StaticResource AtPrimaryButton}" Margin="0,0,7,0" Padding="11,7"/>
     <Button Content="■ 停止" Command="{Binding StopSelectedCommand}" Padding="10,7"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
      Foreground="#2B455D" MaxWidth="280" TextTrimming="CharacterEllipsis"
      VerticalAlignment="Center"/>
     <TextBlock Text="{Binding TotalCount,StringFormat=' · {0} 个用例'}"
      Foreground="#71869A" VerticalAlignment="Center" Margin="9,0,0,0"/>
     <Button Content="＋ 新建用例" Command="{Binding CreateNewPackageCommand}"
      Margin="13,0,0,0" Padding="11,7"
      ToolTip="新建一个真正的 TEST 定义并加入此有序项目"/>
    </StackPanel>
   </DockPanel>
  </Border>
      <Border Grid.Row="1" BorderBrush="#E1E7E4" BorderThickness="1" CornerRadius="7"
     Background="White" ClipToBounds="True">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/>
       <RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FAFCFA" BorderBrush="#ECF2EF"
       BorderThickness="0,0,0,1">
       <DockPanel Margin="10,0">
        <TextBlock Text="添加测试用例" FontWeight="SemiBold" FontSize="11"
         VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox ItemsSource="{Binding AvailablePackages}"
         SelectedItem="{Binding SelectedAvailable,Mode=TwoWay}"
         DisplayMemberPath="Label" Width="290" Height="27"
         VerticalAlignment="Center" Margin="0,0,7,0"/>
        <Button Content="＋ 添加到项目" Command="{Binding AddCommand}"
         VerticalAlignment="Center"/>
       </DockPanel>
      </Border>
      <DataGrid x:Name="PackagesGrid" Grid.Row="1"
       ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage,Mode=TwoWay}"
       AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
       HeadersVisibility="Column" RowHeight="68" ColumnHeaderHeight="36"
       MinHeight="100" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True"
       VirtualizingPanel.VirtualizationMode="Recycling"
       ScrollViewer.CanContentScroll="True"
       ScrollViewer.HorizontalScrollBarVisibility="Auto"
       EnableRowVirtualization="True" SelectionUnit="FullRow"
       MouseDoubleClick="PackagesGrid_DoubleClick">
       <DataGrid.RowStyle>
        <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding RunSelected}" Value="True">
           <Setter Property="Background" Value="#F1F8F4"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding RunSelected}" Value="False">
           <Setter Property="Background" Value="#FBFCFB"/>
           <Setter Property="Foreground" Value="#778598"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </DataGrid.RowStyle>
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="本次执行" Width="92">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <CheckBox IsChecked="{Binding RunSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="只影响本次实际运行选择">
            <CheckBox.Content>
             <TextBlock FontSize="11" Foreground="#475668">
              <TextBlock.Style>
               <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Text" Value="已选"/>
                <Style.Triggers>
                 <DataTrigger Binding="{Binding RunSelected}" Value="False">
                  <Setter Property="Text" Value="—"/>
                  <Setter Property="Foreground" Value="#9AA7B6"/>
                 </DataTrigger>
                </Style.Triggers>
               </Style>
              </TextBlock.Style>
             </TextBlock>
            </CheckBox.Content>
           </CheckBox>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="顺序" Binding="{Binding Order,StringFormat={}{0:D2}}"
         IsReadOnly="True" Width="65"/>
        <DataGridTemplateColumn Header="测试用例" Width="*">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
          <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="6,3,5,3">
           <Button Content="{Binding Name}" Tag="{Binding}" Click="OpenPackage_Click"
            FontSize="14" FontWeight="SemiBold" Foreground="#243D54"
            HorizontalAlignment="Left" Height="29" MinHeight="0"
            Background="Transparent" BorderThickness="0"
            Padding="3,2" ToolTip="打开此用例编辑步骤"
            Style="{StaticResource AtQuietButton}"/>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
  <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#DCE5EF"
   BorderThickness="0,1,0,0" Padding="12,8">
   <StackPanel>
    <DockPanel Margin="0,0,0,6">
     <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
      <Button Content="全选" Command="{Binding SelectAllCommand}" Margin="0,0,5,0"/>
      <Button Content="清空" Command="{Binding ClearSelectionCommand}"/>
     </StackPanel>
     <TextBlock Text="{Binding SelectionSummary}" VerticalAlignment="Center" FontWeight="SemiBold"/>
    </DockPanel>
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="ECU 编号（调试可留空）" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBox Width="240" Height="28" VerticalContentAlignment="Center"
      Text="{Binding DutIdentity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
    <ItemsControl ItemsSource="{Binding BatchResults}" Margin="0,6,0,0"
     MaxHeight="110" ScrollViewer.VerticalScrollBarVisibility="Auto">
     <ItemsControl.ItemTemplate><DataTemplate>
      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="#455E76"
       Margin="0,2,0,0"/>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Border>
  <Border Grid.Row="3" Background="#F9FBFD" BorderBrush="#E0E7EE"
   BorderThickness="0,1,0,0">
   <TextBlock Text="{Binding StatusMessage}" Foreground="#5B7188"
    FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0"/>
  </Border>
 </Grid>
</UserControl>
