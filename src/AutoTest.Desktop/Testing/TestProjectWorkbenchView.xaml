<UserControl x:Class="AutoTest.Desktop.Testing.TestProjectWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White" Foreground="#1E2C41">
 <UserControl.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
 </UserControl.InputBindings>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/>
   <RowDefinition Height="25"/></Grid.RowDefinitions>
  <!-- Project pagehead, one action in the exact HTML hierarchy. -->
  <Border Grid.Row="0" Background="White" BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="＋ 新建用例" Command="{Binding CreateNewPackageCommand}"
      Style="{StaticResource AtPrimaryButton}" Margin="0,0,6,0"
      ToolTip="创建空白真实 TEST，加入当前项目并打开步骤编辑器"/>
     <Button Content="添加已有用例" Command="{Binding AddCommand}" Margin="0,0,6,0"
      ToolTip="从现有工程 TEST 资产中添加到本测试项目"/>
     <Button Content="保存" Command="{Binding SaveCommand}" Margin="0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
      VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
     <Border Background="#F7F9FC" CornerRadius="4" BorderBrush="#DBE3ED"
      BorderThickness="1" Padding="6,2" Margin="10,0,0,0">
      <TextBlock Text="{Binding TotalCount,StringFormat='{}{0} 个测试用例'}"
       FontSize="10" Foreground="#64758C"/>
     </Border>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
   HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="15,12,15,15">
    <!-- Blue-tinted temporary engineer selection bar; not persisted Enabled. -->
    <Border Background="#EBF4FF" BorderBrush="#BED7F3" BorderThickness="1"
     CornerRadius="7" Padding="11,8" Margin="0,0,0,12">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="全选" Command="{Binding SelectAllCommand}" Margin="0,0,5,0"/>
       <Button Content="清空" Command="{Binding ClearSelectionCommand}" Margin="0,0,7,0"/>
       <Button Content="▷ 检查所选" Command="{Binding PreflightSelectedCommand}"
        Style="{StaticResource AtPrimaryButton}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="本次执行" FontSize="13" FontWeight="SemiBold" Margin="0,0,14,0"
        VerticalAlignment="Center"/>
       <TextBlock Text="{Binding SelectedCount}" Foreground="#2368BD" FontSize="19"
        FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,2,0"/>
       <TextBlock Text="{Binding TotalCount,StringFormat=' / {0} 个用例'}" FontSize="12"
        Foreground="#6983A2" VerticalAlignment="Center">
        <TextBlock.LayoutTransform><ScaleTransform ScaleX="1" ScaleY="1"/></TextBlock.LayoutTransform>
       </TextBlock>
      </StackPanel>
     </DockPanel>
    </Border>
    <Border BorderBrush="#DBE3ED" BorderThickness="1" CornerRadius="7"
     Background="White" ClipToBounds="True">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FAFCFF" BorderBrush="#E9EEF5"
       BorderThickness="0,0,0,1">
       <DockPanel Margin="10,0">
        <TextBlock Text="添加测试用例" FontWeight="SemiBold" FontSize="11"
         VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox ItemsSource="{Binding AvailablePackages}"
         SelectedItem="{Binding SelectedAvailable,Mode=TwoWay}"
         DisplayMemberPath="Label" Width="290" Height="27"
         VerticalAlignment="Center" Margin="0,0,7,0"/>
        <Button Content="＋ 添加到项目" Command="{Binding AddCommand}"
         VerticalAlignment="Center"/>
       </DockPanel>
      </Border>
      <DataGrid x:Name="PackagesGrid" Grid.Row="1"
       ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage,Mode=TwoWay}"
       AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
       HeadersVisibility="Column" RowHeight="45" ColumnHeaderHeight="29"
       MinHeight="100" MaxHeight="1300" BorderThickness="0"
       EnableRowVirtualization="True" SelectionUnit="FullRow"
       MouseDoubleClick="PackagesGrid_DoubleClick">
       <DataGrid.RowStyle>
        <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
         <Style.Triggers>
          <DataTrigger Binding="{Binding RunSelected}" Value="True">
           <Setter Property="Background" Value="#F1F7FF"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding RunSelected}" Value="False">
           <Setter Property="Background" Value="#FBFCFD"/>
           <Setter Property="Foreground" Value="#778598"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </DataGrid.RowStyle>
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="本次执行" Width="80">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <CheckBox IsChecked="{Binding RunSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="只影响本次执行选择">
            <CheckBox.Content>
             <TextBlock FontSize="11" Foreground="#245F9D">
              <TextBlock.Style>
               <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Text" Value="已选"/>
                <Style.Triggers>
                 <DataTrigger Binding="{Binding RunSelected}" Value="False">
                  <Setter Property="Text" Value="—"/>
                  <Setter Property="Foreground" Value="#9AA7B6"/>
                 </DataTrigger>
                </Style.Triggers>
               </Style>
              </TextBlock.Style>
             </TextBlock>
            </CheckBox.Content>
           </CheckBox>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="顺序" Binding="{Binding Order,StringFormat={}{0:D2}}"
         IsReadOnly="True" Width="57"/>
        <DataGridTemplateColumn Header="测试用例" Width="*">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
           <Button Content="{Binding Name}" Tag="{Binding}" Click="OpenPackage_Click"
            FontSize="11" FontWeight="SemiBold" Foreground="#254A72"
            HorizontalAlignment="Left" Height="21" MinHeight="0"
            Background="Transparent" BorderThickness="0"
            Padding="2,0" ToolTip="打开此用例编辑步骤"
            Style="{StaticResource AtQuietButton}"/>
           <StackPanel Orientation="Horizontal" Height="17" ToolTip="{Binding PinDetail}">
            <TextBlock Text="{Binding PinStatus}" FontSize="10" Foreground="#778BA2"
             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button Content="采用当前修订" Tag="{Binding}" Click="AdoptCurrentRevision_Click"
             FontSize="10" Margin="6,0,0,0" Padding="3,0" MinHeight="0" Height="17"
             ToolTip="核对固定的 TEST Revision/SHA 后，再采用新修订">
             <Button.Style>
              <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AtQuietButton}">
               <Setter Property="Visibility" Value="Collapsed"/>
               <Style.Triggers>
                <DataTrigger Binding="{Binding CanAdoptLatest}" Value="True">
                 <Setter Property="Visibility" Value="Visible"/>
                 <Setter Property="Foreground" Value="#2167B8"/>
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </Button.Style>
            </Button>
           </StackPanel>
          </StackPanel>
         </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="工程默认" Width="112">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <CheckBox Content="默认启用" IsChecked="{Binding Enabled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            FontSize="10" Foreground="#7D8DA0"
            VerticalAlignment="Center" HorizontalAlignment="Center"
            ToolTip="保存至正式项目；不等于本次选择"/>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="步骤" Binding="{Binding StepCountLabel}"
         IsReadOnly="True" Width="66"/>
        <DataGridTemplateColumn Header="调整" Width="118">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <StackPanel Orientation="Horizontal">
            <Button Content="↑" Tag="{Binding}" Click="MoveRowUp_Click" Width="26"
             MinWidth="0" Height="23" MinHeight="0" Margin="0,0,4,0"
             ToolTip="上移此用例"/>
            <Button Content="↓" Tag="{Binding}" Click="MoveRowDown_Click" Width="26"
             MinWidth="0" Height="23" MinHeight="0" Margin="0,0,4,0"
             ToolTip="下移此用例"/>
            <Button Content="×" Tag="{Binding}" Click="RemoveRow_Click" Width="26"
             MinWidth="0" Height="23" MinHeight="0" Foreground="#C04A57"
             ToolTip="移除项目引用，不删除原始 TEST 文件"/>
           </StackPanel>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="#FBFCFF" BorderBrush="#DBE3ED"
   BorderThickness="0,1,0,0">
   <TextBlock Text="{Binding StatusMessage}" Foreground="#64758C" FontSize="10"
    VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0"/>
  </Border>
 </Grid>
</UserControl>
