<UserControl x:Class="AutoTest.Desktop.Shell.ProductionInspectionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:AutoTest.Desktop.Shell"
 FontFamily="{StaticResource UiFont}" FontSize="12"
 Background="#F6F8FA" Foreground="#25313C">
 <UserControl.Resources>
  <Style x:Key="ProductionHeading" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#25313C"/>
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type shell:ProductionInspectionNode}"
   ItemsSource="{Binding Children}">
   <DockPanel MinWidth="180" LastChildFill="True" Margin="0,3,0,3">
    <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="11"
     Foreground="#54708B" Margin="12,0,4,0" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal">
     <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
      Foreground="#263644" FontSize="12" MaxWidth="245"/>
     <TextBlock Text="{Binding Kind,StringFormat=' · {0}'}" Foreground="#84919D"
      FontSize="10" Margin="5,1,0,0" MaxWidth="105" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </DockPanel>
  </HierarchicalDataTemplate>
 </UserControl.Resources>
 <Grid Margin="16,13,16,14">
  <Grid.RowDefinitions>
   <RowDefinition Height="56"/>
   <RowDefinition Height="94"/>
   <RowDefinition Height="*" MinHeight="230"/>
   <RowDefinition Height="184" MinHeight="140"/>
  </Grid.RowDefinitions>

  <!-- Navigation, never a second TEST editor or a fake run button. -->
  <DockPanel Grid.Row="0" LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="刷新测试树" Command="{Binding RefreshCommand}"
     Margin="0,0,8,0" MinHeight="31" Padding="14,5"/>
    <Button Content="连接／查看扫码枪" Command="{Binding OpenScannerCommand}"
     MinHeight="31" Padding="14,5" Style="{StaticResource AtPrimaryButton}"/>
   </StackPanel>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="生产检测" FontSize="21" FontWeight="SemiBold" Foreground="#263644"/>
    <TextBlock Text="{Binding ProjectName}" Foreground="#738496" FontSize="12"
     TextTrimming="CharacterEllipsis" MaxWidth="640"/>
   </StackPanel>
  </DockPanel>

  <Grid Grid.Row="1" Margin="0,0,0,11">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.12*"/><ColumnDefinition Width="9"/>
    <ColumnDefinition Width="1*"/><ColumnDefinition Width="9"/>
    <ColumnDefinition Width="1.18*"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" CornerRadius="8" Background="White"
    BorderBrush="#E0E7EE" BorderThickness="1" Padding="12,9">
    <StackPanel>
     <TextBlock Text="当前检测对象" Foreground="#778697" FontSize="11"/>
     <TextBlock Text="{Binding DutSerial}" FontSize="19" FontWeight="SemiBold"
      Foreground="#263644" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>
     <TextBlock Text="{Binding ModelCode,StringFormat='型号  {0}'}"
      Foreground="#63788D" FontSize="11"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" CornerRadius="8" Background="White"
    BorderBrush="#E0E7EE" BorderThickness="1" Padding="12,9">
    <StackPanel>
     <TextBlock Text="工程已启用用例" Foreground="#778697" FontSize="11"/>
     <TextBlock Text="{Binding EnabledCaseCount,StringFormat='{}{0} 个'}"
      Foreground="#263644" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,2"/>
     <TextBlock Text="{Binding ProductionReadiness}" Foreground="#63788D"
      FontSize="11" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding ProductionReadiness}"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="4" CornerRadius="8" Background="White"
    BorderBrush="#E0E7EE" BorderThickness="1" Padding="12,9">
    <StackPanel>
     <TextBlock Text="当前阶段" Foreground="#778697" FontSize="11"/>
     <TextBlock Text="{Binding Phase}" FontSize="17" FontWeight="SemiBold"
      Foreground="#2F6FA9" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>
     <TextBlock Text="{Binding MonitorMode}" Foreground="#63788D"
      FontSize="11" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding MonitorMode}"/>
    </StackPanel>
   </Border>
  </Grid>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="2*" MinWidth="310"/><ColumnDefinition Width="10"/>
    <ColumnDefinition Width="3*" MinWidth="360"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" CornerRadius="9" Background="White"
    BorderBrush="#E0E7EE" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Grid.Row="0" BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="13,0">
      <DockPanel LastChildFill="True">
       <TextBlock DockPanel.Dock="Right"
        Text="{Binding ObservedStepCount,StringFormat='已收到 {0} 条步骤结果'}"
        Foreground="#75869A" FontSize="11" VerticalAlignment="Center"/>
       <TextBlock Text="测试用例与实际步骤" FontSize="14" FontWeight="SemiBold"
        Foreground="#263644" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <TreeView Grid.Row="1" Margin="7,5" Background="Transparent"
      BorderThickness="0" ItemsSource="{Binding Cases}"
      SelectedItemChanged="Cases_SelectedItemChanged"
      VirtualizingStackPanel.IsVirtualizing="True"
      ScrollViewer.HorizontalScrollBarVisibility="Auto"
      ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>
   </Border>
   <Border Grid.Column="2" CornerRadius="9" Background="White"
    BorderBrush="#E0E7EE" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Grid.Row="0" BorderBrush="#EDF1F5" BorderThickness="0,0,0,1" Padding="13,0">
      <TextBlock Text="步骤与测量详情" FontSize="14" FontWeight="SemiBold"
       Foreground="#263644" VerticalAlignment="Center"/>
     </Border>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="15,13">
       <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedState}"
         Foreground="#2F6FA9" FontWeight="SemiBold" FontSize="12"
         VerticalAlignment="Center" Margin="8,0,0,0"/>
        <StackPanel>
         <TextBlock Text="{Binding SelectedName}" FontSize="17" FontWeight="SemiBold"
          Foreground="#263644" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding SelectedKind}" FontSize="11"
          Foreground="#738496" Margin="0,3,0,0"/>
        </StackPanel>
       </DockPanel>
       <Border Height="1" Background="#E8EDF1" Margin="0,12"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
         <TextBlock Text="实际观测" Foreground="#778697" FontSize="11"/>
         <TextBlock Text="{Binding SelectedActual}" FontSize="16" FontWeight="SemiBold"
          Foreground="#263644" TextWrapping="Wrap" Margin="0,4,8,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
         <TextBlock Text="预期／判据" Foreground="#778697" FontSize="11"/>
         <TextBlock Text="{Binding SelectedExpected}" FontSize="14"
          Foreground="#263644" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
       </Grid>
       <TextBlock Text="执行时间" Foreground="#778697" FontSize="11" Margin="0,16,0,3"/>
       <TextBlock Text="{Binding SelectedTime}" Foreground="#263644"/>
       <TextBlock Text="真实步骤详情" Foreground="#778697" FontSize="11" Margin="0,16,0,3"/>
       <TextBlock Text="{Binding SelectedDetail}" Foreground="#42556A"
        TextWrapping="Wrap"/>
       <Grid Margin="0,13,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
         <TextBlock Text="观测质量" Foreground="#778697" FontSize="11"/>
         <TextBlock Text="{Binding SelectedQuality}" Foreground="#42556A"
          TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
         <TextBlock Text="步骤执行实例" Foreground="#778697" FontSize="11"/>
         <TextBlock Text="{Binding SelectedOccurrence}" Foreground="#42556A"
          TextWrapping="Wrap" Margin="0,3,0,0" FontSize="10"/>
        </StackPanel>
       </Grid>
       <TextBlock Text="证据引用" Foreground="#778697" FontSize="11" Margin="0,13,0,3"/>
       <TextBlock Text="{Binding SelectedEvidence}" Foreground="#42556A"
        TextWrapping="Wrap" FontSize="11"/>
       <Border Height="1" Background="#E8EDF1" Margin="0,14,0,11"/>
       <TextBlock Text="生产前置烧录" FontWeight="SemiBold" Foreground="#263644"/>
       <TextBlock Text="{Binding FlashState}" TextWrapping="Wrap" Foreground="#657A90"
        Margin="0,5,0,13"/>
       <TextBlock Text="测试执行" FontWeight="SemiBold" Foreground="#263644"/>
       <TextBlock Text="{Binding TestState}" TextWrapping="Wrap" Foreground="#657A90"
        Margin="0,5,0,13"/>
       <TextBlock Text="{Binding LatestRunId,StringFormat='研发 RunId  {0}'}"
        Foreground="#60758B" FontSize="11" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding ReportPath}" Foreground="#60758B"
        FontSize="11" TextTrimming="CharacterEllipsis"
        ToolTip="{Binding ReportPath}" Margin="0,5,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>

  <Border Grid.Row="3" Background="White" CornerRadius="9"
   BorderBrush="#E0E7EE" BorderThickness="1" Margin="0,10,0,0">
   <TabControl BorderThickness="0" Background="White" Margin="7,3">
    <TabItem Header="执行时间线">
     <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False"
      IsReadOnly="True" CanUserAddRows="False"
      HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="27"
      BorderThickness="0" GridLinesVisibility="None">
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="105"/>
       <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="95"/>
       <DataGridTextColumn Header="事件" Binding="{Binding Event}" Width="160"/>
       <DataGridTextColumn Header="真实信息" Binding="{Binding Detail}" Width="*"/>
       <DataGridTextColumn Header="步骤实例 ID" Binding="{Binding Occurrence}" Width="185"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="CAN 实时事件">
     <DataGrid ItemsSource="{Binding CanRecords}" AutoGenerateColumns="False"
      IsReadOnly="True" CanUserAddRows="False"
      HeadersVisibility="Column" RowHeaderWidth="0" RowHeight="27"
      BorderThickness="0" GridLinesVisibility="None">
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="110"/>
       <DataGridTextColumn Header="通道" Binding="{Binding Port}" Width="120"/>
       <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="100"/>
       <DataGridTextColumn Header="完整帧 DATA" Binding="{Binding Data}" Width="*"/>
       <DataGridTextColumn Header="丢帧计数" Binding="{Binding Lost}" Width="95"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
   </TabControl>
  </Border>
 </Grid>
</UserControl>
