<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Integrated professional window, not a second EXE or USB background agent. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AutoTest.FlashLab</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AutoTest.Core/AutoTest.Core.csproj" />
    <ProjectReference Include="../AutoTest.Contracts/AutoTest.Contracts.csproj" />
    <ProjectReference Include="../AutoTest.Devices/AutoTest.Devices.csproj" />
    <ProjectReference Include="../AutoTest.Specialists/AutoTest.Specialists.csproj" />
  </ItemGroup>
  <!-- The user-supplied, SHA-verified fixed SafetyFile is an internal application
       resource, not a selectable per-project file or a separately deployed DLL. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/SafetyFile.dll.gz"
                      LogicalName="AutoTest.FlashLab.FixedSafetyFileGzip" />
  </ItemGroup>
</Project>
