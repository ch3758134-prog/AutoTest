<Window x:Class="AutoTest.FlashLab.Shell.FlashLabWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · CAN1 ECU 烧录调试" Width="1420" Height="900"
 MinWidth="1080" MinHeight="720" WindowState="Maximized"
 WindowStartupLocation="CenterScreen" Background="#F4F7FB"
 FontFamily="Microsoft YaHei UI" FontSize="13" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Margin" Value="4,2"/>
   <Setter Property="MinHeight" Value="31"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#26394D"/>
   <Setter Property="BorderBrush" Value="#BBCBDD"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Margin" Value="4,2"/>
   <Setter Property="Padding" Value="7,5"/>
   <Setter Property="MinHeight" Value="29"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#C7D5E4"/>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="Margin" Value="6,4"/>
   <Setter Property="Padding" Value="9"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#CBD7E5"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#34465C"/>
  </Style>
 </Window.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="330"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#D6E1EE"
    BorderThickness="1" CornerRadius="5" Margin="2,0,2,5" Padding="13,9">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="AutoTest  /  ECU 烧录调试" FontSize="20" FontWeight="Bold" Foreground="#183E63"/>
     <TextBlock Text="  ·  主控 USB → CAN1 → ECU" FontSize="12"
       Foreground="#5B7894" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
    </StackPanel>
    <TextBlock Text="独立烧录测试 · 配置、连接、过程和 CAN 报文均可见"
      HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#61788F"/>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Background="White" BorderBrush="#D6E1EE"
    BorderThickness="1" CornerRadius="5" Margin="2,0,2,5" Padding="10,7">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click"/>
     <Button x:Name="ConnectButton" Content="连接 USB" Click="Connect_Click"
       Background="#D8ECFF" FontWeight="SemiBold"/>
     <Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Left" Text="USB 主控" FontWeight="Bold"
      VerticalAlignment="Center" Margin="4,0,12,0"/>
    <ComboBox x:Name="DeviceSelector" DockPanel.Dock="Left" Width="395"
      ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedDevice,Mode=TwoWay}"
      SelectionChanged="Device_SelectionChanged" DisplayMemberPath="DisplayIdentity"
      Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="UsbStatusLabel" Text="设备未连接，请连接主控后刷新"
      TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#7C5D2A"/>
   </DockPanel>
  </Border>


  <!-- 三栏：小型配置区 / 烧录步骤 / 全高度 CAN1 帧监视 -->
  <Grid Grid.Row="2" Margin="0,3,0,3">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="286" MinWidth="260"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="420" MinWidth="365"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="*" MinWidth="360"/>
   </Grid.ColumnDefinitions>

   <!-- A：导入文件是配置信息，不是主工作区 -->
   <GroupBox Grid.Column="0" Header="烧录配置">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="1">
      <Button Content="一键导入三文件所在目录…" Click="ImportThreeFiles_Click"
        Background="#D9EDFD" FontWeight="SemiBold" Margin="3,3,3,8"
        ToolTip="选择包含 Configuration.xml、HEX/S19/BIN 固件、SafetyFile.dll 的文件夹（包括常见子目录）。只读取并验证文件，不连接或擦写 ECU。"
        HorizontalAlignment="Stretch"/>
      <TextBlock Text="CanTool 配置文件" FontWeight="SemiBold" Margin="4,4,4,2"/>
      <StackPanel Orientation="Horizontal">
       <Button Content="打开 XML" Click="LoadXml_Click" Padding="9,5"/>
       <Button Content="导入 JSON" Click="LoadJson_Click" Padding="9,5"/>
       <Button Content="保存" Click="SaveXml_Click" Padding="9,5"/>
      </StackPanel>
      <TextBlock Text="{Binding ConfigurationPath}" ToolTip="{Binding ConfigurationPath}"
        TextTrimming="CharacterEllipsis" Margin="7,1,7,5" FontSize="11"
        Foreground="#62768B"/>

      <Separator Margin="5,3"/>
      <DockPanel LastChildFill="True" Margin="2,4,2,1">
       <Button DockPanel.Dock="Right" Content="选择..." Click="ChooseImage_Click"
         Padding="10,5"/>
       <TextBlock Text="烧录固件" FontWeight="SemiBold" VerticalAlignment="Center"
         Margin="4,0"/>
      </DockPanel>
      <TextBlock Text="{Binding FirmwarePath}" ToolTip="{Binding FirmwarePath}"
        TextTrimming="CharacterEllipsis" Margin="7,0,7,2" FontSize="11"/>
      <TextBlock Text="{Binding ImageSummary}" TextTrimming="CharacterEllipsis"
        ToolTip="{Binding ImageSummary}" Margin="7,0,7,3"
        FontSize="11" Foreground="#657B94"/>

      <Separator Margin="5,4"/>
      <DockPanel LastChildFill="True" Margin="2,4,2,1">
       <Button DockPanel.Dock="Right" Content="选择..." Click="ChooseSafetyFile_Click"
         Padding="10,5"/>
       <TextBlock Text="安全文件" FontWeight="SemiBold" VerticalAlignment="Center"
         Margin="4,0"/>
      </DockPanel>
      <TextBlock x:Name="SafetyDllStatusLabel" Text="自动从 XML 目录查找 SafetyFile.dll"
        TextTrimming="CharacterEllipsis" Margin="7,0,7,4"
        FontSize="11" Foreground="#62768B"/>

      <TextBlock Text="Seed/Key 使用 CanTool 参考内部算法；SafetyFile 会从配置目录自动识别。"
        TextWrapping="Wrap" Margin="7,5,7,5" FontSize="11" Foreground="#61768D"/>

      <Separator Margin="5,5"/>
      <Expander Header="详细参数 · CAN ID / 地址 / 镜像"
        IsExpanded="False" Margin="5,8,5,2">
       <StackPanel>
        <TextBlock Text="配置参数可双击编辑；修改后重新检查。"
          FontSize="11" Margin="3,5" TextWrapping="Wrap"/>
        <DataGrid ItemsSource="{Binding Parameters}"
          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
          HeadersVisibility="Column" RowHeaderWidth="0"
          Margin="1,2" Height="235" EnableRowVirtualization="True"
          ScrollViewer.HorizontalScrollBarVisibility="Auto">
         <DataGrid.Columns>
          <DataGridTextColumn Header="配置项" Binding="{Binding Name,Mode=OneWay}"
            Width="135" IsReadOnly="True"/>
          <DataGridTextColumn Header="值" Binding="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            Width="140"/>
          <DataGridTextColumn Header="来源" Binding="{Binding Source,Mode=OneWay}"
            Width="120" IsReadOnly="True"/>
          <DataGridTextColumn Header="说明" Binding="{Binding Description,Mode=OneWay}"
            Width="215" IsReadOnly="True"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding Unknown}" TextWrapping="Wrap"
          Margin="5,4" FontSize="11"/>
        <TextBlock Text="BIN 起始地址（十六进制）" FontSize="11" Margin="5,5,5,1"/>
        <TextBox x:Name="BinBaseBox" Margin="4,2"/>
        <CheckBox x:Name="LegacyTailSignatureCheck" Margin="4,5"
          Content="其他 ECU 手动启用尾部 12 34 56 78 签名"
          ToolTip="实测 HydEPB 配置自动启用并计入任务摘要；其他 ECU 仅在已确认 Bootloader 要求时手动勾选。"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </GroupBox>

   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
     Background="#D7E2EF" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

   <!-- B：烧录过程作为工作区 -->
   <GroupBox Grid.Column="2" Header="烧录流程 · UDS 调试">
    <Grid Margin="2">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="125"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="120"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0">
      <TextBlock x:Name="WorkflowStatusLabel"
        Text="连接 USB、导入文件后直接开始烧录" TextWrapping="Wrap"
        Margin="5,3,5,6" FontWeight="SemiBold" Foreground="#235A85"/>
      <TextBlock x:Name="FlashPlanSummary" Text="开始时自动检查 CAN 地址、固件、算法和 Flash 范围"
        TextWrapping="Wrap" FontSize="11" Margin="7,2,7,6"
        Foreground="#516B85" MaxHeight="105"/>
      <StackPanel Orientation="Horizontal" Margin="0,1,0,2">
       <Button x:Name="StartFlashButton" Content="开始烧录" Click="StartFlash_Click"
         Background="#CFE7FC" FontWeight="Bold" Padding="20,7"/>
       <Button x:Name="AbortFlashButton" Content="停止烧录" Click="AbortFlash_Click"
         IsEnabled="False" Padding="20,7"/>
      </StackPanel>
      <ProgressBar x:Name="FlashProgressBar" Height="13"
        Minimum="0" Maximum="100" Value="0" Margin="5,4,5,2"/>
      <TextBlock x:Name="FlashStageLabel" Text="待命" TextWrapping="Wrap"
        Margin="6,1,6,7" FontSize="11"/>
     </StackPanel>

     <TextBlock Grid.Row="1" Text="执行阶段" FontWeight="SemiBold"
       Foreground="#3D5772" Margin="7,5,0,3"/>
     <DataGrid Grid.Row="2" ItemsSource="{Binding Stages}"
       AutoGenerateColumns="False" CanUserAddRows="False"
       CanUserDeleteRows="False" IsReadOnly="True" Margin="4,0,4,4"
       HeadersVisibility="Column" RowHeaderWidth="0"
       EnableRowVirtualization="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="步骤" Binding="{Binding Step,Mode=OneWay}" Width="*"/>
       <DataGridTextColumn Header="结果" Binding="{Binding State,Mode=OneWay}" Width="96"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="3" Text="UDS 请求 / 响应 / NRC 与失败原因"
       FontWeight="SemiBold" Margin="7,5,2,4" Foreground="#3D5772"/>
     <ListBox Grid.Row="4" x:Name="LogList" ItemsSource="{Binding Logs}"
       FontFamily="Consolas" FontSize="11" Margin="4,0,4,3"
       ScrollViewer.HorizontalScrollBarVisibility="Auto"
       ScrollViewer.VerticalScrollBarVisibility="Auto"
       Background="#FCFDFE"/>
    </Grid>
   </GroupBox>

   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
     Background="#D7E2EF" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

   <!-- C：实测主观察区，全高度 CAN1 收发日志 -->
   <GroupBox Grid.Column="4" Header="CAN1 实时报文 · ECU 收发">
    <Grid Margin="2">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="2,0,2,6" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Content="导出日志" Click="Export_Click" Padding="10,5"/>
       <Button Content="清空显示" Click="ClearCan_Click" Padding="10,5"/>
      </StackPanel>
      <TextBlock Text="实时 TX / RX · USB ACK 区别于 ECU 响应"
        VerticalAlignment="Center" Margin="5,0,3,0"
        Foreground="#617B96" FontSize="11" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <DataGrid x:Name="CanLogTable" Grid.Row="1"
       ItemsSource="{Binding CanLogs}" AutoGenerateColumns="False"
       CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
       EnableRowVirtualization="True" EnableColumnVirtualization="True"
       GridLinesVisibility="Horizontal" RowHeaderWidth="0"
       HeadersVisibility="Column" Margin="2,0,2,2"
       ScrollViewer.HorizontalScrollBarVisibility="Auto"
       ScrollViewer.VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Time,Mode=OneWay}" Width="108"/>
       <DataGridTextColumn Header="方向" Binding="{Binding Direction,Mode=OneWay}" Width="76"/>
       <DataGridTextColumn Header="CAN ID" Binding="{Binding CanId,Mode=OneWay}" Width="95"/>
       <DataGridTextColumn Header="DLC" Binding="{Binding Dlc,Mode=OneWay}" Width="42"/>
       <DataGridTextColumn Header="CAN 数据（HEX）" Binding="{Binding Data,Mode=OneWay}" Width="*"/>
       <DataGridTextColumn Header="结果" Binding="{Binding Result,Mode=OneWay}" Width="195"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </GroupBox>
  </Grid>
  <Border Grid.Row="3" Background="#F4F7FB" BorderBrush="#D7E1EC"
    BorderThickness="0,1,0,0" Padding="7" Margin="4,3,4,0">
   <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="#30567B"
     TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>
