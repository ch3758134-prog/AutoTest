<UserControl x:Class="AutoTest.Desktop.Shell.ProjectConfigurationOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,0">
    <Button DockPanel.Dock="Right" Content="核对检测配置"
     Command="{Binding RefreshEngineeringSetupCommand}" Margin="0,0,0,0"
     VerticalAlignment="Center"/>
    <TextBlock Text="检测准备 · 当前 ECU 工程" FontSize="14" FontWeight="SemiBold"
     VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <TabControl x:Name="ConfigTabs" Grid.Row="1" Background="White" BorderThickness="0" Padding="0">
   <TabControl.Resources>
    <Style TargetType="{x:Type TabItem}">
     <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
     <Setter Property="FontSize" Value="11"/>
     <Setter Property="Foreground" Value="#64758C"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="{x:Type TabItem}">
        <Border x:Name="TabLine" Height="35" Background="#FBFCFF"
         BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="13,0">
         <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="TabLine" Property="BorderBrush" Value="#2368BD"/>
          <Setter TargetName="TabLine" Property="Background" Value="White"/>
          <Setter Property="Foreground" Value="#1C5DA8"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
         </Trigger>
         <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="TabLine" Property="Background" Value="#F0F5FB"/>
         </Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </TabControl.Resources>
   <TabControl.Template>
    <ControlTemplate TargetType="{x:Type TabControl}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FBFCFF" BorderBrush="#DBE3ED"
       BorderThickness="0,0,0,1">
       <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
      </Border>
      <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
       ContentSource="SelectedContent"/>
     </Grid>
    </ControlTemplate>
   </TabControl.Template>
   <TabItem Header="配置总览">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel MaxWidth="1200" Margin="14,12,14,16">
      <DockPanel LastChildFill="True" Margin="0,0,0,10">
       <TextBlock Text="{Binding SetupOverallStatus}" DockPanel.Dock="Right"
        Foreground="{StaticResource Subtle}" TextWrapping="Wrap"
        MaxWidth="420" Margin="12,0,0,0" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding CurrentProjectName}" FontWeight="SemiBold"
        FontSize="18" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
      </DockPanel>
 
      <TextBlock Text="配置项目" Foreground="{StaticResource Ink}" FontWeight="SemiBold"
       FontSize="14" Margin="0,0,0,7"/>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="10" Margin="0,0,0,5">
       <DockPanel LastChildFill="True">
        <StackPanel>
         <TextBlock Text="当前 ECU 工程" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupModelStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="10" Margin="0,0,0,5">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="编辑用例及顺序" Command="{Binding OpenFirstTestProjectCommand}"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="01  测试用例与执行顺序" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupTestStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="10" Margin="0,0,0,5">
       <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
         <Button Content="导入 DBC" Command="{Binding ImportDbcCommand}"
          Padding="11,7" Margin="0,0,8,0"/>
         <Button Content="打开波形工具" Command="{Binding OpenWaveWorkbenchCommand}"
          Padding="11,7"/>
        </StackPanel>
        <StackPanel>
         <TextBlock Text="02  测试资源 · DBC 与波形" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupResourcesStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="10" Margin="0,0,0,5">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="试扫唯一编号" Tag="scan" Click="NavigateToStage_Click"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="03  唯一编号扫码" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupScanStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="10" Margin="0,0,0,5">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="配置与验证烧录" Tag="flash" Click="NavigateToStage_Click"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="04  前置烧录" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupFlashStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="10" Margin="0,0,0,5">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="配置与试验夹具" Tag="station" Click="NavigateToStage_Click"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="05  夹具与 IGN 动作" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupStationStatus}" Foreground="{StaticResource Subtle}"
          Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border CornerRadius="8" BorderBrush="{StaticResource Line}" Background="White"
       BorderThickness="1" Padding="15">
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="查看检测准备情况" Tag="check" Click="NavigateToStage_Click"
         Padding="11,7" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="06  完整检测检查" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="统一检查身份、夹具、START、必烧录、全部 TEST 与记录。缺少真机证据时不得宣告生产就绪。"
          Foreground="{StaticResource Subtle}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
       </DockPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="扫码匹配">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Background="#F3F7FC" BorderBrush="#DBE5F0"
      BorderThickness="0,0,0,1" Padding="14,8">
      <TextBlock Text="工程提前声明扫码期望 · 一次扫码解析多个字段并核对期望；串口设备独立设置，试扫不是保存前提。"
       Foreground="#506986" TextWrapping="Wrap"/>
     </Border>
     <ContentControl x:Name="ScannerSetupHost" Grid.Row="1"
      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
   </TabItem>
   <TabItem Header="烧录工艺">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel MaxWidth="880" Margin="22,22,22,18">
      <TextBlock Text="工程前置烧录 · 原生工艺配置" FontSize="18" FontWeight="SemiBold"
       Foreground="{StaticResource Ink}"/>
      <TextBlock Text="{Binding SetupFlashStatus}" Foreground="#516B83"
       TextWrapping="Wrap" Margin="0,10,0,14"/>
      <TextBlock Text="当前工程内保存烧录参数、固件和算法。配置编辑器使用当前工程，不需要 CanTool XML，也不创建第二份扫码配方。"
       Foreground="{StaticResource Subtle}" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,16,0,0">
       <Button Content="编辑当前工程烧录工艺" Command="{Binding OpenNativeFlashProfileCommand}"
        Padding="15,9" Margin="0,0,10,8" Style="{StaticResource AtPrimaryButton}"/>
       <Button Content="真实烧录调试（查看 UDS/CAN）" Command="{Binding OpenFlashWorkbenchCommand}"
        Padding="15,9" Margin="0,0,10,8"/>
       <Button Content="检查当前配置" Command="{Binding RefreshEngineeringSetupCommand}"
        Padding="15,9" Margin="0,0,10,8"/>
      </WrapPanel>
      <Border Background="#F2F6FA" BorderBrush="#E0E8EF" BorderThickness="1"
       CornerRadius="6" Padding="12" Margin="0,10,0,0">
       <StackPanel>
        <TextBlock Text="正确的工程操作顺序" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="编辑并保存参数、固件和算法 → 按需预检和实体调试。正式检测使用当前保存的配置前置烧录。"
         Foreground="{StaticResource Subtle}" TextWrapping="Wrap"/>
        <TextBlock Text="烧录配置已保存不代表 ECU 已完成烧录。"
         Margin="0,9,0,0" TextWrapping="Wrap" Foreground="#9A6A2C"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="夹具与 IGN">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel MaxWidth="900" Margin="22,22,22,18">
      <TextBlock Text="夹具与 IGN · 工艺编辑和实体操作" FontSize="18"
       FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
      <TextBlock Text="{Binding SetupStationStatus}" Foreground="#516B83"
       TextWrapping="Wrap" Margin="0,10,0,14"/>
      <TextBlock Text="配置 IGN 和夹具动作；实际输出可在手动台架检查。"
       Foreground="{StaticResource Subtle}" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,14,0,0">
       <Button Content="连接 / 断开主控" Command="{Binding ConnectHardwareCommand}" Padding="14,8"
        Margin="0,0,9,8"/>
       <Button Content="读取夹具 MCU GPIO" Command="{Binding ReadEngineeringClampGpioCommand}"
        Padding="14,8" Margin="0,0,9,8"/>
       <Button Content="打开真实夹具操作台架" Command="{Binding OpenManualBenchCommand}"
        Style="{StaticResource AtPrimaryButton}" Padding="14,8" Margin="0,0,9,8"/>
      </WrapPanel>
      <Border Background="White" BorderBrush="#DDE6EE" BorderThickness="1"
       CornerRadius="7" Padding="13" Margin="0,12,0,0">
       <StackPanel>
        <TextBlock Text="工位操作"
         FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <WrapPanel Margin="0,0,0,8">
         <TextBlock Text="夹具 1" Width="75" VerticalAlignment="Center" FontWeight="SemiBold"/>
         <Button Content="压紧" Command="{Binding EngineeringClamp1PressCommand}" Padding="14,7" Margin="0,0,9,0"/>
         <Button Content="释放" Command="{Binding EngineeringClamp1ReleaseCommand}" Padding="14,7" Margin="0,0,9,0"/>
        </WrapPanel>
        <WrapPanel Margin="0,0,0,8">
         <TextBlock Text="夹具 2" Width="75" VerticalAlignment="Center" FontWeight="SemiBold"/>
         <Button Content="压紧" Command="{Binding EngineeringClamp2PressCommand}" Padding="14,7" Margin="0,0,9,0"/>
         <Button Content="释放" Command="{Binding EngineeringClamp2ReleaseCommand}" Padding="14,7" Margin="0,0,9,0"/>
        </WrapPanel>
        <WrapPanel>
         <TextBlock Text="IGN" Width="75" VerticalAlignment="Center" FontWeight="SemiBold"/>
         <Button Content="ON" Command="{Binding EngineeringIgnOnCommand}" Padding="14,7" Margin="0,0,9,0"/>
         <Button Content="OFF" Command="{Binding EngineeringIgnOffCommand}" Padding="14,7" Margin="0,0,9,0"/>
        </WrapPanel>
        <TextBlock Text="工位操作需要主控连接；命令确认不代表夹具机械到位。"
         Foreground="#687C8B" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="#F3F7FC" CornerRadius="7" BorderBrush="#DCE5EF"
       BorderThickness="1" Padding="13" Margin="0,9,0,0">
       <StackPanel>
        <TextBlock Text="设备读取结果" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding EngineeringClampReadback}" Foreground="#3B607E"
         TextWrapping="Wrap"/>
        <TextBlock Text="只代表主控 GPIO，绝不冒充夹具机械到位信号。实体 START 尚未实测，上位机保留软件 START；两者最终共用一次检测锁。"
         Foreground="#7C6470" TextWrapping="Wrap" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>
      <Border Background="White" BorderBrush="#DDE6EE" BorderThickness="1"
       CornerRadius="7" Padding="13" Margin="0,14,0,0">
       <StackPanel>
        <DockPanel Margin="0,0,0,10" LastChildFill="True">
         <Button DockPanel.Dock="Right" Content="创建／编辑本工程工位动作"
          Command="{Binding OpenInspectionProcedureCommand}" Padding="12,7"
          Margin="12,0,0,0"/>
         <TextBlock Text="本工程实际需要的夹具动作"
          FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="可选：检测前准备与检测后收尾动作。"
         Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ContentControl x:Name="InspectionProcedureHost"
         HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
       </StackPanel>
      </Border>
      <Border CornerRadius="7" BorderBrush="#DBE3ED" BorderThickness="1"
       Background="White" Padding="13" Margin="0,14,0,0">
       <StackPanel>
        <TextBlock Text="正式检测关联" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <TextBlock Text="扫码 → 夹具准备 → START → 烧录 → 测试 → 收尾与报告。"
         TextWrapping="Wrap" Foreground="{StaticResource Subtle}"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="运行前检查">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel MaxWidth="1010" Margin="22,22,22,24">
      <DockPanel Margin="0,0,0,12">
       <Button DockPanel.Dock="Right" Content="重新检查全部配置"
        Command="{Binding RefreshEngineeringSetupCommand}"
        Padding="12,8" Margin="12,0,0,0"/>
       <TextBlock Text="完整检测 · 配置核对" FontSize="18"
        FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#273E52"/>
      </DockPanel>
      <TextBlock Text="下面核对的都是本工程实际存在的配置，不是另外一份检测方案。点击右侧入口直接修正对应内容；仅查看和检查不会操作真实硬件。"
       TextWrapping="Wrap" Foreground="#687D90" Margin="0,0,0,14"/>
      <Border Background="#F3F7FC" BorderBrush="#DFE7F0"
       BorderThickness="1" CornerRadius="7" Padding="13" Margin="0,0,0,12">
       <StackPanel>
        <TextBlock Text="{Binding SetupOverallStatus}" TextWrapping="Wrap"
         Foreground="#43607B" Margin="0,0,0,10"/>
        <DockPanel LastChildFill="True">
         <Button Content="确认当前工程用于生产" DockPanel.Dock="Right"
          Command="{Binding ConfirmProductionConfigurationCommand}"
          Style="{StaticResource AtPrimaryButton}"
          Padding="13,8" Margin="12,0,0,0" VerticalAlignment="Center"
          ToolTip="只确认本工程 TEST 顺序和已保存的原生 FLASH/固件/安全资源版本；不会直接驱动设备"/>
         <TextBlock Text="配置核对无误后确认一次。正式生产使用该工程的受控版本；后续编辑将使旧确认失效。"
          Foreground="#607A91" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
       </StackPanel>
      </Border>
      <Border BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="7"
       Padding="13" Margin="0,0,0,8">
       <DockPanel>
        <Button DockPanel.Dock="Right" Command="{Binding OpenFirstTestProjectCommand}"
         Content="查看测试用例" Padding="11,7" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="功能测试" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupTestStatus}" TextWrapping="Wrap"
          Foreground="#667A8E" Margin="0,5,0,0"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="7"
       Padding="13" Margin="0,0,0,8">
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="查看烧录配置" Tag="flash"
         Click="NavigateToStage_Click" Padding="11,7" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="前置烧录" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupFlashStatus}" TextWrapping="Wrap"
          Foreground="#667A8E" Margin="0,5,0,0"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="7"
       Padding="13" Margin="0,0,0,8">
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="查看扫码枪" Tag="scan"
         Click="NavigateToStage_Click" Padding="11,7" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="唯一编号读取" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupScanStatus}" TextWrapping="Wrap"
          Foreground="#667A8E" Margin="0,5,0,0"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <Border BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="7"
       Padding="13" Margin="0,0,0,11">
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="查看工位动作" Tag="station"
         Click="NavigateToStage_Click" Padding="11,7" Margin="12,0,0,0"/>
        <StackPanel>
         <TextBlock Text="主控、夹具及 IGN" FontWeight="SemiBold" FontSize="13"/>
         <TextBlock Text="{Binding SetupStationStatus}" TextWrapping="Wrap"
          Foreground="#667A8E" Margin="0,5,0,0"/>
        </StackPanel>
       </DockPanel>
      </Border>
      <TextBlock Text="工程保存即生效；配置检查不会操作设备。"
       TextWrapping="Wrap" Foreground="#8B6845"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
