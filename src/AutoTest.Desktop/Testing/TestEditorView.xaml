<UserControl x:Class="AutoTest.Desktop.Testing.TestEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="White" Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}"
 FontSize="12" PreviewKeyDown="Editor_KeyDown">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="43"/>
   <RowDefinition Height="29"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="24"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <DockPanel Margin="12,0" LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBox x:Name="StepSearch" Width="148" Height="27" VerticalContentAlignment="Center"
      Text="{Binding StepFind,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      ToolTip="查找步骤 Ctrl+F" Margin="0,0,7,0"/>
     <Button Content="＋ 添加步骤" Style="{StaticResource AtPrimaryButton}"
      Command="{Binding AddChildCommand}" Margin="0,0,6,0" MinHeight="27" FontSize="11"/>
     <Button Content="检查问题" Command="{Binding PreflightCommand}" Margin="0,0,5,0" MinHeight="27" FontSize="11"/>
     <Button Content="保存" Command="{Binding SaveCommand}" MinHeight="27" FontSize="11"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding DocumentName}" FontWeight="SemiBold" FontSize="14"
      VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
     <Border Background="#EAF3FF" BorderBrush="#C8DEF9" BorderThickness="1"
       CornerRadius="3" Padding="5,2" Margin="9,0,0,0">
      <TextBlock Text="{Binding AssetRevision,StringFormat='修订 {0}'}" FontSize="10" Foreground="#2368BD"/>
     </Border>
     <TextBlock Text="● 未保存" Foreground="#A96D20" Margin="9,0,0,0" VerticalAlignment="Center">
      <TextBlock.Style><Style TargetType="TextBlock">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsDirty}" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
       </DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Grid.Row="1" Background="#F3F7FB" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <Grid Margin="0,0,9,0">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="36"/><ColumnDefinition Width="29*" MinWidth="185"/>
     <ColumnDefinition Width="71*" MinWidth="220"/><ColumnDefinition Width="126"/><ColumnDefinition Width="72"/>
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="序号" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="#435B74"/>
    <TextBlock Grid.Column="1" Text="步骤 / 流程" VerticalAlignment="Center" Margin="7,0" FontSize="11" Foreground="#435B74"/>
    <TextBlock Grid.Column="2" Text="主要参数 / 判据" VerticalAlignment="Center" Margin="6,0" FontSize="11" Foreground="#435B74"/>
    <TextBlock Grid.Column="3" Text="资源" VerticalAlignment="Center" Margin="6,0" FontSize="11" Foreground="#435B74"/>
    <TextBlock Grid.Column="4" Text="状态" VerticalAlignment="Center" Margin="6,0" FontSize="11" Foreground="#435B74"/>
   </Grid>
  </Border>
  <ListBox x:Name="StepsList" Grid.Row="2" ItemsSource="{Binding StepRows}"
   SelectedItem="{Binding SelectedRow,Mode=TwoWay}" BorderThickness="0"
   Background="White" HorizontalContentAlignment="Stretch"
   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
   ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True"
   VirtualizingStackPanel.VirtualizationMode="Recycling"
   PreviewMouseRightButtonDown="StepsList_RightClick" MouseDoubleClick="StepsList_DoubleClick"
   PreviewMouseLeftButtonDown="StepsList_PreviewMouseLeftButtonDown"
   PreviewMouseMove="StepsList_PreviewMouseMove"
   AllowDrop="True" DragOver="StepsList_DragOver" Drop="StepsList_Drop">
   <ListBox.ItemContainerStyle>
    <Style TargetType="ListBoxItem">
     <Setter Property="Padding" Value="0"/>
     <Setter Property="MinHeight" Value="35"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="Background" Value="White"/>
     <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5F9FE"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E8F2FF"/></Trigger>
     </Style.Triggers>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Border BorderBrush="#E7EDF5" BorderThickness="0,0,0,1" MinHeight="35" Background="Transparent">
      <Grid MinWidth="565">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="36"/><ColumnDefinition Width="29*" MinWidth="185"/>
        <ColumnDefinition Width="71*" MinWidth="220"/><ColumnDefinition Width="126"/><ColumnDefinition Width="72"/>
       </Grid.ColumnDefinitions>
       <TextBlock Grid.Column="0" Text="{Binding SequenceText}" FontSize="10" Foreground="#8798AB"
        VerticalAlignment="Center" HorizontalAlignment="Center"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
        Margin="{Binding Indent}">
        <TextBlock Text="{Binding Icon}" FontSize="12" Foreground="#2368BD"
         Width="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center" Width="150">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
          Foreground="#1E2C41" FontSize="12" ToolTip="{Binding Name}"/>
         <TextBlock Text="{Binding Kind}" Foreground="#7D8EA2" FontSize="10" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </StackPanel>
       <TextBlock Grid.Column="2" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
        Foreground="#405F7B" VerticalAlignment="Center" FontSize="12" Margin="6,0"
        ToolTip="{Binding Summary}"/>
       <TextBlock Grid.Column="3" Text="{Binding Resource}" TextTrimming="CharacterEllipsis"
        Foreground="#6D829A" VerticalAlignment="Center" FontSize="11" Margin="6,0"
        ToolTip="{Binding Resource}"/>
       <TextBlock Grid.Column="4" Text="{Binding State}" TextTrimming="CharacterEllipsis"
        Foreground="#687B8F" VerticalAlignment="Center" FontSize="10" Margin="6,0"
        ToolTip="{Binding State}"/>
      </Grid>
     </Border>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FBFCFF">
   <DockPanel Margin="10,0">
    <TextBlock Text="{Binding StatusMessage}" Foreground="#64758C" VerticalAlignment="Center"
     TextTrimming="CharacterEllipsis" FontSize="10"/>
    <TextBlock DockPanel.Dock="Right" Text="右键步骤 · F2 重命名 · F9 断点 · Ctrl+Space 插入"
     Foreground="#8B9BAE" VerticalAlignment="Center" FontSize="10"/>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
