<Window x:Class="AutoTest.UiPreview.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="AutoTest · UI 视觉预览（未接后端）"
 Width="1600" Height="900" MinWidth="900" MinHeight="580"
 WindowStartupLocation="CenterScreen" WindowState="Maximized" WindowStyle="None"
 ResizeMode="CanResize" Background="#FFFFFF" Foreground="#1E2C41"
 FontFamily="Segoe UI,Microsoft YaHei UI" FontSize="12"
 UseLayoutRounding="True" SnapsToDevicePixels="True"
 PreviewKeyDown="Window_PreviewKeyDown">
 <chrome:WindowChrome.WindowChrome>
  <chrome:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
   CornerRadius="0" UseAeroCaptionButtons="False"/>
 </chrome:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="Btn" TargetType="Button">
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#25415F"/>
   <Setter Property="BorderBrush" Value="#D4DFED"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="26"/>
   <Setter Property="Padding" Value="9,3"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Border" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
      CornerRadius="4" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
       RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Border" Property="Background" Value="#F1F6FD"/>
       <Setter TargetName="Border" Property="BorderBrush" Value="#A8C6E8"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="Border" Property="Background" Value="#DEEAF9"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
   <Setter Property="Background" Value="#2368BD"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#2368BD"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}"
       CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="1" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="PrimaryBorder" Property="Background" Value="#1F5BA7"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="PrimaryBorder" Property="Background" Value="#17477F"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="BareBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="5,2"/>
  </Style>
  <Style x:Key="UiInput" TargetType="TextBox">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#CED9E6"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="7,5"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="MinHeight" Value="26"/>
  </Style>
  <Style x:Key="UiCombo" TargetType="ComboBox">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#CFD9E6"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="26"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#607891"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="BottomTab" TargetType="Button" BasedOn="{StaticResource BareBtn}">
   <Setter Property="Foreground" Value="#536983"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="3,0,8,0"/>
  </Style>
  <Style x:Key="TreeButton" TargetType="Button" BasedOn="{StaticResource BareBtn}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="#29496E"/>
  </Style>
  <Style x:Key="PreviewListBoxItemStyle" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Container" Background="{TemplateBinding Background}"
      BorderBrush="#E9EEF5" BorderThickness="0,0,0,1">
      <ContentPresenter HorizontalAlignment="Stretch"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Container" Property="Background" Value="#F4F8FD"/></Trigger>
      <DataTrigger Binding="{Binding IsMatch}" Value="True"><Setter TargetName="Container" Property="Background" Value="#FFF4DC"/></DataTrigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Container" Property="Background" Value="#EAF3FF"/><Setter TargetName="Container" Property="BorderBrush" Value="#91B9E9"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="32"/>
   <RowDefinition Height="38"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="22"/>
  </Grid.RowDefinitions>

  <!-- 32-DIP application menu and OS window controls -->
  <Border Grid.Row="0" Background="White" BorderBrush="#E4EAF2" BorderThickness="0,0,0,1">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,22,0">
     <Border Background="#2368BD" CornerRadius="4" Width="23" Height="22">
      <TextBlock Text="AT" Foreground="White" FontWeight="Bold" FontSize="12"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="AutoTest" FontWeight="Bold" Margin="5,0,6,0" VerticalAlignment="Center"/>
     <Border Background="#EEF4FF" BorderBrush="#CBDDF4" BorderThickness="1"
      CornerRadius="3" Padding="3,1" VerticalAlignment="Center">
      <TextBlock Text="IDE" FontSize="10" Foreground="#2368BD"/>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="文件" Style="{StaticResource BareBtn}" Click="PreviewOnly_Click"/>
     <Button Content="编辑" Style="{StaticResource BareBtn}" Click="PreviewOnly_Click"/>
     <Button Content="视图" Style="{StaticResource BareBtn}" Click="PreviewOnly_Click"/>
     <Button Content="运行" Style="{StaticResource BareBtn}" Click="PreviewOnly_Click"/>
     <Button Content="帮助" Style="{StaticResource BareBtn}" Click="PreviewOnly_Click"/>
    </StackPanel>
    <TextBlock Grid.Column="2" Text="UI 独立预览 · 无工程、TEST、DBC、设备接线"
     HorizontalAlignment="Right" Foreground="#A06E2F" FontSize="10"
     VerticalAlignment="Center" Margin="0,0,10,0"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal">
     <Button Content="—" Style="{StaticResource BareBtn}" Width="37" Height="31"
      chrome:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
     <Button Content="□" Style="{StaticResource BareBtn}" Width="37" Height="31"
      chrome:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaxRestore_Click"/>
     <Button Content="×" Style="{StaticResource BareBtn}" Width="39" Height="31"
      chrome:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- Frozen HTML toolbar density, no backend commands -->
  <Border Grid.Row="1" Background="#FBFCFE" BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
   <DockPanel LastChildFill="True" Margin="9,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="手动台架" Style="{StaticResource Btn}" Margin="0,0,5,0" Click="PreviewOnly_Click"/>
     <Button Content="DBC" Style="{StaticResource Btn}" Margin="0,0,5,0" Click="PreviewOnly_Click"/>
     <Button Content="UDS" Style="{StaticResource Btn}" Margin="0,0,5,0" Click="PreviewOnly_Click"/>
     <Button Content="波形" Style="{StaticResource Btn}" Margin="0,0,5,0" Click="PreviewOnly_Click"/>
     <Button Content="Flash" Style="{StaticResource Btn}" Margin="0,0,5,0" Click="PreviewOnly_Click"/>
     <Button Content="生产" Style="{StaticResource Btn}" Click="PreviewOnly_Click"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="▤ 工程" Style="{StaticResource Btn}" Click="PreviewOnly_Click" Margin="0,0,6,0"/>
     <TextBlock Text="控制器 A · 样例工程" FontWeight="SemiBold" Margin="3,0,10,0"
      VerticalAlignment="Center" Foreground="#274363"/>
     <Border Background="#FFF3E2" CornerRadius="3" Margin="0,0,8,0" Padding="5,3">
      <TextBlock Text="样例工程" FontSize="10" Foreground="#A86E25"/>
     </Border>
     <Button Content="▣ 保存" Style="{StaticResource Btn}" Click="PreviewOnly_Click" Margin="0,0,5,0"/>
     <Button Content="↶" Style="{StaticResource Btn}" Click="Undo_Click" Margin="0,0,4,0"/>
     <Button Content="↷" Style="{StaticResource Btn}" Click="Redo_Click" Margin="0,0,7,0"/>
     <Button Content="▶ 所选用例检查" Style="{StaticResource PrimaryBtn}"
      IsEnabled="False" ToolTip="UI 预览中禁止执行或模拟 ECU 测试"/>
     <Button Content="运行记录" Style="{StaticResource Btn}" Margin="6,0,0,0"
      IsEnabled="False"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="2" Background="#FFFFFF">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="TreeColumn" Width="245" MinWidth="185"/>
    <ColumnDefinition Width="4"/>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="4"/>
    <ColumnDefinition x:Name="InspectorColumn" Width="302" MinWidth="0"/>
   </Grid.ColumnDefinitions>
   <!-- Left explorer -->
   <Border Grid.Column="0" Background="#FBFCFE" BorderBrush="#DBE3ED" BorderThickness="0,0,1,0">
    <DockPanel LastChildFill="True">
     <Border DockPanel.Dock="Top" Height="35" BorderBrush="#DBE3ED" BorderThickness="0,0,0,1"
      Background="White" Padding="11,0">
      <TextBlock Text="工程导航" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="8,9,8,8">
       <Border BorderBrush="#D4E2F0" BorderThickness="1" Background="#F1F6FC"
        CornerRadius="5" Padding="10,10" Margin="0,0,0,12">
        <TextBlock Text="▣  控制器 A · 样例工程" FontWeight="SemiBold" Foreground="#244D7D"/>
       </Border>
       <DockPanel Margin="0,0,0,5">
        <TextBlock Text="自动测试" FontSize="12" FontWeight="SemiBold"
         Foreground="#29486D" VerticalAlignment="Center"/>
        <Button Content="＋" DockPanel.Dock="Right" HorizontalAlignment="Right"
         Style="{StaticResource BareBtn}" Click="PreviewOnly_Click"/>
       </DockPanel>
       <Border Background="#E8F1FD" CornerRadius="3" Padding="7,5">
        <TextBlock Text="▾  ▱  研发检查项目                            2/2"
         Foreground="#335D91" FontWeight="SemiBold" FontSize="11"/>
       </Border>
       <StackPanel Margin="18,3,0,2">
        <Border Background="#E2EEFE" CornerRadius="3" Padding="4,5" Margin="0,1">
         <StackPanel Orientation="Horizontal">
          <CheckBox x:Name="ProjectCase1Check" IsChecked="True" VerticalAlignment="Center"
           Checked="RunSelection_Changed" Unchecked="RunSelection_Changed"/>
          <Button Content="▤ 通信与状态检查" Style="{StaticResource BareBtn}"
           Foreground="#1D518F" FontWeight="SemiBold"
           Click="OpenDemoCase_Click" Margin="2,0,0,0"/>
         </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="4,4">
         <CheckBox x:Name="ProjectCase2Check" IsChecked="True" VerticalAlignment="Center"
          Checked="RunSelection_Changed" Unchecked="RunSelection_Changed"/>
         <Button Content="▤ 诊断信息读取" Style="{StaticResource BareBtn}"
          Click="OpenDemoCase_Click" Margin="2,0,0,0"/>
        </StackPanel>
       </StackPanel>
       <Border BorderBrush="#DBE3ED" BorderThickness="0,1,0,0" Margin="0,10,0,8"/>
       <TextBlock Text="工程资源" FontWeight="SemiBold" Foreground="#29496E" Margin="2,0,0,9"/>
       <Button Content="▸  ▤  DBC 报文                                  13" Style="{StaticResource TreeButton}" Click="PreviewOnly_Click"/>
       <Button Content="▸  ◈  按键配置                                  2" Style="{StaticResource TreeButton}" Click="PreviewOnly_Click" Margin="0,4"/>
       <Button Content="▸  〰  波形参考                                  1" Style="{StaticResource TreeButton}" Click="PreviewOnly_Click"/>
       <Button Content="▸  ◇  UDS 服务                                  2" Style="{StaticResource TreeButton}" Click="PreviewOnly_Click" Margin="0,4"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="4" Background="#EDF2F7"
    HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

   <!-- Main TEST editing workspace -->
   <Grid Grid.Column="2" Background="White">
    <Grid.RowDefinitions>
     <RowDefinition Height="32"/>
     <RowDefinition Height="44"/>
     <RowDefinition Height="45"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="4"/>
     <RowDefinition x:Name="BottomRow" Height="165" MinHeight="0"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#F2F5F9" BorderBrush="#DBE3ED"
     BorderThickness="0,0,0,1">
     <StackPanel Orientation="Horizontal">
      <Button Content="▥ 工程概览" Style="{StaticResource BareBtn}"
       Width="112" Click="PreviewOnly_Click"/>
      <Button Content="▤ 研发检查项目" Style="{StaticResource BareBtn}"
       Width="130" Click="PreviewOnly_Click"/>
      <Border Background="White" BorderBrush="#2368BD" BorderThickness="0,0,0,2">
       <Button Content="▤ 通信与状态检查" Style="{StaticResource BareBtn}"
        Foreground="#235D9E" FontWeight="SemiBold" Width="142" Click="OpenDemoCase_Click"/>
      </Border>
      <Button Content="◈ 工程配置" Style="{StaticResource BareBtn}"
       Width="100" Click="PreviewOnly_Click"/>
     </StackPanel>
    </Border>
    <Grid Grid.Row="1" Background="White">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
      <TextBlock Text="通信与状态检查" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
      <Border Background="#EEF3F9" CornerRadius="3" Margin="9,0,5,0" Padding="5,3">
       <TextBlock x:Name="StepCountLabel" Text="11 步" FontSize="10" Foreground="#70839A"/>
      </Border>
      <Border BorderBrush="#C4DDF9" BorderThickness="1" Background="#EAF3FF"
       CornerRadius="4" Padding="6,4" Margin="0,0,0,0">
       <CheckBox x:Name="CurrentRunCheck" Content="本次执行" IsChecked="True"
        Foreground="#235B9B" FontWeight="SemiBold" FontSize="11" 
        Checked="CaseHeaderCheck_Changed" Unchecked="CaseHeaderCheck_Changed"/>
      </Border>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
      Margin="0,0,10,0">
      <TextBox x:Name="SearchText" Style="{StaticResource UiInput}"
       Width="178" Height="27" Margin="0,0,6,0" ToolTip="搜索并高亮，Enter 定位下一条"
       TextChanged="SearchText_Changed" KeyDown="SearchText_KeyDown"/>
      <Button Content="＋ 添加步骤" Style="{StaticResource PrimaryBtn}"
       Click="AddToolbar_Click" Margin="0,0,5,0"/>
      <Button Content="检查问题" Style="{StaticResource Btn}"
       Click="PreviewOnly_Click" Margin="0,0,5,0"/>
      <Button Content="重命名" Style="{StaticResource Btn}" Click="RenameCase_Click"/>
     </StackPanel>
    </Grid>
    <Border Grid.Row="2" Background="#F3F6FA" BorderBrush="#DDE5EF" BorderThickness="0,1,0,1">
     <Grid Margin="8,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="42"/>
       <ColumnDefinition Width="30*"/>
       <ColumnDefinition Width="46*"/>
       <ColumnDefinition Width="14*"/>
       <ColumnDefinition Width="10*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="序号" FontSize="11" Foreground="#627891" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="步骤 / 流程" FontSize="11" Foreground="#627891" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="主要参数 / 判据" FontSize="11" Foreground="#627891" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="3" Text="资源" FontSize="11" Foreground="#627891" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="4" Text="状态" FontSize="11" Foreground="#627891" VerticalAlignment="Center"/>
     </Grid>
    </Border>

    <!-- Entire phase/step/branch projection is driven by ONE in-memory UI state.
         No StepEditTransaction, controller, project or device types referenced. -->
    <ListBox x:Name="StepRowsList" Grid.Row="3" ItemsSource="{Binding Rows}"
     ItemContainerStyle="{StaticResource PreviewListBoxItemStyle}"
     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
     ScrollViewer.VerticalScrollBarVisibility="Auto" Background="White"
     SelectionChanged="StepRowsList_SelectionChanged" MouseDoubleClick="StepRowsList_DoubleClick">
     <ListBox.ItemTemplate>
      <DataTemplate>
       <Grid Height="{Binding RowHeight}" Background="Transparent">
        <Border Visibility="{Binding IsPhase,Converter={StaticResource B2V}}"
         Background="{Binding PhaseBackground}" BorderBrush="{Binding PhaseAccent}"
         BorderThickness="3,0,0,1" Padding="8,0">
         <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Tag="{Binding}" Content="＋ 添加"
           Height="24" MinHeight="0" Padding="8,2" Margin="4,0,0,0"
           Style="{StaticResource Btn}" Click="AddAtRow_Click"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}"
           Foreground="#8A9AB0" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
           <Button Tag="{Binding}" Content="{Binding ExpandMark}" Click="TogglePhase_Click"
            Style="{StaticResource BareBtn}" Width="24" FontSize="11"/>
           <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{Binding PhaseAccent}"
            FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
         </DockPanel>
        </Border>
        <Border Visibility="{Binding IsBranch,Converter={StaticResource B2V}}"
         Background="#F5EEFB" BorderBrush="#DECEF3" BorderThickness="3,0,0,1"
         Padding="7,0">
         <DockPanel>
          <Button DockPanel.Dock="Right" Tag="{Binding}" Content="＋ 插入"
           Style="{StaticResource BareBtn}" Foreground="#7854A3" Click="AddAtRow_Click"/>
          <TextBlock Text="{Binding Name}" Margin="{Binding Indent}" VerticalAlignment="Center"
           FontSize="11" Foreground="#7653A5" FontWeight="SemiBold"/>
         </DockPanel>
        </Border>
        <Grid Visibility="{Binding IsStep,Converter={StaticResource B2V}}" Margin="0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="30*"/>
          <ColumnDefinition Width="46*"/>
          <ColumnDefinition Width="14*"/>
          <ColumnDefinition Width="10*"/>
         </Grid.ColumnDefinitions>
         <Border Width="3" Background="#277BD1" HorizontalAlignment="Left" Panel.ZIndex="1">
          <Border.Style>
           <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Background" Value="#277BD1"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsMatch}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
              <Setter Property="Background" Value="#E2A43B"/>
             </DataTrigger>
             <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=IsSelected}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
              <Setter Property="Background" Value="#2675CF"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </Border.Style>
         </Border>
         <TextBlock Grid.Column="0" Text="{Binding Number}" HorizontalAlignment="Right"
          VerticalAlignment="Center" Margin="0,0,10,0" FontSize="10" Foreground="#8A99AD"
          FontFamily="Consolas"/>
         <StackPanel Grid.Column="1" Margin="{Binding Indent}" Orientation="Horizontal"
          VerticalAlignment="Center">
          <Border Background="{Binding CategoryBackground}" CornerRadius="3"
           Width="21" Height="21" Margin="0,0,7,0">
           <TextBlock Text="{Binding Icon}" Foreground="{Binding CategoryForeground}"
            FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
           ToolTip="{Binding Name}" Foreground="#263D5C"/>
         </StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis" Foreground="#587795" FontSize="11"
          Margin="3,0,8,0" ToolTip="{Binding Summary}"/>
         <TextBlock Grid.Column="3" Text="{Binding Resource}" VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis" Foreground="#8498B0" FontSize="10"
          Margin="0,0,5,0" ToolTip="{Binding Resource}"/>
         <TextBlock Grid.Column="4" Text="{Binding Status}" VerticalAlignment="Center"
          Foreground="#8293A9" FontSize="10" TextTrimming="CharacterEllipsis"/>
        </Grid>
       </Grid>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>

    <GridSplitter Grid.Row="4" Height="4" Background="#E8EEF6"
     ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch"/>

    <Grid Grid.Row="5" Background="#FBFCFF">
     <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Background="White" BorderBrush="#DBE3ED"
      BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True" Margin="9,0">
       <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource BareBtn}"
        Click="ToggleBottom_Click" ToolTip="折叠底部观察区"/>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="运行时间线" Style="{StaticResource BottomTab}"
         Foreground="#2368BD" FontWeight="Bold" Click="BottomTab_Click"/>
        <Button Content="CAN 事件" Style="{StaticResource BottomTab}" Click="BottomTab_Click"/>
        <Button Content="变量观察" Style="{StaticResource BottomTab}" Click="BottomTab_Click"/>
        <Button Content="问题列表" Style="{StaticResource BottomTab}" Click="BottomTab_Click"/>
        <Button Content="设备状态" Style="{StaticResource BottomTab}" Click="BottomTab_Click"/>
       </StackPanel>
      </DockPanel>
     </Border>
     <Border Grid.Row="1" Background="#F3F6FA" BorderBrush="#DBE3ED"
      BorderThickness="0,0,0,1" Padding="8,0">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <TextBlock Text="步骤" VerticalAlignment="Center" Foreground="#55708D" FontSize="10"/>
       <TextBlock Grid.Column="1" Text="实际状态" VerticalAlignment="Center" Foreground="#55708D" FontSize="10"/>
       <TextBlock Grid.Column="2" Text="实际数据" VerticalAlignment="Center" Foreground="#55708D" FontSize="10"/>
       <TextBlock Grid.Column="3" Text="证据 / 说明" VerticalAlignment="Center" Foreground="#55708D" FontSize="10"/>
      </Grid>
     </Border>
     <TextBlock x:Name="BottomEmpty" Grid.Row="2" Text="暂无本次运行事件 · 独立 UI 预览不执行 ECU 测试"
      Foreground="#869AB0" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
   </Grid>
   <GridSplitter Grid.Column="3" Width="4" Background="#EDF2F7"
    ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch"/>

   <!-- Fixed right Inspector. Always the currently selected row, never a duplicate creation wizard. -->
   <Border Grid.Column="4" Background="#FCFDFF" BorderBrush="#DBE3ED" BorderThickness="1,0,0,0">
    <DockPanel LastChildFill="True">
     <Border DockPanel.Dock="Top" Background="White" Height="35"
      BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
      <DockPanel Margin="11,0">
       <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource BareBtn}"
        Click="ToggleInspector_Click" ToolTip="折叠右侧属性"/>
       <TextBlock Text="步骤属性" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
      </DockPanel>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12,13,12,16">
       <StackPanel x:Name="InspectorStepPanel">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
         <Border x:Name="SelectedTypeBadge" Background="#FFF0D7" CornerRadius="4"
          Width="25" Height="25" Margin="0,0,8,0">
          <TextBlock x:Name="SelectedTypeIcon" Text="◈" FontSize="12"
           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A16E2C"/>
         </Border>
         <TextBlock x:Name="SelectedTypeLabel" Text="IGN 控制" FontWeight="Bold"
          VerticalAlignment="Center" FontSize="12" Margin="0,0,7,0"/>
         <Border Background="#EDF3FA" Padding="5,2" CornerRadius="3" VerticalAlignment="Center">
          <TextBlock x:Name="SelectedStepId" Text="A38C4" FontFamily="Consolas"
           Foreground="#7187A2" FontSize="10"/>
         </Border>
        </StackPanel>
        <TextBlock Text="步骤名称" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="StepNameField" Style="{StaticResource UiInput}"
         TextChanged="StepNameField_TextChanged" Margin="0,0,0,12"/>
        <Grid Margin="0,0,0,12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="运行状态" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="EnabledBox" Style="{StaticResource UiCombo}"
           SelectionChanged="EnabledBox_SelectionChanged">
           <ComboBoxItem Content="启用"/><ComboBoxItem Content="禁用"/>
          </ComboBox>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="断点" Style="{StaticResource FieldLabel}"/>
          <ComboBox x:Name="BreakpointBox" Style="{StaticResource UiCombo}"
           SelectionChanged="BreakpointBox_SelectionChanged">
           <ComboBoxItem Content="无"/><ComboBoxItem Content="已设置"/>
          </ComboBox>
         </StackPanel>
        </Grid>
        <Border BorderBrush="#E4EAF2" BorderThickness="0,0,0,1"
         Margin="0,0,0,9"/>
        <TextBlock Text="动作参数" Foreground="#536F91" FontWeight="SemiBold"
         FontSize="11" Margin="0,0,0,9"/>
        <StackPanel x:Name="InspectorParameterFields" Margin="0,0,0,12"/>
        <Border BorderBrush="#E4EAF2" BorderThickness="0,1,0,0"
         Margin="0,3,0,10"/>
        <TextBlock Text="当前步骤操作" Foreground="#607891" FontSize="11"
         Margin="0,0,0,8"/>
        <WrapPanel>
         <Button Content="在下方插入" Style="{StaticResource Btn}" Margin="0,0,5,5"
          Click="InsertAfter_Click"/>
         <Button Content="复制" Style="{StaticResource Btn}" Margin="0,0,5,5"
          Click="Duplicate_Click"/>
         <Button Content="↑" Style="{StaticResource Btn}" Width="29" Margin="0,0,5,5"
          Click="MoveUp_Click"/>
         <Button Content="↓" Style="{StaticResource Btn}" Width="29" Margin="0,0,5,5"
          Click="MoveDown_Click"/>
         <Button Content="删除" Style="{StaticResource Btn}" Foreground="#B84957" Margin="0,0,5,5"
          Click="Delete_Click"/>
        </WrapPanel>
       </StackPanel>
       <StackPanel x:Name="InspectorEmptyPanel" Visibility="Collapsed">
        <TextBlock Text="选中步骤后可直接编辑其属性。" Foreground="#7186A0"
         FontSize="12" TextWrapping="Wrap" Margin="0,0,0,13"/>
        <Button Content="＋ 添加步骤" Style="{StaticResource PrimaryBtn}"
         Click="AddToolbar_Click" HorizontalAlignment="Left"/>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>

  <Border Grid.Row="3" Background="#2367AA" Padding="8,0">
   <DockPanel>
    <TextBlock x:Name="StatusText" Text="控制器 A · 样例工程 · UI 预览（内存数据，不与设备通信）"
     Foreground="White" FontSize="10" VerticalAlignment="Center"/>
    <TextBlock DockPanel.Dock="Right" Text="独立 UI · 无连接 · 无运行 · 无保存"
     Foreground="#E7F1FC" FontSize="10" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>

  <!-- Palette is placed above the full UI; it edits only in-memory sample rows. -->
  <Grid x:Name="PaletteOverlay" Grid.RowSpan="4" Panel.ZIndex="100" Visibility="Collapsed"
   Background="#660D2546">
   <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="520"
    MaxHeight="620" Background="White" BorderBrush="#BDCBDB" BorderThickness="1"
    CornerRadius="8" Padding="16" Margin="12">
    <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.27"/></Border.Effect>
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource BareBtn}"
       Click="ClosePalette_Click"/>
      <TextBlock Text="插入测试步骤" FontSize="15" FontWeight="Bold" Foreground="#27486D"/>
     </DockPanel>
     <TextBox x:Name="PaletteSearchText" DockPanel.Dock="Top" Style="{StaticResource UiInput}"
      TextChanged="PaletteSearchText_Changed" KeyDown="PaletteSearchText_KeyDown"
      Margin="0,0,0,8" ToolTip="输入步骤类型，选择后立即进入右侧编辑"/>
     <TextBlock DockPanel.Dock="Bottom" Text="UI 预览：动作只改变当前内存示例，不保存工程，也不会控制真实设备。"
      TextWrapping="Wrap" Foreground="#8190A4" FontSize="10" Margin="0,10,0,0"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
      MaxHeight="490">
      <StackPanel x:Name="PaletteGroupsPanel"/>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
