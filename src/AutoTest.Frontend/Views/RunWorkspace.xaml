<UserControl x:Class="AutoTest.Frontend.Views.RunWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Background="{StaticResource AT.Canvas}">
 <Grid Margin="14,12">
  <Grid.RowDefinitions><RowDefinition Height="57"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="4,0" LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="待接入真实 TEST Run" Foreground="{StaticResource AT.Warning}"
     FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <ui:Button Content="运行所选用例" Appearance="Primary" IsEnabled="False"
     ToolTip="仅 UI 设计预览，未接执行器，不能运行或生成 PASS" Padding="17,8"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="当前测试任务" Style="{StaticResource AT.PageTitle}"/>
    <TextBlock Text="启动后直接显示当前测试项目；本页仅展示运行界面，不模拟执行。"
     Style="{StaticResource AT.Caption}" Margin="0,3,0,0"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="350" MinWidth="260" MaxWidth="440"/>
    <ColumnDefinition Width="8"/>
    <ColumnDefinition Width="*" MinWidth="320"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource AT.Panel}" Padding="0"
    Margin="0,0,2,0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel Margin="16,15,16,12">
      <TextBlock Text="测试项目" Style="{StaticResource AT.PanelTitle}"/>
      <TextBlock Text="当前测试项目 · 界面演示"
       Style="{StaticResource AT.Caption}" Margin="0,5,0,11"/>
      <Border Background="{StaticResource AT.AccentWash}" CornerRadius="7"
       Padding="11,9">
       <DockPanel>
        <TextBlock Text="{Binding RunSelectionSummary}" Foreground="#286FCA"
         FontWeight="SemiBold" FontSize="12"/>
       </DockPanel>
      </Border>
     </StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Cases}"
      SelectedItem="{Binding SelectedCase,Mode=TwoWay}"
      Margin="10,0,10,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ColumnWidth="*" IsReadOnly="False">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="选" Width="42">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding SelectedForRun,Mode=TwoWay}"
           HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="测试用例" Binding="{Binding Name}"
        Width="*" MinWidth="120" IsReadOnly="True"/>
      </DataGrid.Columns>
     </DataGrid>
     <Border Grid.Row="2" Padding="15,12" Background="{StaticResource AT.SubtleSurface}"
      BorderBrush="{StaticResource AT.Border}" BorderThickness="0,1,0,0">
      <StackPanel>
       <TextBlock Text="勾选决定当前工程师的运行选择，不代表执行器已连接。"
        Style="{StaticResource AT.Caption}"/>
       <ui:Button Content="编辑当前用例" Click="Edit_Click"
        Margin="0,10,0,0" HorizontalAlignment="Left"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" ResizeDirection="Columns"
    ShowsPreview="True" Background="Transparent"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions>
     <RowDefinition Height="125"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="225"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource AT.Panel}"
     Margin="0,0,0,10">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="3">
       <TextBlock Text="执行状态" Style="{StaticResource AT.Caption}"/>
       <TextBlock Text="未运行" FontSize="24" FontWeight="SemiBold"
        Foreground="{StaticResource AT.Text}" Margin="0,11,0,4"/>
       <TextBlock Text="不产生模拟结果" Style="{StaticResource AT.Caption}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="4">
       <TextBlock Text="当前测试用例" Style="{StaticResource AT.Caption}"/>
       <TextBlock Text="{Binding SelectedCase.Name}" FontSize="15" FontWeight="SemiBold"
        Foreground="{StaticResource AT.Text}" Margin="0,14,10,4"
        TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="4">
       <TextBlock Text="设备 / 工位" Style="{StaticResource AT.Caption}"/>
       <TextBlock Text="未连接" FontSize="17" FontWeight="SemiBold"
        Foreground="{StaticResource AT.Muted}" Margin="0,13,0,4"/>
       <TextBlock Text="无实体测试授权" Style="{StaticResource AT.Caption}"/>
      </StackPanel>
     </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource AT.Panel}" Padding="0"
     Margin="0,0,0,10">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="15,0">
       <TextBlock Text="测试步骤" Style="{StaticResource AT.PanelTitle}"/>
       <TextBlock DockPanel.Dock="Right" Text="{Binding StepCountSummary}"
        Style="{StaticResource AT.Caption}" VerticalAlignment="Center"/>
      </DockPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedCase.Steps}"
       IsReadOnly="True">
       <DataGrid.Columns>
        <DataGridTextColumn Header="阶段" Binding="{Binding Phase}" Width="66"/>
        <DataGridTextColumn Header="步骤" Binding="{Binding Name}" Width="*" MinWidth="125"/>
        <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="103"/>
        <DataGridTemplateColumn Header="运行状态" Width="98">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <TextBlock Text="未执行" Foreground="{StaticResource AT.Muted}"
            VerticalAlignment="Center" Margin="8,0"/>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource AT.Panel}" Padding="0">
     <TabControl>
      <TabItem Header="执行日志">
       <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
         <TextBlock Text="尚无执行日志" FontSize="15" Foreground="{StaticResource AT.Muted}"
          HorizontalAlignment="Center"/>
         <TextBlock Text="完成真实 TEST 接线后展示实际事件、时间线及错误原因。"
          Style="{StaticResource AT.Caption}" TextAlignment="Center" Margin="0,9,0,0"/>
        </StackPanel>
       </Grid>
      </TabItem>
      <TabItem Header="报告">
       <Grid Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
         <TextBlock Text="当前没有测试报告" FontSize="15" Foreground="{StaticResource AT.Muted}"
          HorizontalAlignment="Center"/>
         <TextBlock Text="报告必须来自真实执行记录，前端不会自动生成合格判定。"
          Style="{StaticResource AT.Caption}" TextAlignment="Center" Margin="0,9,0,0"/>
        </StackPanel>
       </Grid>
      </TabItem>
      <TabItem Header="变量 / 观察">
       <Grid Background="White">
        <TextBlock Text="等待真实观测数据" Foreground="{StaticResource AT.Muted}"
         HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Grid>
      </TabItem>
     </TabControl>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
