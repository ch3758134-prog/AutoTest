<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
 <!-- R1 neutral light IDE tokens shared by the modern TEST workspace. -->
 <SolidColorBrush x:Key="AtUiSurface" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="AtUiInk" Color="#2B3435"/>
 <SolidColorBrush x:Key="AtUiButtonForeground" Color="#475668"/>
 <SolidColorBrush x:Key="AtUiBorder" Color="#DCE5DF"/>
 <SolidColorBrush x:Key="AtUiHoverSurface" Color="#F3F7F4"/>
 <SolidColorBrush x:Key="AtUiHoverBorder" Color="#CADAF1"/>
 <SolidColorBrush x:Key="AtUiPressedSurface" Color="#E7EFFB"/>
 <SolidColorBrush x:Key="AtUiAccent" Color="#3478D6"/>
 <SolidColorBrush x:Key="AtUiAccentHover" Color="#475668"/>
 <SolidColorBrush x:Key="AtUiAccentPressed" Color="#475668"/>
 <SolidColorBrush x:Key="AtUiStepTitle" Color="#475668"/>
 <SolidColorBrush x:Key="AtUiStepSummary" Color="#627C9D"/>
 <SolidColorBrush x:Key="AtUiStepResource" Color="#97B6DE"/>
 <SolidColorBrush x:Key="AtUiStepStatus" Color="#97B6DE"/>
 <FontFamily x:Key="AtUiFont">Segoe UI, Microsoft YaHei UI</FontFamily>
 <sys:Double x:Key="AtUiBodySize">12</sys:Double>
 <sys:Double x:Key="AtUiCaptionSize">11</sys:Double>
 <sys:Double x:Key="AtUiMicroSize">10</sys:Double>
 <sys:Double x:Key="AtUiButtonHeight">26</sys:Double>
 <sys:Double x:Key="AtUiStepHeight">35</sys:Double>
 <sys:Double x:Key="AtUiPhaseHeight">34</sys:Double>
 <sys:Double x:Key="AtUiBranchHeight">26</sys:Double>
 <Thickness x:Key="AtUiButtonPadding">9,3</Thickness>
 <Thickness x:Key="AtUiStepIconMargin">0,0,7,0</Thickness>
</ResourceDictionary>
