<Window x:Class="AutoTest.UdsLab.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · UDS 交互工作台" Width="1520" Height="890" MinWidth="1180" MinHeight="710"
 WindowStartupLocation="CenterScreen" Background="#F4F7FB" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Grid Margin="15">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="310"/>
   <RowDefinition Height="220"/>
  </Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,9">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="UDS 交互工作台" FontSize="22" FontWeight="SemiBold" Foreground="#20334E"/>
    <TextBlock Text="选择服务 → 填写 ECU 参数 → 直接执行；可自由改 HEX、保存常用操作并连续交互。" Foreground="#64748B" Margin="0,3,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="打开操作配置" Click="Open_Click"/>
    <Button Content="保存操作配置" Click="Save_Click"/>
    <Button Content="导出交互记录" Click="Export_Click"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,0,10">
   <StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="请求 ID（HEX）" Margin="5,8,6,0" Foreground="#52637A"/>
     <TextBox x:Name="TxIdBox" Width="94" ToolTip="ECU 物理请求 CAN ID，十六进制"/>
     <TextBlock Text="响应 ID（HEX）" Margin="3,8,6,0" Foreground="#52637A"/>
     <TextBox x:Name="RxIdBox" Width="94" ToolTip="ECU 响应 CAN ID，十六进制"/>
     <TextBlock Text="P2 (ms)" Margin="3,8,6,0" Foreground="#52637A"/>
     <TextBox x:Name="P2Box" Text="1000" Width="64"/>
     <TextBlock Text="P2* (ms)" Margin="3,8,6,0" Foreground="#52637A"/>
     <TextBox x:Name="P2StarBox" Text="5000" Width="72"/>
     <Button x:Name="ConnectButton" Content="连接主控并建立诊断通路" Click="Connect_Click"/>
     <Button x:Name="DisconnectButton" Content="断开" IsEnabled="False" Click="Disconnect_Click"/>
    </WrapPanel>
    <TextBlock x:Name="ConnectionStatus" Text="未连接。请按当前 ECU 诊断规范填写请求/响应 CAN ID；连接不会自动发送 UDS。" Foreground="#697B91"/>
    <TextBlock x:Name="EcuSessionStatus" Text="ECU 诊断会话：未知（连接 USB 不代表进入 ECU 默认会话）。" Foreground="#946927" FontSize="12" Margin="0,3,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="290" MinWidth="230"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="*" MinWidth="390"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="385" MinWidth="315"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="8" Padding="12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="我的诊断操作" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,6"/>
      <TextBlock Text="先选服务，自动生成请求；也可从空白 HEX 开始。" Foreground="#65768F" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,5"/>
      <ComboBox x:Name="NewServiceCombo" DisplayMemberPath="Display" ToolTip="选择要使用的标准 UDS 服务"/>
      <Button Content="+ 通过服务创建操作" Click="CreateFromService_Click" Margin="0,0,0,6" HorizontalContentAlignment="Center" Background="#DCE9FA"/>
      <WrapPanel>
       <Button Content="+ 空白 HEX" Click="Add_Click"/>
       <Button Content="复制" Click="Copy_Click"/>
       <Button Content="删除" Click="Delete_Click"/>
      </WrapPanel>
      <Button Content="+ 加入连续交互清单" Click="QueueAdd_Click" HorizontalContentAlignment="Center"
              Margin="0,6,0,0" Background="#E8F0FA"/>
     </StackPanel>
     <Expander x:Name="QueueExpander" DockPanel.Dock="Bottom" Header="连续交互与重复读取 · 展开操作" IsExpanded="False" Margin="0,10,0,0" MaxHeight="255">
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="224">
       <Border BorderBrush="#E2E8F2" BorderThickness="0,1,0,0" Padding="0,7,0,0">
      <StackPanel>
       <TextBlock Text="连续交互 · 操作清单" FontWeight="SemiBold" Margin="0,0,0,3"/>
       <TextBlock Text="排列常用操作，逐项运行；不等于自动测试脚本。" FontSize="11" Foreground="#697B91" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <WrapPanel Margin="0,0,0,6">
        <Button Content="加入清单" Click="QueueAdd_Click"/>
        <Button Content="移除" Click="QueueRemove_Click"/>
       </WrapPanel>
       <ListBox x:Name="QueueList" Height="102" FontSize="12" DisplayMemberPath="Name" Margin="0,0,0,6"/>
       <Button x:Name="QueueNextButton" Content="▶ 执行下一项" Click="QueueNext_Click" HorizontalContentAlignment="Center"/>
       <Button x:Name="QueueRunButton" Content="▶ 顺序执行整组一次" Click="QueueRun_Click" HorizontalContentAlignment="Center" Margin="0,6,0,0"/>
       <Separator Margin="0,8,0,6"/>
       <TextBlock Text="受控重复读取当前操作" FontWeight="SemiBold" FontSize="12"/>
       <WrapPanel Margin="0,4,0,2" VerticalAlignment="Center">
        <TextBlock Text="间隔(ms)" Margin="0,9,5,0" Foreground="#64748B" FontSize="12"/>
        <TextBox x:Name="WatchIntervalBox" Text="2000" Width="70" ToolTip="1000 到 60000 毫秒"/>
        <Button x:Name="WatchStartButton" Content="▶ 开始" Click="WatchStart_Click"/>
       </WrapPanel>
       <TextBlock x:Name="SeriesStatus" Text="清单和重复读取：每次真实 CAN 帧仍需人工授权。" Foreground="#B06D2A" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
      </StackPanel>
       </Border>
      </ScrollViewer>
     </Expander>
     <ListBox x:Name="ActionsList" SelectionChanged="ActionsList_SelectionChanged"
              HorizontalContentAlignment="Stretch" BorderThickness="0">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel Margin="6,6,4,6">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding Group}" Foreground="#8290A3" FontSize="11"/>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Column="2" Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="8" Padding="14">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="当前诊断操作" FontWeight="SemiBold" FontSize="16" Foreground="#20334E"/>
        <TextBlock Text="选择服务 → 修改参数 → 立即执行" Foreground="#697B91" FontSize="12" Margin="0,3,0,0"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="SendButton" Content="▶ 发送请求" Padding="16,7" Click="Send_Click" IsEnabled="False" Background="#DCEBFB"/>
        <Button x:Name="CancelButton" Content="■ 停止执行/等待" Click="Cancel_Click" IsEnabled="False"/>
       </StackPanel>
      </Grid>
      <TextBlock x:Name="SendHint" Text="每一步都等待真实 ECU 最终响应；NRC、超时或取消会中止整组执行。逐帧人工授权仍有效。" Foreground="#697B91" FontSize="11" Margin="0,6,0,1" TextWrapping="Wrap"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
         <TextBlock Text="操作名称" Foreground="#52637A"/>
         <TextBox x:Name="NameBox" TextChanged="EditorChanged"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock Text="所属组" Foreground="#52637A"/>
         <TextBox x:Name="GroupBox" TextChanged="EditorChanged"/>
        </StackPanel>
       </Grid>
       <Border Background="#F0F5FC" Padding="11,10" CornerRadius="6" Margin="0,0,0,10">
        <StackPanel>
         <TextBlock Text="服务与参数" FontWeight="SemiBold" Foreground="#20334E" Margin="0,0,0,6"/>
         <ComboBox x:Name="ServiceCombo" DisplayMemberPath="Display" SelectionChanged="ServiceChanged" ToolTip="选服务后自动生成 UDS 请求"/>
         <TextBlock x:Name="ServiceHelp" Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
         <ComboBox x:Name="SubfunctionPresetCombo" DisplayMemberPath="Display"
                   SelectionChanged="SubfunctionPresetChanged" Visibility="Collapsed"
                   ToolTip="选择常用子功能；也可以直接填写自定义十六进制参数"/>
         <TextBlock x:Name="PrimaryLabel" Text="DID / 子功能" Foreground="#52637A"/>
         <TextBox x:Name="PrimaryBox" FontFamily="Consolas" FontSize="15" TextChanged="ServiceParameterChanged"/>
         <TextBlock x:Name="AuxiliaryLabel" Text="附加数据（可选）" Foreground="#52637A"/>
         <TextBox x:Name="AuxiliaryBox" FontFamily="Consolas" FontSize="15" TextChanged="ServiceParameterChanged"/>
         <TextBlock x:Name="ComposerStatus" Foreground="#256C4C" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,3"/>
        </StackPanel>
       </Border>
       <Border BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="5" Padding="9,6" Margin="0,0,0,8">
        <StackPanel>
         <TextBlock Text="当前请求预览（自动组帧）" Foreground="#697B91" FontSize="11"/>
         <TextBlock Text="{Binding ElementName=RequestBox, Path=Text, FallbackValue=尚无请求}" Foreground="#20334E"
                    FontFamily="Consolas" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,1"/>
        </StackPanel>
       </Border>
       <Expander x:Name="AdvancedEditExpander" Header="高级编辑 · 原始 UDS HEX 与响应解析" IsExpanded="False" Margin="0,0,0,8">
        <StackPanel Margin="0,8,0,0">
         <CheckBox x:Name="RawModeCheck" Content="直接编辑完整 UDS 请求 HEX" Margin="0,0,0,6"
                   Checked="RawModeChanged" Unchecked="RawModeChanged"/>
         <TextBlock Text="UDS 请求 PDU（不包括 CAN / ISO-TP 帧头）" Foreground="#52637A"/>
         <TextBox x:Name="RequestBox" FontFamily="Consolas" FontSize="16" TextChanged="EditorChanged"
                  ToolTip="结构化模式会自动生成。勾选高级模式后可以直接修改。" IsReadOnly="True"/>
         <TextBlock Text="期望响应前缀（HEX，可自行修改）" Foreground="#52637A"/>
         <TextBox x:Name="ExpectedBox" FontFamily="Consolas" TextChanged="EditorChanged"/>
         <TextBlock Text="响应解析规则（可选）" Foreground="#52637A"/>
         <WrapPanel Margin="0,3,0,6">
          <ComboBox x:Name="DecodeBox" Width="155" SelectionChanged="EditorChangedSelection">
           <ComboBoxItem Content="原始 HEX" Tag="Hex"/>
           <ComboBoxItem Content="ASCII 字符串" Tag="Ascii"/>
           <ComboBoxItem Content="UInt16 大端" Tag="UInt16BE"/>
           <ComboBoxItem Content="UInt16 小端" Tag="UInt16LE"/>
           <ComboBoxItem Content="UInt8" Tag="UInt8"/>
           <ComboBoxItem Content="DTC 故障码列表" Tag="Dtc"/>
          </ComboBox>
          <TextBlock Text="偏移" Margin="2,10,4,0" Foreground="#52637A"/>
          <TextBox x:Name="OffsetBox" Width="46" TextChanged="EditorChanged"/>
          <TextBlock Text="比例" Margin="2,10,4,0" Foreground="#52637A"/>
          <TextBox x:Name="ScaleBox" Width="55" TextChanged="EditorChanged"/>
          <TextBlock Text="单位" Margin="2,10,4,0" Foreground="#52637A"/>
          <TextBox x:Name="UnitBox" Width="68" TextChanged="EditorChanged"/>
         </WrapPanel>
        </StackPanel>
       </Expander>
       <TextBlock Text="真实 ECU 状态变更类请求当前仅支持编辑和查看，不开放实体发送；批量自动交互与周期观察等待受限物理授权合同。" Foreground="#996B36" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Column="4" Background="White" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="8" Padding="14">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="ECU 响应与解析" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="执行状态" Foreground="#64748B"/>
       <TextBlock x:Name="ResultStatus" Text="尚无请求" FontSize="17" FontWeight="SemiBold" Foreground="#20334E" TextWrapping="Wrap" Margin="0,4,0,12"/>
       <TextBlock Text="请求 PDU" Foreground="#64748B"/>
       <TextBox x:Name="LastRequestBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,10"/>
       <TextBlock Text="实际 ECU 响应 PDU" Foreground="#64748B"/>
       <TextBox x:Name="LastResponseBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MinHeight="72" Margin="0,4,0,10"/>
       <TextBlock Text="解析结果" Foreground="#64748B"/>
       <TextBox x:Name="ParsedBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="70" Margin="0,4,0,10"/>
       <TextBlock Text="诊断说明 / NRC" Foreground="#64748B"/>
       <TextBox x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="72" Margin="0,4,0,10"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <TabControl Grid.Row="3" Margin="0,10,0,0">
   <TabItem Header="请求 / 响应历史（点击记录可回看）">
    <ListView x:Name="ExchangeList" SelectionChanged="Exchange_Selected" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto">
     <ListView.View>
      <GridView>
       <GridViewColumn Header="时间" Width="90" DisplayMemberBinding="{Binding LocalTime}"/>
       <GridViewColumn Header="诊断操作" Width="210" DisplayMemberBinding="{Binding ActionName}"/>
       <GridViewColumn Header="请求 PDU" Width="190" DisplayMemberBinding="{Binding RequestHex}"/>
       <GridViewColumn Header="响应 PDU" Width="300" DisplayMemberBinding="{Binding ResponseHex}"/>
       <GridViewColumn Header="结果" Width="260" DisplayMemberBinding="{Binding Outcome}"/>
       <GridViewColumn Header="耗时" Width="80" DisplayMemberBinding="{Binding Duration}"/>
      </GridView>
     </ListView.View>
    </ListView>
   </TabItem>
   <TabItem Header="详细事件时间线">
    <ListBox x:Name="HistoryList" FontFamily="Consolas" FontSize="12" HorizontalContentAlignment="Stretch"/>
   </TabItem>
   <TabItem Header="物理链路 / 原始帧">
    <TextBox x:Name="RawTraceBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="12" Background="White"/>
   </TabItem>
  </TabControl>
 </Grid>
</Window>
