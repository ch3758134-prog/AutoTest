<UserControl x:Class="AutoTest.Desktop.Testing.TestEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="14" Background="White" Foreground="#252C34"
 PreviewKeyDown="Editor_KeyDown">
 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="*" MinWidth="400"/>
   <ColumnDefinition x:Name="MonitorDividerColumn" Width="5"/>
   <ColumnDefinition x:Name="MonitorColumn" Width="350" MinWidth="0"/>
  </Grid.ColumnDefinitions>
  <Grid Grid.Column="0">
  <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="45"/><RowDefinition Height="*"/>
   <RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#E1E5E9" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBox x:Name="StepSearch" Width="146" Height="26" VerticalContentAlignment="Center"
      Text="{Binding StepFind,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      ToolTip="查找并高亮步骤；Enter 下一条，Shift+Enter 上一条"
      KeyDown="StepSearch_KeyDown" Margin="0,0,4,0"/>
     <TextBlock Text="{Binding SearchMatchCount,StringFormat='{}{0} 命中'}"
      Foreground="#9B6A22" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0">
      <TextBlock.Style><Style TargetType="{x:Type TextBlock}">
       <Style.Triggers><DataTrigger Binding="{Binding StepFind}" Value="">
        <Setter Property="Visibility" Value="Collapsed"/>
       </DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
     <Button Content="＋ 添加步骤" Command="{Binding AddStepCommand}"
      Style="{StaticResource AtPrimaryButton}" Foreground="#FFFFFF"
      Margin="0,0,6,0"
      ToolTip="选中阶段/分支：追加；选中步骤：插入其下方"/>
     <Menu Background="Transparent" Height="28" Margin="0,0,6,0">
      <MenuItem Header="常用步骤 ▾" Padding="7,3" FontSize="14"
       ToolTip="先选阶段或明确的子分支，再直接选择步骤类型">
       <MenuItem Header="发送 CAN 报文" Command="{Binding QuickAddCommand}" CommandParameter="can"/>
       <MenuItem Header="停止全部周期 CAN" Command="{Binding QuickAddCommand}" CommandParameter="stop-can"/>
       <MenuItem Header="模拟 ECU 按键" Command="{Binding QuickAddCommand}" CommandParameter="key"/>
       <MenuItem Header="切换 IGN" Command="{Binding QuickAddCommand}" CommandParameter="ign"/>
       <MenuItem Header="读取 CAN 信号" Command="{Binding QuickAddCommand}" CommandParameter="read"/>
          <MenuItem Header="CAN 信号判定" Command="{Binding QuickAddCommand}" CommandParameter="assert-signal"/>
       <MenuItem Header="固定等待" Command="{Binding QuickAddCommand}" CommandParameter="wait"/>
       <Separator/>
       <MenuItem Header="IF / ELSE" Command="{Binding QuickAddCommand}" CommandParameter="if"/>
       <MenuItem Header="循环" Command="{Binding QuickAddCommand}" CommandParameter="loop"/>
       <MenuItem Header="期望判定" Command="{Binding QuickAddCommand}" CommandParameter="expect"/>
      </MenuItem>
     </Menu>
     <Button Content="检查用例" Command="{Binding PreflightCommand}" Margin="0,0,6,0"/>
     <Button x:Name="ToggleCanMonitorButton" Content="隐藏 CAN 监视" Click="ToggleCanMonitor_Click"
      Margin="0,0,6,0" Padding="8,5" ToolTip="右侧固定显示真实 CAN RX，拖动分隔线可调整宽度"/>

    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding DocumentName}" FontSize="14" FontWeight="SemiBold"
      VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
     <Border Background="#F7F9FC" BorderBrush="#E1E5E9" BorderThickness="1"
      CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
      <TextBlock Text="{Binding StepCountLabel}" FontSize="12" Foreground="#64758C"/>
     </Border>
     <TextBlock Text="● 尚有未保存修改" FontSize="12" Foreground="#9B6A22"
      VerticalAlignment="Center" Margin="10,0,0,0">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsDirty}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- Real test execution of the currently open TEST case. -->
  <Border Grid.Row="1" Background="#EFF5FA" BorderBrush="#C9D9E9"
   BorderThickness="0,0,0,1">
   <Grid Margin="12,7">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="调试" FontWeight="SemiBold" Foreground="#42618B"
      VerticalAlignment="Center" Margin="0,0,9,0"/>
     <Button Content="运行用例" Command="{Binding RunCommand}"
      Style="{StaticResource AtPrimaryButton}" Foreground="White" MinHeight="34"
      Margin="0,0,6,0" Padding="11,5"
      ToolTip="执行当前完整用例；开发调试不需要扫码，正式生产才执行前置 FLASH 和全部用例"/>
     <Button Content="运行步骤" Command="{Binding RunSelectedStepCommand}"
      Margin="0,0,6,0" Padding="10,5"
      ToolTip="选中某个步骤；确认后仅执行该步骤及其子步骤，保留实体安全清理与独立诊断记录"/>
     <Button Content="停止" Command="{Binding StopRunCommand}"
      Margin="0,0,10,0" Padding="8,5" Style="{StaticResource AtDangerButton}" MinHeight="34"/>
    </StackPanel>
    <TextBlock Text="{Binding RunSummary}" FontSize="14" Foreground="#687680"
     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
     ToolTip="{Binding RunSummary}"/>
   </DockPanel>
   <Expander Grid.Row="1" Header="调试编号（可选）" IsExpanded="False"
    Foreground="#42566C" FontSize="12" Margin="0,6,0,0">
    <StackPanel Orientation="Horizontal" Margin="0,7,0,2">
     <TextBlock Text="ECU 编号" FontWeight="SemiBold"
      Margin="0,0,8,0" VerticalAlignment="Center"/>
     <TextBox Width="230" Height="28" VerticalContentAlignment="Center"
      Text="{Binding DutIdentity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      ToolTip="调试时可直接输入，留空不影响运行；正式生产使用扫码编号"/>
    </StackPanel>
   </Expander>
   </Grid>
  </Border>

  <Border Grid.Row="2" Background="#E8EFF6" BorderBrush="#C9D5E2" BorderThickness="0,0,0,1">
   <Grid Margin="0,0,8,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/>
     <ColumnDefinition Width="38*" MinWidth="220"/>
     <ColumnDefinition Width="62*" MinWidth="245"/>
     <ColumnDefinition Width="124"/><ColumnDefinition Width="106"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="序号" FontSize="14" Foreground="#263D54" FontWeight="SemiBold"
     VerticalAlignment="Center" HorizontalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="测试步骤" FontSize="14" Foreground="#263D54" FontWeight="SemiBold"
     VerticalAlignment="Center" Margin="7,0"/>
    <TextBlock Grid.Column="2" Text="参数与判定" FontSize="14" Foreground="#263D54" FontWeight="SemiBold"
     VerticalAlignment="Center" Margin="6,0"/>
    <TextBlock Grid.Column="3" Text="资源" FontSize="14" Foreground="#263D54" FontWeight="SemiBold"
     VerticalAlignment="Center" Margin="6,0"/>
    <TextBlock Grid.Column="5" Text="操作" FontSize="14" Foreground="#263D54" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    <TextBlock Grid.Column="4" Text="状态" FontSize="14" Foreground="#263D54" FontWeight="SemiBold"
     VerticalAlignment="Center" Margin="6,0"/>
   </Grid>
  </Border>

  <ListBox x:Name="StepsList" Grid.Row="3" ItemsSource="{Binding StepRows}"
   SelectedItem="{Binding SelectedRow,Mode=TwoWay}"
   SelectionChanged="StepsList_SelectionChanged"
   BorderThickness="0" Background="White"
   HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto"
   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
   VirtualizingStackPanel.IsVirtualizing="True"
   VirtualizingStackPanel.VirtualizationMode="Recycling"
   PreviewMouseRightButtonDown="StepsList_RightClick" MouseDoubleClick="StepsList_DoubleClick"
   PreviewMouseLeftButtonDown="StepsList_PreviewMouseLeftButtonDown"
   PreviewMouseMove="StepsList_PreviewMouseMove"
   AllowDrop="True" DragOver="StepsList_DragOver" Drop="StepsList_Drop">
   <ListBox.ItemContainerStyle>
    <Style TargetType="{x:Type ListBoxItem}">
     <Setter Property="Padding" Value="0"/>
     <Setter Property="MinHeight" Value="0"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="Background" Value="White"/>
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
     <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F8FD"/></Trigger>
      <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
       <Setter Property="Background" Value="#FFF5DE"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsNewDraft}" Value="True">
       <Setter Property="Background" Value="#FFF9EC"/>
      </DataTrigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEBFC"/></Trigger>
     </Style.Triggers>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Grid MinWidth="815">
      <!-- Separate inset phase headers; the canonical TEST phase/slot editing remains unchanged. -->
      <Border x:Name="PhaseRow" Style="{StaticResource AtTestPhaseHeader}"
       Visibility="{Binding IsPhase,Converter={StaticResource BoolToVisibility}}">
       <StackPanel>
       <DockPanel Height="42" Margin="11,0,9,0">
        <Button DockPanel.Dock="Right" Content="＋ 添加步骤" Tag="{Binding}" Click="AddAtRow_Click"
         Focusable="False" Style="{StaticResource AtTestPhaseAddButton}"
         ToolTip="直接在这个阶段末尾添加真实 TEST 步骤"/>
        <Border DockPanel.Dock="Right" Background="White" BorderBrush="#E4EAF3"
         BorderThickness="1" CornerRadius="4" Padding="7,3"
         VerticalAlignment="Center" Margin="0,0,10,0">
         <TextBlock Text="{Binding RowCount}" FontSize="12" Foreground="#74869B"/>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Button Content="{Binding ExpandMark}" Click="StepExpand_Click" Tag="{Binding}"
          Width="22" Height="24" MinWidth="0" MinHeight="0" Padding="0"
          Style="{StaticResource AtQuietButton}" Foreground="#64758C"
          ToolTip="展开或收起此阶段"/>
         <Border Width="3" Height="19" CornerRadius="2" Margin="5,0,10,0"
          VerticalAlignment="Center">
          <Border.Style>
           <Style TargetType="Border">
            <Setter Property="Background" Value="#397FBB"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding PhaseKind}" Value="Test">
              <Setter Property="Background" Value="#13816B"/>
             </DataTrigger>
             <DataTrigger Binding="{Binding PhaseKind}" Value="Cleanup">
              <Setter Property="Background" Value="#CA8B2E"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </Border.Style>
         </Border>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
          VerticalAlignment="Center">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#27649A"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding PhaseKind}" Value="Test">
              <Setter Property="Foreground" Value="#176B59"/>
             </DataTrigger>
             <DataTrigger Binding="{Binding PhaseKind}" Value="Cleanup">
              <Setter Property="Foreground" Value="#9A671F"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </DockPanel>
       <TextBlock Text="本阶段暂无步骤" FontSize="14" Foreground="#7A8DA4"
        Margin="50,1,0,7"
        Visibility="{Binding IsEmptyPhase,Converter={StaticResource BoolToVisibility}}"/>
       </StackPanel>
      </Border>

      <Border x:Name="SlotRow" Background="#F3F7FC" BorderBrush="#DCE6F1"
       BorderThickness="0,0,0,1" Height="36"
       Visibility="{Binding IsSlot,Converter={StaticResource BoolToVisibility}}">
       <DockPanel LastChildFill="True" Margin="8,0,7,0">
        <Button DockPanel.Dock="Right" Content="{Binding AddBranchButtonText}" Tag="{Binding}"
         Click="AddAtRow_Click" Focusable="False" Height="27" MinHeight="0"
         Padding="10,2" FontSize="12" Foreground="#285B89"
         Style="{StaticResource AtQuietButton}"
         ToolTip="直接向此 THEN／ELSE／CASE／循环子分支末尾添加步骤"/>
        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}"
         VerticalAlignment="Center">
         <Button Content="{Binding ExpandMark}" Click="StepExpand_Click"
          Width="18" Height="22" MinWidth="0" MinHeight="0" Padding="0"
          Style="{StaticResource AtQuietButton}" Foreground="#435975"/>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
          Foreground="#344E67" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>
       </DockPanel>
      </Border>

      <Border x:Name="StepRow" Background="Transparent" BorderBrush="#E7EDF5"
       BorderThickness="0,0,0,1"
       Visibility="{Binding IsStep,Converter={StaticResource BoolToVisibility}}">
       <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="46"/><Style.Triggers><DataTrigger Binding="{Binding IsCanSendRow}" Value="True"><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="60"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/>
         <ColumnDefinition Width="38*" MinWidth="220"/>
         <ColumnDefinition Width="62*" MinWidth="245"/>
         <ColumnDefinition Width="124"/><ColumnDefinition Width="106"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
        <Border Width="3" HorizontalAlignment="Left" Panel.ZIndex="2">
         <Border.Style><Style TargetType="{x:Type Border}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="Background" Value="#3478D6"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Background" Value="#D89826"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=IsSelected}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Background" Value="#3478D6"/>
           </DataTrigger>
          </Style.Triggers>
         </Style></Border.Style>
        </Border>

        <TextBlock Grid.Column="0" Text="{Binding SequenceText}" FontSize="12"
         Foreground="#526477" HorizontalAlignment="Center" VerticalAlignment="Center"
         FontFamily="Consolas"/>
        <TextBlock Grid.Column="0" Text="{Binding BreakpointMark}" Foreground="#C04A57"
         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0" FontSize="12"/>
        <Grid Grid.Column="1" Margin="{Binding Indent}">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="19"/><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <Button Grid.Column="0" Content="{Binding ExpandMark}" Click="StepExpand_Click"
          Height="23" Width="18" MinWidth="0" MinHeight="0" Padding="0"
          Style="{StaticResource AtQuietButton}" Foreground="#64758C"
          Focusable="False" ToolTip="展开／收起子步骤"/>
         <Border Grid.Column="1" Width="25" Height="25" CornerRadius="4"
          VerticalAlignment="Center" Margin="1,0">
          <Border.Style>
           <Style TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#E9EEF5"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Category}" Value="Can"><Setter Property="Background" Value="#D9E9FC"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Hardware"><Setter Property="Background" Value="#FCE4C4"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Uds"><Setter Property="Background" Value="#DFE5F6"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Flash"><Setter Property="Background" Value="#FCE1DB"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Flow"><Setter Property="Background" Value="#E0E7F1"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Wave"><Setter Property="Background" Value="#D9F0E8"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </Border.Style>
          <TextBlock Text="{Binding Icon}" FontSize="12"
           VerticalAlignment="Center" HorizontalAlignment="Center">
           <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
             <Setter Property="Foreground" Value="#66788E"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding Category}" Value="Can"><Setter Property="Foreground" Value="#3478D6"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Hardware"><Setter Property="Foreground" Value="#A26319"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Uds"><Setter Property="Foreground" Value="#384E91"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Flash"><Setter Property="Foreground" Value="#B42318"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Flow"><Setter Property="Foreground" Value="#435975"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Wave"><Setter Property="Foreground" Value="#17694E"/></DataTrigger>
             </Style.Triggers>
            </Style>
           </TextBlock.Style>
          </TextBlock>
         </Border>
         <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,7,0">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#182B3C" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
          <TextBlock Text="{Binding TypeLabel}" FontSize="12" Foreground="#43566B" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </Grid>
        <Grid Grid.Column="2" Margin="6,0">
         <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
          Foreground="#2C4055" VerticalAlignment="Center" FontSize="14"
          Visibility="{Binding ShowNormalSummary,Converter={StaticResource BoolToVisibility}}"
          MouseLeftButtonDown="QuickSummary_MouseLeftButtonDown"
          ToolTip="步骤摘要；等待时间与循环次数可双击直接修改"/>
         <StackPanel VerticalAlignment="Center" Margin="0,5" Visibility="{Binding IsCanSendRow,Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Summary}">
          <TextBlock Text="{Binding CanDataLine}" FontFamily="Consolas" FontSize="14" Foreground="#263D55" FontWeight="Medium" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding CanFrameLine}" FontSize="14" Foreground="#526B84" Margin="0,3,0,0" TextWrapping="Wrap"/>
         </StackPanel>
         <TextBox Text="{Binding QuickValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          Visibility="{Binding ShowInlineEditor,Converter={StaticResource BoolToVisibility}}"
          Background="White" BorderBrush="#5A9BD2" BorderThickness="1"
          Padding="4,1" Height="25" MinHeight="0" FontSize="12" Foreground="#264D74"
          VerticalAlignment="Center" VerticalContentAlignment="Center"
          ToolTip="Enter 应用到 TEST 草稿；Esc 恢复原值"
          LostFocus="QuickField_LostFocus" KeyDown="QuickField_KeyDown"/>
        </Grid>
        <TextBlock Grid.Column="3" Text="{Binding ResourceDisplay}" TextTrimming="CharacterEllipsis"
         Foreground="#43566B" VerticalAlignment="Center" FontSize="13" Margin="7,0"
         ToolTip="{Binding ResourceDisplay}"/>
        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Button Content="＋" Click="InsertAfterRow_Click" Tag="{Binding}" Padding="5,3"
          MinWidth="25" MinHeight="25" Margin="0,0,3,0" ToolTip="在当前步骤下方直接添加下一步"/>
         <Button Content="编辑" Click="EditStepRow_Click" Tag="{Binding}" Padding="5,3"
          MinWidth="38" MinHeight="25" ToolTip="双击整行也可编辑步骤"/>
        </StackPanel>
        <Border Grid.Column="4" Margin="5,0" Padding="6,4" CornerRadius="4" VerticalAlignment="Center" ToolTip="{Binding StateDetail}">
         <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#EEF2F6"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding StateTone}" Value="Done"><Setter Property="Background" Value="#DEF1E5"/></DataTrigger>
           <DataTrigger Binding="{Binding StateTone}" Value="Error"><Setter Property="Background" Value="#FCE1DF"/></DataTrigger>
           <DataTrigger Binding="{Binding StateTone}" Value="Warning"><Setter Property="Background" Value="#FCE8C9"/></DataTrigger>
          </Style.Triggers></Style></Border.Style>
         <TextBlock Text="{Binding State}" FontSize="13" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#43566B"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding StateTone}" Value="Done"><Setter Property="Foreground" Value="#17633B"/></DataTrigger>
            <DataTrigger Binding="{Binding StateTone}" Value="Error"><Setter Property="Foreground" Value="#A61E17"/></DataTrigger>
            <DataTrigger Binding="{Binding StateTone}" Value="Warning"><Setter Property="Foreground" Value="#8A4B00"/></DataTrigger>
           </Style.Triggers></Style></TextBlock.Style>
         </TextBlock>
        </Border>
       </Grid>
      </Border>
     </Grid>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <Border Grid.Row="4" Background="#FBFCFF" BorderBrush="#E1E5E9" BorderThickness="0,1,0,0">
   <DockPanel Margin="10,0">
    <TextBlock DockPanel.Dock="Right" Text="行内＋插入 · 双击编辑 · Ctrl+Space · F9"
     FontSize="12" Foreground="#526477" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding StatusMessage}" Foreground="#64758C" FontSize="12"
     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <!-- Wide grouped palette: common actions visible together, one click inserts a formal TEST draft. -->
  <Popup x:Name="ActionPalette" Placement="Center"
   PlacementTarget="{Binding ElementName=StepsList}" StaysOpen="False" AllowsTransparency="True">
   <Border x:Name="PaletteSurface" Width="690" MaxHeight="560" Background="White"
    CornerRadius="8" BorderBrush="#DFE5E4" BorderThickness="1" Padding="12,11">
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.24"/></Border.Effect>
    <DockPanel LastChildFill="True">
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="27" MinWidth="0"
       Style="{StaticResource AtQuietButton}" Click="PaletteCancel_Click"
       ToolTip="关闭步骤选择" Margin="12,0,0,0"/>
      <StackPanel>
       <TextBlock Text="添加测试步骤" FontSize="17" FontWeight="SemiBold" Foreground="#2F3C4B"/>
       <TextBlock x:Name="PaletteHint" Text="当前插入位置"
        FontSize="11" Foreground="#61758A" Margin="0,3,0,0"
        TextTrimming="CharacterEllipsis" ToolTip="根据当前选中的阶段或步骤确定插入位置"/>
      </StackPanel>
     </DockPanel>
     <Border DockPanel.Dock="Top" Background="#F8FAF9" BorderBrush="#DCE5E2"
      BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="6,2">
      <DockPanel>
       <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="18" Foreground="#627C9D"
        VerticalAlignment="Center" Margin="3,0,7,0"/>
       <TextBox x:Name="PaletteSearch" TextChanged="PaletteSearch_Changed"
        KeyDown="PaletteSearch_KeyDown" ToolTip="输入 CAN、IGN、按键、等待、IF、波形等关键词"
        Height="32" BorderThickness="0" Background="Transparent"
        VerticalContentAlignment="Center" Padding="5,3"/>
      </DockPanel>
     </Border>
     <TextBlock DockPanel.Dock="Bottom" Text="Enter 添加  ·  Esc 关闭"
      Foreground="#7A8EA6" FontSize="11" Margin="0,8,0,0"/>
     <DockPanel>
      <ListBox x:Name="PaletteCategories" DockPanel.Dock="Top" Height="40"
       SelectionChanged="PaletteCategory_Changed" Background="#F6F8FA"
       BorderBrush="#E1E7E5" BorderThickness="1" FontSize="14"
       ScrollViewer.HorizontalScrollBarVisibility="Auto"
       ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
       <ListBox.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
       </ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle>
        <Style TargetType="{x:Type ListBoxItem}">
         <Setter Property="Padding" Value="11,6"/>
         <Setter Property="Margin" Value="2,2"/>
         <Setter Property="Height" Value="34"/>
         <Setter Property="VerticalContentAlignment" Value="Center"/>
         <Setter Property="Foreground" Value="#263D54"/>
         <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
           <Setter Property="Background" Value="#E8F0FC"/>
           <Setter Property="Foreground" Value="#1C5DA6"/>
           <Setter Property="FontWeight" Value="SemiBold"/>
          </Trigger>
         </Style.Triggers>
        </Style>
       </ListBox.ItemContainerStyle>
      </ListBox>
      <ListBox x:Name="PaletteList" MinHeight="165" MaxHeight="390"
       MouseDoubleClick="PaletteList_DoubleClick" KeyDown="PaletteList_KeyDown"
       PreviewMouseLeftButtonUp="PaletteList_PreviewMouseLeftButtonUp"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
       ScrollViewer.VerticalScrollBarVisibility="Auto"
       Background="#FFFFFF" BorderBrush="#E1E7E5" BorderThickness="1" FontSize="12">
       <ListBox.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
       </ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle>
        <Style TargetType="{x:Type ListBoxItem}">
         <Setter Property="MinHeight" Value="38"/>
         <Setter Property="Margin" Value="3,2"/>
         <Setter Property="Padding" Value="10,7"/>
         <Setter Property="Background" Value="#FBFCFD"/>
         <Setter Property="BorderBrush" Value="#DEE6E8"/>
         <Setter Property="BorderThickness" Value="1"/>
         <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
         <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
           <Setter Property="Background" Value="#F0F5FC"/>
           <Setter Property="BorderBrush" Value="#9EBCE8"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
           <Setter Property="Background" Value="#E7F0FF"/>
           <Setter Property="BorderBrush" Value="#89B0E9"/>
          </Trigger>
         </Style.Triggers>
        </Style>
       </ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <TextBlock Text="{Binding Title}" ToolTip="{Binding Description}"
          FontWeight="SemiBold" Foreground="#273B50" FontSize="13"
          VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </DockPanel>
   </Border>
  </Popup>
  <!-- A single explicit step transaction; no second shell inspector. -->
  <Grid x:Name="StepPropertyOverlay" Grid.RowSpan="5" Panel.ZIndex="100" Visibility="Collapsed" Background="#40F1F5F9" Focusable="True" MouseLeftButtonDown="StepPropertyOverlay_MouseLeftButtonDown">
   <Border x:Name="StepPropertyCard" MaxWidth="1120" MaxHeight="760" Margin="18" Background="#FAFBFC" BorderBrush="#DDE6ED" BorderThickness="1" CornerRadius="9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="14,10,14,6">
      <TextBlock DockPanel.Dock="Right" Text="在步骤窗口点击“完成”保存或“取消”返回；点击外部不会关闭" Foreground="#687680" FontSize="12" VerticalAlignment="Center"/>
      <TextBlock Text="步骤属性" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#34475C"/>
     </DockPanel>
     <ContentControl x:Name="StepPropertyHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
 <GridSplitter x:Name="MonitorDivider" Grid.Column="1" Width="5"
  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#D6E1ED"
  ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
 <Border x:Name="CanMonitorPanel" Grid.Column="2" Background="#F8FAFD"
  BorderBrush="#D6E1ED" BorderThickness="1,0,0,0">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="12,12,10,7">
    <TextBlock x:Name="CanMonitorFeedStatus" DockPanel.Dock="Right" Text="CAN 实时监视" Foreground="#406B51" FontSize="11"
     VerticalAlignment="Center"/>
    <TextBlock Text="CAN 实时监视" FontSize="15" FontWeight="SemiBold"
     Foreground="#203C55" VerticalAlignment="Center"/>
   </DockPanel>
   <DockPanel Grid.Row="1" Margin="10,0,10,8">
    <CheckBox x:Name="CanAutoFollow" DockPanel.Dock="Right" Content="跟随最新"
     IsChecked="True" FontSize="12" Foreground="#3F556A" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal">
     <RadioButton Content="全部" Tag="All" GroupName="TestCanFilter" IsChecked="True"
      Checked="CanMonitorFilter_Checked" Margin="0,0,11,0" Foreground="#263D54"/>
     <RadioButton Content="ECU" Tag="Ecu" GroupName="TestCanFilter"
      Checked="CanMonitorFilter_Checked" Margin="0,0,11,0" Foreground="#263D54"/>
     <RadioButton Content="KEY" Tag="Key" GroupName="TestCanFilter"
      Checked="CanMonitorFilter_Checked" Foreground="#263D54"/>
    </StackPanel>
   </DockPanel>
   <DataGrid x:Name="CanMonitorTable" Grid.Row="2" Margin="7,0,7,0"
    AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
    HeadersVisibility="Column" RowHeaderWidth="0" FontFamily="Consolas"
    FontSize="12" Foreground="#203C55" Background="White"
    AlternatingRowBackground="#F2F6FB" GridLinesVisibility="Horizontal"
    ScrollViewer.HorizontalScrollBarVisibility="Auto"
    ScrollViewer.VerticalScrollBarVisibility="Auto"
    VirtualizingPanel.IsVirtualizing="True"
    VirtualizingPanel.VirtualizationMode="Recycling">
    <DataGrid.Columns>
     <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="94"/>
     <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="67"/>
     <DataGridTextColumn Header="通道" Binding="{Binding Port}" Width="68"/>
     <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="96"/>
     <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="42"/>
     <DataGridTextColumn Header="DATA (HEX)" Binding="{Binding Data}" Width="175"/>
     <DataGridTextColumn Header="丢帧" Binding="{Binding Lost}" Width="55"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Grid.Row="3" Margin="11,8,11,10" FontSize="11" Foreground="#617589"
    TextWrapping="Wrap" Text="RX：收到的 CAN 帧。发送确认不代表 ECU 收到，丢帧可能影响测试结论。"/>
  </Grid>
 </Border>
 </Grid>
</UserControl>
