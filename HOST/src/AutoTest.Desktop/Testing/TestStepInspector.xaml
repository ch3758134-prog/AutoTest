<UserControl x:Class="AutoTest.Desktop.Testing.TestStepInspector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:testing="clr-namespace:AutoTest.Desktop.Testing"
 Background="#FAFBFB" Foreground="#2B3435" FontFamily="{StaticResource UiFont}"
 FontSize="13" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12,9,12,11">
    <DockPanel Margin="0,0,0,8" LastChildFill="True">
     <Border DockPanel.Dock="Left" Background="#EDF4FF" CornerRadius="5"
      Width="27" Height="27" Margin="0,0,8,0">
      <TextBlock x:Name="TypeIcon" Text="▣" Foreground="#475668" FontSize="13"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock x:Name="StepCode" DockPanel.Dock="Right" Visibility="Collapsed" Foreground="#43566B"
      VerticalAlignment="Center" FontFamily="Consolas" FontSize="13"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="Heading" Text="编辑步骤" Visibility="Collapsed" Foreground="#344454"
       FontWeight="SemiBold" FontSize="13"/>
      <TextBlock x:Name="TypeLabel" Foreground="#344454" FontSize="13" FontWeight="SemiBold"/>
     </StackPanel>
    </DockPanel>
    <!-- Editing existing StepId only. New action selection belongs exclusively to
         the central editor's grouped ActionPalette; no second type list here. -->
    <TextBlock x:Name="ActionDescription" TextWrapping="Wrap" Foreground="#64758C"
     FontSize="13" Margin="0,0,0,6" Visibility="Collapsed"/><DockPanel Margin="0,0,0,12" LastChildFill="True">
      <CheckBox x:Name="StepEnabledInput" DockPanel.Dock="Right" Content="执行此步骤"
       Margin="10,14,0,0" VerticalAlignment="Top" IsChecked="True"
       ToolTip="取消后，本步骤不参与测试；如果是流程容器，其子步骤也会跳过。步骤配置仍保留。"/>
      <StackPanel>
       <TextBlock Text="名称" Foreground="#43566B" FontWeight="SemiBold"
        FontSize="13" Margin="0,0,0,4"/>
       <TextBox x:Name="NameInput" MinHeight="34"/>
      </StackPanel>
     </DockPanel>
    <StackPanel x:Name="PublicFlowPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="调用公共流程" Foreground="#43566B" FontWeight="SemiBold"
      FontSize="13" Margin="0,0,0,5"/>
     <ComboBox x:Name="PublicFlowPicker" ItemsSource="{Binding AvailableFlowChoices}"
      DisplayMemberPath="Label" MinHeight="34"/>
     <TextBlock x:Name="PublicFlowReferenceStatus" TextWrapping="Wrap"
      Foreground="#A2752D" FontSize="13" Margin="0,5,0,0"/>
    </StackPanel>
    <Grid x:Name="ObjectParameterGrid" Margin="0,0,0,10">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="ObjectParameterLeft" Width="*"/><ColumnDefinition x:Name="ObjectParameterGap" Width="0"/><ColumnDefinition x:Name="ObjectParameterRight" Width="0"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="TargetPanel" Grid.Row="0" Margin="0,0,0,13">
     <!-- All TEST DBC signals share the same search-first picker as CAN sending. -->
     <StackPanel x:Name="DbcSignalPickerPanel" Visibility="Collapsed">
      <TextBlock Text="DBC 信号" FontWeight="SemiBold" Foreground="#475668"
       FontSize="13" Margin="0,0,0,6"/>
      <testing:DbcReferencePicker x:Name="SignalDbcPicker"
       ChoiceCommitted="DbcReference_ChoiceCommitted"/>
     </StackPanel>
     <!-- Keep existing non-DBC KEY, IGN and wave resource edit contracts. -->
     <StackPanel x:Name="LegacyTargetPanel">
      <TextBlock Text="操作对象" Foreground="#43566B"
       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5"/>
      <TextBox x:Name="TargetSearch" TextChanged="TargetSearch_Changed"
       ToolTip="搜索 KEY、IGN 或波形资源"
       Margin="0,0,0,5"/>
      <ComboBox x:Name="TargetPicker" ItemsSource="{Binding AvailableTargets}"
       DisplayMemberPath="Label" MinHeight="34"
       SelectionChanged="TargetPicker_Changed"/>
     </StackPanel>
     <TextBlock x:Name="TargetHint" Visibility="Collapsed" Foreground="#64758C"
      FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <Border x:Name="TargetDetailCard" Visibility="Collapsed" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
      <StackPanel>
       <TextBlock Text="当前配置" FontWeight="SemiBold" Foreground="#34475C" Margin="0,0,0,8"/>
       <TextBlock x:Name="TargetDetail" TextWrapping="Wrap" Foreground="#42576C" FontSize="13"/>
       <Viewbox x:Name="WaveReferenceView" Visibility="Collapsed" Stretch="Uniform" Margin="0,10,0,0">
        <Canvas x:Name="WaveReferenceCanvas" Width="360" Height="184" Background="#F7FAFD" ClipToBounds="True"/>
       </Viewbox>
       <TextBlock x:Name="WaveReferenceStatus" TextWrapping="Wrap" Foreground="#526B84" FontSize="13" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <ItemsControl x:Name="ParameterList" Grid.Row="1" ItemsSource="{Binding ParameterFields}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="0,0,0,11">
        <TextBlock Text="{Binding Label}" Foreground="#43566B" FontSize="13"
         FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid>
         <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
          <TextBox.Style>
           <Style TargetType="TextBox">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding HasChoices}" Value="True">
              <Setter Property="Visibility" Value="Collapsed"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBox.Style>
         </TextBox>
         <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
          SelectedValuePath="Value" SelectedValue="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          MinHeight="34" Padding="6,3">
          <ComboBox.Style>
           <Style TargetType="ComboBox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding HasChoices}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </ComboBox.Style>
         </ComboBox>
        </Grid>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Grid>

    <!-- CAN remains an exact byte editor; DBC is an automatically attached
         helper, with a compact optional picker for changing definitions. -->
    <Grid x:Name="CanSendPanel" Visibility="Collapsed" Margin="0,0,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1*" MinWidth="335"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.15*" MinWidth="330"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
     <Border x:Name="CanDataCard" Background="White" BorderBrush="#E2E8E5"
      BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,11">
      <StackPanel>
       <TextBlock Text="发送报文" FontWeight="SemiBold" Foreground="#475668"
        Margin="0,0,0,8"/>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <StackPanel Margin="0,0,10,0">
         <TextBlock Text="CAN ID" FontSize="13" Foreground="#43566B"
          Margin="0,0,0,3"/>
         <TextBox x:Name="FrameIdInput" Width="126" Height="29"
          FontFamily="Consolas" TextChanged="CanId_Changed"
          LostFocus="CanId_LostFocus"/>
        </StackPanel>
        <StackPanel Margin="0,0,10,0">
         <TextBlock Text="DLC" FontSize="13" Foreground="#43566B"
          Margin="0,0,0,3"/>
         <TextBox x:Name="CanDlcInput" Width="43" Height="29"
          IsReadOnly="True" Background="#F2F5F9"
          FontFamily="Consolas"/>
        </StackPanel>
        <StackPanel>
         <TextBlock Text="帧格式" FontSize="13" Foreground="#43566B"
          Margin="0,0,0,3"/>
         <TextBlock x:Name="CanFrameFormatLabel" Text="根据 CAN ID 自动识别"
          Margin="0,5,0,0" FontSize="13" Foreground="#64758C"
          ToolTip="DBC 定义优先；无 DBC 时，ID 大于 0x7FF 自动识别为扩展帧，否则默认为标准帧。"/>
        </StackPanel>
       </StackPanel>
       <TextBlock Text="DATA · 实际发送字节（HEX）" FontWeight="SemiBold"
        Foreground="#475668" FontSize="13" Margin="0,3,0,4"/>
       <TextBox x:Name="RawCanDataInput" TextChanged="CanData_Changed"
        MinHeight="31" Padding="7,4"
         HorizontalAlignment="Stretch" FontFamily="Consolas" FontSize="13"
        ToolTip="直接编辑完整报文字节，例如 00 00 00 00 00 00 00 00"/>
       <TextBlock x:Name="CanFramePreview" FontSize="13"
        Foreground="#43566B" Margin="0,6,0,0" TextWrapping="Wrap"/>
       <TextBlock x:Name="CanPreviewIssue" FontSize="13" Foreground="#AF533D"
        Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>

     <Border Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="6"
      Padding="10" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="发送方式" FontWeight="SemiBold"
        Foreground="#475668" Margin="0,0,0,8"/>
       <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
        <RadioButton x:Name="CanOnceMode" Content="单次"
         GroupName="CanSendMode" Checked="CanSendMode_Changed"
         Margin="0,0,15,0"/>
        <RadioButton x:Name="CanPeriodicMode" Content="周期发送"
         GroupName="CanSendMode" Checked="CanSendMode_Changed" Margin="0,0,12,0"/>
        <StackPanel x:Name="CanPeriodField" Orientation="Horizontal" VerticalAlignment="Center">
         <TextBox x:Name="CanPeriodInput" Width="70" MinHeight="34" ToolTip="周期（毫秒）"/>
         <TextBlock Text="ms" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>
       </WrapPanel>
       <StackPanel x:Name="CanPeriodicPanel" Visibility="Collapsed">
        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,5">
         <TextBlock Text="结束条件" VerticalAlignment="Center" Foreground="#526B84" Margin="0,0,9,0"/>
         <RadioButton x:Name="CanUntilStopped" Content="持续到停止 / 整组结束" GroupName="CanSendStop" Checked="CanStopMode_Changed" VerticalAlignment="Center" Margin="0,0,12,0"/>
         <RadioButton x:Name="CanTimedStop" Content="发送指定时长后自动停止" GroupName="CanSendStop" Checked="CanStopMode_Changed" VerticalAlignment="Center" Margin="0,0,7,0"/>
         <StackPanel x:Name="CanTimedDurationPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox x:Name="CanDurationInput" Width="70" MinHeight="34" ToolTip="持续时间（毫秒）"/>
          <TextBlock Text="ms" VerticalAlignment="Center" Margin="4,0,0,0"/>
         </StackPanel>
        </WrapPanel>
        <TextBlock x:Name="CanPeriodicMeaning" FontSize="13"
         Foreground="#365873" Margin="0,8,0,0" TextWrapping="Wrap"
         Text="启动后立即发送首帧；后续在后台按周期发送，测试流程继续执行。"/>
       </StackPanel>
      </StackPanel>
     </Border>
     </StackPanel>
     <Border Grid.Column="2" Background="White" BorderBrush="#E2E8E5" BorderThickness="1" CornerRadius="6" Padding="12">
     <StackPanel Margin="0,0,0,0">
      <DockPanel Margin="0,0,0,7">
        <Button DockPanel.Dock="Right" Content="清除辅助" Click="ClearCanDbc_Click"
         Padding="9,4" MinWidth="80" ToolTip="解除 DBC 关联；保留 CAN ID、帧格式、DATA 和发送方式"/>
        <TextBlock Text="DBC 信号辅助" FontWeight="SemiBold" Foreground="#475668"
         VerticalAlignment="Center"/>
       </DockPanel>
      <testing:DbcReferencePicker x:Name="CanDbcPicker" Margin="0,0,0,6"
       ChoiceCommitted="DbcReference_ChoiceCommitted"/>
      <!-- Hidden compatibility selection state for existing StepNode transactions.
           The operator sees only the unified DBC picker above. -->
      <StackPanel Visibility="Collapsed">
       <TextBox x:Name="CanTargetSearch" TextChanged="TargetSearch_Changed"/>
       <ComboBox x:Name="CanTargetPicker" ItemsSource="{Binding AvailableTargets}"
        DisplayMemberPath="Label" SelectionChanged="TargetPicker_Changed"/>
      </StackPanel>
      <TextBlock x:Name="CanTargetHint" Foreground="#43566B"
       TextWrapping="Wrap" FontSize="13" Margin="0,1,0,5"/>
      <Button x:Name="CanRebindButton" Content="重新绑定 DBC"
       Click="CanRebind_Click" Visibility="Collapsed"
       HorizontalAlignment="Left" Padding="7,4" Margin="0,3,0,5"/>
      <StackPanel x:Name="DbcCanPanel" Visibility="Collapsed">
       <TextBlock x:Name="DbcMessageInfo" FontSize="13" Foreground="#526B84"
        Margin="0,0,0,7" TextWrapping="Wrap"/>
       <TextBox x:Name="CanSignalSearch" TextChanged="CanSignalSearch_Changed" ToolTip="搜索信号名称或别名，不改变 DATA" MinHeight="34" Margin="0,0,0,6"/>
       <ScrollViewer MaxHeight="385" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ItemsControl x:Name="SignalGrid" ItemsSource="{Binding SignalValues}" ItemTemplate="{StaticResource CanSignalEditorRow}"/>
       </ScrollViewer>
      </StackPanel>
     </StackPanel>
     </Border>
    </Grid>

    <StackPanel x:Name="KeyPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="按键动作" Foreground="#43566B" FontWeight="SemiBold"
      FontSize="13" Margin="0,0,0,6"/>

     <ComboBox x:Name="KeyActionInput" SelectionChanged="KeyAction_Changed"
      ToolTip="正常 KEY_SIM 为保持组合、明确释放或纯等待；不会因计时结束自动断开当前 Key"
      MinHeight="34" Margin="0,0,0,8"><ComboBoxItem Content="设置并保持" Tag="Hold"/>
      <ComboBoxItem Content="全部断开" Tag="Release"/>
      <ComboBoxItem Content="纯等待" Tag="Wait"/>
     </ComboBox>
     <StackPanel x:Name="RawKeyMaskPanel" Visibility="Collapsed">
      <TextBlock Text="20 Key 组合" Foreground="#43566B"
       FontSize="13" Margin="0,0,0,5"/>
      <TextBox x:Name="RawKeyMaskInput" IsReadOnly="True" Visibility="Collapsed" FontFamily="Consolas"
       Margin="0,0,0,8"/>
      <UniformGrid x:Name="RawKeyGrid" Columns="5" Rows="4" Margin="0,0,0,7"/>
      <Button Content="清空选择" Click="ClearRawKeys_Click"
       HorizontalAlignment="Left" Margin="0,0,0,8"/>

     </StackPanel>
     <StackPanel x:Name="KeyDurationPanel">
      <TextBlock x:Name="KeyDurationLabel" Text="保持时间（ms）" Foreground="#43566B" FontSize="13"
       Margin="0,0,0,5" ToolTip="保持到时不会释放；纯等待不会发送 KEY CAN。"/>
      <TextBox x:Name="KeyDurationInput" Width="150"
       HorizontalAlignment="Left"/>
     </StackPanel>
    </StackPanel>

    <StackPanel x:Name="IgnitionPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="IGN 目标状态" FontWeight="SemiBold" Foreground="#43566B"
      FontSize="13" Margin="0,0,0,6"/>
     <ComboBox x:Name="IgnitionState">
      <ComboBoxItem Content="开启 IGN" Tag="ON"/>
      <ComboBoxItem Content="关闭 IGN" Tag="OFF"/>
     </ComboBox>
    </StackPanel>

    <Border BorderBrush="#E3E9E6" BorderThickness="0,1,0,0" Margin="0,12,0,8"/>
    <StackPanel x:Name="StepActionsPanel" Visibility="Collapsed"/>

   </StackPanel>
  </ScrollViewer>
  <!-- Sticky apply/cancel at the bottom; edits stay transactional and cancellable. -->
  <Border Grid.Row="1" Background="#FAFBFB" BorderBrush="#E1E7E4"
   BorderThickness="0,1,0,0" Padding="12,8">
   <StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#C04A57" FontSize="13"
     TextWrapping="Wrap" Margin="0,0,0,7"/>
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click"
      MinWidth="70" Margin="0,0,7,0"/>
     <Button x:Name="ConfirmButton" Content="完成"
      Style="{StaticResource AtPrimaryButton}" Click="Confirm_Click" MinWidth="92"/>
     </StackPanel>
     <TextBlock Text="修改完成点击“完成”；“取消”放弃本次编辑。外部点击不会关闭窗口" Foreground="#43566B" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
    </DockPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
