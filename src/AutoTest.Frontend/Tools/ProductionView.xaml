<UserControl x:Class="AutoTest.Frontend.Tools.ProductionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Background="{StaticResource AT.Canvas}">
 <Grid Margin="13">
  <Grid.ColumnDefinitions><ColumnDefinition Width="440" MinWidth="320"/>
   <ColumnDefinition Width="*" MinWidth="400"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource AT.Panel}" Margin="0,0,10,0">
   <StackPanel>
    <TextBlock Text="生产工位" Style="{StaticResource AT.PageTitle}"/>
    <TextBlock Text="扫码是正式生产测试的启动方式；本轮只做 UI 设计。"
     Style="{StaticResource AT.Caption}" Margin="0,7,0,17"/>
    <Border Background="{StaticResource AT.SubtleSurface}" CornerRadius="8"
     BorderBrush="{StaticResource AT.Border}" BorderThickness="1"
     Padding="14" Margin="0,0,0,16">
     <StackPanel>
      <TextBlock Text="当前工程" Style="{StaticResource AT.FieldLabel}"/>
      <TextBlock Text="{Binding ProjectLabel}" FontWeight="SemiBold"/>
      <TextBlock Text="工位：未连接" Foreground="{StaticResource AT.Warning}"
       Margin="0,11,0,0"/>
     </StackPanel>
    </Border>
    <TextBlock Text="DUT 编号 / 扫码输入" Style="{StaticResource AT.FieldLabel}"/>
    <TextBox IsEnabled="False" Height="43"
     ToolTip="真实扫描验证与自动执行链暂未接入，不接收正式编号"/>
    <ui:Button Content="扫码后自动执行（未接入）" Appearance="Primary"
     IsEnabled="False" Margin="0,13,0,0" Padding="16,10"/>
    <Border Background="{StaticResource AT.AccentWash}" CornerRadius="8"
     Padding="12" Margin="0,22,0,0">
     <TextBlock Text="正式生产模式需根据编号匹配工程与资源、完成工位预检并依合同触发真实 Run；不使用工程师的临时选测范围。"
      Foreground="#326CA8" TextWrapping="Wrap" FontSize="11"/>
    </Border>
   </StackPanel>
  </Border>
  <Border Grid.Column="1" Style="{StaticResource AT.Panel}" Padding="0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/>
     <RowDefinition Height="230"/></Grid.RowDefinitions>
    <StackPanel Margin="16,14">
     <TextBlock Text="本次生产任务" Style="{StaticResource AT.PanelTitle}"/>
     <TextBlock Text="等待 DUT 编号和生产任务预检"
      FontSize="18" Foreground="{StaticResource AT.Muted}" Margin="0,12,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Background="White">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="没有正在运行的生产测试"
       FontSize="16" Foreground="{StaticResource AT.Muted}"/>
      <TextBlock Text="执行步骤、计时、合格状态与错误都必须来自真实 Run。"
       Style="{StaticResource AT.Caption}" Margin="0,11,0,0"/>
     </StackPanel>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource AT.Border}"
     BorderThickness="0,1,0,0">
     <TabControl>
      <TabItem Header="当次结果">
       <Grid Background="White">
        <TextBlock Text="尚无实际结果"
         Foreground="{StaticResource AT.Muted}" VerticalAlignment="Center"
         HorizontalAlignment="Center"/>
       </Grid>
      </TabItem>
      <TabItem Header="工位日志">
       <Grid Background="White">
        <TextBlock Text="尚无真实生产工位日志"
         Foreground="{StaticResource AT.Muted}" VerticalAlignment="Center"
         HorizontalAlignment="Center"/>
       </Grid>
      </TabItem>
      <TabItem Header="统计">
       <Grid Background="White">
        <TextBlock Text="真实生产与复测统计等待 RECORD 接入"
         Foreground="{StaticResource AT.Muted}" VerticalAlignment="Center"
         HorizontalAlignment="Center"/>
       </Grid>
      </TabItem>
     </TabControl>
    </Border>
   </Grid>
  </Border>
 </Grid>
</UserControl>
