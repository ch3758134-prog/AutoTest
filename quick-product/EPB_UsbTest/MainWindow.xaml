                                               KeyDown="FlowEditorList_KeyDown"
                                               SelectionChanged="FlowEditorList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                         <ListView.ItemTemplate>
                                             <DataTemplate>
                                                 <Grid Height="44" HorizontalAlignment="Stretch">
                                                     <Grid.RowDefinitions><RowDefinition Height="2"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                                                     <Border Grid.Row="0" Height="2" Background="#2F80ED" Visibility="{Binding IsInsertAnchor, Converter={StaticResource BoolToVisibility}}"/>
                                                     <Border Grid.Row="1" Panel.ZIndex="3" Height="2" VerticalAlignment="Bottom" Background="#2F80ED"
                                                             Visibility="{Binding IsDropAfter, Converter={StaticResource BoolToVisibility}}"/>
                                                     <Grid Grid.Row="1">
                                                         <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="198"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                                                         <TextBlock Grid.Column="0" Text="{Binding Number}" Foreground="#98A2B3" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         <Grid Grid.Column="1">
                                                             <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                             <ItemsControl Grid.Column="0" ItemsSource="{Binding IndentGuides}">
                                                                 <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                 <ItemsControl.ItemTemplate><DataTemplate><Border Width="18" BorderBrush="#D6E1EB" BorderThickness="1,0,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
                                                             </ItemsControl>
                                                             <Button Grid.Column="1" Tag="{Binding}" Content="{Binding ExpandGlyph}" Click="FlowRowToggle_Click" Width="20" Height="22" Padding="0" BorderThickness="0" Background="Transparent" Visibility="{Binding IsContainer, Converter={StaticResource BoolToVisibility}}" ToolTip="展开或折叠结构行"/>
                                                             <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                 <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                 <Border Grid.Column="0" Width="4" Height="16" Background="{Binding KindBrush}" CornerRadius="1" Margin="0,0,6,0"/>
                                                                 <Border Grid.Column="1" Background="{Binding KindBackground}" Padding="4,1" CornerRadius="2" Margin="6,0,6,0">
                                                                     <TextBlock Text="{Binding DisplayKind}" Foreground="{Binding KindBrush}" FontSize="11"/>
                                                                 </Border>
                                                                 <TextBlock Grid.Column="2" Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                             </Grid>
                                                         </Grid>
                                                         <TextBlock Grid.Column="2" Text="{Binding ParameterText}" ToolTip="{Binding ParameterText}" Margin="4,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                                         <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0">
                                                             <TextBlock Text="{Binding PathText}" ToolTip="{Binding PathText}" Foreground="#3C658D" FontSize="12"
                                                                        TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                                             <TextBlock Text="{Binding NoteText}" ToolTip="{Binding NoteText}" Foreground="{StaticResource Text2Brush}"
                                                                        FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                         </StackPanel>
                                                     </Grid>
                                                 </Grid>
                                             </DataTemplate>
                                         </ListView.ItemTemplate>
                                     </ListView>
                                     <TreeView x:Name="StepsTree" Visibility="Collapsed" ItemContainerStyle="{StaticResource StepTreeItemStyle}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.PanningMode="Both"
                                          AllowDrop="True" SelectedItemChanged="StepsTree_SelectedItemChanged"
                                          PreviewMouseLeftButtonDown="StepsTree_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="StepsTree_PreviewMouseLeftButtonUp"
                                          PreviewMouseMove="StepsTree_PreviewMouseMove" DragOver="StepsTree_DragOver" Drop="StepsTree_Drop"
                                          ContextMenuOpening="StepsTree_ContextMenuOpening" MouseDoubleClick="StepsTree_DoubleClick"
                                          RequestBringIntoView="Tree_RequestBringIntoView"/>
                                    <Border x:Name="StepsEmptyState" Tag="{Binding ElementName=StepsTree, Path=HasItems}" IsEnabled="{Binding ElementName=StepsTree, Path=IsVisible}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource EmptyStateCard}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False"/>
                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="暂无资源步骤" Style="{StaticResource EmptyStateTitle}"/>
                                            <TextBlock Text="在左侧资源树中选择或新建步骤后即可编辑。" Style="{StaticResource EmptyStateHint}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <GridSplitter Grid.Row="1" Grid.Column="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DDE6F0" ShowsPreview="True" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ToolTip="拖动调整步骤区与日志区高度"/>
                    <!-- 日志只占中间列，左侧用例列表从顶部连续到底部。 -->
                    <Border x:Name="SharedLogPanel" Grid.Row="2" Grid.Column="2" Style="{StaticResource QuickPanel}" Padding="12">
                        <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="执行日志" Style="{StaticResource QuickSectionTitle}"/>
                                        <TextBox x:Name="LogSearch" Width="150" Height="26" Margin="12,0,5,0" ToolTip="筛选执行日志" TextChanged="LogSearch_TextChanged"/>
                                        <ComboBox x:Name="LogLevelFilter" Width="82" Height="26" SelectedIndex="0" SelectionChanged="LogLevelFilter_SelectionChanged">
                                            <ComboBoxItem Content="全部"/><ComboBoxItem Content="错误"/><ComboBoxItem Content="信息"/>
                                        </ComboBox>
                                        <Button Content="清空" Click="ClearLog_Click" Padding="8,2" Margin="5,0,0,0"/>
                                        <Button x:Name="LogPanelToggleButton" Content="⌄" Click="LogPanelToggle_Click" Padding="6,1" Margin="7,0,0,0" ToolTip="折叠或展开测试日志"/>
                                    </StackPanel>
                                    <Grid>
                                        <ListView x:Name="LogRows" FontFamily="Consolas" FontSize="12" Background="White" AlternationCount="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                            <ListView.View>
                                                <GridView AllowsColumnReorder="False">
                                                    <GridViewColumn Header="时间" DisplayMemberBinding="{Binding Time}" Width="120"/>
                                                    <GridViewColumn Header="级别" DisplayMemberBinding="{Binding Level}" Width="70"/>
                                                    <GridViewColumn Header="来源" DisplayMemberBinding="{Binding Source}" Width="120"/>
                                                    <GridViewColumn Header="消息" DisplayMemberBinding="{Binding Message}" Width="520"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <Border x:Name="LogEmptyState" Tag="{Binding ElementName=LogRows, Path=Items.Count}" Panel.ZIndex="1">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource EmptyStateCard}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="暂无执行日志" Style="{StaticResource EmptyStateTitle}"/>
                                                <TextBlock Text="运行测试或执行操作后，过程信息会显示在这里。" Style="{StaticResource EmptyStateHint}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="1" Grid.Column="2" Width="8" HorizontalAlignment="Center" Background="#D9E2ED" ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

        <Border Grid.Row="1" Grid.Column="3" Margin="0,12,12,12" Style="{StaticResource QuickPanel}" Padding="12">
            <Grid>
                <Grid x:Name="QuickRightToolsGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="RightInspectorRow" Height="280" MinHeight="165"/>
                        <RowDefinition x:Name="RightInspectorSplitterRow" Height="6"/>
                        <RowDefinition Height="*" MinHeight="150"/>
                    </Grid.RowDefinitions>
                                 <Border x:Name="InspectorHost" Grid.Row="0" Grid.Column="0" Visibility="Visible" Background="#FAFCFF" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,0,4" Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Content="清除选择" Click="CloseInspectorPopup_Click" Padding="8,2" FontSize="11" Foreground="#63788F" Background="Transparent" BorderThickness="0" ToolTip="清除当前属性编辑对象，保留右侧面板"/>
                                            <Button x:Name="BackToReferenceButton" DockPanel.Dock="Right" Content="返回" Click="BackToReference_Click" Visibility="Collapsed" Padding="7,3" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="InspectorTitle" Text="步骤属性" Style="{StaticResource QuickSectionTitle}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <ScrollViewer x:Name="StepInspectorScrollViewer" Grid.Row="1" CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ContentControl x:Name="StepEditor">
                                                <StackPanel Margin="4,12" VerticalAlignment="Top">
                                                    <TextBlock Text="选择步骤以编辑参数" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="单击中央步骤行，可直接编辑 CAN 报文、判断条件、循环次数、保持时间等。"
                                                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Text2Brush}" Margin="0,8,0,0"/>
                                                    <TextBlock Text="右键步骤可插入、移动和重命名。无 USB 连接时仍可编辑并保存。"
                                                               TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="0,12,0,0"/>
                                                </StackPanel>
                                            </ContentControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                    <GridSplitter x:Name="InspectorGridSplitter" Grid.Row="1" Height="6"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True" Cursor="SizeNS" Background="#D9E2ED"
                                  Visibility="Visible" ToolTip="上下拖动调整步骤属性与 CAN 监控的高度"/>
                    <Grid x:Name="CanPanelContentGrid" Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="CAN1 · 实时监控" Style="{StaticResource QuickSectionTitle}"/>
                        <TextBlock Text="按 ID 汇总" FontSize="11" Foreground="{StaticResource Text2Brush}" Margin="8,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RawPauseButton" Content="Ⅱ 暂停" Click="RawPause_Click" Padding="8,3" Margin="4,0,0,0" ToolTip="冻结右侧显示，不影响 ECU 报文接收和自动测试"/>
                        <Button Content="清空" Click="RawClear_Click" Padding="8,3" Margin="4,0,0,0" ToolTip="清除当前右侧列表，不影响报文接收"/>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="RawGrid" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F7F9FD" ClipboardCopyMode="IncludeHeader" FontFamily="Consolas" FontSize="12" HeadersVisibility="Column" CanUserResizeRows="False" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" GridLinesVisibility="Horizontal" RowHeight="30" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="105"/>
                            <DataGridTextColumn Header="数据" Binding="{Binding Data}" Width="*"/>
                            <DataGridTextColumn Header="周期" Binding="{Binding Period}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="RawEmptyState" Tag="{Binding ElementName=RawGrid, Path=HasItems}" Panel.ZIndex="1">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource EmptyStateCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="暂无 CAN1 报文" Style="{StaticResource EmptyStateTitle}"/>
                            <TextBlock Text="连接主控板并等待报文接收后，实时数据会显示在这里。" Style="{StaticResource EmptyStateHint}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                </Grid>
                </Grid>
                <Button x:Name="CanPanelExpandButton" Content="›" Click="CanPanelToggle_Click" Width="24" Height="28" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" ToolTip="展开 CAN 观察"/>
            </Grid>
        </Border>

    </Grid>
</Window>
