<UserControl x:Class="AutoTest.Desktop.Shell.ProjectOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,0">
    <Button DockPanel.Dock="Right" Content="新建空白工程" Command="{Binding NewProjectCommand}"
     FontSize="11" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="工程工作区" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Border Background="#E8F1FD" BorderBrush="#C8DEF9" BorderThickness="1"
      Padding="6,2" CornerRadius="4" Margin="10,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="当前工程" FontSize="10" Foreground="#2368BD"/>
     </Border>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="15,13,15,13">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="11"/>
      <ColumnDefinition Width="*"/><ColumnDefinition Width="11"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Button Grid.Column="0" Command="{Binding OpenFirstTestProjectCommand}"
      Height="136" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
      Background="White" BorderBrush="#DBE3ED" Padding="16,11">
      <StackPanel>
       <TextBlock Text="▣  测试项目" FontSize="11" Foreground="#64758C" Margin="0,0,0,13"/>
       <TextBlock Text="{Binding TestProjectCount,StringFormat='{}{0} 个'}" FontSize="18"
        Foreground="#2368BD" FontWeight="Bold" Margin="0,0,0,11"/>
       <TextBlock Text="组织测试用例，勾选当次运行" FontSize="11" Foreground="#64758C"
        TextWrapping="Wrap"/>
      </StackPanel>
     </Button>
     <Button Grid.Column="2" Command="{Binding OpenFirstTestProgramCommand}"
      Height="136" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
      Background="White" BorderBrush="#DBE3ED" Padding="16,11">
      <StackPanel>
       <TextBlock Text="▤  测试用例" FontSize="11" Foreground="#64758C" Margin="0,0,0,13"/>
       <TextBlock Text="{Binding TestProgramCount,StringFormat='{}{0} 个'}" FontSize="18"
        Foreground="#2368BD" FontWeight="Bold" Margin="0,0,0,11"/>
       <TextBlock Text="步骤、流程与断言编辑" FontSize="11" Foreground="#64758C"
        TextWrapping="Wrap"/>
      </StackPanel>
     </Button>
     <Button Grid.Column="4" Command="{Binding OpenProjectConfigurationOverviewCommand}"
      Height="136" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
      Background="White" BorderBrush="#DBE3ED" Padding="16,11">
      <StackPanel>
       <TextBlock Text="⚙  已登记的工程资源" FontSize="11" Foreground="#64758C" Margin="0,0,0,13"/>
       <TextBlock Text="{Binding ConfigurationCount,StringFormat='{}{0} 项资源'}" FontSize="18"
        Foreground="#2368BD" FontWeight="Bold" Margin="0,0,0,11"/>
       <TextBlock Text="DBC、固件、波形与检测工艺" FontSize="11" Foreground="#64758C"
        TextWrapping="Wrap"/>
      </StackPanel>
     </Button>
    </Grid>
    <Border Background="#EDF5FF" BorderBrush="#CBDEF5" BorderThickness="1"
     CornerRadius="7" Padding="14,12" Margin="0,14,0,0">
     <Border.Style>
      <Style TargetType="{x:Type Border}">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding TestProjectCount}" Value="0">
         <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </Border.Style>
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="建立项目并直接编辑空白用例"
       Command="{Binding CreateStarterProjectCommand}"
       Style="{StaticResource AtPrimaryButton}" Margin="12,0,0,0"
       VerticalAlignment="Center"/>
      <StackPanel>
       <TextBlock Text="开始编写第一个自动测试" FontWeight="SemiBold" FontSize="13"
        Foreground="#245B96" Margin="0,0,0,5"/>
       <TextBlock Text="创建真实测试项目和一条空白 TEST 用例，直接进入准备／测试／清理编辑器；不会生成任何模拟步骤。"
        Foreground="#597491" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <WrapPanel Margin="0,15,0,0">
     <Button Content="打开手动台架" IsEnabled="False"
      ToolTip="完整手动工位界面尚未接入实体安全服务" Margin="0,0,8,7"/>
     <Button Content="波形分析" IsEnabled="False"
      ToolTip="波形专项工作台尚未完成统一接线" Margin="0,0,8,7"/>
     <Button Content="UDS 服务" IsEnabled="False"
      ToolTip="独立 UDS 工具待后续专项集成" Margin="0,0,8,7"/>
     <Button Content="生产入口" IsEnabled="False"
      ToolTip="尚无真实项目级 Run，生产入口被安全阻断" Margin="0,0,8,7"/>
    </WrapPanel>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
