<UserControl x:Class="AutoTest.Desktop.Testing.RunMonitorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel>
   <TextBlock Text="TEST PREPARE / MOCK EXECUTION" Foreground="{StaticResource Subtle}" FontSize="11"/>
   <TextBlock Text="{Binding RequestStatus}" FontWeight="SemiBold" Margin="0,6,0,0"/>
   <TextBlock Text="{Binding AckStatus}"/><TextBlock Text="{Binding ObservationStatus}"/>
   <TextBlock Text="{Binding Verdict}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
   <WrapPanel Margin="0,8,0,0"><Button Content="暂停" Command="{Binding PauseCommand}"/>
    <Button Content="继续" Command="{Binding ResumeCommand}"/><Button Content="单步" Command="{Binding StepCommand}"/>
    <Button Content="停止" Command="{Binding StopCommand}"/></WrapPanel>
  </StackPanel>
  <DockPanel Grid.Column="1">
   <TextBlock DockPanel.Dock="Top" Text="MOCK / Simulated StepFact · Expected / Actual / Quality / Verdict" Foreground="{StaticResource Subtle}"/>
   <TextBlock DockPanel.Dock="Bottom" Text="{Binding FailureReason}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
   <ListBox ItemsSource="{Binding FactLines}" FontFamily="Consolas" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
  </DockPanel>
 </Grid>
</UserControl>
