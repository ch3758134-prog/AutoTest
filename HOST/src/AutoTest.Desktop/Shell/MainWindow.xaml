<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:navigation="clr-namespace:AutoTest.Desktop.Shell.Navigation"
 Title="{Binding WindowTitle}" Width="1530" Height="880" MinWidth="820" MinHeight="455"
 WindowStartupLocation="CenterScreen" WindowState="Maximized" WindowStyle="None"
 PreviewKeyDown="Window_PreviewKeyDown"
 ResizeMode="CanResize" Background="#F6F7F8" Foreground="#252C34"
 FontFamily="{StaticResource UiFont}" FontSize="14"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <chrome:WindowChrome.WindowChrome>
  <chrome:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
   CornerRadius="0" UseAeroCaptionButtons="False"/>
 </chrome:WindowChrome.WindowChrome>
 <Window.InputBindings>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveActiveCommand}"/>
 </Window.InputBindings>
 <Window.Resources>
  <Style x:Key="ChromeButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AtQuietButton}">
   <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="Width" Value="40"/><Setter Property="Height" Value="36"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="#64758C"/>
  </Style>
  <Style x:Key="DocumentTabItem" TargetType="{x:Type TabItem}">
   <Setter Property="MinWidth" Value="100"/><Setter Property="MaxWidth" Value="220"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
     <Border x:Name="TabSurface" Height="34" Background="{TemplateBinding Background}"
      BorderBrush="#E1E5E9" BorderThickness="0,0,1,0" Padding="9,0">
      <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="TabSurface" Property="Background" Value="White"/>
       <Setter TargetName="TabSurface" Property="BorderBrush" Value="#3478D6"/>
       <Setter TargetName="TabSurface" Property="BorderThickness" Value="0,0,0,2"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="TabSurface" Property="Background" Value="#F8FBF9"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>

  </Style>
  <Style x:Key="ObservationTabItem" TargetType="{x:Type TabItem}">
   <Setter Property="Padding" Value="9,0"/><Setter Property="Height" Value="29"/>
   <Setter Property="Foreground" Value="#64758C"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
     <Border x:Name="Line" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
      Padding="{TemplateBinding Padding}">
      <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="Line" Property="BorderBrush" Value="#3478D6"/>
       <Setter Property="Foreground" Value="#3478D6"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter TargetName="Line" Property="Background" Value="White"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Line" Property="Background" Value="#F2F8F5"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid Background="#F6F7F8">
  <Grid.RowDefinitions><RowDefinition Height="41"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- A single desktop-native 38px caption and IDE menu; no second OS titlebar. -->
  <Border Grid.Row="0" Background="White" BorderBrush="#E1E5E9" BorderThickness="0,0,0,1">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
     chrome:WindowChrome.IsHitTestVisibleInChrome="True">
     <TextBlock Text="{Binding MainUsbDisplay}" FontSize="13" FontWeight="SemiBold"
      ToolTip="{Binding HardwareStatus}" Foreground="#345B76"
      VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis"
      Margin="0,0,10,0">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsCompactShell}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <Button Content="─" Style="{StaticResource ChromeButton}" ToolTip="最小化"
      chrome:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
     <Button Content="□" Style="{StaticResource ChromeButton}" ToolTip="最大化／还原"
      chrome:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click"/>
     <Button Content="×" Style="{StaticResource ChromeButton}" ToolTip="关闭"
      chrome:WindowChrome.IsHitTestVisibleInChrome="True"
      Foreground="#A43845" FontSize="19" Click="Close_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="9,0,15,0"
     VerticalAlignment="Center" chrome:WindowChrome.IsHitTestVisibleInChrome="True">
     <Border Width="23" Height="23" CornerRadius="6" Background="#3478D6">
      <TextBlock Text="AT" Foreground="White" FontSize="11" FontWeight="Bold"
       VerticalAlignment="Center" HorizontalAlignment="Center"/>
     </Border>
     <TextBlock Text="AutoTest" Margin="7,0,0,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

    </StackPanel>
    <!-- Primary tasks. Production and engineering share the real station,
         scanner and TEST/FLASH execution services; RECORD is a direct task. -->
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="10,0,8,0"
     VerticalAlignment="Center" chrome:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button Content="生产检测" Command="{Binding ShowProductionWorkspaceCommand}"
      Padding="15,5" Margin="0,0,4,0" FontSize="13" FontWeight="SemiBold"
      ToolTip="扫码识别 ECU，查看真实生产流程和结果">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource AtQuietButton}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsProductionWorkspace}" Value="True">
          <Setter Property="Background" Value="#E6F1FD"/>
          <Setter Property="Foreground" Value="#185FAD"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
     </Button>
     <Button Content="测试工程" Command="{Binding ShowEngineerWorkspaceCommand}"
      Padding="15,5" Margin="0,0,4,0" FontSize="13" FontWeight="SemiBold"
      ToolTip="编辑工程和用例，在真实工位调试测试步骤">
      <Button.Style>
       <Style TargetType="Button" BasedOn="{StaticResource AtQuietButton}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsEngineerWorkspace}" Value="True">
          <Setter Property="Background" Value="#E6F1FD"/>
          <Setter Property="Foreground" Value="#185FAD"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </Button.Style>
     </Button>
     <Button Content="检测记录" Command="{Binding OpenRecordHistoryCommand}"
      Style="{StaticResource AtQuietButton}" FontSize="13"
      Padding="15,5" ToolTip="按完整扫码编号查询历次检测、证据和报告"/>
    </StackPanel>
    <Menu Background="Transparent" VerticalAlignment="Center" FontSize="13"
     Visibility="{Binding IsEngineerWorkspace,Converter={StaticResource BoolToVisibility}}"
     chrome:WindowChrome.IsHitTestVisibleInChrome="True">
     <MenuItem Header="文件">
      <MenuItem Header="新建工程" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
      <MenuItem Header="打开工程" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
      <MenuItem Header="重命名当前工程" Command="{Binding RenameProjectCommand}"/>
      <MenuItem Header="保存修改" Command="{Binding SaveActiveCommand}" InputGestureText="Ctrl+S"/>
      <Separator/>
      <MenuItem Header="工程资源…" Command="{Binding OpenEngineeringResourcesCommand}"/>
      <MenuItem Header="调整测试顺序" Command="{Binding OpenFirstTestProjectCommand}"/>
      <MenuItem Header="新建测试用例" Command="{Binding NewTestProgramCommand}"/>
      <Separator/>
      <MenuItem Header="退出" Click="Exit_Click" InputGestureText="Alt+F4"/>
     </MenuItem>
     <MenuItem Header="编辑">
      <MenuItem Header="撤销" Command="{Binding UndoActiveCommand}" InputGestureText="Ctrl+Z"/>
      <MenuItem Header="重做" Command="{Binding RedoActiveCommand}" InputGestureText="Ctrl+Y"/>
      <Separator/>
      <MenuItem Header="重命名测试用例/公共流程" Command="{Binding RenameResourceCommand}" InputGestureText="F2"/>
      <MenuItem Header="重命名当前 DBC" Command="{Binding RenameCurrentDbcCommand}"/>
      <MenuItem Header="移除工程引用（保留源文件）" Command="{Binding RemoveReferenceCommand}"/>
     </MenuItem>
     <MenuItem Header="调试">
      <MenuItem Header="当前内容运行条件检查" Command="{Binding CheckActiveCommand}"/>
      <MenuItem Header="整套工程实测…" Command="{Binding EnterEngineeringVerificationCommand}"/>
      <Separator/>
      <MenuItem Header="显示／隐藏实时观察" Click="ToggleBottom_Click"/>
      <MenuItem Header="显示／隐藏参数面板" Click="ToggleInspector_Click"/>
     </MenuItem>
     <MenuItem Header="工具">
      <MenuItem Header="手动台架" Command="{Binding OpenManualBenchCommand}"/>
      <Separator/>
      <MenuItem Header="UDS 诊断" Command="{Binding OpenUdsWorkbenchCommand}"/>
      <MenuItem Header="独立烧录调试" Command="{Binding OpenFlashWorkbenchCommand}"/>
      <MenuItem Header="新建独立 DBC…" Command="{Binding NewIndependentDbcCommand}"/>
      <MenuItem Header="打开独立 DBC…" Command="{Binding OpenIndependentDbcCommand}"/>
      <MenuItem Header="导入／替换工程 DBC…" Command="{Binding ImportDbcCommand}"/>
      <Separator/>
      <MenuItem Header="波形采集与分析" Command="{Binding OpenWaveWorkbenchCommand}"/>
      <MenuItem Header="工程 DBC 编辑" Command="{Binding OpenDbcToolCommand}"/>
     </MenuItem>
    </Menu>
    <Menu Background="Transparent" VerticalAlignment="Center" FontSize="13"
     chrome:WindowChrome.IsHitTestVisibleInChrome="True">
     <MenuItem Header="设置">
      <MenuItem Header="扫码标记与工程匹配…" Command="{Binding OpenProductionProjectLibraryCommand}"/>
      <MenuItem Header="扫码枪连接诊断…" Command="{Binding OpenSerialScannerCommand}"/>
     </MenuItem>
     <MenuItem Header="帮助" Command="{Binding HelpCommand}"/>
    </Menu>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Height="49" Background="#FFFFFF"
   BorderBrush="#DFE7F1" BorderThickness="0,0,0,1"
   Visibility="{Binding IsEngineerWorkspace,Converter={StaticResource BoolToVisibility}}">
   <DockPanel LastChildFill="False" Margin="12,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="检查工程" Command="{Binding OpenProjectConfigurationOverviewCommand}"
      Style="{StaticResource AtQuietButton}" Margin="0,0,8,0" Padding="9,5"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="{Binding CurrentProjectName}" Command="{Binding RenameProjectCommand}"
      Style="{StaticResource AtQuietButton}" FontSize="15" FontWeight="SemiBold"
      Foreground="#21384F" VerticalAlignment="Center" MaxWidth="220"
      ToolTip="单击重命名工程；工程身份和已保存测试内容不会改变"/>
     <Border Width="1" Height="21" Background="#DEE7F1" Margin="13,0,9,0"/>
     <Button Content="工程资源" Command="{Binding OpenEngineeringResourcesCommand}"
      Style="{StaticResource AtQuietButton}" Margin="0,0,8,0" Padding="10,5"
      ToolTip="查看当前 DBC、标准波形、公共流程与烧录参数，在各自的专业环境中编辑"/>
     <Button Content="DBC" Command="{Binding OpenDbcToolCommand}"
      Style="{StaticResource AtQuietButton}" Margin="0,0,5,0" Padding="9,5"
      ToolTip="编辑当前工程的 DBC 文件"/>
     <Button Content="波形" Command="{Binding OpenWaveWorkbenchCommand}"
      Style="{StaticResource AtQuietButton}" Margin="0,0,5,0" Padding="9,5"
      ToolTip="进入实时采集、建立标准与比较分析工作台"/>
     <Button Content="FLASH" Command="{Binding OpenNativeFlashProfileCommand}"
      Style="{StaticResource AtQuietButton}" Margin="0,0,5,0" Padding="9,5"
      ToolTip="编辑当前工程的 HEX 和 ECU 烧录参数"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="2" Background="#FFFFFF"
   Visibility="{Binding IsEngineerWorkspace,Converter={StaticResource BoolToVisibility}}">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="TreeColumn" Width="266" MinWidth="210" MaxWidth="365"/>
    <ColumnDefinition Width="4"/>
    <ColumnDefinition Width="*" MinWidth="460"/>
   </Grid.ColumnDefinitions>
   <navigation:ProjectExplorerView Grid.Column="0"/>
   <GridSplitter Grid.Column="1" Background="#EDF2F7" ResizeDirection="Columns"
    HorizontalAlignment="Stretch" ShowsPreview="True"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- A focused work surface, not a second IDE tab strip. A compact
         document switcher remains available for editing several definitions. -->
    <Border Grid.Row="0" Height="38" Background="#F6F9FC"
     BorderBrush="#E1E7EE" BorderThickness="0,0,0,1"
     Visibility="{Binding HasActiveEditor,Converter={StaticResource BoolToVisibility}}">
     <DockPanel Margin="10,0" LastChildFill="True">
      <ComboBox DockPanel.Dock="Right" Width="220" Height="28"
       Margin="7,4,5,4" VerticalAlignment="Center"
       ItemsSource="{Binding OpenEditors}" DisplayMemberPath="Title"
       SelectedItem="{Binding ActiveEditorTab,Mode=TwoWay}"
       ToolTip="切换已打开的测试用例、公共流程或检查内容"/>
      <Button DockPanel.Dock="Right" Content="返回用例"
       Command="{Binding ReturnToTestCommand}"
       Style="{StaticResource AtQuietButton}" Padding="8,3" Margin="0,4,7,4"
       ToolTip="返回上次编辑的 TEST 用例，保留原编辑上下文"/>
      <Button DockPanel.Dock="Right" Content="关闭当前"
       Tag="{Binding ActiveEditorTab}" Click="CloseEditorTab_Click"
       Style="{StaticResource AtQuietButton}" Margin="0,4,6,4"
       Padding="8,3" ToolTip="关闭当前编辑内容，不删除工程资源"/>
      <TextBlock Text="{Binding ActiveEditorTitle}" FontSize="13"
       FontWeight="SemiBold" Foreground="#3B536C" VerticalAlignment="Center"
       TextTrimming="CharacterEllipsis" Margin="3,0,8,0"/>
      <!-- Keep the native TabControl selection event contract for draft
           validation while removing its visible multirow chrome. -->
      <TabControl x:Name="DocumentTabs" Visibility="Collapsed"
       ItemsSource="{Binding OpenEditors}"
       SelectedItem="{Binding ActiveEditorTab,Mode=TwoWay}"
       SelectionChanged="DocumentTabs_SelectionChanged"/>
     </DockPanel>
    </Border>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="400"/>
      <ColumnDefinition x:Name="InspectorSplitterColumn" Width="4"/>
      <ColumnDefinition x:Name="InspectorColumn" Width="410" MinWidth="0" MaxWidth="520"/>
     </Grid.ColumnDefinitions>
     <Grid Grid.Column="0">
      <Grid.RowDefinitions>
       <RowDefinition Height="*" MinHeight="180"/>
       <RowDefinition x:Name="BottomSplitterRow" Height="4"/>
       <RowDefinition x:Name="BottomRow" Height="145" MinHeight="0"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="White">
       <ContentControl Content="{Binding ActiveEditorView}"
        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
       <!-- Only real project state decides the next action. No fake resources or persisted steps. -->
       <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
        MaxWidth="510" Margin="30,22"
        Visibility="{Binding NoOpenEditors,Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding StartTitle}" FontWeight="SemiBold" FontSize="18"
         Foreground="#3E5155" Margin="0,0,0,9"/>
        <TextBlock Text="{Binding StartDescription}" FontSize="12" Foreground="#647A93"
         TextWrapping="Wrap" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal">
         <Button Content="{Binding StartPrimaryLabel}" Command="{Binding StartPrimaryCommand}"
          Style="{StaticResource AtPrimaryButton}" Padding="18,9" MinWidth="142" Margin="0,0,12,0"/>
         <Button Content="{Binding StartSecondaryLabel}" Command="{Binding StartSecondaryCommand}"
          Visibility="{Binding ShowStartSecondary,Converter={StaticResource BoolToVisibility}}"
          Padding="14,8" MinWidth="100"/>
        </StackPanel>
       </StackPanel>
      </Grid>
      <GridSplitter Grid.Row="1" Background="#E4E8E9" HorizontalAlignment="Stretch"
       ResizeDirection="Rows" ShowsPreview="True"/>
      <!-- Observation is collapsible and shows only real execution evidence. -->
      <Grid Grid.Row="2" Background="#FAFBFB">
       <TabControl BorderThickness="0" Background="#FAFBFB" FontSize="11"
        ItemContainerStyle="{StaticResource ObservationTabItem}">
        <TabControl.Template>
         <ControlTemplate TargetType="{x:Type TabControl}">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <Border Grid.Row="0" Background="#FAFBFB" BorderBrush="#E1E5E9"
            BorderThickness="0,0,0,1">
            <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
           </Border>
           <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
            ContentSource="SelectedContent"/>
          </Grid>
         </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="运行时间线">
         <DataGrid ItemsSource="{Binding ActiveEditorTab.Editor.RunFactRows}" AutoGenerateColumns="False"
          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
          RowHeaderWidth="0" RowHeight="25" BorderThickness="0">
          <DataGrid.Columns>
           <DataGridTextColumn Header="步骤" Binding="{Binding Type}" Width="105"/>
           <DataGridTextColumn Header="实际状态" Binding="{Binding Status}" Width="100"/>
           <DataGridTextColumn Header="实际数据" Binding="{Binding Actual}" Width="180"/>
           <DataGridTextColumn Header="证据／说明" Binding="{Binding Detail}" Width="*"/>
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
        <TabItem Header="CAN 事件">
         <DataGrid ItemsSource="{Binding CanRecords}" AutoGenerateColumns="False"
          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
          RowHeaderWidth="0" RowHeight="25" BorderThickness="0">
          <DataGrid.Columns>
           <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="105"/>
           <DataGridTextColumn Header="通道" Binding="{Binding Port}" Width="116"/>
           <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="85"/>
           <DataGridTextColumn Header="帧字节" Binding="{Binding Data}" Width="*"/>
          </DataGrid.Columns>
         </DataGrid>
        </TabItem>
        <!-- Variable inspection will return only with a real engine-backed
             variable observation model; no static pretend panel. -->
        <TabItem Header="问题列表">
         <TextBlock Margin="13" Foreground="#9B6A22" TextWrapping="Wrap"
          Text="{Binding ActiveEditorTab.Editor.StatusMessage}"/>
        </TabItem>
        <TabItem Header="设备状态">
         <StackPanel Margin="13">
          <TextBlock Text="{Binding HardwareStatus}" Foreground="#9B6A22" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ScanStatus}" Foreground="#64758C"
           TextWrapping="Wrap" Margin="0,7,0,0"/>
         </StackPanel>
        </TabItem>
       </TabControl>
       <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Width="24"
        Height="24" MinWidth="0" MinHeight="0" Margin="0,3,8,0"
        Style="{StaticResource AtQuietButton}" ToolTip="隐藏观察区"
        Click="ToggleBottom_Click"/>
      </Grid>
     </Grid>
     <GridSplitter Grid.Column="1" ResizeDirection="Columns"
      Background="#EDF2F7" HorizontalAlignment="Stretch" ShowsPreview="True"/>
     <Grid Grid.Column="2" Background="#FAFBFB">
      <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FAFBFB" BorderBrush="#E1E5E9" BorderThickness="0,0,0,1">
       <DockPanel Margin="12,0">
        <Button DockPanel.Dock="Right" Content="×" Click="ToggleInspector_Click"
         Width="24" Height="24" MinWidth="0" MinHeight="0" Style="{StaticResource AtQuietButton}"
         VerticalAlignment="Center" ToolTip="隐藏属性"/>
        <TextBlock Text="{Binding InspectorHeading}" FontSize="12" FontWeight="SemiBold"
         VerticalAlignment="Center"/>
       </DockPanel>
      </Border>
      <ContentControl Grid.Row="1" Content="{Binding ActiveEditorInspector}"
       HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     </Grid>
    </Grid>
   </Grid>
  </Grid>

  <ContentControl Grid.Row="2" Content="{Binding AutomaticTestView}"
   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
   Visibility="{Binding IsProductionWorkspace,Converter={StaticResource BoolToVisibility}}"/>

  <Border Grid.Row="3" Height="38" Background="#F8FAFA" BorderBrush="#E1E6E8" BorderThickness="0,1,0,0"
   Visibility="{Binding IsEngineerWorkspace,Converter={StaticResource BoolToVisibility}}">
   <DockPanel Margin="11,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

     <Button Content="日志" Click="ToggleBottom_Click"
      Foreground="{StaticResource Ink}" Background="Transparent" BorderThickness="0"
      MinWidth="44" MinHeight="26" Height="26" Padding="2,0" FontSize="12" Margin="0,0,3,0"/>
     <Button Content="属性" Click="ToggleInspector_Click"
      Foreground="{StaticResource Ink}" Background="Transparent" BorderThickness="0"
      MinWidth="44" MinHeight="26" Height="26" Padding="2,0" FontSize="12" Margin="0"/>
    </StackPanel>
    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Ink}" FontSize="13"
     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
