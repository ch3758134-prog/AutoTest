<UserControl x:Class="AutoTest.Desktop.Tools.Flash.FlashToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    FontFamily="Segoe UI" FontSize="13" Background="#F2F5F9">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="29"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,2,7,2"/>
            <Setter Property="MinHeight" Value="31"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5F7084"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#18314B"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#172C43" Padding="18,12">
            <StackPanel>
                <TextBlock Text="FLASH  /  编程与镜像验证工作台" Foreground="White"
                           FontWeight="Bold" FontSize="18"/>
                <TextBlock Text="Mock Bootloader · Dry-run · 禁止物理 ECU 擦写 · 结果不计作实际刷写成功"
                           Foreground="#F8CB81" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="325"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1"
                    CornerRadius="5" Padding="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="固件镜像" Style="{StaticResource Heading}"/>
                        <TextBlock Text="HEX / S19 / BIN 文件路径" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding ImagePath,UpdateSourceTrigger=PropertyChanged}"/>
                        <WrapPanel>
                            <Button Content="选择文件…" Click="BrowseImage_Click"/>
                            <Button Content="解析镜像" Command="{Binding LoadCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="BIN 基地址 (HEX)" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        <TextBox Text="{Binding BinAddress,UpdateSourceTrigger=PropertyChanged}"/>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="ECU / Mock Boot 配置" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Target / 型号" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="期望 ECU 身份" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding ExpectedIdentity,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Mock 返回 ECU 身份" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding ObservedIdentity,UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="允许地址起点 (HEX)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding AllowedStart,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="终点 exclusive (HEX)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding AllowedEnd,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="电压 (模拟)" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding MockVoltage,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="最小 V" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding VoltageMin,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="最大 V" Style="{StaticResource Caption}"/>
                                <TextBox Text="{Binding VoltageMax,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        </Grid>
                        <TextBlock Text="传输块字节数" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding ChunkSize,UpdateSourceTrigger=PropertyChanged}"/>
                        <Separator Margin="0,12"/>
                        <TextBlock Text="故障注入（可选）" Style="{StaticResource Heading}"/>
                        <TextBlock Text="失败 SID (HEX)，如 36" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding FaultSid,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="返回 NRC (HEX)，如 72" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding FaultNrc,UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="传输前断开：第 N 块" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding DropBlock,UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#D7E0EA" BorderThickness="1"
                        CornerRadius="5" Padding="14">
                    <StackPanel>
                        <TextBlock Text="镜像信息与地址段" Style="{StaticResource Heading}"/>
                        <WrapPanel>
                            <TextBlock Text="Format: " Foreground="#5F7084"/>
                            <TextBlock Text="{Binding Format}" FontWeight="SemiBold" Margin="0,0,14,0"/>
                            <TextBlock Text="Bytes: " Foreground="#5F7084"/>
                            <TextBlock Text="{Binding Bytes}" FontWeight="SemiBold"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Hash}" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,10"/>
                        <DataGrid ItemsSource="{Binding Segments}" IsReadOnly="True"
                                  AutoGenerateColumns="False" CanUserAddRows="False" Height="110" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Start" Binding="{Binding Start}" Width="*"/>
                                <DataGridTextColumn Header="End (exclusive)" Binding="{Binding EndExclusive}" Width="*"/>
                                <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="White" Margin="0,11,0,11"
                        BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="5" Padding="14">
                    <StackPanel>
                        <TextBlock Text="编程预检 / 运行" Style="{StaticResource Heading}"/>
                        <WrapPanel>
                            <Button Content="预检 (Mock)" Command="{Binding PreflightCommand}"/>
                            <Button Content="▶ Dry-run" Command="{Binding StartCommand}"/>
                            <Button Content="■ 请求取消" Command="{Binding CancelCommand}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,5,0,4">
                            <TextBlock Text="预检: " Foreground="#5F7084"/>
                            <TextBlock Text="{Binding Preflight}" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Text="阶段/进度: " Foreground="#5F7084"/>
                            <TextBlock Text="{Binding Progress}" FontWeight="SemiBold"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,3,0,5">
                            <TextBlock Text="已确认字节: " Foreground="#5F7084"/>
                            <TextBlock Text="{Binding ConfirmedBytes}" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Text="最后 ACK 块: " Foreground="#5F7084"/>
                            <TextBlock Text="{Binding LastAcknowledgedBlock}" FontWeight="SemiBold"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Failure}" TextWrapping="Wrap" Foreground="#AA422F"/>
                        <TextBlock Text="{Binding RecoveryAdvice}" TextWrapping="Wrap"
                                   Foreground="#667B8F" Margin="0,4,0,0"/>
                        <WrapPanel Margin="0,7,0,0">
                            <TextBox Width="310" ToolTip="模拟作业审计 JSON 输出路径"
                                     Text="{Binding AuditPath,UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="导出 Mock 审计" Command="{Binding ExportAuditCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Background="White" BorderBrush="#D7E0EA"
                        BorderThickness="1" CornerRadius="5" Padding="13">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Mock 作业阶段与 UDS 协议诊断证据"
                                       Style="{StaticResource Heading}"/>
                            <WrapPanel>
                                <TextBlock Text="{Binding TraceQuality}" Foreground="#8B4428"
                                           FontSize="11" VerticalAlignment="Center"/>
                                <Button Content="复制 UDS 证据" Command="{Binding CopyTraceCommand}"
                                        Margin="10,0,0,3"/>
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Job}" DockPanel.Dock="Bottom"
                                   FontSize="11" FontFamily="Consolas" Foreground="#718195"/>
                        <TabControl>
                            <TabItem Header="编程阶段 / 进度">
                                <ListBox ItemsSource="{Binding Stages}" BorderThickness="0"
                                         FontSize="12" FontFamily="Consolas"/>
                            </TabItem>
                            <TabItem Header="UDS TX/RX / Correlation">
                                <ListBox ItemsSource="{Binding DiagnosticTrace}" BorderThickness="0"
                                         FontSize="12" FontFamily="Consolas"/>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#DEE7EF" Padding="14,9">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SourceLabel}" Foreground="#8B4428"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
