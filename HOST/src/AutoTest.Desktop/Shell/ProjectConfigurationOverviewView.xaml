<UserControl x:Class="AutoTest.Desktop.Shell.ProjectConfigurationOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="12" Background="White">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#DBE3ED" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,0">
    <Button DockPanel.Dock="Right" Content="检查当前工程"
     Command="{Binding CheckActiveCommand}" Margin="0,0,0,0"
     VerticalAlignment="Center"/>
    <TextBlock Text="工程配置" FontSize="14" FontWeight="SemiBold"
     VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <TabControl x:Name="ConfigTabs" Grid.Row="1" Background="White" BorderThickness="0" Padding="0">
   <TabControl.Resources>
    <Style TargetType="{x:Type TabItem}">
     <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
     <Setter Property="FontSize" Value="11"/>
     <Setter Property="Foreground" Value="#64758C"/>
     <Setter Property="Template">
      <Setter.Value>
       <ControlTemplate TargetType="{x:Type TabItem}">
        <Border x:Name="TabLine" Height="35" Background="#FBFCFF"
         BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="13,0">
         <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsSelected" Value="True">
          <Setter TargetName="TabLine" Property="BorderBrush" Value="#2368BD"/>
          <Setter TargetName="TabLine" Property="Background" Value="White"/>
          <Setter Property="Foreground" Value="#1C5DA8"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
         </Trigger>
         <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="TabLine" Property="Background" Value="#F0F5FB"/>
         </Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
   </TabControl.Resources>
   <TabControl.Template>
    <ControlTemplate TargetType="{x:Type TabControl}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FBFCFF" BorderBrush="#DBE3ED"
       BorderThickness="0,0,0,1">
       <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
      </Border>
      <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
       ContentSource="SelectedContent"/>
     </Grid>
    </ControlTemplate>
   </TabControl.Template>
   <TabItem Header="DUT 配置">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="12,4">
      <Button DockPanel.Dock="Right" Content="创建／打开 TCF"
       Command="{Binding OpenTcfCommand}"/>
      <TextBlock Text="ECU 与 DBC 资源"
       FontSize="11" Foreground="#64758C" VerticalAlignment="Center"/>
     </DockPanel>
     <ContentControl x:Name="DutFormHost" Grid.Row="1"
      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
   </TabItem>
   <TabItem Header="工位状态">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="12,4">
      <Button DockPanel.Dock="Right" Content="创建／打开 TBC"
       Command="{Binding OpenTbcCommand}"/>
      <TextBlock Text="固定台架：ECU CAN（A1/A12）／KEY CAN（B1/B11）"
       Foreground="#64758C" FontSize="11" VerticalAlignment="Center"/>
     </DockPanel>
     <ContentControl x:Name="BenchFormHost" Grid.Row="1"
      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
   </TabItem>
    <TabItem Header="扫码与烧录">
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="18,15,18,20" MaxWidth="950">
       <TextBlock Text="工位扫码与工程原生烧录" FontSize="15"
        Foreground="{StaticResource Ink}" FontWeight="SemiBold"/>
       <TextBlock Text="扫码设备、条码解释和型号登记属于工位配置；DBC、TEST 项目、固件与烧录参数属于 ECU 工程。没有多配方选择和额外测试范围勾选。"
        Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,15"/>
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="12"/>
         <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" CornerRadius="8"
         BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
         <StackPanel>
          <TextBlock Text="1 · 扫码枪及编号解释" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock Text="选择真实 COM、串口波特率；配置 UT1 / 型号+编号 / 纯编号，试解析真实标签；把型号唯一登记到工位。"
           Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,11"/>
          <Button Content="打开扫码枪配置" Command="{Binding OpenSerialScannerCommand}"
           HorizontalAlignment="Left" Padding="14,7"/>
          <TextBlock Text="{Binding ScanStatus}" Foreground="#60788B"
           TextWrapping="Wrap" Margin="0,11,0,0"/>
         </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="White" CornerRadius="8"
         BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
         <StackPanel>
          <TextBlock Text="2 · 原生烧录配置" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock Text="使用当前型号工程中的强类型参数；受控导入 HEX/S19 和受审算法文件，离线校验 Job 后明确发布。运行期不依赖 CanTool XML 配方。"
           Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,11"/>
          <Button Content="打开原生烧录配置" Command="{Binding OpenNativeFlashProfileCommand}"
           HorizontalAlignment="Left" Padding="14,7"/>
          <TextBlock Text="编辑或发布配置不会连接主控板或对 ECU 擦写。"
           Foreground="#60788B" TextWrapping="Wrap" Margin="0,11,0,0"/>
         </StackPanel>
        </Border>
       </Grid>
       <Border Background="{StaticResource ToolbarSurface}" CornerRadius="8"
        BorderBrush="{StaticResource Line}" BorderThickness="1"
        Padding="14" Margin="0,14,0,0">
        <StackPanel>
         <TextBlock Text="3 · 资源与工程测试范围" FontSize="13" FontWeight="SemiBold"/>
         <TextBlock Text="正式自动测试由 ECU 工程的 TEST 项目确定顺序及用例实例；扫码只选择唯一工程，烧录是生产执行前置过程。工程师可以独立调试，不用扫码。"
          Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,11"/>
         <WrapPanel>
          <Button Content="打开 TEST 项目" Command="{Binding OpenFirstTestProjectCommand}"
           Margin="0,0,8,0" Padding="12,7"/>
          <Button Content="打开独立烧录工具" Command="{Binding OpenFlashWorkbenchCommand}"
           Margin="0,0,8,0" Padding="12,7"/>
         </WrapPanel>
         <TextBlock Text="当前状态：扫码匹配、原生 Flash 发布和 TEST 项目均可独立检查；真实夹具/实体 START → 每次前置烧录 → TEST → RECORD 的自动生产闭环尚未实测接通，不能出具合格结论。"
          Foreground="#61778A" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   <TabItem Header="运行前检查">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="16,16,16,12">
      <TextBlock Text="当前工程与实体运行条件" FontSize="13" FontWeight="SemiBold"
       Margin="0,0,0,12"/>
      <Border Background="#F5F8FC" BorderBrush="#E5ECF4"
       BorderThickness="1" CornerRadius="6" Padding="10">
       <StackPanel>
        <TextBlock Text="{Binding SelectedConfigurationSummary}" TextWrapping="Wrap"
         Foreground="#64758C" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding HardwareStatus}" Foreground="#A96D20"/>
        <TextBlock Text="尚无正式项目级 Run/设备租约预检；此页面不输出 PASS，也不执行实体动作。"
         Foreground="#64758C" TextWrapping="Wrap" Margin="0,10,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
