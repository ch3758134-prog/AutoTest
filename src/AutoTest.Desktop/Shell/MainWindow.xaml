<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Title="AutoTest · ECU 测试与开发" Width="1580" Height="920"
    MinWidth="1150" MinHeight="720" WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource StudioBg}" Foreground="{DynamicResource StudioText}"
    FontFamily="Microsoft YaHei UI" FontSize="13"
    SnapsToDevicePixels="True" UseLayoutRounding="True"
    Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Border" Color="#DCE6F3"/>
        <SolidColorBrush x:Key="Text" Color="#24364A"/>
        <SolidColorBrush x:Key="Muted" Color="#65778A"/>
        <SolidColorBrush x:Key="Primary" Color="#2E85EE"/>
        <!-- Application control styles are the single source of truth. -->
        <!-- Only the opened documents are tabs. Overflow scrolls horizontally
             instead of wrapping tabs into multiple rows and stealing TEST space. -->
        <Style x:Key="IdeDocuments" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" Background="#F6F9FE">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#EDF4FE"
                                BorderBrush="#DCE6F3" BorderThickness="0,0,0,1">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Disabled" CanContentScroll="True"
                                    Focusable="False">
                                    <TabPanel IsItemsHost="True" Background="#EDF4FE"/>
                                </ScrollViewer>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Foreground" Value="#4A627B"/>
            <Setter Property="Background" Value="#F4F8FE"/>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="41"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*" MinHeight="330"/>
            <RowDefinition x:Name="LogRow" Height="29" MinHeight="29"/>
            <RowDefinition Height="27"/>
        </Grid.RowDefinitions>

        <!-- Single coherent application chrome. No nested operator/developer shells. -->
        <Border Grid.Row="0" Background="#F8FAFF" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="13,0,13,0">
                <TextBlock DockPanel.Dock="Right" Text="ECU 测试工作台"
                    FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Left" Background="#2E85EE" Width="26" Height="26"
                    CornerRadius="5" Margin="0,0,9,0" VerticalAlignment="Center">
                    <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="AutoTest" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="   /   " Foreground="#94A4B7" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ProjectLabel}" Foreground="#5D7087" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>



        <!-- Test is the primary action. Scanner is only a small station input status. -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="12,7">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StationLed" Width="8" Height="8" Fill="#92A6BD" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="StationStatus" Text="未连接主控" VerticalAlignment="Center"
                        Foreground="#62778E" FontSize="11" Margin="0,0,10,0"/>
                    <Button Content="连接设备" x:Name="StationConnectButton" Click="OpenStation_Click" ToolTip="自动发现设备并连接；不执行任何物理输出"
                        Padding="7,3" MinHeight="27"/>
                    <Border Height="23" Width="1" Background="#DCE6F3" Margin="6,0,12,0"/>
                    <TextBlock x:Name="ScannerStatus" Text="扫码：等待编号" VerticalAlignment="Center"
                        Foreground="#63758A" FontSize="11" MaxWidth="220" TextTrimming="CharacterEllipsis"/>

                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开工程" Command="{Binding OpenProjectCommand}" ToolTip="Ctrl+O 打开本地工程"/>
                    <Button Content="保存工程" Command="{Binding SaveCommand}" ToolTip="Ctrl+S 保存工程"/>
                    <Border Height="22" Width="1" Background="{DynamicResource StudioLine}" Margin="1,0,12,0"/>
                    <Button Content="✎ 编辑测试程序" Style="{StaticResource AtPrimaryButton}" Click="OpenTest_Click"/>
                    <Button Content="▷ 运行测试" Click="OpenRun_Click"/>
                    <Button Content="▣ 手动台架" Click="OpenBench_Click"
                            ToolTip="在独立窗口打开真实 CAN1 发送、按键动作、IGN 与夹具"/>
                    <Menu Background="Transparent" Foreground="{DynamicResource StudioText}" VerticalAlignment="Center" Margin="0,0,7,0">
                        <MenuItem Header="专业工具 ▾" ToolTip="所有专业工具均在独立窗口打开">
                            <MenuItem Header="UDS 诊断" Click="OpenUds_Click"/>
                            <MenuItem Header="CAN 烧录" Click="OpenFlash_Click"/>
                            <MenuItem Header="波形分析" Click="OpenWave_Click"/>
                            <MenuItem Header="DBC 编辑器" Click="OpenDbc_Click"/>
                            <Separator/>
                            <MenuItem Header="控制器与按键配置" Click="OpenController_Click"/>
                            <MenuItem Header="CAN 接收监视" Click="OpenCan_Click"/>
                            <MenuItem Header="扫码与生产" Click="OpenProduction_Click"/>
                            <MenuItem Header="运行记录与报告" Click="OpenRecords_Click"/>
                            <MenuItem Header="操作审计" Click="OpenAudit_Click"/>
                        </MenuItem>
                        <MenuItem Header="更多 ▾">
                            <MenuItem Header="新建工程" Command="{Binding NewProjectCommand}"/>
                            <MenuItem Header="导入 DBC" Command="{Binding ImportDbcCommand}"/>
                            <MenuItem Header="检查工程与引用" Command="{Binding ValidateCommand}"/>
                            <Separator/>
                            <MenuItem Header="显示或隐藏工程资源" Click="ToggleExplorer_Click"/>
                            <MenuItem Header="显示或隐藏通信日志" Click="ToggleBottom_Click"/>
                            <MenuItem Header="命令搜索（Ctrl+K）" Click="CommandPalette_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3" Background="#F6F9FE">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition x:Name="ExplorerColumn" Width="273" MinWidth="0"/>
                <ColumnDefinition x:Name="ExplorerSplitterColumn" Width="5"/>
                <ColumnDefinition Width="*" MinWidth="620"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F7FAFF" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <StackPanel Margin="3,10,3,0">
                    <Button Content="⌂" FontSize="21" Style="{StaticResource AtQuietButton}" ToolTip="工程资源" Click="ToggleExplorer_Click" MinHeight="42" Margin="0,0,0,8"/>
                    <Button Content="▤" FontSize="20" Style="{StaticResource AtPrimaryButton}" ToolTip="测试程序编辑" Click="OpenTest_Click" MinHeight="42" Margin="0,0,0,8"/>
                    <Button Content="▶" FontSize="19" Style="{StaticResource AtQuietButton}" ToolTip="自动测试运行" Click="OpenRun_Click" MinHeight="42" Margin="0,0,0,8"/>
                    <Button Content="▣" FontSize="19" Style="{StaticResource AtQuietButton}" ToolTip="手动台架（独立窗口）" Click="OpenBench_Click" MinHeight="42" Margin="0,0,0,8"/>
                    <Button Content="∿" FontSize="22" Style="{StaticResource AtQuietButton}" ToolTip="波形分析（独立窗口）" Click="OpenWave_Click" MinHeight="42" Margin="0,0,0,8"/>
                    <Button Content="⌕" FontSize="21" Style="{StaticResource AtQuietButton}" ToolTip="查找命令 Ctrl+K" Click="CommandPalette_Click" MinHeight="42" Margin="0"/>
                </StackPanel>
            </Border>
            <!-- An IDE always provides access to the project and TEST structure. -->
            <Border x:Name="ExplorerPanel" Grid.Column="1" Background="White"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F5F9FF" Padding="12,10"
                        BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="‹" Click="ToggleExplorer_Click"
                                Padding="6,0" MinHeight="20" Margin="0" Background="Transparent"
                                BorderThickness="0" ToolTip="收起工程树"/>
                            <TextBlock Text="工程资源" FontSize="13" FontWeight="SemiBold"/>
                        </DockPanel>
                    </Border>
                    <ContentControl x:Name="ExplorerDocumentHost" Background="{DynamicResource StudioPanel}" Margin="4,6,4,0"/>

                </DockPanel>
            </Border>
            <GridSplitter x:Name="ExplorerSplitter" Grid.Column="2" Width="5"
                HorizontalAlignment="Stretch" Background="#EDF2F8"/>
            <!-- The ONE document host. The operator TEST is its first permanent document. -->
            <TabControl x:Name="DocumentTabs" Grid.Column="3" Style="{StaticResource IdeDocuments}" Background="#F6F9FE"
                BorderBrush="{StaticResource Border}" BorderThickness="0"
                SelectionChanged="DocumentTabs_SelectionChanged"/>
        </Grid>

        <Border Grid.Row="4" Background="White"
            BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="日志 ▴ / ▾" Click="ToggleBottom_Click"
                    Background="Transparent" BorderThickness="0" Margin="0" Padding="12,2" MinHeight="25"/>
                <TextBlock DockPanel.Dock="Left" Text="通信记录与操作日志" Foreground="#65778A"
                    VerticalAlignment="Center" FontSize="11" Margin="13,0,9,0"/>
                <TabControl x:Name="EvidenceTabs" Visibility="Collapsed"
                    Background="White" BorderThickness="0" TabStripPlacement="Top">
                    <TabItem Header="CAN 接收记录">
                        <DataGrid x:Name="CanTraceGrid" AutoGenerateColumns="True" IsReadOnly="True"
                            CanUserAddRows="False" RowHeaderWidth="0"/>
                    </TabItem>
                    <TabItem Header="UDS / ISO-TP">
                        <DataGrid x:Name="UdsTraceGrid" AutoGenerateColumns="True" IsReadOnly="True"
                            CanUserAddRows="False" RowHeaderWidth="0"/>
                    </TabItem>
                    <TabItem Header="操作审计">
                        <DataGrid x:Name="AuditGrid" AutoGenerateColumns="True" IsReadOnly="True"
                            CanUserAddRows="False" RowHeaderWidth="0"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <Border Grid.Row="5" Background="#F1F3F5" Padding="12,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="#526C87"
                    FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="700"/>
                <TextBlock Text="主控连接不等于 ECU 测试通过" FontSize="11"
                    Foreground="#355B81"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>