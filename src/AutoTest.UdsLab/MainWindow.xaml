<Window x:Class="AutoTest.UdsLab.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · UDS 诊断控制台" Width="1560" Height="920"
 MinWidth="1160" MinHeight="720" WindowStartupLocation="CenterScreen" WindowState="Maximized"
 PreviewKeyDown="MainWindow_PreviewKeyDown"
 Background="#F3F6FA" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#1A2F4B"/>
  <SolidColorBrush x:Key="Secondary" Color="#64758D"/>
  <SolidColorBrush x:Key="Stroke" Color="#DDE5EF"/>
  <SolidColorBrush x:Key="Accent" Color="#2564A7"/>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>
  <Style x:Key="Muted" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="9"/>
   <Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Background" Value="#2A67AA"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#2A67AA"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="17,8"/>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button">
   <Setter Property="Background" Value="#F0F4F9"/>
   <Setter Property="BorderBrush" Value="#DAE2ED"/>
   <Setter Property="Padding" Value="11,7"/>
  </Style>
 </Window.Resources>
 <Grid Margin="16,12,16,12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="360"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <!-- Header: only highest-frequency actions; configure details elsewhere -->
  <Grid Grid.Row="0" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="UDS 诊断控制台" Foreground="{StaticResource Ink}" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="快速请求 · 常用操作 · 连续交互 · 真实响应"
               Style="{StaticResource Muted}" Margin="0,3,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="打开诊断配置" Style="{StaticResource QuietButton}" Click="Open_Click" Margin="0,0,7,0"/>
    <Button Content="保存诊断配置" Style="{StaticResource QuietButton}" Click="Save_Click" Margin="0,0,7,0"/>
    <Button Content="导出交互证据" Style="{StaticResource QuietButton}" Click="Export_Click"/>
   </StackPanel>
  </Grid>
  <!-- Connection status remains visible; IDs and timing are expandable -->
  <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="11,8" Margin="0,0,0,10">
   <StackPanel>
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="ConnectButton" Content="连接主控" Style="{StaticResource PrimaryButton}"
              Click="Connect_Click" Margin="0,0,6,0"/>
      <Button x:Name="DisconnectButton" Content="断开" IsEnabled="False" Style="{StaticResource QuietButton}"
              Click="Disconnect_Click"/>
     </StackPanel>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="ConnectionStatus" Text="未连接 · 尚未验证 ECU 通信。请先配置请求 / 响应 CAN ID。"
                 Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="EcuSessionStatus" Text="ECU 诊断会话：未知"
                 Foreground="#866632" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </DockPanel>
    <Expander x:Name="ConnectionSettingsExpander" Header="连接参数 · CAN 寻址 / P2 / P2*" Margin="0,6,0,0" Foreground="#52657B">
     <WrapPanel Margin="2,9,0,0">
      <TextBlock Text="请求 CAN ID (HEX)" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <TextBox x:Name="TxIdBox" Width="110" Margin="0,0,14,6"/>
      <TextBlock Text="响应 CAN ID (HEX)" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <TextBox x:Name="RxIdBox" Width="110" Margin="0,0,14,6"/>
      <TextBlock Text="P2 (ms)" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <TextBox x:Name="P2Box" Text="1000" Width="72" Margin="0,0,14,6"/>
      <TextBlock Text="P2* (ms)" VerticalAlignment="Center" Margin="0,0,6,6"/>
      <TextBox x:Name="P2StarBox" Text="5000" Width="72" Margin="0,0,14,6"/>
      <TextBlock Text="Normal ISO-TP · DUT CAN · 实体帧仍需逐帧授权" Foreground="#8B633A"
                 VerticalAlignment="Center" FontSize="11" Margin="0,0,0,6"/>
     </WrapPanel>
    </Expander>
   </StackPanel>
  </Border>
  <!-- Work area: actions / actual exchanges / observation and inspection -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="245" MinWidth="215"/>
    <ColumnDefinition Width="8"/>
    <ColumnDefinition Width="*" MinWidth="380"/>
    <ColumnDefinition Width="8"/>
    <ColumnDefinition Width="310" MinWidth="270"/>
   </Grid.ColumnDefinitions>
   <!-- Frequent saved actions -->
   <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="11">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="常用诊断操作" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
      <TextBlock Text="点击执行；选中后可编辑和复用" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
      <TextBox x:Name="OperationSearchBox" TextChanged="OperationSearchChanged"
               ToolTip="按操作名称或分组筛选" Margin="0,0,0,9" Padding="8,6"/>
      <Button Content="＋ 创建即时请求" Style="{StaticResource QuietButton}" Click="QuickNew_Click" Margin="0,0,0,9"/>
      <TextBlock x:Name="ActionsEmptyHint" Text="还没有常用操作。&#10;可以先在中间发送请求，再保存到这里。"
                 Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="3,3,0,10"/>
      <TextBlock Text="单击左侧操作，即在中间直接修改；右键可复制或删除"
                 Foreground="#72839A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
      <WrapPanel Margin="0,0,0,8">
       <Button Content="复制选中" Style="{StaticResource QuietButton}" Click="Copy_Click" Margin="0,0,5,0"/>
       <Button Content="删除选中" Style="{StaticResource QuietButton}" Click="Delete_Click"/>
      </WrapPanel>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
      <Expander x:Name="QueueExpander" Header="批量与连续读取（可选）" IsExpanded="False">
       <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,0">
         <TextBlock Text="按顺序执行已保存的诊断操作。不是 TEST 程序。" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
         <WrapPanel Margin="0,7,0,7">
          <Button Content="加入" Click="QueueAdd_Click" Style="{StaticResource QuietButton}" Margin="0,0,4,0"/>
          <Button Content="移除" Click="QueueRemove_Click" Style="{StaticResource QuietButton}"/>
         </WrapPanel>
         <ListBox x:Name="QueueList" Height="80" DisplayMemberPath="Name" FontSize="12"/>
         <Button x:Name="QueueNextButton" Content="执行下一项" Click="QueueNext_Click"
                 Style="{StaticResource QuietButton}" Margin="0,7,0,5"/>
         <Button x:Name="QueueRunButton" Content="顺序执行一次" Click="QueueRun_Click"
                 Style="{StaticResource QuietButton}" Margin="0,0,0,8"/>
         <TextBlock Text="重复读取单个 DID" FontWeight="SemiBold" FontSize="12"/>
         <WrapPanel Margin="0,4,0,3">
          <TextBlock Text="间隔 ms" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <TextBox x:Name="WatchIntervalBox" Width="60" Text="2000" Margin="0,0,5,0"/>
          <Button x:Name="WatchStartButton" Content="开始读取" Click="WatchStart_Click" Style="{StaticResource QuietButton}"/>
         </WrapPanel>
         <TextBlock x:Name="SeriesStatus" Style="{StaticResource Muted}" TextWrapping="Wrap"
                    Text="每帧物理授权仍有效；不能无人值守。" Margin="0,5,0,0"/>
        </StackPanel>
       </ScrollViewer>
      </Expander>
     </StackPanel>
     <ListBox x:Name="ActionsList" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
              SelectionChanged="ActionsList_SelectionChanged">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Border Margin="0,2" Padding="6,7" Background="#F5F8FC" CornerRadius="5">
         <Border.ContextMenu>
          <ContextMenu>
           <MenuItem Header="执行此操作" Click="MenuRunAction_Click"/>
           <MenuItem Header="编辑操作" Click="MenuEditAction_Click"/>
           <MenuItem Header="复制操作" Click="MenuCopyAction_Click"/>
           <Separator/>
           <MenuItem Header="删除操作" Click="MenuDeleteAction_Click"/>
          </ContextMenu>
         </Border.ContextMenu>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,5,0">
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Group}" FontSize="11" Foreground="#71839A" Margin="0,2,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="执行" Click="RunSavedAction_Click"
                  CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="7,4"
                  VerticalAlignment="Center"/>
         </Grid>
        </Border>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Background="Transparent" Width="8" HorizontalAlignment="Stretch"/>
   <!-- Central workbench: the editor is the primary surface; live history stays visible. -->
   <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="11">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="3*" MinHeight="260"/>
      <RowDefinition Height="7"/>
      <RowDefinition Height="2*" MinHeight="150"/>
     </Grid.RowDefinitions>
     <!-- Persistent edit/run toolbar. Nothing here requires a saved action. -->
     <Grid Grid.Row="0" Margin="0,0,0,9">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="诊断请求 · 实时编辑" Style="{StaticResource SectionTitle}"/>
       <TextBlock x:Name="EditorContextStatus" Text="当前：临时请求 · 选择服务并填写参数，可直接执行"
                  Style="{StaticResource Muted}" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="SendButton" Content="▶ 发送 / 重发" Click="Send_Click"
               Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,6,0"
               ToolTip="发送编辑器当前的请求，Ctrl+Enter"/>
       <Button x:Name="CancelButton" Content="■ 停止" Click="Cancel_Click" IsEnabled="False"
               Style="{StaticResource QuietButton}" Margin="0,0,6,0"/>
       <Button Content="保存为操作" Click="SaveCurrent_Click" Style="{StaticResource QuietButton}"/>
      </StackPanel>
     </Grid>
     <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
             CornerRadius="7" Background="#FAFCFF">
      <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="12,10,12,10">
        <!-- Name, group and actual service parameters are always directly editable. -->
        <Grid Margin="0,0,0,5">
         <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0">
          <TextBlock Text="操作名称 · 可以随时修改" Style="{StaticResource Muted}"/>
          <TextBox x:Name="NameBox" TextChanged="EditorChanged" Padding="8,5"
                   ToolTip="选择左侧操作后可直接修改名称；编辑立即作用于当前操作"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="分组" Style="{StaticResource Muted}"/>
          <TextBox x:Name="GroupBox" TextChanged="EditorChanged" Padding="8,5"/>
         </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,5">
         <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0">
          <TextBlock Text="UDS 服务 · 自动组帧" Style="{StaticResource Muted}"/>
          <ComboBox x:Name="ServiceCombo" DisplayMemberPath="Display" SelectionChanged="ServiceChanged"
                    ToolTip="选择服务后直接编辑 DID、子功能或附加参数"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="常用子功能" Style="{StaticResource Muted}"/>
          <ComboBox x:Name="SubfunctionPresetCombo" DisplayMemberPath="Display" SelectionChanged="SubfunctionPresetChanged"
                    Visibility="Collapsed" ToolTip="选择子功能，或在下面直接输入 HEX"/>
          <TextBlock x:Name="NoSubfunctionHint" Text="无预设子功能，可直接填写" Style="{StaticResource Muted}"/>
         </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,3">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0">
          <TextBlock x:Name="PrimaryLabel" Text="DID / 子功能" Style="{StaticResource Muted}"/>
          <TextBox x:Name="PrimaryBox" FontFamily="Consolas" FontSize="14"
                   TextChanged="ServiceParameterChanged" Padding="8,5"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock x:Name="AuxiliaryLabel" Text="附加参数（可选）" Style="{StaticResource Muted}"/>
          <TextBox x:Name="AuxiliaryBox" FontFamily="Consolas" FontSize="14"
                   TextChanged="ServiceParameterChanged" Padding="8,5"/>
         </StackPanel>
        </Grid>
        <TextBlock x:Name="ServiceHelp" Style="{StaticResource Muted}" TextWrapping="Wrap"
                   Margin="0,1,0,5"/>
        <Border Background="#F0F5FC" CornerRadius="5" Padding="9,7" Margin="0,3,0,7">
         <StackPanel>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="实际请求 PDU（HEX）" Foreground="#324B6A" FontWeight="SemiBold" VerticalAlignment="Center"/>
           <CheckBox x:Name="RawModeCheck" Grid.Column="1" Content="直接编辑 HEX" Margin="8,0,0,0"
                     Checked="RawModeChanged" Unchecked="RawModeChanged"
                     ToolTip="开启后直接修改原始 UDS 请求；不会被服务模板覆盖"/>
          </Grid>
          <TextBox x:Name="RequestBox" FontFamily="Consolas" FontSize="15"
                   TextChanged="EditorChanged" Padding="8,5" Margin="0,7,0,0" IsReadOnly="True"
                   ToolTip="当前将发送的 UDS PDU，不包含 CAN ID 和 ISO-TP PCI"/>
         </StackPanel>
        </Border>
        <!-- Parsing and response expectations are frequently tuned during ECU debugging. -->
        <Expander x:Name="AdvancedEditExpander" Header="期望响应 · 数据解析（随时修改）"
                  IsExpanded="True" Margin="0,0,0,4">
         <StackPanel Margin="0,7,0,0">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <StackPanel Grid.Column="0">
            <TextBlock Text="期望响应前缀（HEX）" Style="{StaticResource Muted}"/>
            <TextBox x:Name="ExpectedBox" FontFamily="Consolas" TextChanged="EditorChanged" Padding="7,4"/>
           </StackPanel>
           <StackPanel Grid.Column="2">
            <TextBlock Text="解析类型" Style="{StaticResource Muted}"/>
            <ComboBox x:Name="DecodeBox" SelectionChanged="EditorChangedSelection">
             <ComboBoxItem Content="原始 HEX" Tag="Hex"/>
             <ComboBoxItem Content="ASCII 字符串" Tag="Ascii"/>
             <ComboBoxItem Content="16 位大端整数" Tag="UInt16BE"/>
             <ComboBoxItem Content="16 位小端整数" Tag="UInt16LE"/>
             <ComboBoxItem Content="8 位整数" Tag="UInt8"/>
             <ComboBoxItem Content="DTC 故障列表" Tag="Dtc"/>
            </ComboBox>
           </StackPanel>
          </Grid>
          <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
           <TextBlock Text="数据偏移" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#64758D"/>
           <TextBox x:Name="OffsetBox" Width="50" TextChanged="EditorChanged" Margin="0,0,12,0"/>
           <TextBlock Text="比例" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#64758D"/>
           <TextBox x:Name="ScaleBox" Width="68" TextChanged="EditorChanged" Margin="0,0,12,0"/>
           <TextBlock Text="单位" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#64758D"/>
           <TextBox x:Name="UnitBox" Width="85" TextChanged="EditorChanged"/>
          </WrapPanel>
         </StackPanel>
        </Expander>
        <TextBlock x:Name="ComposerStatus" Foreground="#346F5A" FontSize="12"
                   TextWrapping="Wrap" Margin="0,5,0,1"/>
        <TextBlock x:Name="SendHint" Foreground="#9A7042" FontSize="11"
                   TextWrapping="Wrap"
                   Text="可以边调参数边连续执行；只有真实 ECU 最终响应才表示诊断结果已确认。"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
     <GridSplitter Grid.Row="2" Height="7" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                   HorizontalAlignment="Stretch" Background="#E3EAF3"
                   ToolTip="拖动调整编辑区与交互历史的高度"/>
     <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,9,0,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="请求 / 响应历史" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="修改参数并重复发送，历史不丢失；选择一条可在右侧查看实际结果"
                   Style="{StaticResource Muted}" Margin="0,2,0,0"/>
       </StackPanel>
       <TextBlock x:Name="HistoryCounter" Grid.Column="1" Text="0 条交互"
                  Foreground="#64758D" FontSize="12" VerticalAlignment="Center"/>
      </Grid>
      <Grid Grid.Row="1">
       <ListView x:Name="ExchangeList" SelectionChanged="Exchange_Selected"
                 BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                 Background="White" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <ListView.View>
         <GridView>
          <GridViewColumn Header="时间" Width="95" DisplayMemberBinding="{Binding LocalTime}"/>
          <GridViewColumn Header="诊断操作" Width="170" DisplayMemberBinding="{Binding ActionName}"/>
          <GridViewColumn Header="请求 PDU" Width="120" DisplayMemberBinding="{Binding RequestHex}"/>
          <GridViewColumn Header="响应 PDU" Width="160" DisplayMemberBinding="{Binding ResponseHex}"/>
          <GridViewColumn Header="结果" Width="195" DisplayMemberBinding="{Binding Outcome}"/>
          <GridViewColumn Header="耗时" Width="75" DisplayMemberBinding="{Binding Duration}"/>
         </GridView>
        </ListView.View>
       </ListView>
       <TextBlock x:Name="EmptyHistoryText" Text="暂无真实诊断记录&#10;上方修改请求，连接后可反复发送并查看每次结果"
                  Foreground="#8A9BAF" FontSize="13" TextAlignment="Center"
                  VerticalAlignment="Center" HorizontalAlignment="Center"
                  IsHitTestVisible="False" TextWrapping="Wrap"/>
      </Grid>
     </Grid>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="3" Background="Transparent" Width="8" HorizontalAlignment="Stretch"/>
   <!-- Right: pinned observed values and selected exchange details -->
   <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="155"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="固定观察" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="仅随真实响应更新" Style="{StaticResource Muted}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="固定结果" Click="PinSelected_Click" Style="{StaticResource QuietButton}" Padding="7,4" Margin="0,0,4,0"/>
       <Button Content="移除" Click="UnpinSelected_Click" Style="{StaticResource QuietButton}" Padding="6,4"/>
      </StackPanel>
     </Grid>
     <ListBox Grid.Row="1" x:Name="WatchList" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
              Background="#F8FAFD" Margin="0,0,0,12" FontSize="12">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel Margin="5,5,5,6">
         <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding Display}" Foreground="#24659C" Margin="0,3,0,0" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding UpdatedAt}" Foreground="#8794A5" FontSize="11"/>
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <Grid Grid.Row="2" Margin="0,0,0,9">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="交互详情" Style="{StaticResource SectionTitle}"/>
      <Button Grid.Column="1" Content="回填到请求" Style="{StaticResource QuietButton}" Padding="7,4"
              Click="ReuseSelected_Click"/>
     </Grid>
     <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="执行结果" Style="{StaticResource Muted}"/>
       <TextBlock x:Name="ResultStatus" Text="尚无 ECU 响应" Foreground="{StaticResource Ink}"
                  FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,9"/>
       <TextBlock Text="解析数据" Style="{StaticResource Muted}"/>
       <TextBox x:Name="ParsedBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="63" Margin="0,3,0,9"/>
       <TextBlock Text="请求 PDU" Style="{StaticResource Muted}"/>
       <TextBox x:Name="LastRequestBox" IsReadOnly="True" FontFamily="Consolas"
                TextWrapping="Wrap" MinHeight="29" Margin="0,3,0,9"/>
       <TextBlock Text="ECU 响应 PDU" Style="{StaticResource Muted}"/>
       <TextBox x:Name="LastResponseBox" IsReadOnly="True" FontFamily="Consolas"
                TextWrapping="Wrap" MinHeight="40" Margin="0,3,0,9"/>
       <TextBlock Text="说明 / NRC" Style="{StaticResource Muted}"/>
       <TextBox x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="65" Margin="0,3,0,6"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <Expander Grid.Row="3" Header="底层通信证据 · CAN / ISO-TP / UDS" Margin="0,10,0,0">
   <TabControl Height="195" Margin="0,5,0,0">
    <TabItem Header="详细事件时间线">
     <ListBox x:Name="HistoryList" FontFamily="Consolas" FontSize="12"/>
    </TabItem>
    <TabItem Header="物理 USB / CAN 原始帧">
     <TextBox x:Name="RawTraceBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
              FontFamily="Consolas" FontSize="12"/>
    </TabItem>
   </TabControl>
  </Expander>
 </Grid>
</Window>
