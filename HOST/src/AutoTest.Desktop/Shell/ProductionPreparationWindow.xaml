<Window x:Class="AutoTest.Desktop.Shell.ProductionPreparationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="工位设备设置" Width="840" Height="670" MinWidth="660" MinHeight="490"
 WindowStartupLocation="CenterOwner" Background="#F6F8FB"
 FontFamily="Microsoft YaHei" FontSize="13" Foreground="#263D52">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DAE4EC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="15"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="Margin" Value="0,0,12,8"/>
  </Style>
  <Style x:Key="Section" TargetType="TextBlock">
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
 </Window.Resources>
 <Grid Margin="19,16,19,13">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <Button Content="关闭" DockPanel.Dock="Right"
    Click="Close_Click" Margin="7,0,0,0"/>
   <StackPanel>
    <TextBlock Text="工位设备设置" FontSize="21" FontWeight="SemiBold"/>
   </StackPanel>
  </DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
   HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Style="{StaticResource Panel}">
     <StackPanel>
      <TextBlock Text="设备连接" Style="{StaticResource Section}"/>
      <TextBlock x:Name="MainBoardState" Text="主控未连接"
       Margin="0,0,0,5" Foreground="#45677F"/>
      <TextBlock x:Name="ScannerState" Text="扫码枪未连接"
       Margin="0,0,0,9" Foreground="#45677F"/>
      <WrapPanel Margin="0,0,0,8">
       <Button Content="扫码枪连接设置…" Click="ScannerSettings_Click"/>
       <Button Content="重新连接扫码枪" Click="RetryScanner_Click"/>
      </WrapPanel>
      <TextBlock Text="最近收到的扫码内容" Foreground="#677F93" FontSize="12"/>
      <TextBlock x:Name="ScanRaw" Text="等待扫码…"
       FontSize="20" FontWeight="SemiBold" Foreground="#23649C"
       TextWrapping="Wrap" Margin="0,7,0,0"/>
      <TextBlock x:Name="ScanObservedAt" Text="" FontSize="12"
       Foreground="#6F8393" Margin="0,3,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Panel}">
     <StackPanel>
      <TextBlock Text="夹具动作" Style="{StaticResource Section}"/>
      <TextBlock Text="夹具 1 → 夹具 2 自动压紧；检测完成后按相反顺序释放。"
       Foreground="#263D52" FontSize="14" TextWrapping="Wrap"/>
      <TextBlock Text="压紧后以本台 ECU CAN 新收到的报文确认通信就绪。"
       Foreground="#547087" TextWrapping="Wrap" Margin="0,9,0,0"/>
      <TextBlock Text="ECU 通信确认不是机械位置传感器，也不替代独立的人员安全防护。"
       Foreground="#647B8D" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
      <TextBlock x:Name="FixtureSummary" Foreground="#547087"
       TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Panel}">
     <StackPanel>
      <TextBlock Text="设置状态" Style="{StaticResource Section}"/>
      <TextBlock Text="修改会自动保存。设置中填写的输入名称必须与实际硬件接线和固件支持一致。"
       Foreground="#647B8D" TextWrapping="Wrap"/>
      <Button x:Name="ResetOldConfig" Content="重新设置工位"
       Click="ResetOld_Click" Visibility="Collapsed"
       HorizontalAlignment="Left" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="White" BorderBrush="#DAE4EC"
   BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,9,0,0">
   <TextBlock x:Name="StatusText" Text="正在读取工位设置…"
    Foreground="#365B76" TextWrapping="Wrap"/>
  </Border>
 </Grid>
</Window>