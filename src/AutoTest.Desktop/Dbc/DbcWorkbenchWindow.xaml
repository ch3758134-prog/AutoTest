<Window x:Class="AutoTest.Desktop.Dbc.DbcWorkbenchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · DBC 工作台" Width="1360" Height="800"
 MinWidth="1100" MinHeight="640" WindowStartupLocation="CenterOwner"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
 FontFamily="{StaticResource UiFont}" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True"
 Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                     Color="{StaticResource SelectedSurfaceColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                     Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                     Color="{StaticResource InactiveSelectionColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                     Color="{StaticResource InkColor}"/>
    <Style x:Key="DbcSectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource MutedSurface}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="9,9"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="4,3"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource HoverSurface}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource SelectedSurface}"/>
          <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource SelectedSurface}"/>
          <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="6,5"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource SelectedSurface}"/>
          <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="F5" Command="{Binding ReloadCommand}"/>
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="69"/>
      <RowDefinition Height="49"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="17,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="DBC 工作台" FontSize="19" FontWeight="SemiBold"
                       Margin="0,0,12,0"/>
            <TextBlock Text="{Binding AssetName}" FontSize="15" Foreground="{StaticResource Subtle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
          </StackPanel>
          <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource Subtle}"
                     FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"
                     ToolTip="{Binding FilePath}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding AssetRevision,StringFormat='资源修订 {0}'}"
                     VerticalAlignment="Center" Foreground="{StaticResource Subtle}"
                     Margin="0,0,15,0"/>
          <TextBlock Text="● 未保存" Foreground="{StaticResource Warning}"
                     FontSize="12" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDirty}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,0">
        <TextBlock DockPanel.Dock="Right" Text="{Binding StateDescription}"
                   Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                   FontSize="12"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="保存 DBC" Command="{Binding SaveCommand}"
                  ToolTip="保存文件，复核并更新工程资源 Revision（Ctrl+S）"/>
          <Button Content="重新加载" Command="{Binding ReloadCommand}"
                  ToolTip="重新从磁盘读取 DBC（F5）"/>
          <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="2,0,10,0"/>
          <Button Content="编辑报文参数" Command="{Binding EditMessageCommand}"/>
          <Button Content="编辑信号参数" Command="{Binding EditSignalCommand}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="10,10,10,9">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290" MinWidth="220"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="410"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="292" MinWidth="235"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource AtPanel}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="12,11"
                  Background="{StaticResource ToolbarSurface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="报文" Style="{StaticResource DbcSectionTitle}"/>
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding MessageCount,StringFormat='{}{0} 条'}"
                         Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ListBox ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                   BorderThickness="0" Background="Transparent" Margin="5"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingStackPanel.VirtualizationMode="Recycling"
                   MouseDoubleClick="MessageList_DoubleClick">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="3,5">
                  <TextBlock Text="{Binding Caption}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Transmitter,StringFormat='发送节点：{0}'}"
                             FontSize="11" Foreground="{StaticResource Subtle}" Margin="0,5,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" Background="{StaticResource Line}"/>

      <Border Grid.Column="2" Style="{StaticResource AtPanel}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="12,11"
                  Background="{StaticResource ToolbarSurface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock Text="信号列表" Style="{StaticResource DbcSectionTitle}"/>
              <TextBlock DockPanel.Dock="Right"
                         Text="{Binding SignalCount,StringFormat='{}{0} 个'}"
                         Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <DataGrid ItemsSource="{Binding Signals}" SelectedItem="{Binding SelectedSignal}"
                    AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    CanUserSortColumns="True" IsReadOnly="True"
                    HeadersVisibility="Column" RowHeaderWidth="0"
                    GridLinesVisibility="Horizontal"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    BorderThickness="0" Background="Transparent" AlternatingRowBackground="{StaticResource ToolbarSurface}"
                    RowHeight="35" ColumnHeaderHeight="38"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    MouseDoubleClick="SignalGrid_DoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="信号名称" Binding="{Binding Name}" Width="160"/>
              <DataGridTextColumn Header="起始位" Binding="{Binding StartBit}" Width="65"/>
              <DataGridTextColumn Header="位长" Binding="{Binding BitLength}" Width="55"/>
              <DataGridTextColumn Header="字节序" Binding="{Binding Order}" Width="85"/>
              <DataGridTextColumn Header="符号" Binding="{Binding Signed}" Width="78"/>
              <DataGridTextColumn Header="因子" Binding="{Binding Factor}" Width="85"/>
              <DataGridTextColumn Header="偏移" Binding="{Binding Offset}" Width="85"/>
              <DataGridTextColumn Header="范围" Binding="{Binding MinMax}" Width="145"/>
              <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="85"/>
              <DataGridTextColumn Header="接收节点" Binding="{Binding Receiver}" Width="105"/>
              <DataGridTextColumn Header="复用" Binding="{Binding Multiplexer}" Width="70"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                    ResizeDirection="Columns" Background="{StaticResource Line}"/>

      <Border Grid.Column="4" Style="{StaticResource AtPanel}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="12,11"
                  Background="{StaticResource ToolbarSurface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <TextBlock Text="参数与状态" Style="{StaticResource DbcSectionTitle}"/>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="13">
              <TextBlock Text="当前报文" FontSize="11" Foreground="{StaticResource Subtle}"
                         Margin="0,0,0,6"/>
              <TextBlock Text="{Binding SelectedMessage.HexId}" FontWeight="SemiBold"
                         FontSize="16" Margin="0,0,0,7"/>
              <TextBlock Text="{Binding SelectedMessage.Name}" Margin="0,0,0,5"/>
              <TextBlock Text="{Binding SelectedMessage.Dlc,StringFormat='DLC：{0} 字节'}"
                         Foreground="{StaticResource Subtle}"/>
              <Button Content="编辑报文参数…" Command="{Binding EditMessageCommand}"
                      HorizontalAlignment="Left" Margin="0,12,0,14"/>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/>
              <TextBlock Text="当前信号" FontSize="11" Foreground="{StaticResource Subtle}"
                         Margin="0,0,0,6"/>
              <TextBlock Text="{Binding SelectedSignal.Name}" FontSize="16"
                         FontWeight="SemiBold" Margin="0,0,0,9"/>
              <TextBlock Text="{Binding SelectedSignal.Order,StringFormat='字节序：{0}'}"
                         Margin="0,0,0,6"/>
              <TextBlock Text="{Binding SelectedSignal.Signed,StringFormat='数值类型：{0}'}"
                         Margin="0,0,0,6"/>
              <TextBlock Text="{Binding SelectedSignal.Factor,StringFormat='因子：{0}'}"
                         Margin="0,0,0,6"/>
              <TextBlock Text="{Binding SelectedSignal.Offset,StringFormat='偏移：{0}'}"
                         Margin="0,0,0,6"/>
              <TextBlock Text="{Binding SelectedSignal.MinMax,StringFormat='范围：{0}'}"
                         TextWrapping="Wrap" Margin="0,0,0,6"/>
              <TextBlock Text="{Binding SelectedSignal.Unit,StringFormat='单位：{0}'}"
                         Margin="0,0,0,6"/>
              <TextBlock Text="{Binding SelectedSignal.Multiplexer,StringFormat='复用：{0}'}"
                         Margin="0,0,0,8"/>
              <TextBlock Text="枚举值说明（VAL_）" Foreground="{StaticResource Subtle}"
                         FontSize="11" Margin="0,9,0,6"/>
              <TextBlock Text="{Binding SelectedValueDescriptions}" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>
              <Button Content="编辑信号参数…" Command="{Binding EditSignalCommand}"
                      HorizontalAlignment="Left" Margin="0,7,0,12"/>
              <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,13"/>
              <TextBlock Text="{Binding UnsupportedDescription}"
                         Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
              <TextBlock Text="任何更改必须先点击“保存 DBC”，否则不会写入文件。"
                         Foreground="{StaticResource Subtle}" FontSize="11"
                         TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0">
        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                   Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>