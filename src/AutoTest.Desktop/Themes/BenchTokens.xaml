<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Optional shared palette: merge into App.xaml ONLY through INTEGRATION. -->
    <Color x:Key="AtColorCanvas">#F6F8FB</Color>
    <Color x:Key="AtColorSurface">#FFFFFF</Color>
    <Color x:Key="AtColorText">#20314A</Color>
    <Color x:Key="AtColorMuted">#54657B</Color>
    <Color x:Key="AtColorAccent">#2255A4</Color>
    <Color x:Key="AtColorBorder">#DEE4EC</Color>
    <Color x:Key="AtColorSuccess">#176D51</Color>
    <Color x:Key="AtColorWarning">#9A640C</Color>
    <Color x:Key="AtColorError">#B43535</Color>
    <SolidColorBrush x:Key="AtBrushCanvas" Color="{StaticResource AtColorCanvas}"/>
    <SolidColorBrush x:Key="AtBrushSurface" Color="{StaticResource AtColorSurface}"/>
    <SolidColorBrush x:Key="AtBrushText" Color="{StaticResource AtColorText}"/>
    <SolidColorBrush x:Key="AtBrushMuted" Color="{StaticResource AtColorMuted}"/>
    <SolidColorBrush x:Key="AtBrushAccent" Color="{StaticResource AtColorAccent}"/>
    <SolidColorBrush x:Key="AtBrushBorder" Color="{StaticResource AtColorBorder}"/>
</ResourceDictionary>
