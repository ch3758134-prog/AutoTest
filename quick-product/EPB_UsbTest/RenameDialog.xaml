<Window x:Class="EPB_UsbTest.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名" Width="400" SizeToContent="Height" MinHeight="0" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" FontFamily="Microsoft YaHei UI" FontSize="12">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="名称"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Height="30" VerticalContentAlignment="Center" Margin="0,8,0,16"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="72" Height="30" Padding="12,0" VerticalContentAlignment="Center"/>
            <Button Content="确定" IsDefault="True" Click="Ok_Click" MinWidth="72" Height="30" Padding="12,0" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
