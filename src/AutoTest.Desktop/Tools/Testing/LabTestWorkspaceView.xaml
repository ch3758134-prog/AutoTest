<UserControl x:Class="AutoTest.Desktop.Tools.Testing.LabTestWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AutoTest.Desktop.Tools.Testing"
 Background="#F5F8FC" Foreground="#23344A"
 FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.InputBindings>
  <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
  <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="F10" Command="{Binding StepCommand}"/>
 </UserControl.InputBindings>
 <UserControl.Resources>
  <local:LabStepTypeDisplayConverter x:Key="StepTypeText"/>
  <local:LabParameterNameConverter x:Key="ParameterLabelText"/>
  <BooleanToVisibilityConverter x:Key="ReviewVisibility"/>
  <SolidColorBrush x:Key="EditorBlue" Color="#317FD6"/>
  <SolidColorBrush x:Key="EditorLine" Color="#DAE4F0"/>
  <SolidColorBrush x:Key="EditorSoft" Color="#EFF5FD"/>
  <SolidColorBrush x:Key="EditorMuted" Color="#6A7D93"/>
  <Style x:Key="EditorCard" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="{StaticResource EditorLine}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="EditorCaption" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="{StaticResource EditorMuted}"/>
   <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="EditorSection" TargetType="TextBlock">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#25384E"/>
  </Style>
  <Style x:Key="EditorAction" TargetType="Button" BasedOn="{StaticResource AtQuietButton}">
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="Padding" Value="10,5"/>
   <Setter Property="Margin" Value="0,0,5,0"/>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type local:LabTreeRow}" ItemsSource="{Binding Children}">
   <Border x:Name="NodeBackground" Background="Transparent" CornerRadius="5" Padding="9,10" Margin="0,1,5,1" HorizontalAlignment="Stretch">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="47"/>
      <ColumnDefinition Width="2.5*" MinWidth="180"/>
      <ColumnDefinition Width="1.1*" MinWidth="95"/>
      <ColumnDefinition Width="2*" MinWidth="150"/>
     </Grid.ColumnDefinitions>
     <TextBlock Grid.Column="0" Text="{Binding OrderLabel}" Foreground="#8395A9" FontSize="12" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="{Binding StepName}" Foreground="#26374B" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" Foreground="#5D7188" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="3" Text="{Binding Summary}" Foreground="#62788F" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </Grid>
   </Border>
   <HierarchicalDataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsPhase}" Value="True">
     <Setter TargetName="NodeBackground" Property="Background" Value="#E6F0FD"/>
     <Setter TargetName="NodeBackground" Property="Padding" Value="10,9"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding IsSlot}" Value="True">
     <Setter TargetName="NodeBackground" Property="Background" Value="#F7F9FC"/>
    </DataTrigger>
   </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>
 </UserControl.Resources>
 <Grid Margin="10,8,10,10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="275"/>
   <RowDefinition Height="6"/>
   <RowDefinition Height="207" MinHeight="140"/>
  </Grid.RowDefinitions>
  <!-- Exact mockup hierarchy: document header, large sequence + inspector, and visible results. -->
  <Grid Grid.Row="0" Margin="1,0,1,9">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="✎" FontSize="25" Foreground="#3385DF" Margin="6,2,16,0" VerticalAlignment="Top"/>
   <StackPanel Grid.Column="1">
    <DockPanel>
     <TextBlock Text="测试程序编辑" FontSize="22" FontWeight="SemiBold" Foreground="#1F344C" VerticalAlignment="Center"/>
     <TextBlock Text="{Binding DocumentName}" FontSize="12" Foreground="#536D87" VerticalAlignment="Center" Margin="18,5,0,0" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <TextBlock Text="{Binding ProjectAssetStatus}" FontSize="11" Foreground="#74879C" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="界面评审工程：只用于编辑与检查，不允许操作真实设备"
      Visibility="{Binding IsReviewSample,Converter={StaticResource ReviewVisibility}}"
      Foreground="#8A643E" FontSize="11" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{Binding StepCountLabel}" Foreground="#3478C0" FontWeight="SemiBold"
     VerticalAlignment="Center" Margin="0,0,18,0"/>
    <Button Content="保存到工程" Command="{Binding SaveToProjectCommand}" Style="{StaticResource AtPrimaryButton}"/>
    <Button Content="检查程序" Command="{Binding PreflightCommand}"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" MinWidth="485"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="390" MinWidth="315" MaxWidth="490"/>
   </Grid.ColumnDefinitions>
   <!-- Main editor: 2/3 of the space, actual grouped and nested TEST steps. -->
   <Border Grid.Column="0" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="9">
    <TabControl Background="White" BorderThickness="0">
     <TabItem Header="☷  程序编辑">
      <DockPanel LastChildFill="True">
     <Border DockPanel.Dock="Top" Background="White" Padding="12,9,10,10"
       BorderBrush="#E0E9F5" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
       <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="展开全部" Command="{Binding ExpandAllCommand}" Style="{StaticResource AtQuietButton}"/>
        <Button Content="折叠全部" Command="{Binding CollapseAllCommand}" Style="{StaticResource AtQuietButton}"/>
       </StackPanel>
       <StackPanel Orientation="Horizontal">
        <Button Content="＋ 添加步骤" Command="{Binding InsertCommand}" Style="{StaticResource AtPrimaryButton}" Margin="0,0,5,0"/>
        <ComboBox Width="155" MinHeight="30" Margin="0,0,10,0" ItemsSource="{Binding StepTypes}"
          SelectedItem="{Binding SelectedInsertType,Mode=TwoWay}">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource StepTypeText}}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="上移" Command="{Binding UpCommand}" Style="{StaticResource AtQuietButton}"/>
        <Button Content="下移" Command="{Binding DownCommand}" Style="{StaticResource AtQuietButton}"/>
        <Button Content="删除" Command="{Binding DeleteCommand}" Style="{StaticResource AtQuietButton}"/>
        <Menu Background="Transparent" VerticalAlignment="Center">
         <MenuItem Header="···" ToolTip="复制、撤销、重做及调试">
          <MenuItem Header="复制步骤" Command="{Binding CopyCommand}"/>
          <MenuItem Header="撤销" Command="{Binding UndoCommand}"/>
          <MenuItem Header="重做" Command="{Binding RedoCommand}"/>
          <Separator/>
          <MenuItem Header="从工程重新加载" Command="{Binding ReloadProjectCommand}"/>
          <MenuItem Header="另存程序副本" Command="{Binding SaveCommand}"/>
         </MenuItem>
        </Menu>
       </StackPanel>
      </DockPanel>
     </Border>
     <Border DockPanel.Dock="Top" Background="#EDF3FB" BorderBrush="#DEE8F4" BorderThickness="0,0,0,1" Padding="32,8,10,8">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="55"/>
        <ColumnDefinition Width="2.4*" MinWidth="155"/>
        <ColumnDefinition Width="1.2*" MinWidth="100"/>
        <ColumnDefinition Width="2*" MinWidth="135"/>
       </Grid.ColumnDefinitions>
       <TextBlock Grid.Column="0" Text="序号" Foreground="#62758C" FontSize="12" FontWeight="SemiBold"/>
       <TextBlock Grid.Column="1" Text="步骤名称" Foreground="#62758C" FontSize="12" FontWeight="SemiBold"/>
       <TextBlock Grid.Column="2" Text="步骤类型" Foreground="#62758C" FontSize="12" FontWeight="SemiBold"/>
       <TextBlock Grid.Column="3" Text="简要说明" Foreground="#62758C" FontSize="12" FontWeight="SemiBold"/>
      </Grid>
     </Border>
     <TreeView x:Name="ProgramTree" ItemsSource="{Binding Tree}" Tag="{Binding}"
       SelectedItemChanged="ProgramTree_OnSelectedItemChanged"
       PreviewMouseRightButtonDown="ProgramTree_OnRightClick" Background="White"
       BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="7,7">
      <TreeView.ItemContainerStyle>
       <Style TargetType="{x:Type TreeViewItem}">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,1"/>
       </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.ContextMenu>
       <ContextMenu DataContext="{Binding PlacementTarget.Tag,RelativeSource={RelativeSource Self}}">
        <MenuItem Header="在此添加步骤" Command="{Binding InsertCommand}"/>
        <MenuItem Header="复制" Command="{Binding CopyCommand}"/>
        <MenuItem Header="上移" Command="{Binding UpCommand}"/>
        <MenuItem Header="下移" Command="{Binding DownCommand}"/>
        <MenuItem Header="删除" Command="{Binding DeleteCommand}"/>
        <Separator/>
        <MenuItem Header="运行到此步" Command="{Binding RunToCommand}"/>
        <MenuItem Header="跳过当前步骤" Command="{Binding SkipCommand}"/>
       </ContextMenu>
      </TreeView.ContextMenu>
     </TreeView>
      </DockPanel>
     </TabItem>
     <TabItem Header="⚙  运行配置">
      <Grid Background="White" Margin="17">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="测试执行范围" FontSize="19" FontWeight="SemiBold" Foreground="#253B54"/>
       <TextBlock Grid.Row="1" Text="勾选本次工程调试用例；扫码生产始终使用已批准的完整测试程序。"
         FontSize="12" Foreground="#6B829B" TextWrapping="Wrap" Margin="0,9,0,14"/>
       <Border Grid.Row="2" BorderBrush="#DFE9F4" BorderThickness="1" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
         <ItemsControl ItemsSource="{Binding TestCases}" Margin="12,7">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border BorderBrush="#E1EAF5" BorderThickness="0,0,0,1" Padding="9,12">
            <CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay}">
             <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding StepCount,StringFormat={}{0} 个步骤}" Foreground="#7E90A5"/>
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
             </DockPanel>
            </CheckBox>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </ScrollViewer>
       </Border>
       <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="全选" Command="{Binding SelectAllCasesCommand}"/>
        <Button Content="清空" Command="{Binding ClearCasesCommand}"/>
        <Button Content="执行所选用例" Command="{Binding RunSelectedPhysicalCommand}" Style="{StaticResource AtPrimaryButton}"/>
       </StackPanel>
      </Grid>
     </TabItem>
     <TabItem Header="ⓘ  程序属性">
      <ScrollViewer Background="White" Padding="19,17">
       <StackPanel>
        <TextBlock Text="测试程序属性" FontSize="18" FontWeight="SemiBold" Foreground="#243A52"/>
        <TextBlock Text="程序名称" Margin="0,17,0,6" Foreground="#75879C"/>
        <TextBlock Text="{Binding DocumentName}" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="步骤与用例" Margin="0,17,0,6" Foreground="#75879C"/>
        <TextBlock Text="{Binding StepCountLabel}"/>
        <TextBlock Text="工程版本" Margin="0,17,0,6" Foreground="#75879C"/>
        <TextBlock Text="{Binding ProjectAssetStatus}" TextWrapping="Wrap"/>
        <TextBlock Text="上一次编辑 / 检查" Margin="0,17,0,6" Foreground="#75879C"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#526D8A"/>
        <StackPanel Orientation="Horizontal" Margin="0,19,0,0">
         <Button Content="保存至工程" Command="{Binding SaveToProjectCommand}" Style="{StaticResource AtPrimaryButton}"/>
         <Button Content="重载程序" Command="{Binding ReloadProjectCommand}"/>
        </StackPanel>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
    </TabControl>
   </Border>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
   <!-- Right panel: narrow dedicated inspector, identical vertical alignment to mockup. -->
   <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="9">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F5F9FF" BorderBrush="#DEE8F4" BorderThickness="0,0,0,1" Padding="15,12">
      <StackPanel>
       <TextBlock Text="⚙  步骤设置" FontSize="16" FontWeight="SemiBold" Foreground="#243A52"/>
       <TextBlock Text="{Binding SelectedStepTypeLabel}" FontSize="12" Foreground="#73889F" Margin="0,5,0,0"/>
      </StackPanel>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="15,12,15,18">
       <TextBlock Text="步骤名称" Foreground="#526D88" Margin="0,4,0,6"/>
       <TextBox Text="{Binding SelectedName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <Button Content="保存名称" Command="{Binding RenameCommand}" HorizontalAlignment="Right"
         Style="{StaticResource AtQuietButton}" Margin="0,5,0,12"/>
       <DockPanel Margin="0,0,0,9">
        <TextBlock Text="参数设置" FontWeight="SemiBold" FontSize="14" Foreground="#263B51"/>
        <Button DockPanel.Dock="Right" Content="＋" Style="{StaticResource AtQuietButton}" ToolTip="添加参数字段：展开下方高级参数"/>
       </DockPanel>
       <DataGrid ItemsSource="{Binding ParameterRows}" SelectedItem="{Binding SelectedParameterRow,Mode=TwoWay}"
        AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="145"
        RowHeaderWidth="0" BorderBrush="#DCE7F4" Background="White" FontSize="12">
        <DataGrid.Columns>
         <DataGridTextColumn Header="参数" Binding="{Binding Key,Converter={StaticResource ParameterLabelText}}" Width="*"/>
         <DataGridTextColumn Header="参数值" Binding="{Binding Value}" Width="1.3*"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Text="{Binding SelectedParameterLabel}" Foreground="#526D88" Margin="0,14,0,5"/>
       <TextBox Text="{Binding ParameterValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <Button Content="保存参数" Command="{Binding SetParameterCommand}" Style="{StaticResource AtPrimaryButton}"
        HorizontalAlignment="Right" Margin="0,9,0,14"/>
       <Expander Header="高级参数键" Foreground="#577592" Margin="0,0,0,11">
        <StackPanel Margin="0,9,0,7">
         <TextBlock Text="参数名称" Foreground="#6F8399"/>
         <TextBox Text="{Binding ParameterName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
        </StackPanel>
       </Expander>
       <Expander Header="按键动作 / 控制器状态" Foreground="#577592">
        <StackPanel Margin="0,9,0,7">
         <ComboBox ItemsSource="{Binding ControllerStateChoices}" SelectedItem="{Binding SelectedControllerChoice,Mode=TwoWay}"
           DisplayMemberPath="Label" MinHeight="30"/>
         <Button Content="刷新状态" Command="{Binding RefreshControllerStatesCommand}" Margin="0,7,0,7"/>
         <Button Content="关联当前步骤" Command="{Binding ApplyControllerStateCommand}" Style="{StaticResource AtPrimaryButton}"/>
         <TextBlock Text="仅编辑工程绑定，不触发真实按键输出。" FontSize="11" Foreground="#8294A9" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
  <!-- Visible results dock, same bottom hierarchy as the approved illustration. -->
  <Border Grid.Row="3" Background="White" BorderBrush="#D7E3F1" BorderThickness="1" CornerRadius="9">
   <TabControl Background="White" BorderThickness="0">
    <TabItem Header="✔  执行结果">
     <DataGrid ItemsSource="{Binding Facts}" AutoGenerateColumns="False" IsReadOnly="True"
       CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
       RowHeaderWidth="0" BorderThickness="0" FontSize="12">
      <DataGrid.Columns>
       <DataGridTextColumn Header="阶段" Binding="{Binding Phase}" Width="72"/>
       <DataGridTextColumn Header="步骤" Binding="{Binding NodeType}" Width="150"/>
       <DataGridTextColumn Header="预期结果" Binding="{Binding Expected}" Width="*"/>
       <DataGridTextColumn Header="实际结果" Binding="{Binding Actual}" Width="*"/>
       <DataGridTextColumn Header="判定" Binding="{Binding Verdict}" Width="90"/>
       <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="105"/>
       <DataGridTextColumn Header="诊断" Binding="{Binding Diagnostic}" Width="1.2*"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="▤  日志">
     <ScrollViewer Padding="15,10" Background="White">
      <StackPanel>
       <TextBlock Text="最近运行或编辑状态" FontWeight="SemiBold" FontSize="13" Foreground="#3D5976" Margin="0,0,0,7"/>
       <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#526F8D"/>
       <TextBlock Text="{Binding PhysicalEvidencePath}" FontSize="11" Foreground="#758DA5" TextWrapping="Wrap" Margin="0,9,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="⌁  追踪记录">
     <DataGrid ItemsSource="{Binding Facts}" AutoGenerateColumns="False" IsReadOnly="True"
       CanUserAddRows="False" RowHeaderWidth="0" BorderThickness="0" FontSize="12">
      <DataGrid.Columns>
       <DataGridTextColumn Header="步骤" Binding="{Binding NodeType}" Width="145"/>
       <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="140"/>
       <DataGridTextColumn Header="操作或追踪" Binding="{Binding TraceRef}" Width="*"/>
       <DataGridTextColumn Header="诊断" Binding="{Binding Diagnostic}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
   </TabControl>
  </Border>
 </Grid>
</UserControl>