<Application x:Class="AutoTest.FieldStudio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="CanvasColor">#F2F5F8</Color>
      <SolidColorBrush x:Key="CanvasBrush" Color="#F2F5F8"/>
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#286FAC"/>
      <SolidColorBrush x:Key="LineBrush" Color="#D4DFE9"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#61758A"/>
      <SolidColorBrush x:Key="InkBrush" Color="#26394C"/>
      <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI,Microsoft YaHei UI"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="FontSize" Value="13"/></Style>
      <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI,Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="12,4"/>
        <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="BorderBrush" Value="#BAC9D8"/>
        <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#26394C"/>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#286FAC"/><Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#286FAC"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas,Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,4"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
      </Style>
      <Style TargetType="DataGrid">
        <Setter Property="RowHeight" Value="27"/><Setter Property="ColumnHeaderHeight" Value="30"/>
        <Setter Property="FontSize" Value="12"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="AutoGenerateColumns" Value="True"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
      </Style>
      <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
      </Style>
      <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
      </Style>
      <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
      <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="Padding" Value="14"/><Setter Property="CornerRadius" Value="4"/>
      </Style>
      <Style TargetType="TabItem">
        <Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="13,12"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
