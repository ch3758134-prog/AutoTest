<UserControl x:Class="AutoTest.Desktop.Testing.TestEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" FontSize="13" Background="White" Foreground="#252C34"
 PreviewKeyDown="Editor_KeyDown">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="38"/><RowDefinition Height="*"/>
   <RowDefinition Height="24"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#E1E5E9" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBox x:Name="StepSearch" Width="146" Height="26" VerticalContentAlignment="Center"
      Text="{Binding StepFind,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      ToolTip="查找并高亮步骤；Enter 下一条，Shift+Enter 上一条"
      KeyDown="StepSearch_KeyDown" Margin="0,0,4,0"/>
     <TextBlock Text="{Binding SearchMatchCount,StringFormat='{}{0} 命中'}"
      Foreground="#9B6A22" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0">
      <TextBlock.Style><Style TargetType="{x:Type TextBlock}">
       <Style.Triggers><DataTrigger Binding="{Binding StepFind}" Value="">
        <Setter Property="Visibility" Value="Collapsed"/>
       </DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
     <Button Content="＋ 添加步骤" Command="{Binding AddStepCommand}"
      Style="{StaticResource AtPrimaryButton}" Foreground="#FFFFFF"
      Margin="0,0,6,0"
      ToolTip="选中阶段/分支：追加；选中步骤：插入其下方"/>
     <Menu Background="Transparent" Height="28" Margin="0,0,6,0">
      <MenuItem Header="常用步骤 ▾" Padding="7,3" FontSize="11"
       ToolTip="先选阶段或明确的子分支，再直接选择步骤类型">
       <MenuItem Header="发送 CAN 报文" Command="{Binding QuickAddCommand}" CommandParameter="can"/>
       <MenuItem Header="停止全部周期 CAN" Command="{Binding QuickAddCommand}" CommandParameter="stop-can"/>
       <MenuItem Header="模拟 ECU 按键" Command="{Binding QuickAddCommand}" CommandParameter="key"/>
       <MenuItem Header="切换 IGN" Command="{Binding QuickAddCommand}" CommandParameter="ign"/>
       <MenuItem Header="读取 CAN 信号" Command="{Binding QuickAddCommand}" CommandParameter="read"/>
          <MenuItem Header="CAN 信号判定" Command="{Binding QuickAddCommand}" CommandParameter="assert-signal"/>
       <MenuItem Header="固定等待" Command="{Binding QuickAddCommand}" CommandParameter="wait"/>
       <Separator/>
       <MenuItem Header="IF / ELSE" Command="{Binding QuickAddCommand}" CommandParameter="if"/>
       <MenuItem Header="循环" Command="{Binding QuickAddCommand}" CommandParameter="loop"/>
       <MenuItem Header="期望判定" Command="{Binding QuickAddCommand}" CommandParameter="expect"/>
      </MenuItem>
     </Menu>
     <Button Content="检查问题" Command="{Binding PreflightCommand}" Margin="0,0,6,0"/>
     <Button Content="保存" Click="SaveEditor_Click"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="{Binding DocumentName}" FontSize="14" FontWeight="SemiBold"
      VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
     <Border Background="#F7F9FC" BorderBrush="#E1E5E9" BorderThickness="1"
      CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
      <TextBlock Text="{Binding StepCountLabel}" FontSize="10" Foreground="#64758C"/>
     </Border>
     <TextBlock Text="● 未保存" FontSize="10" Foreground="#9B6A22"
      VerticalAlignment="Center" Margin="10,0,0,0">
      <TextBlock.Style>
       <Style TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsDirty}" Value="True">
          <Setter Property="Visibility" Value="Visible"/>
         </DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- Real test execution of the currently open TEST case. -->
  <Border Grid.Row="1" Background="#F6F9F8" BorderBrush="#DCE8E3"
   BorderThickness="0,0,0,1">
   <Grid Margin="12,7">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="真实自动测试" FontWeight="SemiBold" Foreground="#42618B"
      VerticalAlignment="Center" Margin="0,0,11,0"/>
     <Button Content="确认当前用例" Command="{Binding PrepareRunApprovalCommand}"
      Margin="0,0,6,0" Padding="11,5"
      ToolTip="先检查步骤和资源版本；确认后仍需点击运行，无需手输长串授权码"/>
     <Button Content="▶ 运行当前用例" Command="{Binding RunCommand}"
      Style="{StaticResource AtPrimaryButton}" Foreground="White"
      Margin="0,0,6,0" Padding="11,5"
      ToolTip="需要连接 USB 主控、填写 ECU 编号并确认当前用例；执行真实 USB/CAN/KEY/IGN，支持停止和安全清理"/>
     <Button Content="■ 停止" Command="{Binding StopRunCommand}"
      Margin="0,0,10,0" Padding="8,5"/>
    </StackPanel>
    <TextBlock Text="{Binding RunSummary}" FontSize="11" Foreground="#687680"
     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
     ToolTip="{Binding RunSummary}"/>
   </DockPanel>
   <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
    <TextBlock Text="ECU 编号（扫码输入）：" FontWeight="SemiBold"
     Margin="0,0,7,0" VerticalAlignment="Center"/>
    <TextBox Width="315" Height="28" VerticalContentAlignment="Center"
     Text="{Binding DutIdentity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
     ToolTip="扫码枪键盘输入或现场人工输入实际 ECU 唯一编号，绝不自动生成"/>
    <TextBlock Text="本入口归档为开发运行，不计入出厂统计"
     Foreground="#7A664B" Margin="10,0,0,0" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
    <StackPanel.Style><Style TargetType="StackPanel">
     <Style.Triggers><DataTrigger Binding="{Binding ExpectedFlashApproval}" Value="">
      <Setter Property="Visibility" Value="Collapsed"/>
     </DataTrigger></Style.Triggers>
    </Style></StackPanel.Style>
    <TextBlock Text="FLASH 实体授权：" FontWeight="SemiBold"
     Margin="0,0,7,0" VerticalAlignment="Center"/>
    <TextBox Width="370" Height="28" VerticalContentAlignment="Center"
     Text="{Binding FlashApproval,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
     ToolTip="现场人员手动输入完整 AUTHORIZE ECU FLASH + SHA256；不会保存到工程"/>
    <TextBlock Text="请完整输入：" Margin="10,0,5,0" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding ExpectedFlashApproval}" MaxWidth="280"
     ToolTip="{Binding ExpectedFlashApproval}" TextTrimming="CharacterEllipsis"
     Foreground="#385F88" VerticalAlignment="Center"/>
   </StackPanel>
   </Grid>
  </Border>

  <Border Grid.Row="2" Background="#F7F8FA" BorderBrush="#E1E5E9" BorderThickness="0,0,0,1">
   <Grid Margin="0,0,8,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/>
     <ColumnDefinition Width="29*" MinWidth="185"/>
     <ColumnDefinition Width="71*" MinWidth="220"/>
     <ColumnDefinition Width="126"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="序号" FontSize="11" Foreground="#435B74"
     VerticalAlignment="Center" HorizontalAlignment="Center"/>
    <TextBlock Grid.Column="1" Text="步骤 / 流程" FontSize="11" Foreground="#435B74"
     VerticalAlignment="Center" Margin="7,0"/>
    <TextBlock Grid.Column="2" Text="主要参数 / 判据" FontSize="11" Foreground="#435B74"
     VerticalAlignment="Center" Margin="6,0"/>
    <TextBlock Grid.Column="3" Text="资源" FontSize="11" Foreground="#435B74"
     VerticalAlignment="Center" Margin="6,0"/>
    <TextBlock Grid.Column="4" Text="状态" FontSize="11" Foreground="#435B74"
     VerticalAlignment="Center" Margin="6,0"/>
   </Grid>
  </Border>

  <ListBox x:Name="StepsList" Grid.Row="3" ItemsSource="{Binding StepRows}"
   SelectedItem="{Binding SelectedRow,Mode=TwoWay}"
   SelectionChanged="StepsList_SelectionChanged"
   BorderThickness="0" Background="White"
   HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto"
   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
   VirtualizingStackPanel.IsVirtualizing="True"
   VirtualizingStackPanel.VirtualizationMode="Recycling"
   PreviewMouseRightButtonDown="StepsList_RightClick" MouseDoubleClick="StepsList_DoubleClick"
   PreviewMouseLeftButtonDown="StepsList_PreviewMouseLeftButtonDown"
   PreviewMouseMove="StepsList_PreviewMouseMove"
   AllowDrop="True" DragOver="StepsList_DragOver" Drop="StepsList_Drop">
   <ListBox.ItemContainerStyle>
    <Style TargetType="{x:Type ListBoxItem}">
     <Setter Property="Padding" Value="0"/>
     <Setter Property="MinHeight" Value="0"/>
     <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
     <Setter Property="BorderThickness" Value="0"/>
     <Setter Property="Background" Value="White"/>
     <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F4F8FD"/></Trigger>
      <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
       <Setter Property="Background" Value="#FFF5DE"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsNewDraft}" Value="True">
       <Setter Property="Background" Value="#FFF9EC"/>
      </DataTrigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#ECF3FF"/></Trigger>
     </Style.Triggers>
    </Style>
   </ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate>
    <DataTemplate>
     <Grid MinWidth="580">
      <!-- Separate inset phase headers; the canonical TEST phase/slot editing remains unchanged. -->
      <Border x:Name="PhaseRow" Style="{StaticResource AtTestPhaseHeader}"
       Visibility="{Binding IsPhase,Converter={StaticResource BoolToVisibility}}">
       <StackPanel>
       <DockPanel Height="42" Margin="11,0,9,0">
        <Button DockPanel.Dock="Right" Content="＋ 添加步骤" Tag="{Binding}" Click="AddAtRow_Click"
         Focusable="False" Style="{StaticResource AtTestPhaseAddButton}"
         ToolTip="直接在这个阶段末尾添加真实 TEST 步骤"/>
        <Border DockPanel.Dock="Right" Background="White" BorderBrush="#E4EAF3"
         BorderThickness="1" CornerRadius="4" Padding="7,3"
         VerticalAlignment="Center" Margin="0,0,10,0">
         <TextBlock Text="{Binding RowCount}" FontSize="10" Foreground="#74869B"/>
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <Button Content="{Binding ExpandMark}" Click="StepExpand_Click" Tag="{Binding}"
          Width="22" Height="24" MinWidth="0" MinHeight="0" Padding="0"
          Style="{StaticResource AtQuietButton}" Foreground="#64758C"
          ToolTip="展开或收起此阶段"/>
         <Border Width="3" Height="19" CornerRadius="2" Margin="5,0,10,0"
          VerticalAlignment="Center">
          <Border.Style>
           <Style TargetType="Border">
            <Setter Property="Background" Value="#397FBB"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding PhaseKind}" Value="Test">
              <Setter Property="Background" Value="#4E85C9"/>
             </DataTrigger>
             <DataTrigger Binding="{Binding PhaseKind}" Value="Cleanup">
              <Setter Property="Background" Value="#CA8B2E"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </Border.Style>
         </Border>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
          VerticalAlignment="Center">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#27649A"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding PhaseKind}" Value="Test">
              <Setter Property="Foreground" Value="#427CBF"/>
             </DataTrigger>
             <DataTrigger Binding="{Binding PhaseKind}" Value="Cleanup">
              <Setter Property="Foreground" Value="#9A671F"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </StackPanel>
       </DockPanel>
       <TextBlock Text="本阶段暂无步骤" FontSize="11" Foreground="#7A8DA4"
        Margin="50,1,0,7"
        Visibility="{Binding IsEmptyPhase,Converter={StaticResource BoolToVisibility}}"/>
       </StackPanel>
      </Border>

      <Border x:Name="SlotRow" Background="#FAFBFF" BorderBrush="#EDF1F6"
       BorderThickness="0,0,0,1" Height="25"
       Visibility="{Binding IsSlot,Converter={StaticResource BoolToVisibility}}">
       <DockPanel LastChildFill="True" Margin="8,0,7,0">
        <Button DockPanel.Dock="Right" Content="＋ 插入" Tag="{Binding}"
         Click="AddAtRow_Click" Focusable="False" Height="22" MinHeight="0"
         Padding="6,0" FontSize="10" Foreground="#7550AB"
         Style="{StaticResource AtQuietButton}"
         ToolTip="直接向此 THEN／ELSE／CASE／循环子分支末尾添加步骤"/>
        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}"
         VerticalAlignment="Center">
         <Button Content="{Binding ExpandMark}" Click="StepExpand_Click"
          Width="18" Height="22" MinWidth="0" MinHeight="0" Padding="0"
          Style="{StaticResource AtQuietButton}" Foreground="#7550AB"/>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
          Foreground="#7550AB" VerticalAlignment="Center" Margin="5,0,0,0"/>
        </StackPanel>
       </DockPanel>
      </Border>

      <Border x:Name="StepRow" Background="Transparent" BorderBrush="#E7EDF5"
       BorderThickness="0,0,0,1" Height="42"
       Visibility="{Binding IsStep,Converter={StaticResource BoolToVisibility}}">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="36"/>
         <ColumnDefinition Width="29*" MinWidth="185"/>
         <ColumnDefinition Width="71*" MinWidth="220"/>
         <ColumnDefinition Width="126"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
        <Border Width="3" HorizontalAlignment="Left" Panel.ZIndex="2">
         <Border.Style><Style TargetType="{x:Type Border}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="Background" Value="#3478D6"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsSearchMatch}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Background" Value="#D89826"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=IsSelected}" Value="True">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="Background" Value="#3478D6"/>
           </DataTrigger>
          </Style.Triggers>
         </Style></Border.Style>
        </Border>

        <TextBlock Grid.Column="0" Text="{Binding SequenceText}" FontSize="10"
         Foreground="#8798AB" HorizontalAlignment="Center" VerticalAlignment="Center"
         FontFamily="Consolas"/>
        <TextBlock Grid.Column="0" Text="{Binding BreakpointMark}" Foreground="#C04A57"
         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,2,0" FontSize="10"/>
        <Grid Grid.Column="1" Margin="{Binding Indent}">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="19"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <Button Grid.Column="0" Content="{Binding ExpandMark}" Click="StepExpand_Click"
          Height="23" Width="18" MinWidth="0" MinHeight="0" Padding="0"
          Style="{StaticResource AtQuietButton}" Foreground="#64758C"
          Focusable="False" ToolTip="展开／收起子步骤"/>
         <Border Grid.Column="1" Width="21" Height="21" CornerRadius="4"
          VerticalAlignment="Center" Margin="1,0">
          <Border.Style>
           <Style TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#E9EEF5"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Category}" Value="Can"><Setter Property="Background" Value="#E8F5F1"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Hardware"><Setter Property="Background" Value="#FFF0DA"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Uds"><Setter Property="Background" Value="#EEE7FA"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Flow"><Setter Property="Background" Value="#EEE7FA"/></DataTrigger>
             <DataTrigger Binding="{Binding Category}" Value="Wave"><Setter Property="Background" Value="#F3F7FC"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </Border.Style>
          <TextBlock Text="{Binding Icon}" FontSize="12"
           VerticalAlignment="Center" HorizontalAlignment="Center">
           <TextBlock.Style>
            <Style TargetType="{x:Type TextBlock}">
             <Setter Property="Foreground" Value="#66788E"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding Category}" Value="Can"><Setter Property="Foreground" Value="#3478D6"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Hardware"><Setter Property="Foreground" Value="#A26319"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Uds"><Setter Property="Foreground" Value="#7050A6"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Flow"><Setter Property="Foreground" Value="#7050A6"/></DataTrigger>
              <DataTrigger Binding="{Binding Category}" Value="Wave"><Setter Property="Foreground" Value="#475668"/></DataTrigger>
             </Style.Triggers>
            </Style>
           </TextBlock.Style>
          </TextBlock>
         </Border>
         <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold"
          TextTrimming="CharacterEllipsis" FontSize="13" Foreground="#252C34"
          VerticalAlignment="Center" ToolTip="{Binding Kind}" Margin="5,0,7,0"/>
        </Grid>
        <Grid Grid.Column="2" Margin="6,0">
         <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
          Foreground="#64737B" VerticalAlignment="Center" FontSize="13"
          Visibility="{Binding ShowQuickSummary,Converter={StaticResource BoolToVisibility}}"
          MouseLeftButtonDown="QuickSummary_MouseLeftButtonDown"
          ToolTip="步骤摘要；等待时间与循环次数可双击直接修改"/>
         <TextBox Text="{Binding QuickValue,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          Visibility="{Binding ShowInlineEditor,Converter={StaticResource BoolToVisibility}}"
          Background="White" BorderBrush="#5A9BD2" BorderThickness="1"
          Padding="4,1" Height="25" MinHeight="0" FontSize="12" Foreground="#264D74"
          VerticalAlignment="Center" VerticalContentAlignment="Center"
          ToolTip="Enter 应用到 TEST 草稿；Esc 恢复原值"
          LostFocus="QuickField_LostFocus" KeyDown="QuickField_KeyDown"/>
        </Grid>
        <TextBlock Grid.Column="3" Text="{Binding Resource}" TextTrimming="CharacterEllipsis"
         Foreground="#71849A" VerticalAlignment="Center" FontSize="11" Margin="7,0"
         ToolTip="{Binding Resource}"/>
        <TextBlock Grid.Column="4" Text="{Binding State}" TextTrimming="CharacterEllipsis"
         VerticalAlignment="Center" FontSize="11" Margin="6,0" ToolTip="{Binding StateDetail}">
         <TextBlock.Style><Style TargetType="{x:Type TextBlock}">
          <Setter Property="Foreground" Value="#748399"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsNewDraft}" Value="True">
            <Setter Property="Foreground" Value="#9B6A22"/>
            <Setter Property="FontWeight" Value="Bold"/>
           </DataTrigger>
           <DataTrigger Binding="{Binding IsUnavailable}" Value="True"><Setter Property="Foreground" Value="#B05D47"/></DataTrigger>
           <DataTrigger Binding="{Binding HasRealExecutionError}" Value="True">
            <Setter Property="Foreground" Value="#BC454F"/>
            <Setter Property="FontWeight" Value="Bold"/>
           </DataTrigger>
          </Style.Triggers>
         </Style></TextBlock.Style>
        </TextBlock>
       </Grid>
      </Border>
     </Grid>
    </DataTemplate>
   </ListBox.ItemTemplate>
  </ListBox>
  <Border Grid.Row="4" Background="#FBFCFF" BorderBrush="#E1E5E9" BorderThickness="0,1,0,0">
   <DockPanel Margin="10,0">
    <TextBlock DockPanel.Dock="Right" Text="右键 · F2 · F9 · Ctrl+Space"
     FontSize="10" Foreground="#8B9BAE" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding StatusMessage}" Foreground="#64758C" FontSize="10"
     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
  <!-- Wide grouped palette: common actions visible together, one click inserts a formal TEST draft. -->
  <Popup x:Name="ActionPalette" Placement="Center"
   PlacementTarget="{Binding ElementName=StepsList}" StaysOpen="False" AllowsTransparency="True">
   <Border x:Name="PaletteSurface" Width="740" MaxHeight="630" Background="White"
    CornerRadius="10" BorderBrush="#DFE5E4" BorderThickness="1" Padding="16,13">
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.24"/></Border.Effect>
    <DockPanel LastChildFill="True">
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="27" MinWidth="0"
       Style="{StaticResource AtQuietButton}" Click="PaletteCancel_Click"
       ToolTip="关闭步骤选择" Margin="12,0,0,0"/>
      <StackPanel>
       <TextBlock Text="添加测试步骤" FontSize="17" FontWeight="SemiBold" Foreground="#2F3C4B"/>
       <TextBlock x:Name="PaletteHint" Text="单击选项即插入，随后在右侧编辑参数"
        FontSize="11" Foreground="#64758C" Margin="0,5,0,0"/>
      </StackPanel>
     </DockPanel>
     <Border DockPanel.Dock="Top" Background="#F8FAF9" BorderBrush="#DCE5E2"
      BorderThickness="1" CornerRadius="7" Margin="0,0,0,10" Padding="6,2">
      <DockPanel>
       <TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="18" Foreground="#627C9D"
        VerticalAlignment="Center" Margin="3,0,7,0"/>
       <TextBox x:Name="PaletteSearch" TextChanged="PaletteSearch_Changed"
        KeyDown="PaletteSearch_KeyDown" ToolTip="输入 CAN、IGN、按键、等待、IF、波形等关键词"
        Height="32" BorderThickness="0" Background="Transparent"
        VerticalContentAlignment="Center" Padding="5,3"/>
      </DockPanel>
     </Border>
     <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="关闭" Click="PaletteCancel_Click"
       MinWidth="72" HorizontalAlignment="Right"/>
      <TextBlock Text="单击即添加  ·  Enter 添加所选  ·  Esc 关闭"
       Foreground="#7A8EA6" FontSize="11" VerticalAlignment="Center"/>
     </DockPanel>
     <ListBox x:Name="PaletteList" MaxHeight="430" MinHeight="160"
      MouseDoubleClick="PaletteList_DoubleClick" KeyDown="PaletteList_KeyDown"
      PreviewMouseLeftButtonUp="PaletteList_PreviewMouseLeftButtonUp"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      Background="#FAFBFB" BorderBrush="#E1E7E5" BorderThickness="1"
      FontSize="12">
      <ListBox.GroupStyle>
       <GroupStyle>
        <GroupStyle.HeaderTemplate>
         <DataTemplate>
          <Border Background="#F6F8FB" CornerRadius="5" Padding="10,7"
           Margin="5,10,5,4">
           <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
            Foreground="#455263"/>
          </Border>
         </DataTemplate>
        </GroupStyle.HeaderTemplate>
        <GroupStyle.Panel>
         <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </GroupStyle.Panel>
       </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemContainerStyle>
       <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="MinWidth" Value="270"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Margin" Value="5,3"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#DEE6E3"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
         <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#EDF6F3"/>
          <Setter Property="BorderBrush" Value="#9EBCE8"/>
         </Trigger>
         <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E8F5F1"/>
          <Setter Property="BorderBrush" Value="#89B0E9"/>
         </Trigger>
        </Style.Triggers>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
         ToolTip="{Binding Description}" TextTrimming="CharacterEllipsis"/>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
