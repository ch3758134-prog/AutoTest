<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Unified QuickUse-inspired light palette. Keep legacy brush aliases for future reuse. -->
  <Color x:Key="BackgroundColor">#F4F7FB</Color>
  <Color x:Key="PanelColor">#FFFFFF</Color>
  <Color x:Key="InkColor">#24364C</Color>
  <Color x:Key="SubtleColor">#687D94</Color>
  <Color x:Key="LineColor">#DCE5EF</Color>
  <Color x:Key="AccentColor">#587EAA</Color>
  <SolidColorBrush x:Key="Canvas" Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}"/>
  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
  <SolidColorBrush x:Key="Subtle" Color="{StaticResource SubtleColor}"/>
  <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}"/>
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
  <Color x:Key="SelectedSurfaceColor">#E6F1FF</Color>
  <Color x:Key="InactiveSelectionColor">#EDF4FD</Color>
  <SolidColorBrush x:Key="SelectedSurface" Color="{StaticResource SelectedSurfaceColor}"/>
  <SolidColorBrush x:Key="HoverSurface" Color="#EDF4FD"/>
  <SolidColorBrush x:Key="ToolbarSurface" Color="#F8FAFD"/>
  <SolidColorBrush x:Key="MutedSurface" Color="#F0F4FA"/>
  <SolidColorBrush x:Key="Ok" Color="#287C60"/>
  <SolidColorBrush x:Key="Warning" Color="#996320"/>
  <SolidColorBrush x:Key="Danger" Color="#B64353"/>
  <SolidColorBrush x:Key="White" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="DisabledSurface" Color="#EEF2F7"/>
</ResourceDictionary>