<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Title="AutoTest  |  V0 Mock Workbench" Height="650" Width="1100"
    MinHeight="530" MinWidth="920" WindowStartupLocation="CenterScreen"
    Background="#F4F6F9" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#16243A" Padding="24,17">
            <StackPanel>
                <TextBlock Text="AutoTest / INTEGRATION" FontSize="20" FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="V0   •   SIMULATION ONLY   •   NO DEVICE ACCESS   •   NO PHYSICAL OUTPUT"
                           FontWeight="SemiBold" Foreground="#F5C57E" Margin="0,7,0,0" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#D9E2EB"
                    BorderThickness="1" CornerRadius="6" Padding="15">
                <StackPanel>
                    <TextBlock Text="PRISM REGION" FontWeight="Bold" Foreground="#48586B" />
                    <ContentControl prism:RegionManager.RegionName="V0SidebarRegion"
                                    Margin="0,12,0,0" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="White" Padding="18" CornerRadius="6"
                        BorderBrush="#D9E2EB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="FAKE STATION  /  只读模拟闭环" FontWeight="Bold"
                                   FontSize="16" Foreground="#15283E" />
                        <TextBlock Text="模拟应答不等于物理执行；模拟观测不等于真实设备测量。"
                                   Foreground="#6B7789" Margin="0,5,0,12" />
                        <WrapPanel>
                            <Button Content="正常模拟" Command="{Binding NormalCommand}" />
                            <Button Content="模拟超时" Command="{Binding TimeoutCommand}" />
                            <Button Content="模拟断连" Command="{Binding DisconnectCommand}" />
                            <Button Content="无授权拒绝" Command="{Binding UnauthorizedCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Background="White" Margin="0,12,0,12"
                        BorderBrush="#D9E2EB" BorderThickness="1" CornerRadius="6" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="REQUEST" Foreground="#718195" />
                        <TextBlock Grid.Column="1" Text="ACK（命令应答）" Foreground="#718195" />
                        <TextBlock Grid.Row="1" Text="{Binding RequestStatus}" FontWeight="Bold"
                                   Margin="0,5,0,12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AckStatus}"
                                   FontWeight="Bold" Margin="0,5,0,12" />
                        <TextBlock Grid.Row="2" Text="OBSERVATION（独立观测）" Foreground="#718195" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="VERDICT（判定）"
                                   Foreground="#718195" />
                        <TextBlock Grid.Row="3" Text="{Binding ObservationStatus}"
                                   FontWeight="Bold" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Verdict}"
                                   FontWeight="Bold" Margin="0,5,0,0" />
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="White" BorderBrush="#D9E2EB"
                        BorderThickness="1" CornerRadius="6" Padding="18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="模拟事实（内存追加，不是永久记录）"
                                       FontWeight="Bold" Foreground="#15283E" />
                            <TextBlock Text="{Binding FailureReason}" Foreground="#A13D25"
                                       Margin="0,6,0,6" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding FactLines}" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="12">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#E7EDF5" Padding="20,11">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MODE: SIMULATED" FontWeight="Bold" />
                <TextBlock Text="    |    Physical output: DISABLED    |    Record: NOT COMMITTED"
                           Foreground="#47566C" />
                <TextBlock Text="    |    " />
                <TextBlock Text="{Binding BusyLabel}" Foreground="#536B8B" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
