<UserControl x:Class="AutoTest.Desktop.Shell.ProjectOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="{StaticResource UiFont}" Foreground="#26394A" Background="#F8FAFD"
 FontSize="13">
 <UserControl.Resources>
  <Style x:Key="WorkCard" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DFE7F0"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="10"/>
   <Setter Property="Padding" Value="20"/>
   <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <Style x:Key="WorkTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="18"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#213A52"/>
  </Style>
  <Style x:Key="WorkDetail" TargetType="TextBlock">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#60768B"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="WorkAction" TargetType="Button"
   BasedOn="{StaticResource AtQuietButton}">
   <Setter Property="Padding" Value="15,9"/>
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="Margin" Value="0,0,9,0"/>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"
  HorizontalScrollBarVisibility="Disabled">
  <StackPanel MaxWidth="1050" Margin="28,23,28,28">
   <TextBlock Text="ECU 工程" FontSize="13" Foreground="#6F8497"/>
   <TextBlock Text="{Binding CurrentProjectName}" FontSize="27"
    FontWeight="SemiBold" Foreground="#183A58" Margin="0,4,0,5"
    TextWrapping="Wrap"/>
   <TextBlock Text="一个 ECU 工程 · 一套有序 TEST · 一组专业资源"
    Foreground="#718699" FontSize="13" Margin="0,0,0,20"/>
   <Border Background="#FFF8ED" BorderBrush="#F0D5A3"
    BorderThickness="1" CornerRadius="8" Padding="16,14"
    Margin="0,0,0,16"
    Visibility="{Binding TestProjectRecoveryAvailable,Converter={StaticResource BoolToVisibility}}">
    <StackPanel>
     <TextBlock Text="当前 TEST 顺序无法读取" FontWeight="SemiBold"
      FontSize="15" Foreground="#8B521B"/>
     <TextBlock Text="工程文件和其他资源仍保留。可重建一份空白 TEST 顺序，再把已有用例添加进去。"
      TextWrapping="Wrap" Foreground="#7A6041" Margin="0,6,0,12"/>
     <Button Content="重建当前 TEST 项目" Command="{Binding RebuildTestProjectCommand}"
      Style="{StaticResource WorkAction}" HorizontalAlignment="Left"/>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource WorkCard}">
    <StackPanel>
     <DockPanel Margin="0,0,0,8">
      <TextBlock Text="01" Foreground="#2874B8" FontSize="20"
       FontWeight="SemiBold" DockPanel.Dock="Left" Margin="0,0,14,0"/>
      <TextBlock Text="TEST 测试程序" Style="{StaticResource WorkTitle}"/>
     </DockPanel>
     <TextBlock Text="{Binding TestProgramCount,StringFormat='当前 {0} 个测试用例'}"
      Foreground="#2F6FA8" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="编排正式检测顺序，打开用例直接编辑、调试步骤。"
      Style="{StaticResource WorkDetail}" Margin="0,7,0,16"/>
     <WrapPanel>
      <Button Content="编辑 TEST 顺序" Command="{Binding OpenFirstTestProjectCommand}"
       Style="{StaticResource AtPrimaryButton}" Padding="17,9"
       MinHeight="36" Margin="0,0,10,0"/>
      <Button Content="＋ 新建测试用例" Command="{Binding NewTestProgramCommand}"
       Style="{StaticResource WorkAction}"/>
      <Button Content="整组工程调试" Command="{Binding EnterEngineeringVerificationCommand}"
       Style="{StaticResource WorkAction}"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource WorkCard}">
    <StackPanel>
     <DockPanel Margin="0,0,0,8">
      <TextBlock Text="02" Foreground="#2874B8" FontSize="20"
       FontWeight="SemiBold" DockPanel.Dock="Left" Margin="0,0,14,0"/>
      <TextBlock Text="工程资源" Style="{StaticResource WorkTitle}"/>
     </DockPanel>
     <TextBlock Text="DBC 是文件；波形和公共流程在各自的工作台建立；FLASH 参数保存在工程内。"
      Style="{StaticResource WorkDetail}" Margin="0,0,0,14"/>
     <Grid Margin="0,0,0,13">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="*" MinWidth="140"/>
       <ColumnDefinition Width="18"/>
       <ColumnDefinition Width="*" MinWidth="140"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
       <TextBlock Text="DBC 数据库" FontWeight="SemiBold" Foreground="#375B78"/>
       <TextBlock Text="{Binding EngineeringDbcName}" Style="{StaticResource WorkDetail}"
        TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="标准波形" FontWeight="SemiBold" Foreground="#375B78" Margin="0,13,0,0"/>
       <TextBlock Text="{Binding EngineeringWaveStatus}" Style="{StaticResource WorkDetail}"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="公共流程" FontWeight="SemiBold" Foreground="#375B78"/>
       <TextBlock Text="{Binding EngineeringFlowStatus}" Style="{StaticResource WorkDetail}"/>
       <TextBlock Text="FLASH 固件" FontWeight="SemiBold" Foreground="#375B78" Margin="0,13,0,0"/>
       <TextBlock Text="{Binding EngineeringFlashStatus}" Style="{StaticResource WorkDetail}"/>
      </StackPanel>
     </Grid>
     <Button Content="打开工程资源" Command="{Binding OpenEngineeringResourcesCommand}"
      Style="{StaticResource WorkAction}" HorizontalAlignment="Left"/>
    </StackPanel>
   </Border>
   <DockPanel Margin="4,5,0,0">
    <TextBlock Text="工程修改自动保存。生产检测在扫码匹配工程后使用完整 TEST 与前置 FLASH。"
     Foreground="#73879B" FontSize="12" TextWrapping="Wrap"/>
   </DockPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>