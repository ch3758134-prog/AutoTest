<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Candidate visual tokens: development-only. Human acceptance is required
       before these become the formal AutoTest design system. -->
  <Color x:Key="Gallery.Color.Canvas">#FFF3F6F9</Color>
  <Color x:Key="Gallery.Color.Surface">#FFFFFFFF</Color>
  <Color x:Key="Gallery.Color.Toolbar">#FFF8FAFC</Color>
  <Color x:Key="Gallery.Color.Border">#FFD5DDE5</Color>
  <Color x:Key="Gallery.Color.Text">#FF243340</Color>
  <Color x:Key="Gallery.Color.SubtleText">#FF637585</Color>
  <Color x:Key="Gallery.Color.Accent">#FF1769AF</Color>
  <Color x:Key="Gallery.Color.AccentSoft">#FFE8F2FB</Color>
  <Color x:Key="Gallery.Color.Error">#FFAC3F37</Color>
  <Color x:Key="Gallery.Color.Success">#FF267247</Color>

  <SolidColorBrush x:Key="Gallery.Brush.Canvas" Color="{StaticResource Gallery.Color.Canvas}"/>
  <SolidColorBrush x:Key="Gallery.Brush.Surface" Color="{StaticResource Gallery.Color.Surface}"/>
  <SolidColorBrush x:Key="Gallery.Brush.Toolbar" Color="{StaticResource Gallery.Color.Toolbar}"/>
  <SolidColorBrush x:Key="Gallery.Brush.Border" Color="{StaticResource Gallery.Color.Border}"/>
  <SolidColorBrush x:Key="Gallery.Brush.Text" Color="{StaticResource Gallery.Color.Text}"/>
  <SolidColorBrush x:Key="Gallery.Brush.SubtleText" Color="{StaticResource Gallery.Color.SubtleText}"/>
  <SolidColorBrush x:Key="Gallery.Brush.Accent" Color="{StaticResource Gallery.Color.Accent}"/>
  <SolidColorBrush x:Key="Gallery.Brush.AccentSoft" Color="{StaticResource Gallery.Color.AccentSoft}"/>
  <SolidColorBrush x:Key="Gallery.Brush.Error" Color="{StaticResource Gallery.Color.Error}"/>
  <SolidColorBrush x:Key="Gallery.Brush.Success" Color="{StaticResource Gallery.Color.Success}"/>

  <Style TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Gallery.Brush.Text}"/>
  </Style>
  <Style x:Key="Gallery.Heading" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource Gallery.Brush.Text}"/>
  </Style>
  <Style x:Key="Gallery.Caption" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource Gallery.Brush.SubtleText}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Gallery.Button" TargetType="{x:Type Button}">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="27"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Background" Value="{StaticResource Gallery.Brush.Surface}"/>
    <Setter Property="Foreground" Value="{StaticResource Gallery.Brush.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Gallery.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Gallery.Brush.AccentSoft}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource Gallery.Brush.Accent}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Gallery.PrimaryButton" BasedOn="{StaticResource Gallery.Button}" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{StaticResource Gallery.Brush.Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="{StaticResource Gallery.Brush.Accent}"/>
  </Style>
  <Style x:Key="Gallery.TextBox" TargetType="{x:Type TextBox}">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="5,3"/>
    <Setter Property="Background" Value="{StaticResource Gallery.Brush.Surface}"/>
    <Setter Property="Foreground" Value="{StaticResource Gallery.Brush.Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Gallery.Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="Gallery.ComboBox" TargetType="{x:Type ComboBox}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="27"/>
    <Setter Property="Padding" Value="3,2"/>
  </Style>
  <Style TargetType="{x:Type TabItem}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,7"/>
  </Style>
  <Style TargetType="{x:Type DataGrid}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="RowHeight" Value="26"/>
    <Setter Property="ColumnHeaderHeight" Value="29"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Gallery.Brush.Border}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Gallery.Brush.Border}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Gallery.Brush.Border}"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
  </Style>
  <Style TargetType="{x:Type TreeViewItem}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="3,4"/>
  </Style>
</ResourceDictionary>
