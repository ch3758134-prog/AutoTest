<UserControl x:Class="AutoTest.Desktop.Tools.Dbc.DbcToolView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource StudioBg}" Foreground="{DynamicResource StudioText}"
 FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True">
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="285"/><RowDefinition Height="225"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="2,0,2,11">
   <StackPanel>
    <TextBlock Text="DBC 数据库编辑" Style="{StaticResource AtPageTitle}"/>
    <TextBlock Text="管理报文与信号定义；修改后保存文件并按需发布工程资源版本。" Style="{StaticResource AtHint}" Margin="0,4,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource AtIdeCard}" Padding="10" Margin="0,0,0,10">
   <StackPanel>
    <WrapPanel>
     <TextBlock Text="DBC 文件" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBox x:Name="DbcFilePathBox" Width="330" Text="{Binding FilePath,UpdateSourceTrigger=PropertyChanged}" ToolTip="本地 DBC 路径"/>
     <Button Content="浏览文件" Click="BrowseDbc_Click"/>
     <Button Content="导入 / 打开 DBC" Style="{StaticResource AtPrimaryButton}" Command="{Binding OpenCommand}"/>
     <Button Content="保存 DBC" Command="{Binding SaveCommand}"/>
     <Button Content="纳入工程" Command="{Binding ImportToProjectCommand}"/>
     <Button Content="发布工程修订" Command="{Binding PublishProjectRevisionCommand}"/>
     <Menu Background="Transparent">
      <MenuItem Header="更多操作 ▾"><MenuItem Header="撤销未保存编辑" Command="{Binding ResetCommand}"/></MenuItem>
     </Menu>
    </WrapPanel>
    <WrapPanel Margin="0,7,0,0">
     <TextBlock Text="当前修订：" Style="{StaticResource AtHint}"/>
     <TextBlock Text="{Binding Revision}" FontWeight="SemiBold" Margin="0,0,12,0"/>
     <TextBlock Text="{Binding ProjectStatus}" Foreground="{DynamicResource StudioMuted}" TextTrimming="CharacterEllipsis"/>
    </WrapPanel>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="260" MinWidth="215"/><ColumnDefinition Width="6"/>
    <ColumnDefinition Width="*" MinWidth="265"/><ColumnDefinition Width="6"/>
    <ColumnDefinition Width="352" MinWidth="290"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource AtIdeCard}" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Style="{StaticResource AtBlueHeading}">
      <TextBlock Text="数据库 / 报文" Style="{StaticResource AtEditorHeading}"/>
     </Border>
     <StackPanel DockPanel.Dock="Bottom" Margin="9,8">
      <TextBlock Text="报文 ID（十六进制）" Style="{StaticResource AtFieldLabel}"/>
      <TextBox Text="{Binding NewMessageId,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="报文名称" Style="{StaticResource AtFieldLabel}"/>
      <TextBox Text="{Binding NewMessageName,UpdateSourceTrigger=PropertyChanged}"/>
      <WrapPanel Margin="0,7,0,0">
       <TextBlock Text="长度 DLC" VerticalAlignment="Center"/>
       <TextBox Text="{Binding NewMessageDlc,UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="7,0,12,0"/>
       <TextBlock Text="发送方" VerticalAlignment="Center"/>
       <TextBox Text="{Binding Transmitter,UpdateSourceTrigger=PropertyChanged}" Width="93" Margin="7,0,0,0"/>
      </WrapPanel>
      <WrapPanel Margin="0,8,0,0">
       <Button Content="＋ 新建报文" Command="{Binding AddMessageCommand}" Style="{StaticResource AtPrimaryButton}"/>
       <Button Content="更新" Command="{Binding UpdateMessageCommand}"/>
       <Button Content="删除" Command="{Binding DeleteMessageCommand}"/>
      </WrapPanel>
      <WrapPanel Margin="0,5,0,0">
       <TextBox Width="130" Text="{Binding NewNodeName,UpdateSourceTrigger=PropertyChanged}" ToolTip="发送/接收节点名称"/>
       <Button Content="添加节点" Command="{Binding AddNodeCommand}"/>
      </WrapPanel>
     </StackPanel>
     <ListBox ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage,Mode=TwoWay}" BorderThickness="0" Margin="7">
      <ListBox.ItemTemplate><DataTemplate>
       <StackPanel Orientation="Horizontal" Margin="3,4">
        <TextBlock Text="▤" Foreground="{DynamicResource StudioAccent}" Margin="0,0,9,0"/>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
       </StackPanel>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Column="2" Style="{StaticResource AtIdeCard}" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Style="{StaticResource AtBlueHeading}">
      <DockPanel>
       <TextBlock Text="信号列表" Style="{StaticResource AtEditorHeading}"/>
       <TextBlock DockPanel.Dock="Right" Text="选择信号后在右侧编辑属性" Style="{StaticResource AtHint}"/>
      </DockPanel>
     </Border>
     <StackPanel DockPanel.Dock="Bottom" Margin="9,9">
      <WrapPanel>
       <TextBlock Text="信号名称" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <TextBox Width="185" Text="{Binding SignalName,UpdateSourceTrigger=PropertyChanged}"/>
       <Button Content="＋ 新建信号" Command="{Binding AddSignalCommand}" Style="{StaticResource AtPrimaryButton}"/>
       <Button Content="删除信号" Command="{Binding DeleteSignalCommand}"/>
      </WrapPanel>
     </StackPanel>
     <DataGrid ItemsSource="{Binding Signals}" SelectedItem="{Binding SelectedSignal,Mode=TwoWay}" BorderThickness="0"
      IsReadOnly="True" AutoGenerateColumns="False" RowHeaderWidth="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="信号名称" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="起始位" Binding="{Binding StartBit}" Width="70"/>
       <DataGridTextColumn Header="位数" Binding="{Binding BitLength}" Width="60"/>
       <DataGridTextColumn Header="比例" Binding="{Binding Factor}" Width="70"/>
       <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Column="4" Style="{StaticResource AtIdeCard}" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Style="{StaticResource AtBlueHeading}">
      <TextBlock Text="信号属性" Style="{StaticResource AtEditorHeading}"/>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="12">
       <TextBlock Text="名称" Style="{StaticResource AtFieldLabel}"/>
       <TextBox Text="{Binding SignalName,UpdateSourceTrigger=PropertyChanged}"/>
       <UniformGrid Columns="2">
        <StackPanel Margin="0,3,6,0"><TextBlock Text="起始位" Style="{StaticResource AtFieldLabel}"/><TextBox Text="{Binding StartBit,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="6,3,0,0"><TextBlock Text="位长度" Style="{StaticResource AtFieldLabel}"/><TextBox Text="{Binding BitLength,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="0,3,6,0"><TextBlock Text="比例因子" Style="{StaticResource AtFieldLabel}"/><TextBox Text="{Binding Factor,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="6,3,0,0"><TextBlock Text="偏移量" Style="{StaticResource AtFieldLabel}"/><TextBox Text="{Binding Offset,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="0,3,6,0"><TextBlock Text="最小值" Style="{StaticResource AtFieldLabel}"/><TextBox Text="{Binding Minimum,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
        <StackPanel Margin="6,3,0,0"><TextBlock Text="最大值" Style="{StaticResource AtFieldLabel}"/><TextBox Text="{Binding Maximum,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       </UniformGrid>
       <TextBlock Text="单位" Style="{StaticResource AtFieldLabel}"/>
       <TextBox Text="{Binding Unit,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="接收节点" Style="{StaticResource AtFieldLabel}"/>
       <TextBox Text="{Binding Receiver,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="复用规则（Mux）" Style="{StaticResource AtFieldLabel}"/>
       <TextBox Text="{Binding Mux,UpdateSourceTrigger=PropertyChanged}"/>
       <WrapPanel Margin="0,10,0,6">
        <CheckBox Content="小端字节序（Intel）" IsChecked="{Binding Intel}" Margin="0,0,14,0"/>
        <CheckBox Content="有符号" IsChecked="{Binding Signed}"/>
       </WrapPanel>
       <Button Content="保存信号属性" Command="{Binding UpdateSignalCommand}" Style="{StaticResource AtPrimaryButton}"/>
       <Separator Margin="0,12,0,7"/>
       <TextBlock Text="原始值表" Style="{StaticResource AtSectionTitle}" Margin="0,0,0,7"/>
       <WrapPanel>
        <TextBox Width="65" Text="{Binding LabelRaw,UpdateSourceTrigger=PropertyChanged}" ToolTip="原始值" Margin="0,0,7,0"/>
        <TextBox Width="135" Text="{Binding ValueLabel,UpdateSourceTrigger=PropertyChanged}" ToolTip="显示文本"/>
        <Button Content="设置值表" Command="{Binding LabelCommand}"/>
       </WrapPanel>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource AtIdeCard}" Padding="0" Margin="0,10,0,0">
   <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource AtBlueHeading}">
     <TextBlock Text="报文与信号预览 · 离线解码" Style="{StaticResource AtEditorHeading}"/>
    </Border>
    <Grid Margin="9">
     <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <TextBlock Text="待解码的 CAN 帧" Style="{StaticResource AtSectionTitle}"/>
      <TextBlock Text="报文 ID（十六进制）" Style="{StaticResource AtFieldLabel}"/>
      <TextBox Text="{Binding ReplayFrameId,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="8 字节数据（HEX）" Style="{StaticResource AtFieldLabel}"/>
      <TextBox Text="{Binding ReplayHex,UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="解码预览" Command="{Binding ReplayCommand}" Style="{StaticResource AtPrimaryButton}" Margin="0,9,0,0" HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding DecodeSummary}" Style="{StaticResource AtHint}" Margin="0,8,0,0" TextWrapping="Wrap"/>
     </StackPanel>
     <DataGrid Grid.Column="2" ItemsSource="{Binding Decoded}" IsReadOnly="True" AutoGenerateColumns="False" RowHeaderWidth="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="信号名" Binding="{Binding SignalName}" Width="2*"/>
       <DataGridTextColumn Header="原始值" Binding="{Binding RawValue}" Width="*"/>
       <DataGridTextColumn Header="物理值" Binding="{Binding PhysicalValue}" Width="*"/>
       <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="70"/>
       <DataGridTextColumn Header="值表" Binding="{Binding ValueDescription}" Width="2*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </DockPanel>
  </Border>
  <StackPanel Grid.Row="4" Margin="3,7,0,0">
   <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
   <TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/>
   <TextBlock Text="此处为离线报文解码；真实 CAN 发送请使用独立手动台架。" Style="{StaticResource AtHint}"/>
  </StackPanel>
 </Grid>
</UserControl>