<UserControl x:Class="AutoTest.Desktop.Tools.Testing.R1ProjectTestRunView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource StudioBg}" Foreground="{DynamicResource StudioText}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <UserControl.Resources>
  
  
  
 </UserControl.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,14">
   <TextBlock Text="自动测试运行" Style="{StaticResource AtPageTitle}"/>
   <TextBlock Text="{Binding DocumentName}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,3"/>
   <TextBlock Text="{Binding ProjectAssetStatus}" Foreground="#2B7BCB" TextWrapping="Wrap"/>
   <TextBlock Text="P10 与 P11 使用同一个测试程序实例。真实执行仅允许经过工程版本固定、操作员授权的 CAN1 只读 Observe / Assert；物理输出和烧录仍被锁定。"
              Foreground="#90611A" Margin="0,8,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{DynamicResource StudioLine}" BorderThickness="1" Padding="12">
   <WrapPanel>
    <Button Content="预检当前 TEST" Command="{Binding PreflightCommand}"/>
    <Button Content="发布 TEST 至工程" Command="{Binding SaveToProjectCommand}"/>
    <Button Content="从工程重载 TEST" Command="{Binding ReloadProjectCommand}"/>
    <Button Content="运行当前测试" Style="{StaticResource AtPrimaryButton}" Command="{Binding RunPhysicalReadOnlyCommand}"
            Background="#3188ED" FontWeight="Bold"/>
    
    <Button Content="暂停" Command="{Binding PauseCommand}"/>
    <Button Content="继续" Command="{Binding ResumeCommand}"/>
    <Button Content="单步" Command="{Binding StepCommand}"/>
    <Button Content="停止" Style="{StaticResource AtDangerButton}" Command="{Binding StopCommand}" Foreground="#B53D4B"/>
   </WrapPanel>
  </Border>
  <StackPanel Grid.Row="2" Margin="2,12">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" Foreground="#90611A" Margin="0,5"/>
   <TextBlock Text="{Binding PhysicalEvidencePath, StringFormat=本地实测证据：{0}}"
              TextWrapping="Wrap" Foreground="#2B7BCB"/>
  </StackPanel>
  <DataGrid Grid.Row="3" ItemsSource="{Binding Facts}" IsReadOnly="True"
            AutoGenerateColumns="False" CanUserAddRows="False" RowHeaderWidth="0">
   <DataGrid.Columns>
    <DataGridTextColumn Header="阶段" Binding="{Binding Phase}" Width="70"/>
    <DataGridTextColumn Header="步骤" Binding="{Binding NodeType}" Width="110"/>
    <DataGridTextColumn Header="预期" Binding="{Binding Expected}" Width="*"/>
    <DataGridTextColumn Header="实际" Binding="{Binding Actual}" Width="*"/>
    <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="90"/>
    <DataGridTextColumn Header="判定" Binding="{Binding Verdict}" Width="90"/>
    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="90"/>
    <DataGridTextColumn Header="Trace" Binding="{Binding TraceReference}" Width="150"/>
    <DataGridTextColumn Header="Diagnostic" Binding="{Binding Diagnostic}" Width="2*"/>
    <DataGridTextColumn Header="Generation" Binding="{Binding SessionGeneration}" Width="90"/>
   </DataGrid.Columns>
  </DataGrid>
 </Grid>
</UserControl>