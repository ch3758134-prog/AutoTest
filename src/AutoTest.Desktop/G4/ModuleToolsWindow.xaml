<Window x:Class="AutoTest.Desktop.G4.ModuleToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoTest G4-LAB · 模块工作台" Width="1440" Height="900"
        MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="#142131" Foreground="#E6EFFB" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Background="#513B19" Padding="10" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="查看审计 / 导出" Click="OpenAudit_Click"
                        Padding="12,4" Margin="12,0,0,0"/>
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="R0-LAB 专项工作台 · Mock/Replay 与 Physical 分离 · 本窗口不发送物理输出"/>
                    <TextBlock x:Name="AuditStatus" FontSize="11" TextTrimming="CharacterEllipsis"
                               ToolTip="页面打开记录只表示 UI 导航，不能证明 USB/CAN/UDS 或真实输出。"
                               Text="审计待命 · 当前仅记录 UI 导航，不代表通信成功"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TabControl x:Name="SpecialistTabs" Background="#1B2A40" Foreground="#EAF3FF">
            <TabItem Header="控制器配置" Tag="controller-config"><ContentControl x:Name="ControllerConfigHost"/></TabItem>
            <TabItem Header="DBC 编辑 / Replay" Tag="dbc"><ContentControl x:Name="DbcHost"/></TabItem>
            <TabItem Header="TEST 编辑 / Mock" Tag="test"><ContentControl x:Name="TestHost"/></TabItem>
            <TabItem Header="SCAN / Production Mock" Tag="production"><ContentControl x:Name="ProductionHost"/></TabItem>
            <TabItem Header="运行历史 / Records" Tag="records"><ContentControl x:Name="RecordsHost"/></TabItem>
            <TabItem Header="操作审计 / Trace" Tag="operations" x:Name="OperationsTab"><ContentControl x:Name="OperationsHost"/></TabItem>
            <TabItem Header="UDS / ISO-TP Mock" Tag="uds"><ContentControl x:Name="UdsHost"/></TabItem>
            <TabItem Header="Flash / Dry-run" Tag="flash"><ContentControl x:Name="FlashHost"/></TabItem>
            <TabItem Header="Wave / CAN Hub Replay" Tag="wave"><ContentControl x:Name="WaveHost"/></TabItem>
            <TabItem Header="U-BENCH 状态控制" Tag="bench">
                <Grid Margin="28">
                    <StackPanel VerticalAlignment="Top" MaxWidth="920">
                        <TextBlock Text="U-BENCH 控制适配器尚未接入" FontSize="22" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock TextWrapping="Wrap" FontSize="15"
                                   Text="此页不创建伪造的 IBenchWorkbenchPort，也不提供按钮输出。当前可使用主窗口“DEVICE B0/B1/B2 只读诊断”进行设备枚举、人工确认后的手动连接、固件只读查询及被动 CAN 接收。控制器状态执行与测量持久化需在共享 DEVICE / PROJECT / RECORD 适配器接入后开放。"/>
                        <TextBlock Text="Software UI: NOT_CONNECTED · Physical output: DENY" FontFamily="Consolas" Foreground="#FFD28A" Margin="0,20,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
