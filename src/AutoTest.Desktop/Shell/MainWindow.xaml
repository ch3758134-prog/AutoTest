<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoTest" Width="1280" Height="800" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <TextBlock Text="AutoTest" FontSize="18" FontWeight="SemiBold"
                 Margin="20,0" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Row="1" Width="500" HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock Text="工作区尚未接入" FontSize="20" FontWeight="SemiBold"
                 Margin="0,0,0,12"/>
      <TextBlock Text="已移除旧版本的工程编辑适配器和模拟运行工作台。此窗口不提供设备控制、测试执行或生产判定。"
                 TextWrapping="Wrap" Foreground="{StaticResource Subtle}"/>
    </StackPanel>
  </Grid>
</Window>
