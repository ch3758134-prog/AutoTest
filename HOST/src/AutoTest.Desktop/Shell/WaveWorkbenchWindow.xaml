<Window x:Class="AutoTest.Desktop.Shell.WaveWorkbenchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · ECU 信号波形工作台"
 Width="1420" Height="870" MinWidth="820" MinHeight="490"
 WindowStartupLocation="CenterOwner" WindowState="Maximized"
 FontFamily="{StaticResource UiFont}" FontSize="14"
 Foreground="#243447" Background="#F1F5F9" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="WavePanel" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#CBD5E1"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="5"/>
  </Style>
  <Style x:Key="WaveLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#42566C"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="WaveButton" TargetType="Button">
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
   <Setter Property="FontSize" Value="14"/>
  </Style>
  <Style x:Key="WaveInput" TargetType="TextBox">
   <Setter Property="MinHeight" Value="33"/>
   <Setter Property="Padding" Value="7,4"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="36"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1"
   BorderThickness="0,0,0,1" Padding="14,7">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="True">
     <TextBlock DockPanel.Dock="Right" Text="{Binding ToolUsbStatus}" FontSize="12"
      Foreground="#52677D" VerticalAlignment="Center" MaxWidth="280"
      TextTrimming="CharacterEllipsis" Margin="9,0,0,0"
      ToolTip="{Binding ToolUsbStatus}"/>
     <StackPanel>
      <TextBlock Text="波形分析" FontSize="19" FontWeight="SemiBold"
       Foreground="#1E3E5B"/>
      <TextBlock Text="{Binding SourceDescription}" FontSize="11" Foreground="#5B7188"
       TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceDescription}"/>
     </StackPanel>
    </DockPanel>
    <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
     <Button Content="连接 USB" Command="{Binding ConnectToolUsbCommand}"
      Style="{StaticResource WaveButton}"/>
     <Button Content="断开" Command="{Binding DisconnectToolUsbCommand}"
      Style="{StaticResource WaveButton}"/>
     <Menu Background="White" VerticalAlignment="Center" Margin="0,0,7,0">
      <MenuItem Header="波形来源 ▾">
       <MenuItem Header="打开独立波形目录…" Click="OpenWaveFolder_Click"/>
       <MenuItem Header="使用当前工程波形"
        IsEnabled="{Binding HasEcuProject}" Click="UseProjectWaveSource_Click"/>
      </MenuItem>
     </Menu>
     <Button Content="刷新记录" Command="{Binding RefreshCommand}"
      Style="{StaticResource WaveButton}"/>
     <Button Content="判定配置" Click="OpenConfiguration_Click"
      IsEnabled="{Binding CanEditProjectWaveSettings}"
      Style="{StaticResource WaveButton}"
      ToolTip="编辑工程中的 TEST 波形判定条件"/>
    </WrapPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="#FAFBFD" BorderBrush="#CBD5E1"
   BorderThickness="0,0,0,1" Padding="12,7">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Grid.Row="0" VerticalAlignment="Center">
     <Button Content="开始观察" Command="{Binding StartObserveCommand}"
      Style="{StaticResource AtPrimaryButton}" MinHeight="33" Padding="12,5"
      Margin="0,0,7,0" ToolTip="观察真实接收信号，不自动保存为证据"/>
     <Button Content="停止观察" Command="{Binding StopObserveCommand}"
      Style="{StaticResource WaveButton}"/>
     <Button Content="开始记录" Command="{Binding StartCaptureCommand}"
      Style="{StaticResource WaveButton}" ToolTip="采集真实时间序列并生成证据"/>
     <Button Content="停止记录" Command="{Binding StopCaptureCommand}"
      Style="{StaticResource WaveButton}"/>
     <Button Content="{Binding PauseLabel}" Command="{Binding PausePreviewCommand}"
      Style="{StaticResource WaveButton}" ToolTip="只暂停画面，不停止证据采集"/>
    </WrapPanel>
    <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,0">
     <TextBlock Text="记录时长" Style="{StaticResource WaveLabel}" Margin="0,0,5,0"/>
     <ComboBox Width="118" Height="31" ItemsSource="{Binding DurationChoices}"
      DisplayMemberPath="Label" SelectedItem="{Binding SelectedDuration,Mode=TwoWay}"
      ToolTip="到时自动保存证据；手动停止最长 60 分钟" Margin="0,0,14,0"/>
     <TextBlock Text="时间窗" Style="{StaticResource WaveLabel}" Margin="0,0,5,0"/>
     <ComboBox Width="104" Height="31" ItemsSource="{Binding WindowChoices}"
      DisplayMemberPath="Label" SelectedItem="{Binding SelectedWindow,Mode=TwoWay}"
      Margin="0,0,9,0"/>
     <Button Content="◀" Command="{Binding EarlierWindowCommand}"
      MinHeight="30" Padding="8,3" Margin="0,0,5,0"
      ToolTip="向前浏览半个时间窗"/>
     <Button Content="▶" Command="{Binding LaterWindowCommand}"
      MinHeight="30" Padding="8,3" Margin="0,0,5,0"
      ToolTip="向后浏览半个时间窗"/>
     <Button Content="最新" Command="{Binding LatestWindowCommand}"
      MinHeight="30" Padding="9,3" ToolTip="回到最新样本"/>
    </WrapPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="12,12,12,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="260" MinWidth="220"/>
    <ColumnDefinition Width="7"/>
    <ColumnDefinition Width="*" MinWidth="440"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource WavePanel}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="1.6*"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="12,12,12,7">
      <DockPanel>
       <TextBlock Text="当前观察信号" FontSize="17" FontWeight="Bold" Foreground="#1F3C58"/>
       <TextBlock DockPanel.Dock="Right" Text="{Binding LiveSourceStatus}" FontSize="12"
        Foreground="#60758B" HorizontalAlignment="Right"/>
      </DockPanel>
      <TextBlock Text="从工程 DBC 选择信号；每路独立显示数值和质量"
       FontSize="12" Foreground="#52677D" Margin="0,4,0,8"/>
      <ComboBox ItemsSource="{Binding AvailableSignals}" DisplayMemberPath="Label"
       SelectedItem="{Binding SelectedSignal,Mode=TwoWay}" Height="35" IsTextSearchEnabled="True"
       ToolTip="工程 DBC 信号（不使用模拟数据）"/>
      <Button Content="+ 添加到观察" Command="{Binding AddSignalCommand}"
       Style="{StaticResource WaveButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
     </StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}"
      SelectedItem="{Binding SelectedTrack,Mode=TwoWay}"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      BorderThickness="0" Margin="8,0,8,6" Background="White">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Border BorderBrush="#E0E6ED" BorderThickness="0,0,0,1" Padding="5,10">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="5"/>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="60"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{Binding Color}" CornerRadius="2"/>
          <StackPanel Grid.Column="1" Margin="10,0,3,0">
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
            Foreground="#20354B" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Subtitle}" Foreground="#52677D" FontSize="12"
            TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Latest}" FontSize="19" FontWeight="Bold"
            Foreground="#1D4B76" Margin="0,5,0,2"/>
           <TextBlock Text="{Binding State}" FontSize="12">
            <TextBlock.Style><Style TargetType="TextBlock">
             <Setter Property="Foreground" Value="#946000"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding State}" Value="接收正常">
               <Setter Property="Foreground" Value="#17633B"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="时间序列异常">
               <Setter Property="Foreground" Value="#B42318"/>
               <Setter Property="FontWeight" Value="Bold"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding State}" Value="曾出现数据缺口">
               <Setter Property="Foreground" Value="#B42318"/>
              </DataTrigger>
             </Style.Triggers>
            </Style></TextBlock.Style>
           </TextBlock>
           <TextBlock Text="{Binding ClockLabel}" FontSize="11"
            Foreground="#52677D" Margin="0,3,0,0" TextWrapping="Wrap"/>
           <TextBlock Text="{Binding Received,StringFormat='样本 {0}'}"
            FontSize="11" Foreground="#52677D" Margin="0,2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Top">
           <CheckBox Content="显示" IsChecked="{Binding Visible,Mode=TwoWay}"
            FontSize="12" Margin="0,1,0,7"/>
           <CheckBox Content="阶梯" IsChecked="{Binding StepStyle,Mode=TwoWay}"
            FontSize="12" Margin="0,0,0,7"
            ToolTip="离散/枚举状态建议阶梯显示；不修改实际采集证据"/>
           <Button Content="移除" FontSize="12" Padding="4,4"
            Command="{Binding DataContext.RemoveTrackCommand,RelativeSource={RelativeSource AncestorType=Window}}"
            CommandParameter="{Binding}" ToolTip="停止观察后可编辑信号集合"/>
          </StackPanel>
         </Grid>
        </Border>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
      ResizeDirection="Rows" Background="#D6E0EA"/>
     <TabControl Grid.Row="3" Margin="8,3,8,8" Background="White">
      <TabItem Header="同次采集">
       <ListBox ItemsSource="{Binding Sessions}"
        SelectedItem="{Binding SelectedSession,Mode=TwoWay}" BorderThickness="0"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate><DataTemplate>
         <StackPanel Margin="6,8">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#52677D"
           TextWrapping="Wrap" Margin="0,3,0,0"/>
         </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </TabItem>
      <TabItem Header="原始记录">
       <ListBox ItemsSource="{Binding Captures}"
        SelectedItem="{Binding Selected,Mode=TwoWay}" BorderThickness="0"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate><DataTemplate>
         <StackPanel Margin="6,8">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#52677D"
           TextWrapping="Wrap" Margin="0,3,0,0"/>
         </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </TabItem>
      <TabItem Header="比较证据">
       <ListBox ItemsSource="{Binding Comparisons}"
        SelectedItem="{Binding Selected,Mode=TwoWay}" BorderThickness="0"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate><DataTemplate>
         <StackPanel Margin="6,8">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#52677D"
           TextWrapping="Wrap" Margin="0,3,0,0"/>
         </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </TabItem>
      <TabItem Header="参考波形">
       <ListBox ItemsSource="{Binding References}"
        SelectedItem="{Binding SelectedReference,Mode=TwoWay}" BorderThickness="0"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate><DataTemplate>
         <StackPanel Margin="6,8">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Text="{Binding Signal.SignalName}" FontSize="12"
           Foreground="#52677D" Margin="0,3,0,4"/>
          <Button Content="查看波形" Padding="6,4" FontSize="12"
           Command="{Binding DataContext.ViewReferenceCommand,RelativeSource={RelativeSource AncestorType=Window}}"
           CommandParameter="{Binding}"
           ToolTip="打开此参考波形；选择实际记录后可进行叠加比较"/>
         </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </TabItem>
     </TabControl>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="7" Background="Transparent"
    ResizeDirection="Columns"/>
   <Border Grid.Column="2" Style="{StaticResource WavePanel}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="47"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Border BorderBrush="#D8E1EB" BorderThickness="0,0,0,1">
      <DockPanel Margin="15,0">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="实时观察" Command="{Binding ShowLiveCommand}"
         Style="{StaticResource WaveButton}"/>
        <Button Content="历史分析" Command="{Binding ShowArchiveCommand}"
         Style="{StaticResource WaveButton}"/>
        <CheckBox Content="历史阶梯线" IsChecked="{Binding HistoryStepStyle,Mode=TwoWay}"
         VerticalAlignment="Center" Margin="0,0,14,0" FontSize="13"
         ToolTip="对离散状态信号使用阶梯显示；不影响存储采样或正式判定"/>
        <Button Content="清除游标" Click="ClearCursors_Click"
         Style="{StaticResource WaveButton}" Margin="0"/>
       </StackPanel>
       <TextBlock Text="{Binding DisplayMode}" FontSize="17" FontWeight="Bold"
        Foreground="#1F3C58" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <Grid Grid.Row="1" Margin="10,10,10,6">
      <ScrollViewer x:Name="WavePlotViewport" VerticalScrollBarVisibility="Auto"
       HorizontalScrollBarVisibility="Disabled" Background="#FCFDFE">
       <Canvas x:Name="WavePlot" Height="480"
        Width="{Binding ActualWidth,ElementName=WavePlotViewport}"
        Background="#FCFDFE" SizeChanged="WavePlot_SizeChanged"
        MouseLeftButtonDown="WavePlot_Click"/>
      </ScrollViewer>
      <TextBlock Text="{Binding EmptyWaveMessage}"
       HorizontalAlignment="Center" VerticalAlignment="Center"
       TextAlignment="Center" Foreground="#627A93" FontSize="16"
       FontWeight="SemiBold" TextWrapping="Wrap" IsHitTestVisible="False"
       MaxWidth="510" Margin="24"/>
     </Grid>
     <Border Grid.Row="2" BorderBrush="#D8E1EB" BorderThickness="0,1,0,0"
      Background="#FFFFFF" Padding="14,10">
      <StackPanel>
       <TextBlock Text="{Binding CursorInfo}" FontSize="13" Foreground="#295A85"
        FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Info}" FontSize="13" Foreground="#52677D"
        Margin="0,0,0,5" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding DataQuality}" FontSize="12"
        Foreground="#52677D" Margin="0,0,0,9" TextWrapping="Wrap"/>
       <Expander Header="参考波形与比较参数" IsExpanded="False"
        Foreground="#35536F" FontSize="12" Margin="0,0,0,6"
        ToolTip="展开后采集标准参考或调整离线比较容差；不影响实时观察与记录">
        <StackPanel Margin="0,7,0,2">
       <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
        <TextBlock Text="参考名称" Style="{StaticResource WaveLabel}" Margin="0,0,7,0"/>
        <TextBox Text="{Binding ReferenceName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource WaveInput}" Width="194" Margin="0,0,8,0"/>
        <Button Content="将当前记录存为参考" Command="{Binding SaveReferenceCommand}"
         Style="{StaticResource WaveButton}" ToolTip="只有原始真实采集证据能建立参考；并不会自动修改测试标准"/>
       </WrapPanel>
       <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
        <TextBlock Text="比较类型" Style="{StaticResource WaveLabel}" Margin="0,0,6,0"/>
        <ComboBox Width="204" Height="31" ItemsSource="{Binding CompareModes}"
         SelectedItem="{Binding SelectedCompareMode,Mode=TwoWay}"
         DisplayMemberPath="Label" Margin="0,0,10,0"/>
        <TextBlock Text="离散状态按实测跳变区间判定，不作中间值插值"
         FontSize="11" Foreground="#61758A" VerticalAlignment="Center"/>
       </WrapPanel>
       <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="绝对容差" Style="{StaticResource WaveLabel}" Margin="0,0,6,0"/>
        <TextBox Width="77" Style="{StaticResource WaveInput}" Margin="0,0,13,0"
         Text="{Binding AbsoluteToleranceText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="最小覆盖率" Style="{StaticResource WaveLabel}" Margin="0,0,6,0"/>
        <TextBox Width="70" Style="{StaticResource WaveInput}" Margin="0,0,10,0"
         Text="{Binding MinimumCoverageText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="与所选参考比较" Command="{Binding CompareCommand}"
         Style="{StaticResource WaveButton}"/>
        <Button Content="清除叠加" Command="{Binding ClearComparisonCommand}"
         Style="{StaticResource WaveButton}"/>
       </WrapPanel>
        </StackPanel>
       </Expander>
       <TextBlock Text="{Binding ComparisonSummary}" FontSize="13" FontWeight="SemiBold"
        Margin="0,7,0,0" TextWrapping="Wrap">
        <TextBlock.Style><Style TargetType="TextBlock">
         <Setter Property="Foreground" Value="#35536F"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding ComparisonTone}" Value="Pass">
           <Setter Property="Foreground" Value="#17633B"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding ComparisonTone}" Value="Fail">
           <Setter Property="Foreground" Value="#B42318"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding ComparisonTone}" Value="Warning">
           <Setter Property="Foreground" Value="#9A5600"/>
          </DataTrigger>
         </Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
       <TextBlock Text="比较只供独立分析；正式 PASS/FAIL 由 TEST 使用已保存的判定条件执行。"
        Foreground="#61758A" FontSize="12" Margin="0,5,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#D0D9E2"
   BorderThickness="0,1,0,0" Padding="12,6">
   <TextBlock Text="{Binding Status}" FontSize="13" Foreground="#334D67"
    TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
  </Border>
 </Grid>
</Window>