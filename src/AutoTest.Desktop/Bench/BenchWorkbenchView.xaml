<UserControl x:Class="AutoTest.Desktop.Bench.BenchWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F6F8FB" Foreground="#23374D" FontFamily="Segoe UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Ink" Color="#23374D"/>
  <SolidColorBrush x:Key="Muted" Color="#657D95"/>
  <SolidColorBrush x:Key="Rule" Color="#DCE5EF"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Padding" Value="11,6"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="#F7FAFE"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="#CBD9E8"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D4E0EC"/>
   <Setter Property="Padding" Value="6,4"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D4E0EC"/>
  </Style>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="KeySwitch" TargetType="CheckBox">
   <Setter Property="Margin" Value="4"/>
   <Setter Property="Padding" Value="9,7"/>
   <Setter Property="Foreground" Value="#29435D"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="RowBackground" Value="#FFFFFF"/>
   <Setter Property="AlternatingRowBackground" Value="#F7FAFC"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#E7EDF4"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="RowHeight" Value="29"/>
   <Setter Property="ColumnHeaderHeight" Value="30"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F0F5FA"/>
   <Setter Property="Foreground" Value="#4F6B85"/>
   <Setter Property="Padding" Value="9,5"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Padding" Value="7,3"/>
  </Style>
 </UserControl.Resources>

 <Grid Margin="15">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="280"/>
   <RowDefinition Height="182" MinHeight="120"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="设备连接…" Click="OpenStation_Click"
     ToolTip="打开共用的真实 WinUSB 主控连接窗口；本手动台架不会创建第二条 USB 会话"/>
    <Button Content="刷新状态/工程" Command="{Binding RefreshCommand}" Margin="0"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="手动台架" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="真实 ECU 外部激励 · KEY_SIM 20 路组合开关 / CAN0 · 操作与证据分离"
     Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="12,10">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="1.2*"/>
     <ColumnDefinition Width="1.2*"/>
     <ColumnDefinition Width="1.5*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="共享主控 / WinUSB" FontSize="11" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{Binding ConnectionStatus}" FontSize="15" FontWeight="SemiBold"
      Margin="0,5,0,2"/>
     <TextBlock Text="{Binding DeviceIdentity}" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding DeviceIdentity}" FontSize="11" Foreground="{StaticResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="10,0,0,0">
     <TextBlock Text="当前工程 / Controller Profile" FontSize="11" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{Binding ProjectName}" FontSize="13" FontWeight="SemiBold"
      Margin="0,5,0,2" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Revision, StringFormat=Revision {0}}" FontSize="11"
      Foreground="{StaticResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Margin="10,0,0,0">
     <TextBlock Text="主控会话 / 诊断说明" FontSize="11" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{Binding ConnectionDetail}" TextWrapping="Wrap" FontSize="11"
      Foreground="#57718B" Margin="0,5,0,0" MaxHeight="47"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="2" Margin="0,0,0,12">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.55*" MinWidth="415"/>
    <ColumnDefinition Width="12"/>
    <ColumnDefinition Width="1*" MinWidth="315"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Panel}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="KEY_SIM · 按键组合" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="K01～K20 是电阻网络开关，不是 20 路模拟输出。可同时选中多个；勾选本身不会发送任何命令。"
       Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,11"/>
      <Border Background="#F3F8FE" BorderBrush="#DFEAF6" BorderThickness="1"
       CornerRadius="4" Padding="8" Margin="0,0,0,9">
       <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="CAN0 · 标准帧 ID 0x730"
         Foreground="#5D7892" FontSize="11" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding SelectedKeyMaskText}" FontSize="15"
         FontWeight="SemiBold" Foreground="#1D609C"/>
       </DockPanel>
      </Border>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
      <WrapPanel>
       <Button Content="▶ 应用选中的开关组合" Command="{Binding ApplyDirectMaskCommand}"
        Background="#176AB2" Foreground="White" FontWeight="SemiBold"
        ToolTip="要求真实会话 + 操作者确认，一次性发送选中 20-bit mask 到 CAN0"/>
       <Button Content="清空勾选（不发送）" Command="{Binding ClearSwitchesCommand}"/>
       <Button Content="释放全部真实按键" Command="{Binding ReleaseAllKeysCommand}"
        Background="#FFF5F3" Foreground="#A74541" Margin="0"
        ToolTip="真实 CAN0 0x730 发送全释放命令；需要再次确认。即使无 Controller 配置也可以操作。"/>
      </WrapPanel>
      <TextBlock Text="{Binding DirectResult}" Foreground="#536F89"
       Margin="0,9,0,2" TextWrapping="Wrap" FontSize="12"/>
      <TextBlock Text="ACK 只证明主控接收 CAN_SEND，不是五路输出电压或 ECU 识别的回读。"
       Foreground="#8B6733" FontSize="11" TextWrapping="Wrap"/>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <ItemsControl ItemsSource="{Binding Switches}">
        <ItemsControl.Style>
         <Style TargetType="ItemsControl">
          <Style.Triggers>
           <DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
          </Style.Triggers>
         </Style>
        </ItemsControl.Style>
        <ItemsControl.ItemsPanel>
         <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Border BorderBrush="#E3EAF2" BorderThickness="1" CornerRadius="4"
           Background="#F9FBFE" Margin="3" Padding="2">
           <CheckBox Style="{StaticResource KeySwitch}" Content="{Binding BitLabel}"
            IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <Expander Header="按 Controller Profile 执行预设按键状态（可选）"
        Margin="0,14,0,0" Foreground="#385B7E">
        <StackPanel Margin="4,9,4,7">
         <TextBlock Text="可直接使用上面的 20 Key 开关；本区仅供有命名映射的 ECU 工程使用。"
          Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
         <ComboBox ItemsSource="{Binding Controllers}" DisplayMemberPath="Name"
          SelectedItem="{Binding SelectedController}" Height="29" Margin="0,0,0,7"/>
         <ItemsControl ItemsSource="{Binding States}">
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <Border BorderBrush="#E4EAF2" BorderThickness="0,0,0,1" Padding="0,6">
             <DockPanel>
              <Button DockPanel.Dock="Right" Content="执行" MinHeight="25" Padding="8,3"
               Command="{Binding DataContext.ApplyStateCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
               CommandParameter="{Binding}" Margin="0"/>
              <StackPanel>
               <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
               <TextBlock Text="{Binding Subtitle}" Foreground="#697E94" FontSize="11"/>
              </StackPanel>
             </DockPanel>
            </Border>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>

   <Border Grid.Column="2" Style="{StaticResource Panel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="实际控制结果 / 人工测量" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding LastOperation}" Margin="0,8,0,4" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding LastEvidence}" Foreground="#57738C" FontSize="11"
       TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Border BorderBrush="#E5EBF3" BorderThickness="0,1,0,0" Margin="0,0,0,10"/>
      <TextBlock Text="KEY_SIM 五路模拟电压 · 人工记录" FontWeight="SemiBold" FontSize="13"/>
      <TextBlock Text="CH1～CH5 是按键网络合成的模拟输出。此软件目前不具备自动采样；仅能记录万用表实测值。"
       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,6"/>
      <ItemsControl ItemsSource="{Binding Voltages}">
       <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
       </ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <StackPanel Margin="0,0,7,8" Width="78">
          <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#647C95"/>
          <TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
           ToolTip="人工输入实际测得的电压（V），空白代表未测量；不得将目标值当成实际值"/>
         </StackPanel>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="测量人员" Foreground="{StaticResource Muted}" FontSize="11"/>
      <TextBox Text="{Binding OperatorName,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
      <TextBlock Text="记录备注" Foreground="{StaticResource Muted}" FontSize="11"/>
      <TextBox Text="{Binding Comment,UpdateSourceTrigger=PropertyChanged}"
       Margin="0,4,0,7"/>
      <Button Content="保存人工测量" Command="{Binding SaveMeasurementCommand}"
       HorizontalAlignment="Left" Margin="0,0,0,10"/>
      <TextBlock Text="只有获得主控 ACK 的真实按键组合或 Controller 状态才能关联人工测量；未采样仍显示未知，不能推断 ECU PASS。"
       Foreground="#8A6734" FontSize="11" TextWrapping="Wrap"/>
      <Border BorderBrush="#E5EBF3" BorderThickness="0,1,0,0" Margin="0,13,0,11"/>
      <TextBlock Text="其他台架硬件" FontWeight="SemiBold" FontSize="13"/>
      <TextBlock Text="IGN · 真实主控 SET_IGN 0x12" FontSize="12"
       FontWeight="SemiBold" Margin="0,7,0,6"/>
      <WrapPanel Margin="0,0,0,7">
       <Button Content="IGN ON" Command="{Binding IgnOnCommand}"
        Foreground="#146A4D" Background="#E7F5ED"
        FontWeight="SemiBold" Padding="15,7"/>
       <Button Content="IGN OFF" Command="{Binding IgnOffCommand}"
        Foreground="#A44835" Background="#FFF3EF"
        FontWeight="SemiBold" Padding="15,7"/>
      </WrapPanel>
      <TextBlock Text="{Binding IgnStatus}" FontSize="11" TextWrapping="Wrap"
       Foreground="#57738C" Margin="0,0,0,9"/>
      <TextBlock Text="IGN 高边输出 OFF 表示断开高边开关，不等于主动拉低电平。按钮仅经人工确认后发送；ACK 不等于测得电压。"
       FontSize="11" TextWrapping="Wrap" Foreground="#8B6733" Margin="0,0,0,9"/>
      <TextBlock Text="夹具电磁阀、ECU 电源：现有固件与设备层尚无确认的完整操作接口，不提供无法工作的假控制按钮。"
       FontSize="11" TextWrapping="Wrap" Foreground="#8B6733"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>

  <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="10">
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="台架操作记录 · ACK / 错误 / Session / Trace"
     FontSize="13" FontWeight="SemiBold" Margin="1,0,0,8"/>
    <DataGrid ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True"
     CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
     SelectionMode="Single">
     <DataGrid.Columns>
      <DataGridTextColumn Header="时间" Binding="{Binding When,StringFormat={}{0:HH:mm:ss.fff}}" Width="105"/>
      <DataGridTextColumn Header="类别" Binding="{Binding Severity}" Width="75"/>
      <DataGridTextColumn Header="操作" Binding="{Binding Heading}" Width="195"/>
      <DataGridTextColumn Header="请求 / ACK / 错误说明" Binding="{Binding Details}" Width="*"/>
      <DataGridTextColumn Header="证据" Binding="{Binding TraceReference}" Width="155"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>