<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · ECU 测试与开发" Width="1360" Height="850"
 MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterScreen"
 WindowState="Maximized" Background="{StaticResource Canvas}"
 Foreground="{StaticResource Ink}" FontFamily="{StaticResource UiFont}"
 FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
    <KeyBinding Key="F2" Command="{Binding RenameResourceCommand}"/>
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="35"/>
      <RowDefinition Height="86"/>
      <RowDefinition Height="*" MinHeight="350"/>
      <RowDefinition Height="27"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentProjectName}"
                   FontSize="11" Foreground="{StaticResource Subtle}"
                   VerticalAlignment="Center" Margin="0,0,16,0"
                   TextTrimming="CharacterEllipsis" MaxWidth="430"/>
        <Menu Margin="8,1,0,0" VerticalAlignment="Stretch">
          <MenuItem Header="文件(_F)">
            <MenuItem Header="新建工程…" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N"/>
            <MenuItem Header="打开工程…" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
          </MenuItem>
          <MenuItem Header="资源(_R)">
            <MenuItem Header="打开选中的测试程序…" Command="{Binding OpenTestProgramCommand}"/>
            <MenuItem Header="打开选中的 DBC…" Command="{Binding OpenDbcCommand}"/>
            <MenuItem Header="新建测试用例（Package）…" Command="{Binding NewTestProgramCommand}"/>
            <MenuItem Header="新建测试项目（Project）…" Command="{Binding NewTestProjectCommand}"/>
            <MenuItem Header="新建 TCF 被测系统配置…" Command="{Binding CreateTcfCommand}"/>
            <MenuItem Header="新建 TBC 固定台架配置…" Command="{Binding CreateTbcCommand}"/>
            <MenuItem Header="导入 DBC…" Command="{Binding ImportDbcCommand}"/>
            <MenuItem Header="导入固件…" Command="{Binding ImportFirmwareCommand}"/>
            <MenuItem Header="导入波形证据…" Command="{Binding ImportWaveCommand}"/>
            <Separator/>
            <MenuItem Header="新建控制器与按键配置…" Command="{Binding CreateControllerConfigCommand}"/>
            <MenuItem Header="新建波形判定配置…" Command="{Binding CreateWaveConfigCommand}"/>
            <MenuItem Header="新建烧录配置…" Command="{Binding CreateFlashConfigCommand}"/>
            <MenuItem Header="新建扫码匹配配置…" Command="{Binding CreateScanConfigCommand}"/>
            <MenuItem Header="打开选中的配置…" Command="{Binding OpenConfigurationCommand}"/>
            <Separator/>
            <MenuItem Header="重命名资源…" Command="{Binding RenameResourceCommand}" InputGestureText="F2"/>
            <MenuItem Header="移除资源引用…" Command="{Binding RemoveReferenceCommand}"/>
          </MenuItem>

        </Menu>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="12,0,13,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="45"/>
          <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True">
          <TextBlock DockPanel.Dock="Right" Text="{Binding AssetCount,StringFormat='工程资源 {0} 项'}"
                     FontSize="11" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="新建工程" Command="{Binding NewProjectCommand}"
                    Style="{StaticResource AtButton}" ToolTip="创建工程 (Ctrl+N)"/>
            <Button Content="打开工程" Command="{Binding OpenProjectCommand}"
                    Style="{StaticResource AtButton}" ToolTip="打开已有工程 (Ctrl+O)"/>
            <Border Width="1" Height="24" Background="{StaticResource Line}" Margin="2,0,10,0"/>
            <Button Content="新建测试用例" Command="{Binding NewTestProgramCommand}"
                    Style="{StaticResource AtButton}"/>
            <Button Content="新建测试项目" Command="{Binding NewTestProjectCommand}"
                    Style="{StaticResource AtButton}"/>
            <Button Content="打开测试程序" Command="{Binding OpenTestProgramCommand}"
                    Style="{StaticResource AtButton}"/>
            <Button Content="导入 DBC" Command="{Binding ImportDbcCommand}"
                    Style="{StaticResource AtButton}"/>
            <Button Content="打开 DBC" Command="{Binding OpenDbcCommand}"
                    Style="{StaticResource AtButton}"/>
          </StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="1" LastChildFill="True">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="主控板" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <Button Content="{Binding ConnectionButtonText}" Command="{Binding ConnectHardwareCommand}"
                    Style="{StaticResource AtButton}" ToolTip="{Binding HardwareStatus}"/>
            <Button Content="CAN 监视" Command="{Binding OpenCanMonitorCommand}"
                    Style="{StaticResource AtButton}" Margin="4,0,14,0"/>
            <Border Width="1" Height="22" Background="{StaticResource Line}" Margin="0,0,12,0"/>
            <TextBlock Text="扫码枪" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBox x:Name="ScannerEntry" Width="220" Height="28" VerticalContentAlignment="Center"
                     ToolTip="点击输入框后扫描，扫码枪需要以键盘模式发送文本和回车"
                     PreviewTextInput="ScannerEntry_TextInput"
                     PreviewKeyDown="ScannerEntry_KeyDown"/>
            <TextBlock Text="{Binding ScanStatus}" Width="220" VerticalAlignment="Center"
                       Margin="9,0,0,0" FontSize="11" Foreground="{StaticResource Subtle}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ScanStatus}"/>
          </StackPanel>
          <TextBlock Text="{Binding HardwareStatus}" DockPanel.Dock="Right"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     FontSize="11" Foreground="{StaticResource Subtle}" Margin="12,0,0,0"/>
          <TextBlock Text="{Binding SelectedConfigurationSummary}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" FontSize="11"
                     Foreground="{StaticResource Subtle}" Margin="10,0,0,0"/>
        </DockPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Background="{StaticResource Canvas}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="200" MaxWidth="460"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="490"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Padding="13,12,12,11"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="工程资源" FontSize="{StaticResource SectionTitleSize}"
                         FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock DockPanel.Dock="Right" Text="{Binding AssetCount, StringFormat='{}{0} 项'}"
                         FontSize="11" Foreground="{StaticResource Subtle}"
                         VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <Grid Margin="8">
            <TextBlock Text="暂无工程。请新建或打开工程。"
                       Margin="8,12" Foreground="{StaticResource Subtle}"
                       TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasProject}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TreeView x:Name="ResourceTree"
                      ItemsSource="{Binding ResourceNodes}"
                      Tag="{Binding}" BorderThickness="0"
                      Margin="0,3" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasProject,Converter={StaticResource BoolToVisibility}}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      SelectedItemChanged="ResourceTree_SelectedItemChanged"
                      PreviewMouseRightButtonDown="ResourceTree_RightClick"
                      >
              <!-- Override Windows theme selection brushes with AutoTest light theme. -->
              <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                 Color="{StaticResource SelectedSurfaceColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                 Color="{StaticResource InkColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                 Color="{StaticResource InactiveSelectionColor}"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                 Color="{StaticResource InkColor}"/>
              </TreeView.Resources>
              <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" Margin="0,0,7,0"
                               Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Description}" VerticalAlignment="Center"/>
                    <Button Content="＋" Click="ResourceTree_Create_Click" Focusable="False"
                            ToolTip="新建或导入此类资源" Margin="7,0,0,0"
                            MinWidth="23" MinHeight="23" Padding="1,0" VerticalAlignment="Center">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AtButton}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCreatableCategory}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </StackPanel>
                </HierarchicalDataTemplate>
              </TreeView.ItemTemplate>
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="True"/>
                  <Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="2,5"/>
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.Tag,RelativeSource={RelativeSource Self}}">
                  <MenuItem Header="新建测试用例（Package）…" Command="{Binding NewTestProgramCommand}"/>
            <MenuItem Header="新建测试项目（Project）…" Command="{Binding NewTestProjectCommand}"/>
            <MenuItem Header="新建 TCF 被测系统配置…" Command="{Binding CreateTcfCommand}"/>
            <MenuItem Header="新建 TBC 固定台架配置…" Command="{Binding CreateTbcCommand}"/>
                  <MenuItem Header="导入 DBC…" Command="{Binding ImportDbcCommand}"/>
                  <MenuItem Header="导入固件…" Command="{Binding ImportFirmwareCommand}"/>
                  <MenuItem Header="导入波形证据…" Command="{Binding ImportWaveCommand}"/>
                  <Separator/>
                  <MenuItem Header="新建控制器与按键配置…" Command="{Binding CreateControllerConfigCommand}"/>
                  <MenuItem Header="新建波形判定配置…" Command="{Binding CreateWaveConfigCommand}"/>
                  <MenuItem Header="新建烧录配置…" Command="{Binding CreateFlashConfigCommand}"/>
                  <MenuItem Header="新建扫码匹配配置…" Command="{Binding CreateScanConfigCommand}"/>
                  <MenuItem Header="打开选中的配置…" Command="{Binding OpenConfigurationCommand}"/>
                  <MenuItem Header="打开选中的 DBC…" Command="{Binding OpenDbcCommand}"/>
                  <MenuItem Header="打开选中的测试程序…" Command="{Binding OpenTestProgramCommand}"/>
                  <Separator/>
                  <MenuItem Header="重命名资源…" Command="{Binding RenameResourceCommand}"/>
                  <MenuItem Header="移除引用（保留磁盘文件）" Command="{Binding RemoveReferenceCommand}"/>
                </ContextMenu>
              </TreeView.ContextMenu>
            </TreeView>
          </Grid>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                    Background="{StaticResource Line}" ResizeDirection="Columns"/>
      <Border Grid.Column="2" Margin="10,10,10,9" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="{Binding NoOpenEditors,Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="打开资源，开始编辑" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="单击左侧测试用例、DBC 或配置，直接进入正式编辑页面。"
                       Foreground="{StaticResource Subtle}" HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Content="新建测试用例" Command="{Binding NewTestProgramCommand}"
                      Style="{StaticResource AtPrimaryButton}"/>
              <Button Content="导入 DBC" Command="{Binding ImportDbcCommand}"/>
            </StackPanel>
          </StackPanel>
          <TabControl ItemsSource="{Binding OpenEditors}"
                      SelectedItem="{Binding ActiveEditorTab,Mode=TwoWay}"
                      Visibility="{Binding HasActiveEditor,Converter={StaticResource BoolToVisibility}}"
                      BorderThickness="0" Background="{StaticResource Panel}">
            <TabControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                             MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                  <Button Content="×" Tag="{Binding}" Click="CloseEditorTab_Click" Focusable="False"
                          Width="24" Height="23" Margin="8,0,0,0" Padding="0"
                          ToolTip="关闭当前编辑标签"/>
                </StackPanel>
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate>
                <ContentControl Content="{Binding View}"/>
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource ToolbarSurface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="13,0" LastChildFill="True">
        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentProjectName}"
                   Foreground="{StaticResource Subtle}" FontSize="11"
                   VerticalAlignment="Center" MaxWidth="380" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                   Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>