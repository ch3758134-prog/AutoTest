<UserControl x:Class="AutoTest.Desktop.Testing.TestStepInspector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#FBFCFF" Foreground="#1E2C41" FontFamily="{StaticResource UiFont}"
 FontSize="13" UseLayoutRounding="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="12,9,12,11">
    <DockPanel Margin="0,0,0,8" LastChildFill="True">
     <Border DockPanel.Dock="Left" Background="#E8EFF9" CornerRadius="5"
      Width="27" Height="27" Margin="0,0,8,0">
      <TextBlock x:Name="TypeIcon" Text="▣" Foreground="#386EA9" FontSize="13"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock x:Name="StepCode" DockPanel.Dock="Right" Visibility="Collapsed" Foreground="#8798AC"
      VerticalAlignment="Center" FontFamily="Consolas" FontSize="10"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="Heading" Text="编辑步骤" Visibility="Collapsed" Foreground="#26476D"
       FontWeight="SemiBold" FontSize="12"/>
      <TextBlock x:Name="TypeLabel" Foreground="#26476D" FontSize="13" FontWeight="SemiBold"/>
     </StackPanel>
    </DockPanel>
    <!-- Editing existing StepId only. New action selection belongs exclusively to
         the central editor's grouped ActionPalette; no second type list here. -->
    <TextBlock x:Name="ActionDescription" TextWrapping="Wrap" Foreground="#64758C"
     FontSize="11" Margin="0,0,0,6" Visibility="Collapsed"/>
    <TextBlock x:Name="ImportWarning"
     Text="该步骤来自旧版文件，尚未完成可执行参数验证。旧文件信息已保留，但不会作为可编辑参数展示；实测前请重新核对操作对象及判定条件。"
     TextWrapping="Wrap" Foreground="#9B6423" FontSize="11"
     Margin="0,0,0,10" Visibility="Collapsed"/>
    <Button x:Name="ConvertImportedAssertionButton" Content="按当前 DBC 重建 CAN 判定"
     Click="ConvertImportedAssertion_Click" Visibility="Collapsed"
     HorizontalAlignment="Left" Margin="0,0,0,12" Padding="10,6"
     ToolTip="只转换当前旧版 CAN 判定；必须选择 CAN ID 匹配的真实 DBC 信号，并核对原位长、字节序、判定值和超时。转换后此步骤参与执行。"/>
    <DockPanel Margin="0,0,0,12" LastChildFill="True">
      <CheckBox x:Name="StepEnabledInput" DockPanel.Dock="Right" Content="启用"
       Margin="10,14,0,0" VerticalAlignment="Top" IsChecked="True"
       ToolTip="关闭后运行时跳过；步骤仍保留。"/>
      <StackPanel>
       <TextBlock Text="名称" Foreground="#61738B" FontWeight="SemiBold"
        FontSize="11" Margin="0,0,0,4"/>
       <TextBox x:Name="NameInput" MinHeight="34"/>
      </StackPanel>
     </DockPanel>
    <StackPanel x:Name="PublicFlowPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="调用公共流程" Foreground="#61738B" FontWeight="SemiBold"
      FontSize="11" Margin="0,0,0,5"/>
     <ComboBox x:Name="PublicFlowPicker" ItemsSource="{Binding AvailableFlowChoices}"
      DisplayMemberPath="Label" MinHeight="34"/>
     <TextBlock x:Name="PublicFlowReferenceStatus" TextWrapping="Wrap"
      Foreground="#A96D20" FontSize="10" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel x:Name="TargetPanel" Margin="0,0,0,13">
     <TextBlock Text="选择报文、信号或资源" Foreground="#61738B"
      FontWeight="SemiBold" FontSize="11" Margin="0,0,0,5"/>
     <TextBox x:Name="TargetSearch" TextChanged="TargetSearch_Changed"
      ToolTip="搜索报文、信号或 KEY 动作"
      Margin="0,0,0,5"/>
     <ComboBox x:Name="TargetPicker" ItemsSource="{Binding AvailableTargets}"
      DisplayMemberPath="Label" MinHeight="34"
      SelectionChanged="TargetPicker_Changed"/>
     <TextBlock x:Name="TargetHint" Visibility="Collapsed" Foreground="#64758C" FontSize="11"
      TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>

    <!-- Complete CAN frame is primary; the DBC signal editor is always
         present below it as an optional, non-destructive assistant. -->
    <StackPanel x:Name="CanSendPanel" Visibility="Collapsed" Margin="0,0,0,14">
     <Border x:Name="CanDataCard" Background="White" BorderBrush="#D9E3EE"
      BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,0,13">
      <StackPanel>
       <TextBlock Text="CAN 报文" FontWeight="SemiBold" Foreground="#254565"
        Margin="0,0,0,10"/>
       <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="70"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,9,0">
         <TextBlock Text="CAN ID（HEX）" FontSize="11" Foreground="#64758C" Margin="0,0,0,4"/>
         <TextBox x:Name="FrameIdInput" MinHeight="30" FontFamily="Consolas"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
         <TextBlock Text="DLC" FontSize="11" Foreground="#64758C" Margin="0,0,0,4"/>
         <TextBox x:Name="CanDlcInput" MinHeight="30" IsReadOnly="True"
          Background="#F2F6FA" FontFamily="Consolas"
          ToolTip="无 DBC 时由实际 DATA 字节数决定"/>
        </StackPanel>
       </Grid>
       <CheckBox x:Name="ExtendedFrame" Content="29 位扩展帧" FontSize="11"
        Margin="0,0,0,11"/>
       <TextBlock Text="DATA · 实际发送字节" FontWeight="SemiBold"
        Foreground="#2D4D6D" FontSize="12" Margin="0,0,0,5"/>
       <TextBox x:Name="RawCanDataInput" TextChanged="CanData_Changed"
        MinHeight="54" TextWrapping="Wrap" Padding="7"
        FontFamily="Consolas" FontSize="13"
        ToolTip="完整 HEX 字节，例如 01 02 03 04 05 06 07 08"/>
       <TextBlock x:Name="CanFramePreview" Foreground="#476987"
        Margin="0,7,0,0" FontSize="11" TextWrapping="Wrap"
        Text="填写 CAN ID 和完整 DATA"/>
       <TextBlock x:Name="CanPreviewIssue" Foreground="#B25143"
        Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
     <StackPanel Margin="0,0,0,13">
      <TextBlock Text="DBC 辅助编辑" FontWeight="SemiBold" Foreground="#254565"
       Margin="0,0,0,4"/>
      <TextBlock Text="DBC 负责解析和辅助修改 DATA，不是另一种发送模式。"
       FontSize="10" Foreground="#697C91" TextWrapping="Wrap"
       Margin="0,0,0,8"/>
      <TextBox x:Name="CanTargetSearch" TextChanged="TargetSearch_Changed"
       MinHeight="29" Margin="0,0,0,5"
       ToolTip="按中文名称、报文名或 CAN ID 搜索"/>
      <ComboBox x:Name="CanTargetPicker" ItemsSource="{Binding AvailableTargets}"
       DisplayMemberPath="Label" MinHeight="32" MaxDropDownHeight="350"
       SelectionChanged="TargetPicker_Changed"/>
      <TextBlock x:Name="CanTargetHint" Foreground="#647993"
       TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"/>
      <Button x:Name="CanRebindButton" Content="按当前 DBC 重新绑定"
       Click="CanRebind_Click" Visibility="Collapsed" HorizontalAlignment="Left"
       Margin="0,7,0,0" Padding="8,5"/>
      <StackPanel x:Name="DbcCanPanel" Visibility="Collapsed" Margin="0,10,0,0">
       <Border Background="#F3F7FC" Padding="7" CornerRadius="5"
        Margin="0,0,0,8">
        <TextBlock x:Name="DbcMessageInfo" FontSize="11" Foreground="#57728E"
         TextWrapping="Wrap"/>
       </Border>
       <ItemsControl x:Name="SignalGrid" ItemsSource="{Binding SignalValues}">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <StackPanel Margin="0,0,0,10">
           <TextBlock Text="{Binding DisplayName}" Foreground="#315477"
            FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"
            ToolTip="{Binding Definition}"/>
           <Grid Margin="0,4,0,0" IsEnabled="{Binding IsEditable}">
            <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
             MinHeight="28" FontFamily="Consolas" ToolTip="{Binding Range}">
             <TextBox.Style><Style TargetType="TextBox">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True">
               <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger></Style.Triggers>
             </Style></TextBox.Style>
            </TextBox>
            <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
             SelectedValuePath="Value"
             SelectedValue="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
             MinHeight="28" ToolTip="{Binding Definition}">
             <ComboBox.Style><Style TargetType="ComboBox">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True">
               <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger></Style.Triggers>
             </Style></ComboBox.Style>
            </ComboBox>
           </Grid>
           <TextBlock Text="{Binding Range,StringFormat='范围：{0}'}"
            FontSize="10" Foreground="#8797A8" Margin="0,3,0,0"/>
          </StackPanel>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </StackPanel>
     <Border BorderBrush="#DEE5ED" BorderThickness="0,1,0,0" Padding="0,10,0,0">
      <StackPanel>
       <TextBlock Text="发送控制" FontWeight="SemiBold" Foreground="#254565"
        Margin="0,0,0,8"/>
       <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
        <RadioButton x:Name="CanOnceMode" Content="发送一次"
         GroupName="CanSendMode" Checked="CanSendMode_Changed"
         Margin="0,0,19,0"/>
        <RadioButton x:Name="CanPeriodicMode" Content="周期发送"
         GroupName="CanSendMode" Checked="CanSendMode_Changed"/>
       </StackPanel>
       <StackPanel x:Name="CanPeriodicPanel" Visibility="Collapsed">
        <TextBlock Text="周期（毫秒）" FontSize="11" Foreground="#64758C" Margin="0,0,0,4"/>
        <TextBox x:Name="CanPeriodInput" MinHeight="29" Margin="0,0,0,8"/>
        <RadioButton x:Name="CanTimedStop" Content="发送指定时长后停止"
         GroupName="CanSendStop" Checked="CanStopMode_Changed" Margin="0,0,0,6"/>
        <StackPanel x:Name="CanTimedDurationPanel" Visibility="Collapsed"
         Margin="12,0,0,8">
         <TextBlock Text="持续时间（毫秒）" FontSize="11" Foreground="#64758C"
          Margin="0,0,0,4"/>
         <TextBox x:Name="CanDurationInput" MinHeight="29"/>
        </StackPanel>
        <RadioButton x:Name="CanUntilStopped" Content="直到停止步骤或测试清理"
         GroupName="CanSendStop" Checked="CanStopMode_Changed"/>
        <TextBlock Text="周期任务在后台发送，后续测试步骤继续执行。"
         TextWrapping="Wrap" FontSize="10" Foreground="#73859C"
         Margin="0,8,0,0"/>
       </StackPanel>
      </StackPanel>
     </Border>
    </StackPanel>

    <StackPanel x:Name="KeyPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="KEY 动作" Foreground="#4B6382" FontWeight="SemiBold"
      FontSize="11" Margin="0,0,0,6"/>

     <ComboBox x:Name="KeyActionInput" SelectionChanged="KeyAction_Changed"
      MinHeight="28" Margin="0,0,0,8">
      <ComboBoxItem Content="按下后释放" Tag="Pulse"/>
      <ComboBoxItem Content="保持按下" Tag="Hold"/>
      <ComboBoxItem Content="恢复／释放" Tag="Release"/>
     </ComboBox>
     <StackPanel x:Name="RawKeyMaskPanel" Visibility="Collapsed">
      <TextBlock Text="20 Key 组合" Foreground="#61738B"
       FontSize="11" Margin="0,0,0,5"/>
      <TextBox x:Name="RawKeyMaskInput" IsReadOnly="True" Visibility="Collapsed" FontFamily="Consolas"
       Margin="0,0,0,8"/>
      <UniformGrid x:Name="RawKeyGrid" Columns="5" Rows="4" Margin="0,0,0,7"/>
      <Button Content="清空选择" Click="ClearRawKeys_Click"
       HorizontalAlignment="Left" Margin="0,0,0,8"/>

     </StackPanel>
     <StackPanel x:Name="KeyDurationPanel">
      <TextBlock Text="保持时间（ms）" Foreground="#61738B" FontSize="11"
       Margin="0,0,0,5"/>
      <TextBox x:Name="KeyDurationInput" Width="150"
       HorizontalAlignment="Left"/>
     </StackPanel>
    </StackPanel>

    <StackPanel x:Name="IgnitionPanel" Visibility="Collapsed" Margin="0,0,0,13">
     <TextBlock Text="IGN 目标状态" FontWeight="SemiBold" Foreground="#61738B"
      FontSize="11" Margin="0,0,0,6"/>
     <ComboBox x:Name="IgnitionState">
      <ComboBoxItem Content="开启 IGN" Tag="ON"/>
      <ComboBoxItem Content="关闭 IGN" Tag="OFF"/>
     </ComboBox>
    </StackPanel>

    <ItemsControl x:Name="ParameterList" ItemsSource="{Binding ParameterFields}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="0,0,0,11">
        <TextBlock Text="{Binding Label}" Foreground="#61738B" FontSize="11"
         FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid>
         <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
          <TextBox.Style>
           <Style TargetType="TextBox">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding HasChoices}" Value="True">
              <Setter Property="Visibility" Value="Collapsed"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBox.Style>
         </TextBox>
         <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
          SelectedValuePath="Value" SelectedValue="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          MinHeight="28" Padding="6,3">
          <ComboBox.Style>
           <Style TargetType="ComboBox">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding HasChoices}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>
          </ComboBox.Style>
         </ComboBox>
        </Grid>
       </StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border BorderBrush="#E1E8F2" BorderThickness="0,1,0,0" Margin="0,12,0,8"/>
    <StackPanel x:Name="StepActionsPanel" Visibility="Collapsed"/>

   </StackPanel>
  </ScrollViewer>
  <!-- Sticky apply/cancel at the bottom; edits stay transactional and cancellable. -->
  <Border Grid.Row="1" Background="#FBFCFF" BorderBrush="#DBE3ED"
   BorderThickness="0,1,0,0" Padding="12,8">
   <StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#C04A57" FontSize="10"
     TextWrapping="Wrap" Margin="0,0,0,7"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click"
      MinWidth="70" Margin="0,0,7,0"/>
     <Button x:Name="ConfirmButton" Content="应用"
      Style="{StaticResource AtPrimaryButton}" Click="Confirm_Click" MinWidth="92"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</UserControl>
