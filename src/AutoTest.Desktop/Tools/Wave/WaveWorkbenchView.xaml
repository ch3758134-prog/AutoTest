<UserControl x:Class="AutoTest.Desktop.Tools.Wave.WaveWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="990" MinHeight="760" Background="#111927"
             Foreground="#E4EAF3" FontFamily="Segoe UI" FontSize="13"
             Focusable="True">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1C2839" />
        <SolidColorBrush x:Key="LineBrush" Color="#34445C" />
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,7,7" />
            <Setter Property="Background" Value="#283C51" />
            <Setter Property="Foreground" Value="#EAF2FB" />
            <Setter Property="BorderBrush" Value="#435B77" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="#101A29" />
            <Setter Property="Foreground" Value="#EAF2FB" />
            <Setter Property="BorderBrush" Value="#435B77" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SmallCaption">
            <Setter Property="Foreground" Value="#9DAEC4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ReplayCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    </UserControl.InputBindings>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="245" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="波形分析工作区" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SmallCaption}"
                           Text="DBC 信号 · CAN Replay · 实时共享源 · 参考版本 · 容差证据" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#253B52" CornerRadius="4"
                    Padding="10,5" HorizontalAlignment="Right">
                <TextBlock Text="WAVE · LAB I4" Foreground="#81CEE5" FontWeight="SemiBold" />
            </Border>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" Padding="11" CornerRadius="6" Margin="0,0,0,12">
            <WrapPanel>
                <Button Command="{Binding ReloadCommand}" Content="刷新 DBC 信号 (Ctrl+L)" />
                <Button Command="{Binding ReplayCommand}" Content="↻ 档案 Replay (Ctrl+R)" />
                <TextBlock Text="每路帧上限" Margin="6,8,5,0" VerticalAlignment="Top" />
                <TextBox Width="78" Height="28" ToolTip="2 至 100000；超限拒绝静默截断"
                         Text="{Binding ReplayFrameLimitText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Command="{Binding MockCommand}" Content="◇ 示例 CAN Mock" />
                <TextBox Width="160" Height="28" Text="{Binding ArchivePath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="输入/选择保存的 CAN RX JSON 帧档案" Margin="0,0,7,7" />
                <Button Click="ChooseArchive_Click" Content="选择帧文件…" />
                <Button Command="{Binding OpenArchiveCommand}" Content="载入帧档案" />
                <Button Command="{Binding LiveCommand}" Content="▶ 共享实时采集" />
                <Button Command="{Binding StopCommand}" Content="■ 取消操作" />
                <Button Command="{Binding SaveReferenceCommand}" Content="保存参考" />
                <Button Command="{Binding LoadReferenceCommand}" Content="读取参考" />
                <TextBlock Text="绝对容差" Margin="8,8,6,0" VerticalAlignment="Top" />
                <TextBox Width="70" Height="28" Text="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Command="{Binding CompareCommand}" Content="比较 / 证据" Margin="8,0,7,7" />
                <CheckBox Content="导出原始帧/解码/数值（敏感，仅本地）" IsChecked="{Binding IncludeRawEvidence, Mode=TwoWay}"
                          ToolTip="取消勾选后将对报文、解码值、采样值和自由文本进行脱敏；完整原始证据仍保留在本地原文件。"
                          VerticalAlignment="Center" Margin="6,0,8,5" Foreground="#E4EAF3" />
                <Button Click="ChooseExport_Click" Content="选择诊断包路径…" />
                <Button Command="{Binding ExportDiagnosticCommand}" Content="导出完整证据 ZIP" />
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                        <TextBlock Text="项目 DBC 信号" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="勾选信号（同图最多显示 8 路）" Style="{StaticResource SmallCaption}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Signals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="1,8,1,8" Foreground="#DDE8F4" ToolTip="DBC Revision 已固定；修改后需要重新刷新信号" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,9">
                    <DockPanel>
                        <TextBlock Text="时间曲线 / 独立 Y 轴分层" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Command="{Binding ZoomInCommand}" Content="＋" MinWidth="35" Padding="5,2" />
                            <Button Command="{Binding ZoomOutCommand}" Content="－" MinWidth="35" Padding="5,2" />
                            <Button Command="{Binding ResetZoomCommand}" Content="适合窗口" Padding="7,2" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Background="#0B1523" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="ChartCanvas" Width="950" Height="350" ClipToBounds="True"
                                Background="#0B1523" MouseLeftButtonDown="ChartCanvas_MouseLeftButtonDown">
                            <Rectangle Canvas.Left="48" Canvas.Top="12" Width="852" Height="322"
                                       Stroke="#41536A" StrokeThickness="1" />
                            <Line X1="48" X2="900" Y1="92" Y2="92" Stroke="#243447" />
                            <Line X1="48" X2="900" Y1="174" Y2="174" Stroke="#243447" />
                            <Line X1="48" X2="900" Y1="254" Y2="254" Stroke="#243447" />
                            <Line X1="261" X2="261" Y1="12" Y2="334" Stroke="#243447" />
                            <Line X1="474" X2="474" Y1="12" Y2="334" Stroke="#243447" />
                            <Line X1="687" X2="687" Y1="12" Y2="334" Stroke="#243447" />
                            <ItemsControl ItemsSource="{Binding Traces}" Canvas.Left="0" Canvas.Top="0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polyline Points="{Binding Points}" Stroke="{Binding Color}" StrokeThickness="2"
                                                  />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Polyline Points="{Binding CursorLineA}" Stroke="#F3E078" StrokeThickness="1.7" />
                            <Polyline Points="{Binding CursorLineB}" Stroke="#F8A578" StrokeThickness="1.7" />
                            <TextBlock Canvas.Left="52" Canvas.Top="336" FontSize="11"
                                       Foreground="#A0B0C3" Text="时间（s） / 单击 A · Shift+单击 B" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="6" Margin="0,9,0,0" Padding="9">
                    <StackPanel>
                        <TextBlock Text="{Binding ViewRange}" Style="{StaticResource SmallCaption}" />
                        <TextBlock Text="{Binding CursorInfo}" TextWrapping="Wrap" Margin="0,4,0,3" />
                        <ItemsControl ItemsSource="{Binding Traces}" MaxHeight="80">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1,0,1">
                                        <Rectangle Fill="{Binding Color}" Width="11" Height="3" Margin="0,7,8,0" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding Name}" Foreground="#B7C6D7" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="采集质量 / 证据" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="来源" Style="{StaticResource SmallCaption}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding Origin}" TextWrapping="Wrap" />
                        <TextBlock Text="时间与采样质量" Style="{StaticResource SmallCaption}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding Quality}" TextWrapping="Wrap" />
                        <TextBlock Text="固定参考" Style="{StaticResource SmallCaption}" Margin="0,7,0,0" />
                        <TextBlock Text="{Binding ReferenceStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,7,0,8">
                        <TextBlock Text="比较结果与规则" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ComparisonRules}" TextWrapping="Wrap"
                                   Foreground="#9DAEC4" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="PASS 仅表示当前离线数据满足规则，不等于实机验收。"
                               TextWrapping="Wrap" Foreground="#C9A66B" Margin="0,0,0,8" />
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#394A61" Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Signal}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Verdict}" FontSize="18" Foreground="#F4CB83" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Coverage}" Style="{StaticResource SmallCaption}" />
                                            <TextBlock Text="{Binding EvidenceId}" Style="{StaticResource SmallCaption}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="比较证据 ID" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="6" Margin="0,12,0,0" Padding="7">
            <TabControl Background="#1C2839" Foreground="#E4EAF3" BorderThickness="0">
                <TabItem Header="原始 CAN RX / DBC 解码">
                    <DockPanel Background="#172335">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5,5,5,4">
                            <TextBlock Text="筛选 ID / HEX / 信号 / Error" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="175" Text="{Binding TraceFilter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="仅筛选表格预览，导出保留完整档案" />
                            <Button Command="{Binding RefreshTraceCommand}" Content="筛选 / 刷新帧" Margin="8,0,8,0" />
                            <Button Command="{Binding LocateFrameCommand}" Content="定位游标 A 源帧" Margin="0,0,8,0"
                                    ToolTip="选中一条 Replay 波形后，点击曲线设置游标 A，定位关联的原始 CAN Evidence" />
                            <TextBlock Text="{Binding RawTraceStatus}" Foreground="#9EBCD5"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding RawFrames}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True" Background="#172335"
                                  Foreground="#DDE7F2" RowBackground="#172335" AlternatingRowBackground="#1F3046"
                                  BorderBrush="#354960" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  ClipboardCopyMode="IncludeHeader" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" />
                                <DataGridTextColumn Header="UTC 时间" Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm:ss.ffffff}" Width="170" />
                                <DataGridTextColumn Header="偏移 µs" Binding="{Binding OffsetMicroseconds}" Width="92" />
                                <DataGridTextColumn Header="Bus" Binding="{Binding BusRole}" Width="80" />
                                <DataGridTextColumn Header="CAN ID" Binding="{Binding CanId}" Width="80" />
                                <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="45" />
                                <DataGridTextColumn Header="原始 RX Hex" Binding="{Binding DataHex}" Width="155" />
                                <DataGridTextColumn Header="Loss" Binding="{Binding ReportedLostFrames}" Width="60" />
                                <DataGridTextColumn Header="DBC 解码" Binding="{Binding DecodedSummary}" Width="*" />
                                <DataGridTextColumn Header="错误" Binding="{Binding ErrorCode}" Width="160" />
                                <DataGridTextColumn Header="Trace Evidence" Binding="{Binding TraceEvidenceId}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="操作与错误时间线">
                    <DataGrid ItemsSource="{Binding OperationLogs}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" EnableRowVirtualization="True" Background="#172335"
                              Foreground="#DDE7F2" RowBackground="#172335" AlternatingRowBackground="#1F3046"
                              ClipboardCopyMode="IncludeHeader" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="UTC" Binding="{Binding TimestampUtc, StringFormat=HH:mm:ss.fff}" Width="110" />
                            <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="160" />
                            <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="90" />
                            <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110" />
                            <DataGridTextColumn Header="错误码" Binding="{Binding ErrorCode}" Width="160" />
                            <DataGridTextColumn Header="说明/证据" Binding="{Binding Detail}" Width="*" />
                            <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="190" />
                            <DataGridTextColumn Header="耗时 ms" Binding="{Binding DurationMilliseconds}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="逐信号证据/质量">
                    <DataGrid ItemsSource="{Binding CaptureQuality}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" EnableRowVirtualization="True" Background="#172335"
                              Foreground="#DDE7F2" RowBackground="#172335" AlternatingRowBackground="#1F3046">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="信号" Binding="{Binding Signal}" Width="130" />
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="56" />
                            <DataGridTextColumn Header="来源" Binding="{Binding InputKind}" Width="80" />
                            <DataGridTextColumn Header="采样" Binding="{Binding Samples}" Width="62" />
                            <DataGridTextColumn Header="观测" Binding="{Binding Observed}" Width="62" />
                            <DataGridTextColumn Header="拒绝" Binding="{Binding Rejected}" Width="62" />
                            <DataGridTextColumn Header="Gap" Binding="{Binding Gap}" Width="55" />
                            <DataGridTextColumn Header="质量码" Binding="{Binding ValidationCode}" Width="150" />
                            <DataGridTextColumn Header="时间源" Binding="{Binding TimeSource}" Width="130" />
                            <DataGridTextColumn Header="时钟质量" Binding="{Binding TimeQuality}" Width="150" />
                            <DataGridTextColumn Header="Capture Evidence" Binding="{Binding CaptureEvidenceId}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>
        <Border Grid.Row="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Margin="0,12,0,0" Padding="4,10,2,0">
            <DockPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#A7C5DB" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ExportStatus}" Foreground="#8FA2B7" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
