<Window x:Class="AutoTest.Desktop.Shell.ManualBenchWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AutoTest.Desktop.Shell"
 Title="AutoTest · 手动台架" Width="1500" Height="860" MinWidth="1200" MinHeight="660"
 WindowStartupLocation="CenterOwner" WindowState="Maximized" Background="#F4F7FC"
 FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#223A57">
 <Window.Resources>
  <Style x:Key="BenchHeader" TargetType="TextBlock">
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#244E7D"/>
  </Style>
  <Style x:Key="BenchHint" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="#71869D"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="BenchCard" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DCE5EF"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="13"/>
  </Style>
  <Style x:Key="BenchKey" TargetType="CheckBox">
   <Setter Property="Padding" Value="9,8"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style x:Key="FieldCaption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#617B98"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="0,9,0,4"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="64"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="37"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="White" BorderBrush="#DCE5EF" BorderThickness="0,0,0,1">
   <DockPanel Margin="15,10" LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="连接 / 断开" Command="{Binding ConnectCommand}"
     Style="{StaticResource AtPrimaryButton}" Padding="15,8" Margin="9,0,0,0"/>
    <Button DockPanel.Dock="Right" Content="刷新工程资源" Command="{Binding ReloadProfilesCommand}"
     Padding="12,7" Margin="9,0,0,0"/>
    <StackPanel>
     <TextBlock Text="AutoTest · 真实手动台架" Style="{StaticResource BenchHeader}" FontSize="17"/>
     <TextBlock Text="{Binding ConnectionStatus}" Foreground="#6C8198" Margin="0,3,0,0" FontSize="11"
      MaxWidth="1150" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConnectionStatus}"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Grid.Row="1" Margin="12,12,12,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.65*" MinWidth="470"/>
    <ColumnDefinition Width="1.03*" MinWidth="345"/>
    <ColumnDefinition Width="1.16*" MinWidth="340"/>
   </Grid.ColumnDefinitions>

   <!-- LEFT: CAN1 multi-message table and selected-message inspector. -->
   <Border Grid.Column="0" Style="{StaticResource BenchCard}" Margin="0,0,9,0">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="3*"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="CAN1 · ECU 报文发送" Style="{StaticResource BenchHeader}"/>
      <TextBlock Text="勾选多条报文，可混合单次与周期发送。选中一条，下方直接编辑；USB ACK 不等于 ECU 应答。"
       Style="{StaticResource BenchHint}" Margin="0,3,0,9"/>
      <DockPanel LastChildFill="False">
       <Button Content="+ 新增" Command="{Binding AddCanRowCommand}" Padding="10,6" Margin="0,0,5,0"/>
       <Button Content="复制" Command="{Binding CopyCanRowCommand}" Padding="9,6" Margin="0,0,5,0"/>
       <Button Content="删除" Command="{Binding DeleteCanRowCommand}" Padding="9,6" Margin="0,0,10,0"/>
       <Button Content="启动勾选" Command="{Binding StartCanRowsCommand}"
        Style="{StaticResource AtPrimaryButton}" Padding="11,6" Margin="0,0,5,0"/>
       <Button Content="停止全部" Command="{Binding StopCanRowsCommand}" Padding="11,6"/>
      </DockPanel>
     </StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding CanSendRows}"
      SelectedItem="{Binding SelectedCanRow,Mode=TwoWay}"
      AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
      GridLinesVisibility="None" RowHeight="35" ColumnHeaderHeight="32"
      SelectionMode="Single" EnableRowVirtualization="True" BorderBrush="#E2EAF3"
      Background="#FFFFFF" AlternatingRowBackground="#F8FAFD">
      <DataGrid.ContextMenu>
       <ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
        <MenuItem Header="新增报文" Command="{Binding AddCanRowCommand}"/>
        <MenuItem Header="复制当前报文" Command="{Binding CopyCanRowCommand}"/>
        <MenuItem Header="删除当前报文" Command="{Binding DeleteCanRowCommand}"/>
       </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="发送" Width="48">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding Included,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           IsEnabled="{Binding DataContext.CanEditCanRows,RelativeSource={RelativeSource AncestorType=DataGrid}}"
           HorizontalAlignment="Center" VerticalAlignment="Center"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="110" IsReadOnly="True"/>
       <DataGridTextColumn Header="CAN ID / DBC" Binding="{Binding Summary}" Width="*" IsReadOnly="True"/>
       <DataGridTextColumn Header="发送方式" Binding="{Binding ModeLabel}" Width="84" IsReadOnly="True"/>
       <DataGridTextColumn Header="状态 / 次数" Binding="{Binding Result}" Width="138" IsReadOnly="True"/>
      </DataGrid.Columns>
     </DataGrid>
     <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch"
      Background="#ECF1F7" ResizeDirection="Rows" VerticalAlignment="Stretch"/>
     <Border Grid.Row="3" BorderBrush="#DFE8F3" BorderThickness="1" CornerRadius="5"
      Background="#FBFCFE" Padding="12" Margin="0,7,0,0">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <TextBlock Text="所选 CAN 报文 · 属性编辑" Style="{StaticResource BenchHeader}" FontSize="13"/>
        <TextBlock Text="左侧列表负责组织与运行；这里负责编辑当前一条报文。"
         Style="{StaticResource BenchHint}" Margin="0,3,0,0"/>
       </StackPanel>
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel DataContext="{Binding SelectedCanRow}"
         IsEnabled="{Binding DataContext.CanEditCanRows,RelativeSource={RelativeSource AncestorType=Window}}">
         <TextBlock Text="名称" Style="{StaticResource FieldCaption}"/>
         <TextBox Text="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          Padding="7,5" MinHeight="30"/>
         <StackPanel Orientation="Horizontal" Margin="0,12,0,2">
          <CheckBox Content="周期发送" IsChecked="{Binding IsPeriodic,Mode=TwoWay}" Margin="0,0,16,0"/>
          <TextBlock Text="周期 (ms)" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox Text="{Binding PeriodText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           Width="78" Padding="6,4" ToolTip="周期 50～60000 ms，全部周期帧合计不超过 25 帧/秒"/>
         </StackPanel>
         <CheckBox Content="使用工程 DBC 报文" IsChecked="{Binding UseDbc,Mode=TwoWay}"
          Margin="0,9,0,1"/>
         <StackPanel Visibility="{Binding UseDbc,Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="DBC 报文" Style="{StaticResource FieldCaption}"/>
          <ComboBox ItemsSource="{Binding DataContext.DbcMessages,RelativeSource={RelativeSource AncestorType=Window}}"
           SelectedItem="{Binding DbcMessage,Mode=TwoWay}" DisplayMemberPath="Display" MinHeight="29"/>
          <TextBlock Text="信号物理值" Style="{StaticResource FieldCaption}"/>
          <ItemsControl ItemsSource="{Binding SignalValues}">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Grid Margin="0,0,0,7">
              <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*"/>
               <ColumnDefinition Width="130"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
               <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
               <TextBlock Text="{Binding Range}" FontSize="10" Foreground="#8899AA"/>
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
               Padding="6,5" Margin="7,0,0,0" ToolTip="{Binding Range}"/>
             </Grid>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
         <StackPanel Visibility="{Binding IsRaw,Converter={StaticResource BoolToVisibility}}">
          <Grid Margin="0,8,0,0">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel>
            <TextBlock Text="CAN ID (HEX)" Style="{StaticResource FieldCaption}"/>
            <TextBox Text="{Binding IdHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
             Padding="7,5" MinHeight="30"/>
           </StackPanel>
           <CheckBox Grid.Column="1" Content="扩展帧" IsChecked="{Binding Extended,Mode=TwoWay}"
            VerticalAlignment="Bottom" Margin="14,0,0,7"/>
          </Grid>
          <TextBlock Text="DATA (HEX，0～8 字节)" Style="{StaticResource FieldCaption}"/>
          <TextBox Text="{Binding DataHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           MinHeight="31" Padding="7,5" ToolTip="如 01 02 03 04"/>
         </StackPanel>
         <TextBlock Text="运行前会核对 ID、DLC、DBC 资源和周期；运行中冻结所选报文快照。"
          Style="{StaticResource BenchHint}" Margin="0,12,0,0"/>
        </StackPanel>
       </ScrollViewer>
      </DockPanel>
     </Border>
    </Grid>
   </Border>

   <!-- CENTER: direct KEY_SIM / IGN / two physical clamp controls. -->
   <Border Grid.Column="1" Style="{StaticResource BenchCard}" Margin="0,0,9,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="工位控制" Style="{StaticResource BenchHeader}"/>
      <TextBlock Text="KEY_SIM / IGN / 独立夹具，全部使用当前主控 USB 会话。"
       Style="{StaticResource BenchHint}" Margin="0,4,0,10"/>
      <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile,Mode=TwoWay}"
       MinHeight="30" ToolTip="当前工程的 Controller 配置"/>
      <TextBlock Text="{Binding ControllerSummary}" Style="{StaticResource BenchHint}" Margin="0,7,0,9"/>
      <TextBlock Text="KEY_SIM · 20 Key 组合 (CAN0)" FontWeight="SemiBold" Foreground="#264E7C"/>
      <TextBlock Text="点击选择组合，点击“应用”才会通过 CAN0 发送到按键板；保持/释放不会自动变化。"
       Style="{StaticResource BenchHint}" Margin="0,4,0,8"/>
      <ItemsControl ItemsSource="{Binding NamedOperations}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Content="{Binding Display}" Tag="{Binding}" Click="SelectNamedOperation_Click"
          Padding="7,5" Margin="0,0,5,5"/>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Keys}" Margin="0,6,0,5">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked,Mode=TwoWay}"
          Style="{StaticResource BenchKey}"/>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding DraftMaskLabel}" Foreground="#617D9B" FontSize="11"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
       <Button Content="应用 Key 组合" Command="{Binding SendKeyCommand}"
        Style="{StaticResource AtPrimaryButton}" Padding="11,6" Margin="0,0,7,0"/>
       <Button Content="清空选择" Command="{Binding ReleaseKeysCommand}" Padding="10,6"/>
      </StackPanel>
      <TextBlock Text="{Binding LastKeyAck}" Style="{StaticResource BenchHint}" Margin="0,7,0,0"/>
      <Border BorderBrush="#E5ECF4" BorderThickness="0,1,0,0" Margin="0,14,0,11"/>
      <TextBlock Text="IGN · 点火控制" FontWeight="SemiBold" Foreground="#264E7C"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,7">
       <RadioButton Content="ON" GroupName="IgnTarget" IsChecked="{Binding IgnOn,Mode=TwoWay}" Margin="0,0,18,0"/>
       <RadioButton Content="OFF" GroupName="IgnTarget" IsChecked="{Binding IgnOff,Mode=TwoWay}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
       <Button Content="设置 IGN" Command="{Binding SendIgnCommand}"
        Padding="11,6" Margin="0,0,7,0"/>
       <Button Content="读取 GPIO" Command="{Binding ReadIgnCommand}" Padding="10,6"/>
      </StackPanel>
      <TextBlock Text="{Binding LastIgnAck}" Style="{StaticResource BenchHint}" Margin="0,7,0,0"/>
      <Border BorderBrush="#E5ECF4" BorderThickness="0,1,0,0" Margin="0,14,0,11"/>
      <TextBlock Text="两只夹具 · 独立控制" FontWeight="SemiBold" Foreground="#264E7C"/>
      <TextBlock Text="夹具1=J1 B5，夹具2=J1 B4。请求压紧=1、释放=0；USB 断开可能释放夹具。"
       Style="{StaticResource BenchHint}" Margin="0,5,0,6"/>
      <CheckBox IsChecked="{Binding ClampSafetyConfirmed,Mode=TwoWay}" Margin="0,6,0,9">
       <TextBlock Text="已确认现场线束、气路和夹具区域安全，可执行实体动作"
        TextWrapping="Wrap" MaxWidth="335"/>
      </CheckBox>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="74"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
       <TextBlock Grid.Row="0" Grid.Column="0" Text="夹具 1" VerticalAlignment="Center" FontWeight="SemiBold"/>
       <Button Grid.Row="0" Grid.Column="1" Content="压紧" Click="Clamp1Press_Click"
        IsEnabled="{Binding CanSendClamp}" Margin="0,3,5,3"/>
       <Button Grid.Row="0" Grid.Column="2" Content="释放" Click="Clamp1Release_Click"
        IsEnabled="{Binding CanSendClamp}" Margin="0,3,0,3"/>
       <TextBlock Grid.Row="1" Grid.Column="0" Text="夹具 2" VerticalAlignment="Center" FontWeight="SemiBold"/>
       <Button Grid.Row="1" Grid.Column="1" Content="压紧" Click="Clamp2Press_Click"
        IsEnabled="{Binding CanSendClamp}" Margin="0,3,5,3"/>
       <Button Grid.Row="1" Grid.Column="2" Content="释放" Click="Clamp2Release_Click"
        IsEnabled="{Binding CanSendClamp}" Margin="0,3,0,3"/>
      </Grid>
      <Button Content="读取两夹具 MCU GPIO" Command="{Binding ReadClampsCommand}"
       Margin="0,9,0,0" Padding="10,6" HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding LastClampStatus}" Style="{StaticResource BenchHint}" Margin="0,7,0,0"/>
      <TextBlock Text="GPIO 回读不是机械到位。KEY_SIM 20 个开关最终合成五路电压，需以实物和 ECU 响应验证。"
       Style="{StaticResource BenchHint}" Margin="0,12,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </Border>

   <!-- RIGHT: read-only real-time monitor with USB/ACK/evidence and export. -->
   <Border Grid.Column="2" Style="{StaticResource BenchCard}">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
      <StackPanel>
       <TextBlock Text="CAN0 / CAN1 · 实时监视" Style="{StaticResource BenchHeader}"/>
       <TextBlock Text="真实 RX、TX ACK、USB 故障。主控 ACK 不能代替 ECU 应答。"
        Style="{StaticResource BenchHint}" Margin="0,4,0,8"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="导出 JSONL" Click="ExportLog_Click" Padding="10,5" Margin="0,0,6,0"/>
        <Button Content="清屏" Command="{Binding ClearLogsCommand}" Padding="10,5"/>
       </StackPanel>
      </StackPanel>
     </DockPanel>
     <TextBox DockPanel.Dock="Top" Text="{Binding LogFilter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
      ToolTip="按 CAN0/CAN1、ID、数据、状态或说明过滤" Padding="8,6" MinHeight="29" Margin="0,0,0,8"/>
     <Border DockPanel.Dock="Bottom" BorderBrush="#E5ECF5" BorderThickness="0,1,0,0"
      Margin="0,8,0,0" Padding="5,9">
      <StackPanel>
       <TextBlock Text="日志详情（选择一条记录查看）" Foreground="#4B6888" FontWeight="SemiBold" FontSize="11"/>
       <TextBlock Text="{Binding SelectedLog.Detail}" Foreground="#657B94" TextWrapping="Wrap"
        Margin="0,5,0,0" FontSize="11" MinHeight="42"/>
      </StackPanel>
     </Border>
     <DataGrid ItemsSource="{Binding FilteredLogs}" SelectedItem="{Binding SelectedLog,Mode=TwoWay}"
      IsReadOnly="True" AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
      HeadersVisibility="Column" EnableRowVirtualization="True" BorderBrush="#E6EDF5"
      ColumnHeaderHeight="31" RowHeight="29" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="81"/>
       <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="83"/>
       <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="56"/>
       <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="66"/>
       <DataGridTextColumn Header="DATA" Binding="{Binding Data}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#286DAE" Padding="14,8">
   <TextBlock Text="{Binding Status}" Foreground="White" TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>
