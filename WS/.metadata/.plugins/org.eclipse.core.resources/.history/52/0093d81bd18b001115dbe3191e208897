/*
 * main.c - KEY_SIM 项目 CAN 接收回发测试
 * 收到任意报文后，自动回发一帧响应
 */

#include "sys_include.h"
#include "Driver_Gpio.h"
#include "Driver_CAN.h"

extern volatile u8 canMessageReceivedFlag;
extern CanMsgInf CanMsg;

void main(void)
{
	u8 rsp_data[8] = {0xAA, 0x55, 0x12, 0x34, 0x56, 0x78, 0x9A, 0xBC};
    sys_clk_Init();
    PE_low_level_init();
    Drv_Gpio_Init();
    Timer_1ms_Init();
    Drv_CAN_Init();
    Drv_CAN_Enable();

    for (;;) {
        if (canMessageReceivedFlag) {
            canMessageReceivedFlag = 0;

            /* 收到什么报文都回发一帧响应 */
            Drv_CAN_SendFrame(0x18FEFA50, rsp_data);  /* 扩展帧响应 ID，可改成你需要的 */
        }
    }
}
