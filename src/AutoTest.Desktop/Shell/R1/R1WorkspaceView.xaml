<UserControl x:Class="AutoTest.Desktop.Shell.R1.R1WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r1="clr-namespace:AutoTest.Desktop.Shell.R1"
             FontFamily="Segoe UI" FontSize="13" MinWidth="800" MinHeight="480">
    <UserControl.InputBindings>
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Control,Shift" Command="{Binding PreviousTabCommand}"/>
        <KeyBinding Key="F4" Modifiers="Control" Command="{Binding CloseActiveTabCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <SolidColorBrush x:Key="R1Background" Color="#121B27"/>
        <SolidColorBrush x:Key="R1Panel" Color="#1B2837"/>
        <SolidColorBrush x:Key="R1Line" Color="#324357"/>
        <SolidColorBrush x:Key="R1Text" Color="#E6EDF5"/>
        <SolidColorBrush x:Key="R1Muted" Color="#9CACBF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource R1Text}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#273D54"/>
            <Setter Property="Foreground" Value="{StaticResource R1Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource R1Line}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="28"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource R1Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="29"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource R1Panel}"
                BorderBrush="{StaticResource R1Line}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"
                           Text="AutoTest Studio · R1 Workspace"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="工程：" Foreground="{StaticResource R1Muted}"/>
                    <TextBlock Text="{Binding ProjectLabel}" Margin="0,0,12,0"/>
                    <TextBlock Text="Revision：" Foreground="{StaticResource R1Muted}"/>
                    <TextBlock Text="{Binding ResourceRevision}" Margin="0,0,12,0"/>
                    <TextBlock Text="来源：" Foreground="{StaticResource R1Muted}"/>
                    <TextBlock Text="{Binding Origin}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="240" MinWidth="160"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource R1Panel}"
                    BorderBrush="{StaticResource R1Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10">
                    <TextBox DockPanel.Dock="Top" Height="30" Margin="0,0,0,8"
                             ToolTip="筛选 13 个工作区（名称、编号或所属专业）"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock DockPanel.Dock="Top" Text="工作区导航"
                               FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <ListBox ItemsSource="{Binding FilteredNavigation}" BorderThickness="0"
                             Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type r1:WorkspaceDescriptor}">
                                <Button Width="205" HorizontalContentAlignment="Left" Margin="0,2,0,2"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" Width="37"/>
                                        <TextBlock Text="{Binding Label}" Width="128"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Background="{StaticResource R1Line}" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="155"/>
                </Grid.RowDefinitions>
                <TabControl Grid.Row="0" Height="38" ItemsSource="{Binding OpenTabs}"
                            SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                            Background="{StaticResource R1Panel}" BorderBrush="{StaticResource R1Line}">
                    <TabControl.ContentTemplate><DataTemplate><Grid Height="0"/></DataTemplate></TabControl.ContentTemplate>
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type r1:WorkspaceTab}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Header}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StateLabel}" FontWeight="SemiBold"
                                           Foreground="#FFD18A" FontSize="10" Margin="0,0,8,0"/>
                                <Button Content="×" Padding="2,0"
                                        ToolTip="关闭（未保存或忙时阻止）"
                                        Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                </TabControl>
                <Border Grid.Row="1" Background="{StaticResource R1Background}" Padding="18">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="专业文档宿主 · 待 INTEGRATION 注册"
                                   FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock Margin="0,9,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource R1Muted}"
                                   Text="导航和标签由 R1 UI 管理，实际专业 View 必须由唯一 Prism/DI 宿主装入；这里不会伪造已实现的专业页面。"/>
                    </StackPanel>
                </Border>
                <GridSplitter Grid.Row="2" Background="{StaticResource R1Line}" HorizontalAlignment="Stretch"/>
                <Border Grid.Row="3" Background="{StaticResource R1Panel}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Output / Trace / Problems · 正式日志由 INTEGRATION 接线"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Notice}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="3" Background="{StaticResource R1Line}" HorizontalAlignment="Stretch"/>
            <Border Grid.Column="4" Background="{StaticResource R1Panel}"
                    BorderBrush="{StaticResource R1Line}" BorderThickness="1,0,0,0">
                <StackPanel Margin="13">
                    <TextBlock Text="上下文检查器" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="激活页面" Margin="0,16,0,3" Foreground="{StaticResource R1Muted}"/>
                    <TextBlock Text="{Binding ActiveTab.Header}"/>
                    <TextBlock Text="所属专业" Margin="0,12,0,3" Foreground="{StaticResource R1Muted}"/>
                    <TextBlock Text="{Binding ActiveTab.Owner}"/>
                    <TextBlock Text="打开时 Revision（不随外部变化偷偷更新）"
                               Margin="0,12,0,3" TextWrapping="Wrap" Foreground="{StaticResource R1Muted}"/>
                    <TextBlock Text="{Binding ActiveTab.ContextRevision}"/>
                    <TextBlock Text="文档状态" Margin="0,12,0,3" Foreground="{StaticResource R1Muted}"/>
                    <TextBlock Text="{Binding ActiveTab.StateLabel}"/>
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#FFD18A"
                               Text="Revision 不同的已打开文档标记 STALE，不能据此认为其业务绑定仍有效。"/>
                    <TextBlock Text="设备" Margin="0,12,0,3" Foreground="{StaticResource R1Muted}"/>
                    <TextBlock Text="{Binding StationIdentity}"/>
                    <TextBlock Text="SessionGeneration" Margin="0,12,0,3" Foreground="{StaticResource R1Muted}"/>
                    <TextBlock Text="{Binding SessionGeneration}"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#193C55" Padding="10,4">
            <TextBlock Text="{Binding Notice}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>