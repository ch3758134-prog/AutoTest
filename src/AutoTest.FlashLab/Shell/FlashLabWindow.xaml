<Window x:Class="AutoTest.FlashLab.Shell.FlashLabWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest Flash Lab - CanTool 工作台（G4-F1）"
 Width="1340" Height="860" MinWidth="1050" MinHeight="700" WindowState="Maximized"
 WindowStartupLocation="CenterScreen" Background="#F5F7FB"
 FontFamily="Microsoft YaHei UI" FontSize="13" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="14,6"/>
   <Setter Property="Margin" Value="4,2"/>
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#CAD5E5"/>
   <Setter Property="Foreground" Value="#273950"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Margin" Value="4,2"/>
   <Setter Property="Padding" Value="6,5"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#CED8E6"/>
   <Setter Property="MinHeight" Value="29"/>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="Margin" Value="8,5"/>
   <Setter Property="Padding" Value="8"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D6DFEA"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#304054"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 </Window.Resources>
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="250"/>
   <RowDefinition Height="240"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8E2EE" BorderThickness="1"
    CornerRadius="5" Padding="14,11" Margin="0,0,0,8">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
     <TextBlock Text="AutoTest  /  Flash Lab" FontWeight="Bold" FontSize="20" Foreground="#1D3554"/>
     <Border Background="#EEF3F9" CornerRadius="3" Padding="8,3" Margin="12,3,0,3">
      <TextBlock Text="G4-F1 · CAN1 · 只读诊断" FontWeight="SemiBold" Foreground="#385E85"/>
     </Border>
    </StackPanel>
    <TextBlock Text="参考 CanTool 工作流程；原始窗口布局尚待原件对照" Foreground="#687A90"
      HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D8E2EE" BorderThickness="1"
    Padding="10,8" CornerRadius="5">
   <DockPanel LastChildFill="True">
    <TextBlock DockPanel.Dock="Left" Text="主控设备（WinUSB）： " VerticalAlignment="Center" FontWeight="SemiBold"/>
    <Button DockPanel.Dock="Right" x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click"/>
    <Button DockPanel.Dock="Right" x:Name="ConnectButton" Content="连接" Click="Connect_Click"
      Background="#DCECFD" FontWeight="Bold"/>
    <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click"/>
    <ComboBox x:Name="DeviceSelector" ItemsSource="{Binding Candidates}"
      SelectedItem="{Binding SelectedDevice,Mode=TwoWay}" DisplayMemberPath="DisplayIdentity"
      MinWidth="500" Height="31" VerticalAlignment="Center" Margin="4,0"/>
   </DockPanel>
  </Border>

  <Grid Grid.Row="2" Margin="0,6,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.55*"/>
    <ColumnDefinition Width="1.05*"/>
   </Grid.ColumnDefinitions>
   <GroupBox Grid.Column="0" Header="CanTool 配置（未验证 ECU 参数不得作为真实默认值）">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <DockPanel Grid.Row="0" LastChildFill="True">
      <Button DockPanel.Dock="Left" Content="打开配置 XML" Click="LoadXml_Click"/>
      <Button DockPanel.Dock="Left" Content="导入 settings.json" Click="LoadJson_Click"/>
      <Button DockPanel.Dock="Left" Content="保存配置..." Click="SaveXml_Click"/>
      <TextBlock Text="{Binding ConfigurationPath}" TextTrimming="CharacterEllipsis"
        Foreground="#64748B" Margin="10,0,0,0"/>
     </DockPanel>
     <DataGrid Grid.Row="1" Margin="4" ItemsSource="{Binding Parameters}"
       AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
       HeadersVisibility="Column" GridLinesVisibility="Horizontal"
       RowHeaderWidth="0" Background="#FFFFFF" BorderBrush="#D5DFEB"
       EnableRowVirtualization="True" SelectionMode="Single">
      <DataGrid.Columns>
       <DataGridTextColumn Header="字段" Binding="{Binding Name}" Width="165" IsReadOnly="True"/>
       <DataGridTextColumn Header="值（双击编辑）"
        Binding="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
        Width="1.3*"/>
       <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="104" IsReadOnly="True"/>
       <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="1.25*" IsReadOnly="True"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="2" Text="{Binding Unknown}" TextWrapping="Wrap" Margin="8,3"
       Foreground="#73839A" FontSize="11"/>
     <TextBlock Grid.Row="3" Text="参考配置仅供研究；不自动配置主控波特率，不加载 Seed/Key DLL，不触发烧录。"
       FontSize="11" Foreground="#A65E20" Margin="8,3" TextWrapping="Wrap"/>
    </Grid>
   </GroupBox>

   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <GroupBox Header="固件文件（离线解析）">
      <StackPanel>
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="选择 HEX / S19 / BIN..." Click="ChooseImage_Click"/>
        <TextBlock Text="BIN 基地址（16进制）：" VerticalAlignment="Center"/>
        <TextBox x:Name="BinBaseBox" Width="110" Text="" ToolTip="例如 0x10008000；不是默认值"/>
       </DockPanel>
       <TextBlock Text="{Binding FirmwarePath}" Margin="7,3" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="{Binding ImageSummary}" FontSize="11" Margin="7,3" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding ImageRanges}" FontSize="11" Margin="7,3"
        Foreground="#677B94" TextWrapping="Wrap"/>
      </StackPanel>
     </GroupBox>
     <GroupBox Header="ECU 信息 · 限定一次 UDS 0x22 DID">
      <StackPanel>
       <TextBlock Text="未经现场单独授权不得发送。仅 CAN1；不自动进入会话、解锁或复位。"
         Foreground="#9C5D20" FontSize="11" TextWrapping="Wrap" Margin="4,3"/>
       <DockPanel Margin="4,3">
        <TextBlock Text="地址来源：" Margin="0,0,5,0"/>
        <ComboBox x:Name="EndpointSelector" Width="140" Height="27" SelectionChanged="Endpoint_SelectionChanged"
          SelectedIndex="0">
         <ComboBoxItem Content="APP 地址"/>
         <ComboBoxItem Content="Boot 地址"/>
        </ComboBox>
        <Button Content="从配置填入" Click="ApplyEndpoint_Click"/>
       </DockPanel>
       <Grid Margin="3,3">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="TX ID：" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding RequestId,UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Column="2" Text="RX ID：" VerticalAlignment="Center"/>
        <TextBox Grid.Column="3" Text="{Binding ResponseId,UpdateSourceTrigger=PropertyChanged}"/>
       </Grid>
       <DockPanel Margin="3,3">
        <TextBlock DockPanel.Dock="Left" Text="DID（16进制）：" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Did,UpdateSourceTrigger=PropertyChanged}" Width="150"
         HorizontalAlignment="Left"/>
       </DockPanel>
       <TextBlock Text="本次物理许可的精确确认字符串：" Margin="5,6,5,2" FontSize="11"/>
       <TextBox Text="{Binding ExpectedConsent}" IsReadOnly="True"
         Foreground="#63758B" TextWrapping="Wrap" MinHeight="28"/>
       <TextBlock Text="现场人员手工输入以上整串后才允许一次读取：" Margin="5,6,5,2" FontSize="11"/>
       <TextBox x:Name="ConfirmationBox" Text="{Binding TypedConfirmation,UpdateSourceTrigger=PropertyChanged}"
         MinHeight="30"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button x:Name="ReadDidButton" Content="读取指定 DID（0x22）" Click="ReadDid_Click"
          Background="#DCECFD" FontWeight="Bold"/>
        <Button x:Name="CancelDidButton" Content="取消读取" Click="CancelDid_Click"/>
       </StackPanel>
       <TextBlock Text="{Binding DidResult}" Margin="7,5" TextWrapping="Wrap"
         FontWeight="SemiBold" Foreground="#295379"/>
      </StackPanel>
     </GroupBox>
     <GroupBox Header="CanTool 烧录流程 · F2 尚未授权">
      <StackPanel>
       <UniformGrid Columns="2">
        <Button Content="进入编程会话" IsEnabled="False"/>
        <Button Content="SecurityAccess 解锁" IsEnabled="False"/>
        <Button Content="擦除 Flash" IsEnabled="False"/>
        <Button Content="下载 / TransferData" IsEnabled="False"/>
        <Button Content="校验 / Verify" IsEnabled="False"/>
        <Button Content="ECU 复位" IsEnabled="False"/>
        <Button Content="开始烧录" IsEnabled="False" FontWeight="Bold"/>
        <Button Content="停止烧录" IsEnabled="False"/>
       </UniformGrid>
       <ProgressBar Minimum="0" Maximum="100" Value="0" Height="14" Margin="7"/>
       <TextBlock Text="F1 无实体编程服务、无编程进度；以上控件全部禁用。"
         Foreground="#9A5B25" FontSize="11" TextWrapping="Wrap" Margin="6"/>
      </StackPanel>
     </GroupBox>
    </StackPanel>
   </ScrollViewer>
  </Grid>

  <GroupBox Grid.Row="3" Header="通讯日志 / 原始证据（真实 USB ACK ≠ ECU 发送结果）"
     Margin="8,4,8,3">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,4">
     <Button DockPanel.Dock="Right" Content="导出诊断 ZIP..." Click="Export_Click"/>
     <Button DockPanel.Dock="Right" Content="清空界面日志" Click="ClearLog_Click"/>
     <TextBlock Text="保留原始 USB/CAN 追踪及操作时间线；导出内容可能含 ECU 标识信息"
       FontSize="11" Foreground="#76879C" Margin="6,0"/>
    </DockPanel>
    <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}"
      FontFamily="Consolas" FontSize="12" Background="#FCFDFE"
      BorderBrush="#D5DFEA" ScrollViewer.HorizontalScrollBarVisibility="Auto"
      ScrollViewer.VerticalScrollBarVisibility="Auto"/>
   </Grid>
  </GroupBox>
  <Border Grid.Row="4" BorderBrush="#DAE2ED" BorderThickness="0,1,0,0" Margin="2,4,2,0" Padding="5">
   <TextBlock Text="{Binding Status}" Foreground="#315779" FontWeight="SemiBold"/>
  </Border>
 </Grid>
</Window>
