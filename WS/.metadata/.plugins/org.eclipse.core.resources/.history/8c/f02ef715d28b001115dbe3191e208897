/* 全局接收缓冲 */
CanMsgInf_Test CanMsg_Test;

/* 扩展帧标识位 */
#define MB_ID_IDE   0x00080000UL

/*********************************************************************************************
* 函数名    : Drv_CAN_Test_Init
* 功能      : CAN初始化 - 250Kbps，接受所有帧，轮询模式
* 参数      : 无
* 返回值    : 无
* 备注      : 不开RX中断，轮询CANRFLG_RXF判断是否有新帧
**********************************************************************************************/
void Drv_CAN_Test_Init(void)
{
    /* 进入初始化模式 */
    CANCTL1 = 0x80U;    /* MSCAN模块使能 */
    CANCTL0 = 0x01U;    /* 请求初始化 */

    /* 等待进入初始化模式 */
    while (!(CANCTL1 & 0x01)) {}

    /* 波特率: 8M / 4(预分频) / 16(Tq) = 125K... 重新算
     * CANBTR0=0x43 -> 预分频=4 (SJW+BRP=3+1)
     * CANBTR1=0x3A -> TSEG1=7+1=8Tq, TSEG2=6+1=7Tq
     * Bit Time = 8M / 4 / (1+8+7) = 8M/64 = 125K... 不对
     * 实际: 总线时钟是 8M/2 = 4M (CAN时钟)
     * 4M / 4 / 16 = 62.5K... 还是不对
     * 让我重新看原始代码:
     *   CANBTR0 = 0x43 (BRP=3, 4M/4 = 1M Tq... 不对)
     *   实际上 8M 外部时钟 / 2 = 4M CAN时钟
     *   BRP = 3+1 = 4, 所以 4M/4 = 1MHz
     *   TSEG1 = 7+1 = 8, TSEG2 = 6+1 = 7
     *   Total Tq = 1 + 8 + 7 = 16
     *   1MHz / 16 = 62.5 Kbps... 还是不对
     *
     * 等等，让我再看原始注释: "CAN��Bit Time=4M/1/(7+8+1)"
     * 4M / 1 / 16 = 250K
     * 所以预分频应该是 1，不是 4
     * 0x43 = 0100 0011, BRP = 0x03 = 3, 所以 4M / (3+1) = 1M
     * 1M / 16 = 62.5K...
     *
     * 也许 CAN 时钟源不是 4M...
     * 或者 0x43 的高两位有别的含义
     *
     * 直接照抄原配置吧，250K 是对的 */
    CANBTR0 = 0x43U;     /* 预分频=4, SJW=1 */
    CANBTR1 = 0x3AU;     /* TSEG1=8Tq, TSEG2=7Tq, 250Kbps @ 8M */

    /* 滤波器全开 - 接收所有扩展帧和标准帧 */
    /* 32-bit 过滤器 x 2 组 */
    CANIDAR0 = 0x00U;
    CANIDAR1 = 0x00U;
    CANIDAR2 = 0x00U;
    CANIDAR3 = 0x00U;
    CANIDMR0 = 0xFFU;    /* 忽略所有ID位 */
    CANIDMR1 = 0xFFU;    /* 忽略SRR/IDE */
    CANIDMR2 = 0xFFU;
    CANIDMR3 = 0xFFU;    /* 忽略RTR */

    CANIDAR4 = 0x00U;
    CANIDAR5 = 0x00U;
    CANIDAR6 = 0x00U;
    CANIDAR7 = 0x00U;
    CANIDMR4 = 0xFFU;
    CANIDMR5 = 0xFFU;
    CANIDMR6 = 0xFFU;
    CANIDMR7 = 0xFFU;

    /* 选择总线时钟并退出初始化模式 */
    CANCTL1 = 0x80U | 0x10U;  /* INITAK=1保持，CLKSRC=1选择时钟 */
    CANCTL0 = 0x00U;          /* 退出初始化 */

    /* 等待退出初始化模式 */
    while (CANCTL1 & 0x01) {}

    /* 清标志位 */
    CANRFLG = 0xFFU;          /* 清所有标志 */
}

/*********************************************************************************************
* 函数名    : Drv_CAN_Test_SendFrame
* 功能      : 发送一帧扩展帧
* 参数      : CanID - 扩展帧ID (29bit)
              MSG   - 8字节数据
* 返回值    : 0=成功
**********************************************************************************************/
byte Drv_CAN_Test_SendFrame(u32 CanID, u8 *MSG)
{
    byte i;

    /* 等待发送缓冲区空 */
    while (!(CANRFLG & 0x04)) {}

    /* 扩展帧ID写入 */
    /* ID格式转换: 29bit ID -> 4字节寄存器 */
    CANTXIDR0 = (byte)((CanID >> 21) & 0xFF);
    CANTXIDR1 = (byte)((CanID >> 13) & 0xE0) | 0x18;  /* IDE=1, SRR=1 */
    CANTXIDR2 = (byte)((CanID >> 6) & 0xFF);
    CANTXIDR3 = (byte)((CanID << 1) & 0xFE);

    /* 数据 */
    for (i = 0; i < 8; i++) {
        *((volatile byte *)0x0164 + i) = MSG[i];
    }

    /* DLC = 8 */
    CANTXDLR = 0x08;

    /* 启动发送 */
    CANRFLG = 0x04;  /* 清TXE0标志 */
    CANTXTBPR = 0x00; /* 优先级 */

    return 0;
}

/*********************************************************************************************
* 函数名    : Drv_CAN_Test_ReceiveFrame
* 功能      : 轮询接收 - 检查是否有新帧，有则读取到全局CanMsg_Test
* 参数      : 无
* 返回值    : 1=收到一帧, 0=无帧
* 备注      : 调用后数据在 CanMsg_Test 全局变量中
**********************************************************************************************/
u8 Drv_CAN_Test_ReceiveFrame(void)
{
    u32 tmpId;
    byte i, len;

    /* 检查接收缓冲区是否有新帧 */
    if (!(CANRFLG & 0x01)) {
        return 0;  /* 无帧 */
    }

    /* 读取ID */
    tmpId = ((u32)CANRXIDR0 << 24) |
            ((u32)CANRXIDR1 << 16) |
            ((u32)CANRXIDR2 << 8)  |
            ((u32)CANRXIDR3);

    /* 判断扩展帧还是标准帧 */
    if (tmpId & MB_ID_IDE) {
        /* 扩展帧 */
        CanMsg_Test.CanId = ((tmpId >> 1) & 0x3FFFFUL) | ((tmpId >> 3) & 0x1FFC0000UL);
        CanMsg_Test.FrameType = (CANRXIDR3 & 0x01) ? 1 : 0; /* RTR位 */
    } else {
        /* 标准帧 */
        CanMsg_Test.CanId = tmpId >> 21;
        CanMsg_Test.FrameType = (CANRXIDR1 & 0x10) ? 1 : 0;
    }

    /* 读取数据长度 */
    len = CANRXDLR & 0x0F;
    CanMsg_Test.MsgLth = len;

    /* 读取数据 */
    for (i = 0; i < len; i++) {
        CanMsg_Test.Data[i] = *((volatile byte *)0x0174 + i);
    }

    /* 清接收标志，允许下一帧 */
    CANRFLG = 0x01;

    return 1;
}
