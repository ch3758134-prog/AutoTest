<Window x:Class="AutoTest.Frontend.ToolWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Width="1370" Height="850" MinWidth="1030" MinHeight="620"
 Background="{StaticResource AT.Canvas}" Foreground="{StaticResource AT.Text}"
 FontFamily="Microsoft YaHei UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="70"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="34"/>
  </Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource AT.Border}"
   BorderThickness="0,0,0,1">
   <DockPanel Margin="21,0" LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="{StaticResource AT.AccentWash}" CornerRadius="6"
      Padding="12,7" Margin="0,0,11,0">
      <TextBlock Text="前端设计模式 · 无设备连接"
       FontSize="11" Foreground="#2F6EB6" VerticalAlignment="Center"/>
     </Border>
     <ui:Button Content="关闭窗口" Click="Close_Click" Padding="12,8"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Center">
     <TextBlock x:Name="ToolTitle" Text="工具" Style="{StaticResource AT.PageTitle}"/>
     <TextBlock x:Name="ToolSubtitle" Text="独立专业工作区"
      Style="{StaticResource AT.Caption}" Margin="0,4,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ContentControl x:Name="ToolContent" Grid.Row="1"
   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource AT.Border}"
   BorderThickness="0,1,0,0">
   <DockPanel Margin="15,0">
    <TextBlock DockPanel.Dock="Right" Text="{Binding SaveStatus}"
     Foreground="{StaticResource AT.Muted}" FontSize="11" VerticalAlignment="Center"/>
    <TextBlock Text="该窗口从属于 AutoTest 主窗口；当前操作不访问真实 ECU 或主控板。"
     Foreground="{StaticResource AT.Warning}" FontSize="11" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
