<UserControl x:Class="AutoTest.Desktop.Testing.TestEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel Margin="10">
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,9">
   <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding NewStepType,Mode=TwoWay}" Width="128" Margin="0,0,7,4"/>
   <ComboBox ItemsSource="{Binding AvailablePhases}" SelectedItem="{Binding NewStepPhase,Mode=TwoWay}" Width="88" Margin="0,0,7,4"/>
   <Button Content="＋ 阶段根节点" Command="{Binding InsertRootCommand}"/>
   <Button Content="＋ 前插" Command="{Binding InsertBeforeCommand}"/>
   <Button Content="＋ 后插" Command="{Binding InsertAfterCommand}"/>
   <Button Content="↳ 子节点" Command="{Binding InsertChildCommand}"/>
   <Button Content="↳ IF ELSE" Command="{Binding InsertElseCommand}"/>
   <Button Content="上移" Command="{Binding MoveUpCommand}"/>
   <Button Content="下移" Command="{Binding MoveDownCommand}"/>
   <Button Content="复制" Command="{Binding CopyCommand}"/>
   <Button Content="删除" Command="{Binding DeleteCommand}"/>
  </WrapPanel>
  <ListBox ItemsSource="{Binding FilteredSteps}" SelectedItem="{Binding SelectedStep,Mode=TwoWay}" MouseDoubleClick="OnDoubleClick">
   <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding IndexLabel}" Foreground="{StaticResource Subtle}" Margin="3"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="3"><TextBlock Text="{Binding TreeLabel}" FontWeight="Medium"/>
     <TextBlock Text="{Binding NodeType}" Foreground="{StaticResource Subtle}" Margin="8,0,0,0"/></StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding Expected}" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"/>
    <TextBlock Grid.Column="3" Text="{Binding RunBadge}" Foreground="{StaticResource Warning}"/>
   </Grid></DataTemplate></ListBox.ItemTemplate>
   <ListBox.ContextMenu><ContextMenu>
    <MenuItem Header="前插" Click="InsertBefore_Click"/><MenuItem Header="后插" Click="InsertAfter_Click"/>
    <MenuItem Header="插入子步骤" Click="InsertChild_Click"/><MenuItem Header="插入 IF ELSE" Click="InsertElse_Click"/>
    <MenuItem Header="复制步骤及子树" Click="Copy_Click"/>
    <Separator/><MenuItem Header="上移" Click="MoveUp_Click"/><MenuItem Header="下移" Click="MoveDown_Click"/>
    <MenuItem Header="删除" Click="Delete_Click"/>
   </ContextMenu></ListBox.ContextMenu>
  </ListBox>
 </DockPanel>
</UserControl>
