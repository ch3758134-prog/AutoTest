<UserControl x:Class="AutoTest.Desktop.Tools.ControllerConfig.ControllerConfigToolView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F4F8FD" Foreground="#24394F" FontFamily="Microsoft YaHei UI"
 FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True">
 <Grid Margin="11">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="340"/>
   <RowDefinition Height="6"/>
   <RowDefinition Height="196" MinHeight="140"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="2,2,2,11">
   <StackPanel>
    <TextBlock Text="控制器与按键配置" FontSize="22" FontWeight="SemiBold" Foreground="#223850"/>
    <TextBlock Text="20 个按键组合开关经电阻网络形成五路模拟电压；不同 ECU 的映射和电压识别范围由工程配置定义。"
      Foreground="#6E849B" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#DAE6F3" BorderThickness="1"
   CornerRadius="8" Padding="11,8" Margin="0,0,0,10">
   <WrapPanel>
    <TextBlock Text="配置文件" VerticalAlignment="Center" Foreground="#71849C" Margin="0,0,8,0"/>
    <TextBox Width="290" Text="{Binding FilePath,UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
    <Button Content="新建配置" Command="{Binding CreateCommand}"/>
    <Button Content="打开" Command="{Binding OpenCommand}"/>
    <Button Content="保存配置" Style="{StaticResource AtPrimaryButton}" Command="{Binding SaveCommand}"/>
    <Button Content="撤销" Command="{Binding UndoCommand}"/>
    <TextBlock Text="修订" Foreground="#758BA4" VerticalAlignment="Center" Margin="12,0,5,0"/>
    <TextBlock Text="{Binding CurrentRevision}" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </WrapPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="215" MinWidth="185"/>
    <ColumnDefinition Width="7"/>
    <ColumnDefinition Width="*" MinWidth="435"/>
    <ColumnDefinition Width="7"/>
    <ColumnDefinition Width="315" MinWidth="270"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#D9E5F3"
      BorderThickness="1" CornerRadius="8">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F2F6FE" Padding="11,9"
       BorderBrush="#DCE8F4" BorderThickness="0,0,0,1">
      <TextBlock Text="控制器配置" FontSize="15" FontWeight="SemiBold"/>
     </Border>
     <StackPanel DockPanel.Dock="Bottom" Margin="10,10,10,13">
      <TextBlock Text="当前 ECU" Foreground="#71879F" FontSize="11"/>
      <TextBox Text="{Binding EcuName,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
      <TextBlock Text="板型" Foreground="#71879F" FontSize="11"/>
      <TextBox Text="{Binding BoardModel,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
      <TextBlock Text="控制器名称" Foreground="#71879F" FontSize="11"/>
      <TextBox Text="{Binding ControllerName,UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,7"/>
      <WrapPanel>
       <Button Content="添加" Command="{Binding AddControllerCommand}"/>
       <Button Content="重命名" Command="{Binding RenameControllerCommand}"/>
       <Button Content="删除" Command="{Binding RemoveControllerCommand}"/>
      </WrapPanel>
     </StackPanel>
     <ListBox ItemsSource="{Binding Controllers}" SelectedItem="{Binding SelectedController}"
      DisplayMemberPath="Name" BorderThickness="0" Background="White" Margin="9"/>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Column="2" Background="White" BorderBrush="#D9E5F3"
      BorderThickness="1" CornerRadius="8">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="145"/><RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <Border Grid.Row="0" Background="#EFF5FD" Padding="11,10" BorderBrush="#DDE8F4" BorderThickness="0,0,0,1">
      <DockPanel>
       <TextBlock Text="按键组合与五路模拟电压" FontSize="15" FontWeight="SemiBold"/>
       <TextBlock DockPanel.Dock="Right" Text="K01～K20 → V1～V5" Foreground="#347FCB" FontSize="12" FontWeight="SemiBold"/>
      </DockPanel>
     </Border>
     <Grid Grid.Row="1" Margin="15,13,15,10">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.1*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
       <TextBlock Text="按键开关组合" Foreground="#54718F" FontWeight="SemiBold" Margin="0,0,0,7"/>
       <TextBlock Text="K01～K20" FontSize="15" FontWeight="SemiBold" Foreground="#276FC2"/>
       <TextBlock Text="可同时闭合多个开关" FontSize="11" Foreground="#7E90A7" Margin="0,7,0,0"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="➜" FontSize="25" Foreground="#387FCF" VerticalAlignment="Center" Margin="11,0"/>
      <Border Grid.Column="2" Background="#E9F3FF" BorderBrush="#AFD2F8" BorderThickness="1" CornerRadius="9"
        Padding="15,15">
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="电阻网络" FontWeight="SemiBold" Foreground="#3577BD" HorizontalAlignment="Center"/>
        <TextBlock Text="组合编码" FontSize="11" Foreground="#6D87A3" HorizontalAlignment="Center" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
      <TextBlock Grid.Column="3" Text="➜" FontSize="25" Foreground="#387FCF" VerticalAlignment="Center" Margin="11,0"/>
      <Border Grid.Column="4" Background="#E9F3FF" BorderBrush="#AFD2F8" BorderThickness="1" CornerRadius="9"
        Padding="12,15">
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="五路模拟电压" FontWeight="SemiBold" Foreground="#3577BD" HorizontalAlignment="Center"/>
        <TextBlock Text="V1 / V2 / V3 / V4 / V5" FontSize="11" Foreground="#6D87A3" HorizontalAlignment="Center" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
     </Grid>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,3,12,10">
      <StackPanel>
       <DockPanel Margin="0,0,0,9">
        <TextBlock Text="开关状态矩阵（当前选中状态）" FontSize="14" FontWeight="SemiBold"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding StateMaskHex}" Foreground="#4F7FB2" FontSize="12"/>
       </DockPanel>
       <Border Background="#F4F8FE" BorderBrush="#DFE9F5" BorderThickness="1" CornerRadius="7" Padding="7">
        <ItemsControl ItemsSource="{Binding KeyBits}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate><DataTemplate>
          <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked,Mode=TwoWay}" Margin="4,6" MinWidth="62"
            ToolTip="更改配置掩码，不会立即向真实按键板发送输出"/>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </Border>
       <TextBlock Text="开关掩码、目标电压和实测电压均是不同字段；软件不会用配置值假冒物理测量。"
         Foreground="#798DA4" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Column="4" Background="White" BorderBrush="#D9E5F3" BorderThickness="1" CornerRadius="8">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F1F6FE" Padding="12,10" BorderBrush="#DFE9F5" BorderThickness="0,0,0,1">
      <TextBlock Text="状态 / 配置详情" FontSize="15" FontWeight="SemiBold"/>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12">
       <TextBlock Text="状态名称" Foreground="#70859C" Margin="0,4,0,5"/>
       <TextBox Text="{Binding StateName,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="20 位组合掩码" Foreground="#70859C" Margin="0,11,0,5"/>
       <TextBox Text="{Binding StateMaskHex,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="按键动作规则" Foreground="#70859C" Margin="0,11,0,5"/>
       <ComboBox ItemsSource="{Binding Interactions}" SelectedItem="{Binding InteractionChoice}"/>
       <TextBlock Text="松开后返回状态" Foreground="#70859C" Margin="0,11,0,5"/>
       <TextBox Text="{Binding ReturnStateId,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="互斥组（可选）" Foreground="#70859C" Margin="0,11,0,5"/>
       <TextBox Text="{Binding ExclusiveGroup,UpdateSourceTrigger=PropertyChanged}"/>
       <WrapPanel Margin="0,12,0,8">
        <Button Content="添加状态" Command="{Binding AddStateCommand}" Style="{StaticResource AtPrimaryButton}"/>
        <Button Content="更新状态" Command="{Binding UpdateStateCommand}"/>
        <Button Content="删除状态" Command="{Binding RemoveStateCommand}"/>
       </WrapPanel>
       <Button Content="设为默认状态" Command="{Binding SetDefaultCommand}" HorizontalAlignment="Left"/>
       <TextBlock Text="五路电压识别窗口" FontWeight="SemiBold" Margin="0,15,0,8"/>
       <DataGrid ItemsSource="{Binding VoltageWindows}" AutoGenerateColumns="False" IsReadOnly="True"
         Height="128" RowHeaderWidth="0">
        <DataGrid.Columns>
         <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="60"/>
         <DataGridTextColumn Header="目标 V" Binding="{Binding TargetVolts}" Width="*"/>
         <DataGridTextColumn Header="下限" Binding="{Binding MinimumVolts}" Width="*"/>
         <DataGridTextColumn Header="上限" Binding="{Binding MaximumVolts}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
       <WrapPanel Margin="0,8,0,0">
        <TextBlock Text="CH" VerticalAlignment="Center"/>
        <TextBox Width="32" Text="{Binding VoltageChannel,UpdateSourceTrigger=PropertyChanged}" Margin="3,0,5,0"/>
        <TextBlock Text="目标" VerticalAlignment="Center"/>
        <TextBox Width="44" Text="{Binding TargetVolts,UpdateSourceTrigger=PropertyChanged}" Margin="3,0,5,0"/>
        <TextBlock Text="下限" VerticalAlignment="Center"/>
        <TextBox Width="44" Text="{Binding MinVolts,UpdateSourceTrigger=PropertyChanged}" Margin="3,0,5,0"/>
        <TextBlock Text="上限" VerticalAlignment="Center"/>
        <TextBox Width="44" Text="{Binding MaxVolts,UpdateSourceTrigger=PropertyChanged}" Margin="3,0,5,0"/>
       </WrapPanel>
       <Button Content="设置电压窗口" Command="{Binding SetWindowCommand}" HorizontalAlignment="Left" Margin="0,9,0,0"/>
       <TextBlock Text="硬件配置编号" Foreground="#70859C" Margin="0,14,0,5"/>
       <TextBox Text="{Binding HardwareProfileId,UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Height="6" Background="Transparent"/>
  <Grid Grid.Row="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="420"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*" MinWidth="280"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" BorderBrush="#D9E5F3" BorderThickness="1" CornerRadius="8" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F3F7FE" Padding="11,8" BorderBrush="#DFE8F4" BorderThickness="0,0,0,1">
      <DockPanel>
       <TextBlock Text="状态列表与预览" FontSize="14" FontWeight="SemiBold"/>
       <TextBlock DockPanel.Dock="Right" Text="选择左侧控制器后显示其实际状态" FontSize="11" Foreground="#8294A9"/>
      </DockPanel>
     </Border>
     <ListBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" DisplayMemberPath="Name"
      Background="White" BorderThickness="0" Margin="8"/>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Column="2" Background="White" BorderBrush="#D9E5F3" BorderThickness="1" CornerRadius="8" Padding="0">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="#F3F7FE" Padding="11,8">
      <TextBlock Text="人工电压测量记录" FontSize="14" FontWeight="SemiBold"/>
     </Border>
     <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,5,8,8">
      <TextBlock Text="实测 V" VerticalAlignment="Center"/>
      <TextBox Width="57" Text="{Binding MeasuredVolts,UpdateSourceTrigger=PropertyChanged}" Margin="5,0,7,0"/>
      <TextBlock Text="操作员" VerticalAlignment="Center"/>
      <TextBox Width="68" Text="{Binding OperatorId,UpdateSourceTrigger=PropertyChanged}" Margin="4,0,7,0"/>
      <TextBlock Text="证据" VerticalAlignment="Center"/>
      <TextBox Width="75" Text="{Binding EvidenceRef,UpdateSourceTrigger=PropertyChanged}" Margin="4,0,7,0"/>
      <Button Content="记录" Command="{Binding RecordVoltageCommand}" Style="{StaticResource AtPrimaryButton}"/>
     </StackPanel>
     <DataGrid ItemsSource="{Binding Measurements}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
      <DataGrid.Columns>
       <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="55"/>
       <DataGridTextColumn Header="实测 V" Binding="{Binding ValueVolts}" Width="85"/>
       <DataGridTextColumn Header="来源" Binding="{Binding Origin}" Width="110"/>
       <DataGridTextColumn Header="判定" Binding="{Binding Status}" Width="80"/>
       <DataGridTextColumn Header="证据" Binding="{Binding EvidenceRef}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </Border>
  </Grid>
  <DockPanel Grid.Row="5" Margin="3,8,0,0">
   <TextBlock Text="{Binding Error}" Foreground="#BC3C50" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="#536E8C" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
 </Grid>
</UserControl>