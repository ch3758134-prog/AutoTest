<Window x:Class="AutoTest.Desktop.Shell.ManualBenchCanPropertiesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CAN 报文属性" Width="990" Height="690" MinWidth="660" MinHeight="470"
 Background="#F7F8F8" Foreground="#303941" FontSize="13"
 FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterOwner"
 ResizeMode="CanResizeWithGrip">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <ContentControl x:Name="EditorHost" Grid.Row="0"/>
  <TextBlock x:Name="SaveFailureText" Grid.Row="1" Visibility="Collapsed"
   Padding="14,8" Foreground="#B42318" TextWrapping="Wrap"
   Background="#FFF7F4" FontSize="12"/>
 </Grid>
</Window>
