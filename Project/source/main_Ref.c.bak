#include "EAL_GPIO.h"
#include "EAL_Can.h"
#include "MK20D10.h"   /* SIM 时钟门控 */

  /* 如果你之前想打 hello 一并保留也可,这里只放最简 CAN 测试 */

int main(void)
{
  /* 1. CAN 初始化(CAN0 = EAL_CAN_INSTANCE_0, 500 kbps) */
  EAL_Can_Status_t s1 = EAL_Can_Init(EAL_CAN_INSTANCE_0, 500000);
  /* 这里先不打日志,先靠示波器/RTT 看 */
  (void)s1;

  /* 2. 准备一帧:协议 §4.2 的 EXECUTE + KEY_ACTION_PARK + t_hold=500
   *   cmd=0x01, key_action=0x03, t_hold=500, reserved=0 */
  uint8_t frame[8] = {
      0x01, 0x03,
      0xF4, 0x01,         /* 500 小端 = 0x01F4 */
      0x00, 0x00, 0x00, 0x00
  };

  /* 3. 发一帧(ID 0x100 = 按规格;按键板硬件确认是否就是 0x100) */
  EAL_Can_Status_t s2 = EAL_Can_Send(EAL_CAN_INSTANCE_0, 0x100, frame, 8);
  (void)s2;

  while (1)	
		{
      /* 4. 飞线回环时这里能收到自发自收的一帧(协议不依赖应答,主循环空转也能循环) */
      EAL_Can_Frame_t rx;
      EAL_Can_Status_t s3 = EAL_Can_Read(EAL_CAN_INSTANCE_0, &rx);
      (void)s3;
      /* 收到啥先不打;靠示波器或后续加 RTT/UART 打印 */
		}
}