u16 Get_IGN(void)//获取IGN电源电压值
{
	u16 temp;
	temp = (u16)((float)ADC_Info.S.DRV_AD_IGN*AD_IGN_Ratio + 0.5);

	return temp;
}

u16 Get_PressPow()//获取压力电源电压值
{
	u16 temp;
	temp = (u16)((float)ADC_Info.S.DRV_AD_Press_POW*AD_PressPow_Ratio + 0.5);

	return temp;
}

u16 Get_EPB_Pow()//获取 EPB 电源电压值
{
	u16 temp;
	temp = (u16)((float)ADC_Info.S.DRV_AD_EPB_POW*AD_EPBPow_Ratio + 0.5);
	return temp;
}

u16 Get_5V_Pow()
{
	u16 temp;
	temp = (u16)((float)ADC_Info.S.DRV_AD_POW5V*AD_5VPow_Ratio + 0.5);

	return temp;
}

u16 Get_BAUDRATE()
{
	u16 temp;
	//temp = (u16)((float)ADC_Info.S.DRV_AD_BAUDRATE*AD_BAUDRATE_Ratio + 0.5);
	float value = ADC_Info.S.DRV_AD_BAUDRATE*AD_BAUDRATE_Ratio + 0.5;
	temp = (u16)value;
	return temp;
}

void Adc_GetData_10ms(void)
{
	// 获取电池电压数据，并存储在 Pcs_AdcInfor 结构体中
    Pcs_AdcInfor.AD_Bat24V = Get_BAT();
    // 获取压力电源电压数据，并存储在 Pcs_AdcInfor 结构体中
    Pcs_AdcInfor.AD_PressPow = Get_PressPow();
    // 获取按键电源电压数据，并存储在 Pcs_AdcInfor 结构体中
    Pcs_AdcInfor.AD_KeyPow = Get_KeyPow();
    // 获取 EPB 电源电压数据，并存储在 Pcs_AdcInfor 结构体中
    Pcs_AdcInfor.AD_EPBPOW = Get_EPB_Pow();
    // 获取压力1数据，并存储在 Pcs_AdcInfor 结构体中
    //Pcs_AdcInfor.AD_Press1 = Get_Press1();
    // 获取压力2数据，并存储在 Pcs_AdcInfor 结构体中
    //Pcs_AdcInfor.AD_Press2 = Get_Press2();
    // 获取5V电源电压数据，并存储在 Pcs_AdcInfor 结构体中
    Pcs_AdcInfor.AD_VCC5V = Get_5V_Pow();
    // 获取IGN电源电压数据，并存储在 Pcs_AdcInfor 结构体中
    Pcs_AdcInfor.AD_IGN = Get_IGN();
    // 获取波特率数据，并存储在 Pcs_AdcInfor 结构体中
    Pcs_AdcInfor.AD_BAUD = Get_BAUDRATE();
}



void Buad_change(void)
{
	if(get_EPBBaud<= limtHi_BUAD500k && get_EPBBaud >= limtLow_BUAD500k)//500khz
	{
			BUAD_status = 1;//波特率按键切换开
			Drv_CAN_Init();
	}
}
