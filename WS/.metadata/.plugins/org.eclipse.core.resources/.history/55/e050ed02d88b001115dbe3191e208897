#include "sys_include.h"

// 定义静态变量，用于标记SPI接收状态和存储接收到的数据
static u8 SpiRX_flag=0;
static u8 RecData[2];

/*********************************************************************************************
*函数名    : Drv_Spi_Init
*功能      : SPI初始化函数
*输入      : 无
*返回      : 无
*备注      : 初始化SPI模块，设置波特率、时钟极性和相位等参数
*日期      : 
**********************************************************************************************/
void Drv_Spi_Init(void) 
{
  // 清空SPI状态寄存器
  (void)SPIS;                       
  // 清空SPI数据寄存器
  (void)SPID;                       
  // 设置SPI波特率为8分频
  SPIBR = 0x30U;     //(3+1)*2^1=8                 //BaudRateDivisor = (SPPR + 1)*2^(SPR + 1)
  	  	  	  	  	  // SS端口引脚无效，采用IO口高低电平控制 
  // 禁用SPI模式故障检测
  SPIC2 = 0x00U;                  
  // 设置SPI时钟极性和相位
  SPIC1 = 0x10U;     //CPHA = 0,CPOL=0
  // 使能SPI模块
  SPIC1_SPE = 1; 

  //setReg8Bits(PTEDD, 0x02U);  		
  // 配置PTEDD寄存器，设置PTEDD0为输出

  // 拉高片选信号
  Power_CS_High();
}

/*********************************************************************************************
*函数名    : Drv_Spi_Data_TxByte
*功能      : 通过SPI口发送数据8bit
*输入      : wdata - 要发送的数据
*返回      : ERR_OK - 发送成功；ERR_TXFULL - 发送缓冲区满
*备注      : 将数据写入SPI数据寄存器，并等待发送完成
*日期      : 
**********************************************************************************************/
u8 Drv_Spi_Data_TxByte(u8 wdata) 
{
  // 保存要发送的数据
  u8 temp = wdata;
  // 等待发送缓冲区为空
  while (SPIS_SPTEF == 0U) 
  {           
    // 如果发送缓冲区满，返回错误
    return ERR_TXFULL;               
  }
  // 将数据写入SPI数据寄存器
  SPID = temp; 
  // 等待发送缓冲区为空
  while(SPIS_SPTEF!=1);
  // 返回发送成功
  return ERR_OK;         
}

/*********************************************************************************************
*函数名    : ISR(Drv_Spi_Interrupt)
*功能      : SPI串口接收中断
*输入      : 无
*返回      : 无
*备注      : 当SPI接收到数据时，将数据存储在RecData数组中，并标记接收完成
*日期      : 
**********************************************************************************************/
ISR(Drv_Spi_Interrupt)
{
  // 定义静态变量，用于计数接收到的字节数
  static u8 SpiRX_Cnt =0;
  // 检查SPI接收标志
  if(SPIS_SPRF ==1) 
  {
    // 如果接收标志为0，表示尚未接收完成
    if(SpiRX_flag == 0) 
    {
      // 将接收到的数据存储在RecData数组中
      RecData[SpiRX_Cnt++] = SPID;
      // 如果接收到两个字节，重置计数器并标记接收完成
      if(SpiRX_Cnt == 2) 
      {
        SpiRX_Cnt =0;
        SpiRX_flag =1;
      }
    }
     // 如果接收标志为1，表示已经接收完成
     else 
     {
       // 读取SPI数据寄存器以清除接收标志
       (void)SPID;
     }
  }
}

/*********************************************************************************************
*函数名    : Drv_Spi_Data_RxWord
*功能      : 通过SPI口接收数据8bit
*输入      : 无
*返回      : 接收到的数据
*备注      : 等待接收缓冲区非空，然后读取数据寄存器中的数据
*日期      : 
**********************************************************************************************/
u8 Drv_Spi_Data_RxWord(u16 wdata,u16 *rdata) 
{
  // 等待接收缓冲区非空
  while (SPIS_SPRF == 0U) 
  {           
    // 如果接收缓冲区为空，返回0
    return 0;               
  }
  // 读取SPI数据寄存器中的数据
  return SPID; 
}
