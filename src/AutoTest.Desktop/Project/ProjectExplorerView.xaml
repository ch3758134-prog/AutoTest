<UserControl x:Class="AutoTest.Desktop.Project.ProjectExplorerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:AutoTest.Desktop.Shell">
 <DockPanel Margin="9">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="▾ 当前工程 / 富工程图" FontWeight="SemiBold" Margin="4,7"/>
   <TextBox Text="{Binding EditableProjectName,UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,5" ToolTip="工程名称"/>
   <Button Content="应用工程名称" Command="{Binding RenameProjectCommand}"/>
   <TreeView ItemsSource="{Binding ResourceNodes}" MinHeight="110" MaxHeight="260" Margin="0,8,0,6">
    <TreeView.Resources>
     <HierarchicalDataTemplate DataType="{x:Type vm:WorkbenchResourceNode}" ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="11"/>
     </HierarchicalDataTemplate>
    </TreeView.Resources>
   </TreeView>
   <Button Content="导入 DBC" Command="{Binding ImportDbcCommand}"/>
   <TextBlock Text="DBC 信号基础编辑（Factor）" FontWeight="SemiBold" Margin="4,8,0,3"/>
   <ComboBox ItemsSource="{Binding DbcSignals}" SelectedItem="{Binding SelectedDbcSignal,Mode=TwoWay}"
    DisplayMemberPath="Label" MaxDropDownHeight="220" Margin="0,0,0,4"/>
   <TextBox Text="{Binding DbcFactor,UpdateSourceTrigger=PropertyChanged}" ToolTip="Factor 数值 (InvariantCulture)" Margin="0,0,0,5"/>
   <Button Content="应用 DbcEditSession → 新 Revision" Command="{Binding EditDbcCommand}"/>
   <Button Content="创建可编辑 TEST Mock 示例" Command="{Binding AddExampleCommand}" Margin="0,8,0,4"/>
   <TextBlock Text="▾ TEST 步骤检索" FontWeight="SemiBold" Margin="4,8,0,4"/>
  </StackPanel>
  <ListBox ItemsSource="{Binding FilteredSteps}" SelectedItem="{Binding SelectedStep,Mode=TwoWay}" DisplayMemberPath="TreeLabel"/>
 </DockPanel>
</UserControl>
