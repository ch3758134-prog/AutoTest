<Window x:Class="AutoTest.Desktop.Bench.BenchKeyActionEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · 编辑按键动作" Width="1040" Height="790"
 MinWidth="800" MinHeight="630" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource StudioBg}" Foreground="{DynamicResource StudioText}" FontFamily="Segoe UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVis"/>
  <SolidColorBrush x:Key="Muted" Color="#657D95"/>
  
  
  <Style x:Key="KeyToggle" TargetType="ToggleButton">
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Padding" Value="6,10"/>
   <Setter Property="MinHeight" Value="40"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#23374D"/>
   <Setter Property="BorderBrush" Value="#C7D7E7"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers>
    <Trigger Property="IsChecked" Value="True">
     <Setter Property="Background" Value="#176AB2"/>
     <Setter Property="Foreground" Value="White"/>
     <Setter Property="BorderBrush" Value="#176AB2"/>
    </Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" />
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,14">
   <TextBlock Text="编辑按键动作" Style="{StaticResource AtPageTitle}"/>
   <TextBlock Text="选择动作、编排步骤并用按钮设置本步骤的 20 路开关；编辑不会自动操作设备。"
    Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="240" MinWidth="200"/>
    <ColumnDefinition Width="12"/>
    <ColumnDefinition Width="*" MinWidth="480"/>
   </Grid.ColumnDefinitions>
   <!-- Left: reusable user-created actions, selection only in editor. -->
   <Border Grid.Column="0" Background="White" BorderBrush="#DCE5EF"
    BorderThickness="1" CornerRadius="6" Padding="12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button Content="＋ 新建动作" Command="{Binding NewActionCommand}"
       Style="{StaticResource AtPrimaryButton}" Margin="0,0,0,6"/>
      <WrapPanel>
       <Button Content="复制" Command="{Binding CopyActionCommand}"/>
       <Button Content="删除" Command="{Binding DeleteActionCommand}" Margin="0"/>
      </WrapPanel>
     </StackPanel>
     <TextBlock DockPanel.Dock="Top" Text="动作按钮" FontWeight="SemiBold"
      FontSize="15" Margin="0,0,0,10"/>
     <ListBox ItemsSource="{Binding Actions}"
      SelectedItem="{Binding SelectedAction,Mode=TwoWay}"
      Background="Transparent" BorderThickness="0"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Border Background="#F4F8FD" BorderBrush="#D0DEEB"
         BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,7">
         <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
           FontSize="14" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Steps.Count,StringFormat=共 {0} 个步骤}"
           Foreground="#657D95" FontSize="11" Margin="0,5,0,0"/>
         </StackPanel>
        </Border>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>

   <!-- Right: direct step editing; the only K01-K20 grid in the editor. -->
   <Border Grid.Column="2" Background="White" BorderBrush="#DCE5EF"
    BorderThickness="1" CornerRadius="6" Padding="15">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="165"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>

     <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Text="动作名称" VerticalAlignment="Center"
       FontWeight="SemiBold" Margin="0,0,12,0"/>
      <TextBox x:Name="ActionNameBox" Grid.Column="1"
       Text="{Binding SelectedAction.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       FontSize="15" MinHeight="33"
       ToolTip="为动作设置可以直接显示在台架按钮上的名字"/>
     </Grid>
     <DockPanel Grid.Row="1" Margin="0,0,0,7">
      <WrapPanel DockPanel.Dock="Right">
       <Button Content="+ 开关组合" Command="{Binding AddSetKeysCommand}"/>
       <Button Content="+ 保持" Command="{Binding AddHoldCommand}"/>
       <Button Content="↑" Command="{Binding MoveStepUpCommand}" MinWidth="29" Padding="5"/>
       <Button Content="↓" Command="{Binding MoveStepDownCommand}" MinWidth="29" Padding="5"/>
       <Button Content="删除" Command="{Binding RemoveStepCommand}" Margin="0"/>
      </WrapPanel>
      <TextBlock Text="动作步骤" FontWeight="SemiBold" FontSize="15"
       VerticalAlignment="Center"/>
     </DockPanel>
     <ListBox Grid.Row="2" ItemsSource="{Binding Steps}"
      SelectedItem="{Binding SelectedStep,Mode=TwoWay}"
      DisplayMemberPath="Summary" BorderBrush="#DCE5EF"
      FontSize="13" Padding="5" Margin="0,0,0,12"/>

     <Border Grid.Row="3" BorderBrush="#DCE5EF" BorderThickness="1"
      CornerRadius="5" Background="#FAFCFF" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="当前步骤" FontWeight="SemiBold" FontSize="15"
         Margin="0,0,0,10"/>
        <Grid Margin="0,0,0,9">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="步骤名称" VerticalAlignment="Center" Margin="0,0,10,0"/>
         <TextBox Grid.Column="1" Text="{Binding SelectedStep.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
          IsEnabled="{Binding CanEdit}" ToolTip="例如：按下实验键、保持识别、松开"/>
        </Grid>
        <StackPanel Visibility="{Binding IsKeyStep,Converter={StaticResource BoolVis}}">
         <TextBlock Text="开关组合（勾选＝闭合，不勾选＝断开）"
          FontWeight="SemiBold" Margin="0,0,0,5"/>
         <TextBlock Text="当前步骤完整设置 20 路开关。允许同时闭合多路；真实输出是 KEY_SIM 五路模拟电压。"
          Foreground="{StaticResource Muted}" FontSize="11"
          TextWrapping="Wrap" Margin="0,0,0,8"/>
         <ItemsControl ItemsSource="{Binding Switches}" IsEnabled="{Binding CanEdit}">
          <ItemsControl.ItemsPanel>
           <ItemsPanelTemplate><UniformGrid Columns="10"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <ToggleButton Content="{Binding BitLabel}"
             Style="{StaticResource KeyToggle}"
             IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
             ToolTip="点击编辑当前步骤；不会立即发送给设备"/>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
         <WrapPanel Margin="0,10,0,5">
          <Button Content="现场试发当前开关组合" Command="{Binding SendSelectedStepCommand}"
           ToolTip="真实改变按键板开关组合，需连接主控并确认；配置页面中的勾选本身不会发送"/>
          <Button Content="清空当前步骤选择" Command="{Binding ClearMaskCommand}" Margin="0"
           ToolTip="仅修改当前步骤的编辑草稿，不会松开真实设备按键"/>
         </WrapPanel>
         <TextBlock Text="{Binding SelectedStepResult}" Foreground="#536F89"
          TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Visibility="{Binding IsHoldStep,Converter={StaticResource BoolVis}}">
         <TextBlock Text="保持前一步的完整开关状态，不再发送新的组合。"
          Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
         <WrapPanel>
          <TextBlock Text="保持时间" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Width="120" Text="{Binding SelectedStep.DurationMsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="8,0,0,0"/>
         </WrapPanel>
        </StackPanel>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Grid>
   </Border>
  </Grid>
  <Grid Grid.Row="2" Margin="0,12,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="{Binding Status}" Foreground="#536F89" TextWrapping="Wrap" FontSize="11"/>
    <TextBlock Text="{Binding Progress}" Foreground="#8B6733" TextWrapping="Wrap" FontSize="11"/>
   </StackPanel>
   <WrapPanel Grid.Column="1" VerticalAlignment="Center">
    <Button Content="保存动作配置" Style="{StaticResource AtPrimaryButton}"
      Command="{Binding SaveActionsCommand}"
      ToolTip="将当前动作配置保存到当前工程，不会向真实主控发送指令"/>
    <Button Content="关闭" Click="CloseEditor_Click"/>
    <Button Content="现场试运行整个动作" Command="{Binding RunActionCommand}"
      ToolTip="向真实按键板发送多步骤操作，需要主控连接和人工确认"/>
    <Button Content="停止动作" Style="{StaticResource AtDangerButton}"
      IsEnabled="{Binding IsActionRunning}" Command="{Binding StopActionCommand}" Margin="0"/>
   </WrapPanel>
  </Grid>
 </Grid>
</Window>