<UserControl x:Class="AutoTest.Desktop.Tools.ControllerConfig.ControllerConfigToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Background="{DynamicResource StudioBg}" Foreground="{DynamicResource StudioText}" FontFamily="Segoe UI" FontSize="13">
<UserControl.Resources>
  
  
  
  
  
  
  
  
 </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="控制器与按键电压配置" Style="{StaticResource AtPageTitle}" Margin="0,0,0,7"/>
      <WrapPanel>
        <TextBlock Text="ECU 型号" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox Width="155" Margin="0,0,12,0" Text="{Binding EcuName,UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="板型" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox Width="155" Margin="0,0,12,0" Text="{Binding BoardModel,UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="硬件配置 ID" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox Width="260" Text="{Binding HardwareProfileId,UpdateSourceTrigger=PropertyChanged}"/>
      </WrapPanel>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBlock Text="配置文件" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <TextBox Width="370" Text="{Binding FilePath,UpdateSourceTrigger=PropertyChanged}"
       ToolTip="本地配置 JSON 文件路径" Margin="0,0,8,0"/>
      <Button Content="新建" Command="{Binding CreateCommand}"/>
      <Button Content="打开" Command="{Binding OpenCommand}"/>
      <Button Content="保存配置" Style="{StaticResource AtPrimaryButton}" Command="{Binding SaveCommand}"/>
      <Button Content="撤销编辑" Command="{Binding UndoCommand}"/>
      <TextBlock Text="修订" Margin="9,0,5,0" VerticalAlignment="Center" Style="{StaticResource AtHint}"/>
      <TextBlock Text="{Binding CurrentRevision}" VerticalAlignment="Center" FontWeight="SemiBold"/>
    </WrapPanel>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="控制器" Grid.Column="0" Margin="0,0,8,0">
        <DockPanel Margin="6"><StackPanel DockPanel.Dock="Bottom">
          <TextBox Text="{Binding ControllerName, UpdateSourceTrigger=PropertyChanged}" ToolTip="控制器名称" Margin="0,4"/>
          <WrapPanel><Button Content="添加" Command="{Binding AddControllerCommand}" Padding="8,3"/>
            <Button Content="重命名" Command="{Binding RenameControllerCommand}" Padding="8,3" Margin="4,0"/>
            <Button Content="删除" Command="{Binding RemoveControllerCommand}" Padding="8,3"/></WrapPanel>
        </StackPanel><ListBox ItemsSource="{Binding Controllers}" SelectedItem="{Binding SelectedController}" DisplayMemberPath="Name"/>
        </DockPanel>
      </GroupBox>
      <GroupBox Header="状态（任意数量）" Grid.Column="1" Margin="0,0,8,0"><DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="按键状态名称 / 20 路开关编码（HEX）" Foreground="{DynamicResource StudioMuted}"/>
          <TextBox Text="{Binding StateName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
          <TextBox Text="{Binding StateMaskHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
          <ComboBox ItemsSource="{Binding Interactions}" SelectedItem="{Binding InteractionChoice}" Margin="0,3"/>
          <TextBlock Text="回弹目标 State GUID"/><TextBox Text="{Binding ReturnStateId, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
          <TextBlock Text="互斥组（可选）"/><TextBox Text="{Binding ExclusiveGroup, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>
          <WrapPanel Margin="0,4,0,0"><Button Content="新增" Command="{Binding AddStateCommand}" Padding="8,3"/>
            <Button Content="更新" Command="{Binding UpdateStateCommand}" Padding="8,3" Margin="4,0"/>
            <Button Content="删除" Command="{Binding RemoveStateCommand}" Padding="8,3"/>
            <Button Content="设默认" Command="{Binding SetDefaultCommand}" Padding="8,3" Margin="4,0"/></WrapPanel>
        </StackPanel>
        <ListBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" DisplayMemberPath="Name"/>
      </DockPanel></GroupBox>
      <GroupBox Grid.Column="2" Header="五路电压窗口 / 人工测量事实"><Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding VoltageWindows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
          <DataGrid.Columns><DataGridTextColumn Header="通道" Binding="{Binding Channel}"/>
            <DataGridTextColumn Header="目标 V" Binding="{Binding TargetVolts}"/>
            <DataGridTextColumn Header="最低 V" Binding="{Binding MinimumVolts}"/>
            <DataGridTextColumn Header="最高 V" Binding="{Binding MaximumVolts}"/></DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7"><TextBlock Text="CH" VerticalAlignment="Center"/>
          <TextBox Width="35" Text="{Binding VoltageChannel, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,8,0"/>
          <TextBlock Text="目标" VerticalAlignment="Center"/><TextBox Width="55" Text="{Binding TargetVolts, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,8,0"/>
          <TextBlock Text="下限" VerticalAlignment="Center"/><TextBox Width="55" Text="{Binding MinVolts, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,8,0"/>
          <TextBlock Text="上限" VerticalAlignment="Center"/><TextBox Width="55" Text="{Binding MaxVolts, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,8,0"/>
          <Button Content="设置窗口" Command="{Binding SetWindowCommand}" Padding="9,3"/>
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Measurements}" AutoGenerateColumns="False" IsReadOnly="True">
          <DataGrid.Columns><DataGridTextColumn Header="CH" Binding="{Binding Channel}"/>
            <DataGridTextColumn Header="实测 V" Binding="{Binding ValueVolts}"/>
            <DataGridTextColumn Header="来源" Binding="{Binding Origin}"/>
            <DataGridTextColumn Header="判定" Binding="{Binding Status}"/>
            <DataGridTextColumn Header="证据" Binding="{Binding EvidenceRef}" Width="*"/>
            <DataGridTextColumn Header="Rev" Binding="{Binding ConfigurationRevision}"/></DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="3" Margin="0,6"><TextBlock Text="录入 V" VerticalAlignment="Center"/>
          <TextBox Width="60" Text="{Binding MeasuredVolts, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,8,0"/>
          <TextBlock Text="操作员" VerticalAlignment="Center"/><TextBox Width="70" Text="{Binding OperatorId, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,8,0"/>
          <TextBlock Text="证据引用" VerticalAlignment="Center"/><TextBox Width="110" Text="{Binding EvidenceRef, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,8,0"/>
          <Button Content="记录人工测量" Command="{Binding RecordVoltageCommand}" Padding="9,3"/>
        </WrapPanel>
      </Grid></GroupBox>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,8,0,0"><TextBlock Text="{Binding Status}"/>
      <TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/>
      <TextBlock Foreground="#8F611B" Text="配置数据不表示物理输出。真实 Key/IGN/CAN TX 默认禁止，台架操作须通过共享安全门禁。"/></StackPanel>
  </Grid>
</UserControl>
