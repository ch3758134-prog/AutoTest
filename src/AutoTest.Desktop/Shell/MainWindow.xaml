<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:prism="http://prismlibrary.com/"
 prism:ViewModelLocator.AutoWireViewModel="True"
 Title="AutoTest · ECU 测试与开发" Width="1600" Height="940"
 MinWidth="1210" MinHeight="735" WindowState="Maximized"
 WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
 FontFamily="Microsoft YaHei UI" FontSize="13"
 Background="#F3F7FC" Foreground="#24364C"
 Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="Border" Color="#DCE6F2"/>
  <SolidColorBrush x:Key="Muted" Color="#687F98"/>
  <Style x:Key="IdeDocuments" TargetType="{x:Type TabControl}">
   <Setter Property="Background" Value="#F4F8FD"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="{x:Type TabControl}">
      <Grid Background="{TemplateBinding Background}" KeyboardNavigation.TabNavigation="Local">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border Grid.Row="0" Background="#F0F5FC" BorderBrush="#DEE8F3" BorderThickness="0,0,0,1">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
          CanContentScroll="True" Focusable="False">
         <TabPanel IsItemsHost="True" Background="#F0F5FC" />
        </ScrollViewer>
       </Border>
       <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="RailAction" TargetType="{x:Type Button}" BasedOn="{StaticResource AtQuietButton}">
   <Setter Property="MinHeight" Value="48"/>
   <Setter Property="MinWidth" Value="48"/>
   <Setter Property="FontSize" Value="20"/>
   <Setter Property="Foreground" Value="#526C88"/>
   <Setter Property="Margin" Value="0,0,0,7"/>
   <Setter Property="Padding" Value="5,6"/>
  </Style>
  <Style x:Key="TopAction" TargetType="{x:Type Button}" BasedOn="{StaticResource AtQuietButton}">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#263A52"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="0,0,3,0"/>
  </Style>
  <Style x:Key="TopPrimary" TargetType="{x:Type Button}" BasedOn="{StaticResource AtPrimaryButton}">
   <Setter Property="MinHeight" Value="39"/>
   <Setter Property="Padding" Value="15,8"/>
   <Setter Property="Margin" Value="0,0,7,0"/>
  </Style>
 </Window.Resources>
 <Window.InputBindings>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
 </Window.InputBindings>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="46"/>
   <RowDefinition Height="63"/>
   <RowDefinition Height="*" MinHeight="360"/>
   <RowDefinition x:Name="LogRow" Height="0" MinHeight="0"/>
   <RowDefinition Height="31"/>
  </Grid.RowDefinitions>
  <!-- Professional IDE header: project identity, not an extra nested command menu. -->
  <Border Grid.Row="0" Background="#F7FAFE" BorderBrush="#DFE8F4" BorderThickness="0,0,0,1">
   <DockPanel Margin="18,0,19,0">
    <TextBlock DockPanel.Dock="Right" Text="ECU 测试与开发" Foreground="#74869B" FontSize="12"
      VerticalAlignment="Center"/>
    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="6" Background="#3587E7"
      Margin="0,0,12,0" VerticalAlignment="Center">
     <TextBlock Text="A" Foreground="White" FontSize="17" FontWeight="Bold"
       HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <TextBlock DockPanel.Dock="Left" Text="AutoTest" Foreground="#182B42" FontSize="18"
      FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
    <TextBlock DockPanel.Dock="Left" Text="/" Foreground="#A0AEC0" FontSize="16"
      VerticalAlignment="Center" Margin="0,0,16,0"/>
    <TextBlock Text="{Binding ProjectLabel}" Foreground="#526D89" FontSize="12"
      VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="720"/>
   </DockPanel>
  </Border>

  <!-- Exactly one global operation bar. All specialist tools open their own Window. -->
  <Border Grid.Row="1" Background="White" BorderBrush="#DCE6F2" BorderThickness="0,0,0,1">
   <DockPanel Margin="16,0,18,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse x:Name="StationLed" Width="9" Height="9" Fill="#9BAFC6" Margin="0,0,8,0"/>
     <TextBlock x:Name="StationStatus" Text="主控未连接" FontSize="12" Foreground="#536C85"
       VerticalAlignment="Center" Margin="0,0,10,0"/>
     <Button x:Name="StationConnectButton" Content="连接设备" Click="OpenStation_Click"
       ToolTip="发现并连接真实 USB 主控；连接不会触发 ECU、按键、IGN 或 CAN 输出"
       MinHeight="35" Padding="12,6" Margin="0,0,12,0"/>
     <Border Width="1" Height="23" Background="#DAE3EE" Margin="1,0,13,0"/>
     <TextBlock x:Name="ScannerStatus" Text="扫码：等待编号" FontSize="11"
       Foreground="#6E8096" MaxWidth="195" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="打开工程" Command="{Binding OpenProjectCommand}" Style="{StaticResource TopAction}"/>
     <Button Content="保存工程" Command="{Binding SaveCommand}" Style="{StaticResource TopAction}"/>
     <Border Width="1" Height="22" Background="#DAE3EE" Margin="6,0,14,0"/>
     <Button Content="✎  编辑测试程序" Click="OpenTest_Click" Style="{StaticResource TopPrimary}"/>
     <Button Content="▷  自动测试运行" Click="OpenRun_Click" Style="{StaticResource TopAction}"/>
     <Border Width="1" Height="22" Background="#DAE3EE" Margin="8,0,14,0"/>
     <Button Content="▣  手动台架" Click="OpenBench_Click" Style="{StaticResource TopAction}"
        ToolTip="独立窗口：CAN 收发、KEY_SIM、IGN 与夹具"/>
     <Menu Background="Transparent" VerticalAlignment="Center">
      <MenuItem Header="专业工具 ▾" ToolTip="DBC、UDS、烧录、波形等全部独立窗口">
       <MenuItem Header="DBC 数据库编辑" Click="OpenDbc_Click"/>
       <MenuItem Header="UDS 诊断" Click="OpenUds_Click"/>
       <MenuItem Header="CAN 烧录" Click="OpenFlash_Click"/>
       <MenuItem Header="波形分析" Click="OpenWave_Click"/>
       <MenuItem Header="控制器与按键配置" Click="OpenController_Click"/>
       <MenuItem Header="CAN 接收监视" Click="OpenCan_Click"/>
       <Separator/>
       <MenuItem Header="扫码与生产" Click="OpenProduction_Click"/>
       <MenuItem Header="运行记录与报告" Click="OpenRecords_Click"/>
       <MenuItem Header="操作审计" Click="OpenAudit_Click"/>
      </MenuItem>
      <MenuItem Header="更多 ▾">
       <MenuItem Header="新建工程" Command="{Binding NewProjectCommand}"/>
       <MenuItem Header="载入 UI 评审示例工程" Click="OpenReviewSample_Click"/>
       <MenuItem Header="导入 DBC" Command="{Binding ImportDbcCommand}"/>
       <MenuItem Header="检查工程与引用" Command="{Binding ValidateCommand}"/>
       <Separator/>
       <MenuItem Header="显示或隐藏工程资源" Click="ToggleExplorer_Click"/>
       <MenuItem Header="显示或隐藏通信日志" Click="ToggleBottom_Click"/>
       <MenuItem Header="查找命令（Ctrl+K）" Click="CommandPalette_Click"/>
      </MenuItem>
     </Menu>
    </StackPanel>
   </DockPanel>
  </Border>
  <!-- Fixed activity rail + discoverable explorer + ONE editor/document host. -->
  <Grid Grid.Row="2" Background="#F4F8FD">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="60"/>
    <ColumnDefinition x:Name="ExplorerColumn" Width="295" MinWidth="0"/>
    <ColumnDefinition x:Name="ExplorerSplitterColumn" Width="5"/>
    <ColumnDefinition Width="*" MinWidth="710"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#F8FAFD" BorderBrush="#DFE8F4" BorderThickness="0,0,1,0">
    <StackPanel Margin="5,12,5,0">
     <Button Content="⌂" ToolTip="工程资源" Click="ToggleExplorer_Click" Style="{StaticResource RailAction}"/>
     <Button Content="▤" ToolTip="测试程序编辑" Click="OpenTest_Click" Style="{StaticResource AtPrimaryButton}"
       MinWidth="48" MinHeight="48" FontSize="22" Padding="6" Margin="0,0,0,7"/>
     <Button Content="▷" ToolTip="自动测试运行" Click="OpenRun_Click" Style="{StaticResource RailAction}"/>
     <Button Content="▣" ToolTip="手动台架（独立窗口）" Click="OpenBench_Click" Style="{StaticResource RailAction}"/>
     <Button Content="⌁" ToolTip="波形分析（独立窗口）" Click="OpenWave_Click" Style="{StaticResource RailAction}"/>
     <Button Content="⚙" ToolTip="控制器配置（独立窗口）" Click="OpenController_Click" Style="{StaticResource RailAction}"/>
     <Button Content="⌕" ToolTip="搜索命令" Click="CommandPalette_Click" Style="{StaticResource RailAction}"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="1" x:Name="ExplorerPanel" Background="White"
      BorderBrush="#DCE6F2" BorderThickness="0,0,1,0">
    <ContentControl x:Name="ExplorerDocumentHost" Background="White"/>
   </Border>
   <GridSplitter x:Name="ExplorerSplitter" Grid.Column="2" Width="5"
     Background="#E9EFF6" HorizontalAlignment="Stretch"/>
   <TabControl x:Name="DocumentTabs" Grid.Column="3" Background="#F4F8FD"
     Style="{StaticResource IdeDocuments}" BorderThickness="0"
     SelectionChanged="DocumentTabs_SelectionChanged"/>
  </Grid>

  <!-- Optional diagnostics dock: completely hidden until explicitly requested. -->
  <Border Grid.Row="3" Background="White" BorderBrush="#DCE6F2" BorderThickness="0,1,0,0">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="收起 / 展开" Click="ToggleBottom_Click"
      MinHeight="26" Padding="10,2" Style="{StaticResource AtQuietButton}"/>
    <TabControl x:Name="EvidenceTabs" Visibility="Collapsed" BorderThickness="0" Background="White">
     <TabItem Header="CAN 接收记录"><DataGrid x:Name="CanTraceGrid" AutoGenerateColumns="True" IsReadOnly="True" RowHeaderWidth="0"/></TabItem>
     <TabItem Header="UDS / ISO-TP"><DataGrid x:Name="UdsTraceGrid" AutoGenerateColumns="True" IsReadOnly="True" RowHeaderWidth="0"/></TabItem>
     <TabItem Header="操作审计"><DataGrid x:Name="AuditGrid" AutoGenerateColumns="True" IsReadOnly="True" RowHeaderWidth="0"/></TabItem>
    </TabControl>
   </DockPanel>
  </Border>
  <Border Grid.Row="4" Background="White" BorderBrush="#DEE8F2" BorderThickness="0,1,0,0" Padding="16,4">
   <DockPanel>
    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11" Foreground="#647990"
      TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="720"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse Width="7" Height="7" Fill="#3387E4" Margin="0,0,8,0"/>
     <TextBlock Text="就绪" Foreground="#54718F" FontSize="11" Margin="0,0,16,0"/>
     <TextBlock Text="{Binding ProjectLabel}" FontSize="11" Foreground="#72849A" MaxWidth="600"
       TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </DockPanel>
  </Border>
 </Grid>
</Window>