/*
 * Driver_CAN_Test.c
 *
 * CAN 测试驱动 - 轮询接收模式
 * 基于 Driver_CAN.c 修改：
 * 1. 滤波器全开（接收所有帧）
 * 2. 轮询接收（不开中断）
 */

#include "sys_include.h"
#include "Driver_CAN_Test.h"

CanMsgInf_Test CanMsg_Test;
static u8 ExtendedFrame;
static u8 StandardFrame;

byte Drv_CAN_Test_SendFrame(u32 CanID, byte *MSG)
{
    u8 i;
    TMsgBuff *MsgBuff;
    u32 tmpId = CanID;

    if (!(CANTFLG & 0x07)) {
        return ERR_TXFULL;
    }
    CANTBSEL = CANTFLG;
    MsgBuff = (TMsgBuff *)&CANTIDR0;

    tmpId = (((tmpId & 0x1FFC0000UL) << 3) | 0x00180000UL | ((tmpId & 0x0003FFFFUL) << 1));
    MsgBuff->IDR3 = ((DwordSwap *)&tmpId)->b.b3;
    MsgBuff->IDR2 = ((DwordSwap *)&tmpId)->b.b2;
    MsgBuff->IDR1 = ((DwordSwap *)&tmpId)->b.b1;
    MsgBuff->IDR0 = ((DwordSwap *)&tmpId)->b.b0;

    for (i = 0; i < 8; i++) {
        MsgBuff->Data[i] = MSG[i];
    }

    MsgBuff->DLR = 8;
    MsgBuff->TBPR = 0x00;

    CANTFLG = CANTBSEL;
    return ERR_OK;
}

void Drv_CAN_Test_ReadFrame(CanMsgInf_Test *Msg)
{
    byte i, Length;
    u32 tmpId = 0;

    ((DwordSwap *)&tmpId)->b.b0 = CANRIDR0;
    ((DwordSwap *)&tmpId)->b.b1 = CANRIDR1;
    ((DwordSwap *)&tmpId)->b.b2 = CANRIDR2;
    ((DwordSwap *)&tmpId)->b.b3 = CANRIDR3;

    if (tmpId & MB_ID_IDE) {
        Msg->CanId = ((tmpId >> 1) & 0x3FFFFUL) | ((tmpId >> 3) & 0x1FFC0000UL);
        ExtendedFrame = 1;
    } else {
        Msg->CanId = tmpId >> 21;
        StandardFrame = 1;
    }

    if (ExtendedFrame) {
        Msg->FrameType = (CANRIDR3 & 0x01) ? 1 : 0;
        ExtendedFrame = 0;
    }

    if (StandardFrame) {
        Msg->FrameType = (CANRIDR1 & 0x10) ? 1 : 0;
        StandardFrame = 0;
    }

    Length = (byte)(CANRDLR & 0x0F);
    Msg->MsgLth = Length;

    for (i = 0; i < Length; i++) {
        Msg->Data[i] = *((byte *)&CANRDSR0 + i);
    }

    CANRFLG = 1;
}

void Drv_CAN_Test_Init(void)
{
    u32 AcFilterId = 0;

    CANCTL1 = 0x80U;
    CANCTL0 = 0x01U;

    /* 滤波器全开 - 32-bit 模式两组都设成接收所有 */
    CANIDAC_IDAM = 0x00U;

    CANIDAR0 = 0x00U;
    CANIDAR1 = 0x00U;
    CANIDAR2 = 0x00U;
    CANIDAR3 = 0x00U;
    CANIDMR0 = 0xFFU;
    CANIDMR1 = 0xFFU;
    CANIDMR2 = 0xFFU;
    CANIDMR3 = 0xFFU;

    CANIDAR4 = 0x00U;
    CANIDAR5 = 0x00U;
    CANIDAR6 = 0x00U;
    CANIDAR7 = 0x00U;
    CANIDMR4 = 0xFFU;
    CANIDMR5 = 0xFFU;
    CANIDMR6 = 0xFFU;
    CANIDMR7 = 0xFFU;

    CANBTR0 = 0x43U;
    CANBTR1 = 0x3AU;

    CANCTL1 = 0x80U | 0x10U;
    CANCTL0 = 0x00U;

    while (CANCTL1 & 0x01) {}

    CANRFLG = 0xFFU;
}

u8 Drv_CAN_Test_ReceiveFrame(void)
{
    if (!(CANRFLG & 0x01)) {
        return 0;
    }
    Drv_CAN_Test_ReadFrame(&CanMsg_Test);
    return 1;
}
