<UserControl x:Class="AutoTest.Desktop.Tools.Testing.LabTestWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AutoTest.Desktop.Tools.Testing"
             Background="#101620" Foreground="#E2EDF7" FontFamily="Segoe UI" FontSize="13">
  <UserControl.InputBindings>
    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="F5" Command="{Binding RunMockCommand}"/>
    <KeyBinding Key="F10" Command="{Binding StepCommand}"/>
  </UserControl.InputBindings>
  <UserControl.Resources>
    <HierarchicalDataTemplate DataType="{x:Type local:LabTreeRow}" ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding Caption}" FontSize="12.5" Margin="3,4"/>
    </HierarchicalDataTemplate>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#263748"/><Setter Property="Foreground" Value="#E2EDF7"/>
      <Setter Property="BorderBrush" Value="#314458"/>
      <Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="9,3"/>
      <Setter Property="Margin" Value="3,2"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E2EDF7"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
      <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101620"/><Setter Property="Foreground" Value="#E2EDF7"/>
      <Setter Property="BorderBrush" Value="#314458"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#192431"/><Setter Property="Foreground" Value="#E2EDF7"/>
      <Setter Property="BorderBrush" Value="#314458"/>
    </Style>
  </UserControl.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="True" Margin="3,0,3,9">
      <TextBlock DockPanel.Dock="Left" Text="TEST PROGRAM" FontSize="19" FontWeight="SemiBold" Margin="0,0,18,0"/>
      <Border DockPanel.Dock="Right" Background="#493425" BorderBrush="#876038" BorderThickness="1"
              CornerRadius="3" Padding="9,4">
        <TextBlock Text="{Binding SourceLabel}" Foreground="#E8B967" FontWeight="Bold" FontSize="11"/>
      </Border>
      <StackPanel>
       <TextBlock Text="{Binding DocumentName}" Foreground="#92A4B7" FontSize="13"/>
       <TextBlock Text="{Binding ProjectAssetStatus}" Foreground="#81C9BA" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,9">
      <Button Content="Open" Command="{Binding OpenCommand}"/>
      <Button Content="Save file" Command="{Binding SaveCommand}"/>
      <Button Content="纳入当前工程 / 新 Revision" Command="{Binding SaveToProjectCommand}" Background="#176A8C"/>
      <Button Content="从工程重新加载" Command="{Binding ReloadProjectCommand}"/>
      <Button Content="Undo" Command="{Binding UndoCommand}"/>
      <Button Content="Redo" Command="{Binding RedoCommand}"/>
      <Separator Width="12"/>
      <Button Content="Preflight" Command="{Binding PreflightCommand}"/>
      <Button Content="Run Mock" Command="{Binding RunMockCommand}" FontWeight="SemiBold"/>
      <Button Content="Pause" Command="{Binding PauseCommand}"/>
      <Button Content="Resume" Command="{Binding ResumeCommand}"/>
      <Button Content="Step" Command="{Binding StepCommand}"/>
      <Button Content="Skip selected" Command="{Binding SkipCommand}"/>
      <Button Content="Run to selected" Command="{Binding RunToCommand}"/>
      <Button Content="STOP" Command="{Binding StopCommand}" Foreground="#FF7886" FontWeight="Bold"/>
    </WrapPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#192431" BorderBrush="#314458" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="8,7,8,4">
            <TextBlock Text="Steps · Prepare / Test / Cleanup" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <WrapPanel>
              <ComboBox Width="145" Margin="2" ItemsSource="{Binding StepTypes}"
                        SelectedItem="{Binding SelectedInsertType, Mode=TwoWay}"/>
              <Button Content="Insert" Command="{Binding InsertCommand}"/>
              <Button Content="Copy" Command="{Binding CopyCommand}"/>
              <Button Content="Delete" Command="{Binding DeleteCommand}"/>
              <Button Content="↑" Width="30" Command="{Binding UpCommand}"/>
              <Button Content="↓" Width="30" Command="{Binding DownCommand}"/>
            </WrapPanel>
          </StackPanel>
          <TreeView x:Name="ProgramTree" ItemsSource="{Binding Tree}"
                    SelectedItemChanged="ProgramTree_OnSelectedItemChanged"
                    BorderThickness="0" Padding="8,3">
            <TreeView.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Insert step" Command="{Binding InsertCommand}"/>
                <MenuItem Header="Copy step" Command="{Binding CopyCommand}"/>
                <MenuItem Header="Delete step" Command="{Binding DeleteCommand}"/>
                <Separator/>
                <MenuItem Header="Move up" Command="{Binding UpCommand}"/>
                <MenuItem Header="Move down" Command="{Binding DownCommand}"/>
                <Separator/>
                <MenuItem Header="Run to selected" Command="{Binding RunToCommand}"/>
                <MenuItem Header="Skip selected" Command="{Binding SkipCommand}"/>
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Border Grid.Column="2" Background="#192431" BorderBrush="#314458" BorderThickness="1" Padding="12">
        <StackPanel>
          <TextBlock Text="Step properties" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,13"/>
          <TextBlock Text="Name" Foreground="#92A4B7"/>
          <TextBox Text="{Binding SelectedName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,5"/>
          <Button Content="Rename selected step" Command="{Binding RenameCommand}" HorizontalAlignment="Left" Margin="0,0,0,15"/>
          <TextBlock Text="Current parameters" Foreground="#92A4B7" Margin="0,0,0,4"/>
          <DataGrid ItemsSource="{Binding ParameterRows}" AutoGenerateColumns="False" IsReadOnly="True"
                    Height="110" RowHeaderWidth="0" HeadersVisibility="Column" CanUserAddRows="False"
                    Margin="0,0,0,12" FontSize="12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Parameter key" Foreground="#92A4B7"/>
          <TextBox Text="{Binding ParameterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
          <TextBlock Text="Parameter value" Foreground="#92A4B7"/>
          <TextBox Text="{Binding ParameterValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,5"/>
          <Button Content="Set parameter" Command="{Binding SetParameterCommand}" HorizontalAlignment="Left"/>
          <TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Foreground="#92A4B7" FontSize="11"
                     Text="ControllerState requires PROJECT ControllerId / StateId / exact Revision. Missing or outdated references block Preflight. No physical output permission is available here."/>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="#192431" BorderBrush="#314458" BorderThickness="1" Margin="0,9,0,0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="9,5,9,5">
          <TextBlock DockPanel.Dock="Left" Text="Execution facts · Expected / Actual / Quality" FontWeight="SemiBold"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Verdict}" FontWeight="SemiBold" Foreground="#46D0DC"/>
        </DockPanel>
        <DataGrid ItemsSource="{Binding Facts}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" BorderThickness="0"
                  RowHeaderWidth="0" HeadersVisibility="Column" FontSize="12">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="70"/>
            <DataGridTextColumn Header="Step" Binding="{Binding NodeType}" Width="110"/>
            <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="*"/>
            <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="*"/>
            <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="90"/>
            <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="100"/>
            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80"/>
            <DataGridTextColumn Header="Diagnostic" Binding="{Binding Diagnostic}" Width="2*"/>
            <DataGridTextColumn Header="Trace" Binding="{Binding TraceReference}" Width="140"/>
            <DataGridTextColumn Header="Session" Binding="{Binding SessionGeneration}" Width="70"/>
            <DataGridTextColumn Header="OperationId" Binding="{Binding OperationId}" Width="155"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
    <Border Grid.Row="4" BorderBrush="#314458" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="4,6">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#E2EDF7"/>
    </Border>
  </Grid>
</UserControl>
