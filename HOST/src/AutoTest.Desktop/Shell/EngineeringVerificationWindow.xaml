<Window x:Class="AutoTest.Desktop.Shell.EngineeringVerificationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AutoTest.Desktop.Shell"
 Title="工程测试" Width="1150" Height="780" MinWidth="740" MinHeight="495"
 WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}"
 FontSize="13" Background="#F6F8FB" Foreground="#24384C"
 UseLayoutRounding="True">
 <Window.Resources>
  <local:OperatorStateTextConverter x:Key="OperatorStateTextConverter"/>
  <Style x:Key="EngPanel" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DAE4EC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="EngCaption" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#687C8F"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="EngFact" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Foreground" Value="#284157"/>
  </Style>
  <Style x:Key="EngState" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#526A81"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding State}" Value="执行中">
     <Setter Property="Foreground" Value="#1663A5"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="实测通过">
     <Setter Property="Foreground" Value="#19704B"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="实测失败">
     <Setter Property="Foreground" Value="#B42318"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding State}" Value="执行异常">
     <Setter Property="Foreground" Value="#B42318"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="EngAction" TargetType="Button">
   <Setter Property="Padding" Value="13,7"/>
   <Setter Property="MinHeight" Value="34"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
 </Window.Resources>
 <Grid Margin="14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- The only primary action is the same real TEST/FLASH execution command.
       Device connection, scan identity and hardware authorization are still
       enforced by the existing view model and executor. -->
  <Border Grid.Row="0" Style="{StaticResource EngPanel}" Margin="0,0,0,10" Padding="16,12">
   <StackPanel>
    <DockPanel LastChildFill="True">
     <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click"
      Style="{StaticResource EngAction}" Margin="8,0,0,0"/>
     <StackPanel>
      <TextBlock Text="工程测试" FontWeight="SemiBold" FontSize="20"/>
      <TextBlock Text="{Binding ProjectName}" FontSize="13"
       Foreground="#536C82" TextTrimming="CharacterEllipsis"
       Margin="0,3,0,0" ToolTip="{Binding ProjectName}"/>
     </StackPanel>
    </DockPanel>
    <WrapPanel Margin="0,12,0,0">
     <Button Content="开始测试" Command="{Binding StartOperatorVerificationCommand}"
      Style="{StaticResource AtPrimaryButton}" MinHeight="36" Padding="20,8"
      Margin="0,0,9,0"
      ToolTip="扫描 ECU 编号且设备就绪后启动；如涉及真实烧录和夹具动作，会先请求确认。"/>
     <Button Content="重新扫码" Command="{Binding ArmOperatorVerificationCommand}"
      Style="{StaticResource EngAction}"
      ToolTip="为下一次工程测试重新接收 ECU 编号；不操作硬件。"/>
     <Button Content="停止" Command="{Binding StopOperatorVerificationCommand}"
      Style="{StaticResource EngAction}"
      ToolTip="停止当前运行并按执行器规则进行收尾；停止本身不会自动重试烧录。"/>
     <Button Content="扫码枪连接…" Command="{Binding OpenScannerSettingsCommand}"
      Style="{StaticResource EngAction}"/>
     <Button Content="本次报告" Click="OpenCurrentReport_Click"
      Style="{StaticResource EngAction}" ToolTip="查看本次已保存的测试报告。"/>
     <Button Content="历史记录" Click="OpenReports_Click"
      Style="{StaticResource EngAction}" ToolTip="查询历史检测和调试记录。"/>
    </WrapPanel>
    <WrapPanel Margin="0,9,0,0">
     <TextBlock Text="{Binding ControllerLabel}" Foreground="#536C82"
      Margin="0,0,18,0"/>
     <TextBlock Text="{Binding ScannerLabel}" Foreground="#536C82"
      Margin="0,0,18,0"/>
     <TextBlock Text="{Binding CanLabel}" Foreground="#536C82"/>
    </WrapPanel>
   </StackPanel>
  </Border>

  <!-- Identity and the next action stay visible. Raw COM observations are
       distinct from the accepted ECU identity, even on failed parsing. -->
  <Border Grid.Row="1" Style="{StaticResource EngPanel}"
   Margin="0,0,0,10" Padding="16,12">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="1.15*"/>
     <ColumnDefinition Width="0.9*"/>
     <ColumnDefinition Width="0.75*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,16,0">
     <TextBlock Text="最近扫码内容" Style="{StaticResource EngCaption}"/>
     <TextBlock Text="{Binding LastObservedBarcode}" FontFamily="Consolas,Microsoft YaHei"
      FontSize="19" Foreground="#185D92" FontWeight="SemiBold"
      TextTrimming="CharacterEllipsis" ToolTip="{Binding LastObservedBarcode}"
      Margin="0,5,0,2"/>
     <TextBlock Text="{Binding LastObservedAt,StringFormat='接收时间：{0}'}"
      Style="{StaticResource EngCaption}"/>
     <TextBlock Text="{Binding DutSerial,StringFormat='当前 ECU：{0}'}"
      FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding DutSerial}" Margin="0,7,0,0"/>
     <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource EngCaption}"
      Margin="0,5,0,0" MaxHeight="38" ToolTip="{Binding ScanStatus}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,15,0">
     <TextBlock Text="当前状态" Style="{StaticResource EngCaption}"/>
     <TextBlock Text="{Binding OperatorRunState}" FontSize="16" FontWeight="SemiBold"
      TextWrapping="Wrap" Margin="0,5,0,4"/>
     <TextBlock Text="{Binding EngineeringNextAction}" Style="{StaticResource EngCaption}"
      TextWrapping="Wrap" MaxHeight="55"/>
    </StackPanel>
    <StackPanel Grid.Column="2">
     <TextBlock Text="烧录与报告" Style="{StaticResource EngCaption}"/>
     <TextBlock Text="{Binding OperatorFlashState}" Style="{StaticResource EngFact}"
      Margin="0,5,0,6" MaxHeight="54"/>
     <TextBlock Text="{Binding OperatorRecordState}" Style="{StaticResource EngCaption}"
      TextWrapping="Wrap" MaxHeight="44"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="2" Margin="0,0,0,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.1*" MinWidth="325"/>
    <ColumnDefinition Width="8"/>
    <ColumnDefinition Width="0.9*" MinWidth="290"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource EngPanel}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <DockPanel Margin="14,12,14,8">
      <TextBlock DockPanel.Dock="Right" Text="{Binding CaseCount,StringFormat='{}{0} 个用例'}"
       Foreground="#64788B" VerticalAlignment="Center"/>
      <CheckBox x:Name="FollowEngineeringRun" DockPanel.Dock="Right"
       Content="跟随执行" IsChecked="True" VerticalAlignment="Center"
       Margin="0,0,12,0" ToolTip="运行时定位当前步骤；取消后可以自由查看。"/>
      <TextBlock Text="测试用例" FontWeight="SemiBold" FontSize="15"/>
     </DockPanel>
     <TreeView x:Name="EngineeringCasesTree" Grid.Row="1"
      ItemsSource="{Binding Cases}" BorderThickness="0" Padding="7,4"
      SelectedItemChanged="EngineeringCasesTree_SelectedItemChanged"
      ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <TreeView.ItemContainerStyle>
       <Style TargetType="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=OneWay}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
       </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.Resources>
       <HierarchicalDataTemplate DataType="{x:Type local:AutomaticTestCase}"
        ItemsSource="{Binding Children}">
        <Grid Margin="5,4" MinHeight="37">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36"/>
          <ColumnDefinition Width="*" MinWidth="110"/>
          <ColumnDefinition Width="112"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Index}" VerticalAlignment="Center"
          FontWeight="SemiBold" Foreground="#486581"/>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
          <TextBlock Text="{Binding StepCountLabel}" Style="{StaticResource EngCaption}"/>
         </StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding State,Converter={StaticResource OperatorStateTextConverter}}" Style="{StaticResource EngState}"
          VerticalAlignment="Center" ToolTip="{Binding State,Converter={StaticResource OperatorStateTextConverter}}"/>
        </Grid>
       </HierarchicalDataTemplate>
       <HierarchicalDataTemplate DataType="{x:Type local:AutomaticTestStep}"
        ItemsSource="{Binding Children}">
        <Grid Margin="4,3" MinHeight="33">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="*" MinWidth="100"/>
          <ColumnDefinition Width="112"/>
         </Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Index}" VerticalAlignment="Center"
          Foreground="#72879A" FontSize="11"/>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
           ToolTip="{Binding Name}"/>
          <TextBlock Text="{Binding ActionSummary}" Style="{StaticResource EngCaption}"
           TextTrimming="CharacterEllipsis" ToolTip="{Binding ActionSummary}"/>
         </StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding State,Converter={StaticResource OperatorStateTextConverter}}" Style="{StaticResource EngState}"
          VerticalAlignment="Center" ToolTip="{Binding State,Converter={StaticResource OperatorStateTextConverter}}"/>
        </Grid>
       </HierarchicalDataTemplate>
      </TreeView.Resources>
     </TreeView>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
    Background="#E4EAF1"/>
   <Border Grid.Column="2" Style="{StaticResource EngPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="15,13,15,15">
      <TextBlock Text="当前步骤" FontSize="15" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding OperatorCurrentCase}" Foreground="#52708D"
       TextTrimming="CharacterEllipsis" ToolTip="{Binding OperatorCurrentCase}"
       Margin="0,11,0,0"/>
      <TextBlock Text="{Binding OperatorCurrentStep}" FontSize="17"
       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,5"/>
      <TextBlock Text="{Binding OperatorStepStatus}" Foreground="#286B9C"
       TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Border Height="1" Background="#E4EAF0" Margin="0,0,0,13"/>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0">
        <TextBlock Text="实际结果" Style="{StaticResource EngCaption}"/>
        <TextBlock Text="{Binding OperatorActual}" Style="{StaticResource EngFact}"
         FontWeight="SemiBold" Margin="0,5,0,0"/>
       </StackPanel>
       <StackPanel Grid.Column="1">
        <TextBlock Text="期望结果" Style="{StaticResource EngCaption}"/>
        <TextBlock Text="{Binding OperatorExpected}" Style="{StaticResource EngFact}"
         Margin="0,5,0,0"/>
       </StackPanel>
      </Grid>
      <TextBlock Text="{Binding OperatorFailure}" Foreground="#B42318"
       TextWrapping="Wrap" Margin="0,12,0,8"/>
      <Border Height="1" Background="#E4EAF0" Margin="0,5,0,11"/>
      <TextBlock Text="查看步骤" FontWeight="SemiBold" FontSize="12"/>
      <TextBlock Text="{Binding InspectedNode}" Margin="0,7,0,3"
       TextWrapping="Wrap"/>
      <TextBlock Text="{Binding InspectedStatus}" Style="{StaticResource EngCaption}"/>
      <Expander Header="通信诊断" IsExpanded="False" Margin="0,15,0,0">
       <StackPanel Margin="0,10,0,5">
        <TextBlock Text="周期发送任务" FontWeight="SemiBold" FontSize="12"/>
        <TextBlock Text="{Binding OperatorPeriodicStatus}" Foreground="#44647F"
         TextWrapping="Wrap" Margin="0,6,0,8"/>
        <TextBlock Text="发送确认仅表示主控接受命令，不等于 ECU 已收到 CAN 帧。"
         Style="{StaticResource EngCaption}"/>
        <TextBlock Text="{Binding ScannerDiagnostic}" Style="{StaticResource EngCaption}"
         Margin="0,9,0,0"/>
        <TextBlock Text="{Binding StartRequestStatus}" Style="{StaticResource EngCaption}"
         Margin="0,8,0,0"/>
        <TextBlock Text="{Binding OperatorRunEvidence}" Style="{StaticResource EngCaption}"
         Margin="0,7,0,0"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource EngPanel}" Padding="9,6">
   <Expander Header="执行日志" IsExpanded="False" Foreground="#334963">
    <ListBox x:Name="OperatorEventsList" ItemsSource="{Binding OperatorEvents}"
     MaxHeight="150" MinHeight="70" BorderThickness="0"
     FontFamily="Consolas" FontSize="12"
     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
   </Expander>
  </Border>
 </Grid>
</Window>