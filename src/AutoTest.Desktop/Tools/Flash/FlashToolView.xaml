<UserControl x:Class="AutoTest.Desktop.Tools.Flash.FlashToolView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource StudioBg}" Foreground="{DynamicResource StudioText}" FontFamily="Segoe UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid Margin="14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="320"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,11">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="验证镜像与配置" Style="{StaticResource AtPrimaryButton}" Command="{Binding PreflightCommand}"/>
    <Button Content="核对主控" Click="PhysicalPreflight_Click"/>
    <Button Content="设备连接" Click="OpenStationFromFlash_Click"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="ECU 编程" Foreground="{DynamicResource StudioMuted}" FontSize="10" FontWeight="SemiBold"/>
    <TextBlock Text="CAN 烧录" Style="{StaticResource AtPageTitle}" Margin="0,4,0,0"/>
    <TextBlock Text="配置检查 · 镜像加载 · 安全访问 · 擦写校验"
     Foreground="{DynamicResource StudioMuted}" FontSize="11" Margin="0,3,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#FFF5E7" BorderBrush="#BF9D65" BorderThickness="1"
   CornerRadius="4" Padding="10,8" Margin="0,0,0,11">
   <TextBlock Text="导入文件与预检不会擦写 ECU；真实擦写需要逐项授权和人工确认。CAN1 共用当前主控会话，实机烧录尚待验证。"
    TextWrapping="Wrap" Foreground="#8F611B" FontSize="12"/>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="320" MinWidth="260"/>
    <ColumnDefinition Width="5"/>
    <ColumnDefinition Width="*" MinWidth="350"/>
    <ColumnDefinition Width="5"/>
    <ColumnDefinition Width="275" MinWidth="245"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{DynamicResource StudioLine}" BorderThickness="1" CornerRadius="5">
    <DockPanel>
     <Border DockPanel.Dock="Top" Padding="12,12,12,9" Background="{DynamicResource StudioSurface}">
      <TextBlock Text="烧录资源与参数" FontSize="12" FontWeight="SemiBold"/>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12,10,12,16">
       <TextBlock Text="设备与诊断配置" Foreground="#176CB5" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,8"/>
       <Button Content="导入 Configuration.xml" Click="ImportCanTool_Click" HorizontalAlignment="Stretch"/>
       <TextBlock Text="{Binding ConfigurationStatus}" TextWrapping="Wrap" FontSize="11" Foreground="#167B5A" Margin="0,7,0,0"/>
       <TextBlock Text="写入地址范围（终点不含）" Foreground="{DynamicResource StudioMuted}" Margin="0,10,0,3" FontSize="11"/>
       <TextBlock Text="{Binding AllowedStart}" FontFamily="Consolas"/>
       <TextBlock Text="{Binding AllowedEnd}" FontFamily="Consolas" Margin="0,0,0,7"/>
       <Border Height="1" Background="{DynamicResource StudioLine}" Margin="0,10,0,12"/>
       <TextBlock Text="固件镜像" Foreground="#176CB5" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <TextBlock Text="HEX / S19 / BIN 固件路径" Foreground="{DynamicResource StudioMuted}" FontSize="11"/>
       <TextBox Text="{Binding ImagePath,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,5"/>
       <WrapPanel>
        <Button Content="浏览固件…" Click="BrowseImage_Click"/>
        <Button Content="解析镜像" Command="{Binding LoadCommand}"/>
       </WrapPanel>
       <TextBlock Text="BIN 基地址（十六进制）" Foreground="{DynamicResource StudioMuted}" FontSize="11" Margin="0,7,0,2"/>
       <TextBox Text="{Binding BinAddress,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="目标 ECU 型号" Foreground="{DynamicResource StudioMuted}" FontSize="11" Margin="0,9,0,2"/>
       <TextBox Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}"/>
       <TextBlock Text="期望 ECU 身份" Foreground="{DynamicResource StudioMuted}" FontSize="11" Margin="0,9,0,2"/>
       <TextBox Text="{Binding ExpectedIdentity,UpdateSourceTrigger=PropertyChanged}"/>
       <Border Height="1" Background="{DynamicResource StudioLine}" Margin="0,14,0,12"/>
       <TextBlock Text="安全访问算法" Foreground="#176CB5" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7"/>
       <TextBlock Text="原生 ZLGKey DLL（不能使用 sa_demo 充当 ECU 算法）"
        Foreground="{DynamicResource StudioMuted}" FontSize="11" TextWrapping="Wrap"/>
       <TextBox x:Name="SecurityDllPath" IsReadOnly="True" Margin="0,5,0,5"/>
       <Button Content="选择真实 Seed/Key DLL…" Click="BrowseSecurityDll_Click" HorizontalAlignment="Stretch"/>
       <Border Height="1" Background="{DynamicResource StudioLine}" Margin="0,14,0,12"/>
       <TextBlock Text="通信与擦写超时参数" Foreground="#176CB5" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,9"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="BlockLength (HEX)" Margin="0,6,0,0"/>
        <TextBox x:Name="FlashBlockLength" Grid.Row="0" Grid.Column="1" Text="200" Margin="0,2,0,4"/>
        <TextBlock Grid.Row="1" Text="P2 ms" Margin="0,6,0,0"/>
        <TextBox x:Name="FlashP2" Grid.Row="1" Grid.Column="1" Text="1000" Margin="0,2,0,4"/>
        <TextBlock Grid.Row="2" Text="P2* ms" Margin="0,6,0,0"/>
        <TextBox x:Name="FlashP2Star" Grid.Row="2" Grid.Column="1" Text="5000" Margin="0,2,0,4"/>
        <TextBlock Grid.Row="3" Text="Erase ms" Margin="0,6,0,0"/>
        <TextBox x:Name="FlashErase" Grid.Row="3" Grid.Column="1" Text="30000" Margin="0,2,0,4"/>
        <TextBlock Grid.Row="4" Text="ISO-TP FC ms" Margin="0,6,0,0"/>
        <TextBox x:Name="FlashFc" Grid.Row="4" Grid.Column="1" Text="2000" Margin="0,2,0,4"/>
       </Grid>
       <CheckBox x:Name="FlashSignature" Content="写入 CanTool OEM 末端签名（默认关闭）" Margin="0,9,0,2"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <GridSplitter Grid.Column="1" Background="{DynamicResource StudioLine}" HorizontalAlignment="Stretch"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*" MinHeight="160"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{DynamicResource StudioLine}" BorderThickness="1" CornerRadius="5" Padding="13">
     <StackPanel>
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="FlashProbeButton" Content="CAN1 探测 Boot / APP" Click="ProbePhysical_Click"/>
        <Button Content="固件预检" Command="{Binding PreflightCommand}"/>
       </StackPanel>
       <StackPanel>
        <TextBlock Text="实机烧录" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="PhysicalSessionLine" Text="Station 未连接；请在 P02 连接并验证主控"
         Foreground="{DynamicResource StudioMuted}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"/>
       </StackPanel>
      </DockPanel>
      <WrapPanel Margin="0,10,0,0">
       <Button x:Name="FlashPrepareButton" Content="核对并生成本次授权" Click="PreparePhysicalFlash_Click"/>
       <Button x:Name="FlashStartButton" Content="开始真实 ECU 烧录" Style="{StaticResource AtDangerButton}" Click="StartPhysicalFlash_Click"
        IsEnabled="False" Background="#E1F4ED"/>
       <Button x:Name="FlashCancelButton" Content="请求停止 / 取消" Style="{StaticResource AtDangerButton}" Click="CancelPhysicalFlash_Click"
        IsEnabled="False"/>
       <Button Content="导出本页诊断日志" Click="ExportPhysicalFlashLog_Click"/>
      </WrapPanel>
      <ProgressBar x:Name="FlashProgressBar" Height="9" Minimum="0" Maximum="100" Margin="0,11,0,5"/>
      <TextBlock x:Name="FlashProgressLine" Text="尚未执行" Foreground="#167B5A" FontSize="11"/>
     </StackPanel>
    </Border>
    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{DynamicResource StudioLine}" BorderThickness="1" Padding="10,7" Margin="0,7,0,0">
     <StackPanel>
      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource StudioMuted}" FontSize="11" TextWrapping="Wrap"/>
      <TextBlock x:Name="PhysicalResultLine" Text="真实烧录未开始。探测不会擦除；无物理 ECU 验证结果。"
       TextWrapping="Wrap" Foreground="#8F611B" FontSize="12" Margin="0,4,0,0"/>
     </StackPanel>
    </Border>
    <TabControl Grid.Row="2" Background="{DynamicResource StudioBg}" Margin="0,8,0,0">
     <TabItem Header="FLASH STAGES / 阶段">
      <DataGrid x:Name="FlashStagesGrid" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
       <DataGrid.Columns>
        <DataGridTextColumn Header="时间" Binding="{Binding Utc,StringFormat=HH:mm:ss.fff}" Width="110"/>
        <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="175"/>
        <DataGridTextColumn Header="结果" Binding="{Binding Outcome}" Width="110"/>
        <DataGridTextColumn Header="细节 / NRC / 地址" Binding="{Binding Detail}" Width="*"/>
        <DataGridTextColumn Header="已 ACK B" Binding="{Binding ConfirmedBytes}" Width="90"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="UDS / USB / CAN1 Trace">
      <ListBox x:Name="FlashEventsList" FontFamily="Consolas" FontSize="11" Background="{DynamicResource StudioBg}"
       Foreground="{DynamicResource StudioText}" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
     </TabItem>
     <TabItem Header="镜像段">
      <DataGrid ItemsSource="{Binding Segments}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
       <DataGrid.Columns>
        <DataGridTextColumn Header="起点" Binding="{Binding Start}" Width="*"/>
        <DataGridTextColumn Header="终点（不含）" Binding="{Binding EndExclusive}" Width="*"/>
        <DataGridTextColumn Header="字节数" Binding="{Binding Bytes}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="配置与 XML 来源">
      <DataGrid ItemsSource="{Binding ConfigurationFields}" AutoGenerateColumns="True" IsReadOnly="True"/>
     </TabItem>
     <TabItem Header="现场预检">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top" Margin="8">
        <TextBlock Text="{Binding PhysicalPreflight}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Preflight}" Foreground="#8F611B"/>
       </StackPanel>
       <DataGrid ItemsSource="{Binding PhysicalChecks}" AutoGenerateColumns="True" IsReadOnly="True"/>
      </DockPanel>
     </TabItem>
    </TabControl>
    <TextBlock Grid.Row="3" Text="{Binding SourceLabel}" Foreground="{DynamicResource StudioMuted}" FontSize="11" Margin="2,9,2,0" TextWrapping="Wrap"/>
   </Grid>
   <GridSplitter Grid.Column="3" Background="{DynamicResource StudioLine}" HorizontalAlignment="Stretch"/>
   <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="{DynamicResource StudioLine}" BorderThickness="1" CornerRadius="5">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="{DynamicResource StudioSurface}" Padding="12">
      <StackPanel>
       <TextBlock Text="实机授权与检查" FontSize="12" FontWeight="SemiBold"/>
       <TextBlock Text="核对 ECU、配置、固件和设备连接" Foreground="{DynamicResource StudioMuted}" FontSize="11" Margin="0,5,0,0"/>
      </StackPanel>
     </Border>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12,12,12,16">
       <TextBlock Text="当前配置和固件" Foreground="#176CB5" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding Format,StringFormat=格式：{0}}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Bytes,StringFormat=镜像字节：{0}}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <TextBlock Text="{Binding Hash}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" Foreground="#127C9D" Margin="0,5,0,0"/>
       <TextBlock Text="{Binding Failure}" TextWrapping="Wrap" Foreground="#B63B51" Margin="0,5,0,0"/>
       <Border Height="1" Background="{DynamicResource StudioLine}" Margin="0,14,0,12"/>
       <TextBlock Text="实际烧录许可 / 必须逐项确认" Foreground="#176CB5" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <CheckBox x:Name="FlashPowerConfirmed" Content="已核实 ECU 型号、接线、供电和恢复措施"
        Margin="0,10,0,7"/>
       <CheckBox x:Name="FlashRateConfirmed" Content="已核实 CAN1 物理比特率与 XML 期望一致"
        Margin="0,2,0,7"/>
       <CheckBox x:Name="FlashEraseConfirmed" Content="同意本次对实际 ECU 擦除、写入和复位"
        Margin="0,2,0,7"/>
       <TextBlock Text="提示：导入 XML 不会修改 CAN1 实际波特率。主控 ACK 也不代表 ECU UDS 成功。"
        Foreground="#8F611B" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,10"/>
       <Button Content="生成真实烧录授权短语" Click="PreparePhysicalFlash_Click" HorizontalAlignment="Stretch"/>
       <TextBlock Text="本次授权（需人工逐字核对）" Foreground="{DynamicResource StudioMuted}" FontSize="11" Margin="0,11,0,4"/>
       <TextBox x:Name="FlashExpectedAuthorization" IsReadOnly="True" TextWrapping="Wrap"
        AcceptsReturn="True" MinHeight="74"/>
       <TextBlock Text="输入完全一致的授权短语" Foreground="{DynamicResource StudioMuted}" FontSize="11" Margin="0,11,0,4"/>
       <TextBox x:Name="FlashTypedAuthorization" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="74"/>
       <TextBlock Text="刷写被取消、断连或擦除 ACK 不明确时，结果必须保持 UNCERTAIN；不自动重试。"
        Foreground="#B63B51" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>