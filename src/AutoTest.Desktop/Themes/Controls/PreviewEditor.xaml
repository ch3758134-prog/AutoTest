<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Shared G4 test editor resources: compiled by both Desktop and UiPreview. -->
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="../Tokens/PreviewTokens.xaml"/>
 </ResourceDictionary.MergedDictionaries>
 <BooleanToVisibilityConverter x:Key="B2V"/>
 <SolidColorBrush x:Key="AtPreviewSelected" Color="#EAF3FF"/>
 <SolidColorBrush x:Key="AtPreviewTreeCaseSelected" Color="#E2EEFE"/>
 <SolidColorBrush x:Key="AtPreviewTreeGroupSelected" Color="#E8F1FD"/>
 <SolidColorBrush x:Key="AtPreviewTreeText" Color="#29496E"/>
 <SolidColorBrush x:Key="AtPreviewBreakpoint" Color="#C04A57"/>
 <SolidColorBrush x:Key="AtPreviewStatusDisabled" Color="#A0ADBE"/>
 <SolidColorBrush x:Key="AtPreviewBranchSurface" Color="#F5EEFB"/>
 <SolidColorBrush x:Key="AtPreviewBranchBorder" Color="#DECEF3"/>
<Style x:Key="Btn" TargetType="Button">
   <Setter Property="Background" Value="{StaticResource AtUiSurface}"/>
   <Setter Property="Foreground" Value="{StaticResource AtUiButtonForeground}"/>
   <Setter Property="BorderBrush" Value="{StaticResource AtUiBorder}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="{StaticResource AtUiButtonHeight}"/>
   <Setter Property="Padding" Value="{StaticResource AtUiButtonPadding}"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FontSize" Value="{StaticResource AtUiCaptionSize}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Border" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
      CornerRadius="4" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
       RecognizesAccessKey="True"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
       <Setter TargetName="Border" Property="Background" Value="{StaticResource AtUiHoverSurface}"/>
       <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AtUiHoverBorder}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
       <Setter TargetName="Border" Property="Background" Value="{StaticResource AtUiPressedSurface}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
       <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
   <Setter Property="Background" Value="#2368BD"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#2368BD"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}"
       CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="1" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="PrimaryBorder" Property="Background" Value="#1F5BA7"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="PrimaryBorder" Property="Background" Value="#17477F"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="BareBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="5,2"/>
  </Style>
  <Style x:Key="UiInput" TargetType="TextBox">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#CED9E6"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="7,5"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="MinHeight" Value="26"/>
  </Style>
  <Style x:Key="UiCombo" TargetType="ComboBox">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#CFD9E6"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="MinHeight" Value="26"/>
   <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#607891"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="BottomTab" TargetType="Button" BasedOn="{StaticResource BareBtn}">
   <Setter Property="Foreground" Value="#536983"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="3,0,8,0"/>
  </Style>
  <Style x:Key="TreeButton" TargetType="Button" BasedOn="{StaticResource BareBtn}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Foreground" Value="#29496E"/>
  </Style>
  <Style x:Key="PreviewListBoxItemStyle" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ListBoxItem">
     <Border x:Name="Container" Background="{TemplateBinding Background}"
      BorderBrush="#E9EEF5" BorderThickness="0,0,0,1">
      <ContentPresenter HorizontalAlignment="Stretch"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Container" Property="Background" Value="#F4F8FD"/></Trigger>
      <DataTrigger Binding="{Binding IsMatch}" Value="True"><Setter TargetName="Container" Property="Background" Value="#FFF4DC"/></DataTrigger>
      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Container" Property="Background" Value="#EAF3FF"/><Setter TargetName="Container" Property="BorderBrush" Value="#91B9E9"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 <Style x:Key="AtPreviewPhaseRow" TargetType="Border">
  <Setter Property="BorderThickness" Value="3,0,0,1"/>
  <Setter Property="Padding" Value="8,0"/>
 </Style>
 <Style x:Key="AtPreviewBranchRow" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource AtPreviewBranchSurface}"/>
  <Setter Property="BorderBrush" Value="{StaticResource AtPreviewBranchBorder}"/>
  <Setter Property="BorderThickness" Value="3,0,0,1"/>
  <Setter Property="Padding" Value="7,0"/>
 </Style>
 <Style x:Key="AtPreviewStepName" TargetType="TextBlock">
  <Setter Property="FontSize" Value="11"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  <Setter Property="Foreground" Value="{StaticResource AtUiStepTitle}"/>
 </Style>
 <Style x:Key="AtPreviewStepSummary" TargetType="TextBlock">
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  <Setter Property="Foreground" Value="{StaticResource AtUiStepSummary}"/>
  <Setter Property="FontSize" Value="11"/>
  <Setter Property="Margin" Value="3,0,8,0"/>
 </Style>
 <Style x:Key="AtPreviewStepResource" TargetType="TextBlock">
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  <Setter Property="Foreground" Value="{StaticResource AtUiStepResource}"/>
  <Setter Property="FontSize" Value="10"/>
  <Setter Property="Margin" Value="0,0,5,0"/>
 </Style>
 <Style x:Key="AtPreviewStepStatus" TargetType="TextBlock">
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Foreground" Value="{StaticResource AtUiStepStatus}"/>
  <Setter Property="FontSize" Value="10"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
 </Style>
 <Style x:Key="AtPreviewStepIcon" TargetType="Border">
  <Setter Property="CornerRadius" Value="3"/>
  <Setter Property="Width" Value="21"/>
  <Setter Property="Height" Value="21"/>
  <Setter Property="Margin" Value="0,0,7,0"/>
 </Style>
 <!-- Inspector field components: the dynamic editor and static inspector share one chrome. -->
 <Style x:Key="AtPreviewDynamicLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
  <Setter Property="Margin" Value="0,3,0,5"/>
 </Style>
 <Style x:Key="AtPreviewDynamicInput" TargetType="TextBox" BasedOn="{StaticResource UiInput}">
  <Setter Property="MinHeight" Value="27"/>
  <Setter Property="Margin" Value="0,0,0,10"/>
  <Setter Property="Padding" Value="7,4,7,4"/>
  <Setter Property="BorderBrush" Value="#CDD9E8"/>
 </Style>
 <Style x:Key="AtPreviewDynamicChoice" TargetType="ComboBox" BasedOn="{StaticResource UiCombo}">
  <Setter Property="Height" Value="27"/>
  <Setter Property="Margin" Value="0,0,0,10"/>
  <Setter Property="BorderBrush" Value="#CDD9E8"/>
 </Style>
 <!-- Search match / selection rail style for test step rows. -->
 <Style x:Key="AtPreviewMatchRail" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Background" Value="#277BD1"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsMatch}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
              <Setter Property="Background" Value="#E2A43B"/>
             </DataTrigger>
             <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem},Path=IsSelected}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
              <Setter Property="Background" Value="#2675CF"/>
             </DataTrigger>
            </Style.Triggers>
           </Style>

 <!-- Explorer rows share interaction chrome across resource types and test cases. -->
 <Style x:Key="AtPreviewTreeRoot" TargetType="Border">
  <Setter Property="BorderBrush" Value="#D4E2F0"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Background" Value="#F1F6FC"/>
  <Setter Property="CornerRadius" Value="5"/>
  <Setter Property="Padding" Value="10,10"/>
  <Setter Property="Margin" Value="0,0,0,12"/>
 </Style>
 <Style x:Key="AtPreviewTreeGroup" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource AtPreviewTreeGroupSelected}"/>
  <Setter Property="CornerRadius" Value="3"/>
  <Setter Property="Padding" Value="7,5"/>
 </Style>
 <Style x:Key="AtPreviewTreeCaseSelectedStyle" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource AtPreviewTreeCaseSelected}"/>
  <Setter Property="CornerRadius" Value="3"/>
  <Setter Property="Padding" Value="4,5"/>
  <Setter Property="Margin" Value="0,1"/>
 </Style>
 <Style x:Key="AtPreviewTreeResource" TargetType="Button" BasedOn="{StaticResource TreeButton}">
  <Setter Property="Foreground" Value="{StaticResource AtPreviewTreeText}"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
 </Style>
 <Style x:Key="AtPreviewStatusText" TargetType="TextBlock" BasedOn="{StaticResource AtPreviewStepStatus}">
  <Style.Triggers>
   <DataTrigger Binding="{Binding Step.Enabled}" Value="False">
    <Setter Property="Foreground" Value="{StaticResource AtPreviewStatusDisabled}"/>
   </DataTrigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="AtPreviewBreakpointText" TargetType="TextBlock">
  <Setter Property="Foreground" Value="{StaticResource AtPreviewBreakpoint}"/>
  <Setter Property="FontSize" Value="11"/>
  <Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Margin" Value="0,0,4,0"/>
 </Style>
 <DataTemplate x:Key="AtPreviewRowTemplate">

       <Grid Height="{Binding RowHeight}" Background="Transparent">
        <Border Style="{StaticResource AtPreviewPhaseRow}" Visibility="{Binding IsPhase,Converter={StaticResource B2V}}"
         Background="{Binding PhaseBackground}" BorderBrush="{Binding PhaseAccent}"
         >
         <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="＋ 添加" Command="{Binding DataContext.AddRowCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
           Height="24" MinHeight="0" Padding="8,2" Margin="4,0,0,0"
           Style="{StaticResource Btn}"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}"
           Foreground="#8A9AB0" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
           <Button Content="{Binding ExpandMark}" Command="{Binding DataContext.TogglePhaseCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
            Style="{StaticResource BareBtn}" Width="24" FontSize="11"/>
           <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{Binding PhaseAccent}"
            FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
         </DockPanel>
        </Border>
        <Border Style="{StaticResource AtPreviewBranchRow}" Visibility="{Binding IsBranch,Converter={StaticResource B2V}}">
         <DockPanel>
          <Button DockPanel.Dock="Right" Content="＋ 插入" Command="{Binding DataContext.AddRowCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
           Style="{StaticResource BareBtn}" Foreground="#7854A3"/>
          <TextBlock Text="{Binding Name}" Margin="{Binding Indent}" VerticalAlignment="Center"
           FontSize="11" Foreground="#7653A5" FontWeight="SemiBold"/>
         </DockPanel>
        </Border>
        <Grid Visibility="{Binding IsStep,Converter={StaticResource B2V}}" Margin="0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="30*"/>
          <ColumnDefinition Width="46*"/>
          <ColumnDefinition Width="14*"/>
          <ColumnDefinition Width="10*"/>
         </Grid.ColumnDefinitions>
         <Border Width="3" HorizontalAlignment="Left" Panel.ZIndex="1" Style="{StaticResource AtPreviewMatchRail}"/>
         <TextBlock Grid.Column="0" Text="{Binding Number}" HorizontalAlignment="Right"
          VerticalAlignment="Center" Margin="0,0,10,0" FontSize="10" Foreground="#8A99AD"
          FontFamily="Consolas"/>
         <StackPanel Grid.Column="1" Margin="{Binding Indent}" Orientation="Horizontal"
          VerticalAlignment="Center" ClipToBounds="True">
          <Border Style="{StaticResource AtPreviewStepIcon}" Background="{Binding CategoryBackground}">
           <TextBlock Text="{Binding Icon}" Foreground="{Binding CategoryForeground}"
            FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding Name}" Style="{StaticResource AtPreviewStepName}" ToolTip="{Binding Name}"/>
         </StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource AtPreviewStepSummary}" ToolTip="{Binding Summary}"/>
         <TextBlock Grid.Column="3" Text="{Binding Resource}" Style="{StaticResource AtPreviewStepResource}" ToolTip="{Binding Resource}"/>
         <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding BreakpointMark}" Style="{StaticResource AtPreviewBreakpointText}"/>
          <TextBlock Text="{Binding Status}" Style="{StaticResource AtPreviewStatusText}"/>
         </StackPanel>
        </Grid>
       </Grid>
 </DataTemplate>
 <!-- Step palette shares the same button and typography system as the editor. -->
 <Style x:Key="AtPreviewPaletteGroup" TargetType="TextBlock">
  <Setter Property="Foreground" Value="#547089"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontSize" Value="{StaticResource AtUiCaptionSize}"/>
  <Setter Property="Margin" Value="0,10,0,6"/>
 </Style>
 <Style x:Key="AtPreviewPaletteButton" TargetType="Button" BasedOn="{StaticResource Btn}">
  <Setter Property="Width" Value="226"/>
  <Setter Property="MinHeight" Value="30"/>
  <Setter Property="Margin" Value="0,0,8,6"/>
  <Setter Property="Padding" Value="8,5,8,5"/>
  <Setter Property="HorizontalContentAlignment" Value="Left"/>
  <Setter Property="Foreground" Value="#28486D"/>
  <Setter Property="Background" Value="{StaticResource AtUiSurface}"/>
  <Setter Property="BorderBrush" Value="#D8E3EF"/>
 </Style>
 
 <!-- Right-side attribute editor: static template with two-way field binding. -->
 <DataTemplate x:Key="AtPreviewPropertyFieldTemplate">
  <StackPanel>
   <TextBlock Text="{Binding Label}" Style="{StaticResource AtPreviewDynamicLabel}"/>
   <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            ToolTip="{Binding Error}">
    <TextBox.Style>
     <Style TargetType="TextBox" BasedOn="{StaticResource AtPreviewDynamicInput}">
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsText}" Value="False">
        <Setter Property="Visibility" Value="Collapsed"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding HasError}" Value="True">
        <Setter Property="BorderBrush" Value="#C04A57"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </TextBox.Style>
   </TextBox>
   <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
    <ComboBox.Style>
     <Style TargetType="ComboBox" BasedOn="{StaticResource AtPreviewDynamicChoice}">
      <Style.Triggers>
       <DataTrigger Binding="{Binding IsChoice}" Value="False">
        <Setter Property="Visibility" Value="Collapsed"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </ComboBox.Style>
   </ComboBox>
   <TextBlock Text="{Binding Error}" Foreground="#C04A57" FontSize="10" Margin="0,0,0,5">
    <TextBlock.Style>
     <Style TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding HasError}" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
  </StackPanel>
 </DataTemplate>

 <Style x:Key="AtPreviewTreeMainCase" TargetType="Border">
  <Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="4,5"/><Setter Property="Margin" Value="0,1"/>
  <Style.Triggers><DataTrigger Binding="{Binding Selection.IsMainActive}" Value="True"><Setter Property="Background" Value="{StaticResource AtPreviewTreeCaseSelected}"/></DataTrigger></Style.Triggers>
 </Style>
 <Style x:Key="AtPreviewTreeDiagnosticCase" TargetType="Border">
  <Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="4,5"/><Setter Property="Margin" Value="0,1"/>
  <Style.Triggers><DataTrigger Binding="{Binding Selection.IsDiagnosticActive}" Value="True"><Setter Property="Background" Value="{StaticResource AtPreviewTreeCaseSelected}"/></DataTrigger></Style.Triggers>
 </Style>
</ResourceDictionary>
