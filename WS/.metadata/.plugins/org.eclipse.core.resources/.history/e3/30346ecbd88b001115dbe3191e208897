/*********************************************************************************************
*函数名    :
*功能      : 读一帧数据
*输入      : MSG：读取的消息指针
*返回      : ERR_OK
*备注      :
*日期      :
**********************************************************************************************/
void Drv_CAN_ReadFrame(CanMsgInf *Msg)//读取CAN帧
{
  byte i,Length;
  u32  tmpId =0;
  ((DwordSwap*)&tmpId)->b.b0 = CANRIDR0;//CAN接收缓冲区寄存器指针
  ((DwordSwap*)&tmpId)->b.b1 = CANRIDR1;
  ((DwordSwap*)&tmpId)->b.b2 = CANRIDR2;
  ((DwordSwap*)&tmpId)->b.b3 = CANRIDR3;
  if (tmpId & MB_ID_IDE)//判断是否为扩展帧 
  {
    Msg->CanId = ((tmpId >> 1) & 0x3FFFFUL) | ((tmpId >> 3) & 0x1FFC0000UL); //扩展帧
    ExtendedFrame = 1;
  }
  else {
    Msg->CanId  = tmpId >> 21;         //标准帧
    StandardFrame = 1;
  }
  
  if(ExtendedFrame) 
  {
	  if(CANRIDR3 & 0x01)
	  {
		  Msg->FrameType = 1;//远程帧  
	  }
	  else
	  {
	    Msg->FrameType = 0;//数据帧
	  }
	  ExtendedFrame = 0;
  }
  
  
  if(StandardFrame)
  {
	  if(CANRIDR1 & 0x10) 	//判断是否为远程帧
	  {
		Msg->FrameType = 1;//远程帧
	  } 
	  else 
	  {
		Msg->FrameType = 0;//数据帧
	  }
	  StandardFrame = 0;
  }
	
  Length = (byte)(CANRDLR & 0x0F); //获取数据长度
  Msg->MsgLth  = (byte)(CANRDLR & 0x0F);
 
  
 #ifdef Motorola   
   //////  Motorola
  for (i=0U; i<Length; i++) 
  {
    Msg->Data[7-i] = *((byte *)&CANRDSR0 + i); //CAN接收缓冲区指针
  }
  #else  
  //////////////////////Intel//////////////
    for (i=0U; i<Length; i++) 
  {
    Msg->Data[i] = *((byte *)&CANRDSR0 + i); //CAN接收缓冲区指针
  }
  
  #endif  
  
    CANRFLG = 1;//清接收中断标志位          
  //CANRFLG = CANRFLG_RXF_MASK;//清接收中断标志位                     
}


void Drv_CAN_Init(void)
{                 
  u32 AcFilterId=0;
  //MSCAN模块使能
  CANCTL1 = 0x80U;                    
  //MSCAN处于初始化模式
  CANCTL0 = 0x01U;

 #if 1
  /* 婊ゆ尝鍣ㄥ叏寮� - 鎺ユ敹鎵�鏈夋墿灞曞抚鍜屾爣鍑嗗抚 */
  CANIDAC_IDAM = 0x00U;
  CANIDAR0 = 0x00U;
  CANIDAR1 = 0x00U;
  CANIDAR2 = 0x00U;
  CANIDAR3 = 0x00U;
  CANIDMR0 = 0xFFU;
  CANIDMR1 = 0xFFU;
  CANIDMR2 = 0xFFU;
  CANIDMR3 = 0xFFU;
  CANIDAR4 = 0x00U;
  CANIDAR5 = 0x00U;
  CANIDAR6 = 0x00U;
  CANIDAR7 = 0x00U;
  CANIDMR4 = 0xFFU;
  CANIDMR5 = 0xFFU;
  CANIDMR6 = 0xFFU;
  CANIDMR7 = 0xFFU;
 #else
  

  CANIDAC_IDAM = 0x01U; //4个16位接收滤波器    
//  AcFilterId =(u16)(DBUG_CAN1 << 5)|0x0000;
//  //标准帧
//  CANIDAR0 = ((DwordSwap *)&AcFilterId)->b.b3;                    
//  CANIDAR1 = ((DwordSwap *)&AcFilterId)->b.b2;                    
//  CANIDAR3 = ((DwordSwap *)&AcFilterId)->b.b0;
  
  
  CANIDAR0 = (u8)((DBUG_CAN1 << 5) >> 8) & 0xF7;  // ID[10:3] → bit15-8                  
  CANIDAR1 = (u8)((DBUG_CAN1 << 5)& 0xFF); // ID[2:0] → bit7-5 + RTR=0, IDE=0               
  CANIDAR2 = (u8)((DBUG_CAN2 << 5) >> 8) & 0xF7;  // ID[10:3] → bit15-8                  
  CANIDAR3 = (u8)((DBUG_CAN2 << 5)& 0xFF); // ID[2:0] → bit7-5 + RTR=0, IDE=0
  
//  CANIDAR4 = (u8)(Diag_Fun_Rsp_FilterId>>3);                   
//  CANIDAR5 = (u8)(Diag_Fun_Rsp_FilterId<<5);             
//  CANIDAR6 = (u8)(Diag_GSNR_RQ_FilterId>>3);                   
//  CANIDAR7 = (u8)(Diag_GSNR_RQ_FilterId<<5); 

  CANIDMR0 = 0x00U;                   
  CANIDMR1 = 0x1FU;                   
  CANIDMR2 = 0x00U;                   
  CANIDMR3 = 0x1FU; 
  
//  CANIDMR4 = 0x00U;                   
//  CANIDMR5 = 0x1FU; 
//  CANIDMR6 = 0x00U;                   
//  CANIDMR7 = 0x1FU; 
 #endif 

	//系统时钟8M，进行2分频。
	CANBTR0 = 0x43U;                     
	//时间段1：7Tq 时钟周期  时间段2：8Tq 时钟周期
	//CAN线Bit Time=4M/1/(7+8+1)
	CANBTR1 = 0x3AU;

  if(BUAD_status == 1)
  {
	//系统时钟8M，进行2分频。
	CANBTR0 = 0x43U;                     
	//时间段1：4Tq 时钟周期  时间段2：3Tq 时钟周期
	//CAN线Bit Time=4M/1/(4 + 3 + 1)
	CANBTR1 = 0x23U;
  }
  CANCTL1_CLKSRC = 0x01U;              
  CANCTL0_INITRQ = 0x00U;//CAN正常运行

  while(CANCTL1_INITAK) {} 
            
  CANRFLG_RXF = 1;//清接收中断标志                    
  // CANRIER_RXFIE = 0x01U; // RX interrupt disabled for polling mode
  CANRFLG_TSTAT0 =1;
  CANRFLG_TSTAT1 =1;                     
  CANRFLG_RSTAT0 =1;
  CANRFLG_RSTAT1 =1;
  
   /* Busoff中断使能 */
 	CANRIER_TSTATE0 = 1; //01:Generate CSCIF interrupt only if the transmitter enters or leaves “bus-off” state. 
 	CANRIER_TSTATE1 = 0; //Discard other transmitter state changes for generating CSCIF interrupt.
 	CANRFLG_CSCIF = 1;
 	CANRIER_CSCIE = 1;  //1:A CAN Status Change event causes an error interrupt request.
	sDrvCan_Busoff =  0;                     
}



