<Window x:Class="AutoTest.FlashLab.Shell.FlashLabWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · CAN1 ECU 烧录调试" Width="1420" Height="900"
 MinWidth="1080" MinHeight="720" WindowState="Maximized"
 WindowStartupLocation="CenterScreen" Background="#F4F7FB"
 FontFamily="Microsoft YaHei UI" FontSize="13" Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Margin" Value="4,2"/>
   <Setter Property="MinHeight" Value="31"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#26394D"/>
   <Setter Property="BorderBrush" Value="#BBCBDD"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Margin" Value="4,2"/>
   <Setter Property="Padding" Value="7,5"/>
   <Setter Property="MinHeight" Value="29"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#C7D5E4"/>
  </Style>
  <Style TargetType="GroupBox">
   <Setter Property="Margin" Value="6,4"/>
   <Setter Property="Padding" Value="9"/>
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#CBD7E5"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#34465C"/>
  </Style>
 </Window.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="260"/>
   <RowDefinition Height="255"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="White" BorderBrush="#D6E1EE"
    BorderThickness="1" CornerRadius="5" Margin="2,0,2,5" Padding="13,9">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="AutoTest  /  ECU 烧录调试" FontSize="20" FontWeight="Bold" Foreground="#183E63"/>
     <TextBlock Text="  ·  主控 USB → CAN1 → ECU" FontSize="12"
       Foreground="#5B7894" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
    </StackPanel>
    <TextBlock Text="独立烧录测试 · 配置、连接、过程和 CAN 报文均可见"
      HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#61788F"/>
   </DockPanel>
  </Border>

  <Border Grid.Row="1" Background="White" BorderBrush="#D6E1EE"
    BorderThickness="1" CornerRadius="5" Margin="2,0,2,5" Padding="10,7">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click"/>
     <Button x:Name="ConnectButton" Content="连接 USB" Click="Connect_Click"
       Background="#D8ECFF" FontWeight="SemiBold"/>
     <Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Left" Text="USB 主控" FontWeight="Bold"
      VerticalAlignment="Center" Margin="4,0,12,0"/>
    <ComboBox x:Name="DeviceSelector" DockPanel.Dock="Left" Width="395"
      ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedDevice,Mode=TwoWay}"
      SelectionChanged="Device_SelectionChanged" DisplayMemberPath="DisplayIdentity"
      Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="UsbStatusLabel" Text="设备未连接，请连接主控后刷新"
      TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#7C5D2A"/>
   </DockPanel>
  </Border>

  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="1.02*" MinWidth="380"/>
    <ColumnDefinition Width="1.23*" MinWidth="460"/>
   </Grid.ColumnDefinitions>

   <GroupBox Grid.Column="0" Header="烧录配置 · 所有文件在这里选择">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="3">
      <TextBlock Text="配置文件" FontWeight="SemiBold" Margin="5,3,5,1"/>
      <DockPanel LastChildFill="True">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="导入 XML" Click="LoadXml_Click"/>
        <Button Content="导入 JSON" Click="LoadJson_Click"/>
        <Button Content="保存配置" Click="SaveXml_Click"/>
       </StackPanel>
       <TextBlock Text="{Binding ConfigurationPath}" TextTrimming="CharacterEllipsis"
         VerticalAlignment="Center" Margin="6,0" Foreground="#5C7188"/>
      </DockPanel>

      <Separator Margin="5,7"/>
      <TextBlock Text="待烧录固件" FontWeight="SemiBold" Margin="5,3,5,1"/>
      <DockPanel LastChildFill="True">
       <Button DockPanel.Dock="Right" Content="选择固件..." Click="ChooseImage_Click"/>
       <TextBlock Text="{Binding FirmwarePath}" TextTrimming="CharacterEllipsis"
         VerticalAlignment="Center" Margin="6,0"/>
      </DockPanel>
      <TextBlock Text="{Binding ImageSummary}" Margin="8,2,8,1" TextWrapping="Wrap"
        FontSize="11" Foreground="#5B718B"/>

      <Separator Margin="5,7"/>
      <TextBlock Text="安全文件（SafetyFile.dll）" FontWeight="SemiBold" Margin="5,3,5,1"/>
      <DockPanel LastChildFill="True">
       <Button DockPanel.Dock="Right" Content="选择安全文件..." Click="ChooseSafetyFile_Click"/>
       <TextBlock x:Name="SafetyDllStatusLabel" Text="未选择安全文件"
         TextTrimming="CharacterEllipsis" Margin="6,0" VerticalAlignment="Center"/>
      </DockPanel>

      <TextBlock Text="Seed/Key 算法文件（例如 sa_demo.dll）"
        FontWeight="SemiBold" Margin="5,9,5,1"/>
      <DockPanel LastChildFill="True">
       <Button DockPanel.Dock="Right" Content="选择 Seed/Key..." Click="ChooseSeedKey_Click"/>
       <TextBlock x:Name="SeedKeyDllStatusLabel" Text="未选择 Seed/Key 文件"
         TextTrimming="CharacterEllipsis" Margin="6,0" VerticalAlignment="Center"/>
      </DockPanel>
      <DockPanel Margin="5,6,5,2">
       <TextBlock DockPanel.Dock="Left" Text="本次采用的算法：" VerticalAlignment="Center"/>
       <ComboBox x:Name="SecuritySourceSelector" Width="205" Height="30"
         SelectedIndex="0" SelectionChanged="SecuritySource_SelectionChanged">
        <ComboBoxItem Content="SafetyFile.dll 托管算法"/>
        <ComboBoxItem Content="Seed/Key 原生 DLL 算法"/>
       </ComboBox>
      </DockPanel>
      <TextBlock x:Name="SecurityProviderStatusLabel"
        Text="两个文件分别导入；当前实际采用的算法以上方选择为准"
        TextWrapping="Wrap" Margin="8,2,8,3" FontSize="11" Foreground="#687D92"/>

      <Separator Margin="5,7"/>
      <DockPanel Margin="4,3">
       <TextBlock DockPanel.Dock="Left" Text="目标 ECU：" Width="94" VerticalAlignment="Center"/>
       <TextBox x:Name="TargetEcuBox" MinWidth="190" ToolTip="现场识别的目标 ECU 型号与版本"/>
      </DockPanel>

      <Expander Header="详细参数（CAN ID、Flash 地址、镜像参数）" Margin="5,5,5,2">
       <StackPanel>
        <TextBlock Text="导入的 XML 可以直接编辑；修改后需重新检查烧录文件。" 
          Margin="6,4" FontSize="11" Foreground="#61768D"/>
        <DataGrid Margin="4,2" Height="220" ItemsSource="{Binding Parameters}"
          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
          EnableRowVirtualization="True">
         <DataGrid.Columns>
          <DataGridTextColumn Header="配置项" Binding="{Binding Name,Mode=OneWay}"
            Width="140" IsReadOnly="True"/>
          <DataGridTextColumn Header="值（双击编辑）" Binding="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
            Width="170"/>
          <DataGridTextColumn Header="来源" Binding="{Binding Source,Mode=OneWay}"
            Width="110" IsReadOnly="True"/>
          <DataGridTextColumn Header="说明" Binding="{Binding Description,Mode=OneWay}"
            Width="220" IsReadOnly="True"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding Unknown}" Margin="8,3" TextWrapping="Wrap" FontSize="11"/>
        <DockPanel Margin="4,3">
         <TextBlock DockPanel.Dock="Left" Text="BIN 起始地址（16进制）："
           VerticalAlignment="Center"/>
         <TextBox x:Name="BinBaseBox" Width="125" HorizontalAlignment="Left" Text=""/>
        </DockPanel>
        <CheckBox x:Name="LegacyTailSignatureCheck" Margin="8,5"
          Content="兼容 CanTool 末尾 12 34 56 78 签名（可能覆盖固件最后4字节）"
          ToolTip="仅明确知道目标 ECU 需要此行为时才勾选"/>
       </StackPanel>
      </Expander>
      <CheckBox x:Name="BitrateVerifiedCheck" Margin="9,5"
        Content="现场确认主控 CAN1 为 500K，与 XML 配置一致"/>
      <Button x:Name="PrepareFlashButton" Content="检查烧录文件及参数"
        Click="PrepareFlash_Click" Margin="7,5" Background="#DFEFFD"
        FontWeight="SemiBold" HorizontalAlignment="Stretch"/>
      <TextBlock x:Name="FlashPlanSummary" Text="尚未检查。导入 XML、固件和安全文件后检查。"
        TextWrapping="Wrap" Margin="8,3" FontSize="11" Foreground="#405B76"/>
     </StackPanel>
    </ScrollViewer>
   </GroupBox>

   <GroupBox Grid.Column="1" Header="烧录执行 · 逐阶段观察 ECU 响应">
    <Grid Margin="3">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="140"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="135"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0">
      <TextBlock x:Name="WorkflowStatusLabel"
        Text="等待配置。导入文件、连接主控并检查参数后即可准备烧录。"
        TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#2A5B85" Margin="6,3"/>
      <CheckBox x:Name="FlashSafetyCheck" Margin="7,3"
        Content="我已核对目标 ECU、镜像、安全算法、擦除地址和稳定供电"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
       <Button x:Name="StartFlashButton" Content="开始烧录"
         Click="StartFlash_Click" Background="#CEE8FC" FontWeight="Bold"
         Padding="28,7"/>
       <Button x:Name="AbortFlashButton" Content="停止烧录"
         Click="AbortFlash_Click" IsEnabled="False"/>
      </StackPanel>
      <ProgressBar x:Name="FlashProgressBar" Minimum="0" Maximum="100"
        Value="0" Height="14" Margin="7,5"/>
      <TextBlock x:Name="FlashStageLabel" Text="待命。"
        TextWrapping="Wrap" Margin="7,2,7,4" FontSize="11"/>
     </StackPanel>

     <DataGrid Grid.Row="1" ItemsSource="{Binding Stages}" Margin="5,1"
       AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
       IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0"
       GridLinesVisibility="Horizontal" EnableRowVirtualization="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="流程步骤" Binding="{Binding Step,Mode=OneWay}" Width="*"/>
       <DataGridTextColumn Header="执行状态" Binding="{Binding State,Mode=OneWay}" Width="125"/>
      </DataGrid.Columns>
     </DataGrid>

     <TextBlock Grid.Row="2" Text="UDS 阶段消息与失败信息（包含 NRC / 响应确认）"
       Margin="8,5,8,2" FontWeight="SemiBold" Foreground="#405C77"/>
     <ListBox Grid.Row="3" x:Name="LogList" ItemsSource="{Binding Logs}"
       FontFamily="Consolas" FontSize="12" Margin="5,0,5,3"
       ScrollViewer.HorizontalScrollBarVisibility="Auto"
       ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#FCFDFE"/>
     <TextBlock Grid.Row="4"
       Text="开始前会再次确认真实擦除范围；取消、超时或断连后不会自动重刷。"
       Margin="7,3" FontSize="11" Foreground="#8E582B" TextWrapping="Wrap"/>
    </Grid>
   </GroupBox>
  </Grid>

  <GroupBox Grid.Row="3" Header="实时 CAN1 报文 · TX / RX（主控 USB 通道）" Margin="6,5,6,2">
   <Grid>
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="True">
     <Button DockPanel.Dock="Right" Content="清空 CAN 表格" Click="ClearCan_Click"/>
     <Button DockPanel.Dock="Right" Content="导出完整诊断 ZIP" Click="Export_Click"/>
     <TextBlock Text="时刻 · 方向 · 报文 ID · DLC · 原始数据 · USB/ECU 结果；Seed/Key 字节脱敏"
       Margin="8,4" Foreground="#59748B" FontSize="11"/>
    </DockPanel>
    <DataGrid x:Name="CanLogTable" Grid.Row="1" Margin="5,2"
      ItemsSource="{Binding CanLogs}" AutoGenerateColumns="False"
      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
      EnableRowVirtualization="True" EnableColumnVirtualization="True"
      GridLinesVisibility="Horizontal" RowHeaderWidth="0" HeadersVisibility="Column">
     <DataGrid.Columns>
      <DataGridTextColumn Header="时间" Binding="{Binding Time,Mode=OneWay}" Width="112"/>
      <DataGridTextColumn Header="方向" Binding="{Binding Direction,Mode=OneWay}" Width="88"/>
      <DataGridTextColumn Header="CAN ID" Binding="{Binding CanId,Mode=OneWay}" Width="110"/>
      <DataGridTextColumn Header="DLC" Binding="{Binding Dlc,Mode=OneWay}" Width="48"/>
      <DataGridTextColumn Header="CAN 数据" Binding="{Binding Data,Mode=OneWay}" Width="*"/>
      <DataGridTextColumn Header="结果" Binding="{Binding Result,Mode=OneWay}" Width="245"/>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </GroupBox>

  <Border Grid.Row="4" Background="#F4F7FB" BorderBrush="#D7E1EC"
    BorderThickness="0,1,0,0" Padding="7" Margin="4,3,4,0">
   <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="#30567B"
     TextTrimming="CharacterEllipsis"/>
  </Border>
 </Grid>
</Window>