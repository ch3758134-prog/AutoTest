<Window x:Class="AutoTest.UdsLab.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AutoTest · UDS 诊断" Width="1460" Height="880" MinWidth="1280" MinHeight="700"
 WindowStartupLocation="CenterScreen" WindowState="Maximized"
 Background="#F3F6FA" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#1D334F"/>
  <SolidColorBrush x:Key="Muted" Color="#63768F"/>
  <SolidColorBrush x:Key="Line" Color="#DDE5EF"/>
  <Style x:Key="Pane" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="8"/>
   <Setter Property="Padding" Value="15"/>
  </Style>
  <Style x:Key="Section" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
  </Style>
  <Style x:Key="Field" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="Background" Value="#F4F8FD"/>
   <Setter Property="BorderBrush" Value="#CFDBEB"/>
   <Setter Property="Foreground" Value="#304D6D"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="#1D334F"/>
   <Setter Property="BorderBrush" Value="#CBD8E8"/>
   <Setter Property="Margin" Value="0,3,7,6"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="#1D334F"/>
   <Setter Property="BorderBrush" Value="#CBD8E8"/>
   <Setter Property="Margin" Value="0,3,7,6"/>
  </Style>
  <Style x:Key="Primary" TargetType="Button">
   <Setter Property="Background" Value="#2466AA"/>
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="BorderBrush" Value="#2466AA"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="19,9"/>
  </Style>
 </Window.Resources>
 <Grid Margin="15,12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="380"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="1,0,1,10">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
   </Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="UDS 诊断" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
    <TextBlock Text="编辑一个包含多个 UDS 服务的诊断用例 · 单步调试与顺序执行 · 保存复用"
               Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="打开用例文件" Click="Open_Click" Padding="10,7" Margin="0,0,7,0"/>
    <Button Content="保存用例文件" Click="Save_Click" Padding="10,7" Margin="0,0,7,0"/>
    <Button Content="导出记录" Click="Export_Click" Padding="10,7"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Pane}" Padding="12,7" Margin="0,0,0,10">
   <StackPanel>
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="ConnectButton" Content="连接主控" Click="Connect_Click" Style="{StaticResource Primary}" Margin="0,0,6,0"/>
      <Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click" IsEnabled="False"/>
     </StackPanel>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="ConnectionStatus" Text="未连接 · 请填写目标 ECU 的请求/响应 CAN ID"
                 FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="SessionStatus" Text="诊断会话未知 · 连接 USB 不代表 ECU 已响应"
                 Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
     </StackPanel>
    </DockPanel>
    <Expander x:Name="SettingsExpander" Header="通信参数（CAN ID / 超时）" Margin="0,6,0,0">
     <WrapPanel Margin="3,8,0,0">
      <TextBlock Text="请求 CAN ID (HEX)" VerticalAlignment="Center" Margin="0,0,6,4"/>
      <TextBox x:Name="TxIdBox" Width="105" TextChanged="WorkspaceParameterChanged" Margin="0,0,14,4"/>
      <TextBlock Text="响应 CAN ID (HEX)" VerticalAlignment="Center" Margin="0,0,6,4"/>
      <TextBox x:Name="RxIdBox" Width="105" TextChanged="WorkspaceParameterChanged" Margin="0,0,14,4"/>
      <TextBlock Text="P2 (ms)" VerticalAlignment="Center" Margin="0,0,6,4"/>
      <TextBox x:Name="P2Box" Text="1000" Width="72" TextChanged="WorkspaceParameterChanged" Margin="0,0,14,4"/>
      <TextBlock Text="P2* (ms)" VerticalAlignment="Center" Margin="0,0,6,4"/>
      <TextBox x:Name="P2StarBox" Text="5000" Width="72" TextChanged="WorkspaceParameterChanged" Margin="0,0,14,4"/>
      <TextBlock Text="DUT CAN · Normal ISO-TP" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
     </WrapPanel>
    </Expander>
   </StackPanel>
  </Border>
  <!-- Two working surfaces only: compose on left; real exchange facts on right. -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="8*" MinWidth="800"/>
    <ColumnDefinition Width="8"/>
    <ColumnDefinition Width="5*" MinWidth="375"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Pane}" Padding="10">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="225" MinWidth="185"/>
      <ColumnDefinition Width="7"/>
      <ColumnDefinition Width="255" MinWidth="210"/>
      <ColumnDefinition Width="7"/>
      <ColumnDefinition Width="*" MinWidth="315"/>
     </Grid.ColumnDefinitions>
     <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="0,2,8,0">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="诊断用例" Style="{StaticResource Section}"/>
        <TextBlock Text="一个用例可调用多个 UDS 服务" Style="{StaticResource Field}" TextWrapping="Wrap" Margin="0,3,0,7"/>
        <Button Content="＋ 新建用例" Click="NewCase_Click" Margin="0,0,0,7"/>
        <WrapPanel Margin="0,0,0,9">
         <Button Content="复制" Click="CopyCase_Click" Padding="7,5" Margin="0,0,4,0"/>
         <Button Content="删除" Click="DeleteCase_Click" Padding="7,5"/>
        </WrapPanel>
        <TextBlock Text="搜索用例" Style="{StaticResource Field}"/>
        <TextBox x:Name="CaseSearchBox" TextChanged="CaseSearchChanged"
                 ToolTip="按名称或备注搜索已保存的用例"/>
        <Expander x:Name="CaseInfoExpander" Header="用例信息 · 改名与备注" IsExpanded="False" Margin="0,5,0,10">
         <StackPanel Margin="0,6,2,0">
          <TextBlock Text="用例名称" Style="{StaticResource Field}"/>
          <TextBox x:Name="CaseNameBox" TextChanged="CaseMetadataChanged"/>
          <TextBlock Text="备注" Style="{StaticResource Field}"/>
          <TextBox x:Name="CaseDescriptionBox" TextChanged="CaseMetadataChanged"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalContentAlignment="Top"/>
         </StackPanel>
        </Expander>
       </StackPanel>
       <StackPanel DockPanel.Dock="Bottom">
        <Separator Margin="0,7,0,6"/>
        <TextBlock x:Name="LibraryStatus" Text="未保存" Style="{StaticResource Field}" TextWrapping="Wrap"/>
       </StackPanel>
       <ListBox x:Name="CasesList" SelectionChanged="CaseSelected" BorderThickness="0"
                HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ContextMenu>
         <ContextMenu>
          <MenuItem Header="编辑用例名称（F2）" Click="RenameCase_Click"/>
          <MenuItem Header="复制当前用例" Click="CopyCase_Click"/>
          <MenuItem Header="新建用例（Ctrl+N）" Click="NewCase_Click"/>
          <Separator/>
          <MenuItem Header="删除用例（Delete）" Click="DeleteCase_Click"/>
         </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemContainerStyle>
         <Style TargetType="ListBoxItem">
          <EventSetter Event="PreviewMouseRightButtonDown" Handler="CaseItemRightClick"/>
         </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Border CornerRadius="5" Margin="0,2,0,3" Padding="7,7">
           <Border.Style>
            <Style TargetType="Border">
             <Setter Property="Background" Value="#F1F6FC"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
               <Setter Property="Background" Value="#DCECFD"/>
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </Border.Style>
           <StackPanel>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#72849B"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Margin="0,3,0,0"/>
           </StackPanel>
          </Border>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>
     </Border>
     <GridSplitter Grid.Column="1" Background="#E7EDF5" Width="7" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="拖动调整用例与步骤列表宽度"/>
     <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="0,2,8,0">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="用例步骤" Style="{StaticResource Section}"/>
        <TextBlock Text="选择要做的诊断动作，再修改它的参数" Style="{StaticResource Field}" Margin="0,3,0,7" TextWrapping="Wrap"/>
        <Button x:Name="AddServiceButton" Content="＋ 添加诊断动作 ▾" Click="AddStep_Click" Margin="0,0,0,7">
         <Button.ContextMenu>
          <ContextMenu Placement="Bottom">
           <MenuItem Header="读取 VIN（示例 · 22 F1 90）" Tag="vin" Click="AddStepChoice_Click"/>
           <MenuItem Header="读取故障码列表（19 02 FF）" Tag="dtc" Click="AddStepChoice_Click"/>
           <MenuItem Header="查询故障码数量（19 01 FF）" Tag="dtc-count" Click="AddStepChoice_Click"/>
           <Separator/>
           <MenuItem Header="读取 ECU 自定义 DID（填写 DID）" Tag="did" Click="AddStepChoice_Click"/>
           <MenuItem Header="自定义 UDS HEX 请求" Tag="custom" Click="AddStepChoice_Click"/>
           <MenuItem Header="选择其他 UDS 标准服务" Tag="service" Click="AddStepChoice_Click"/>
           <Separator/>
           <MenuItem Header="切换扩展诊断会话（仅编辑，实体未授权）" Tag="session" Click="AddStepChoice_Click"/>
          </ContextMenu>
         </Button.ContextMenu>
        </Button>
        <WrapPanel Margin="0,0,0,8">
         <Button Content="复制" ToolTip="复制选中步骤，Ctrl+D" Click="CopyStep_Click" Padding="6,5" Margin="0,0,4,0"/>
         <Button Content="删除" ToolTip="删除选中步骤，Delete" Click="DeleteStep_Click" Padding="6,5" Margin="0,0,4,0"/>
         <Button Content="↑" ToolTip="上移选中步骤" Click="MoveStepUp_Click" Padding="7,5" Margin="0,0,4,0"/>
         <Button Content="↓" ToolTip="下移选中步骤" Click="MoveStepDown_Click" Padding="7,5"/>
         <Button Content="粘贴" ToolTip="粘贴刚复制的步骤 Ctrl+V" Click="PasteSteps_Click" Padding="7,5" Margin="0,4,0,0"/>
        </WrapPanel>
        <TextBlock Text="点选某项，在右侧修改。勾选表示参与整份用例的运行。"
                   Style="{StaticResource Field}" TextWrapping="Wrap" Margin="0,0,0,7"/>
       </StackPanel>
       <StackPanel DockPanel.Dock="Bottom">
        <Separator Margin="0,7,0,6"/>
        <TextBlock x:Name="StepCountStatus" Text="0 个步骤" Style="{StaticResource Field}"/>
        <WrapPanel Margin="0,7,0,0">
         <Button Content="↶ 撤销" Click="UndoSteps_Click" ToolTip="撤销用例步骤编辑（Ctrl+Z）" Padding="8,4" Margin="0,0,5,0"/>
         <Button Content="↷ 重做" Click="RedoSteps_Click" ToolTip="重做已撤销的修改（Ctrl+Y）" Padding="8,4"/>
        </WrapPanel>
       </StackPanel>
       <ListBox x:Name="StepsList" SelectionChanged="CaseStepSelected" BorderThickness="0"
                HorizontalContentAlignment="Stretch" SelectionMode="Extended"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ContextMenu>
         <ContextMenu>
          <MenuItem Header="编辑步骤名称（F2）" Click="RenameStep_Click"/>
          <MenuItem Header="复制到步骤剪贴板（Ctrl+C）" Click="CopyStepsToClipboard_Click"/>
          <MenuItem Header="粘贴步骤（Ctrl+V）" Click="PasteSteps_Click"/>
          <MenuItem Header="创建副本（Ctrl+D）" Click="CopyStep_Click"/>
          <Separator/>
          <MenuItem Header="上移步骤" Click="MoveStepUp_Click"/>
          <MenuItem Header="下移步骤" Click="MoveStepDown_Click"/>
          <MenuItem Header="删除选中步骤（Delete）" Click="DeleteStep_Click"/>
         </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemContainerStyle>
         <Style TargetType="ListBoxItem">
          <EventSetter Event="PreviewMouseRightButtonDown" Handler="StepItemRightClick"/>
         </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Border CornerRadius="5" Margin="0,2,0,3" Padding="7,7">
           <Border.Style>
            <Style TargetType="Border">
             <Setter Property="Background" Value="#F1F6FC"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
               <Setter Property="Background" Value="#DCECFD"/>
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </Border.Style>
           <StackPanel>
            <DockPanel>
             <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                       Checked="StepEnabledChanged" Unchecked="StepEnabledChanged" Margin="0,0,7,0"/>
             <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Name}"/>
            </DockPanel>
            <TextBlock Text="{Binding Purpose}" FontSize="11" Foreground="#637993"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Purpose}" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding Action.RequestHex}" FontFamily="Consolas" FontSize="11"
                       Foreground="#7086A1" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding LastState}" FontSize="11"
                       Foreground="{Binding RunStateBrush}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding LastState}"
                       Margin="0,2,0,0"/>
           </StackPanel>
          </Border>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>
     </Border>
     <GridSplitter Grid.Column="3" Background="#E7EDF5" Width="7" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="拖动调整步骤列表与编辑器宽度"/>
     <Grid x:Name="StepEditorPanel" Grid.Column="4">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="210"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="正在编辑的诊断动作" Style="{StaticResource Section}"/>
       <TextBlock Text="选中中间的动作，修改名称、参数或原始 HEX；无需先连接 ECU" Style="{StaticResource Field}" Margin="0,3,0,0"/>
      </StackPanel>
      <TextBlock x:Name="DraftStatus" Grid.Column="1" VerticalAlignment="Center"
                 Foreground="#547D63" FontSize="12" MaxWidth="150" TextTrimming="CharacterEllipsis"
                 Text="当前请求可编辑"/>
     </Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="1,0,8,4">
       <TextBlock Text="步骤名称（可直接修改）" Style="{StaticResource Field}"/>
       <TextBox x:Name="OperationNameBox" TextChanged="EditorDraftChanged"
                ToolTip="修改当前步骤名称；切换步骤后保留，Ctrl+S 写入用例文件"/>
       <Expander Header="用途说明与分类（按需编辑）" IsExpanded="False" Margin="0,3,0,10">
        <StackPanel Margin="0,7,0,0">
         <TextBlock Text="备注分类（可选）" Style="{StaticResource Field}"/>
         <TextBox x:Name="OperationGroupBox" TextChanged="EditorDraftChanged"/>
         <TextBlock Text="这项诊断是做什么的（可修改）" Style="{StaticResource Field}"/>
         <TextBox x:Name="PurposeBox" TextChanged="CaseStepDraftChanged"
                  TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                  VerticalContentAlignment="Top"/>
        </StackPanel>
       </Expander>
       <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="UDS 服务" Style="{StaticResource Field}"/>
         <ComboBox x:Name="ServiceCombo" DisplayMemberPath="Display"
                   SelectionChanged="ServiceChanged" MinHeight="34"
                   ToolTip="选择标准服务自动生成 SID；未知或 OEM 请求使用下面的原始 HEX 模式"/>
        </StackPanel>
        <CheckBox x:Name="RawModeCheck" Grid.Column="1" Content="原始 HEX" Margin="12,23,0,0"
                  Checked="RawModeChanged" Unchecked="RawModeChanged"
                  ToolTip="直接编辑实际 UDS PDU，编辑器不会自行修改该请求"/>
       </Grid>
       <TextBlock x:Name="ServiceHelp" TextWrapping="Wrap" Style="{StaticResource Field}"
                  Margin="0,0,0,9"/>
       <ComboBox x:Name="PresetCombo" DisplayMemberPath="Display" SelectionChanged="PresetChanged"
                 Visibility="Collapsed" Margin="0,0,0,9" ToolTip="常用 UDS 子功能"/>
       <Grid>
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="9"/>
         <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock x:Name="PrimaryLabel" Text="DID / 子功能" Style="{StaticResource Field}"/>
         <TextBox x:Name="PrimaryBox" FontFamily="Consolas" FontSize="15"
                  TextChanged="ParametersChanged" Padding="8,5"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
         <TextBlock x:Name="AuxiliaryLabel" Text="附加参数" Style="{StaticResource Field}"/>
         <TextBox x:Name="AuxiliaryBox" FontFamily="Consolas" FontSize="15"
                  TextChanged="ParametersChanged" Padding="8,5"/>
        </StackPanel>
       </Grid>
       <Border Background="#EEF4FB" CornerRadius="6" Padding="11,9" Margin="0,5,0,9">
        <StackPanel>
         <TextBlock Text="实际发送的 UDS PDU（HEX）" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
         <TextBox x:Name="RequestBox" FontFamily="Consolas" FontSize="17"
                  TextChanged="RequestChanged" Padding="8,6" Margin="0,8,0,0"
                  ToolTip="仅填写应用层 UDS PDU；不包含 CAN ID、ISO-TP PCI 或 USB 帧头"/>
        </StackPanel>
       </Border>
       <TextBlock x:Name="ComposerStatus" TextWrapping="Wrap" Foreground="#9B6C30"
                  FontSize="12" Margin="0,0,0,6"/>
       <CheckBox x:Name="PauseBeforeCheck" Content="连续运行到本步骤前暂停，等待人工检查/继续"
                 Checked="CaseStepFlagChanged" Unchecked="CaseStepFlagChanged" Margin="0,4,0,8"/>
       <Expander Header="跨步骤信息传递（可选）" Margin="0,6,0,0" IsExpanded="False">
        <StackPanel Margin="0,7,0,0">
         <TextBlock Text="动态请求模板（完整 PDU，可引用 {{变量名}}；留空则使用上方请求）" Style="{StaticResource Field}"/>
         <TextBox x:Name="RequestTemplateBox" FontFamily="Consolas" TextChanged="CaseStepDraftChanged"/>
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="7"/>
           <ColumnDefinition Width="62"/>
           <ColumnDefinition Width="7"/>
           <ColumnDefinition Width="62"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="本步正响应保存到变量" Style="{StaticResource Field}"/>
           <TextBox x:Name="CaptureNameBox" TextChanged="CaseStepDraftChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="偏移" Style="{StaticResource Field}"/>
           <TextBox x:Name="CaptureOffsetBox" Text="3" TextChanged="CaseStepDraftChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
           <TextBlock Text="字节数" Style="{StaticResource Field}"/>
           <TextBox x:Name="CaptureLengthBox" Text="0" TextChanged="CaseStepDraftChanged"/>
          </StackPanel>
         </Grid>
         <TextBlock Text="响应偏移从完整 ECU PDU 首字节起算；变量只来自本次执行中的有效正响应。"
                    Style="{StaticResource Field}" TextWrapping="Wrap"/>
         <TextBlock x:Name="CaseVariableStatus" Text="当前变量：无" Style="{StaticResource Field}"
                    TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
       </Expander>
       <Expander Header="响应匹配与解码（可选）" IsExpanded="False">
        <StackPanel Margin="0,9,0,0">
         <TextBlock Text="期望响应前缀（HEX）" Style="{StaticResource Field}"/>
         <TextBox x:Name="ExpectedBox" FontFamily="Consolas" TextChanged="DecoderChanged"/>
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="9"/>
           <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
           <TextBlock Text="解析方式" Style="{StaticResource Field}"/>
           <ComboBox x:Name="DecodeBox" SelectionChanged="DecoderChanged">
            <ComboBoxItem Content="原始 HEX" Tag="Hex"/>
            <ComboBoxItem Content="ASCII 字符串" Tag="Ascii"/>
            <ComboBoxItem Content="UInt8" Tag="UInt8"/>
            <ComboBoxItem Content="UInt16 大端" Tag="UInt16BE"/>
            <ComboBoxItem Content="UInt16 小端" Tag="UInt16LE"/>
            <ComboBoxItem Content="DTC 记录（0x19/02）" Tag="Dtc"/>
           </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="数据起始偏移（响应 PDU 字节）" Style="{StaticResource Field}"/>
           <TextBox x:Name="OffsetBox" Text="3" TextChanged="DecoderChanged"/>
          </StackPanel>
         </Grid>
         <WrapPanel Margin="0,3,0,0">
          <TextBlock Text="比例" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="ScaleBox" Width="80" Text="1" TextChanged="DecoderChanged" Margin="0,0,12,0"/>
          <TextBlock Text="单位" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="UnitBox" Width="130" TextChanged="DecoderChanged"/>
         </WrapPanel>
        </StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
             Padding="0,11,0,0">
      <StackPanel>
       <WrapPanel Margin="0,0,0,5" VerticalAlignment="Center">
        <Button x:Name="RunCaseButton" Content="▶ 运行整个用例" Click="RunCase_Click"
                Style="{StaticResource Primary}" ToolTip="按顺序执行所有勾选的诊断步骤" Margin="0,0,8,0"/>
        <Button x:Name="SendButton" Content="发送当前步骤" Click="Send_Click"
                IsEnabled="False" Margin="0,0,8,0" ToolTip="只发送当前选中服务步骤，不自动继续"/>
        <Button x:Name="CancelButton" Content="■ 停止" Click="Cancel_Click"
                IsEnabled="False" Margin="0,0,8,0" ToolTip="停止本地等待，不保证 ECU 已取消操作"/>
       </WrapPanel>
       <WrapPanel Margin="0,0,0,4">
        <Button x:Name="RunNextButton" Content="执行下一步" Click="RunNext_Click" Margin="0,0,7,0" Padding="10,5"/>
        <Button x:Name="RunFromButton" Content="从选中步骤继续" Click="RunFrom_Click" Margin="0,0,7,0" Padding="10,5"/>
        <TextBlock x:Name="RequestState" Text="连接 ECU 后可运行；未连接仍可编辑和保存"
                   VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/>
       </WrapPanel>
       <Border Background="#EDF4FB" CornerRadius="5" Padding="9,7" Margin="0,5,0,0">
        <StackPanel>
         <TextBlock x:Name="CaseProgressText" Text="诊断用例就绪 · 未运行" FontWeight="SemiBold"
                    Foreground="#285884" FontSize="12"/>
         <TextBlock x:Name="CaseRunStatus" Text="编辑步骤后可单独发送，或顺序执行整个用例；失败默认停止后续请求"
                    Style="{StaticResource Field}" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
       </Border>
       <TextBlock Text="当前真实 CAN 发送仍需逐帧人工授权；主控 ACK 不代表 ECU 响应。"
                  FontSize="11" Foreground="#956A3E" Margin="0,7,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>

     </Grid>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Width="8" Background="#E7EDF5" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="拖动调整编辑器与诊断响应的宽度"/>
   <Border Grid.Column="2" Style="{StaticResource Pane}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="5*" MinHeight="160"/>
      <RowDefinition Height="7"/>
      <RowDefinition Height="4*" MinHeight="155"/>
     </Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="ECU 请求 / 响应" Style="{StaticResource Section}"/>
       <TextBlock Text="真实请求逐条留存；选中可查看完整响应、NRC 和来源用例"
                  Style="{StaticResource Field}" Margin="0,3,0,0"/>
      </StackPanel>
      <TextBlock x:Name="HistoryCount" Grid.Column="1" Text="0 条" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
     </Grid>
     <Grid Grid.Row="1">
      <ListView x:Name="HistoryList" SelectionChanged="HistorySelected"
                BorderBrush="{StaticResource Line}" BorderThickness="1" FontSize="12"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
       <ListView.View>
        <GridView>
         <GridViewColumn Header="时间" Width="89" DisplayMemberBinding="{Binding Time}"/>
         <GridViewColumn Header="诊断步骤" Width="150" DisplayMemberBinding="{Binding Name}"/>
         <GridViewColumn Header="请求 PDU" Width="125" DisplayMemberBinding="{Binding Request}"/>
         <GridViewColumn Header="结果" Width="140" DisplayMemberBinding="{Binding Status}"/>
         <GridViewColumn Header="耗时" Width="68" DisplayMemberBinding="{Binding Elapsed}"/>
        </GridView>
       </ListView.View>
      </ListView>
      <TextBlock x:Name="EmptyHistory" Text="暂无真实诊断记录&#10;左边修改请求并发送，结果会逐条追加"
                 Foreground="#8495AA" FontSize="13" TextAlignment="Center"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False" TextWrapping="Wrap"/>
     </Grid>
     <GridSplitter Grid.Row="2" Background="#E4EAF2" Height="7"
                   HorizontalAlignment="Stretch" ResizeDirection="Rows"
                   ResizeBehavior="PreviousAndNext" ToolTip="拖动调整历史记录与解析结果高度"/>
     <Grid Grid.Row="3" Margin="0,9,0,0">
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,7">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="选中记录的响应与解析" Style="{StaticResource Section}" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Content="将此请求回填到左侧" Click="Reuse_Click" Padding="9,5"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock x:Name="ResultStatus" Text="尚无 ECU 响应" Foreground="{StaticResource Ink}"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,9"/>
        <TextBlock Text="解析结果" Style="{StaticResource Field}"/>
        <TextBox x:Name="DecodedResultBox" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" MinHeight="54" VerticalContentAlignment="Top"/>
        <TextBlock Text="发送的请求" Style="{StaticResource Field}"/>
        <TextBox x:Name="RecordedRequestBox" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap"/>
        <TextBlock Text="ECU 返回的 PDU" Style="{StaticResource Field}"/>
        <TextBox x:Name="RecordedResponseBox" IsReadOnly="True" FontFamily="Consolas"
                 TextWrapping="Wrap" MinHeight="40"/>
        <TextBlock Text="诊断说明 / NRC / 原因" Style="{StaticResource Field}"/>
        <TextBox x:Name="ResultDetailsBox" IsReadOnly="True" TextWrapping="Wrap"
                 AcceptsReturn="True" MinHeight="55" VerticalContentAlignment="Top"/>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <Expander Grid.Row="3" Header="原始通信日志 · USB / CAN / ISO-TP / UDS（需要时展开）"
            Margin="0,10,0,0">
   <TextBox x:Name="TraceBox" IsReadOnly="True" Height="195" AcceptsReturn="True"
            FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
            Margin="0,7,0,0"/>
  </Expander>
 </Grid>
</Window>
