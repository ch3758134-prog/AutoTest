<UserControl x:Class="AutoTest.Desktop.Project.ProjectExplorerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:AutoTest.Desktop.Shell"
 Background="#FFFFFF" Foreground="{DynamicResource StudioText}" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources>
  
 </UserControl.Resources>
 <Grid Margin="9">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,8">
   <TextBlock Text="工程文件" FontWeight="SemiBold" FontSize="14" Margin="3,4,0,4"/>
   <TextBlock Text="双击文件打开对应编辑器" FontSize="11" Foreground="#71859A" Margin="3,0,0,9"/>
   <TextBox Text="{Binding EditableProjectName,UpdateSourceTrigger=PropertyChanged}"
    ToolTip="当前工程名称（工程师编辑）" Padding="6,5"
    Background="#F7FAFD" Foreground="{DynamicResource StudioText}" BorderBrush="#D9E3EE" Margin="0,0,0,5"/>
   <Button Content="更新名称" Command="{Binding RenameProjectCommand}" HorizontalAlignment="Left"/>
  </StackPanel>
  <TreeView Grid.Row="1" x:Name="ResourceTree"
    ItemsSource="{Binding ResourceNodes}" BorderThickness="0"
    Background="White" Foreground="{DynamicResource StudioText}"
    MouseDoubleClick="ResourceTree_MouseDoubleClick" Margin="0,2,0,5">
   <TreeView.Resources>
    <HierarchicalDataTemplate DataType="{x:Type vm:WorkbenchResourceNode}" ItemsSource="{Binding Children}">
     <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" Foreground="#284660"/>
    </HierarchicalDataTemplate>
   </TreeView.Resources>
  </TreeView>
  <StackPanel Grid.Row="2" Margin="0,8,0,0">
   <WrapPanel>
    <Button Content="TEST 编辑" Click="OpenTest_Click"/>
    <Button Content="DBC 编辑" Click="OpenDbc_Click"/>
    <Button Content="编号规则" Click="OpenRules_Click"/>
   </WrapPanel>
   <Button Content="打开工程文件夹" Style="{StaticResource AtQuietButton}" Click="OpenFolder_Click"
    HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
   <TextBlock Text="编辑和保存进入工程资源修订；运行时使用已冻结的资源版本。"
    FontSize="11" TextWrapping="Wrap" Foreground="#778A9D" Margin="3,9,0,3"/>
  </StackPanel>
 </Grid>
</UserControl>