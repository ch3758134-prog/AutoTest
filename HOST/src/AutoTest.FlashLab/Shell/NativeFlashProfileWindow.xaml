<Window x:Class="AutoTest.FlashLab.Shell.NativeFlashProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="原生 ECU 烧录配置" Width="880" Height="690"
        MinWidth="750" MinHeight="510" Background="#FAFBFC"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,12">
   <StackPanel>
    <TextBlock Text="ECU 原生烧录配置" FontSize="20" FontWeight="SemiBold"
               Foreground="#172F43"/>
    <TextBlock Text="参数保存在固定工程位置，不需要 CanTool XML；仅支持已核验的 HydEPB 编程方法"
               Foreground="#6B7D8B" FontSize="12" Margin="0,5,0,0"/>
   </StackPanel>
  </DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
   <StackPanel>
    <Border Padding="14" Background="White" CornerRadius="8"
            BorderBrush="#DFE6EB" BorderThickness="1" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="目标工程与编程方法" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
      <WrapPanel>
       <StackPanel Width="280" Margin="0,0,15,8">
        <TextBlock Text="ECU 型号代码" Foreground="#617280"/>
        <TextBox x:Name="ModelBox" Margin="0,4,0,0" Padding="8,6" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Width="400" Margin="0,0,15,8">
        <TextBlock Text="当前编程方法" Foreground="#617280"/>
        <TextBox Text="CanTool-HydEPB-v1" IsReadOnly="True" Padding="8,6" Margin="0,4,0,0"/>
       </StackPanel>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Border Padding="14" Background="White" CornerRadius="8"
            BorderBrush="#DFE6EB" BorderThickness="1" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="CAN 诊断端点" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
      <WrapPanel>
       <StackPanel Width="180" Margin="0,0,14,8">
        <TextBlock Text="APP 请求 ID (HEX)"/>
        <TextBox x:Name="AppTxBox" Padding="8,6" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Width="180" Margin="0,0,14,8">
        <TextBlock Text="APP 应答 ID (HEX)"/>
        <TextBox x:Name="AppRxBox" Padding="8,6" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Width="180" Margin="0,0,14,8">
        <TextBlock Text="Boot 请求 ID (HEX)"/>
        <TextBox x:Name="BootTxBox" Padding="8,6" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Width="180" Margin="0,0,14,8">
        <TextBlock Text="Boot 应答 ID (HEX)"/>
        <TextBox x:Name="BootRxBox" Padding="8,6" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Width="180" Margin="0,0,14,8">
        <TextBlock Text="ECU CAN 波特率 (kbit/s)"/>
        <ComboBox x:Name="BaudBox" Width="160" SelectedIndex="1"
                  SelectionChanged="EditorSelectionChanged">
         <ComboBoxItem Content="250"/>
         <ComboBoxItem Content="500"/>
        </ComboBox>
       </StackPanel>
      </WrapPanel>
     </StackPanel>
    </Border>
    <Border Padding="14" Background="White" CornerRadius="8"
            BorderBrush="#DFE6EB" BorderThickness="1" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="烧录空间与下载参数" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
      <WrapPanel>
       <StackPanel Width="180" Margin="0,0,14,8">
        <TextBlock Text="起始地址 (HEX)"/>
        <TextBox x:Name="StartBox" Padding="8,6" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Width="180" Margin="0,0,14,8">
        <TextBlock Text="结束地址（含）(HEX)"/>
        <TextBox x:Name="EndBox" Padding="8,6" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Width="180" Margin="0,0,14,8">
        <TextBlock Text="对齐块长 (字节)"/>
        <TextBox x:Name="BlockBox" Padding="8,6" TextChanged="EditorChanged"/>
       </StackPanel>
       <StackPanel Width="180" Margin="0,0,14,8">
        <TextBlock Text="BIN 基址（可选 HEX）"/>
        <TextBox x:Name="BinBaseBox" Padding="8,6" TextChanged="EditorChanged"/>
       </StackPanel>
      </WrapPanel>
      <TextBlock Text="P2、擦除/校验例程和尾块行为由已核实的 CanTool-HydEPB-v1 方法管理，当前不能任意改写。"
                 Foreground="#627484" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <Border Padding="14" Background="White" CornerRadius="8"
            BorderBrush="#DFE6EB" BorderThickness="1" Margin="0,0,0,10">
     <StackPanel>
      <TextBlock Text="当前受控资源" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,9"/>
      <WrapPanel Margin="0,0,0,5">
       <Button Content="导入 HEX / S19 / BIN 固件" Click="ImportFirmware_Click" Padding="13,7"/>
       <TextBlock x:Name="FirmwareLabel" VerticalAlignment="Center"
                  Text="尚未导入固件" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
      </WrapPanel>
      <WrapPanel>
       <Button Content="导入受审安全算法 DLL" Click="ImportSecurity_Click" Padding="13,7"/>
       <TextBlock x:Name="SecurityLabel" VerticalAlignment="Center"
                  Text="尚未导入安全算法" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
      </WrapPanel>
      <TextBlock Text="导入会复制到工程内部并按 SHA256 固定；源文件删除不会影响工程。当前仅接受已核实的参考安全算法。"
                 Foreground="#627484" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,12,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="发布为当前生产配置" Click="Publish_Click" Padding="12,8" Margin="0,0,8,0"/>
    <Button Content="校验并预览真实 Job" Click="Preview_Click" Padding="12,8" Margin="0,0,8,0"/>
    <Button Content="保存" Click="Save_Click" Padding="15,8" Margin="0,0,8,0"/>
    <Button Content="关闭" Click="Close_Click" Padding="15,8"/>
   </StackPanel>
   <TextBlock x:Name="StatusLabel" Text="配置草稿尚未保存"
              TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#375B73"
              Margin="0,0,10,0" FontSize="12"/>
  </DockPanel>
 </Grid>
</Window>
