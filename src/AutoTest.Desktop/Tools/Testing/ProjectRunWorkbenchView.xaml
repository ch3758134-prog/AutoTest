<UserControl x:Class="AutoTest.Desktop.Tools.Testing.ProjectRunWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#101620" Foreground="#E2EDF7" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E2EDF7"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#263748"/>
   <Setter Property="Foreground" Value="#E2EDF7"/>
   <Setter Property="BorderBrush" Value="#314458"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Padding" Value="12,7"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,16">
   <TextBlock Text="P11 / PROJECT RUN" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="执行对象：当前 P01 工程 / P10 TEST 的同一份已编辑测试程序；不加载独立 LAB 演示文档。" Foreground="#93AFC6" Margin="0,6,0,5" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding ProjectLabel}" FontWeight="SemiBold"/>
   <TextBlock Text="当前执行后端仅为 MOCK：不控制真实 ECU，不产生出厂 PASS。物理步骤执行须通过独立受控执行适配和安全门禁。" Foreground="#F4BD78" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#192431" BorderBrush="#314458" BorderThickness="1" Padding="12" Margin="0,0,0,12">
   <StackPanel>
    <WrapPanel>
     <Button Content="检查当前工程 / TEST" Command="{Binding ValidateCommand}"/>
     <Button Content="R2 统一测试程序预检" Command="{Binding PrepareR2Command}"/>
     <Button Content="运行当前 TEST（Mock）" Command="{Binding RunCommand}" Background="#196C9A"/>
     <Button Content="停止" Command="{Binding StopCommand}"/>
     <Button Content="暂停" Command="{Binding PauseCommand}"/>
     <Button Content="继续" Command="{Binding ResumeCommand}"/>
     <Button Content="单步" Command="{Binding StepCommand}"/>
    </WrapPanel>
    <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <TextBlock Text="{Binding R2PrepareStatus}" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="#E8B967"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="240"/>
    <ColumnDefinition Width="*"/>
   </Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#192431" BorderBrush="#314458" BorderThickness="1" Margin="0,0,10,0" Padding="12">
    <StackPanel>
     <TextBlock Text="RUN / RESULT" FontWeight="SemiBold" Margin="0,0,0,15"/>
     <TextBlock Text="请求"/><TextBlock Text="{Binding RequestStatus}" TextWrapping="Wrap" Margin="0,3,0,12"/>
     <TextBlock Text="硬件 ACK"/><TextBlock Text="{Binding AckStatus}" TextWrapping="Wrap" Margin="0,3,0,12"/>
     <TextBlock Text="观测来源"/><TextBlock Text="{Binding ObservationStatus}" TextWrapping="Wrap" Margin="0,3,0,12"/>
     <TextBlock Text="判定"/><TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,3,0,12"/>
     <TextBlock Text="错误"/><TextBlock Text="{Binding FailureReason}" TextWrapping="Wrap" Foreground="#F0A48B" Margin="0,3,0,12"/>
    </StackPanel>
   </Border>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="StepFact / 审计事实（仅来自当前工程 TEST 的运行）" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <ListBox Grid.Row="1" ItemsSource="{Binding FactLines}" Background="#192431" Foreground="#E2EDF7"
      BorderBrush="#314458" FontFamily="Consolas" FontSize="12" HorizontalContentAlignment="Stretch"
      ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>