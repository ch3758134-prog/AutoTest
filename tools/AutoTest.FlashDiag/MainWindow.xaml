<Window x:Class="AutoTest.FlashDiag.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:flash="clr-namespace:AutoTest.Desktop.Tools.Flash;assembly=AutoTest.Desktop"
 xmlns:uds="clr-namespace:AutoTest.Desktop.Tools.Uds;assembly=AutoTest.Desktop"
 Title="AutoTest · 独立 CAN Flash 联调与诊断" Width="1460" Height="940"
 MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen"
 Background="#101620" Foreground="#E2EDF7" FontFamily="Segoe UI" FontSize="13"
 Closing="Window_Closing">
 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="160"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="6,4,6,12">
   <TextBlock Text="CAN FLASH · 实际 ECU 独立排障" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="独立进程 / 单设备 WinUSB / CAN1 / 固件与 CanTool XML / UDS 原始诊断 / 会话证据"
              Foreground="#9AADC1" Margin="0,5,0,0"/>
   <TextBlock Text="注意：当前软件只支持固件解析、配置核对、真实 CAN1 只读诊断。物理烧录序列（安全解锁、擦除、传输、校验、复位）尚未实现，不会发送写入命令。"
              Foreground="#E8B967" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#192431" BorderBrush="#314458" BorderThickness="1" Padding="10" Margin="0,0,0,8">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="重新查找 USB" Click="Refresh_Click" Margin="3" Padding="10,6"/>
     <Button x:Name="ConnectButton" Content="连接主控" Click="Connect_Click" Margin="3" Padding="10,6"/>
     <Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click" Margin="3" Padding="10,6" IsEnabled="False"/>
     <Button Content="导出 USB/CAN 诊断日志…" Click="Export_Click" Margin="3" Padding="10,6"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="真实设备 · Windows WinUSB 主控板" FontWeight="SemiBold"/>
     <ComboBox x:Name="Devices" Width="485" HorizontalAlignment="Left" Margin="0,6,0,5"
               DisplayMemberPath="DisplayIdentity" Background="#243343" Foreground="#E2EDF7"/>
     <TextBlock x:Name="StatusLine" Text="未连接；连接设备后可进行 CAN1 实际只读诊断。" TextWrapping="Wrap" Foreground="#81C9BA"/>
     <TextBlock x:Name="TracePathLine" Text="USB/CAN JSONL：未开始" Foreground="#9AADC1" TextWrapping="Wrap"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TabControl Grid.Row="2" Background="#101620" Foreground="#E2EDF7">
   <TabItem Header="① 固件 / CanTool 配置 / 地址 / 预检">
    <flash:FlashToolView x:Name="FlashPanel"/>
   </TabItem>
   <TabItem Header="② 真实 CAN1 UDS 只读通信 / ISO-TP / NRC">
    <uds:UdsToolView x:Name="UdsPanel"/>
   </TabItem>
  </TabControl>
  <Border Grid.Row="3" Margin="0,10,0,0" Background="#192431" BorderBrush="#314458" BorderThickness="1" Padding="9">
   <DockPanel>
    <DockPanel DockPanel.Dock="Top">
     <Button DockPanel.Dock="Right" Content="复制日志" Click="CopyLog_Click" Padding="9,4"/>
     <TextBlock Text="真实 WinUSB / CAN 操作时间线（最近 1000 条）" FontWeight="SemiBold"/>
    </DockPanel>
    <ListBox x:Name="Logs" ItemsSource="{Binding}" Background="#192431"
             Foreground="#E2EDF7" FontFamily="Consolas" FontSize="11"
             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>