<UserControl x:Class="AutoTest.Desktop.Tools.Flash.FlashToolView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#101620" Foreground="#E2EDF7" FontFamily="Segoe UI" FontSize="13">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#E2EDF7"/>
   <Setter Property="Background" Value="#263748"/>
   <Setter Property="BorderBrush" Value="#314458"/>
   <Setter Property="Margin" Value="3,2"/>
   <Setter Property="Padding" Value="12,6"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="#E2EDF7"/>
   <Setter Property="Background" Value="#101620"/>
   <Setter Property="BorderBrush" Value="#314458"/>
   <Setter Property="Padding" Value="6,5"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E2EDF7"/></Style>
  <Style TargetType="DataGrid">
   <Setter Property="Foreground" Value="#E2EDF7"/>
   <Setter Property="Background" Value="#192431"/>
   <Setter Property="RowBackground" Value="#192431"/>
   <Setter Property="AlternatingRowBackground" Value="#202D3B"/>
   <Setter Property="BorderBrush" Value="#314458"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button Content="选择固件…" Click="BrowseImage_Click"/>
    <Button Content="导入 CanTool XML…" Click="ImportCanTool_Click"/>
    <Button Content="验证固件和配置" Command="{Binding PreflightCommand}"/>
    <Button Content="检查当前真实主控" Click="PhysicalPreflight_Click"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="CAN Flash / 固件与配置" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="Firmware · ECU Profile · Address Map · Hardware Preflight"
               Foreground="#92A4B7" Margin="0,4,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Padding="10" BorderBrush="#876038" BorderThickness="1"
          Background="#493425" Margin="0,0,0,12">
   <TextBlock Text="当前模块只执行真实文件解析、地址范围验证与非破坏性硬件检查。尚未实现获准的物理刷写流程，不发送 ECU 擦除、写入或复位命令。"
              TextWrapping="Wrap" Foreground="#F5D7A2"/>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#192431" BorderBrush="#314458" BorderThickness="1" Padding="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock Text="镜像文件 / 实际 ECU 配置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="固件文件 HEX / S19 / BIN" Foreground="#92A4B7"/>
      <TextBox Text="{Binding ImagePath,UpdateSourceTrigger=PropertyChanged}"/>
      <WrapPanel Margin="0,4,0,14">
       <Button Content="浏览…" Click="BrowseImage_Click"/>
       <Button Content="解析文件" Command="{Binding LoadCommand}"/>
      </WrapPanel>
      <TextBlock Text="BIN 基地址（HEX）" Foreground="#92A4B7"/>
      <TextBox Text="{Binding BinAddress,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="目标 ECU 型号（人工配置）" Foreground="#92A4B7" Margin="0,12,0,0"/>
      <TextBox Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="期望 ECU 身份（人工配置）" Foreground="#92A4B7" Margin="0,12,0,0"/>
      <TextBox Text="{Binding ExpectedIdentity,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="CanTool XML Flash 起点 / 终点" Foreground="#92A4B7" Margin="0,12,0,0"/>
      <TextBlock Text="{Binding AllowedStart}" FontFamily="Consolas"/>
      <TextBlock Text="{Binding AllowedEnd}" FontFamily="Consolas" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding ConfigurationStatus}" TextWrapping="Wrap" Foreground="#81C9BA"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#192431" BorderBrush="#314458" BorderThickness="1" Padding="12">
     <StackPanel>
      <TextBlock Text="固件解析结果" FontSize="15" FontWeight="SemiBold"/>
      <WrapPanel Margin="0,12,0,8">
       <TextBlock Text="格式：" Foreground="#92A4B7"/>
       <TextBlock Text="{Binding Format}" Margin="0,0,18,0"/>
       <TextBlock Text="字节：" Foreground="#92A4B7"/>
       <TextBlock Text="{Binding Bytes}"/>
      </WrapPanel>
      <TextBlock Text="{Binding Hash}" FontFamily="Consolas" TextWrapping="Wrap" Foreground="#46D0DC"/>
      <TextBlock Text="{Binding Failure}" TextWrapping="Wrap" Foreground="#FF8994" Margin="0,7,0,0"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
    <TabControl Grid.Row="1" Margin="0,10,0,0" Background="#192431">
     <TabItem Header="固件段">
      <DataGrid ItemsSource="{Binding Segments}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
       <DataGrid.Columns>
        <DataGridTextColumn Header="起点" Binding="{Binding Start}" Width="*"/>
        <DataGridTextColumn Header="终点（不含）" Binding="{Binding EndExclusive}" Width="*"/>
        <DataGridTextColumn Header="字节" Binding="{Binding Bytes}" Width="Auto"/>
       </DataGrid.Columns>
      </DataGrid>
     </TabItem>
     <TabItem Header="CanTool 配置字段">
      <DataGrid ItemsSource="{Binding ConfigurationFields}" AutoGenerateColumns="True" IsReadOnly="True"/>
     </TabItem>
     <TabItem Header="真实硬件预检">
      <DockPanel>
       <StackPanel DockPanel.Dock="Top" Margin="8">
        <TextBlock Text="{Binding PhysicalPreflight}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Preflight}" Foreground="#E8B967"/>
       </StackPanel>
       <DataGrid ItemsSource="{Binding PhysicalChecks}" AutoGenerateColumns="True" IsReadOnly="True"/>
      </DockPanel>
     </TabItem>
    </TabControl>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0">
   <TextBlock Text="{Binding SourceLabel}" Foreground="#E8B967" TextWrapping="Wrap"/>
   <TextBlock Text="烧录发送路径暂未授权；配置解析和硬件条件核对不能当作 ECU 已经被编程的证据。"
              Foreground="#92A4B7" TextWrapping="Wrap" Margin="0,5,0,0"/>
  </StackPanel>
 </Grid>
</UserControl>