<UserControl x:Class="AutoTest.Desktop.Bench.BenchWorkbenchView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#F6F8FB" Foreground="#23374D" FontFamily="Segoe UI" FontSize="13"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVis"/>
  <SolidColorBrush x:Key="Ink" Color="#23374D"/>
  <SolidColorBrush x:Key="Muted" Color="#657D95"/>
  <SolidColorBrush x:Key="Rule" Color="#DCE5EF"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Padding" Value="11,6"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="#F7FAFE"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="#CBD9E8"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D4E0EC"/>
   <Setter Property="Padding" Value="6,4"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D4E0EC"/>
  </Style>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="6"/>
   <Setter Property="Padding" Value="14"/>
  </Style>
  <Style x:Key="KeySwitch" TargetType="CheckBox">
   <Setter Property="Margin" Value="4"/>
   <Setter Property="Padding" Value="9,7"/>
   <Setter Property="Foreground" Value="#29435D"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="RowBackground" Value="#FFFFFF"/>
   <Setter Property="AlternatingRowBackground" Value="#F7FAFC"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#E7EDF4"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="RowHeight" Value="29"/>
   <Setter Property="ColumnHeaderHeight" Value="30"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F0F5FA"/>
   <Setter Property="Foreground" Value="#4F6B85"/>
   <Setter Property="Padding" Value="9,5"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="Padding" Value="7,3"/>
  </Style>
 </UserControl.Resources>

 <Grid Margin="15">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*" MinHeight="450"/>
  </Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="连接主控" Click="OpenStation_Click"
     ToolTip="打开共用的真实 WinUSB 主控连接窗口；本手动台架不会创建第二条 USB 会话"/>
    <Button Content="刷新状态/工程" Command="{Binding RefreshCommand}" Margin="0"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="手动台架" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="左侧编辑 CAN 报文 · 中间操作 20 路按键与 IGN · 右侧观察 ECU CAN 广播"
     Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
   </StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="12,10">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="1.2*"/>
     <ColumnDefinition Width="1.2*"/>
     <ColumnDefinition Width="1.5*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
     <TextBlock Text="主控设备" FontSize="11" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{Binding ConnectionStatus}" FontSize="15" FontWeight="SemiBold"
      Margin="0,5,0,2"/>
     <TextBlock Text="{Binding DeviceIdentity}" TextTrimming="CharacterEllipsis"
      ToolTip="{Binding DeviceIdentity}" FontSize="11" Foreground="{StaticResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="10,0,0,0">
     <TextBlock Text="当前工程" FontSize="11" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{Binding ProjectName}" FontSize="13" FontWeight="SemiBold"
      Margin="0,5,0,2" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{Binding Revision, StringFormat=Revision {0}}" FontSize="11"
      Foreground="{StaticResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Margin="10,0,0,0">
     <TextBlock Text="连接状态说明" FontSize="11" Foreground="{StaticResource Muted}"/>
     <TextBlock Text="{Binding ConnectionDetail}" TextWrapping="Wrap" FontSize="11"
      Foreground="#57718B" Margin="0,5,0,0" MaxHeight="47"/>
    </StackPanel>
   </Grid>
  </Border>


  <!-- One workstation: CAN transmit | direct 20-Key / IGN | DUT CAN receive. -->
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="40*" MinWidth="330"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="33*" MinWidth="315"/>
    <ColumnDefinition Width="6"/>
    <ColumnDefinition Width="35*" MinWidth="330"/>
   </Grid.ColumnDefinitions>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
    Background="#DFE8F1" ResizeDirection="Columns" ShowsPreview="True"/>
   <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
    Background="#DFE8F1" ResizeDirection="Columns" ShowsPreview="True"/>

   <!-- LEFT: raw and DBC-bound frames share the SAME real DUT CAN1 path. -->
   <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="11">
    <Grid DataContext="{Binding CanMessages}">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*" MinHeight="140"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="1.15*" MinHeight="130"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="CAN 报文发送" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="编辑报文 → 勾选要周期发送的行 → 开始发送。未勾选的不发送。"
       FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,5"/>
      <WrapPanel Margin="0,0,0,5">
       <Button Content="+ 新建原始报文" Command="{Binding AddCommand}"/>
       <Button Content="删除选中报文" Command="{Binding DeleteCommand}"/>
       <Button Content="打开 DBC 工具" Click="OpenDbc_Click" Margin="0"/>
      </WrapPanel>
      <TextBlock Text="从当前工程 DBC 选择报文（可选）"
       FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <ComboBox ItemsSource="{Binding DbcMessages}" SelectedItem="{Binding SelectedDbcMessage}"
        DisplayMemberPath="Name" MinHeight="30" ToolTip="选取已导入工程的 DBC 报文，不需要重新导入文件"/>
       <Button Grid.Column="1" Content="添加 DBC 报文" Command="{Binding AddFromDbcCommand}"
        Margin="7,0,0,0"/>
      </Grid>
      <TextBlock Text="{Binding DbcStatus}" FontSize="11" Foreground="#536F89"
       TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel>

     <DataGrid Grid.Row="1" ItemsSource="{Binding Messages}"
      SelectedItem="{Binding SelectedMessage,Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
      HeadersVisibility="Column" RowHeaderWidth="0" Margin="0,0,0,7"
      ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionUnit="FullRow">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="发" Width="35">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <CheckBox IsChecked="{Binding IsChecked,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="勾选后参加周期发送"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="名称" Width="82"
        Binding="{Binding Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="CAN ID" Width="81"
        Binding="{Binding CanIdHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridCheckBoxColumn Header="扩展" Width="43"
        Binding="{Binding Extended,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="数据（十六进制）" Width="130"
        Binding="{Binding DataHex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
       <DataGridTextColumn Header="周期 ms" Width="68"
        Binding="{Binding PeriodMsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
      </DataGrid.Columns>
     </DataGrid>

     <StackPanel Grid.Row="2" Margin="0,0,0,8">
      <WrapPanel Margin="0,0,0,5">
       <Button Content="开始周期发送（勾选行）" Command="{Binding StartPeriodicCommand}"
        Background="#176AB2" Foreground="White" FontWeight="SemiBold"/>
       <Button Content="停止发送" Command="{Binding StopPeriodicCommand}" Margin="0"
        Foreground="#A74541" Background="#FFF1EC"/>
      </WrapPanel>
      <WrapPanel>
       <Button Content="单次发送（选中行）" Command="{Binding SendOnceCommand}"/>
       <Button Content="保存发送表" Command="{Binding SaveCommand}"/>
       <Button Content="重新加载" Click="ReloadCanMessages_Click" Margin="0"/>
      </WrapPanel>
     </StackPanel>

     <Border Grid.Row="3" BorderBrush="{StaticResource Rule}" BorderThickness="1"
      CornerRadius="4" Padding="8" Background="#FAFCFF">
      <Grid>
       <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
       </Grid.RowDefinitions>
       <DockPanel Grid.Row="0" Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Content="转为原始报文"
         Command="{Binding UnbindDbcCommand}" Margin="0" Padding="6,3" MinHeight="24"/>
        <TextBlock Text="DBC 信号编辑" FontWeight="SemiBold" FontSize="13"
         VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Grid.Row="1" Text="{Binding SignalStatus}" FontSize="11"
        Foreground="#536F89" TextWrapping="Wrap" Margin="0,0,0,5"/>
       <DataGrid Grid.Row="2" ItemsSource="{Binding SignalInputs}"
        AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
        IsEnabled="{Binding CanEdit}" HeadersVisibility="Column" RowHeaderWidth="0">
        <DataGrid.Columns>
         <DataGridTextColumn Header="信号" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>
         <DataGridTextColumn Header="物理值" Width="100"
          Binding="{Binding ValueText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
         <DataGridTextColumn Header="单位" Width="58" Binding="{Binding Unit}" IsReadOnly="True"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock Grid.Row="3" Text="修改信号值会自动编码左侧选中报文的 Data；未发送前不会影响 ECU。"
        FontSize="10" Foreground="#6F8498" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </Grid>
     </Border>
     <StackPanel Grid.Row="4" Margin="0,7,0,0">
      <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Foreground="#536F89"/>
      <TextBlock Text="{Binding PeriodicStatus}" FontSize="11" TextWrapping="Wrap"
       Foreground="#8B6733" Margin="0,3,0,0"/>
     </StackPanel>
    </Grid>
   </Border>


   <!-- CENTER: ONE 20-switch editor belongs to the selected named action step. -->
   <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="11">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="*" MinHeight="320"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled">
      <StackPanel DataContext="{Binding KeyActions}">
       <TextBlock Text="按键动作" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="新建动作或选择已有动作，逐步配置 ECU 要接收的开关组合。"
        FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
        Margin="0,4,0,9"/>
       <Grid Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/>
         <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction,Mode=TwoWay}"
         DisplayMemberPath="Name" MinHeight="30" ToolTip="当前工程的自定义按键动作"/>
        <Button Grid.Column="1" Content="新建动作" Command="{Binding NewActionCommand}"
         Margin="7,0,0,0"/>
       </Grid>
       <DockPanel Margin="0,0,0,8">
        <TextBlock DockPanel.Dock="Left" Text="动作名称" VerticalAlignment="Center"
         Margin="0,0,8,0"/>
        <TextBox Text="{Binding SelectedAction.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
         MinHeight="29" ToolTip="例如：按键识别实验 A；名称由你自由定义"/>
       </DockPanel>

       <DockPanel Margin="0,0,0,5">
        <TextBlock Text="动作步骤（按顺序执行）" FontWeight="SemiBold"
         VerticalAlignment="Center"/>
       </DockPanel>
       <WrapPanel IsEnabled="{Binding CanEdit}" Margin="0,0,0,5">
        <Button Content="+ 开关组合" Command="{Binding AddSetKeysCommand}"/>
        <Button Content="+ 保持时间" Command="{Binding AddHoldCommand}"/>
        <Button Content="上移" Command="{Binding MoveStepUpCommand}"/>
        <Button Content="下移" Command="{Binding MoveStepDownCommand}"/>
        <Button Content="删除步骤" Command="{Binding RemoveStepCommand}" Margin="0"/>
       </WrapPanel>
       <ListBox Height="112" ItemsSource="{Binding Steps}" DisplayMemberPath="Summary"
        SelectedItem="{Binding SelectedStep,Mode=TwoWay}" Margin="0,0,0,9"
        ToolTip="点击不同步骤，下方 20 路开关会切换到该步骤的配置"/>

       <Border BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="5"
        Padding="9" Background="#FAFCFF" Margin="0,0,0,8">
        <StackPanel>
         <TextBlock Text="当前步骤编辑" FontWeight="SemiBold" FontSize="13"
          Margin="0,0,0,7"/>
         <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="Auto"/>
           <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="步骤名称" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Grid.Column="1" MinHeight="27" IsEnabled="{Binding CanEdit}"
           Text="{Binding SelectedStep.Name,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
           ToolTip="可独立命名每个开关组合或保持步骤，例如：驻车按下、等待识别"/>
         </Grid>
         <StackPanel Visibility="{Binding IsKeyStep,Converter={StaticResource BoolVis}}">
          <TextBlock Text="本步骤的 20 路开关" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock Text="勾选＝闭合，不勾选＝断开；这里只编辑当前选中步骤。"
           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
           Margin="0,0,0,6"/>
          <ItemsControl ItemsSource="{Binding Switches}" IsEnabled="{Binding CanEdit}">
           <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
           </ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Border BorderBrush="#DCE5EF" BorderThickness="1" CornerRadius="3"
              Margin="2" Background="White" Padding="2">
              <CheckBox Content="{Binding BitLabel}"
               IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
               FontWeight="SemiBold" HorizontalAlignment="Center"
               Margin="2" Padding="3,6"
               ToolTip="当前步骤的真实 KEY_SIM 电阻网络开关状态；编辑本身不会发送"/>
             </Border>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="0,8,0,5">
           <Button Content="试发此开关组合" Command="{Binding SendSelectedStepCommand}"
            IsEnabled="{Binding CanEdit}" Background="#176AB2" Foreground="White"/>
           <Button Content="清空本步骤勾选" Command="{Binding ClearMaskCommand}"
            IsEnabled="{Binding CanEdit}" Margin="0"/>
          </WrapPanel>
          <TextBlock Text="{Binding SelectedStepResult}" FontSize="11"
           Foreground="#536F89" TextWrapping="Wrap"/>
         </StackPanel>
         <StackPanel Visibility="{Binding IsHoldStep,Converter={StaticResource BoolVis}}">
          <TextBlock Text="本步骤保持前一步的开关状态，不再发送新开关组合。"
           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
           Margin="0,0,0,7"/>
          <WrapPanel>
           <TextBlock Text="保持时间" VerticalAlignment="Center" Margin="0,0,8,0"/>
           <TextBox Width="100" IsEnabled="{Binding CanEdit}"
            Text="{Binding SelectedStep.DurationMsText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
           <TextBlock Text="毫秒" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </WrapPanel>
         </StackPanel>
        </StackPanel>
       </Border>

       <WrapPanel Margin="0,0,0,6">
        <Button Content="试运行整个动作" Command="{Binding RunActionCommand}"
         Background="#176AB2" Foreground="White" FontWeight="SemiBold"/>
        <Button Content="停止动作" Command="{Binding StopActionCommand}"/>
        <Button Content="保存动作" Command="{Binding SaveActionsCommand}"/>
        <Button Content="重新加载" Click="ReloadKeyActions_Click" Margin="0"/>
       </WrapPanel>
       <WrapPanel Margin="0,0,0,6">
        <Button Content="释放全部真实按键"
         Command="{Binding DataContext.ReleaseAllKeysCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
         Foreground="#A74541" Background="#FFF1EC" Margin="0"/>
       </WrapPanel>
       <WrapPanel Margin="0,0,0,6">
        <Button Content="复制动作" Command="{Binding CopyActionCommand}"/>
        <Button Content="删除动作" Command="{Binding DeleteActionCommand}" Margin="0"/>
       </WrapPanel>
       <TextBlock Text="{Binding Status}" Foreground="#536F89" FontSize="11"
        TextWrapping="Wrap" Margin="0,0,0,4"/>
       <TextBlock Text="{Binding Progress}" Foreground="#8B6733" FontSize="11"
        TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>

     <!-- IGN and fixture are one separate hardware-control group, not Key steps. -->
     <Border Grid.Row="1" BorderBrush="{StaticResource Rule}" BorderThickness="1"
      CornerRadius="5" Background="#F6F9FC" Padding="9" Margin="0,9,0,0">
      <StackPanel>
       <TextBlock Text="其他设备控制 · IGN / 夹具" FontSize="14" FontWeight="SemiBold"/>
       <WrapPanel Margin="0,7,0,3">
        <TextBlock Text="点火 IGN" VerticalAlignment="Center" FontWeight="SemiBold"
         Margin="0,0,9,0"/>
        <Button Content="打开" Command="{Binding IgnOnCommand}"
         Foreground="#146A4D" Background="#E7F5ED" Padding="9,4"/>
        <Button Content="关闭" Command="{Binding IgnOffCommand}"
         Foreground="#A44835" Background="#FFF3EF" Padding="9,4" Margin="0"/>
       </WrapPanel>
       <TextBlock Text="{Binding IgnStatus}" FontSize="10"
        TextWrapping="Wrap" Foreground="#536F89" Margin="0,0,0,4"/>
       <WrapPanel Margin="0,3,0,4">
        <TextBlock Text="夹具电磁阀" VerticalAlignment="Center" FontWeight="SemiBold"
         Margin="0,0,9,0"/>
        <Button Content="升起" Command="{Binding SolenoidRaiseCommand}" Padding="9,4"/>
        <Button Content="下落" Command="{Binding SolenoidLowerCommand}" Padding="9,4"/>
        <Button Content="读取状态" Command="{Binding SolenoidReadCommand}"
         Padding="9,4" Margin="0"/>
       </WrapPanel>
       <TextBlock Text="{Binding SolenoidStatus}" FontSize="10" Foreground="#536F89"
        TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>

   <!-- RIGHT: DUT CAN1 broadcasts, not USB command/operator logs. -->
   <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="11">
    <Grid DataContext="{Binding CanMonitor}">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="ECU CAN 接收日志" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="实时显示被测 ECU 在 CAN1 广播的调试报文"
       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,6"/>
      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#536F89"
       TextWrapping="Wrap"/>
     </StackPanel>
     <WrapPanel Grid.Row="1" Margin="0,0,0,7">
      <TextBlock Text="CAN ID" VerticalAlignment="Center" Margin="0,0,5,0"/>
      <TextBox Width="92" Text="{Binding FilterId,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       Margin="0,0,6,0" ToolTip="输入报文 ID 进行筛选"/>
      <Button Content="{Binding PauseLabel}" Command="{Binding PauseCommand}"
       Padding="7,4"/>
      <Button Content="清空" Command="{Binding ClearCommand}" Padding="7,4" Margin="0"/>
     </WrapPanel>
     <TabControl Grid.Row="2">
      <TabItem Header="按 ID 实时刷新">
       <DataGrid ItemsSource="{Binding IdView}" AutoGenerateColumns="False"
        IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
        RowHeaderWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
         <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="74"/>
         <DataGridTextColumn Header="数据 HEX" Binding="{Binding Data}" Width="*"/>
         <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="55"/>
         <DataGridTextColumn Header="最近时间" Binding="{Binding LastAt,StringFormat={}{0:HH:mm:ss.fff}}" Width="94"/>
        </DataGrid.Columns>
       </DataGrid>
      </TabItem>
      <TabItem Header="原始接收流水">
       <DataGrid ItemsSource="{Binding HistoryView}" AutoGenerateColumns="False"
        IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
        RowHeaderWidth="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
         <DataGridTextColumn Header="时间" Binding="{Binding ReceivedAt,StringFormat={}{0:HH:mm:ss.fff}}" Width="92"/>
         <DataGridTextColumn Header="CAN ID" Binding="{Binding Id}" Width="74"/>
         <DataGridTextColumn Header="数据 HEX" Binding="{Binding Data}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
      </TabItem>
     </TabControl>
     <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <WrapPanel>
       <TextBlock Text="{Binding Received,StringFormat=收到 {0} 帧}" Margin="0,0,12,0"/>
       <TextBlock Text="{Binding DisplayDropped,StringFormat=显示丢弃 {0}}" Margin="0,0,12,0"/>
      </WrapPanel>
      <WrapPanel Margin="0,4,0,0">
       <TextBlock Text="{Binding PausedSkipped,StringFormat=暂停未显示 {0}}" Margin="0,0,12,0"/>
       <TextBlock Text="{Binding DeviceDropped,StringFormat=设备丢帧 {0}}"/>
      </WrapPanel>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>