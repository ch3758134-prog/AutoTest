<Window x:Class="AutoTest.Desktop.Shell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:prism="http://prismlibrary.com/"
 prism:ViewModelLocator.AutoWireViewModel="True"
 Title="AutoTest · 工程与测试程序编辑" Width="1440" Height="880"
 MinWidth="1030" MinHeight="650" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
 FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
 <Window.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
  <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
  <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
  <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
  <KeyBinding Key="F2" Command="{Binding FocusNameCommand}"/>
 </Window.InputBindings>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  <RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
 <Menu Grid.Row="0">
  <MenuItem Header="_文件"><MenuItem Header="新建工程" Command="{Binding NewProjectCommand}"/>
   <MenuItem Header="打开工程（含测试程序）" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O"/>
   <MenuItem Header="保存工程及测试程序" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
   <Separator/><MenuItem Header="导入 DBC" Command="{Binding ImportDbcCommand}"/>
   <MenuItem Header="应用所选 DBC 信号 Factor 编辑" Command="{Binding EditDbcCommand}"/>
   <Separator/><MenuItem Header="退出" Click="Close_Click"/></MenuItem>
  <MenuItem Header="_编辑"><MenuItem Header="撤销" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
   <MenuItem Header="重做" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"/>
   <Separator/><MenuItem Header="前插步骤" Command="{Binding InsertBeforeCommand}"/>
   <MenuItem Header="后插步骤" Command="{Binding InsertAfterCommand}"/>
   <MenuItem Header="复制步骤" Command="{Binding CopyCommand}"/>
   <MenuItem Header="插入子步骤" Command="{Binding InsertChildCommand}"/>
   <MenuItem Header="删除" Command="{Binding DeleteCommand}"/></MenuItem>
 </Menu>
 <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
  BorderThickness="0,0,0,1" Padding="10,7">
  <DockPanel>
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
    <TextBlock Text="当前：工程 / TEST 编辑" Foreground="{StaticResource Warning}" VerticalAlignment="Center" FontWeight="SemiBold"/>
    <TextBlock Text="    未接入真实自动测试执行 · 不产生出厂结论" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal">
    <Button Content="新建" Command="{Binding NewProjectCommand}"/>
    <Button Content="打开" Command="{Binding OpenProjectCommand}"/>
    <Button Content="保存工程" Command="{Binding SaveCommand}"/>
    <Button Content="导入 DBC" Command="{Binding ImportDbcCommand}"/>
    <Button Content="撤销" Command="{Binding UndoCommand}"/>
    <Button Content="验证" Command="{Binding ValidateCommand}"/>
   </StackPanel>
  </DockPanel>
 </Border>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions>
  <ColumnDefinition Width="270" MinWidth="180"/><ColumnDefinition Width="5"/>
  <ColumnDefinition Width="*" MinWidth="430"/><ColumnDefinition Width="5"/>
  <ColumnDefinition Width="315" MinWidth="240"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <DockPanel><Border DockPanel.Dock="Top" Padding="12,12,12,7">
    <StackPanel><TextBlock Text="工程资源管理器" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding ProjectLabel}" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,5" TextWrapping="Wrap"/>
     <TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索实际 TEST 节点"/></StackPanel>
   </Border><ContentControl prism:RegionManager.RegionName="ProjectExplorerRegion"/></DockPanel>
  </Border>
  <GridSplitter Grid.Column="1" Background="{StaticResource Line}" HorizontalAlignment="Stretch"/>
  <Border Grid.Column="2" Background="{StaticResource Canvas}">
   <DockPanel>
    <Border DockPanel.Dock="Top" Background="#27364A" Padding="12,9">
     <StackPanel Orientation="Horizontal"><TextBlock Text="测试程序 · 准备 / 测试 / 清理" FontWeight="SemiBold"/>
      <TextBlock Text="    编辑、保存与预检可用；运行待真实设备接线" Foreground="{StaticResource Warning}"/></StackPanel>
    </Border>
    <ContentControl prism:RegionManager.RegionName="TestEditorRegion"/>
   </DockPanel>
  </Border>
  <GridSplitter Grid.Column="3" Background="{StaticResource Line}" HorizontalAlignment="Stretch"/>
  <Border Grid.Column="4" Background="{StaticResource Panel}"><DockPanel>
   <Border DockPanel.Dock="Top" Background="#29384A" Padding="12,10">
    <TextBlock Text="TEST 步骤属性检查器" FontSize="15" FontWeight="SemiBold"/></Border>
   <ContentControl prism:RegionManager.RegionName="StepInspectorRegion"/>
  </DockPanel></Border>
 </Grid>
 <Border Grid.Row="3" Background="#173650" Padding="11,3"><DockPanel>
  <TextBlock Text="main 基线 · 工程 / DBC / TEST 编辑" FontWeight="SemiBold"/>
  <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Ink}"/>
 </DockPanel></Border>
 </Grid>
</Window>
