/**
  读取ADC数据并进行处理
 * 
 * 该函数负责读取ADC数据，并对读取到的数据进行处理和更新。
 * 具体处理方式为将当前ADC数据与之前的7次数据进行加权平均，
 * 以减少噪声和提高数据稳定性。
 */
void AD_Read(void)
{
    // 定义一个临时的ADC数据结构体，用于存储读取到的ADC数据
    Drv_Adc_Data_TypeDef Adc_Inf;

    // 调用驱动函数获取所有ADC通道的数据
    Drv_Adc_Get_All(&Adc_Inf);

//    // 对每个ADC通道的数据进行加权平均处理
//    ADC_Info.S.DRV_AD_BATIN = ((ADC_Info.S.DRV_AD_BATIN * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_BATIN + 4) >> 3);
//    ADC_Info.S.DRV_AD_Press_POW = ((ADC_Info.S.DRV_AD_Press_POW * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_Press_POW + 4) >> 3);
//    ADC_Info.S.DRV_AD_kEY_POW = ((ADC_Info.S.DRV_AD_kEY_POW * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_kEY_POW + 4) >> 3);
//    ADC_Info.S.DRV_AD_EPB_POW = ((ADC_Info.S.DRV_AD_EPB_POW * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_EPB_POW + 4) >> 3);
//    //ADC_Info.S.DRV_AD_Press1 = ((ADC_Info.S.DRV_AD_Press1 * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_Press1 + 4) >> 3);
//    //ADC_Info.S.DRV_AD_Press2 = ((ADC_Info.S.DRV_AD_Press2 * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_Press2 + 4) >> 3);
//    ADC_Info.S.DRV_AD_POW5V = ((ADC_Info.S.DRV_AD_POW5V * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_POW5V + 4) >> 3);
//    ADC_Info.S.DRV_AD_IGN = ((ADC_Info.S.DRV_AD_IGN * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_IGN + 4) >> 3);
//	ADC_Info.S.DRV_AD_BAUDRATE = ((ADC_Info.S.DRV_AD_BAUDRATE * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_BAUDRATE + 4) >> 3);
	
    // 对每个ADC通道的数据进行加权平均处理
    ADC_Info.S.DRV_AD_BATIN = ((ADC_Info.S.DRV_AD_BATIN * 4 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_BATIN * 4 + 4) >> 3);
    ADC_Info.S.DRV_AD_Press_POW = ((ADC_Info.S.DRV_AD_Press_POW * 4 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_Press_POW * 4 + 4) >> 3);
    ADC_Info.S.DRV_AD_kEY_POW = ((ADC_Info.S.DRV_AD_kEY_POW * 4 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_kEY_POW * 4 + 4) >> 3);
    ADC_Info.S.DRV_AD_EPB_POW = ((ADC_Info.S.DRV_AD_EPB_POW * 4 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_EPB_POW * 4 + 4) >> 3);
    //ADC_Info.S.DRV_AD_Press1 = ((ADC_Info.S.DRV_AD_Press1 * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_Press1 + 4) >> 3);
    //ADC_Info.S.DRV_AD_Press2 = ((ADC_Info.S.DRV_AD_Press2 * 7 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_Press2 + 4) >> 3);
    ADC_Info.S.DRV_AD_POW5V = ((ADC_Info.S.DRV_AD_POW5V * 4 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_POW5V * 4 + 4) >> 3);
    ADC_Info.S.DRV_AD_IGN = ((ADC_Info.S.DRV_AD_IGN * 4 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_IGN * 4 + 4) >> 3);
	ADC_Info.S.DRV_AD_BAUDRATE = ((ADC_Info.S.DRV_AD_BAUDRATE * 4 + 4) >> 3) + ((Adc_Inf.S.DRV_AD_BAUDRATE * 4 + 4) >> 3);
    // 设置ADC为使能状态
    Drv_Adc_Set_State(DRV_ADC_Enable);
}



u16 Get_KeyPow(void)
{
	u16 temp;
	temp = (u16)((float)ADC_Info.S.DRV_AD_kEY_POW*AD_KEY_Ratio + 0.5);
	return temp;
}

u16 Get_BAT(void)
{
	u16 temp;
	temp = (u16)((float)ADC_Info.S.DRV_AD_BATIN*AD_24V_Ratio + 0.5);
	return temp;
}



