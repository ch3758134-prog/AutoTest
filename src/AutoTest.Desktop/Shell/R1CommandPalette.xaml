<Window x:Class="AutoTest.Desktop.Shell.R1CommandPalette"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" AllowsTransparency="True"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
 Width="590" Height="520" Background="Transparent"
 Foreground="#253648" FontFamily="Microsoft YaHei UI" FontSize="13"
 ShowInTaskbar="False" Topmost="True" Loaded="Palette_Loaded"
 PreviewKeyDown="Palette_PreviewKeyDown">
 <Border Background="#FFFFFF" BorderBrush="#3188ED" BorderThickness="1.3"
         CornerRadius="9" Padding="14">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <DockPanel>
    <Button Content="✕" DockPanel.Dock="Right" Click="Close_Click" FontSize="15"
            Foreground="#637A90" Background="Transparent" BorderThickness="0" Padding="6,0"/>
    <TextBlock Text="查找命令与工具" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,12"/>
   </DockPanel>
   <TextBox x:Name="Query" Grid.Row="1" MinHeight="38" Padding="10,8"
            Foreground="#253648" Background="#F5F7FA" BorderBrush="#D9E5F3"
            TextChanged="Query_TextChanged"
            ToolTip="输入模块名称，回车打开，Esc 关闭"/>
   <ListBox x:Name="Commands" Grid.Row="2" Margin="0,10,0,0"
            Background="#F5F7FA" Foreground="#253648" BorderBrush="#D9E5F3"
            MouseDoubleClick="Commands_MouseDoubleClick">
    <ListBox.ItemTemplate>
     <DataTemplate>
      <DockPanel Margin="5,7">
       <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" FontSize="10" Foreground="#637A90"/>
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Icon}" Foreground="#3188ED" FontSize="16" Width="33"/>
        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
       </StackPanel>
      </DockPanel>
     </DataTemplate>
    </ListBox.ItemTemplate>
   </ListBox>
   <DockPanel Grid.Row="3" Margin="0,12,0,0">
    <TextBlock Text="↑↓ 选择   Enter 打开   Esc 关闭" Foreground="#637A90" FontSize="11"/>
    <TextBlock DockPanel.Dock="Right" Text="Ctrl+K 打开" Foreground="#65798F" FontSize="11"/>
   </DockPanel>
  </Grid>
 </Border>
</Window>