                        },
                        "operator": "=",
                        "expectedValue": 1
                      },
                      "timeoutMs": 5000,
                      "matchedNodes": []
                    }
                  }
                ]
              },
              {
                "value": 5,
                "nodes": [
                  {
                    "id": "sp-editor-state5-release-key",
