                        },
                        "operator": "=",
                        "expectedValue": 3
                      },
                      "timeoutMs": 5000,
                      "matchedNodes": []
                    }
                  },
                  {
                    "id": "sp-editor-state5-delay",
                    "name": "等待 300 ms",
                    "role": "Delay",
                    "durationMs": 300
                  },
                  {
                    "id": "sp-editor-state5-key-noop",
                    "name": "按键无操作",
                    "role": "Action",
                    "action": { "kind": "KeyInput", "keys": ["K7", "K10"] }
                  },
                  {
                    "id": "sp-editor-state5-wait-key1",
                    "name": "WHEN 等待 KeyStat = 1",
                    "role": "Control",
                    "control": {
                      "kind": "When",
                      "predicate": {
                        "kind": "Signal",
                        "measurement": {
                          "messageDefinitionId": "message:s:00000702",
                          "signalDefinitionId": "signal:message:s:00000702:KeyStat"
                        },
                        "operator": "=",
                        "expectedValue": 1
                      },
                      "timeoutMs": 5000,
                      "matchedNodes": []
                    }
                  },
                  {
                    "id": "sp-editor-state5-wait-car6",
                    "name": "WHEN 等待 Car_State = 6",
                    "role": "Control",
                    "control": {
                      "kind": "When",
                      "predicate": {
                        "kind": "Signal",
                        "measurement": {
                          "messageDefinitionId": "message:s:00000705",
                          "signalDefinitionId": "signal:message:s:00000705:Car_State"
                        },
                        "operator": "=",
                        "expectedValue": 6
                      },
                      "timeoutMs": 5000,
                      "matchedNodes": []
                    }
                  }
                ]
              }
            ],
            "defaultNodes": []
          }
        },
