<Window x:Class="AutoTest.Desktop.Shell.ProductionProjectLibraryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="生产工程管理" Width="1020" Height="740" MinWidth="780" MinHeight="550"
 WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei" FontSize="13"
 Background="#F6F8FB" Foreground="#263D52">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,7"/>
   <Setter Property="MinHeight" Value="34"/>
   <Setter Property="Margin" Value="0,0,9,0"/>
   <Setter Property="MinWidth" Value="72"/>
  </Style>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#DCE5ED"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="9"/>
   <Setter Property="Padding" Value="16"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="Section" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="FontSize" Value="16"/>
   <Setter Property="Margin" Value="0,0,0,11"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="9,7"/>
   <Setter Property="MinHeight" Value="34"/>
   <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,15">
   <Button Content="关闭" DockPanel.Dock="Right" Click="Close_Click"
    Margin="8,0,0,0"/>
   <StackPanel>
    <TextBlock Text="生产工程库" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock Text="保存可用于生产的工程版本，为每个产品固定标记指定唯一版本。测试与烧录由工程自身定义。"
     Foreground="#62788B" Margin="0,5,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </DockPanel>

  <Border Grid.Row="1" Style="{StaticResource Panel}">
   <StackPanel>
    <WrapPanel>
     <TextBlock Text="查找生产工程" VerticalAlignment="Center" Margin="0,0,9,0"/>
     <TextBox x:Name="SearchBox" Width="270" VerticalAlignment="Center"
      TextChanged="SearchChanged" ToolTip="按工程名称、修订或版本标识查找"/>
     <Button Content="刷新" Click="Refresh_Click" Margin="0,0,8,0"/>
    </WrapPanel>
    <Expander Header="跨电脑移交 · 导入 / 导出工程包" IsExpanded="False"
     Margin="0,9,0,0" Foreground="#52677D">
     <WrapPanel Margin="2,10,0,0">
      <Button Content="导入外部工程包…" Click="Import_Click"
       Background="#E8F2FA" BorderBrush="#A7C9E5"/>
      <Button x:Name="ExportButton" Content="导出当前工程…" Click="Export_Click"
       ToolTip="仅工程工作区可导出完整工程"/>
     </WrapPanel>
    </Expander>
   </StackPanel>
  </Border>

  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
   HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border Style="{StaticResource Panel}">
     <StackPanel>
      <TextBlock Text="本机可用于生产的工程版本" Style="{StaticResource Section}"/>
      <Grid>
       <DataGrid x:Name="CatalogTable" Height="226" AutoGenerateColumns="False"
        IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
        HeadersVisibility="Column" ColumnHeaderHeight="36" RowHeight="40"
        HorizontalScrollBarVisibility="Auto"
        SelectionChanged="CatalogSelectionChanged">
        <DataGrid.Columns>
         <DataGridTextColumn Header="工程名称" Binding="{Binding ProjectName}" Width="2*"/>
         <DataGridTextColumn Header="修订" Binding="{Binding ProjectRevision}" Width="85"/>
         <DataGridTextColumn Header="导入时间" Binding="{Binding InstalledAtUtc}" Width="175"/>
         <DataGridTextColumn Header="版本标识（SHA-256）"
          Binding="{Binding PackageSha256}" Width="*"/>
        </DataGrid.Columns>
       </DataGrid>
       <TextBlock x:Name="EmptyCatalogHint"
        Text="还没有生产工程。在“测试工程”中选择“用于生产”可直接加入；跨电脑移交可在上方导入。" FontSize="14"
        Foreground="#617A8E" TextWrapping="Wrap" TextAlignment="Center"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        Margin="16" IsHitTestVisible="False"/>
      </Grid>
      <TextBlock x:Name="SelectedSummary"
       Text="选择上方一份稳定版本，再为它关联固定扫码标记。不要在这里重复选择测试用例或烧录文件。" Foreground="#587389"
       Margin="0,10,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource Panel}">
     <StackPanel>
      <TextBlock Text="产品识别 · 固定标记关联生产工程" Style="{StaticResource Section}"/>
      <TextBlock Text="例如 HYDEP-00001234：识别标记为 HYDEP，完整编号原样保存。相同标记只对应一份生效工程版本。"
       TextWrapping="Wrap" Foreground="#61788D" Margin="0,0,0,13"/>
      <WrapPanel Margin="0,0,0,10">
       <TextBlock Text="固定标记" VerticalAlignment="Center" Margin="0,0,9,0"/>
       <TextBox x:Name="MarkerInput" Width="170" ToolTip="例如 HYDEP，不用输入连字符"/>
       <Button Content="关联到选中工程" Click="Bind_Click"
        Background="#E8F2FA" BorderBrush="#A7C9E5"/>
       <Button Content="删除选中的关联" Click="RemoveBinding_Click"/>
      </WrapPanel>
      <DataGrid x:Name="BindingsTable" Height="135" AutoGenerateColumns="False"
       IsReadOnly="True" CanUserAddRows="False"
       HeadersVisibility="Column" RowHeight="36" ColumnHeaderHeight="34"
       HorizontalScrollBarVisibility="Auto" SelectionMode="Single">
       <DataGrid.Columns>
        <DataGridTextColumn Header="识别标记" Binding="{Binding Marker}" Width="155"/>
        <DataGridTextColumn Header="对应工程" Binding="{Binding ProjectName}" Width="*"/>
        <DataGridTextColumn Header="工程修订" Binding="{Binding ProjectRevision}" Width="95"/>
        <DataGridTextColumn Header="关联版本" Binding="{Binding Revision}" Width="90"/>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource Panel}">
     <StackPanel>
      <TextBlock Text="检查扫码匹配" Style="{StaticResource Section}"/>
      <WrapPanel Margin="0,0,0,10">
       <TextBox x:Name="SampleBarcodeInput" Width="340"
        ToolTip="输入完整编号预览匹配，不会触发真实硬件"/>
       <Button Content="检查匹配" Click="Preview_Click"/>
      </WrapPanel>
      <TextBlock x:Name="PreviewResult"
       Text="输入完整 ECU 编号进行匹配预览；只读校验，不触发设备动作。" TextWrapping="Wrap"
       Foreground="#315C79"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <Border Grid.Row="3" Background="White" BorderBrush="#DCE5ED"
   BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
   <TextBlock x:Name="Status" Text="读取工程库…" TextWrapping="Wrap"
    Foreground="#365A76"/>
  </Border>
 </Grid>
</Window>